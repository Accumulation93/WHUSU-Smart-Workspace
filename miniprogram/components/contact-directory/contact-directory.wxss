.directory-tag-category { display: inline-flex; flex: none; align-items: center; justify-content: center; gap: 7rpx; width: auto; min-width: 0; max-width: none; min-height: var(--ui-compact-height); height: auto; margin: 0; padding: 6rpx 13rpx; border: 1px solid rgba(147,197,253,.56); border-radius: var(--ui-compact-radius); background: linear-gradient(135deg,rgba(255,255,255,.9),rgba(246,249,255,.78)); color: #475569; font-size: var(--ui-type-label); font-weight: 700; line-height: 1.4; text-align: center; }

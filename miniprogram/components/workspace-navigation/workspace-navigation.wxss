:host {
  display: block;
  flex: none;
  width: 100%;
}

.workspace-navigation-spacer {
  width: 100%;
}

.workspace-navigation {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1200;
  width: 100%;
  background: linear-gradient(180deg, #f7faff 0%, #f9fbff 100%);
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.045);
  box-sizing: border-box;
}

.workspace-navigation-status {
  width: 100%;
  background: linear-gradient(180deg, #f7faff 0%, #f9fbff 100%);
}

.workspace-navigation-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  border-bottom: 1rpx solid rgba(219, 229, 241, 0.82);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(250, 252, 255, 0.96) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
}

.workspace-navigation-title {
  display: block;
  width: 100%;
  color: #172033;
  font-size: var(--ui-type-value);
  font-weight: 650;
  line-height: var(--ui-leading-heading);
  text-align: center;
  white-space: nowrap;
}

.workspace-navigation-back {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  padding-left: 28rpx;
  box-sizing: border-box;
}

.workspace-navigation-back-active {
  opacity: 0.56;
}

.workspace-navigation-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #1e293b;
  border-bottom: 4rpx solid #1e293b;
  border-radius: 2rpx;
  transform: rotate(45deg);
  box-sizing: border-box;
}

@media (min-width: 520px) {
  .workspace-navigation {
    box-shadow: 0 5px 14px rgba(15, 23, 42, 0.045);
  }

  .workspace-navigation-bar {
    border-bottom-width: 1px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.92);
  }

  .workspace-navigation-back {
    padding-left: 18px;
  }

  .workspace-navigation-back-icon {
    width: 10px;
    height: 10px;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-radius: 1px;
  }
}

:host {
  display: block;
  width: 100%;
  margin-bottom: 24rpx;
}

.workspace-hero {
  position: relative;
  overflow: hidden;
  width: 100%;
  margin-bottom: 0;
  padding: 34rpx 30rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 34rpx;
  box-sizing: border-box;
  color: #ffffff;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.98) 0%, rgba(59, 130, 246, 0.95) 52%, rgba(96, 165, 250, 0.92) 100%);
  box-shadow:
    0 22rpx 46rpx rgba(37, 99, 235, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.workspace-hero-admin {
  background:
    linear-gradient(135deg, rgba(15, 23, 42, 0.97) 0%, rgba(30, 41, 59, 0.96) 44%, rgba(37, 99, 235, 0.93) 100%);
  box-shadow:
    0 22rpx 46rpx rgba(15, 23, 42, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.15);
}

.workspace-hero::before {
  content: "";
  position: absolute;
  top: -90rpx;
  right: -54rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.workspace-hero-heading {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.workspace-app-name {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.90);
  font-size: var(--ui-type-meta);
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.workspace-page-name {
  flex: 0 1 auto;
  max-width: 58%;
  padding: 8rpx 13rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.27);
  border-radius: 13rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.4;
  text-align: right;
  overflow-wrap: anywhere;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.12));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
}

.workspace-person-name {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  color: #ffffff;
  font-size: var(--ui-type-page);
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: 1rpx;
  overflow-wrap: anywhere;
  text-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.workspace-person-summary {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 5rpx 14rpx;
  margin-top: 7rpx;
}

.workspace-identity {
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--ui-type-label);
  font-weight: 700;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.workspace-person-detail {
  color: rgba(255, 255, 255, 0.88);
  font-size: var(--ui-type-caption);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.workspace-context-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  margin-top: 22rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.20), rgba(255, 255, 255, 0.11));
  box-shadow:
    0 12rpx 26rpx rgba(30, 64, 175, 0.10),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
  box-sizing: border-box;
}

.workspace-context-pressing {
  transform: translateY(1rpx) scale(0.996);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.14));
}

.workspace-context-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.16);
}

.workspace-context-copy {
  flex: 1;
  min-width: 0;
}

.workspace-context-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--ui-type-caption);
  line-height: 1.35;
}

.workspace-organization {
  margin-top: 3rpx;
  color: #ffffff;
  font-size: var(--ui-type-value);
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.workspace-context-identity {
  margin-top: 3rpx;
  color: rgba(239, 246, 255, 0.88);
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.workspace-switch-action {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  min-height: 48rpx;
  padding: 8rpx 5rpx 8rpx 12rpx;
  color: #ffffff;
  font-size: var(--ui-type-label);
  font-weight: 700;
  line-height: 1.35;
}

@media (min-width: 520px) {
  :host {
    margin-bottom: 18px;
  }

  .workspace-hero {
    padding: 24px 26px 22px;
    border-radius: 26px;
  }

  .workspace-hero-heading {
    gap: 18px;
  }

  .workspace-page-name {
    padding: 6px 10px;
    border-radius: 9px;
  }

  .workspace-person-name {
    margin-top: 16px;
  }

  .workspace-person-summary {
    gap: 4px 10px;
    margin-top: 5px;
  }

  .workspace-context-card {
    gap: 12px;
    margin-top: 17px;
    padding: 13px 15px;
    border-radius: 15px;
  }

  .workspace-context-icon {
    width: 40px;
    height: 40px;
    border-radius: 13px;
  }

  .workspace-switch-action {
    min-height: 36px;
    padding: 7px 4px 7px 10px;
  }
}

@media (max-width: 340px) {
  .workspace-hero {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .workspace-context-card {
    align-items: flex-start;
  }
}

@media (min-width: 900px) {
  .workspace-hero {
    padding: 24px 28px 22px;
    border-radius: 18px;
  }

  .workspace-context-card {
    border-radius: 14px;
  }

  .workspace-context-icon {
    border-radius: 10px;
  }

  .workspace-page-name {
    border-radius: 9px;
  }
}

@media (min-width: 900px) and (orientation: landscape) {
  .workspace-hero {
    padding: 22px 26px 20px;
    border-radius: 18px;
  }

  .workspace-context-card {
    margin-top: 15px;
    padding: 12px 14px;
    border-radius: 14px;
  }

  .workspace-context-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
  }

  .workspace-page-name {
    padding: 6px 9px;
    border-radius: 8px;
  }

  .workspace-switch-action {
    min-height: 34px;
    padding: 6px 4px 6px 9px;
  }
}

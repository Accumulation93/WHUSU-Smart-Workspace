<view class="workspace-hero workspace-hero-{{tone}}">
  <view class="workspace-hero-heading">
    <view class="workspace-app-name">{{appName}}</view>
    <view class="workspace-page-name" wx:if="{{pageName}}">{{pageName}}</view>
  </view>

  <block wx:if="{{signedIn}}">
    <view class="workspace-person-name">{{personName}}</view>
    <view class="workspace-person-summary">
      <text class="workspace-identity">{{identityName}}</text>
      <text class="workspace-person-detail" wx:if="{{identityDetail}}">{{identityDetail}}</text>
    </view>

    <view
      class="workspace-context-card"
      catchtap="onSwitchTap"
      hover-class="workspace-context-pressing"
      hover-start-time="0"
      hover-stay-time="160"
      hover-stop-propagation="{{true}}"
      aria-role="button"
      aria-label="{{localeCopy.copy_b58ff21ac7}}"
    >
      <view class="workspace-context-icon">
        <ui-icon name="grid" tone="white" sizeRole="context-leading" ariaLabel="{{localeCopy.copy_511b01626f}}" />
      </view>
      <view class="workspace-context-copy">
        <view class="workspace-context-label">{{localeCopy.copy_511b01626f}}</view>
        <view class="workspace-organization">{{organizationName}}</view>
        <view class="workspace-context-identity">{{identityName}}</view>
      </view>
      <view class="workspace-switch-action">
        <text>{{localeCopy.copy_c488bf29b9}}</text>
        <ui-icon name="chevron-right" tone="white" sizeRole="context-trailing" ariaLabel="{{localeCopy.copy_b58ff21ac7}}" />
      </view>
    </view>
  </block>
</view>

<viewport-portal wx:if="{{visible}}">
  <view class="app-toast-overlay {{blocking ? 'is-blocking' : ''}}">
    <view class="app-toast-blocker" wx:if="{{blocking}}" catchtouchmove="noop"></view>
    <view
      class="app-toast-card"
      aria-role="alert"
      aria-label="{{text}}"
    >
      <app-loading wx:if="{{state === 'loading'}}" toast="{{true}}" text="{{text}}" />
      <view wx:else class="app-toast-leading">
        <ui-icon name="{{iconName}}" tone="white" size-role="toast-leading" />
      </view>
      <view wx:if="{{state !== 'loading'}}" class="app-toast-text">{{text}}</view>
    </view>
  </view>
</viewport-portal>

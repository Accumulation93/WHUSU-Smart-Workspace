.nature-editor { display: flex; flex-direction: column; gap: var(--ui-card-gap); }
.nature-editor > .section-control-card,
.nature-editor > .edit-box,
.nature-editor > .list-card { margin-top: 0; margin-bottom: 0; }
.nature-editor .card-actions { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: var(--ui-card-action-gap); width: 100%; min-width: 0; margin-top: var(--ui-card-action-gap); }
.nature-editor .card-actions > .nature-link { flex: none; width: auto; min-width: 0; max-width: 100%; height: auto; box-sizing: border-box; margin: 0; }
.nature-link { display: flex; align-items: center; justify-content: center; text-align: center; min-height: var(--ui-compact-height); padding: var(--ui-compact-padding-y) var(--ui-compact-padding-x); margin: 0; width: auto; font-size: var(--ui-type-control); line-height: 1.35; color: #2563eb; background: linear-gradient(135deg,rgba(239,246,255,.96),rgba(219,234,254,.72)); border-radius: var(--ui-control-radius); }
.nature-link::after { border: 0; }
.nature-danger { color: #dc2626; background: linear-gradient(135deg,rgba(254,242,242,.96),rgba(254,226,226,.72)); }
.nature-notice { font-size: var(--ui-type-body); line-height: 1.6; }
.nature-description { color: #64748b; font-size: var(--ui-type-body); line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; margin-top: var(--ui-label-gap); }
.nature-editor .nature-description-input { display: block; min-height: 88px; height: auto; box-sizing: border-box; width: 100%; }

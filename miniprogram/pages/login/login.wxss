page {
  min-height: 100%;
}

.page::before,
.page::after {
  content: "";
  position: fixed;
  z-index: 0;
  border-radius: 50%;
  pointer-events: none;
}

.page::before {
  top: -120rpx;
  right: -90rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(96,165,250,0.18), rgba(96,165,250,0) 72%);
}

.page::after {
  left: -120rpx;
  bottom: 150rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(147,197,253,0.16), rgba(147,197,253,0) 72%);
}

.login-layout,
.page-footer {
  position: relative;
  z-index: 1;
}

.login-hero {
  padding: 44rpx 34rpx 40rpx;
}

.login-main {
  min-width: 0;
}

.login-card {
  margin-bottom: 0;
  padding: 28rpx 26rpx;
  animation: glassFadeUp 0.5s cubic-bezier(0.16,0.84,0.28,1) both;
}

.login-card:active {
  transform: none;
  filter: none;
}

.login-card .section-title {
  margin-bottom: 22rpx;
}

.card-desc {
  margin: 16rpx 0 24rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}

.sheet-note {
  margin-bottom: 20rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(191,219,254,0.72);
  border-radius: 16rpx;
  color: #52677f;
  font-size: 23rpx;
  line-height: 1.68;
  background: rgba(239,246,255,0.72);
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 86rpx;
  padding: 17rpx 20rpx;
  border: 1rpx solid rgba(203,213,225,0.82);
  border-radius: 16rpx;
  color: #1e293b;
  font-size: 25rpx;
  line-height: 1.55;
  background: rgba(255,255,255,0.78);
}

.field-picker-arrow {
  margin-left: 18rpx;
  color: #64748b;
  font-size: 34rpx;
}

.verification-input {
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.recovery-code-box {
  box-sizing: border-box;
  width: 100%;
  margin: 18rpx 0;
  padding: 22rpx;
  border: 1rpx solid rgba(96, 165, 250, 0.42);
  border-radius: 16rpx;
  background: rgba(239, 246, 255, 0.9);
  color: #2563eb;
  font-size: var(--ui-type-value);
  font-weight: 700;
  line-height: 1.55;
  letter-spacing: 2rpx;
  overflow-wrap: anywhere;
  text-align: center;
}

.sheet-link {
  box-sizing: border-box;
  width: fit-content;
  max-width: 100%;
  margin: 18rpx auto 0;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.55;
  text-align: center;
}

.login-card .primary-btn {
  width: 100%;
  min-height: 90rpx;
  font-size: 27rpx;
}

.sheet {
  position: fixed;
  inset: 0;
  z-index: 120;
  pointer-events: none;
}

.sheet-show {
  pointer-events: auto;
}

.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(15,23,42,0.36);
  opacity: 0;
  transition: opacity 0.24s ease;
}

.sheet-show .sheet-mask {
  opacity: 1;
}

.sheet-panel {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  padding: 28rpx 26rpx 32rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.97), rgba(247,250,255,0.90));
  border: 1rpx solid rgba(255,255,255,0.82);
  box-shadow:
    0 26rpx 56rpx rgba(15,23,42,0.16),
    inset 0 1rpx 0 rgba(255,255,255,0.90);
  transform: translateY(112%);
  transition: transform 0.28s cubic-bezier(0.16,0.84,0.28,1);
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
}

.sheet-show .sheet-panel {
  transform: translateY(0);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.sheet-title {
  color: #0f172a;
  font-size: 31rpx;
  font-weight: 800;
}

.sheet-close {
  flex-shrink: 0;
  padding: 6rpx 0 6rpx 14rpx;
  color: #475569;
  font-size: 23rpx;
  font-weight: 700;
}

.field {
  margin-bottom: 18rpx;
}

.field-label {
  margin-bottom: 9rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.5;
}

.field-input {
  min-height: 86rpx;
  line-height: 52rpx;
}

.sheet-panel .primary-btn {
  width: 100%;
  margin-top: 4rpx;
}

@media (max-width: 360px) {
  .page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .login-hero {
    padding: 34rpx 26rpx 30rpx;
  }

}

@media (min-width: 520px) {
  .page {
    max-width: 720px;
  }

  .login-layout {
    max-width: 620px;
    margin: 0 auto;
  }

  .login-card .primary-btn {
    min-height: 48px !important;
    height: auto !important;
    padding: 12px 20px !important;
    font-size: 15px !important;
    line-height: 20px !important;
  }

  .login-card .section-title {
    margin-bottom: 16px;
  }

  .card-desc {
    margin: 12px 0 18px;
    font-size: 14px;
    line-height: 1.65;
  }

  .sheet-title {
    font-size: 19px;
    line-height: 1.4;
  }

  .sheet-note,
  .field-picker,
  .sheet-link {
    font-size: 14px;
  }

  .field-picker {
    min-height: 48px;
    padding: 12px 14px;
    border-radius: 12px;
  }

  .sheet-panel {
    left: 50%;
    right: auto;
    width: calc(100vw - 48px);
    width: min(520px, calc(100vw - 48px));
    bottom: 24px;
    transform: translate(-50%, 112%);
  }

  .sheet-show .sheet-panel {
    transform: translate(-50%, 0);
  }
}

@media (min-width: 900px) {
  .page {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 1120px;
  }

  .login-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    align-items: stretch;
    gap: 28px;
    width: 100%;
    max-width: 1040px;
  }

  .login-hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 360px;
    margin-bottom: 0;
    padding: 42px;
  }

  .login-main {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .login-card {
    padding: 30px;
  }
}

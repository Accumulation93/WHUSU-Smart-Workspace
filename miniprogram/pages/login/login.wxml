<view class="page">
  <view class="login-layout">
    <view class="hero login-hero">
      <view class="hero-badge">{{roleBadge}}</view>
      <view class="hero-title">{{roleTitle}}</view>
      <view class="hero-subtitle">{{roleSubtitle}}</view>
    </view>

    <view class="login-main">
      <view class="role-switch">
        <view
          class="role-pill {{activeRole === 'user' ? 'role-pill-active' : ''}} ui-motion-chip"
          data-role="user"
          bindtap="switchRole"
          hover-class="ui-press-chip"
          hover-start-time="0"
          hover-stay-time="160"
          hover-stop-propagation="{{true}}"
        >
          普通用户
        </view>
        <view
          class="role-pill {{activeRole === 'admin' ? 'role-pill-active' : ''}} ui-motion-chip"
          data-role="admin"
          bindtap="switchRole"
          hover-class="ui-press-chip"
          hover-start-time="0"
          hover-stay-time="160"
          hover-stop-propagation="{{true}}"
        >
          管理员
        </view>
      </view>

      <view class="card login-card">
        <view class="section-title">微信登录</view>
        <view class="card-desc">使用微信身份安全登录，首次使用时按提示补充资料。</view>
        <button class="primary-btn ui-motion-button" loading="{{loading}}" bindtap="onLogin" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{loginButtonText}}</button>
      </view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">WHUSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>

  <view class="{{sheetClass}}">
    <view class="sheet-mask" bindtap="closeBind"></view>
    <view class="sheet-panel">
      <view class="sheet-header">
        <view class="sheet-title">{{bindTitle}}</view>
        <view class="sheet-close ui-motion-chip" bindtap="closeBind" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭 ×</view>
      </view>

      <view class="field">
        <view class="field-label">姓名</view>
        <input class="field-input" placeholder="请输入姓名" bindinput="onName" value="{{name}}" />
      </view>

      <view class="field">
        <view class="field-label">学号</view>
        <input class="field-input" placeholder="请输入学号" bindinput="onStudentId" value="{{studentId}}" />
      </view>

      <view class="field" wx:if="{{showInviteCode}}">
        <view class="field-label">邀请码</view>
        <input class="field-input" placeholder="请输入邀请码" bindinput="onInviteCode" value="{{inviteCode}}" />
      </view>

      <button class="primary-btn ui-motion-button" loading="{{loading}}" bindtap="onBind" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{bindButtonText}}</button>
    </view>
  </view>
</view>

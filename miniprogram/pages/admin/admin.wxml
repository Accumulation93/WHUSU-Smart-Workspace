                    <view class="drag-handle">≡</view>
                    <view class="template-config-sort-btns">
                      <view class="sort-arrow {{index === 0 ? 'sort-arrow-disabled' : ''}}" data-index="{{index}}" catchtap="moveClauseTemplateConfigUp">↑</view>
                      <view class="sort-arrow {{index === ruleForm.clauseTemplateConfigs.length - 1 ? 'sort-arrow-disabled' : ''}}" data-index="{{index}}" catchtap="moveClauseTemplateConfigDown">↓</view>
                    </view>
                  </view>
                  <view class="template-config-name">{{item.templateName || '未命名评分问题'}}</view>

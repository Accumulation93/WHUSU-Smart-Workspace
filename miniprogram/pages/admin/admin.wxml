          <view class="button-row compact-row"><button class="secondary-btn" bindtap="toggleSelectAllPubViewRules">{{pubViewRuleAllSelected ? '取消全选' : '全选当前列表'}}</button><button class="secondary-btn" bindtap="reverseSelectPubViewRules">反选当前列表</button><button class="secondary-btn" bindtap="batchDeletePubViewRules">批量删除选中</button></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="target-scroll" style="max-height:500rpx;">
            <view class="list-item rule-list-item" wx:for="{{pubViewRuleListView}}" wx:key="id">
              <view class="list-main">
                <view class="rule-list-action-row">
                  <view class="select-chip {{pubViewRuleSelectedIds[item.id] ? 'select-chip-active' : ''}}" data-id="{{item.id}}" catchtap="togglePubViewRuleSelection">{{pubViewRuleSelectedIds[item.id] ? '已选' : '选择'}}</view>
                  <view class="inline-actions rule-list-inline-actions"><text class="link" data-id="{{item.id}}" bindtap="editPubViewRule">编辑</text><text class="link danger" data-id="{{item.id}}" bindtap="deletePubViewRule">删除</text></view>
                </view>
                <view class="rule-list-info"><view class="rule-list-main-line"><text class="rule-info-text">{{item.granteeDepartment}} / {{item.granteeIdentity}}</text></view><view class="rule-list-meta"><text class="rule-tag tag-scope">{{item.clauseCount || item.clauses.length || 0}} 条查看规则</text></view></view>
              </view>
            </view>
            <view class="rule-empty small-empty" wx:if="{{!pubViewRuleListView.length}}">暂无查看权限类别</view>
          </scroll-view>
        </view>

        <!-- ═══ 评优名单指定权 ─── 类别 + 条款 ─── -->
        <view class="rule-panel" style="margin-top:28rpx;">
          <view class="rule-panel-head"><view class="rule-panel-title">评优指定权类别</view><view class="rule-panel-subtitle">选择授权部门+身份后，可在下方配置评优规则条款（需先有查看权限）</view></view>
          <view class="field"><view class="field-label">授权部门</view><picker range="{{departmentList}}" range-key="name" bindchange="onPubMeritRuleDeptChange"><view class="picker-value">{{pubMeritRuleForm.granteeDepartment || '请选择部门'}}</view></picker></view>
          <view class="field"><view class="field-label">授权身份</view><picker range="{{identityList}}" range-key="name" bindchange="onPubMeritRuleIdentChange"><view class="picker-value">{{pubMeritRuleForm.granteeIdentity || '请选择身份'}}</view></picker></view>
          <view class="button-row"><button class="primary-btn" loading="{{loadingMap.savePubMeritRule}}" bindtap="savePubMeritRule">保存类别</button><button class="secondary-btn" bindtap="startNewPubMeritRule">新建类别</button><button class="secondary-btn" bindtap="batchSavePubMeritRules">批量应用到已选类别</button><button class="secondary-btn" disabled="{{loadingMap.generatePubMeritRules}}" bindtap="generatePubMeritRules">生成默认类别</button></view>

        <view class="rule-panel" wx:if="{{pubMeritRuleForm.granteeDepartmentId && pubMeritRuleForm.granteeIdentityId}}">
          <view class="rule-panel-head rule-panel-head-row"><view><view class="rule-panel-title">当前评优规则条款</view><view class="rule-panel-subtitle">附加到此类别下的每条评优规则</view></view><button class="secondary-btn mini-action-btn" bindtap="openPubMeritClauseEditor">新建评优规则条款</button></view>
          <view class="rule-empty" wx:if="{{!pubMeritRuleForm.clauses.length}}">暂无评优规则，点击右上角「新建评优规则条款」添加</view>
          <view class="rule-clause-card" wx:for="{{pubMeritRuleForm.clauses}}" wx:key="index" wx:for-item="c">
            <view class="rule-clause-main"><view class="rule-clause-title">{{c.targetIdentity || '未选择目标身份'}}</view><view class="rule-tag-row"><text class="rule-tag tag-scope">{{c.scopeLabel || c.scopeType}}</text><text class="rule-tag tag-target">{{c.targetIdentity}}</text><text class="rule-tag tag-weight">名额 {{c.quotaLimit || '不限'}}</text><text class="rule-tag {{c.requireExactQuota ? 'tag-required' : 'tag-free'}}">{{c.requireExactQuota ? '等额' : '可少于'}}</text></view></view>
            <view class="pill-actions rule-card-actions"><text class="pill-link" data-clause-id="{{c.id}}" data-pub-id="{{publicationForm.id}}" bindtap="openDesignationPicker">指定名单</text><text class="pill-link" data-index="{{index}}" bindtap="editPubMeritClause">编辑</text><text class="pill-close" data-index="{{index}}" bindtap="removePubMeritClause">删除</text></view>
          </view>
        </view>
        <view class="rule-empty" wx:elif="{{pubMeritRuleForm.granteeDepartmentId || pubMeritRuleForm.granteeIdentityId}}">请先完整选择授权部门和身份，再配置评优规则条款</view>

        <view class="rule-panel" wx:if="{{pubMeritRuleForm.granteeDepartmentId && pubMeritRuleForm.granteeIdentityId && pubMeritRuleForm.isClauseEditorVisible}}">
          <view class="rule-panel-head"><view class="rule-panel-title">评优规则条款编辑</view><view class="rule-panel-subtitle">{{pubMeritRuleForm.clauseEditingIndex >= 0 ? '正在编辑已有条款' : '添加一条新的评优规则'}}</view></view>
          <view class="field"><view class="field-label">指定范围</view><picker range="{{viewScopeOptions}}" range-key="label" bindchange="onPubMeritClauseScopeChange"><view class="picker-value">{{pubMeritRuleForm.clauseScopeLabel || '请选择范围'}}</view></picker></view>
          <view class="field"><view class="field-label">目标身份（为哪个身份的成员评优）</view><picker range="{{identityList}}" range-key="name" bindchange="onPubMeritClauseTargetIdentChange"><view class="picker-value">{{pubMeritRuleForm.clauseTargetIdentity || '请选择目标身份'}}</view></picker></view>
          <view class="field"><view class="field-label">名额上限（0=不限）</view><input class="field-input" type="number" value="{{pubMeritRuleForm.clauseQuotaLimit}}" bindinput="onPubMeritClauseQuotaInput"/></view>
          <view class="rule-switch-row"><view><view class="field-label">必须等额</view><view class="rule-panel-subtitle">开启后，必须恰好填满名额</view></view><switch checked="{{pubMeritRuleForm.clauseRequireExactQuota}}" color="#2563eb" bindchange="onPubMeritClauseExactToggle"/></view>
          <view class="button-row compact-row"><button class="secondary-btn" bindtap="addPubMeritClause">{{pubMeritRuleForm.clauseEditingIndex >= 0 ? '保存条款' : '加入当前条款'}}</button><button class="secondary-btn" bindtap="cancelPubMeritClauseEdit">取消编辑</button></view>
        </view>

        <view class="list-card rule-list-card">
          <view class="rule-list-toolbar"><view><view class="list-title">评优指定权类别列表</view><view class="rule-panel-subtitle">筛选只影响当前显示</view></view><view class="rule-list-count">{{pubMeritRuleListView.length}} / {{pubMeritRuleList.length}}</view></view>
          <view class="rule-filter-row"><view class="rule-filter-field"><view class="field-label">部门</view><picker range="{{pubMeritRuleFilterOptions.departments}}" bindchange="onPubMeritRuleFilterChange" data-field="department"><view class="picker-value compact-picker-value">{{pubMeritRuleFilters.department}}</view></picker></view><view class="rule-filter-field"><view class="field-label">身份</view><picker range="{{pubMeritRuleFilterOptions.identities}}" bindchange="onPubMeritRuleFilterChange" data-field="identity"><view class="picker-value compact-picker-value">{{pubMeritRuleFilters.identity}}</view></picker></view></view>
          <view class="button-row compact-row"><button class="secondary-btn" bindtap="toggleSelectAllPubMeritRules">{{pubMeritRuleAllSelected ? '取消全选' : '全选当前列表'}}</button><button class="secondary-btn" bindtap="reverseSelectPubMeritRules">反选当前列表</button><button class="secondary-btn" bindtap="batchDeletePubMeritRules">批量删除选中</button></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="target-scroll" style="max-height:500rpx;">
            <view class="list-item rule-list-item" wx:for="{{pubMeritRuleListView}}" wx:key="id">
              <view class="list-main">
                <view class="rule-list-action-row">
                  <view class="select-chip {{pubMeritRuleSelectedIds[item.id] ? 'select-chip-active' : ''}}" data-id="{{item.id}}" catchtap="togglePubMeritRuleSelection">{{pubMeritRuleSelectedIds[item.id] ? '已选' : '选择'}}</view>
                  <view class="inline-actions rule-list-inline-actions"><text class="link" data-id="{{item.id}}" bindtap="editPubMeritRule">编辑</text><text class="link danger" data-id="{{item.id}}" bindtap="deletePubMeritRule">删除</text></view>
                </view>
                <view class="rule-list-info"><view class="rule-list-main-line"><text class="rule-info-text">{{item.granteeDepartment}} / {{item.granteeIdentity}}</text></view><view class="rule-list-meta"><text class="rule-tag tag-scope">{{item.clauseCount || item.clauses.length || 0}} 条评优规则</text></view></view>
              </view>
            </view>
            <view class="rule-empty small-empty" wx:if="{{!pubMeritRuleListView.length}}">暂无评优指定权类别</view>
          </scroll-view>
        </view>
      </view>

      <!-- ═══ 评优名单汇总（Feature 5） ═══ -->
      <view class="rule-panel merit-summary-panel" wx:if="{{publicationForm.id}}" style="margin-top:28rpx;">
        <view class="rule-panel-head rule-panel-head-row">
          <view>
            <view class="rule-panel-title">🏆 评优名单汇总</view>
            <view class="rule-panel-subtitle">按规则条款分组显示，支持筛选和导出</view>
          </view>
          <view class="merit-summary-head-actions">
            <view class="merit-summary-total-chip" wx:if="{{meritSummaryGroups.length}}">共 {{meritSummaryGroups.length}} 组</view>
            <button class="secondary-btn mini-action-btn" loading="{{loadingMap.exportMeritSummary}}" bindtap="exportMeritListSummary">导出表格</button>
          </view>
        </view>

        <!-- 筛选条（玻璃风格） -->
        <view class="merit-summary-filter-bar" wx:if="{{meritSummaryGroups.length}}">
          <view class="merit-summary-filter-field">
            <text class="merit-summary-filter-label">部门</text>
            <picker range="{{meritSummaryDeptOptions}}" bindchange="onMeritSummaryFilterChange" data-field="department">
              <view class="merit-summary-filter-value">{{meritSummaryFilterDept}}</view>
            </picker>
          </view>
          <view class="merit-summary-filter-field">
            <text class="merit-summary-filter-label">身份</text>
            <picker range="{{meritSummaryIdentOptions}}" bindchange="onMeritSummaryFilterChange" data-field="identity">
              <view class="merit-summary-filter-value">{{meritSummaryFilterIdent}}</view>
            </picker>
          </view>
          <view class="merit-summary-filter-field">
            <text class="merit-summary-filter-label">职能组</text>
            <picker range="{{meritSummaryWgOptions}}" bindchange="onMeritSummaryFilterChange" data-field="workGroup">
              <view class="merit-summary-filter-value">{{meritSummaryFilterWg}}</view>
            </picker>
          </view>
        </view>

        <view class="rule-empty glass-empty" wx:if="{{!meritSummaryGroups.length}}">
          <view class="empty-illustration"><view class="empty-icon-star"></view></view>
          <view class="empty-title">暂无评优名单</view>
          <view class="empty-desc">请先在评优规则条款中指定人选</view>
        </view>

        <!-- 分组卡片（玻璃风格） -->
        <view class="merit-group-glass-card" wx:for="{{meritSummaryFilteredGroups}}" wx:key="clauseId" wx:for-item="group" wx:for-index="gi" style="animation: glassFadeUp 0.38s {{0.06 * gi}}s ease both;">
          <view class="merit-group-glass-head" data-clause-id="{{group.clauseId}}" bindtap="toggleMeritSummaryGroup">
            <view class="merit-group-glass-left">
              <view class="merit-group-color-dot" style="background: {{gradeBandWxs.getColor(group.targetIdentity)}};"></view>
              <view class="merit-group-glass-title">{{group.granteeDepartment}} {{group.granteeIdentity}} → {{group.targetIdentity}}</view>
            </view>
            <view class="merit-group-glass-right">
              <view class="merit-group-count-bubble" style="background: {{gradeBandWxs.getColor(group.targetIdentity)}};">
                <text>{{group.memberCount}}人</text>
              </view>
              <view class="merit-group-quota-chip" wx:if="{{group.quotaLimit > 0}}">名额{{group.quotaLimit}}</view>
              <text class="merit-group-expand-arrow">{{expandedMeritSummaryClauseId === group.clauseId ? '▲' : '▼'}}</text>
            </view>
          </view>
          <!-- Expanded: glass member cards -->
          <view class="merit-group-glass-body" wx:if="{{expandedMeritSummaryClauseId === group.clauseId}}">
            <view class="merit-group-glass-member" wx:for="{{group.members}}" wx:key="id" wx:for-item="m" style="animation: glassFadeUp 0.28s {{0.04 * index}}s ease both;">
              <view class="merit-member-avatar" style="background: {{gradeBandWxs.getColor(group.targetIdentity)}};">{{m.name[0] || '?'}}</view>
              <view class="merit-member-info">
                <view class="merit-member-name">{{m.name}}</view>
                <view class="merit-member-detail">{{m.identity}}<text wx:if="{{m.department}}"> · {{m.department}}</text><text wx:if="{{m.workGroup}}"> · {{m.workGroup}}</text></view>
              </view>
              <view class="merit-member-id">{{m.studentId}}</view>
            </view>
            <view class="empty-inline" wx:if="{{!group.members.length}}">当前筛选条件下无匹配成员</view>
          </view>
        </view>
      </view>

    </view>

  <!-- Designation Picker Popup (page level, outside tab sections) -->
  <view class="popup-mask" wx:if="{{showDesignationPicker}}" bindtap="closeDesignationPicker">
    <view class="popup-card desig-popup-card" catchtap="noop">
      <view class="popup-header"><view class="popup-title">指定评优名单</view><text class="popup-close" bindtap="closeDesignationPicker">关闭</text></view>
      <view class="list-title">当前名单（{{designationPickerSelectedIds.length}}人）</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-current-scroll">
          <view class="list-item desig-current-item" wx:for="{{designationPickerSelectedList}}" wx:key="id"><view class="list-main"><view class="list-name">{{item.name}}</view><view class="list-desc">{{item.department}} · {{item.studentId}}</view></view><view class="inline-actions list-actions-below"><text class="link danger" data-hr-id="{{item.id}}" catchtap="onDesignationPickerToggle">移除</text></view></view>
          <view class="empty-inline" wx:if="{{!designationPickerSelectedList.length}}">尚未指定任何人</view>
        </scroll-view>
        <view class="list-title" style="margin-top:8rpx;">可选成员</view>
        <view class="rule-filter-row"><view class="rule-filter-field"><view class="field-label">部门</view><picker range="{{desigFilterDeptOptions}}" bindchange="onDesigFilterChange" data-field="department"><view class="picker-value compact-picker-value">{{desigFilterDept}}</view></picker></view><view class="rule-filter-field"><view class="field-label">身份</view><picker range="{{desigFilterIdentOptions}}" bindchange="onDesigFilterChange" data-field="identity"><view class="picker-value compact-picker-value">{{desigFilterIdent}}</view></picker></view><view class="rule-filter-field" style="flex:1;"><view class="field-label">搜索</view><input class="field-input" placeholder="姓名/学号" value="{{desigSearchKeyword}}" bindinput="onDesigSearchInput"/></view></view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-candidate-scroll"><view class="list-item" wx:for="{{designationPickerFilteredList}}" wx:key="id" data-hr-id="{{item.id}}" bindtap="onDesignationPickerToggle"><view class="list-main"><view class="list-name"><view class="select-chip select-chip-inline {{item.isSelected ? 'select-chip-active' : ''}}">{{item.isSelected ? '已选' : '选择'}}</view>{{item.name}}</view><view class="list-desc">{{item.studentId}} · {{item.department}}</view></view></view><view class="empty-inline" wx:if="{{!designationPickerFilteredList.length}}">没有匹配的成员</view></scroll-view>
        <view class="button-row"><button class="secondary-btn" bindtap="closeDesignationPicker">取消</button><button class="primary-btn" loading="{{loadingMap.saveDesignations}}" bindtap="saveDesignations">保存名单（已选{{designationPickerSelectedIds.length}}人）</button></view>
    </view>
  </view>

  <view class="popup-mask" wx:if="{{orgFormVisible}}" bindtap="closeOrgForm">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="list-title">{{orgFormData.id ? '编辑组织名称' : '新建组织'}}</view>
        <text class="popup-close" bindtap="closeOrgForm">关闭</text>
      </view>
      <view class="popup-body">
        <view class="field">
          <view class="field-label">组织名称</view>
          <input class="field-input" bindinput="onOrgFieldInput" value="{{orgFormData.name}}" placeholder="请输入组织名称" />
        </view>
        <view class="button-row compact-row">
          <button class="primary-btn" loading="{{loadingMap.saveOrganization}}" bindtap="saveOrganization">保存组织</button>
          <button class="secondary-btn" wx:if="{{!orgFormData.id}}" loading="{{loadingMap.switchOrganization}}" bindtap="createAndSwitchOrganization">保存并切换</button>
        </view>
      </view>
    </view>
  </view>

  <view class="popup-mask" wx:if="{{scorerTargetPopupVisible}}" bindtap="closeScorerTargetPopup">
    <view class="popup-card completion-popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">{{scorerTargetPopupTitle}}</view>
        <text class="popup-close" bindtap="closeScorerTargetPopup">关闭</text>
      </view>
      <view class="popup-loading-overlay" wx:if="{{scorerTargetPopupLoading}}">
        <view class="card-loading-spinner"></view>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y wx:else>
        <view class="result-table">
          <view class="result-table-head">
            <view class="result-col result-col-target-name">被评人</view>
            <view class="result-col result-col-target-detail">具体信息</view>
            <view class="result-col result-col-popup-status">状态</view>
          </view>
          <view class="result-table-row {{item.status === 'submitted' ? 'result-table-row-clickable' : ''}}" wx:for="{{scorerTargetPopupRows}}" wx:key="targetId" data-record-id="{{item.recordId}}" bindtap="openScorerTargetRecordDetail">
            <view class="result-col result-col-target-name">
              <view class="result-name">{{item.targetName}}</view>
              <view class="result-meta">{{item.targetStudentId}}</view>
            </view>
            <view class="result-col result-col-target-detail">
              <view class="result-meta result-meta-strong">{{item.detailText}}</view>
            </view>
            <view class="result-col result-col-popup-status">
              <view class="status-chip {{item.statusClass}}">{{item.statusText}}</view>
            </view>
          </view>
        </view>
        <view class="empty-inline" wx:if="{{!scorerTargetPopupRows.length}}">该评分人暂无待评任务。</view>
      </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU考核评分</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>

  <view class="popup-mask" wx:if="{{recordDetailPopupVisible}}" bindtap="closeScoreRecordDetail">
    <view class="popup-card completion-popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">评分详情</view>
        <text class="popup-close" bindtap="closeScoreRecordDetail">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y wx:if="{{recordDetail}}">
        <view class="list-item detail-summary-card">
          <view class="list-main">
            <view class="detail-people-row">
              <view class="detail-person-block">
                <view class="detail-person-label">评分人</view>
                <view class="detail-person-name">{{recordDetail.scorer.name}}</view>
              </view>
              <view class="detail-person-divider"></view>
              <view class="detail-person-block">
                <view class="detail-person-label">被评分人</view>
                <view class="detail-person-name">{{recordDetail.target.name}}</view>
              </view>
            </view>
            <view class="list-desc">{{recordDetail.submittedAt}}</view>
            <view class="detail-action-row">
              <button
                class="secondary-btn danger-btn compact-action-btn"
                data-id="{{recordDetail.recordId}}"
                bindtap="revokeScoreRecord"
              >撤销这条评分</button>
            </view>
          </view>
        </view>
        <view class="question-card" wx:for="{{recordDetail.templates}}" wx:for-index="templateIndex" wx:key="templateId">
          <view class="question-title">{{item.templateName}}</view>
          <view class="detail-tag-row">
            <view class="score-tag score-tag-template">模板得分 {{item.score}}</view>
            <view class="score-tag score-tag-weight">权重 {{item.weight}}</view>
            <view class="score-tag score-tag-weighted">加权 {{item.weightedScore}}</view>
          </view>
          <view class="detail-question compact-question" wx:for="{{item.questions}}" wx:for-item="question" wx:for-index="questionIndex" wx:key="questionIndex">
            <view class="compact-question-head">
              <view class="list-name detail-question-title">{{question.question}}</view>
              <view class="question-score-corner">{{question.score}} / {{question.maxValue}}</view>
            </view>
            <view
              class="score-label-toggle"
              wx:if="{{question.hasScoreLabel}}"
              data-template-index="{{templateIndex}}"
              data-question-index="{{questionIndex}}"
              bindtap="toggleScoreLabel"
            >
              {{question.scoreLabelExpanded ? '收起评分说明' : '查看评分说明'}}
            </view>
            <view class="score-label-box" wx:if="{{question.hasScoreLabel && question.scoreLabelExpanded}}">{{question.scoreLabel}}</view>
          </view>
        </view>
      </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
      <view class="card-loading-overlay" wx:if="{{!recordDetail}}">
        <view class="card-loading-spinner"></view>
      </view>
    </view>
  </view>

</view>
</view>

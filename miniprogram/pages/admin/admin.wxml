          <view class="field"><view class="field-label">授权部门</view><picker range="{{departmentList}}" range-key="name" bindchange="onPubViewRuleDeptChange"><view class="picker-value">{{pubViewRuleForm.granteeDepartment || '请选择部门'}}</view></picker></view>
          <view class="field"><view class="field-label">授权身份</view><picker range="{{identityList}}" range-key="name" bindchange="onPubViewRuleIdentChange"><view class="picker-value">{{pubViewRuleForm.granteeIdentity || '请选择身份'}}</view></picker></view>
          <view class="button-row"><button class="primary-btn" loading="{{loadingMap.savePubViewRule}}" bindtap="savePubViewRule">保存类别</button><button class="secondary-btn" bindtap="startNewPubViewRule">新建类别</button><button class="secondary-btn" bindtap="batchSavePubViewRules">批量应用到已选类别</button><button class="secondary-btn" disabled="{{loadingMap.generatePubViewRules}}" bindtap="generatePubViewRules">生成默认类别</button></view>
        </view>

        <view class="rule-panel" wx:if="{{pubViewRuleForm.granteeDepartmentId && pubViewRuleForm.granteeIdentityId}}">
          <view class="rule-panel-head rule-panel-head-row"><view><view class="rule-panel-title">当前查看规则条款</view><view class="rule-panel-subtitle">附加到此类别下的每条查看规则</view></view><button class="secondary-btn mini-action-btn" bindtap="openPubViewClauseEditor">新建查看规则条款</button></view>
          <view class="rule-empty" wx:if="{{!pubViewRuleForm.clauses.length}}">暂无查看规则，点击右上角「新建查看规则条款」添加</view>
          <view class="rule-clause-card" wx:for="{{pubViewRuleForm.clauses}}" wx:key="index" wx:for-item="c">
            <view class="rule-clause-main"><view class="rule-clause-title">{{c.targetIdentity || '不限身份'}}</view><view class="rule-tag-row"><text class="rule-tag tag-scope">{{c.scopeLabel || c.scopeType}}</text><text class="rule-tag tag-target" wx:if="{{c.targetIdentity}}">{{c.targetIdentity}}</text><text class="rule-tag tag-weight">{{c.displayMode === 'grade' ? '等第' : '分数'}}</text></view></view>
            <view class="pill-actions rule-card-actions"><text class="pill-link" data-index="{{index}}" bindtap="editPubViewClause">编辑</text><text class="pill-close" data-index="{{index}}" bindtap="removePubViewClause">删除</text></view>
          </view>
        </view>
        <view class="rule-empty" wx:elif="{{pubViewRuleForm.granteeDepartmentId || pubViewRuleForm.granteeIdentityId}}">请先完整选择授权部门和身份，再配置查看规则条款</view>

        <view class="rule-panel" wx:if="{{pubViewRuleForm.granteeDepartmentId && pubViewRuleForm.granteeIdentityId && pubViewRuleForm.isClauseEditorVisible}}">
          <view class="rule-panel-head"><view class="rule-panel-title">查看规则条款编辑</view><view class="rule-panel-subtitle">{{pubViewRuleForm.clauseEditingIndex >= 0 ? '正在编辑已有条款' : '添加一条新的查看规则'}}</view></view>
          <view class="field"><view class="field-label">查看范围</view><picker range="{{viewScopeOptions}}" range-key="label" bindchange="onPubViewClauseScopeChange"><view class="picker-value">{{pubViewRuleForm.clauseScopeLabel || '请选择范围'}}</view></picker></view>
          <view class="field" wx:if="{{pubViewRuleForm.clauseScopeType === 'same_department_identity' || pubViewRuleForm.clauseScopeType === 'same_work_group_identity'}}"><view class="field-label">目标身份</view><picker range="{{identityList}}" range-key="name" bindchange="onPubViewClauseTargetIdentChange"><view class="picker-value">{{pubViewRuleForm.clauseTargetIdentity || '请选择目标身份'}}</view></picker></view>
          <view class="field"><view class="field-label">显示模式</view><picker range="{{displayModeOptions}}" range-key="label" bindchange="onPubViewClauseDisplayModeChange"><view class="picker-value">{{pubViewRuleForm.clauseDisplayMode === 'grade' ? '等第模式' : '分数模式'}}</view></picker></view>
          <!-- 等第区间编辑器（仅等第模式，每条条款独立配置） -->
          <view wx:if="{{pubViewRuleForm.clauseDisplayMode === 'grade'}}">
            <view class="list-card nested-card">
              <view class="list-title">等第区间配置</view>
              <view class="empty-inline" wx:if="{{!pubViewRuleForm.clauseGradeBands.length}}">暂无等第区间，请点击下方按钮添加</view>
              <view class="question-card grade-band-card" wx:for="{{pubViewRuleForm.clauseGradeBands}}" wx:key="index">
                <view class="question-header" data-index="{{index}}" bindtap="toggleGradeBandExpand">
                  <view class="question-title">
                    <text>等第区间 {{index + 1}}</text>
                    <text class="expand-indicator">{{expandedGradeBandIndex === index ? '▲' : '▼'}}</text>
                  </view>
                </view>
                <!-- Collapsed: colored bubble -->
                <view class="grade-band-collapsed" wx:if="{{expandedGradeBandIndex !== index}}" data-index="{{index}}" bindtap="toggleGradeBandExpand">
                  <view class="grade-band-bubble" style="background: {{gradeBandWxs.getColor(item.gradeName)}};">
                    <text class="grade-band-bubble-name">{{gradeBandWxs.getLabel(item, index)}}</text>
                  </view>
                </view>
                <!-- Expanded: editable fields -->
                <view class="question-fields" wx:if="{{expandedGradeBandIndex === index}}">
                  <view class="field field-row">
                    <view class="field field-half"><view class="field-label">最低分（含）</view><input class="field-input" type="digit" data-index="{{index}}" data-field="minScore" bindinput="onClauseGradeBandInput" value="{{item.minScore}}" placeholder="0" /></view>
                    <view class="field field-half"><view class="field-label">最高分（含）</view><input class="field-input" type="digit" data-index="{{index}}" data-field="maxScore" bindinput="onClauseGradeBandInput" value="{{item.maxScore}}" placeholder="100" /></view>
                  </view>
                  <view class="field"><view class="field-label">等第名称</view><input class="field-input" data-index="{{index}}" data-field="gradeName" bindinput="onClauseGradeBandInput" value="{{item.gradeName}}" placeholder="例如：优秀、良好、合格" /></view>
                  <view class="button-row compact-row"><button class="secondary-btn" data-index="{{index}}" bindtap="removeClauseGradeBand">删除此区间</button></view>
                </view>
              </view>
              <view class="button-row"><button class="secondary-btn" bindtap="addClauseGradeBand">新增等第区间</button><button class="secondary-btn" bindtap="generateClauseDefaultGradeBands">生成默认等第</button></view>
            </view>
          </view>
          <view class="button-row compact-row"><button class="secondary-btn" bindtap="addPubViewClause">{{pubViewRuleForm.clauseEditingIndex >= 0 ? '保存条款' : '加入当前条款'}}</button><button class="secondary-btn" bindtap="cancelPubViewClauseEdit">取消编辑</button></view>
        </view>

        <view class="list-card rule-list-card">
          <view class="rule-list-toolbar"><view><view class="list-title">查看权限类别列表</view><view class="rule-panel-subtitle">筛选只影响当前显示，不影响权限本身</view></view><view class="rule-list-count">{{pubViewRuleListView.length}} / {{pubViewRuleList.length}}</view></view>

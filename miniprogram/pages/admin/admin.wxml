            <view class="picker-value">{{hrForm.workGroup || ((!hrForm.departmentId && !hrForm.department) ? '请先选择所属部门' : '请选择工作分工（职能组）')}}</view>
          </picker>
        </view>
        <view class="button-row compact-row">
          <button class="primary-btn" loading="{{loadingMap.saveHr}}" bindtap="saveHr">保存成员</button>
          <button class="secondary-btn" bindtap="resetHrForm">重置</button>
        </view>
      </view>

      <view class="edit-box" wx:if="{{showTemplateConfig}}">
        <view class="edit-box-header">
          <view class="list-title">模板配置</view>
          <text class="link" bindtap="toggleTemplateConfig">收起</text>
        </view>
        <view class="template-section-tip">基础敏感字段仍由后台统一维护，模板只负责扩展资料采集。</view>
        <view class="field">
          <view class="field-label">填写说明</view>
          <textarea class="field-textarea" auto-height maxlength="-1" data-field="description" bindinput="onHrProfileTemplateInput" value="{{hrProfileTemplateForm.description}}" placeholder="告诉普通用户这份人事信息用于什么、如何填写" />
        </view>
        <view class="field">
          <view class="field-label">修改模式</view>
          <picker range="{{profileEditModeOptions}}" range-key="label" bindchange="onHrProfileEditModeChange">
            <view class="picker-value">{{hrProfileTemplateForm.editModeLabel}}</view>
          </picker>
        </view>
        <view class="list-card nested-card">
          <view class="list-title">扩展字段</view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y lower-threshold="80" bindscrolltolower="loadMoreScoreResults">
            <view class="question-card" wx:for="{{hrProfileTemplateForm.fields}}" wx:key="id">
              <view class="question-title">字段 {{index + 1}}</view>
              <view class="field">
                <view class="field-label">字段名称</view>
                <input class="field-input" data-index="{{index}}" data-field="label" bindinput="onHrProfileFieldInput" value="{{item.label}}" placeholder="例如：宿舍号 / 籍贯 / 年级" />
              </view>
              <view class="field">
                <view class="field-label">字段类型</view>
                <picker range="{{profileFieldTypeOptions}}" range-key="label" bindchange="onHrProfileFieldTypeChange" data-index="{{index}}">
                  <view class="picker-value">{{item.typeLabel}}</view>
                </picker>
              </view>
              <view class="field">
                <view class="field-label">是否必填</view>
                <switch checked="{{item.required}}" color="#2563eb" data-index="{{index}}" bindchange="onHrProfileFieldRequiredChange" />
              </view>
              <view class="field field-row" wx:if="{{item.type === 'text'}}">
                <view class="field field-half">
                  <view class="field-label">最短长度</view>
                  <input class="field-input" data-index="{{index}}" data-field="minLength" bindinput="onHrProfileFieldInput" value="{{item.minLength}}" placeholder="可留空" />
                </view>
                <view class="field field-half">
                  <view class="field-label">最大长度</view>
                  <input class="field-input" data-index="{{index}}" data-field="maxLength" bindinput="onHrProfileFieldInput" value="{{item.maxLength}}" placeholder="可留空" />
                </view>
              </view>
              <view wx:if="{{item.type === 'number'}}">
                <view class="field">
                  <view class="field-label">数字限制方式</view>
                  <picker range="{{numberRuleOptions}}" range-key="label" bindchange="onHrProfileNumberRuleChange" data-index="{{index}}">
                    <view class="picker-value">{{item.numberRuleLabel}}</view>
                  </picker>
                </view>
                <view class="field">
                  <view class="field-label">允许小数</view>
                  <switch checked="{{item.allowDecimal}}" color="#2563eb" data-index="{{index}}" bindchange="onHrProfileFieldAllowDecimalChange" />
                </view>
                <view class="field field-row" wx:if="{{item.numberRule === 'value_range'}}">
                  <view class="field field-half">
                    <view class="field-label">最小值</view>
                    <input class="field-input" data-index="{{index}}" data-field="minValue" bindinput="onHrProfileFieldInput" value="{{item.minValue}}" placeholder="可留空" />
                  </view>
                  <view class="field field-half">
                    <view class="field-label">最大值</view>
                    <input class="field-input" data-index="{{index}}" data-field="maxValue" bindinput="onHrProfileFieldInput" value="{{item.maxValue}}" placeholder="可留空" />
                  </view>
                </view>
                <view class="field field-row" wx:if="{{item.numberRule === 'length_range'}}">
                  <view class="field field-half">
                    <view class="field-label">最短长度</view>
                    <input class="field-input" data-index="{{index}}" data-field="minDigits" bindinput="onHrProfileFieldInput" value="{{item.minDigits}}" placeholder="可留空" />
                  </view>
                  <view class="field field-half">
                    <view class="field-label">最长长度</view>
                    <input class="field-input" data-index="{{index}}" data-field="maxDigits" bindinput="onHrProfileFieldInput" value="{{item.maxDigits}}" placeholder="可留空" />
                  </view>
                </view>
              </view>
              <view class="field" wx:if="{{item.type === 'sequence'}}">
                <view class="field-label">序列选项</view>
                <textarea class="field-textarea question-textarea" auto-height maxlength="-1" data-index="{{index}}" data-field="optionsText" bindinput="onHrProfileFieldInput" value="{{item.optionsText}}" placeholder="每行一个选项，例如：&#10;本科&#10;硕士&#10;博士" />
              </view>
              <view class="button-row compact-row">
                <button class="secondary-btn" data-index="{{index}}" bindtap="removeHrProfileField">删除字段</button>
              </view>
            </view>
          </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
        </view>
        <view class="button-row">
          <button class="secondary-btn" bindtap="addHrProfileField">新增字段</button>
          <button class="secondary-btn" loading="{{loadingMap.importTemplateFieldsCsv}}" bindtap="importTableFields">导入表格字段</button>
          <button class="primary-btn template-save-btn" loading="{{loadingMap.saveProfileTemplate}}" bindtap="saveHrProfileTemplate">保存模板配置</button>
        </view>
      </view>

      <view class="list-card">
        <view class="list-card-header">
          <view class="list-title">成员资料</view>
          <view class="hint-text">点击成员卡片查看/编辑完整信息</view>
        </view>
        <view class="filter-row">
          <view class="field field-half">
            <view class="field-label">部门</view>
            <picker range="{{hrProfileFilterOptions.departments}}" bindchange="onHrProfileFilterChange" data-field="departments">
              <view class="picker-value">{{hrProfileFilters.department}}</view>
            </picker>
          </view>
          <view class="field field-half">
            <view class="field-label">身份</view>
            <picker range="{{hrProfileFilterOptions.identities}}" bindchange="onHrProfileFilterChange" data-field="identities">
              <view class="picker-value">{{hrProfileFilters.identity}}</view>
            </picker>
          </view>
        </view>
        <view class="filter-row">
          <view class="field field-half">
            <view class="field-label">工作分工（职能组）</view>
            <picker range="{{hrProfileFilterOptions.workGroups}}" bindchange="onHrProfileFilterChange" data-field="workGroups">
              <view class="picker-value">{{hrProfileFilters.workGroup !== '无' ? hrProfileFilters.workGroup : (hrProfileFilters.department === '全部部门' ? '请先选择所属部门' : '请选择工作分工（职能组）')}}</view>
            </picker>
          </view>
          <view class="field field-half">
            <view class="field-label">审核状态</view>
            <picker range="{{hrProfileFilterOptions.statuses}}" bindchange="onHrProfileFilterChange" data-field="statuses">
              <view class="picker-value">{{hrProfileFilters.status}}</view>
            </picker>
          </view>
        </view>
        <view class="field">
          <view class="field-label">搜索</view>
          <input class="field-input search-input" bindinput="onHrProfileKeywordInput" value="{{_hrInfoKeywordInput}}" placeholder="输入姓名或学号搜索..." />
        </view>
        <view class="button-row compact-row">
          <button class="secondary-btn" bindtap="resetHrProfileFilters">重置筛选</button>
        </view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y lower-threshold="80" bindscrolltolower="loadMoreScoreResults">
          <view class="card-loading-overlay" wx:if="{{loadingMap.hr}}">
            <view class="card-loading-spinner"></view>
          </view>
          <block wx:else>
          <view class="hr-member-card" wx:for="{{hrProfileRows}}" wx:key="id" data-hr-id="{{item.id}}" bindtap="openHrPersonDetail">
            <view class="hr-member-main">
              <view class="hr-member-top">
                <view class="hr-member-name">{{item.name}}</view>
                <view class="status-chip {{item.auditStatus === 'pending' ? 'pending-chip' : item.auditStatus === 'approved' ? 'current-chip' : item.auditStatus === 'rejected' ? 'rejected-chip' : 'none-chip'}}">{{item.auditStatusText}}</view>
              </view>
              <view class="hr-member-meta">
                <text class="hr-member-id">{{item.studentId}}</text>
                <text class="hr-member-sep">|</text>
                <text>{{item.department}}</text>
                <text class="hr-member-sep">|</text>
                <text>{{item.identity}}</text>
                <text wx:if="{{item.workGroup}}" class="hr-member-sep">|</text>
                <text wx:if="{{item.workGroup}}">{{item.workGroup}}</text>
              </view>
              <view class="hr-member-summary">{{item.currentSummary}}</view>
              <view class="hr-member-pending" wx:if="{{item.pendingSummary}}">待审核：{{item.pendingSummary}}</view>
              <view class="hr-member-reject" wx:if="{{item.rejectionReason}}">驳回原因：{{item.rejectionReason}}</view>
            </view>
            <view class="hr-member-actions" wx:if="{{item.hasPending}}" catchtap>
              <text class="link" data-student-id="{{item.studentId}}" bindtap="approveHrProfileChange">通过</text>
              <text class="link danger" data-student-id="{{item.studentId}}" bindtap="rejectHrProfileChange">驳回</text>
            </view>
            <view class="hr-member-arrow">›</view>
          </view>
          <view class="empty-inline" wx:if="{{!loadingMap.hr && !hrProfileRows.length}}">暂无成员资料</view>
          </block>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
      </view>
    </view>

    <view class="modal-mask" wx:if="{{showHrPersonDetail}}" bindtap="closeHrPersonDetail">
      <view class="modal-card detail-modal" catchtap>
        <view class="modal-header">
          <view class="modal-title">人事详情</view>
          <view class="modal-close" bindtap="closeHrPersonDetail">✕</view>
        </view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="modal-body detail-body" scroll-y wx:if="{{!loadingDetailHr}}">
          <view class="detail-section">
            <view class="detail-section-title">基本信息</view>
            <view class="field">
              <view class="field-label">姓名</view>
              <input class="field-input" data-field="_name" bindinput="onDetailBasicFieldInput" value="{{detailHrValues._name}}" placeholder="姓名" />
            </view>
            <view class="field">
              <view class="field-label">学号</view>
              <input class="field-input" data-field="_studentId" bindinput="onDetailBasicFieldInput" value="{{detailHrValues._studentId}}" placeholder="学号" />
            </view>
            <view class="field">
              <view class="field-label">所属部门</view>
              <picker range="{{departmentOptions}}" value="{{detailDepartmentValue}}" bindchange="onDetailDepartmentChange">
                <view class="picker-value">{{detailHrValues._departmentName || '请选择部门'}}</view>
              </picker>
            </view>
            <view class="field">
              <view class="field-label">身份</view>
              <picker range="{{identityOptions}}" value="{{detailIdentityValue}}" bindchange="onDetailIdentityChange">
                <view class="picker-value">{{detailHrValues._identityName || '请选择身份'}}</view>
              </picker>
            </view>
            <view class="field">
              <view class="field-label">工作分工（职能组）</view>
              <picker range="{{detailWorkGroupOptions}}" value="{{detailWorkGroupValue}}" bindchange="onDetailWorkGroupChange">
                <view class="picker-value">{{detailHrValues._workGroupName || (!detailHrValues._departmentId ? '请先选择所属部门' : '请选择工作分工（职能组）')}}</view>
              </picker>
            </view>
          </view>
          <view class="detail-section" wx:if="{{detailHrTemplate && detailHrTemplate.fields && detailHrTemplate.fields.length}}">
            <view class="detail-section-title">扩展资料</view>
            <block wx:for="{{detailHrTemplate.fields}}" wx:key="id">
              <view class="field">
                <view class="field-label">{{item.label}}<text wx:if="{{item.required}}" class="required-mark"> *</text></view>
                <block wx:if="{{item.type === 'sequence'}}">
                  <picker range="{{item.options}}" value="{{detailFieldValues[item.id]}}" bindchange="onDetailProfileFieldInput" data-field="{{item.id}}">
                    <view class="picker-value">{{detailHrValues[item.id] || '请选择'}}</view>
                  </picker>
                </block>
                <block wx:elif="{{item.type === 'date'}}">
                  <picker mode="date" bindchange="onDetailProfileFieldInput" data-field="{{item.id}}">
                    <view class="picker-value">{{detailHrValues[item.id] || '请选择日期'}}</view>
                  </picker>
                </block>
                <block wx:elif="{{item.type === 'number'}}">
                  <input class="field-input" type="digit" data-field="{{item.id}}" bindinput="onDetailProfileFieldInput" value="{{detailHrValues[item.id]}}" placeholder="请输入数字" />
                </block>
                <block wx:elif="{{item.type === 'phone'}}">
                  <input class="field-input" type="number" maxlength="11" data-field="{{item.id}}" bindinput="onDetailProfileFieldInput" value="{{detailHrValues[item.id]}}" placeholder="请输入手机号" />
                </block>
                <block wx:elif="{{item.type === 'email'}}">
                  <input class="field-input" data-field="{{item.id}}" bindinput="onDetailProfileFieldInput" value="{{detailHrValues[item.id]}}" placeholder="请输入邮箱" />
                </block>
                <block wx:else>
                  <input class="field-input" data-field="{{item.id}}" bindinput="onDetailProfileFieldInput" value="{{detailHrValues[item.id]}}" placeholder="请输入{{item.label}}" />
                </block>
                <view class="field-hint" wx:if="{{item.hintText}}">{{item.hintText}}</view>
              </view>
            </block>
          </view>
          <view class="detail-section pending-section" wx:if="{{detailHrHasPending}}">
            <view class="detail-section-title">待审核资料</view>
            <view class="pending-list">
              <block wx:for="{{detailHrTemplate.fields}}" wx:key="id" wx:if="{{detailHrPendingValues[item.id]}}">
                <view class="pending-item">
                  <text class="pending-label">{{item.label}}：</text>
                  <text class="pending-value">{{detailHrPendingValues[item.id]}}</text>
                </view>
              </block>
            </view>
            <view class="button-row compact-row">
              <button class="primary-btn" bindtap="approveDetailHrProfile">通过审核</button>
              <button class="danger-btn" bindtap="rejectDetailHrProfile">驳回</button>
            </view>
          </view>
          <view class="button-row detail-buttons">
            <button class="primary-btn" loading="{{savingDetailHr}}" bindtap="saveHrPersonDetail">保存</button>
            <button class="secondary-btn" bindtap="closeHrPersonDetail">取消</button>
          </view>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
        <view class="modal-body" wx:if="{{loadingDetailHr}}">
          <view class="loading-inline">加载中...</view>
        </view>
      </view>
    </view>

    <!-- CSV column mapping dialog -->
    <view class="modal-mask" wx:if="{{showCsvMappingDialog}}" bindtap="closeCsvMappingDialog">
      <view class="modal-card csv-mapping-card" catchtap>
        <view class="modal-header">
          <view class="modal-title">表格字段映射</view>
          <view class="modal-close" bindtap="closeCsvMappingDialog">✕</view>
        </view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="modal-body csv-mapping-body" scroll-y>
          <view class="csv-mapping-tip">请将表格列名匹配到对应字段。自动识别的类型和示例值仅供参考。</view>
          <view class="csv-mapping-row csv-mapping-row-header">
            <view class="csv-mapping-col csv-mapping-col-csv">表格列名</view>
            <view class="csv-mapping-col csv-mapping-col-type">字段类型</view>
            <view class="csv-mapping-col csv-mapping-col-sample">示例值</view>
            <view class="csv-mapping-col csv-mapping-col-target">映射到</view>
          </view>
          <view class="csv-mapping-row" wx:for="{{csvImportRows}}" wx:key="header">
            <view class="csv-mapping-col csv-mapping-col-csv">{{item.header}}</view>
            <view class="csv-mapping-col csv-mapping-col-type">
              <view class="csv-mapping-type-tag">{{item.fieldTypeLabel}}</view>
            </view>
            <view class="csv-mapping-col csv-mapping-col-sample">{{item.sampleValue || '—'}}</view>
            <view class="csv-mapping-col csv-mapping-col-target">
              <picker range="{{csvImportMappingLabels}}"
                      mode="selector" data-index="{{index}}"
                      bindchange="onCsvMappingTargetChange"
                      value="{{item.optionIndex}}">
                <view class="csv-mapping-picker-value">{{item.optionLabel}}</view>
              </picker>
            </view>
          </view>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
        <view class="csv-skip-invalid-row">
          <view class="csv-skip-invalid-label">
            <text>字段无效时仍然导入</text>
            <text class="csv-skip-invalid-desc">开启后，格式不正确的字段将被跳过，其余数据正常导入</text>
          </view>
          <switch checked="{{csvImportSkipInvalid}}" bindchange="toggleCsvSkipInvalid" color="#2563eb"/>
        </view>
        <view class="modal-footer">
          <button class="secondary-btn" bindtap="closeCsvMappingDialog">取消</button>
          <button class="primary-btn" loading="{{csvImportLoading}}" bindtap="confirmCsvMapping">确认导入</button>
        </view>
      </view>
    </view>

    <!-- Validation errors dialog -->
    <view class="modal-mask" wx:if="{{showValidationErrors}}" bindtap="closeValidationErrors">
      <view class="modal-card validation-errors-card" catchtap>
        <view class="modal-header">
          <view class="modal-title">数据校验失败</view>
          <view class="modal-close" bindtap="closeValidationErrors">✕</view>
        </view>
        <view class="validation-errors-summary">{{validationErrorSummary}}，请修正后重新导入</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="modal-body validation-errors-body" scroll-y>
          <view class="validation-error-card" wx:for="{{validationErrorCards}}" wx:key="studentId">
            <view class="ve-card-top">
              <view class="ve-card-name">{{item.name || '—'}}</view>
              <view class="ve-card-sid">{{item.studentId}}</view>
            </view>
            <view class="ve-card-errors">
              <view class="ve-error-item" wx:for="{{item.errors}}" wx:key="index" wx:for-item="err">
                <view class="ve-error-label">
                  <text class="ve-error-field">{{err.fieldName}}</text>
                  <text class="ve-error-type-tag">{{err.fieldType}}</text>
                </view>
                <view class="ve-error-detail">
                  <text class="ve-error-reason">{{err.errorReason}}</text>
                  <text class="ve-error-value" wx:if="{{err.errorValue}}">当前值：{{err.errorValue}}</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
        <view class="modal-footer">
          <button class="secondary-btn" bindtap="downloadErrorTable">导出错误清单</button>
          <button class="primary-btn" bindtap="closeValidationErrors">知道了</button>
        </view>
      </view>
    </view>


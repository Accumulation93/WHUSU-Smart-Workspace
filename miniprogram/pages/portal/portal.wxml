<view class="page">
  <view class="hero">
    <view class="hero-badge">{{heroIdentity}}</view>
    <view class="hero-title">{{heroName}}</view>
    <view class="hero-subtitle">欢迎使用 REDSU 智慧工作台系统</view>
  </view>

  <view class="card" wx:if="{{organizationName}}">
    <view class="info-head">
      <view class="section-title">当前组织</view>
    </view>
    <view class="activity-name">{{organizationName}}</view>
  </view>

  <view class="card" wx:if="{{hasUser}}">
    <view class="info-head">
      <view class="section-title">个人信息</view>
    </view>
    <view class="info-grid">
      <view class="info-block">
        <view class="info-label">姓名</view>
        <view class="info-value">{{heroName}}</view>
      </view>
      <view class="info-block">
        <view class="info-label">身份</view>
        <view class="info-value">{{heroIdentity}}</view>
      </view>
      <view class="info-block info-block-full" wx:if="{{userDepartment}}">
        <view class="info-label">部门</view>
        <view class="info-value">{{userDepartment}}</view>
      </view>
      <view class="info-block info-block-full" wx:if="{{showWorkGroup}}">
        <view class="info-label">工作分工（职能组）</view>
        <view class="info-value">{{userWorkGroup}}</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{hasUser}}">
    <view class="info-head">
      <view class="section-title">待办事项</view>
      <view class="todo-count" wx:if="{{todoCount > 0}}">共 {{todoCount > 99 ? '99+' : todoCount}} 条</view>
    </view>
    <view class="notification-list">
      <view class="notification-empty" wx:if="{{!todos.length && !todoLoading}}">
        <text class="notification-empty-text">暂无待处理事项</text>
      </view>
      <view class="notification-item todo-item" wx:for="{{todos}}" wx:key="targetId"
            data-url="{{item.targetUrl}}" bindtap="onTodoTap">
        <view class="notification-icon">{{item.category === 'venue' ? '🏟️' : '⏳'}}</view>
        <view class="notification-body">
          <view class="notification-title">
            <text class="notification-tag notification-tag-{{item.category}}">{{item.category === 'venue' ? '场地' : '审核'}}</text>
            {{item.title}}
          </view>
          <view class="notification-desc" wx:if="{{item.description}}">{{item.description}}</view>
          <view class="notification-time">{{item.createdAt}}</view>
        </view>
        <text class="nav-row-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{hasUser}}">
    <view class="info-head">
      <view class="section-title">通知</view>
      <view class="notification-badge" wx:if="{{notificationCount > 0}}">{{notificationCount > 99 ? '99+' : notificationCount}}</view>
    </view>
    <view class="notification-list">
      <view class="notification-empty" wx:if="{{!notifications.length && !notificationLoading}}">
        <text class="notification-empty-text">暂无通知</text>
      </view>
      <view class="notification-swipe-row" wx:for="{{notifications}}" wx:key="id">
        <view class="notification-item {{item.isRead ? 'notification-read' : 'notification-unread'}} {{item._showDelete ? 'notification-shifted' : ''}}"
              style="transform: translateX({{item._swipeX || 0}}px);"
              data-id="{{item.id}}" data-url="{{item.targetUrl}}"
              bindtap="onNotificationTap"
              bindtouchstart="onNotificationTouchStart"
              bindtouchmove="onNotificationTouchMove"
              bindtouchend="onNotificationTouchEnd">
          <view class="notification-dot" wx:if="{{!item.isRead}}"></view>
          <view class="notification-icon">{{item.category === 'venue' ? '🏟️' : (item.category === 'scoring' ? '📊' : '🔔')}}</view>
          <view class="notification-body">
            <view class="notification-title">
              <text class="notification-tag notification-tag-{{item.category}}">{{item.category === 'venue' ? '场地' : (item.category === 'scoring' ? '考核' : '通知')}}</text>
              {{item.title}}
            </view>
            <view class="notification-desc" wx:if="{{item.description}}">{{item.description}}</view>
            <view class="notification-time">{{item.createdAt}}</view>
          </view>
          <text class="nav-row-arrow">›</text>
        </view>
        <view class="notification-delete" wx:if="{{item._showDelete}}" data-id="{{item.id}}" catchtap="deleteNotification">删除</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="info-head">
      <view class="section-title">应用服务</view>
      <view class="app-view-tabs">
        <view class="app-view-tab {{appViewMode === 'grid' ? 'app-view-tab-active' : ''}}"
              data-mode="grid" bindtap="switchAppView">宫格</view>
        <view class="app-view-tab {{appViewMode === 'list' ? 'app-view-tab-active' : ''}}"
              data-mode="list" bindtap="switchAppView">列表</view>
      </view>
    </view>

    <!-- Search bar -->
    <view class="app-search-bar">
      <view class="app-search-icon">🔍</view>
      <input class="app-search-input"
             placeholder="搜索应用…"
             value="{{appSearchKeyword}}"
             bindinput="onAppSearchInput"
             confirm-type="search"/>
      <view class="app-search-clear" wx:if="{{appSearchKeyword}}" bindtap="clearAppSearch">✕</view>
    </view>

    <!-- No results -->
    <view class="notification-empty" wx:if="{{!filteredPortalCards.length}}">
      <text class="notification-empty-text">{{appSearchKeyword ? '没有匹配的应用' : '暂无应用'}}</text>
    </view>

    <!-- ═══ Grid View (宫格) ═══ -->
    <view class="app-grid" wx:if="{{appViewMode === 'grid' && filteredPortalCards.length}}">
      <view class="app-grid-item {{item.disabled ? 'app-grid-item-disabled' : ''}}"
            wx:for="{{filteredPortalCards}}" wx:key="key"
            wx:for-item="item" wx:for-index="i"
            style="animation: glassFadeUp 0.42s {{0.05 * i}}s ease both;"
            data-key="{{item.key}}"
            bindtap="onCardTap">
        <view class="app-grid-icon">{{item.icon}}</view>
        <view class="app-grid-label">{{item.label}}</view>
        <view class="app-grid-desc">{{item.desc}}</view>
        <view class="app-grid-badge" wx:if="{{item.disabled}}">开发中</view>
      </view>
    </view>

    <!-- ═══ List View (列表) ═══ -->
    <view class="nav-list" wx:if="{{appViewMode === 'list' && filteredPortalCards.length}}">
      <view
        class="nav-row {{item.disabled ? 'nav-row-disabled' : ''}}"
        wx:for="{{filteredPortalCards}}"
        wx:key="key"
        wx:for-item="item"
        wx:for-index="i"
        style="animation: glassFadeUp 0.42s {{0.06 * i}}s ease both;"
        data-key="{{item.key}}"
        bindtap="onCardTap"
      >
        <view class="nav-row-icon">{{item.icon}}</view>
        <view class="nav-row-body">
          <view class="nav-row-label">{{item.label}}</view>
          <view class="nav-row-desc">{{item.desc}}</view>
        </view>
        <view class="nav-row-badge" wx:if="{{item.disabled}}">开发中</view>
        <text class="nav-row-arrow" wx:if="{{!item.disabled}}">›</text>
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="secondary-btn" bindtap="goLogin">切换身份</button>
    <button class="danger-btn" wx:if="{{hasUser}}" bindtap="openUnbindDialog">解绑当前身份</button>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU 智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>

  <view class="dialog-layer" wx:if="{{showUnbindDialog}}">
    <view class="dialog-mask" bindtap="closeUnbindDialog"></view>
    <view class="dialog-panel">
      <view class="dialog-badge">危险操作</view>
      <view class="dialog-title">确认解绑当前身份？</view>
      <view class="dialog-desc">解绑后会立即移除当前身份的登录状态，后续如需进入，需要重新完成验证。</view>
      <view class="dialog-actions">
        <button class="secondary-btn dialog-btn" bindtap="closeUnbindDialog">再想想</button>
        <button class="danger-btn dialog-btn" loading="{{unbindLoading}}" bindtap="confirmUnbind">确认解绑</button>
      </view>
    </view>
  </view>
</view>

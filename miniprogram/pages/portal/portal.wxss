/* ═══════════════════════════════════════════════
   Portal Page — same glass-morphism design
   as home page (matching home.wxss exactly)
   ═══════════════════════════════════════════════ */

page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
  color: #1f2a37;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

button, input, textarea, picker, view, text, scroll-view {
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 30rpx 24rpx 42rpx;
  box-sizing: border-box;
}

.page::before {
  content: "";
  position: fixed;
  top: -120rpx; right: -90rpx;
  width: 320rpx; height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.18) 0%, rgba(96, 165, 250, 0) 72%);
  pointer-events: none;
}

.page::after {
  content: "";
  position: fixed;
  left: -120rpx; bottom: 150rpx;
  width: 280rpx; height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(147, 197, 253, 0.16) 0%, rgba(147, 197, 253, 0) 72%);
  pointer-events: none;
}

/* ── Hero (exact copy from home.wxss lines 53-130) ── */
.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 44rpx 34rpx 40rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.98) 0%, rgba(59, 130, 246, 0.95) 42%, rgba(96, 165, 250, 0.90) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 24rpx 54rpx rgba(37, 99, 235, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  animation: glassFadeUp 0.42s ease both;
}

.hero::before {
  content: "";
  position: absolute;
  top: -90rpx; right: -35rpx;
  width: 240rpx; height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.hero::after {
  content: "";
  position: absolute;
  left: -90rpx; bottom: -120rpx;
  width: 280rpx; height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-badge, .hero-title, .hero-subtitle {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.14) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #f8fbff;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  backdrop-filter: blur(14rpx);
  -webkit-backdrop-filter: blur(14rpx);
}

.hero-title {
  color: #ffffff;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.24;
  letter-spacing: 1rpx;
  text-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  line-height: 1.72;
}

/* ── Card (exact copy from home.wxss lines 132-147) ── */
.card {
  position: relative;
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.80) 0%, rgba(248, 251, 255, 0.72) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow:
    0 18rpx 36rpx rgba(15, 23, 42, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-sizing: border-box;
  animation: glassFadeUp 0.46s ease both;
}

/* ── Info-head + section-title (exact copy from home.wxss) ── */
.info-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-title {
  position: relative;
  padding-left: 20rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.2rpx;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 7rpx; height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
}

/* ── Activity-name (for org name display) ── */
.activity-name {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  margin-bottom: 10rpx;
  padding: 8rpx 4rpx 6rpx;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.48;
  letter-spacing: 0.2rpx;
  word-break: break-word;
}

.activity-name::after {
  content: "";
  display: block;
  width: 72rpx;
  height: 4rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(59, 130, 246, 0.46), rgba(59, 130, 246, 0.08));
}

/* ── Info grid / info block (exact copy from home.wxss lines 361-399) ── */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20rpx;
}

.info-block {
  width: calc(50% - 10rpx);
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(248, 251, 255, 0.80) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  box-shadow:
    0 10rpx 24rpx rgba(15, 23, 42, 0.035),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  box-sizing: border-box;
}

.info-block-full {
  width: 100%;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.6) 0%, rgba(219, 234, 254, 0.4) 100%);
  border: 1rpx solid rgba(191, 219, 254, 0.6);
}

.info-label {
  margin-bottom: 10rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.5;
}

.info-value {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
  word-break: break-all;
}

/* ── Navigation rows inside card ── */
.nav-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.nav-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(246, 249, 255, 0.78) 100%);
  border: 1rpx solid rgba(219, 229, 241, 0.82);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.nav-row:active {
  transform: translateY(1rpx) scale(0.992);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.nav-row-disabled {
  opacity: 0.50;
}

.nav-row-disabled:active {
  transform: none;
}

.nav-row-icon {
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}

.nav-row-body {
  flex: 1;
  min-width: 0;
}

.nav-row-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.nav-row-desc {
  font-size: 21rpx;
  color: #94a3b8;
  font-weight: 500;
  line-height: 1.4;
  margin-top: 2rpx;
}

.nav-row-arrow {
  font-size: 34rpx;
  color: #94a3b8;
  font-weight: 300;
  flex-shrink: 0;
}

.nav-row-badge {
  font-size: 18rpx;
  font-weight: 600;
  color: #c2410c;
  background: rgba(255, 237, 213, 0.78);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(253, 186, 116, 0.48);
  flex-shrink: 0;
}

/* ── Actions (exact copy from home.wxss lines 661-742) ── */
.actions {
  margin-top: 14rpx;
  padding-bottom: 12rpx;
}

.actions button {
  position: relative;
  overflow: hidden;
  height: 94rpx;
  line-height: 94rpx;
  margin-bottom: 20rpx;
  border: none;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  box-shadow:
    0 16rpx 30rpx rgba(15, 23, 42, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.actions button::after { border: none; }

.actions button::before {
  content: "";
  position: absolute;
  top: 0; left: -120%;
  width: 72%; height: 100%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.24) 50%, rgba(255, 255, 255, 0) 100%);
}

.primary-btn, .secondary-btn, .danger-btn {
  flex: 1 1 280rpx;
  min-width: 220rpx;
  min-height: 84rpx;
  border-radius: 999rpx;
  line-height: 84rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0 32rpx;
  letter-spacing: 0.3rpx;
  transition: box-shadow 0.24s ease, opacity 0.18s ease, filter 0.24s ease, transform 0.18s ease;
}

.primary-btn {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 45%, #60a5fa 100%);
  color: #ffffff;
  box-shadow:
    0 20rpx 34rpx rgba(37, 99, 235, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.secondary-btn {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(246, 249, 255, 0.88) 100%);
  color: #1e293b;
  border: 1rpx solid rgba(219, 229, 241, 0.96);
  box-shadow:
    0 10rpx 22rpx rgba(15, 23, 42, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
}

.danger-btn {
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #ffffff;
  box-shadow:
    0 16rpx 30rpx rgba(239, 68, 68, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.primary-btn:active, .secondary-btn:active, .danger-btn:active {
  transform: translateY(2rpx) scale(0.985);
  opacity: 0.94;
  filter: saturate(1.03);
}

/* ── Footer ── */
.page-footer {
  text-align: center;
  padding: 20rpx 0;
}

.footer-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #94a3b8;
}

.footer-org {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* ── Notification Card ── */
.notification-badge {
  flex-shrink: 0; min-width: 40rpx; height: 40rpx; padding: 0 10rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(254,242,242,0.94) 0%, rgba(254,226,226,0.84) 100%);
  color: #dc2626; font-size: 22rpx; font-weight: 800;
  border: 1rpx solid rgba(252,165,165,0.5);
}

.todo-count {
  flex-shrink: 0;
  min-width: 64rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(239,246,255,0.96) 0%, rgba(219,234,254,0.86) 100%);
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
  border: 1rpx solid rgba(147,197,253,0.5);
}

.notification-list {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; gap: 8rpx;
}

.notification-item {
  position: relative;
  z-index: 1;
  display: flex; align-items: center; gap: 14rpx;
  padding: 18rpx 16rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.82) 0%, rgba(246,249,255,0.72) 100%);
  border: 1rpx solid rgba(219,229,241,0.76);
  transition: transform 0.14s ease;
}

.todo-item {
  border-color: rgba(147,197,253,0.42);
}

.notification-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}

.notification-shifted {
  transform: translateX(-72px);
}

.notification-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 72px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 16rpx 0;
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  z-index: 0;
}

.notification-unread {
  background: linear-gradient(135deg, rgba(255,255,255,0.96) 0%, rgba(239,246,255,0.84) 100%);
  border-color: rgba(147,197,253,0.55);
}

.notification-read {
  opacity: 0.78;
}

.notification-dot {
  position: absolute;
  top: 14rpx;
  left: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 0 6rpx rgba(239,68,68,0.10);
}

.notification-item:active {
  transform: translateY(1rpx) scale(0.992);
}

.notification-swipe-row .notification-item[style*="translateX"]:active {
  opacity: 0.96;
}

.notification-icon {
  flex-shrink: 0; width: 56rpx; height: 56rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  background: linear-gradient(135deg, rgba(239,246,255,0.94) 0%, rgba(219,234,254,0.84) 100%);
  border: 1rpx solid rgba(147,197,253,0.4);
}

.notification-body {
  flex: 1; min-width: 0;
}

.notification-title {
  color: #0f172a; font-size: 26rpx; font-weight: 700;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.notification-desc {
  color: #64748b; font-size: 21rpx; margin-top: 2rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.notification-time {
  color: #94a3b8; font-size: 19rpx; margin-top: 4rpx;
}

.notification-empty {
  text-align: center; padding: 24rpx 0;
}

.notification-empty-text {
  color: #94a3b8; font-size: 24rpx;
}

/* ── Dialog (exact copy from home.wxss lines 761-828) ── */
.dialog-layer {
  position: fixed;
  inset: 0;
  z-index: 99;
}

.dialog-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.34);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
}

.dialog-panel {
  position: absolute;
  left: 56rpx; right: 56rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 28rpx 26rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 251, 255, 0.9) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 22rpx 44rpx rgba(15, 23, 42, 0.14);
}

.dialog-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.94) 0%, rgba(191, 219, 254, 0.86) 100%);
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.dialog-title {
  margin-top: 18rpx;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.dialog-desc {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.72;
}

.dialog-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.dialog-btn {
  flex: 1;
  height: 82rpx !important;
  line-height: 82rpx !important;
  margin-bottom: 0 !important;
  border-radius: 18rpx !important;
  font-size: 26rpx !important;
}

/* ── Animation (exact copy from home.wxss) ── */
@keyframes glassFadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.message-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
}

.message-hero {
  flex: 0 0 auto;
  margin-bottom: 18rpx;
}

.message-tabs {
  flex: 0 0 auto;
  display: flex;
  gap: var(--ui-tab-gap, 8rpx);
  margin-bottom: 14rpx;
  padding: var(--ui-tab-shell-padding, 8rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: var(--ui-tab-shell-radius, 26rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(248,251,255,0.62));
  box-shadow: 0 14rpx 28rpx rgba(15,23,42,0.045), inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.message-tab {
  flex: 1;
  min-height: var(--ui-tab-min-height, 66rpx);
  padding: var(--ui-tab-padding-y, 14rpx) var(--ui-tab-padding-x, 18rpx);
  text-align: center;
  border-radius: var(--ui-tab-radius, 20rpx);
  color: #64748b;
  font-size: var(--ui-tab-font-size, 24rpx);
  line-height: var(--ui-leading-control, 1.35);
  font-weight: 700;
}

.message-tab text {
  margin-left: 8rpx;
  color: #ef4444;
}

.message-tab-active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 12rpx 22rpx rgba(29,78,216,0.18), inset 0 1rpx 0 rgba(255,255,255,0.2);
}

.organization-picker {
  flex: 0 0 auto;
  margin-bottom: 14rpx;
}

.organization-filter {
  display: flex;
  align-items: center;
  min-height: 78rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(219,229,241,0.96);
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(246,249,255,0.84));
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.045), inset 0 1rpx 0 rgba(255,255,255,0.86);
  box-sizing: border-box;
}

.organization-filter-label {
  flex: 0 0 auto;
  margin-right: 20rpx;
  color: #64748b;
  font-size: var(--ui-type-meta, 22rpx);
  font-weight: 700;
}

.organization-filter-value {
  flex: 1;
  min-width: 0;
  color: #1e293b;
  font-size: var(--ui-type-body, 25rpx);
  font-weight: 750;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.partial-notice {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(56,189,248,0.42);
  border-radius: 18rpx;
  color: #0369a1;
  font-size: var(--ui-type-meta, 22rpx);
  font-weight: 650;
  background: linear-gradient(135deg, rgba(240,249,255,0.94), rgba(224,242,254,0.72));
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.82);
}

.message-card {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
}

.message-card-head {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.message-action {
  padding: 9rpx 12rpx;
  border-radius: 12rpx;
  color: #2563eb;
  font-size: var(--ui-type-label, 23rpx);
  font-weight: 700;
}

.message-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.message-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(219,229,241,0.88);
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(249,251,255,0.84));
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.84);
}

.message-main {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.message-row-read {
  opacity: 0.78;
}

.message-row-unread {
  border-color: rgba(147,197,253,0.66);
  background: linear-gradient(135deg, rgba(239,246,255,0.96), rgba(255,255,255,0.86));
}

.message-icon {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(219,234,254,0.82), rgba(239,246,255,0.68));
  border: 1rpx solid rgba(147,197,253,0.46);
}

.message-copy {
  flex: 1;
  min-width: 0;
}

.message-metadata {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.message-category {
  flex: 0 0 auto;
  padding: 5rpx 10rpx;
  border: 1rpx solid rgba(147,197,253,0.58);
  border-radius: 12rpx;
  color: #2563eb;
  font-size: var(--ui-type-caption, 20rpx);
  font-weight: 800;
  line-height: 1.3;
  background: rgba(219,234,254,0.76);
}

.organization-meta {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
  max-width: 100%;
  padding: 5rpx 10rpx;
  border: 1rpx solid rgba(186,210,232,0.72);
  border-radius: 14rpx;
  color: #475569;
  font-size: var(--ui-type-caption, 20rpx);
  font-weight: 700;
  line-height: 1.35;
  background: linear-gradient(135deg, rgba(248,250,252,0.94), rgba(241,245,249,0.78));
  box-sizing: border-box;
}

.organization-meta-current {
  border-color: rgba(147,197,253,0.64);
  color: #2563eb;
  background: linear-gradient(135deg, rgba(239,246,255,0.94), rgba(219,234,254,0.78));
}

.identity-meta {
  padding: 5rpx 10rpx;
  border: 1rpx solid rgba(203,213,225,0.74);
  border-radius: 12rpx;
  color: #64748b;
  font-size: var(--ui-type-micro);
  font-weight: 700;
  line-height: 1.45;
  background: rgba(248,250,252,0.74);
}

.identity-meta-current {
  color: #2563eb;
  border-color: rgba(147,197,253,0.56);
  background: rgba(219,234,254,0.68);
}

.organization-meta-name {
  min-width: 0;
  overflow-wrap: anywhere;
}

.organization-current {
  flex: 0 0 auto;
  color: #2563eb;
  font-size: var(--ui-type-micro, 18rpx);
  font-weight: 800;
}

.message-title {
  color: #0f172a;
  font-size: var(--ui-type-emphasis, 26rpx);
  font-weight: 750;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.message-desc {
  margin-top: 4rpx;
  color: #64748b;
  font-size: var(--ui-type-meta, 22rpx);
  line-height: var(--ui-leading-body, 1.6);
  overflow-wrap: anywhere;
}

.message-time {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: var(--ui-type-caption, 20rpx);
}

.message-delete {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(254,242,242,0.94), rgba(254,226,226,0.76));
  border: 1rpx solid rgba(252,165,165,0.46);
}

.unread-dot {
  position: absolute;
  left: -8rpx;
  top: -4rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 0 5rpx rgba(239,68,68,0.10);
}

.message-empty,
.message-loading {
  padding: 36rpx 20rpx;
  color: #94a3b8;
  font-size: var(--ui-type-control, 24rpx);
  text-align: center;
}

.message-switch-layer {
  z-index: 320;
}

.message-switch-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.34);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
}

.message-switch-dialog {
  position: relative;
  z-index: 1;
  padding: 26rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.98) 0%, rgba(243, 248, 255, 0.95) 100%);
  box-shadow: 0 28rpx 64rpx rgba(15, 23, 42, 0.2), 0 8rpx 24rpx rgba(37, 99, 235, 0.1);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
}

.message-switch-badge {
  display: inline-flex;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(147,197,253,0.64);
  border-radius: 12rpx;
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 800;
  background: rgba(219,234,254,0.76);
}

.message-switch-title {
  margin-top: 16rpx;
  color: #0f172a;
  font-size: var(--ui-type-dialog, 32rpx);
  font-weight: 800;
  line-height: 1.35;
}

.message-switch-desc {
  margin-top: 14rpx;
  color: #64748b;
  font-size: var(--ui-type-label, 23rpx);
  line-height: var(--ui-leading-body, 1.6);
}

.message-switch-org {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(147,197,253,0.58);
  border-radius: 16rpx;
  color: #2563eb;
  font-size: var(--ui-type-body, 25rpx);
  font-weight: 750;
  line-height: 1.45;
  overflow-wrap: anywhere;
  background: linear-gradient(135deg, rgba(239,246,255,0.96), rgba(219,234,254,0.72));
}

.message-switch-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 0;
  background: transparent;
}

.message-dialog-btn {
  flex: 1;
  min-height: 72rpx;
  height: auto;
  margin: 0;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  line-height: 1.35;
}

@media (min-width: 520px) {
  .message-page {
    max-width: 720px;
    margin: 0 auto;
  }

  .message-card {
    padding: 24px;
  }

  .organization-filter {
    min-height: 54px;
    padding: 10px 14px;
    border-radius: 12px;
  }

  .organization-filter-label,
  .organization-filter-value {
    font-size: var(--ui-type-body);
  }

  .organization-filter-label {
    font-size: var(--ui-type-label);
  }

  .message-row {
    padding: 14px;
    border-radius: 14px;
  }

  .organization-meta,
  .message-category {
    border-radius: 9px;
    font-size: var(--ui-type-caption);
  }

  .message-dialog-btn {
    min-height: 44px;
    border-radius: 12px;
    font-size: var(--ui-type-body);
  }

  .message-switch-dialog {
    border-radius: 18px;
    padding: 24px 24px 20px;
  }
}

@media (min-width: 900px) {
  .message-page {
    max-width: 860px;
  }
}

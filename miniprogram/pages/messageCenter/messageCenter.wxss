.message-page { display: flex; flex-direction: column; height: 100vh; min-height: 0; }
.message-hero { flex: 0 0 auto; margin-bottom: 18rpx; }
.message-tabs { flex: 0 0 auto; display: flex; gap: 12rpx; margin-bottom: 18rpx; padding: 8rpx; border: 1rpx solid rgba(191,219,254,.7); border-radius: 20rpx; background: rgba(255,255,255,.7); }
.message-tab { flex: 1; padding: 18rpx; text-align: center; border-radius: 14rpx; color: #64748b; font-size: 25rpx; font-weight: 700; }
.message-tab text { margin-left: 8rpx; color: #ef4444; }
.message-tab-active { color: #2563eb; background: rgba(219,234,254,.78); box-shadow: 0 8rpx 18rpx rgba(37,99,235,.1); }
.message-card { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 24rpx; }
.message-card-head { flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.message-action { color: #2563eb; font-size: 23rpx; font-weight: 700; padding: 10rpx 12rpx; border-radius: 12rpx; }
.message-scroll { flex: 1; min-height: 0; height: 100%; }
.message-list { display: flex; flex-direction: column; gap: 10rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.message-row { position: relative; display: flex; align-items: center; gap: 12rpx; padding: 18rpx; border: 1rpx solid rgba(219,229,241,.8); border-radius: 18rpx; background: rgba(255,255,255,.82); }
.message-main { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; gap: 14rpx; }
.message-row-read { opacity: .76; }
.message-row-unread { border-color: rgba(147,197,253,.65); background: rgba(239,246,255,.82); }
.message-icon { flex: 0 0 auto; width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: rgba(219,234,254,.7); }
.message-copy { flex: 1; min-width: 0; }
.message-title { color: #0f172a; font-size: 26rpx; font-weight: 750; overflow-wrap: anywhere; }
.message-desc { margin-top: 4rpx; color: #64748b; font-size: 22rpx; line-height: 1.45; overflow-wrap: anywhere; }
.message-time { margin-top: 6rpx; color: #94a3b8; font-size: 20rpx; }
.message-delete { flex: 0 0 auto; width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: rgba(254,226,226,.72); }
.unread-dot { position: absolute; left: -8rpx; top: -4rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: #ef4444; }
.message-empty, .message-loading { padding: 56rpx 20rpx; color: #94a3b8; font-size: 24rpx; text-align: center; }
@media (min-width: 520px) { .message-page { max-width: 720px; margin: 0 auto; } .message-card { padding: 24px; } }
@media (min-width: 900px) { .message-page { max-width: 860px; } }

<view class="page message-page">
  <view class="hero message-hero">
    <view class="hero-badge">消息中心</view>
    <view class="hero-title">待办与通知</view>
  </view>

  <view class="message-tabs">
    <view class="message-tab {{activeTab === 'todos' ? 'message-tab-active' : ''}} ui-motion-chip" data-tab="todos" bindtap="switchTab" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">
      待办 <text wx:if="{{todoTotal}}">{{todoTotal}}</text>
    </view>
    <view class="message-tab {{activeTab === 'notifications' ? 'message-tab-active' : ''}} ui-motion-chip" data-tab="notifications" bindtap="switchTab" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">
      通知 <text wx:if="{{unreadCount}}">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
    </view>
  </view>

  <view class="card message-card">
    <view class="message-card-head">
      <view class="section-title">{{activeTab === 'todos' ? '当前待办' : '全部通知'}}</view>
      <view class="message-action ui-motion-chip" wx:if="{{activeTab === 'notifications' && unreadCount > 0}}" bindtap="markAllRead" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">全部已读</view>
    </view>
    <scroll-view class="message-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" bindscrolltolower="loadMore" lower-threshold="100">
      <view class="message-empty" wx:if="{{!loading && activeTab === 'todos' && !todos.length}}">暂无待处理事项</view>
      <view class="message-empty" wx:if="{{!loading && activeTab === 'notifications' && !notifications.length}}">暂无通知</view>

      <view wx:if="{{activeTab === 'todos'}}" class="message-list">
        <view class="message-row ui-motion-card" wx:for="{{todos}}" wx:key="id" data-url="{{item.targetUrl}}" bindtap="onTodoTap" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">
          <view class="message-icon"><ui-icon name="clock" tone="primary" size="38" ariaLabel="待办" /></view>
          <view class="message-copy">
            <view class="message-title">{{item.title}}</view>
            <view class="message-desc">{{item.description}}</view>
            <view class="message-time">{{item.createdAt}}</view>
          </view>
          <ui-icon name="chevron-right" tone="muted" size="28" ariaLabel="进入" />
        </view>
      </view>

      <view wx:if="{{activeTab === 'notifications'}}" class="message-list">
        <view class="message-row {{item.isRead ? 'message-row-read' : 'message-row-unread'}}" wx:for="{{notifications}}" wx:key="id">
          <view class="message-main ui-motion-card" data-id="{{item.id}}" data-url="{{item.targetUrl}}" bindtap="onNotificationTap" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">
            <view class="unread-dot" wx:if="{{!item.isRead}}"></view>
            <view class="message-icon"><ui-icon name="bell" tone="primary" size="38" ariaLabel="通知" /></view>
            <view class="message-copy">
              <view class="message-title">{{item.title}}</view>
              <view class="message-desc">{{item.description}}</view>
              <view class="message-time">{{item.createdAt}}</view>
            </view>
          </view>
          <view class="message-delete ui-motion-chip" data-id="{{item.id}}" catchtap="deleteNotification" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160"><ui-icon name="trash" tone="danger" size="28" ariaLabel="删除通知" /></view>
        </view>
      </view>
      <view class="message-loading" wx:if="{{loading || loadingMore}}">正在加载…</view>
    </scroll-view>
  </view>
</view>

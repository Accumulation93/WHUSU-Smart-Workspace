<view class="page">
  <view class="hero">
    <view class="hero-badge">{{heroIdentity}}</view>
    <view class="hero-title">{{heroName}}</view>
    <view class="hero-subtitle">{{heroSubtitle}}</view>
  </view>

  <view class="card activity-card" wx:if="{{organizationName}}">
    <view class="info-head">
      <view class="section-title">当前组织</view>
    </view>
    <view class="activity-name">{{organizationName}}</view>
  </view>

  <view class="tabs-card" wx:if="{{hasUser && !isAdminRole}}">
    <view
      class="feature-tab {{activeTab === item.key ? 'feature-tab-active' : ''}}"
      wx:for="{{userTabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="switchUserTab"
    >
      {{item.label}}
    </view>
  </view>

  <view class="panel {{activeTab === 'scoring' ? 'panel-active' : ''}}" wx:if="{{isAdminRole || !hasUser || activeTab === 'scoring'}}">
    <view class="card activity-card">
      <view class="info-head">
        <view class="section-title">当前评分活动</view>
      </view>

      <view class="activity-name" wx:if="{{currentActivityText}}">
        {{currentActivityText}}
      </view>

      <view class="activity-desc" wx:if="{{currentActivity && currentActivity.description}}">
        {{currentActivity.description}}
      </view>
    </view>

    <view class="card" wx:if="{{hasUser}}">
      <view class="info-head">
        <view class="section-title">评分人信息</view>
      </view>

      <view class="info-grid">
        <view class="info-block">
          <view class="info-label">姓名</view>
          <view class="info-value">{{user.name}}</view>
        </view>
        <view class="info-block">
          <view class="info-label">身份</view>
          <view class="info-value">{{heroIdentity}}</view>
        </view>
        <view class="info-block info-block-full" wx:if="{{user.department}}">
          <view class="info-label">部门</view>
          <view class="info-value">{{user.department}}</view>
        </view>
        <view class="info-block info-block-full" wx:if="{{showWorkGroup}}">
          <view class="info-label">工作分工</view>
          <view class="info-value">{{user.workGroup}}</view>
        </view>
      </view>
    </view>

    <view class="stats-bar" wx:if="{{hasUser && !isAdminRole && activeTab === 'scoring'}}">
      <view class="stat-item">
        <view class="stat-value">{{scoringStats.total}}</view>
        <view class="stat-label">待评人数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value stat-value-gold">{{scoringStats.scored}}</view>
        <view class="stat-label">已完成</view>
      </view>
      <view class="stat-item">
        <view class="stat-value stat-value-blue">{{scoringStats.pending}}</view>
        <view class="stat-label">待评分</view>
      </view>
    </view>

    <view class="card targets-card" wx:if="{{hasUser && !isAdminRole && activeTab === 'scoring'}}">
      <view class="info-head">
        <view class="section-title">被评分人</view>
      </view>

      <view class="activity-status-banner paused-banner" wx:if="{{activityPaused}}">
        <view class="status-banner-text">当前评分活动已暂停</view>
      </view>

      <view class="target-state" wx:if="{{targetsLoading}}">加载中...</view>

      <scroll-view class="target-scroll" scroll-y wx:if="{{!targetsLoading && targetGroups.length}}">
        <block wx:for="{{targetGroups}}" wx:key="identity">
          <view class="target-group-label">{{item.identity}}</view>
          <view
            class="target-card {{selectedTargetId === target.id ? 'target-card-active' : ''}}"
            wx:for="{{item.targets}}"
            wx:key="id"
            wx:for-item="target"
            data-id="{{target.id}}"
            data-name="{{target.name}}"
            bindtap="selectTarget"
          >
            <view class="target-main">
              <view class="target-name">{{target.name}}</view>
              <view class="target-tags">
                <view class="target-identity">{{target.identity}}</view>
                <view class="target-status {{target.scoreStatus === 'scored' ? 'target-status-scored' : 'target-status-pending'}}">
                  {{target.scoreStatusText}}
                </view>
              </view>
            </view>
            <view class="target-meta">{{target.department}}</view>
            <view class="target-meta" wx:if="{{target.workGroup}}">{{target.workGroup}}</view>
          </view>
        </block>
      </scroll-view>

      <view class="target-state" wx:if="{{!targetsLoading && !targetList.length}}">{{targetsEmptyText}}</view>
    </view>
  </view>

  <view class="panel {{activeTab === 'results' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'results'}}">
    <view class="card empty-state-card" wx:if="{{!hasPublication}}">
      <view class="empty-illustration"><view class="empty-icon-clock"></view></view>
      <view class="empty-title">暂无结果公示</view>
      <view class="empty-desc">当前暂无结果公示，请等待管理员发布。</view>
    </view>
    <view class="card empty-state-card" wx:if="{{hasPublication && !publishedResults.length}}">
      <view class="empty-illustration"><view class="empty-icon-lock"></view></view>
      <view class="empty-title">暂无可查看结果</view>
      <view class="empty-desc">暂无您可查看的评分结果，如有疑问请联系管理员。</view>
    </view>
    <view class="card results-panel-card" wx:if="{{hasPublication && publishedResults.length}}">
      <view class="info-head">
        <view class="section-title">评分结果</view>
        <view class="results-count-chip">共 {{publishedResults.length}} 人</view>
      </view>
      <view class="stats-bar">
        <view class="stat-item">
          <view class="stat-value">{{filteredStatsData.count || publishedResults.length}}</view>
          <view class="stat-label">公示人数</view>
        </view>
        <view class="stat-item">
          <view class="stat-value stat-value-gold">{{displayMode === 'grade' ? '等第' : (filteredStatsData.maxScore || '--')}}</view>
          <view class="stat-label">{{displayMode === 'grade' ? '显示模式' : '最高分'}}</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{displayMode === 'grade' ? '等第' : (filteredStatsData.avgScore || '--')}}</view>
          <view class="stat-label">{{displayMode === 'grade' ? '显示模式' : '平均分'}}</view>
        </view>
      </view>

      <!-- 搜索 + 筛选 -->
      <view class="result-filter-area">
        <view class="result-search-row">
          <view class="search-icon">🔍</view>
          <input class="result-search-input" placeholder="搜索姓名 / 身份 / 部门 / 职能组" value="{{resultSearchText}}" bindinput="onResultSearchInput" confirm-type="search" />
          <view class="search-clear" wx:if="{{resultSearchText}}" bindtap="onResultSearchClear">✕</view>
        </view>
        <view class="filter-title">筛选</view>
        <view class="filter-row" wx:if="{{resultIdentities.length}}">
          <view class="filter-row-label">身份</view>
          <scroll-view class="filter-row-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="filter-chip {{resultFilterIdentity === '' ? 'filter-chip-active' : ''}}" bindtap="onResultFilterIdentity" data-value="">全部</view>
            <view class="filter-chip {{resultFilterIdentity === item ? 'filter-chip-active' : ''}}" wx:for="{{resultIdentities}}" wx:key="*this" bindtap="onResultFilterIdentity" data-value="{{item}}">{{item}}</view>
          </scroll-view>
        </view>
        <view class="filter-row" wx:if="{{resultDepartments.length}}">
          <view class="filter-row-label">部门</view>
          <scroll-view class="filter-row-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="filter-chip {{resultFilterDepartment === '' ? 'filter-chip-active' : ''}}" bindtap="onResultFilterDepartment" data-value="">全部</view>
            <view class="filter-chip {{resultFilterDepartment === item ? 'filter-chip-active' : ''}}" wx:for="{{resultDepartments}}" wx:key="*this" bindtap="onResultFilterDepartment" data-value="{{item}}">{{item}}</view>
          </scroll-view>
        </view>
        <view class="filter-row" wx:if="{{resultWorkGroups.length}}">
          <view class="filter-row-label">职能组</view>
          <scroll-view class="filter-row-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="filter-chip {{resultFilterWorkGroup === '' ? 'filter-chip-active' : ''}}" bindtap="onResultFilterWorkGroup" data-value="">全部</view>
            <view class="filter-chip filter-chip-wg {{resultFilterWorkGroup === item ? 'filter-chip-active' : ''}}" wx:for="{{resultWorkGroups}}" wx:key="*this" bindtap="onResultFilterWorkGroup" data-value="{{item}}">{{item}}</view>
          </scroll-view>
        </view>
        <view class="filter-clear" wx:if="{{resultFilterIdentity || resultFilterDepartment || resultFilterWorkGroup || resultSearchText}}" bindtap="onResultFilterClear">清除全部筛选</view>
      </view>

      <scroll-view class="results-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{filteredResults.length}}">
      <view class="ranked-list">
        <view class="rank-card rank-card-{{item.rank === 1 ? 'gold' : (item.rank === 2 ? 'silver' : (item.rank === 3 ? 'bronze' : 'normal'))}}" wx:for="{{filteredResults}}" wx:key="name" style="animation-delay: {{0.06 * index}}s;">
          <view class="rank-badge rank-badge-{{item.rank === 1 ? 'gold' : (item.rank === 2 ? 'silver' : (item.rank === 3 ? 'bronze' : 'normal'))}}">
            <text wx:if="{{item.rank === 1}}">🥇</text>
            <text wx:elif="{{item.rank === 2}}">🥈</text>
            <text wx:elif="{{item.rank === 3}}">🥉</text>
            <text wx:else>{{item.rank}}</text>
          </view>
          <view class="member-info">
            <view class="member-name">{{item.name}}</view>
            <view class="member-detail">{{item.identity}}<text wx:if="{{item.department}}"> · {{item.department}}</text><text wx:if="{{item.workGroup}}"> · {{item.workGroup}}</text></view>
          </view>
          <view class="score-display">
            <view class="score-value">{{displayMode === 'grade' ? item.grade : item.finalScore}}</view>
            <view class="score-label">{{displayMode === 'grade' ? '等第' : '得分'}}</view>
          </view>
        </view>
      </view>
      </scroll-view>
      <view class="target-state" wx:if="{{!filteredResults.length && publishedResults.length}}">当前筛选条件下无匹配结果</view>
    </view>
  </view>

  <view class="panel {{activeTab === 'meritList' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'meritList'}}">
    <view class="card empty-state-card" wx:if="{{!hasPublication}}">
      <view class="empty-illustration"><view class="empty-icon-clock"></view></view>
      <view class="empty-title">暂无评优名单</view>
      <view class="empty-desc">当前暂无结果公示，请等待管理员发布。</view>
    </view>
    <view class="card empty-state-card" wx:if="{{hasPublication && !hasMeritPerm}}">
      <view class="empty-illustration"><view class="empty-icon-star"></view></view>
      <view class="empty-title">暂无评优名单</view>
      <view class="empty-desc">暂未发布评优名单，如有疑问请联系管理员。</view>
    </view>
    <view wx:if="{{hasPublication && hasMeritPerm}}">
      <view class="info-head">
        <view class="section-title">🏆 评优名单</view>
        <view class="results-count-chip">共 {{meritRuleGroups.length}} 个组别</view>
      </view>
      <view class="stats-bar">
        <view class="stat-item">
          <view class="stat-value stat-value-gold">{{meritRuleGroups.length}}</view>
          <view class="stat-label">评优组别</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{publishedMeritList.length}}</view>
          <view class="stat-label">已指定人数</view>
        </view>
        <view class="stat-item">
          <view class="stat-value stat-value-blue">{{meritDeptCount || meritRuleGroups.length}}</view>
          <view class="stat-label">涉及部门</view>
        </view>
      </view>
      <view class="card targets-card" wx:for="{{meritRuleGroups}}" wx:key="targetIdentity" style="animation: glassFadeUp 0.42s {{0.08 * index}}s ease both;">
        <view class="merit-rule-head">
          <view class="target-group-label" style="margin-top:0;">{{item.targetIdentity}}</view>
          <view class="merit-group-count">{{item.quotaInfo}}</view>
          <text class="merit-edit-btn" bindtap="openUserDesignation" data-identity="{{item.targetIdentity}}">✎ 编辑</text>
        </view>
        <scroll-view class="target-scroll" scroll-y wx:if="{{item.designatedMembers.length}}">
          <view class="target-card" wx:for="{{item.designatedMembers}}" wx:key="id" wx:for-item="m" style="animation-delay: {{0.05 * index}}s;">
            <view class="target-main">
              <view class="target-name">{{m.name}}</view>
              <view class="target-tags">
                <view class="target-identity">{{m.identity}}</view>
              </view>
            </view>
            <view class="target-meta">{{m.department}}{{m.workGroup ? ' · ' + m.workGroup : ''}}</view>
          </view>
        </scroll-view>
        <view class="target-state" wx:else>暂未指定人选，点击「编辑名单」开始指定</view>
      </view>
    </view>
  </view>

  <view class="panel {{activeTab === 'profile' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'profile'}}">
    <view class="card profile-card">
      <view class="info-head">
        <view class="section-title">人事信息</view>
        <view class="mode-chip {{hrProfile.template && hrProfile.template.editMode === 'audit' ? 'mode-chip-audit' : ''}} {{hrProfile.template && hrProfile.template.editMode === 'readonly' ? 'mode-chip-readonly' : ''}}">
          {{hrProfile.template ? hrProfile.template.modeText : '未配置模板'}}
        </view>
      </view>

      <view class="profile-banner" wx:if="{{hrProfile.template && hrProfile.template.description}}">
        {{hrProfile.template.description}}
      </view>

      <view class="profile-status" wx:if="{{hrProfile.loaded}}">
        <view class="status-title">{{hrProfile.statusText}}</view>
        <view class="status-desc" wx:if="{{hrProfile.auditStatus === 'pending'}}">已提交的内容会在管理员审核通过后正式生效，重新提交会覆盖当前待审核内容。</view>
        <view class="status-desc" wx:if="{{hrProfile.auditStatus === 'rejected' && hrProfile.rejectionReason}}">驳回原因：{{hrProfile.rejectionReason}}</view>
      </view>

      <view class="field-grid">
        <view class="info-block">
          <view class="info-label">姓名</view>
          <view class="info-value">{{user.name}}</view>
        </view>
        <view class="info-block">
          <view class="info-label">学号</view>
          <view class="info-value">{{user.studentId}}</view>
        </view>
        <view class="info-block info-block-full" wx:if="{{user.department}}">
          <view class="info-label">所属部门</view>
          <view class="info-value">{{user.department}}</view>
        </view>
        <view class="info-block">
          <view class="info-label">身份</view>
          <view class="info-value">{{user.identity}}</view>
        </view>
        <view class="info-block">
          <view class="info-label">工作分工</view>
          <view class="info-value">{{user.workGroup || '未设置'}}</view>
        </view>
      </view>

      <view class="readonly-tip">姓名、学号、身份、所属部门、工作分工（职能组）涉及权限控制，仅支持管理员在后台修改。</view>

      <view class="target-state" wx:if="{{hrProfile.loading}}">正在加载人事信息...</view>
      <view class="empty-card profile-empty" wx:if="{{!hrProfile.loading && hrProfile.loaded && (!hrProfile.template || !hrProfile.template.fields.length)}}">
        <view class="empty-title">管理员尚未配置扩展字段</view>
        <view class="empty-desc">当前仅展示只读基础信息。</view>
      </view>

      <view class="profile-form" wx:if="{{!hrProfile.loading && hrProfile.template && hrProfile.template.fields.length}}">
        <scroll-view class="profile-form-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="profile-field" wx:for="{{hrProfile.template.fields}}" wx:key="id">
          <view class="profile-field-head">
            <view class="profile-field-title">{{item.label}}<text class="field-required" wx:if="{{item.required}}">*</text></view>
            <view class="profile-field-type">{{item.typeLabel}}</view>
          </view>

          <picker
            wx:if="{{item.type === 'sequence'}}"
            range="{{item.options}}"
            value="{{item.valueIndex}}"
            bindchange="onHrProfileOptionChange"
            data-index="{{index}}"
          >
            <view class="picker-value">{{item.value || '请选择'}}</view>
          </picker>

          <input
            wx:elif="{{item.type === 'number'}}"
            class="field-input"
            type="digit"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="请输入数字"
            disabled="{{hrProfile.template.editMode === 'readonly'}}"
          />

          <picker
            wx:elif="{{item.type === 'date'}}"
            mode="date"
            value="{{item.value}}"
            bindchange="onHrProfileDateChange"
            data-index="{{index}}"
            disabled="{{hrProfile.template.editMode === 'readonly'}}"
          >
            <view class="picker-value">{{item.value || '请选择日期'}}</view>
          </picker>

          <input
            wx:elif="{{item.type === 'phone'}}"
            class="field-input"
            type="number"
            maxlength="11"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="请输入手机号"
            disabled="{{hrProfile.template.editMode === 'readonly'}}"
          />

          <input
            wx:elif="{{item.type === 'email'}}"
            class="field-input"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="请输入邮箱"
            disabled="{{hrProfile.template.editMode === 'readonly'}}"
          />

          <input
            wx:else
            class="field-input"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="请输入{{item.label}}"
            disabled="{{hrProfile.template.editMode === 'readonly'}}"
          />

          <view class="field-hint" wx:if="{{item.hintText}}">{{item.hintText}}</view>
        </view>
        </scroll-view>

        <button
          class="primary-btn profile-submit-btn {{hrProfile.template.editMode === 'audit' ? 'profile-submit-btn-audit' : ''}}"
          bindtap="submitHrProfile"
          loading="{{hrProfile.saving}}"
          disabled="{{hrProfile.template.editMode === 'readonly'}}"
        >
          {{hrProfile.template.editMode === 'audit' ? '提交审核' : '保存人事信息'}}
        </button>
      </view>
    </view>
  </view>

  <view class="card empty-card" wx:if="{{!hasUser}}">
    <view class="empty-title">当前暂无可用身份</view>
    <view class="empty-desc">请先完成登录。</view>
  </view>

  <view class="actions">
    <button class="primary-btn" wx:if="{{isAdminRole}}" bindtap="goAdmin">进入管理端</button>
    <button class="secondary-btn" bindtap="goLogin">切换身份</button>
    <button class="danger-btn" wx:if="{{hasUser}}" bindtap="openUnbindDialog">解绑当前身份</button>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU考核评分</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>

  <view class="dialog-layer" wx:if="{{showUnbindDialog}}">
    <view class="dialog-mask" bindtap="closeUnbindDialog"></view>
    <view class="dialog-panel">
      <view class="dialog-badge">危险操作</view>
      <view class="dialog-title">确认解绑当前身份？</view>
      <view class="dialog-desc">解绑后会立即移除当前身份的登录状态，后续如需进入，需要重新完成验证。</view>
      <view class="dialog-actions">
        <button class="secondary-btn dialog-btn" bindtap="closeUnbindDialog">再想想</button>
        <button class="danger-btn dialog-btn" loading="{{unbindLoading}}" bindtap="confirmUnbind">确认解绑</button>
      </view>
    </view>
  </view>

  <view class="popup-mask" wx:if="{{showUserDesigPopup}}" bindtap="closeUserDesignation">
    <view class="popup-card desig-popup-card" catchtap="noop">
      <view class="popup-header"><view class="popup-title">指定评优名单</view><text class="popup-close" bindtap="closeUserDesignation">关闭</text></view>
      <view class="list-title">当前名单（{{userDesigSelectedIds.length}}人）</view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-current-scroll">
        <view class="list-item desig-current-item" wx:for="{{userDesigSelectedList}}" wx:key="id">
          <view class="list-main">
            <view class="list-name">{{item.name}}</view>
            <view class="list-desc">{{item.department}} · {{item.studentId}}</view>
          </view>
          <view class="inline-actions list-actions-below">
            <text class="link danger" data-hr-id="{{item.id}}" catchtap="onUserDesigToggle">移除</text>
          </view>
        </view>
        <view class="empty-inline" wx:if="{{!userDesigSelectedList.length}}">尚未指定任何人</view>
      </scroll-view>
      <view class="list-title" style="margin-top:8rpx;">可选成员</view>
      <view class="rule-filter-row">
        <view class="rule-filter-field">
          <view class="field-label">部门</view>
          <picker range="{{userDesigFilterDeptOptions}}" bindchange="onUserDesigFilterChange" data-field="department">
            <view class="picker-value compact-picker-value">{{userDesigFilterDept}}</view>
          </picker>
        </view>
        <view class="rule-filter-field">
          <view class="field-label">身份</view>
          <picker range="{{userDesigFilterIdentOptions}}" bindchange="onUserDesigFilterChange" data-field="identity">
            <view class="picker-value compact-picker-value">{{userDesigFilterIdent}}</view>
          </picker>
        </view>
        <view class="rule-filter-field" style="flex:1;">
          <view class="field-label">搜索</view>
          <input class="field-input" placeholder="姓名/学号" value="{{userDesigSearchKeyword}}" bindinput="onUserDesigSearchInput"/>
        </view>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-candidate-scroll">
        <view wx:if="{{!userDesigFilteredList.length}}" class="empty-inline">没有匹配的成员</view>
        <view class="list-item" wx:for="{{userDesigFilteredList}}" wx:key="id" data-hr-id="{{item.id}}" bindtap="onUserDesigToggle" wx:if="{{userDesigFilteredList.length}}">
          <view class="list-main">
            <view class="list-name">
              <view class="select-chip select-chip-inline {{item.isSelected ? 'select-chip-active' : ''}}">{{item.isSelected ? '已选' : '选择'}}</view>
              {{item.name}}
            </view>
            <view class="list-desc">{{item.studentId}} · {{item.department}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="button-row">
        <button class="secondary-btn" bindtap="closeUserDesignation">取消</button>
        <button class="primary-btn" loading="{{userDesigSaving}}" bindtap="saveUserDesignations">保存名单（已选{{userDesigSelectedIds.length}}人）</button>
      </view>
    </view>
  </view>
</view>
<view class="page">
  <workspace-hero class="workspace-hero-host" app-name="WHUSU智慧工作台" page-name="{{heroSubtitle || '考核评分'}}"></workspace-hero>

  <view class="tabs-card" wx:if="{{hasUser && !isAdminRole}}">
    <view
      class="feature-tab {{activeTab === item.key ? 'feature-tab-active' : ''}} ui-motion-chip"
      wx:for="{{userTabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="switchUserTab"
     hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
      {{item.label}}
    </view>
  </view>

  <view class="panel {{activeTab === 'scoring' ? 'panel-active' : ''}}" wx:if="{{isAdminRole || !hasUser || activeTab === 'scoring'}}">
    <view class="card activity-card {{!currentActivity ? 'activity-card-empty' : ''}}">
      <view class="info-head">
        <view class="section-title">当前评分活动</view>
      </view>

      <view class="activity-name" wx:if="{{currentActivityText}}">
        {{currentActivityText}}
      </view>

      <view class="activity-desc" wx:if="{{currentActivity && currentActivity.description}}">
        {{currentActivity.description}}
      </view>
    </view>

    <view class="stats-bar" wx:if="{{hasUser && !isAdminRole && activeTab === 'scoring'}}">
      <view class="stat-item">
        <view class="stat-value">{{scoringStats.total}}</view>
        <view class="stat-label">待评人数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value stat-value-gold">{{scoringStats.scored}}</view>
        <view class="stat-label">已完成</view>
      </view>
      <view class="stat-item">
        <view class="stat-value stat-value-blue">{{scoringStats.pending}}</view>
        <view class="stat-label">待评分</view>
      </view>
    </view>

    <view class="card targets-card {{!targetsLoading && !targetList.length ? 'targets-card-empty' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'scoring'}}">
      <view class="info-head">
        <view class="section-title">被评分人</view>
      </view>

      <view class="activity-status-banner paused-banner" wx:if="{{activityPaused}}">
        <view class="status-banner-text">当前评分活动已暂停</view>
      </view>

      <view class="target-state" wx:if="{{targetsLoading}}">加载中...</view>

      <scroll-view class="target-scroll" scroll-y wx:if="{{!targetsLoading && targetGroups.length}}">
        <block wx:for="{{targetGroups}}" wx:key="identity">
          <view class="target-group-label">{{item.identity}}</view>
          <view
            class="target-card {{selectedTargetId === target.id ? 'target-card-active' : ''}} ui-motion-card"
            wx:for="{{item.targets}}"
            wx:key="id"
            wx:for-item="target"
            data-id="{{target.id}}"
            data-name="{{target.name}}"
            bindtap="selectTarget"
           hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="target-main">
              <view class="target-name">{{target.name}}</view>
              <view class="target-tags">
                <view class="target-identity">{{target.identity}}</view>
                <view class="target-status {{target.scoreStatus === 'scored' ? 'target-status-scored' : 'target-status-pending'}}">
                  {{target.scoreStatusText}}
                </view>
              </view>
            </view>
            <view class="target-meta">{{target.department}}</view>
            <view class="target-meta" wx:if="{{target.workGroup}}">{{target.workGroup}}</view>
          </view>
        </block>
      </scroll-view>

      <view class="target-state" wx:if="{{!targetsLoading && !targetList.length}}">{{targetsEmptyText}}</view>
    </view>
  </view>

  <view class="panel {{activeTab === 'results' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'results'}}">
    <view class="card empty-state-card" wx:if="{{!hasPublication}}">
      <view class="empty-illustration"><view class="empty-icon-clock"><ui-icon name="clock" tone="primary" size="46" ariaLabel="等待公示" /></view></view>
      <view class="empty-title">暂无结果公示</view>
    </view>
    <view class="card empty-state-card" wx:if="{{hasPublication && !publishedResults.length}}">
      <view class="empty-illustration"><view class="empty-icon-lock"><ui-icon name="shield" tone="danger" size="46" ariaLabel="暂无权限" /></view></view>
      <view class="empty-title">暂无可查看结果</view>
    </view>
    <view class="card results-panel-card" wx:if="{{hasPublication && publishedResults.length}}">
      <view class="info-head">
        <view class="section-title">评分结果</view>
        <view class="results-count-chip">共 {{publishedResults.length}} 人</view>
      </view>
      <view class="stats-bar">
        <view class="stat-item">
          <view class="stat-value">{{filteredStatsData.count || publishedResults.length}}</view>
          <view class="stat-label">公示人数</view>
        </view>
        <view class="stat-item" wx:if="{{displayMode !== 'grade'}}">
          <view class="stat-value stat-value-gold">{{filteredStatsData.maxScore || '--'}}</view>
          <view class="stat-label">最高分</view>
        </view>
        <view class="stat-item" wx:if="{{displayMode !== 'grade'}}">
          <view class="stat-value">{{filteredStatsData.avgScore || '--'}}</view>
          <view class="stat-label">平均分</view>
        </view>
      </view>
      <!-- 等第模式下显示各等第人数分布（可点击筛选） -->
      <view class="grade-distribution" wx:if="{{displayMode === 'grade' && gradeDistribution.length}}">
        <view class="grade-chip {{resultFilterGrade === item.grade ? 'grade-chip-active' : ''}} ui-motion-chip" wx:for="{{gradeDistribution}}" wx:key="grade" bindtap="onResultFilterGrade" data-value="{{item.grade}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <text class="grade-chip-name">{{item.grade}}</text>
          <text class="grade-chip-count">{{item.count}}人</text>
        </view>
      </view>

      <!-- 搜索 + 筛选 -->
      <view class="result-filter-area">
        <view class="result-search-row">
          <view class="search-icon"><ui-icon name="search" tone="muted" size="34" ariaLabel="搜索" /></view>
          <input class="result-search-input" placeholder="搜索姓名或组织信息" value="{{resultSearchText}}" bindinput="onResultSearchInput" confirm-type="search" />
          <view class="search-clear ui-motion-chip" wx:if="{{resultSearchText}}" bindtap="onResultSearchClear" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">✕</view>
        </view>
        <view class="filter-title">筛选</view>
        <view class="filter-row" wx:if="{{resultIdentities.length}}">
          <view class="filter-row-label">身份</view>
          <scroll-view class="filter-row-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="filter-chip {{resultFilterIdentity === '' ? 'filter-chip-active' : ''}} ui-motion-chip" bindtap="onResultFilterIdentity" data-value="" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">全部</view>
            <view class="filter-chip {{resultFilterIdentity === item ? 'filter-chip-active' : ''}} ui-motion-chip" wx:for="{{resultIdentities}}" wx:key="*this" bindtap="onResultFilterIdentity" data-value="{{item}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item}}</view>
          </scroll-view>
        </view>
        <view class="filter-row" wx:if="{{resultDepartments.length}}">
          <view class="filter-row-label">部门</view>
          <scroll-view class="filter-row-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="filter-chip {{resultFilterDepartment === '' ? 'filter-chip-active' : ''}} ui-motion-chip" bindtap="onResultFilterDepartment" data-value="" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">全部</view>
            <view class="filter-chip {{resultFilterDepartment === item ? 'filter-chip-active' : ''}} ui-motion-chip" wx:for="{{resultDepartments}}" wx:key="*this" bindtap="onResultFilterDepartment" data-value="{{item}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item}}</view>
          </scroll-view>
        </view>
        <view class="filter-row" wx:if="{{resultWorkGroups.length}}">
          <view class="filter-row-label">职能组</view>
          <scroll-view class="filter-row-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="filter-chip {{resultFilterWorkGroup === '' ? 'filter-chip-active' : ''}} ui-motion-chip" bindtap="onResultFilterWorkGroup" data-value="" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">全部</view>
            <view class="filter-chip filter-chip-wg {{resultFilterWorkGroup === item ? 'filter-chip-active' : ''}} ui-motion-chip" wx:for="{{resultWorkGroups}}" wx:key="*this" bindtap="onResultFilterWorkGroup" data-value="{{item}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item}}</view>
          </scroll-view>
        </view>
        <view class="filter-clear ui-motion-chip" wx:if="{{resultFilterIdentity || resultFilterDepartment || resultFilterWorkGroup || resultFilterGrade || resultSearchText}}" bindtap="onResultFilterClear" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">清除全部筛选</view>
      </view>

      <!-- Grouped bubble cards (new per-clause mode) -->
      <view class="result-groups-area" wx:if="{{filteredGroups.length}}">
        <view class="result-group-bubble" wx:for="{{filteredGroups}}" wx:key="clauseId" wx:for-item="group" wx:for-index="gi" style="animation: glassFadeUp 0.38s {{0.07 * gi}}s ease both;">
          <view class="result-group-head ui-motion-chip" data-clause-id="{{group.clauseId}}" bindtap="toggleResultGroup" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="result-group-head-left">
              <view class="result-group-label">{{group.groupLabel}}</view>
              <view class="result-group-mode-chip {{group.displayMode === 'grade' ? 'result-group-mode-grade' : 'result-group-mode-score'}}">{{group.displayMode === 'grade' ? '等第' : '分数'}}</view>
            </view>
            <view class="result-group-head-right">
              <view class="result-group-count">{{group.memberCount}}人</view>
              <text class="result-group-arrow">{{expandedResultGroupClauseId === group.clauseId ? '▲' : '▼'}}</text>
            </view>
          </view>
          <view class="result-group-body" wx:if="{{expandedResultGroupClauseId === group.clauseId || filteredGroups.length === 1}}">
            <view class="ranked-list">
              <view class="rank-card rank-card-{{index === 0 ? 'gold' : (index === 1 ? 'silver' : (index === 2 ? 'bronze' : 'normal'))}}" wx:for="{{group.members}}" wx:for-item="m" wx:key="name" style="animation-delay: {{0.05 * index}}s;">
                <view class="rank-badge rank-badge-{{index === 0 ? 'gold' : (index === 1 ? 'silver' : (index === 2 ? 'bronze' : 'normal'))}}">
                  <text wx:if="{{index === 0}}">🥇</text>
                  <text wx:elif="{{index === 1}}">🥈</text>
                  <text wx:elif="{{index === 2}}">🥉</text>
                  <text wx:else>{{index + 1}}</text>
                </view>
                <view class="member-info">
                  <view class="member-name">{{m.name}}</view>
                  <view class="member-detail">{{m.identity}}<text wx:if="{{m.department}}"> · {{m.department}}</text><text wx:if="{{m.workGroup}}"> · {{m.workGroup}}</text></view>
                </view>
                <view class="score-display">
                  <view class="score-value">{{group.displayMode === 'grade' ? (m.grade || m.finalScore) : m.finalScore}}</view>
                  <view class="score-label">{{group.displayMode === 'grade' ? '等第' : '得分'}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- Legacy flat list (fallback when no groups) -->
      <scroll-view class="results-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{!filteredGroups.length && filteredResults.length}}">
      <view class="ranked-list">
        <view class="rank-card rank-card-{{item.rank === 1 ? 'gold' : (item.rank === 2 ? 'silver' : (item.rank === 3 ? 'bronze' : 'normal'))}}" wx:for="{{filteredResults}}" wx:key="name" style="animation-delay: {{0.06 * index}}s;">
          <view class="rank-badge rank-badge-{{item.rank === 1 ? 'gold' : (item.rank === 2 ? 'silver' : (item.rank === 3 ? 'bronze' : 'normal'))}}">
            <text wx:if="{{item.rank === 1}}">🥇</text>
            <text wx:elif="{{item.rank === 2}}">🥈</text>
            <text wx:elif="{{item.rank === 3}}">🥉</text>
            <text wx:else>{{item.rank}}</text>
          </view>
          <view class="member-info">
            <view class="member-name">{{item.name}}</view>
            <view class="member-detail">{{item.identity}}<text wx:if="{{item.department}}"> · {{item.department}}</text><text wx:if="{{item.workGroup}}"> · {{item.workGroup}}</text></view>
          </view>
          <view class="score-display">
            <view class="score-value">{{displayMode === 'grade' ? item.grade : item.finalScore}}</view>
            <view class="score-label">{{displayMode === 'grade' ? '等第' : '得分'}}</view>
          </view>
        </view>
      </view>
      </scroll-view>
      <view class="target-state" wx:if="{{!filteredResults.length && !filteredGroups.length && publishedResults.length}}">没有匹配结果</view>
    </view>
  </view>

  <view class="panel {{activeTab === 'meritList' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'meritList'}}">
    <view class="card empty-state-card" wx:if="{{!hasPublication}}">
      <view class="empty-illustration"><view class="empty-icon-clock"><ui-icon name="clock" tone="primary" size="46" ariaLabel="等待公示" /></view></view>
      <view class="empty-title">暂无评优名单</view>
    </view>
    <view class="card empty-state-card" wx:if="{{hasPublication && !hasMeritPerm}}">
      <view class="empty-illustration"><view class="empty-icon-star"><ui-icon name="star" tone="primary" size="46" ariaLabel="暂无评优名单" /></view></view>
      <view class="empty-title">暂无评优名单</view>
    </view>
    <view wx:if="{{hasPublication && hasMeritPerm}}">
      <view class="info-head">
      <view class="section-title section-title-icon"><ui-icon name="star" tone="primary" size="26" ariaLabel="评优" /><text>评优名单</text></view>
        <view class="results-count-chip">共 {{meritRuleGroups.length}} 个组别</view>
      </view>
      <view class="stats-bar">
        <view class="stat-item">
          <view class="stat-value stat-value-gold">{{meritRuleGroups.length}}</view>
          <view class="stat-label">评优组别</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{publishedMeritList.length}}</view>
          <view class="stat-label">已指定人数</view>
        </view>
        <view class="stat-item">
          <view class="stat-value stat-value-blue">{{meritDeptCount || meritRuleGroups.length}}</view>
          <view class="stat-label">涉及部门</view>
        </view>
      </view>
      <view class="card targets-card" wx:for="{{meritRuleGroups}}" wx:key="targetIdentity" style="animation: glassFadeUp 0.42s {{0.08 * index}}s ease both;">
        <view class="merit-rule-head">
          <view class="target-group-label target-group-label--flush">{{item.targetIdentity}}</view>
          <view class="merit-group-count">{{item.quotaInfo}}</view>
          <text class="merit-edit-btn ui-motion-chip" bindtap="openUserDesignation" data-identity="{{item.targetIdentity}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">✎ 编辑</text>
        </view>
        <scroll-view class="target-scroll" scroll-y wx:if="{{item.designatedMembers.length}}">
          <view class="target-card" wx:for="{{item.designatedMembers}}" wx:key="id" wx:for-item="m" style="animation-delay: {{0.05 * index}}s;">
            <view class="target-main">
              <view class="target-name">{{m.name}}</view>
              <view class="target-tags">
                <view class="target-identity">{{m.identity}}</view>
              </view>
            </view>
            <view class="target-meta">{{m.department}}{{m.workGroup ? ' · ' + m.workGroup : ''}}</view>
          </view>
        </scroll-view>
        <view class="target-state" wx:else>暂未指定人选</view>
      </view>
    </view>
  </view>

  <view class="panel {{activeTab === 'profile' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'profile'}}">
    <view class="card profile-card">
      <view class="info-head">
        <view class="section-title">人事信息</view>
        <view class="mode-chip {{hrProfile.template && hrProfile.template.editMode === 'audit' ? 'mode-chip-audit' : ''}} {{hrProfile.template && hrProfile.template.editMode === 'readonly' ? 'mode-chip-readonly' : ''}}">
          {{hrProfile.template ? hrProfile.template.modeText : '未使用模板'}}
        </view>
      </view>

      <view class="profile-banner" wx:if="{{hrProfile.template && hrProfile.template.description}}">
        {{hrProfile.template.description}}
      </view>

      <view class="profile-status" wx:if="{{hrProfile.loaded}}">
        <view class="status-title">{{hrProfile.statusText}}</view>
        <view class="status-desc" wx:if="{{hrProfile.auditStatus === 'pending'}}">资料正在审核，请等待结果。</view>
        <view class="status-desc" wx:if="{{hrProfile.auditStatus === 'rejected' && hrProfile.rejectionReason}}">驳回原因：{{hrProfile.rejectionReason}}</view>
      </view>

      <view class="field-grid">
        <view class="info-block">
          <view class="info-label">姓名</view>
          <view class="info-value">{{user.name}}</view>
        </view>
        <view class="info-block">
          <view class="info-label">学号</view>
          <view class="info-value">{{user.studentId}}</view>
        </view>
        <view class="info-block info-block-full" wx:if="{{user.department}}">
          <view class="info-label">所属部门</view>
          <view class="info-value">{{user.department}}</view>
        </view>
        <view class="info-block info-block-wide">
          <view class="info-label">身份</view>
          <view class="info-value">{{user.identity}}</view>
        </view>
        <view class="info-block info-block-wide" wx:if="{{user.workGroup}}">
          <view class="info-label">工作分工（职能组）</view>
          <view class="info-value">{{user.workGroup}}</view>
        </view>
      </view>

      <view class="readonly-tip">基础信息由管理员维护，如需修改请联系管理员。</view>

      <view class="target-state" wx:if="{{hrProfile.loading}}">正在加载人事信息...</view>
      <view class="empty-card profile-empty" wx:if="{{!hrProfile.loading && hrProfile.loaded && (!hrProfile.template || !hrProfile.template.fields.length)}}">
        <view class="empty-title">暂无补充资料</view>
      </view>

      <view class="profile-form" wx:if="{{!hrProfile.loading && hrProfile.template && hrProfile.template.fields.length}}">
        <scroll-view class="profile-form-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="profile-field" wx:for="{{hrProfile.template.fields}}" wx:key="id">
          <view class="profile-field-head">
            <view class="profile-field-title">{{item.label}}<text class="field-required" wx:if="{{item.required}}">*</text></view>
            <view class="profile-field-type">{{item.typeLabel}}</view>
          </view>

          <picker
            wx:if="{{item.type === 'sequence'}}"
            range="{{item.options}}"
            value="{{item.valueIndex}}"
            bindchange="onHrProfileOptionChange"
            data-index="{{index}}"
          >
            <view class="picker-value">{{item.value || '请选择'}}</view>
          </picker>

          <input
            wx:elif="{{item.type === 'number'}}"
            class="field-input"
            type="digit"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="请输入数字"
            disabled="{{hrProfile.template.editMode === 'readonly'}}"
          />

          <picker
            wx:elif="{{item.type === 'date'}}"
            mode="date"
            value="{{item.value}}"
            bindchange="onHrProfileDateChange"
            data-index="{{index}}"
            disabled="{{hrProfile.template.editMode === 'readonly'}}"
          >
            <view class="picker-value">{{item.value || '请选择日期'}}</view>
          </picker>

          <input
            wx:elif="{{item.type === 'phone'}}"
            class="field-input"
            type="number"
            maxlength="11"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="请输入手机号"
            disabled="{{hrProfile.template.editMode === 'readonly'}}"
          />

          <input
            wx:elif="{{item.type === 'email'}}"
            class="field-input"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="请输入邮箱"
            disabled="{{hrProfile.template.editMode === 'readonly'}}"
          />

          <input
            wx:else
            class="field-input"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="请输入{{item.label}}"
            disabled="{{hrProfile.template.editMode === 'readonly'}}"
          />

          <view class="field-hint" wx:if="{{item.hintText}}">{{item.hintText}}</view>
        </view>
        </scroll-view>

        <button
          class="primary-btn profile-submit-btn {{hrProfile.template.editMode === 'audit' ? 'profile-submit-btn-audit' : ''}} ui-motion-button"
          bindtap="submitHrProfile"
          loading="{{hrProfile.saving}}"
          disabled="{{hrProfile.template.editMode === 'readonly'}}"
         hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          {{hrProfile.template.editMode === 'audit' ? '提交审核' : '保存人事信息'}}
        </button>
      </view>
    </view>
  </view>

  <!-- ═══ Audit Panel ═══ -->
  <view class="panel {{activeTab === 'audit' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'audit'}}">
    <view class="card">
      <view class="section-title">审核中心</view>
      <view class="audit-home-cards">
        <!-- 我的审核 -->
        <view class="audit-home-card ui-motion-card" bindtap="goMySubmissions" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="audit-home-card-icon"><ui-icon name="file" tone="primary" size="42" ariaLabel="我的审核" /></view>
          <view class="audit-home-card-content">
            <view class="audit-home-card-title">我的审核</view>
          </view>
          <view class="audit-home-card-badge" wx:if="{{auditMyCount > 0}}">{{auditMyCount}}</view>
          <view class="audit-home-card-arrow"><ui-icon name="chevron-right" tone="muted" size="32" ariaLabel="进入" /></view>
        </view>
        <!-- 待我审批 -->
        <view class="audit-home-card ui-motion-card" bindtap="goPendingApprovals" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="audit-home-card-icon"><ui-icon name="signature" tone="primary" size="42" ariaLabel="待我审批" /></view>
          <view class="audit-home-card-content">
            <view class="audit-home-card-title">待我审批</view>
          </view>
          <view class="audit-home-card-badge audit-home-card-badge-pending" wx:if="{{auditPendingCount > 0}}">{{auditPendingCount}}</view>
          <view class="audit-home-card-arrow"><ui-icon name="chevron-right" tone="muted" size="32" ariaLabel="进入" /></view>
        </view>
        <!-- 我的审批记录 -->
        <view class="audit-home-card ui-motion-card" bindtap="goMyApprovalHistory" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="audit-home-card-icon"><ui-icon name="list" tone="primary" size="42" ariaLabel="审批记录" /></view>
          <view class="audit-home-card-content">
            <view class="audit-home-card-title">我的审批记录</view>
          </view>
          <view class="audit-home-card-arrow"><ui-icon name="chevron-right" tone="muted" size="32" ariaLabel="进入" /></view>
        </view>
      </view>
    </view>
  </view>

  <view class="card empty-card" wx:if="{{!hasUser}}">
    <view class="empty-title">暂无可用身份</view>
  </view>

  <view class="actions">
    <button class="secondary-btn ui-motion-button" bindtap="goPortal" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">返回门户</button>
  </view>

  <view class="page-footer">
    <view class="footer-name">WHUSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>

  <viewport-portal wx:if="{{showUserDesigPopup}}">
  <view class="popup-mask ui-overlay" wx:if="{{showUserDesigPopup}}" bindtap="closeUserDesignation">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card desig-popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header"><view class="popup-title">指定评优名单</view><text class="popup-close ui-motion-chip" catchtap="closeUserDesignation" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text></view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="ui-dialog-body ui-dialog-content ui-dialog-scroll--fill ui-dialog-stack-scroll">
      <view class="list-title">当前名单（{{userDesigSelectedIds.length}}人）</view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="desig-inner-scroll desig-current-scroll ui-dialog-scroll--pane ui-dialog-selection-current">
        <view class="list-item desig-current-item" wx:for="{{userDesigSelectedList}}" wx:key="id">
          <view class="list-main">
            <view class="list-name">{{item.name}}</view>
            <view class="list-desc">{{item.department}} · {{item.studentId}}</view>
          </view>
          <view class="inline-actions list-actions-below">
            <text class="link danger ui-motion-chip" data-hr-id="{{item.id}}" catchtap="onUserDesigToggle" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text>
          </view>
        </view>
        <view class="empty-inline" wx:if="{{!userDesigSelectedList.length}}">暂无人选</view>
      </scroll-view>
      <view class="list-title candidate-list-title">可选成员</view>
      <view class="rule-filter-row">
        <view class="rule-filter-field">
          <view class="field-label">部门</view>
          <picker range="{{userDesigFilterDeptOptions}}" bindchange="onUserDesigFilterChange" data-field="department">
            <view class="picker-value compact-picker-value">{{userDesigFilterDept}}</view>
          </picker>
        </view>
        <view class="rule-filter-field">
          <view class="field-label">身份</view>
          <picker range="{{userDesigFilterIdentOptions}}" bindchange="onUserDesigFilterChange" data-field="identity">
            <view class="picker-value compact-picker-value">{{userDesigFilterIdent}}</view>
          </picker>
        </view>
        <view class="rule-filter-field rule-filter-field--grow">
          <view class="field-label">搜索</view>
          <input class="field-input" placeholder="姓名/学号" value="{{userDesigSearchKeyword}}" bindinput="onUserDesigSearchInput"/>
        </view>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="desig-inner-scroll desig-candidate-scroll ui-dialog-scroll--pane ui-dialog-selection-options">
        <view wx:if="{{!userDesigFilteredList.length}}" class="empty-inline">没有匹配的成员</view>
        <view class="list-item ui-motion-card" wx:for="{{userDesigFilteredList}}" wx:key="id" data-hr-id="{{item.id}}" catchtap="onUserDesigToggle" wx:if="{{userDesigFilteredList.length}}" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="list-main">
            <view class="list-name">
              <view class="select-chip select-chip-inline {{item.isSelected ? 'select-chip-active' : ''}}">{{item.isSelected ? '已选' : '选择'}}</view>
              {{item.name}}
            </view>
            <view class="list-desc">{{item.studentId}} · {{item.department}}</view>
          </view>
        </view>
      </scroll-view>
      </scroll-view>
      <view class="button-row ui-dialog-footer">
        <button class="secondary-btn ui-motion-button" catchtap="closeUserDesignation" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
        <button class="primary-btn ui-motion-button" loading="{{userDesigSaving}}" catchtap="saveUserDesignations" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存名单（已选{{userDesigSelectedIds.length}}人）</button>
      </view>
    </view>
  </view>
  </viewport-portal>
</view>

.ui-list-filter {
  box-sizing: border-box;
  min-width: 0;
  padding: var(--ui-list-padding-x, 20rpx);
  border: 1rpx solid rgba(148, 163, 184, .16);
  border-radius: var(--ui-list-radius, 20rpx);
  background: rgba(248, 251, 255, .64);
}

.ui-list-filter-title {
  color: #475569;
  font-size: var(--ui-type-meta, var(--ui-dialog-meta-size));
  font-weight: 700;
}

.ui-list-filter-stack {
  display: flex;
  flex-direction: column;
  gap: var(--ui-label-gap);
  min-width: 0;
}

.ui-list-filter-row {
  display: flex;
  align-items: center;
  gap: var(--ui-inline-gap);
  min-width: 0;
  overflow: hidden;
}

.ui-list-filter-label {
  flex: 0 0 5em;
  max-width: 32%;
  color: var(--ui-text-muted, #64748b);
  font-size: var(--ui-type-caption, var(--ui-dialog-meta-size));
  font-weight: 600;
  line-height: 1.4;
  text-align: right;
  overflow-wrap: anywhere;
}

.ui-list-filter-scroll {
  flex: 1;
  width: 0;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.ui-list-filter-track {
  display: inline-flex;
  align-items: center;
  gap: var(--ui-label-gap);
  padding: 2px 1px;
}

.ui-list-filter-chip {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: var(--ui-compact-height, 26px);
  padding: var(--ui-compact-padding-y, 3px) var(--ui-compact-padding-x, 7px);
  border: 1rpx solid rgba(226, 237, 247, .96);
  border-radius: var(--ui-compact-radius, 9px);
  background: linear-gradient(135deg, rgba(255, 255, 255, .92), rgba(248, 251, 255, .8));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .78);
  color: var(--ui-text-muted, #64748b);
  font-size: var(--ui-type-caption, var(--ui-dialog-meta-size));
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}

.ui-list-filter-chip.is-active {
  color: var(--ui-blue-700);
  background: linear-gradient(135deg, rgba(219, 234, 254, .92), rgba(239, 246, 255, .84));
  border-color: rgba(37, 99, 235, .4);
  font-weight: 700;
}

.ui-list-filter-opener {
  flex: 0 1 auto;
  min-width: 0;
  gap: var(--ui-label-gap);
  overflow-wrap: anywhere;
}

.ui-list-filter-search {
  display: flex;
  align-items: center;
  gap: var(--ui-inline-gap);
  box-sizing: border-box;
  min-width: 0;
  padding: var(--ui-compact-padding-y) var(--ui-list-padding-x);
  border: 1rpx solid rgba(148, 163, 184, .24);
  border-radius: var(--ui-field-radius);
  background: rgba(255, 255, 255, .82);
}

.ui-list-filter-search .ui-list-filter-input {
  flex: 1;
  display: block;
  min-width: 0;
  width: 0;
  min-height: var(--ui-compact-height);
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  color: var(--ui-text);
  font-size: var(--ui-type-control);
  line-height: 1.4;
}

/* 独立搜索与结果区的间距由搜索行承担；已有 stack 的筛选组不叠加。 */
.ui-list-filter-search--results {
  margin-bottom: var(--ui-card-gap);
}

.ui-list-filter-clear {
  align-self: flex-start;
  color: var(--ui-blue-700);
  font-size: var(--ui-type-caption);
  font-weight: 700;
}

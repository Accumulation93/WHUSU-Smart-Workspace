/*
 * 视口级弹窗契约（必须位于所有页面级样式之后）
 *
 * 弹窗不是页面内容的一部分：遮罩固定覆盖整个可视视口，弹窗壳直接
 * 以视口中心为锚点。这样背景页面即使曾经滚动到任意位置，打开或滚动
 * 弹窗时也不会把遮罩和弹窗一起带偏。正文仍由显式 scroll-view 承担滚动。
 */
/*
 * “复杂”只描述结构，不代表必须占满屏幕。窗口默认按实际内容收缩；正文
 * 超过可用高度后由 scroll-view 自己滚动，标题和操作栏始终固定。只有真正
 * 需要整屏工作区的表格、时间表等，才显式使用 --viewport / --wide。
 */
.ui-overlay .ui-dialog-shell.ui-dialog-shell--complex {
  height: auto !important;
}

.ui-overlay .ui-dialog-shell.ui-dialog-shell--viewport {
  height: calc(100vh - 48rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
}

.ui-overlay .ui-dialog-shell.ui-dialog-shell--complex > .ui-dialog-body {
  flex: 0 1 auto !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: calc(100vh - 260rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
}

.ui-overlay .ui-dialog-shell.ui-dialog-shell--viewport > .ui-dialog-body,
.ui-overlay .ui-dialog-shell.ui-dialog-shell--wide > .ui-dialog-body {
  flex: 1 1 auto !important;
  max-height: none !important;
}

.ui-overlay .ui-dialog-body {
  font-size: var(--ui-dialog-body-size) !important;
  line-height: 1.55 !important;
}

.ui-overlay .ui-dialog-shell,
.ui-sheet-overlay .ui-dialog-shell {
  font-size: var(--ui-dialog-body-size) !important;
  -webkit-text-size-adjust: 100%;
}

/* 弹窗保持和页面同一字体体系，但整体降低一级，有限空间内仍清晰紧凑。 */
.ui-overlay .popup-title,
.ui-overlay .dialog-title,
.ui-overlay .modal-title,
.ui-overlay .sheet-title,
.ui-overlay .message-switch-title,
.ui-overlay .permission-dialog-title,
.ui-sheet-overlay .popup-title,
.ui-sheet-overlay .dialog-title,
.ui-sheet-overlay .modal-title,
.ui-sheet-overlay .sheet-title,
.ui-sheet-overlay .message-switch-title,
.ui-sheet-overlay .permission-dialog-title {
  font-size: var(--ui-dialog-title-size) !important;
  line-height: var(--ui-leading-heading) !important;
}

.ui-overlay .dialog-desc,
.ui-overlay .message-switch-desc,
.ui-overlay .sheet-note,
.ui-overlay .field-hint,
.ui-overlay .panel-note,
.ui-sheet-overlay .dialog-desc,
.ui-sheet-overlay .message-switch-desc,
.ui-sheet-overlay .sheet-note,
.ui-sheet-overlay .field-hint,
.ui-sheet-overlay .panel-note {
  font-size: var(--ui-dialog-meta-size) !important;
  line-height: var(--ui-leading-body) !important;
}

.ui-overlay .field-label,
.ui-overlay .filter-label,
.ui-overlay .detail-key,
.ui-sheet-overlay .field-label,
.ui-sheet-overlay .filter-label,
.ui-sheet-overlay .detail-key {
  font-size: var(--ui-dialog-label-size) !important;
}

.ui-overlay button,
.ui-overlay .dialog-btn,
.ui-overlay .popup-close,
.ui-overlay .sheet-close,
.ui-sheet-overlay button,
.ui-sheet-overlay .dialog-btn,
.ui-sheet-overlay .popup-close,
.ui-sheet-overlay .sheet-close {
  font-size: var(--ui-dialog-control-size) !important;
}

.ui-overlay input,
.ui-overlay textarea,
.ui-overlay .field-input,
.ui-overlay .field-textarea,
.ui-overlay .picker-display,
.ui-overlay .picker-value,
.ui-sheet-overlay input,
.ui-sheet-overlay textarea,
.ui-sheet-overlay .field-input,
.ui-sheet-overlay .field-textarea,
.ui-sheet-overlay .picker-display,
.ui-sheet-overlay .picker-value {
  font-size: var(--ui-dialog-body-size) !important;
}

/* 页面业务标题进入弹窗后必须回到弹窗字阶，禁止页面级大标题穿透进来。 */
.ui-overlay .ui-dialog-shell .section-title,
.ui-overlay .ui-dialog-shell .card-title,
.ui-overlay .ui-dialog-shell .panel-title,
.ui-overlay .ui-dialog-shell .list-title,
.ui-overlay .ui-dialog-shell .list-name,
.ui-overlay .ui-dialog-shell .activity-name,
.ui-overlay .ui-dialog-shell .info-value,
.ui-overlay .ui-dialog-shell .detail-value,
.ui-overlay .ui-dialog-shell .venue-name,
.ui-overlay .ui-dialog-shell .booking-title,
.ui-overlay .ui-dialog-shell .pending-title,
.ui-sheet-overlay .ui-dialog-shell .section-title,
.ui-sheet-overlay .ui-dialog-shell .card-title,
.ui-sheet-overlay .ui-dialog-shell .panel-title,
.ui-sheet-overlay .ui-dialog-shell .list-title,
.ui-sheet-overlay .ui-dialog-shell .list-name,
.ui-sheet-overlay .ui-dialog-shell .info-value,
.ui-sheet-overlay .ui-dialog-shell .detail-value {
  font-size: var(--ui-dialog-body-size) !important;
  line-height: 1.45 !important;
}

.ui-overlay .ui-dialog-shell .section-title,
.ui-overlay .ui-dialog-shell .card-title,
.ui-overlay .ui-dialog-shell .panel-title,
.ui-sheet-overlay .ui-dialog-shell .section-title,
.ui-sheet-overlay .ui-dialog-shell .card-title,
.ui-sheet-overlay .ui-dialog-shell .panel-title {
  font-size: var(--ui-dialog-title-size) !important;
}

.ui-overlay scroll-view.ui-dialog-scroll--fill,
.ui-overlay scroll-view.ui-dialog-scroll--pane {
  touch-action: pan-y !important;
}

.ui-overlay scroll-view.ui-dialog-scroll--x {
  touch-action: pan-x !important;
}

.ui-overlay scroll-view.ui-dialog-scroll--both {
  touch-action: pan-x pan-y !important;
}

/*
 * A dialog is centred with transform, so a generic container :active rule
 * must never replace that transform while the user taps inside the dialog.
 * Keep every focus/press state on the exact same viewport anchor.
 */
page .ui-overlay .ui-dialog-shell:active,
page .ui-overlay .ui-dialog-shell:focus,
page .ui-overlay .ui-dialog-shell:focus-within {
  transform: translate(-50%, -50%) !important;
  transition-property: opacity, box-shadow, border-color, background-color !important;
}

page .ui-overlay .ui-dialog-shell.ui-dialog-shell--wide:active,
page .ui-overlay .ui-dialog-shell.ui-dialog-shell--wide:focus,
page .ui-overlay .ui-dialog-shell.ui-dialog-shell--wide:focus-within {
  transform: translateX(-50%) !important;
}

/*
 * Pad 竖屏弹窗保留稳定的屏幕边距和阅读宽度。使用 px 防止 rpx 因竖屏宽度
 * 被放大；标题和正文沿用 Pad 语义字号，不受页面局部弹窗样式抬高。
 */
@media (min-width: 520px) and (max-width: 899px),
       (min-width: 520px) and (orientation: portrait) {
  .ui-overlay .ui-dialog-shell {
    width: calc(100vw - 48px) !important;
    max-width: 720px !important;
    max-height: calc(100vh - 48px - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
  }

  .ui-overlay .ui-dialog-shell.ui-dialog-shell--compact {
    max-width: 520px !important;
  }

  .ui-overlay .ui-dialog-shell.ui-dialog-shell--complex {
    height: auto !important;
    max-width: 720px !important;
  }

  .ui-overlay .ui-dialog-shell.ui-dialog-shell--viewport {
    height: calc(100vh - 48px - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
  }

  .ui-overlay .ui-dialog-shell.ui-dialog-shell--complex > .ui-dialog-body {
    max-height: calc(100vh - 190px - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
  }

  .ui-overlay .ui-dialog-shell.ui-dialog-shell--wide {
    max-width: 720px !important;
  }

  .ui-overlay .popup-title,
  .ui-overlay .dialog-title,
  .ui-overlay .modal-title,
  .ui-overlay .sheet-title,
  .ui-overlay .message-switch-title,
  .ui-overlay .permission-dialog-title {
    font-size: var(--ui-dialog-title-size) !important;
    line-height: 1.4 !important;
  }
}

/* Pad 横屏只压缩密度，不扩大控件和字体；弹窗仍以物理视口为定位基准。 */
@media (min-width: 900px) and (orientation: landscape) {
  .ui-overlay .ui-dialog-shell {
    width: calc(100vw - 32px) !important;
    max-width: 860px !important;
    max-height: calc(100vh - 32px - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
  }

  .ui-overlay .ui-dialog-shell.ui-dialog-shell--compact {
    max-width: 520px !important;
  }

  .ui-overlay .ui-dialog-shell.ui-dialog-shell--complex {
    height: auto !important;
    max-width: 860px !important;
  }

  .ui-overlay .ui-dialog-shell.ui-dialog-shell--viewport {
    height: calc(100vh - 32px - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
  }

  .ui-overlay .ui-dialog-shell.ui-dialog-shell--complex > .ui-dialog-body {
    max-height: calc(100vh - 150px - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
  }

  .ui-overlay .ui-dialog-shell.ui-dialog-shell--wide {
    max-width: 1040px !important;
  }
}

    display: flex;
  }

  .task-table.ui-data-grid--complex > .ui-data-row,
  .result-table.ui-data-grid--complex > .ui-data-row,
  .popup-table.ui-data-grid--complex > .ui-data-row {
    display: flex;
    margin-bottom: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .task-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell,
  .result-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell,
  .popup-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell {
    display: flex;
    width: auto;
    min-width: 0;
    padding: 14px 12px;
    text-align: center;
    border-bottom: 0;
  }

  .ui-data-cell-label {
    display: none;
  }

  .ui-data-cell-content {
    width: 100%;
    text-align: center;
  }

  .footer-name {
    font-size: var(--ui-type-caption) !important;
    line-height: 18px !important;
  }

  .footer-org {
    font-size: var(--ui-type-control) !important;
    line-height: 20px !important;
  }
}

/* Pad 横屏工作台 */
@media (min-width: 900px) {
  .page {
    max-width: 1180px;
    padding: 22px 28px 30px;
  }

  .hero,
  .hero-admin {
    margin-bottom: 16px;
  }

  .popup-card,
  .modal-card {
    max-width: 860px;
  }

  .completion-popup-card,
  .timetable-popup,
  .placement-popup {
    max-width: 1040px;
  }

  .ui-overlay .ui-dialog-shell--complex {
    max-width: 860px;
  }

  .ui-overlay .ui-dialog-shell--wide {
    max-width: 1040px;
  }
}


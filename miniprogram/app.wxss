/* REDSU 统一蓝色轻奢玻璃设计系统 */

page {
  --ui-blue-700: #2563eb;
  --ui-blue-500: #3b82f6;
  --ui-blue-400: #60a5fa;
  --ui-text: #0f172a;
  --ui-text-body: #334155;
  --ui-text-muted: #64748b;
  --ui-text-soft: #94a3b8;
  --ui-line: rgba(226, 237, 247, 0.96);
  --ui-line-blue: rgba(147, 197, 253, 0.64);
  --ui-danger: #ef4444;
  --ui-font-xs: 20rpx;
  --ui-font-sm: 22rpx;
  --ui-font-md: 25rpx;
  --ui-font-lg: 30rpx;
  --ui-font-xl: 46rpx;
  --ui-line-control: 1.35;
  --ui-control-height: 82rpx;
  --ui-control-padding-y: 16rpx;
  --ui-control-padding-x: 28rpx;
  --ui-compact-height: 52rpx;
  min-height: 100%;
  color: #0f172a;
  color: var(--ui-text, #0f172a);
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

button,
input,
textarea,
picker,
view,
text,
scroll-view {
  font-family: inherit;
}

button,
input,
textarea {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  min-height: var(--ui-control-height, 82rpx);
  height: auto;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  font-size: var(--ui-font-md, 25rpx);
  line-height: var(--ui-line-control, 1.35);
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
}

button::after {
  border: 0;
}

input,
textarea {
  display: block;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

/* 页面与 Hero */
.page {
  position: relative;
  min-height: 100vh;
  padding: 30rpx 24rpx calc(42rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero,
.hero-admin {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 40rpx 34rpx 36rpx;
  border-radius: 38rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-shadow:
    0 24rpx 48rpx rgba(37, 99, 235, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  animation: glassFadeUp 0.42s cubic-bezier(0.16, 0.84, 0.28, 1) both;
}

.hero {
  background:
    radial-gradient(circle at 84% 8%, rgba(255,255,255,0.22), transparent 28%),
    linear-gradient(135deg, #2563eb 0%, #3b82f6 52%, #60a5fa 100%);
}

.hero-admin {
  background:
    radial-gradient(circle at 84% 10%, rgba(96,165,250,0.24), transparent 30%),
    linear-gradient(135deg, rgba(15,23,42,0.97) 0%, rgba(30,58,138,0.95) 58%, rgba(37,99,235,0.92) 100%);
  box-shadow:
    0 26rpx 52rpx rgba(15, 23, 42, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}

.hero-badge,
.hero-title,
.hero-subtitle {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  margin-bottom: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: rgba(255,255,255,0.96);
  font-size: 21rpx;
  font-weight: 700;
  background: linear-gradient(135deg, rgba(255,255,255,0.22), rgba(255,255,255,0.12));
  border: 1rpx solid rgba(255,255,255,0.28);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.22);
}

.hero-title {
  color: #ffffff;
  font-size: 46rpx;
  font-size: var(--ui-font-xl, 46rpx);
  font-weight: 800;
  line-height: 1.24;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: rgba(248,250,252,0.90);
  font-size: 25rpx;
  font-size: var(--ui-font-md, 25rpx);
  font-weight: 600;
  line-height: 1.6;
}

/* 三级玻璃表面 */
.card,
.section,
.edit-box,
.list-card,
.booking-panel,
.filter-section,
.popup-card,
.modal-card,
.sheet-panel {
  position: relative;
  box-sizing: border-box;
  transform: none;
}

.card,
.section,
.edit-box,
.list-card,
.booking-panel {
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.86), rgba(248,251,255,0.72));
  border: 1rpx solid rgba(255,255,255,0.72);
  box-shadow:
    0 18rpx 36rpx rgba(15,23,42,0.055),
    inset 0 1rpx 0 rgba(255,255,255,0.82);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.filter-section {
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(248,251,255,0.62));
  border: 1rpx solid rgba(226,237,247,0.84);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.list-item,
.nav-row,
.booking-item,
.pending-item,
.question-card,
.audit-submission-item,
.file-attach-item,
.template-select-item,
.audit-person-item,
.task-table-row,
.result-table-row,
.popup-table-row {
  position: relative;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(249,251,255,0.84));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow:
    0 10rpx 22rpx rgba(15,23,42,0.038),
    inset 0 1rpx 0 rgba(255,255,255,0.82);
}

/* 标题 */
.section-title {
  position: relative;
  margin: 0;
  padding-left: 20rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-size: var(--ui-font-lg, 30rpx);
  font-weight: 800;
  line-height: 1.4;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 7rpx;
  height: 28rpx;
  border-radius: 999rpx;
  transform: translateY(-50%);
  background: linear-gradient(180deg, #3b82f6 0%, #60a5fa 100%);
  box-shadow: 0 0 12rpx rgba(96,165,250,0.20);
}

.list-title {
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.45;
}

.list-desc,
.section-desc,
.panel-note,
.field-hint {
  color: #64748b;
  font-size: 22rpx;
  font-size: var(--ui-font-sm, 22rpx);
  line-height: 1.65;
}

/* 按钮体系 */
.primary-btn,
.secondary-btn,
.danger-btn,
.approve-btn,
.reject-btn,
.profile-submit-btn,
.page-submit-btn,
.template-save-btn,
.purpose-save-btn,
.dialog-btn,
.sigpad-btn {
  position: relative;
  min-height: 82rpx;
  min-height: var(--ui-control-height, 82rpx);
  height: auto;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  border-radius: 24rpx;
  border: 1rpx solid transparent;
  font-size: 25rpx;
  font-size: var(--ui-font-md, 25rpx);
  font-weight: 750;
  line-height: var(--ui-line-control, 1.35);
  box-sizing: border-box;
  transition:
    transform 0.22s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.22s ease,
    opacity 0.18s ease,
    filter 0.20s ease,
    background 0.22s ease,
    border-color 0.22s ease;
}

.primary-btn,
.approve-btn,
.profile-submit-btn,
.page-submit-btn,
.template-save-btn,
.purpose-save-btn,
.sigpad-btn-primary,
.action-btn.primary,
.pending-action-link.approve,
.approval-btn-approve {
  color: #ffffff;
  background:
    radial-gradient(circle at 24% 4%, rgba(255,255,255,0.26), transparent 28%),
    linear-gradient(135deg, #2563eb 0%, #3b82f6 52%, #60a5fa 100%);
  border-color: rgba(147,197,253,0.64);
  box-shadow:
    0 14rpx 28rpx rgba(37,99,235,0.18),
    inset 0 1rpx 0 rgba(255,255,255,0.26);
}

.secondary-btn,
.dialog-btn,
.sigpad-btn-secondary {
  color: #2457a7;
  background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(239,246,255,0.86));
  border-color: rgba(147,197,253,0.70);
  box-shadow:
    0 10rpx 22rpx rgba(37,99,235,0.075),
    inset 0 1rpx 0 rgba(255,255,255,0.88);
}

.danger-btn,
.reject-btn,
.approval-btn-reject {
  color: #ffffff;
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  border-color: rgba(252,165,165,0.62);
  box-shadow:
    0 12rpx 24rpx rgba(239,68,68,0.15),
    inset 0 1rpx 0 rgba(255,255,255,0.22);
}

button[disabled],
.disabled,
.button-disabled {
  opacity: 0.48;
  filter: grayscale(0.12) saturate(0.72);
  transform: none;
}

/* 小型操作与选择控件 */
.link,
.action-btn,
.audit-link-btn,
.flow-action-btn,
.step-action-link,
.pending-action-link,
.pill-link,
.pill-close,
.header-nav-btn,
.mark-all-read,
.popup-close,
.modal-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #2563eb;
  font-size: 22rpx;
  font-size: var(--ui-font-sm, 22rpx);
  font-weight: 750;
  line-height: 1.25;
  background: linear-gradient(135deg, rgba(239,246,255,0.92), rgba(219,234,254,0.72));
  border: 1rpx solid rgba(147,197,253,0.58);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.72);
  box-sizing: border-box;
  transition:
    transform 0.22s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.20s ease,
    opacity 0.18s ease,
    background 0.20s ease;
}

.link.danger,
.audit-link-danger,
.flow-action-danger,
.step-action-danger,
.pending-action-link.reject,
.pill-close {
  color: #dc2626;
  background: linear-gradient(135deg, rgba(254,242,242,0.94), rgba(254,226,226,0.78));
  border-color: rgba(252,165,165,0.58);
}

.popup-close,
.modal-close {
  min-height: 0;
  padding: 4rpx 0 4rpx 14rpx;
  border: 0;
  border-radius: 0;
  color: #475569;
  background: transparent;
  box-shadow: none;
}

.popup-close::after {
  content: "×";
  margin-left: 8rpx;
  color: #3b82f6;
  font-size: 28rpx;
  font-weight: 800;
}

/* Tabs 与 Chip，持续状态和按压状态相互独立 */
.tabs,
.tabs-card {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(248,251,255,0.62));
  border: 1rpx solid rgba(255,255,255,0.70);
  box-shadow:
    0 12rpx 26rpx rgba(15,23,42,0.045),
    inset 0 1rpx 0 rgba(255,255,255,0.82);
}

.tab,
.feature-tab,
.rules-tab,
.app-view-tab,
.filter-chip,
.chip,
.select-chip,
.grade-chip,
.dept-tab,
.hour-chip,
.min-chip,
.duration-chip,
.role-pill {
  position: relative;
  box-sizing: border-box;
  transition:
    transform 0.22s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.20s ease,
    color 0.20s ease,
    background 0.20s ease,
    border-color 0.20s ease;
}

.tab-active,
.feature-tab-active,
.rules-tab-active,
.app-view-tab-active,
.filter-chip-active,
.select-chip-active,
.grade-chip-active,
.dept-tab-active,
.hour-chip-active,
.min-chip-active,
.duration-chip-active,
.role-pill-active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  border-color: rgba(147,197,253,0.64);
  box-shadow:
    0 10rpx 20rpx rgba(37,99,235,0.16),
    inset 0 1rpx 0 rgba(255,255,255,0.24);
}

/* 表单 */
.field-input,
.field-textarea,
.picker-value,
.picker-display,
.compact-picker-value {
  display: block;
  width: 100%;
  min-height: 76rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  color: #10233d;
  font-size: 25rpx;
  line-height: 1.55;
  background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(246,249,255,0.90));
  border: 1rpx solid rgba(219,229,241,0.96);
  box-shadow:
    0 7rpx 16rpx rgba(15,23,42,0.032),
    inset 0 1rpx 0 rgba(255,255,255,0.88);
  box-sizing: border-box;
  transform: none;
  transition:
    box-shadow 0.22s ease,
    border-color 0.20s ease,
    background 0.22s ease;
}

.field-input:focus,
.field-textarea:focus {
  transform: none;
  border-color: rgba(96,165,250,0.88);
  background: linear-gradient(135deg, rgba(255,255,255,0.99), rgba(239,246,255,0.92));
  box-shadow:
    0 9rpx 20rpx rgba(37,99,235,0.08),
    0 0 0 3rpx rgba(191,219,254,0.42),
    inset 0 1rpx 0 rgba(255,255,255,0.92);
}

/* 弹窗 */
.popup-mask,
.dialog-layer,
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
  background: rgba(15,23,42,0.34);
  box-sizing: border-box;
}

.popup-card,
.modal-card {
  width: 100%;
  max-height: 88vh;
  padding: 26rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(255,255,255,0.97), rgba(248,251,255,0.91));
  border: 1rpx solid rgba(255,255,255,0.84);
  box-shadow:
    0 24rpx 52rpx rgba(15,23,42,0.16),
    inset 0 1rpx 0 rgba(255,255,255,0.90);
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.popup-title {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: 29rpx;
  font-size: var(--ui-font-lg, 30rpx);
  font-weight: 800;
  line-height: 1.4;
}

/* 稳定弹窗与响应式数据布局契约 */
.ui-overlay {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100vw;
  height: 100vh;
  padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  overscroll-behavior: contain;
  box-sizing: border-box;
}

.ui-overlay .ui-dialog-shell {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  max-height: calc(100vh - 32rpx - env(safe-area-inset-bottom));
  overflow: hidden;
  box-sizing: border-box;
}

.ui-overlay .ui-dialog-shell--compact {
  height: auto;
  max-width: 640rpx;
}

.ui-overlay .ui-dialog-shell--complex,
.ui-overlay .ui-dialog-shell--wide {
  height: calc(100vh - 32rpx - env(safe-area-inset-bottom));
}

.ui-dialog-header {
  flex: 0 0 auto;
  min-width: 0;
}

.ui-dialog-body {
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  min-height: 0;
  max-height: none;
  overflow: hidden;
  box-sizing: border-box;
}

.ui-overlay .ui-dialog-shell > .ui-dialog-header,
.ui-overlay .ui-dialog-shell > .ui-dialog-footer {
  flex: 0 0 auto;
}

.ui-overlay .ui-dialog-shell > .ui-dialog-body {
  flex: 1 1 auto;
  min-height: 0;
  max-height: none;
}

scroll-view.ui-dialog-body {
  overflow: hidden;
}

.ui-dialog-footer {
  flex: 0 0 auto;
  width: 100%;
  min-width: 0;
  padding-top: 16rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(180deg, rgba(248,251,255,0.12), rgba(248,251,255,0.96) 26%);
  box-sizing: border-box;
}

.ui-dialog-footer button,
.ui-dialog-footer .link,
.ui-dialog-footer .audit-link-btn {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
}

.ui-data-grid--simple,
.ui-data-grid--complex,
.ui-data-grid--specialized,
.ui-data-row,
.ui-data-cell {
  min-width: 0;
  box-sizing: border-box;
}

.ui-data-cell--primary,
.ui-data-cell--action,
.ui-control-text {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
}

.ui-data-cell--secondary {
  min-width: 0;
}

.ui-data-cell-label {
  display: block;
  color: #64748b;
  font-size: 21rpx;
  font-weight: 750;
  line-height: 1.4;
}

.ui-data-cell-content {
  min-width: 0;
  text-align: right;
}

.task-table.ui-data-grid--complex > .ui-data-row--header,
.result-table.ui-data-grid--complex > .ui-data-row--header,
.popup-table.ui-data-grid--complex > .ui-data-row--header {
  display: none;
}

.task-table.ui-data-grid--complex > .ui-data-row,
.result-table.ui-data-grid--complex > .ui-data-row,
.popup-table.ui-data-grid--complex > .ui-data-row {
  display: block;
  margin-bottom: 16rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(191,219,254,0.62);
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(239,246,255,0.82));
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.86);
}

.task-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell,
.result-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell,
.popup-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell {
  display: grid;
  grid-template-columns: minmax(118rpx, 0.7fr) minmax(0, 1.3fr);
  gap: 18rpx;
  align-items: center;
  width: 100%;
  min-width: 0;
  padding: 14rpx 0;
  text-align: right;
  border-bottom: 1rpx solid rgba(226,237,247,0.84);
  box-sizing: border-box;
}

.task-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell:last-child,
.result-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell:last-child,
.popup-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell:last-child {
  border-bottom: 0;
}

.task-table.ui-data-grid--complex .progress-cell,
.result-table.ui-data-grid--complex .progress-cell,
.popup-table.ui-data-grid--complex .progress-cell {
  width: 100%;
  min-width: 0;
}

.ui-data-grid--specialized {
  overflow: auto;
  overscroll-behavior: contain;
}

/* 状态 */
.status-tag,
.booking-status,
.audit-chip,
.green-chip,
.blue-chip,
.orange-chip,
.gray-chip,
.red-chip,
.mode-chip,
.venue-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  box-shadow:
    0 4rpx 10rpx rgba(15,23,42,0.03),
    inset 0 1rpx 0 rgba(255,255,255,0.60);
}

.progress-track,
.audit-flow-progress-bar,
.timeline-bar {
  background: linear-gradient(135deg, rgba(226,237,247,0.78), rgba(248,251,255,0.68));
  border: 1rpx solid rgba(255,255,255,0.66);
  box-shadow: inset 0 1rpx 4rpx rgba(15,23,42,0.08);
}

.progress-fill,
.audit-flow-progress-fill,
.timeline-selection {
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 54%, #60a5fa 100%);
  box-shadow: 0 0 14rpx rgba(59,130,246,0.20);
}

/* Persistent motion classes own the release curve; hover classes own the held state. */
.ui-motion-button,
.ui-motion-card,
.ui-motion-chip {
  transform: translate3d(0, 0, 0) scale(1);
  transform-origin: center;
  backface-visibility: hidden;
}

.ui-motion-button {
  transition:
    transform 0.22s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.24s ease,
    opacity 0.18s ease,
    filter 0.20s ease;
}

.ui-motion-card {
  transition:
    transform 0.24s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.26s ease,
    opacity 0.20s ease,
    filter 0.20s ease;
}

.ui-motion-chip {
  transition:
    transform 0.22s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.22s ease,
    opacity 0.18s ease,
    color 0.20s ease,
    background 0.20s ease,
    border-color 0.20s ease;
}

.ui-press-button,
.button-pressing,
button:active,
.primary-btn:active,
.secondary-btn:active,
.danger-btn:active,
.approve-btn:active,
.reject-btn:active {
  transform: translate3d(0, 2rpx, 0) scale(0.986);
  opacity: 0.97;
  filter: saturate(1.02) brightness(0.995);
  box-shadow:
    0 6rpx 14rpx rgba(37,99,235,0.11),
    inset 0 3rpx 9rpx rgba(15,23,42,0.07),
    inset 0 1rpx 0 rgba(255,255,255,0.72);
  transition-duration: 0.12s;
}

.ui-press-card,
.control-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.992);
  opacity: 0.975;
  filter: saturate(1.015) brightness(1.003);
  box-shadow:
    0 7rpx 16rpx rgba(37,99,235,0.09),
    inset 0 2rpx 7rpx rgba(15,23,42,0.05),
    inset 0 1rpx 0 rgba(255,255,255,0.76);
  transition-duration: 0.13s;
}

.ui-press-chip,
.link:active,
.action-btn:active,
.audit-link-btn:active,
.flow-action-btn:active,
.step-action-link:active,
.pending-action-link:active,
.tab:active,
.feature-tab:active,
.filter-chip:active,
.chip:active,
.role-pill:active {
  transform: translate3d(0, 1rpx, 0) scale(0.985);
  opacity: 0.92;
  transition-duration: 0.12s;
}

/* 容器壳永不响应子控件按压 */
.card:active,
.section:active,
.edit-box:active,
.list-card:active,
.booking-panel:active,
.filter-section:active,
.popup-card:active,
.modal-card:active,
.sheet-panel:active {
  transform: none;
  opacity: 1;
  filter: none;
}

.card-loading-overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
}

.card-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 5rpx solid rgba(59,130,246,0.16);
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: uiSpin 0.72s linear infinite;
}

.page-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  padding: 40rpx 24rpx 28rpx;
  color: #94a3b8;
  font-size: 21rpx;
  line-height: 1.7;
}

.page-footer .footer-name {
  color: #7b8ba3;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.page-footer .footer-org {
  color: #506380;
  font-size: 24rpx;
  font-weight: 650;
}

@keyframes glassFadeUp {
  from { opacity: 0; transform: translateY(18rpx) scale(0.994); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes uiSpin {
  to { transform: rotate(360deg); }
}

/* Pad 竖屏 */
@media (min-width: 520px) {
  page {
    --ui-font-xs: 12px;
    --ui-font-sm: 13px;
    --ui-font-md: 15px;
    --ui-font-lg: 18px;
    --ui-font-xl: 28px;
    --ui-line-control: 20px;
    --ui-control-height: 48px;
    --ui-control-padding-y: 12px;
    --ui-control-padding-x: 20px;
    --ui-compact-height: 36px;
  }

  .page {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 24px 38px;
    font-size: 15px;
    line-height: 1.6;
  }

  .page.page-narrow {
    max-width: 600px;
  }

  .hero,
  .hero-admin {
    padding: 30px 30px 28px;
    border-radius: 28px;
  }

  .hero-title {
    font-size: 28px !important;
    line-height: 1.28 !important;
  }

  .hero-subtitle {
    font-size: 15px !important;
    line-height: 1.6 !important;
  }

  .hero-badge {
    min-height: 28px !important;
    padding: 5px 12px !important;
    font-size: 12px !important;
    line-height: 16px !important;
  }

  .section-title,
  .popup-title,
  .dialog-title,
  .card-title,
  .panel-title {
    font-size: 18px !important;
    line-height: 1.4 !important;
  }

  .list-title,
  .list-name,
  .field-label,
  .panel-note,
  .field-hint,
  .list-desc,
  .section-desc {
    line-height: 1.55 !important;
  }

  .list-title,
  .list-name {
    font-size: 16px !important;
  }

  .audit-submission-title,
  .pending-title,
  .booking-title,
  .booking-item-title,
  .venue-name,
  .detail-title,
  .flow-step-name,
  .audit-step-title {
    font-size: 16px !important;
    line-height: 1.5 !important;
    overflow-wrap: anywhere;
  }

  .field-label {
    font-size: 14px !important;
  }

  .panel-note,
  .field-hint,
  .list-desc,
  .section-desc {
    font-size: 13px !important;
  }

  .audit-submission-meta,
  .audit-submission-desc-text,
  .pending-meta,
  .booking-meta,
  .booking-item-meta,
  .venue-loc,
  .detail-val,
  .flow-info-desc,
  .audit-step-meta {
    font-size: 13px !important;
    line-height: 1.6 !important;
  }

  .primary-btn,
  .secondary-btn,
  .danger-btn,
  .approve-btn,
  .reject-btn,
  .profile-submit-btn,
  .page-submit-btn,
  .template-save-btn,
  .purpose-save-btn,
  .dialog-btn,
  .sigpad-btn {
    min-height: 48px !important;
    height: auto !important;
    padding: 12px 20px !important;
    font-size: 15px !important;
    line-height: 20px !important;
    white-space: normal !important;
    word-break: normal !important;
    overflow-wrap: anywhere;
  }

  button {
    min-height: 48px !important;
    height: auto !important;
    padding: 12px 20px !important;
    font-size: 15px !important;
    line-height: 20px !important;
  }

  button > text {
    line-height: inherit !important;
  }

  .link,
  .action-btn,
  .audit-link-btn,
  .flow-action-btn,
  .step-action-link,
  .pending-action-link,
  .pill-link,
  .header-nav-btn,
  .mark-all-read,
  .placement-page-btn,
  .cancel-btn {
    min-height: 36px !important;
    height: auto !important;
    padding: 8px 14px !important;
    font-size: 13px !important;
    line-height: 18px !important;
    white-space: nowrap !important;
    word-break: keep-all !important;
  }

  .tab,
  .feature-tab,
  .rules-tab,
  .app-view-tab,
  .filter-chip,
  .chip,
  .select-chip,
  .grade-chip,
  .dept-tab,
  .hour-chip,
  .min-chip,
  .duration-chip,
  .role-pill {
    min-height: 36px;
    padding: 8px 14px;
    font-size: 13px !important;
    line-height: 18px !important;
    white-space: nowrap;
    word-break: keep-all;
    box-sizing: border-box;
  }

  .button-row,
  .dialog-actions,
  .audit-btn-bar,
  .inline-actions,
  .list-actions-below {
    flex-wrap: wrap;
    row-gap: 10px;
  }

  .button-row,
  .dialog-actions,
  .audit-btn-bar,
  .inline-actions {
    justify-content: center;
  }

  .button-row button,
  .dialog-btn,
  .audit-btn-bar button {
    flex: 0 1 auto;
    min-width: 128px;
    max-width: 320px;
  }

  .popup-card,
  .modal-card {
    max-width: 720px;
    padding: 24px;
    border-radius: 24px;
  }

  .ui-overlay {
    padding: 24px;
  }

  .ui-overlay .ui-dialog-shell {
    height: auto;
    max-height: calc(100vh - 48px);
  }

  .ui-overlay .ui-dialog-shell--compact {
    max-width: 520px;
  }

  .ui-overlay .ui-dialog-shell--complex,
  .ui-overlay .ui-dialog-shell--wide {
    width: 100%;
    max-width: 720px;
  }

  .ui-dialog-footer {
    padding-top: 14px;
    padding-bottom: max(0px, env(safe-area-inset-bottom));
  }

  .field-input,
  .field-textarea,
  .picker-value,
  .picker-display,
  .compact-picker-value {
    min-height: 46px !important;
    height: auto !important;
    padding: 11px 14px !important;
    border-radius: 14px !important;
    font-size: 15px !important;
    line-height: 22px !important;
  }

  input.field-input,
  textarea.field-textarea {
    display: block !important;
  }

  .status-tag,
  .booking-status,
  .audit-chip,
  .green-chip,
  .blue-chip,
  .orange-chip,
  .gray-chip,
  .red-chip,
  .mode-chip,
  .venue-tag {
    flex-shrink: 0;
    font-size: 12px !important;
    line-height: 16px !important;
  }

  .task-table.ui-data-grid--complex > .ui-data-row--header,
  .result-table.ui-data-grid--complex > .ui-data-row--header,
  .popup-table.ui-data-grid--complex > .ui-data-row--header {
    display: flex;
  }

  .task-table.ui-data-grid--complex > .ui-data-row,
  .result-table.ui-data-grid--complex > .ui-data-row,
  .popup-table.ui-data-grid--complex > .ui-data-row {
    display: flex;
    margin-bottom: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .task-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell,
  .result-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell,
  .popup-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell {
    display: flex;
    width: auto;
    min-width: 0;
    padding: 14px 12px;
    text-align: center;
    border-bottom: 0;
  }

  .ui-data-cell-label {
    display: none;
  }

  .ui-data-cell-content {
    width: 100%;
    text-align: center;
  }

  .footer-name {
    font-size: 12px !important;
    line-height: 18px !important;
  }

  .footer-org {
    font-size: 14px !important;
    line-height: 20px !important;
  }
}

/* Pad 横屏工作台 */
@media (min-width: 900px) {
  .page {
    max-width: 1180px;
    padding: 28px 32px 40px;
  }

  .hero,
  .hero-admin {
    margin-bottom: 22px;
  }

  .popup-card,
  .modal-card {
    max-width: 860px;
  }

  .completion-popup-card,
  .timetable-popup,
  .placement-popup {
    max-width: 1040px;
  }

  .ui-overlay .ui-dialog-shell--complex {
    max-width: 860px;
  }

  .ui-overlay .ui-dialog-shell--wide {
    max-width: 1040px;
  }
}

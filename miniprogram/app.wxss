.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

button {
  background: initial;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 30rpx;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

page {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.14), transparent 28%),
    radial-gradient(circle at 86% 16%, rgba(191, 219, 254, 0.18), transparent 24%),
    linear-gradient(180deg, #f8fbff 0%, #eef5ff 48%, #edf4fb 100%);
  color: #163047;
}

input,
textarea {
  box-sizing: border-box;
}

@keyframes glassFadeUp {
  from {
    opacity: 0.01;
    transform: translateY(18rpx) scale(0.992);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.page-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 30rpx 36rpx;
  margin-top: 40rpx;
  color: #7b8ba3;
  font-size: 24rpx;
  line-height: 1.8;
  letter-spacing: 2rpx;
}

.page-footer .footer-name {
  font-size: 20rpx;
  color: #8b9bb5;
  letter-spacing: 4rpx;
}

.page-footer .footer-org {
  font-size: 26rpx;
  font-weight: 600;
  color: #506380;
}

/* Global glass UI baseline */
.card,
.section,
.edit-box,
.list-card,
.filter-section,
.booking-panel,
.popup-card {
  box-sizing: border-box;
}

.card,
.section,
.edit-box,
.list-card,
.filter-section {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.82) 0%, rgba(248, 251, 255, 0.70) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.64);
  box-shadow:
    0 18rpx 36rpx rgba(15, 23, 42, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.list-item,
.nav-row,
.booking-item,
.pending-item,
.task-table,
.popup-table,
.question-card,
.audit-submission-item,
.file-attach-item {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(249, 251, 255, 0.82) 100%);
  border: 1rpx solid rgba(226, 237, 247, 0.96);
  box-shadow:
    0 12rpx 24rpx rgba(15, 23, 42, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
}

.primary-btn,
.secondary-btn,
.danger-btn,
.approve-btn,
.reject-btn,
.link,
.action-btn,
.filter-chip,
.chip,
.header-nav-btn,
.pending-action-link {
  transition: transform 0.14s ease, box-shadow 0.2s ease, opacity 0.14s ease, filter 0.2s ease;
}

.primary-btn:active,
.secondary-btn:active,
.danger-btn:active,
.approve-btn:active,
.reject-btn:active,
.link:active,
.action-btn:active,
.filter-chip:active,
.chip:active,
.header-nav-btn:active,
.pending-action-link:active {
  transform: translateY(1rpx) scale(0.985);
  opacity: 0.92;
  filter: saturate(1.03);
}

.status-tag,
.booking-status,
.audit-chip,
.green-chip,
.blue-chip,
.orange-chip,
.gray-chip,
.red-chip,
.mode-chip,
.venue-tag {
  border-radius: 999rpx;
  box-shadow:
    0 6rpx 14rpx rgba(15, 23, 42, 0.035),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.56);
}

.progress-track,
.audit-flow-progress-bar,
.timeline-bar {
  background: linear-gradient(135deg, rgba(226, 237, 247, 0.78) 0%, rgba(248, 251, 255, 0.68) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow:
    inset 0 1rpx 4rpx rgba(15, 23, 42, 0.08),
    0 8rpx 18rpx rgba(15, 23, 42, 0.025);
}

.progress-fill,
.audit-flow-progress-fill,
.timeline-selection {
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 54%, #60a5fa 100%);
  box-shadow: 0 0 18rpx rgba(37, 99, 235, 0.24);
}


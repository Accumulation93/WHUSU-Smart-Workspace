/*
 * WHUSU Smart Workspace 前端 UI Kit（2026-08）
 *
 * 这里是共享视觉令牌的唯一运行时入口。手机、Pad 竖屏、Pad 横屏
 * 使用同一套语义角色，但各自拥有独立的字号、间距、半径和控件高度。
 * 页面 WXSS 只负责布局差异，不重新猜测基础尺寸。
 * 设计说明、组件清单和页面模板：docs/ui-kit.md、docs/ui-components.md、
 * docs/ui-page-templates.md。
 */

page {
  --ui-blue-700: #2563eb;
  --ui-blue-500: #3b82f6;
  --ui-blue-400: #60a5fa;
  --ui-text: #0f172a;
  --ui-text-body: #334155;
  --ui-text-muted: #64748b;
  --ui-text-soft: #94a3b8;
  --ui-line: rgba(226, 237, 247, 0.96);
  --ui-line-blue: rgba(147, 197, 253, 0.64);
  --ui-danger: #ef4444;
  /* compact phone：<390px。单位保留 rpx，适合窄屏的触控密度。 */
  --ui-type-micro: 10px;
  --ui-type-caption: 11px;
  --ui-type-meta: 12px;
  --ui-type-label: 12.5px;
  --ui-type-control: 13px;
  --ui-type-body: 13.5px;
  --ui-type-emphasis: 14px;
  --ui-type-value: 15px;
  --ui-type-section: 16px;
  --ui-type-dialog: var(--ui-type-section);
  --ui-type-page: 24px;
  /* 弹窗空间更集中，使用独立的紧凑字阶，避免手机上产生“老年机”式放大。 */
  --ui-dialog-title-size: 15px;
  --ui-dialog-body-size: 12.5px;
  --ui-dialog-meta-size: 11.5px;
  --ui-dialog-label-size: 12px;
  --ui-dialog-control-size: 12.5px;
  --ui-page-padding-top: 30rpx;
  --ui-page-padding-x: 24rpx;
  --ui-page-padding-bottom: 42rpx;
  --ui-hero-gap: 24rpx;
  --ui-hero-padding-top: 40rpx;
  --ui-hero-padding-x: 34rpx;
  --ui-hero-padding-bottom: 36rpx;
  --ui-hero-radius: 38rpx;
  --ui-card-gap: 24rpx;
  --ui-card-padding-y: 28rpx;
  --ui-card-padding-x: 26rpx;
  --ui-card-radius: 30rpx;
  --ui-list-gap: 14rpx;
  --ui-list-padding-y: 22rpx;
  --ui-list-padding-x: 20rpx;
  --ui-list-radius: 20rpx;
  --ui-control-radius: 24rpx;
  --ui-field-radius: 20rpx;
  --ui-section-title-inset: 20rpx;
  --ui-font-xs: var(--ui-type-caption);
  --ui-font-sm: var(--ui-type-meta);
  --ui-font-md: var(--ui-type-body);
  --ui-font-lg: var(--ui-type-section);
  --ui-font-xl: var(--ui-type-page);
  --ui-leading-control: 1.35;
  --ui-leading-heading: 1.45;
  --ui-leading-body: 1.6;
  --ui-leading-relaxed: 1.7;
  --ui-line-control: var(--ui-leading-control);
  --ui-control-height: 82rpx;
  --ui-control-padding-y: 16rpx;
  --ui-control-padding-x: 28rpx;
  --ui-compact-height: 52rpx;
  --ui-tab-font-size: var(--ui-type-control);
  --ui-tab-min-height: 76rpx;
  --ui-tab-sidebar-min-height: 84rpx;
  --ui-tab-padding-y: 16rpx;
  --ui-tab-padding-x: 18rpx;
  --ui-tab-gap: 8rpx;
  --ui-tab-shell-padding: 8rpx;
  --ui-tab-radius: 20rpx;
  --ui-tab-shell-radius: 26rpx;
  --ui-dialog-edge: 24rpx;
  --ui-dialog-width-inset: 48rpx;
  --ui-dialog-padding: 26rpx;
  --ui-dialog-section-gap: 18rpx;
  --ui-dialog-footer-gap: 16rpx;
  --ui-dialog-radius: 30rpx;
  min-height: 100%;
  touch-action: manipulation;
  -webkit-text-size-adjust: 100%;
  color: #0f172a;
  color: var(--ui-text, #0f172a);
  line-height: 1.55;
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

/* standard phone：390–519px。字号略增，触控和卡片密度保持手机比例。 */
@media (min-width: 390px) and (max-width: 519px) {
  page {
    --ui-type-micro: 10.5px;
    --ui-type-caption: 11.5px;
    --ui-type-meta: 12.5px;
    --ui-type-label: 13px;
    --ui-type-control: 13.5px;
    --ui-type-body: 14px;
    --ui-type-emphasis: 14.5px;
    --ui-type-value: 15.5px;
    --ui-type-section: 17px;
    --ui-type-page: 25.5px;
    --ui-dialog-title-size: 15.5px;
    --ui-dialog-body-size: 13px;
    --ui-dialog-meta-size: 12px;
    --ui-dialog-label-size: 12.5px;
    --ui-dialog-control-size: 13px;
    --ui-page-padding-top: 30rpx;
    --ui-page-padding-x: 24rpx;
    --ui-page-padding-bottom: 42rpx;
    --ui-hero-gap: 22rpx;
    --ui-card-gap: 22rpx;
    --ui-list-gap: 14rpx;
  }
}

button,
input,
textarea,
picker,
view,
text,
scroll-view {
  font-family: inherit;
}

button,
input,
textarea {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  min-height: var(--ui-control-height, 82rpx);
  height: auto;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  border-radius: var(--ui-control-radius, 24rpx);
  font-size: var(--ui-font-md, 25rpx);
  line-height: var(--ui-line-control, 1.35);
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
}

button::after {
  border: 0;
}

input,
textarea {
  display: block;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

/* 页面与 Hero */
.page {
  position: relative;
  min-height: 100vh;
  padding: var(--ui-page-padding-top) var(--ui-page-padding-x) calc(var(--ui-page-padding-bottom) + env(safe-area-inset-bottom));
  font-size: var(--ui-type-body);
  line-height: var(--ui-leading-body);
  box-sizing: border-box;
}

.hero,
.hero-admin {
  position: relative;
  overflow: hidden;
  margin-bottom: var(--ui-hero-gap);
  padding: var(--ui-hero-padding-top) var(--ui-hero-padding-x) var(--ui-hero-padding-bottom);
  border-radius: var(--ui-hero-radius);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-shadow:
    0 24rpx 48rpx rgba(37, 99, 235, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  animation: glassFadeUp 0.42s cubic-bezier(0.16, 0.84, 0.28, 1) both;
}

.hero {
  background:
    radial-gradient(circle at 84% 8%, rgba(255,255,255,0.22), transparent 28%),
    linear-gradient(135deg, #2563eb 0%, #3b82f6 52%, #60a5fa 100%);
}

.hero-admin {
  background:
    radial-gradient(circle at 84% 10%, rgba(96,165,250,0.24), transparent 30%),
    linear-gradient(135deg, rgba(15,23,42,0.97) 0%, rgba(30,58,138,0.95) 58%, rgba(37,99,235,0.92) 100%);
  box-shadow:
    0 26rpx 52rpx rgba(15, 23, 42, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}

.hero-badge,
.hero-title,
.hero-subtitle {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  margin-bottom: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: rgba(255,255,255,0.96);
  font-size: var(--ui-type-caption);
  font-weight: 700;
  background: linear-gradient(135deg, rgba(255,255,255,0.22), rgba(255,255,255,0.12));
  border: 1rpx solid rgba(255,255,255,0.28);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.22);
}

.hero-title {
  color: #ffffff;
  font-size: var(--ui-type-page);
  font-size: var(--ui-font-xl, 46rpx);
  font-weight: 800;
  line-height: 1.24;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: rgba(248,250,252,0.90);
  font-size: var(--ui-type-body);
  font-size: var(--ui-font-md, 25rpx);
  font-weight: 600;
  line-height: 1.6;
}

/* 三级玻璃表面 */
.card,
.section,
.edit-box,
.list-card,
.booking-panel,
.filter-section,
.popup-card,
.modal-card,
.sheet-panel {
  position: relative;
  box-sizing: border-box;
  transform: none;
}

.card,
.section,
.edit-box,
.list-card,
.booking-panel {
  border-radius: var(--ui-card-radius, 30rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.86), rgba(248,251,255,0.72));
  border: 1rpx solid rgba(255,255,255,0.72);
  box-shadow:
    0 18rpx 36rpx rgba(15,23,42,0.055),
    inset 0 1rpx 0 rgba(255,255,255,0.82);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.filter-section {
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(248,251,255,0.62));
  border: 1rpx solid rgba(226,237,247,0.84);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.list-item,
.nav-row,
.booking-item,
.pending-item,
.question-card,
.audit-submission-item,
.file-attach-item,
.template-select-item,
.audit-person-item,
.task-table-row,
.result-table-row,
.popup-table-row {
  position: relative;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(249,251,255,0.84));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow:
    0 10rpx 22rpx rgba(15,23,42,0.038),
    inset 0 1rpx 0 rgba(255,255,255,0.82);
}

/* 标题 */
.section-title {
  position: relative;
  margin: 0;
  padding-left: var(--ui-section-title-inset, 20rpx);
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-size: var(--ui-font-lg, 30rpx);
  font-weight: 800;
  line-height: 1.4;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 7rpx;
  height: 28rpx;
  border-radius: 999rpx;
  transform: translateY(-50%);
  background: linear-gradient(180deg, #3b82f6 0%, #60a5fa 100%);
  box-shadow: 0 0 12rpx rgba(96,165,250,0.20);
}

.list-title {
  color: #0f172a;
  font-size: var(--ui-type-value, 28rpx);
  font-weight: 800;
  line-height: var(--ui-leading-heading, 1.45);
}

.list-desc,
.section-desc,
.panel-note,
.field-hint {
  color: #64748b;
  font-size: var(--ui-type-meta);
  font-size: var(--ui-font-sm, 22rpx);
  line-height: 1.65;
}

/*
 * 全局文字角色契约。
 * 页面可以改变颜色、字重和排版，但不得让同一角色在不同设备上越级或倒置。
 */
page .hero-title,
page .hero-admin-title {
  font-size: var(--ui-type-page) !important;
  line-height: 1.28 !important;
}

page .hero-subtitle,
page .hero-admin-subtitle {
  font-size: var(--ui-type-body) !important;
  line-height: var(--ui-leading-body) !important;
}

page .section-title,
page .card-title,
page .panel-title {
  font-size: var(--ui-type-section) !important;
  line-height: 1.4 !important;
}

page .popup-title,
page .dialog-title,
page .message-switch-title {
  font-size: var(--ui-dialog-title-size) !important;
  line-height: var(--ui-leading-heading) !important;
}

page .list-title,
page .list-name,
page .activity-name,
page .info-value,
page .target-name,
page .member-name,
page .merit-card-name,
page .result-group-label,
page .question-title,
page .template-title,
page .message-title,
page .notification-title,
page .pending-title,
page .booking-title,
page .booking-item-title,
page .venue-name,
page .detail-title,
page .flow-step-name,
page .audit-step-title,
page .audit-submission-title {
  font-size: var(--ui-type-value) !important;
  line-height: var(--ui-leading-heading) !important;
  overflow-wrap: anywhere;
}

page .field-label,
page .filter-label,
page .info-label,
page .detail-key,
page .organization-filter-label {
  font-size: var(--ui-type-label) !important;
  line-height: 1.5 !important;
}

page .list-desc,
page .section-desc,
page .panel-note,
page .field-hint,
page .message-desc,
page .notification-desc,
page .dialog-desc,
page .message-switch-desc,
page .pending-meta,
page .booking-meta,
page .booking-item-meta,
page .venue-loc,
page .detail-val,
page .flow-info-desc,
page .audit-step-meta,
page .audit-submission-meta,
page .audit-submission-desc-text {
  font-size: var(--ui-type-meta) !important;
  line-height: var(--ui-leading-body) !important;
}

page .message-time,
page .notification-time,
page .status-chip,
page .status-tag {
  font-size: var(--ui-type-caption) !important;
  line-height: 1.4 !important;
}

page .field-input,
page .field-textarea,
page .picker-display,
page .picker-value {
  font-size: var(--ui-type-body) !important;
}

/* 按钮体系 */
.primary-btn,
.secondary-btn,
.danger-btn,
.approve-btn,
.reject-btn,
.profile-submit-btn,
.page-submit-btn,
.template-save-btn,
.purpose-save-btn,
.dialog-btn,
.sigpad-btn {
  position: relative;
  min-height: 82rpx;
  min-height: var(--ui-control-height, 82rpx);
  height: auto;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  border-radius: 24rpx;
  border: 1rpx solid transparent;
  font-size: var(--ui-type-body);
  font-size: var(--ui-font-md, 25rpx);
  font-weight: 750;
  line-height: var(--ui-line-control, 1.35);
  box-sizing: border-box;
  transition:
    transform 0.22s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.22s ease,
    opacity 0.18s ease,
    filter 0.20s ease,
    background 0.22s ease,
    border-color 0.22s ease;
}

/* 原生文字按钮保持紧凑圆角矩形；胶囊形仅用于标签、chip、内联链接或纯图标控件。 */
.button-row > button {
  flex: 1 1 calc(50% - 7rpx);
  min-width: calc(50% - 7rpx);
  max-width: 100%;
  border-radius: 20rpx;
  line-height: var(--ui-line-control, 1.35);
}

.primary-btn,
.approve-btn,
.profile-submit-btn,
.page-submit-btn,
.template-save-btn,
.purpose-save-btn,
.sigpad-btn-primary,
.action-btn.primary,
.pending-action-link.approve,
.approval-btn-approve {
  color: #ffffff;
  background:
    radial-gradient(circle at 24% 4%, rgba(255,255,255,0.26), transparent 28%),
    linear-gradient(135deg, #2563eb 0%, #3b82f6 52%, #60a5fa 100%);
  border-color: rgba(147,197,253,0.64);
  box-shadow:
    0 14rpx 28rpx rgba(37,99,235,0.18),
    inset 0 1rpx 0 rgba(255,255,255,0.26);
}

.secondary-btn,
.dialog-btn,
.sigpad-btn-secondary {
  color: #2457a7;
  background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(239,246,255,0.86));
  border-color: rgba(147,197,253,0.70);
  box-shadow:
    0 10rpx 22rpx rgba(37,99,235,0.075),
    inset 0 1rpx 0 rgba(255,255,255,0.88);
}

.danger-btn,
.reject-btn,
.approval-btn-reject {
  color: #ffffff;
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  border-color: rgba(252,165,165,0.62);
  box-shadow:
    0 12rpx 24rpx rgba(239,68,68,0.15),
    inset 0 1rpx 0 rgba(255,255,255,0.22);
}

button[disabled],
.disabled,
.button-disabled {
  opacity: 0.48;
  filter: grayscale(0.12) saturate(0.72);
  transform: none;
}

/* 小型操作与选择控件 */
.link,
.action-btn,
.audit-link-btn,
.flow-action-btn,
.step-action-link,
.pending-action-link,
.pill-link,
.pill-close,
.header-nav-btn,
.mark-all-read,
.popup-close,
.modal-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #2563eb;
  font-size: var(--ui-type-meta);
  font-size: var(--ui-font-sm, 22rpx);
  font-weight: 750;
  line-height: 1.25;
  background: linear-gradient(135deg, rgba(239,246,255,0.92), rgba(219,234,254,0.72));
  border: 1rpx solid rgba(147,197,253,0.58);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.72);
  box-sizing: border-box;
  transition:
    transform 0.22s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.20s ease,
    opacity 0.18s ease,
    background 0.20s ease;
}

.link.danger,
.audit-link-danger,
.flow-action-danger,
.step-action-danger,
.pending-action-link.reject,
.pill-close {
  color: #dc2626;
  background: linear-gradient(135deg, rgba(254,242,242,0.94), rgba(254,226,226,0.78));
  border-color: rgba(252,165,165,0.58);
}

.popup-close,
.modal-close {
  min-height: 0;
  padding: 4rpx 0 4rpx 14rpx;
  border: 0;
  border-radius: 0;
  color: #475569;
  background: transparent;
  box-shadow: none;
}

.popup-close::after {
  content: "×";
  margin-left: 8rpx;
  color: #3b82f6;
  font-size: var(--ui-type-value);
  font-weight: 800;
}

/* Tabs 与 Chip，持续状态和按压状态相互独立 */
.tabs,
.tabs-card,
.message-tabs {
  display: flex;
  gap: var(--ui-tab-gap, 8rpx);
  padding: var(--ui-tab-shell-padding, 8rpx);
  border-radius: var(--ui-tab-shell-radius, 26rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(248,251,255,0.62));
  border: 1rpx solid rgba(255,255,255,0.70);
  box-shadow:
    0 12rpx 26rpx rgba(15,23,42,0.045),
    inset 0 1rpx 0 rgba(255,255,255,0.82);
}

.tab,
.feature-tab,
.rules-tab,
.app-view-tab,
.message-tab,
.filter-chip,
.chip,
.select-chip,
.grade-chip,
.dept-tab,
.hour-chip,
.min-chip,
.duration-chip,
.role-pill {
  position: relative;
  box-sizing: border-box;
  transition:
    transform 0.22s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.20s ease,
    color 0.20s ease,
    background 0.20s ease,
    border-color 0.20s ease;
}

.tab,
.feature-tab,
.rules-tab,
.app-view-tab,
.message-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--ui-tab-min-height, 66rpx);
  padding: var(--ui-tab-padding-y, 14rpx) var(--ui-tab-padding-x, 18rpx);
  border-radius: var(--ui-tab-radius, 20rpx);
  font-size: var(--ui-tab-font-size, 24rpx) !important;
  line-height: var(--ui-leading-control, 1.35) !important;
  white-space: nowrap;
  word-break: keep-all;
  text-align: center;
}

.tab-active,
.feature-tab-active,
.rules-tab-active,
.app-view-tab-active,
.filter-chip-active,
.select-chip-active,
.grade-chip-active,
.dept-tab-active,
.hour-chip-active,
.min-chip-active,
.duration-chip-active,
.role-pill-active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  border-color: rgba(147,197,253,0.64);
  box-shadow:
    0 10rpx 20rpx rgba(37,99,235,0.16),
    inset 0 1rpx 0 rgba(255,255,255,0.24);
}

/* 表单 */
.field-input,
.field-textarea,
.picker-value,
.picker-display,
.compact-picker-value {
  display: block;
  width: 100%;
  min-height: 76rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--ui-field-radius, 20rpx);
  color: #10233d;
  font-size: var(--ui-type-body);
  line-height: 1.55;
  background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(246,249,255,0.90));
  border: 1rpx solid rgba(219,229,241,0.96);
  box-shadow:
    0 7rpx 16rpx rgba(15,23,42,0.032),
    inset 0 1rpx 0 rgba(255,255,255,0.88);
  box-sizing: border-box;
  transform: none;
  transition:
    box-shadow 0.22s ease,
    border-color 0.20s ease,
    background 0.22s ease;
}

.field-input:focus,
.field-textarea:focus {
  transform: none;
  border-color: rgba(96,165,250,0.88);
  background: linear-gradient(135deg, rgba(255,255,255,0.99), rgba(239,246,255,0.92));
  box-shadow:
    0 9rpx 20rpx rgba(37,99,235,0.08),
    0 0 0 3rpx rgba(191,219,254,0.42),
    inset 0 1rpx 0 rgba(255,255,255,0.92);
}

/* 弹窗 */
.popup-mask,
.dialog-layer,
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
  background: rgba(15,23,42,0.34);
  box-sizing: border-box;
}

/* 遮罩统一带轻度磨砂，与模块级 blue-polish 的弹窗语言对齐 */
.popup-mask,
.modal-mask {
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
}

.popup-card,
.modal-card {
  width: 100%;
  max-height: 88vh;
  padding: var(--ui-dialog-padding);
  border-radius: var(--ui-dialog-radius);
  overflow: hidden;
  background: linear-gradient(135deg, rgba(255,255,255,0.97), rgba(248,251,255,0.91));
  border: 1rpx solid rgba(255,255,255,0.84);
  box-shadow:
    0 24rpx 52rpx rgba(15,23,42,0.16),
    inset 0 1rpx 0 rgba(255,255,255,0.90);
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-dialog-section-gap);
  margin-bottom: var(--ui-dialog-section-gap);
}

.popup-title {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-size: var(--ui-font-lg, 30rpx);
  font-weight: 800;
  line-height: 1.4;
}

/* 稳定弹窗与响应式数据布局契约 */
.ui-overlay {
  position: fixed !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: 0 !important;
  z-index: 2000 !important;
  display: block !important;
  width: 100vw !important;
  height: 100vh !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
  overscroll-behavior: none;
  background: rgba(15,23,42,0.34) !important;
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  box-sizing: border-box;
  isolation: isolate;
  touch-action: manipulation !important;
  -webkit-text-size-adjust: 100%;
}

.ui-overlay .ui-dialog-shell {
  position: fixed !important;
  top: 50vh !important;
  left: 50vw !important;
  right: auto !important;
  bottom: auto !important;
  z-index: 1 !important;
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  width: calc(100vw - var(--ui-dialog-width-inset)) !important;
  min-width: 0;
  max-width: calc(100vw - var(--ui-dialog-width-inset)) !important;
  margin: 0 !important;
  transform: translate(-50%, -50%) !important;
  max-height: calc(100vh - var(--ui-dialog-width-inset) - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
  overflow-x: hidden;
  overflow-y: hidden !important;
  overscroll-behavior: none;
  box-sizing: border-box;
  pointer-events: auto !important;
  touch-action: auto !important;
  -webkit-text-size-adjust: 100%;
}

/* 透明挡板只拦截背景滑动；弹窗外壳在其上方，内部 scroll-view 仍可独立滚动。 */
.ui-overlay .ui-overlay-blocker {
  position: fixed !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: 0 !important;
  z-index: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  margin: 0 !important;
  background: transparent;
  pointer-events: auto !important;
  touch-action: none !important;
}

.ui-overlay .ui-dialog-shell--compact {
  height: auto;
  max-width: 640rpx !important;
}

.ui-overlay .ui-dialog-shell--complex {
  height: auto;
}

.ui-overlay .ui-dialog-shell--wide {
  top: calc(env(safe-area-inset-top) + var(--ui-dialog-edge)) !important;
  bottom: calc(env(safe-area-inset-bottom) + var(--ui-dialog-edge)) !important;
  height: auto !important;
  max-height: none !important;
  transform: translateX(-50%) !important;
}

/* 弹窗表面与内部留白统一由 UI Kit 令牌控制，页面只定义业务布局。 */
.ui-overlay .popup-card,
.ui-overlay .modal-card,
.ui-overlay .dialog-panel,
.ui-overlay .organization-picker-dialog,
.ui-overlay .message-switch-dialog {
  padding: var(--ui-dialog-padding) !important;
  border-radius: var(--ui-dialog-radius) !important;
  box-sizing: border-box !important;
}

.ui-overlay .permission-dialog {
  border-radius: var(--ui-dialog-radius) !important;
}

.ui-overlay .permission-dialog-header {
  gap: var(--ui-dialog-section-gap) !important;
  padding: var(--ui-dialog-padding) var(--ui-dialog-padding) var(--ui-dialog-section-gap) !important;
}

.ui-overlay .permission-dialog-body {
  padding: var(--ui-dialog-section-gap) var(--ui-dialog-padding) !important;
}

.ui-overlay .permission-dialog-footer {
  gap: var(--ui-dialog-section-gap) !important;
  padding: var(--ui-dialog-footer-gap) var(--ui-dialog-padding) !important;
}

.ui-dialog-header {
  flex: 0 0 auto;
  min-width: 0;
}

.ui-dialog-body {
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  min-height: 0;
  max-height: none;
  overflow-x: hidden;
  overflow-y: hidden;
  overscroll-behavior: contain;
  box-sizing: border-box;
}

/* 弹窗内部的滚动只能发生在显式 scroll-view 中，避免普通 view 形成竞争滚动层。 */
.ui-overlay .ui-dialog-shell > scroll-view.ui-dialog-body,
.ui-overlay .ui-dialog-shell > scroll-view.ui-dialog-scroll--fill,
.ui-overlay .ui-dialog-shell > scroll-view.ui-dialog-scroll--both,
.ui-overlay .ui-dialog-shell > scroll-view.ui-dialog-scroll--pane {
  overflow: hidden;
  overscroll-behavior: contain;
}

/* 内部关闭遮罩只负责点击，不重复绘制一层会造成错位的阴影。 */
.ui-overlay .dialog-mask,
.ui-overlay .message-switch-mask,
.ui-overlay .permission-mask {
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

/* 防止页面级 popup-mask/modal-mask 把背景按钮抬到弹窗之上。 */
view.popup-mask.ui-overlay,
view.dialog-layer.ui-overlay,
view.modal-mask.ui-overlay,
view.permission-overlay.ui-overlay,
view.message-switch-layer.ui-overlay {
  position: fixed !important;
  inset: 0 !important;
  z-index: 2000 !important;
  overflow: hidden !important;
  align-items: center !important;
  justify-content: center !important;
}

.ui-overlay .ui-dialog-shell > .ui-dialog-header,
.ui-overlay .ui-dialog-shell > .ui-dialog-footer {
  flex: 0 0 auto;
}

.ui-overlay .ui-dialog-shell > .ui-dialog-body {
  flex: 1 1 auto;
  min-height: 0;
  max-height: none;
}

/* 普通纵向内容按自身高度生长并以 max-height 截止；专业双向网格保留可计算视口。 */
scroll-view.ui-dialog-scroll--fill,
scroll-view.ui-dialog-scroll--both {
  display: block;
  flex: 1 1 auto;
  overflow: hidden;
  overscroll-behavior: contain;
}

scroll-view.ui-dialog-scroll--fill {
  height: auto;
  min-height: 0;
  max-height: 56vh;
}

scroll-view.ui-dialog-scroll--both {
  height: 64vh;
  min-height: 320rpx;
  max-height: calc(100vh - 220rpx - env(safe-area-inset-bottom));
}

scroll-view.ui-dialog-scroll--pane {
  display: block;
  flex: 1 1 auto;
  min-height: 120rpx;
  overflow: hidden;
  overscroll-behavior: contain;
}

/* 长表单或组合选择器：外层负责整组内容滚动，内层列表仍可独立翻动。 */
scroll-view.ui-dialog-stack-scroll {
  display: block;
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  min-height: 0;
  max-height: 68vh;
  overflow: hidden;
  overscroll-behavior: contain;
  box-sizing: border-box;
}

scroll-view.ui-dialog-selection-current {
  height: 280rpx;
  min-height: 200rpx;
  max-height: 34vh;
}

scroll-view.ui-dialog-selection-options {
  height: 480rpx;
  min-height: 320rpx;
  max-height: 52vh;
}

/* 手写区域必须锁定触摸，防止画线时被识别为弹窗滚动。 */
.ui-dialog-touch-lock,
.ui-dialog-touch-lock .ui-dialog-shell,
.ui-dialog-touch-lock .ui-dialog-body {
  overflow: hidden !important;
  overscroll-behavior: none;
}

scroll-view.ui-dialog-scroll--x {
  display: block;
  flex: 0 0 auto;
  width: 100%;
  height: auto;
  min-height: 0;
  overflow: hidden;
}

.ui-dialog-footer {
  flex: 0 0 auto;
  width: 100%;
  min-width: 0;
  padding-top: var(--ui-dialog-footer-gap);
  padding-bottom: 0;
  background: linear-gradient(180deg, rgba(248,251,255,0.12), rgba(248,251,255,0.96) 26%);
  box-sizing: border-box;
}

/* 居中弹窗的安全区由 overlay 统一负责；操作栏自身不再叠加外边距或第二份安全区。 */
.button-row.ui-dialog-footer,
.dialog-actions.ui-dialog-footer,
.audit-btn-bar.ui-dialog-footer,
.inline-actions.ui-dialog-footer {
  margin-top: 0;
  margin-bottom: 0;
}

.ui-dialog-footer button,
.ui-dialog-footer .link,
.ui-dialog-footer .audit-link-btn {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
}

/* 包裹型控件只由自身 padding 提供边缘留白，避免末项 margin 叠成空白尾部。 */
.card > view:first-child,
.edit-box > view:first-child,
.list-card > view:first-child,
.booking-panel > view:first-child,
.filter-section > view:first-child,
.popup-card > view:first-child,
.modal-card > view:first-child,
.ui-dialog-body > view:first-child,
.list-item > view:first-child,
.nav-row > view:first-child,
.booking-item > view:first-child,
.pending-item > view:first-child {
  margin-top: 0;
}

.card > view:last-child,
.edit-box > view:last-child,
.list-card > view:last-child,
.booking-panel > view:last-child,
.filter-section > view:last-child,
.popup-card > view:last-child,
.modal-card > view:last-child,
.ui-dialog-body > view:last-child,
.list-item > view:last-child,
.nav-row > view:last-child,
.booking-item > view:last-child,
.pending-item > view:last-child {
  margin-bottom: 0;
}

.ui-data-grid--simple,
.ui-data-grid--complex,
.ui-data-grid--specialized,
.ui-data-row,
.ui-data-cell {
  min-width: 0;
  box-sizing: border-box;
}

.ui-data-cell--primary,
.ui-data-cell--action,
.ui-control-text {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
}

.ui-data-cell--secondary {
  min-width: 0;
}

.ui-data-cell-label {
  display: block;
  color: #64748b;
  font-size: var(--ui-type-caption);
  font-weight: 750;
  line-height: 1.4;
}

.ui-data-cell-content {
  min-width: 0;
  text-align: right;
}

.task-table.ui-data-grid--complex > .ui-data-row--header,
.result-table.ui-data-grid--complex > .ui-data-row--header,
.popup-table.ui-data-grid--complex > .ui-data-row--header {
  display: none;
}

.task-table.ui-data-grid--complex > .ui-data-row,
.result-table.ui-data-grid--complex > .ui-data-row,
.popup-table.ui-data-grid--complex > .ui-data-row {
  display: block;
  margin-bottom: 16rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(191,219,254,0.62);
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(239,246,255,0.82));
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.86);
}

.task-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell,
.result-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell,
.popup-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell {
  display: grid;
  grid-template-columns: minmax(118rpx, 0.7fr) minmax(0, 1.3fr);
  gap: 18rpx;
  align-items: center;
  width: 100%;
  min-width: 0;
  padding: 14rpx 0;
  text-align: right;
  border-bottom: 1rpx solid rgba(226,237,247,0.84);
  box-sizing: border-box;
}

.task-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell:last-child,
.result-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell:last-child,
.popup-table.ui-data-grid--complex > .ui-data-row > .ui-data-cell:last-child {
  border-bottom: 0;
}

.task-table.ui-data-grid--complex .progress-cell,
.result-table.ui-data-grid--complex .progress-cell,
.popup-table.ui-data-grid--complex .progress-cell {
  width: 100%;
  min-width: 0;
}

.ui-data-grid--specialized {
  overflow: auto;
  overscroll-behavior: contain;
}

/* 状态 */
.status-tag,
.booking-status,
.audit-chip,
.green-chip,
.blue-chip,
.orange-chip,
.gray-chip,
.red-chip,
.mode-chip,
.venue-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  box-shadow:
    0 4rpx 10rpx rgba(15,23,42,0.03),
    inset 0 1rpx 0 rgba(255,255,255,0.60);
}

.progress-track,
.audit-flow-progress-bar,
.timeline-bar {
  background: linear-gradient(135deg, rgba(226,237,247,0.78), rgba(248,251,255,0.68));
  border: 1rpx solid rgba(255,255,255,0.66);
  box-shadow: inset 0 1rpx 4rpx rgba(15,23,42,0.08);
}

.progress-fill,
.audit-flow-progress-fill,
.timeline-selection {
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 54%, #60a5fa 100%);
  box-shadow: 0 0 14rpx rgba(59,130,246,0.20);
}

/* Persistent motion classes own the release curve; hover classes own the held state. */
.ui-motion-button,
.ui-motion-card,
.ui-motion-chip {
  transform: translate3d(0, 0, 0) scale(1);
  transform-origin: center;
  backface-visibility: hidden;
}

.ui-motion-button {
  transition:
    transform 0.22s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.24s ease,
    opacity 0.18s ease,
    filter 0.20s ease;
}

.ui-motion-card {
  transition:
    transform 0.24s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.26s ease,
    opacity 0.20s ease,
    filter 0.20s ease;
}

.ui-motion-chip {
  transition:
    transform 0.22s cubic-bezier(0.16, 0.84, 0.28, 1),
    box-shadow 0.22s ease,
    opacity 0.18s ease,
    color 0.20s ease,
    background 0.20s ease,
    border-color 0.20s ease;
}

.ui-press-button,
.button-pressing,
button:active,
.primary-btn:active,
.secondary-btn:active,
.danger-btn:active,
.approve-btn:active,
.reject-btn:active {
  transform: translate3d(0, 2rpx, 0) scale(0.986);
  opacity: 0.97;
  filter: saturate(1.02) brightness(0.995);
  box-shadow:
    0 6rpx 14rpx rgba(37,99,235,0.11),
    inset 0 3rpx 9rpx rgba(15,23,42,0.07),
    inset 0 1rpx 0 rgba(255,255,255,0.72);
  transition-duration: 0.12s;
}

.ui-press-card,
.control-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.992);
  opacity: 0.975;
  filter: saturate(1.015) brightness(1.003);
  box-shadow:
    0 7rpx 16rpx rgba(37,99,235,0.09),
    inset 0 2rpx 7rpx rgba(15,23,42,0.05),
    inset 0 1rpx 0 rgba(255,255,255,0.76);
  transition-duration: 0.13s;
}

.ui-press-chip,
.link:active,
.action-btn:active,
.audit-link-btn:active,
.flow-action-btn:active,
.step-action-link:active,
.pending-action-link:active,
.tab:active,
.feature-tab:active,
.filter-chip:active,
.chip:active,
.role-pill:active {
  transform: translate3d(0, 1rpx, 0) scale(0.985);
  opacity: 0.92;
  transition-duration: 0.12s;
}

/* 容器壳永不响应子控件按压 */
.card:active,
.section:active,
.edit-box:active,
.list-card:active,
.booking-panel:active,
.filter-section:active,
.sheet-panel:active {
  transform: none;
  opacity: 1;
  filter: none;
}

.card-loading-overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
}

.card-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 5rpx solid rgba(59,130,246,0.16);
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: uiSpin 0.72s linear infinite;
}

.page-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  color: #94a3b8;
  font-size: var(--ui-type-caption);
  line-height: 1.7;
}

.page-footer .footer-name {
  color: #7b8ba3;
  font-size: var(--ui-type-caption);
  letter-spacing: 2rpx;
}

.page-footer .footer-org {
  color: #506380;
  font-size: var(--ui-type-control);
  font-weight: 650;
}

@keyframes glassFadeUp {
  from { opacity: 0; transform: translateY(18rpx) scale(0.994); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes uiSpin {
  to { transform: rotate(360deg); }
}

/* Pad 竖屏 */
@media (min-width: 520px) {
  page {
    /* Pad 竖屏：字号明确高于手机，布局收紧但保留充足触控间距。 */
    --ui-type-micro: 12px;
    --ui-type-caption: 13px;
    --ui-type-meta: 14px;
    --ui-type-label: 14.5px;
    --ui-type-control: 15px;
    --ui-type-body: 16px;
    --ui-type-emphasis: 16.5px;
    --ui-type-value: 17.5px;
    --ui-type-section: 19px;
    --ui-type-page: 29px;
    --ui-dialog-title-size: 17px;
    --ui-dialog-body-size: 14.5px;
    --ui-dialog-meta-size: 13px;
    --ui-dialog-label-size: 13.5px;
    --ui-dialog-control-size: 14px;
    --ui-line-control: 20px;
    --ui-control-height: 44px;
    --ui-control-padding-y: 10px;
    --ui-control-padding-x: 16px;
    --ui-compact-height: 32px;
    --ui-tab-min-height: 40px;
    --ui-tab-sidebar-min-height: 40px;
    --ui-tab-padding-y: 7px;
    --ui-tab-padding-x: 10px;
    --ui-tab-gap: 4px;
    --ui-tab-shell-padding: 4px;
    --ui-tab-radius: 10px;
    --ui-tab-shell-radius: 13px;
    --ui-dialog-edge: 24px;
    --ui-dialog-width-inset: 48px;
    --ui-dialog-padding: 18px;
    --ui-dialog-section-gap: 14px;
    --ui-dialog-footer-gap: 14px;
    --ui-dialog-radius: 18px;
    --ui-page-padding-top: 24px;
    --ui-page-padding-x: 22px;
    --ui-page-padding-bottom: 32px;
    --ui-hero-gap: 18px;
    --ui-hero-padding-top: 24px;
    --ui-hero-padding-x: 26px;
    --ui-hero-padding-bottom: 22px;
    --ui-hero-radius: 20px;
    --ui-card-gap: 18px;
    --ui-card-padding-y: 18px;
    --ui-card-padding-x: 18px;
    --ui-card-radius: 18px;
    --ui-list-gap: 10px;
    --ui-list-padding-y: 12px;
    --ui-list-padding-x: 14px;
    --ui-list-radius: 12px;
    --ui-control-radius: 12px;
    --ui-field-radius: 10px;
    --ui-section-title-inset: 12px;
  }

  .page {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: var(--ui-page-padding-top) var(--ui-page-padding-x) var(--ui-page-padding-bottom);
    font-size: var(--ui-type-body);
    line-height: var(--ui-leading-body);
  }

  .page.page-narrow {
    max-width: 600px;
  }

  .hero,
  .hero-admin {
    padding: var(--ui-hero-padding-top) var(--ui-hero-padding-x) var(--ui-hero-padding-bottom);
    border-radius: var(--ui-hero-radius);

/* Shared Blue Luxury Glass polish for venue subpackage */
page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 30rpx 24rpx 42rpx;
  box-sizing: border-box;
}

.card,
.section,
.edit-box,
.list-card,
.filter-section {
  position: relative;
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.80) 0%, rgba(248,251,255,0.72) 100%);
  border: 1rpx solid rgba(255,255,255,0.62);
  box-shadow: 0 18rpx 36rpx rgba(15,23,42,0.06), inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-sizing: border-box;
}

.section-title,
.list-title,
.filter-label {
  position: relative;
  padding-left: 20rpx;
  margin-bottom: 20rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.section-title::before,
.list-title::before,
.filter-label::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 0 14rpx rgba(59,130,246,0.24);
}

.venue-card,
.booking-item,
.list-item,
.nav-row {
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(249,251,255,0.82));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow: 0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.venue-name,
.booking-title,
.booking-item-title,
.list-name,
.detail-title {
  color: #0f172a;
  line-height: 1.42;
  word-break: break-word;
}

.venue-loc,
.booking-meta,
.booking-item-meta,
.list-desc,
.detail-val,
.field-hint {
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.72;
  white-space: pre-wrap;
  word-break: break-word;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}

.field-input,
.field-textarea,
.picker-display,
.time-val {
  width: 100%;
  min-height: 86rpx;
  padding: 22rpx 22rpx;
  border-radius: 22rpx;
  color: #0f172a;
  font-size: 26rpx;
  line-height: 1.6;
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(246,249,255,0.88));
  border: 1rpx solid rgba(219,229,241,0.96);
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.84);
  box-sizing: border-box;
}

/* Compact picker chips — not full-width inputs */
.time-pick, .picker-sm {
  width: auto;
  min-height: auto;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 1.35;
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(247,250,255,0.82));
  border: 1rpx solid rgba(226,232,240,0.68);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78), 0 6rpx 14rpx rgba(15,23,42,0.03);
  box-sizing: border-box;
}

.field-textarea,
textarea {
  min-height: 156rpx;
  white-space: pre-wrap;
}

.header-nav,
.rules-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.header-nav-btn,
.filter-chip,
.chip,
.venue-tag,
.status-tag,
.booking-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
  border: 1rpx solid rgba(147,197,253,0.64);
  background: rgba(219,234,254,0.76);
  color: #1d4ed8;
}

/* Rules tabs — distinct style: light bg, slate text, no blue border */
.rules-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  border: 1rpx solid rgba(203,213,225,0.48);
  background: rgba(248,250,252,0.88);
  color: #64748b;
  transition: all 0.2s;
}

.filter-chip.active,
.chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 58%, #3b82f6 100%);
  box-shadow: 0 16rpx 30rpx rgba(29,78,216,0.22);
}

.rules-tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 58%, #3b82f6 100%);
  box-shadow: 0 12rpx 24rpx rgba(29,78,216,0.20);
  border-color: transparent;
}

.popup-mask {
  background: rgba(15,23,42,0.34);
  backdrop-filter: blur(6rpx);
}

.popup-card {
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(248,251,255,0.90));
  border: 1rpx solid rgba(255,255,255,0.82);
  box-shadow: 0 22rpx 44rpx rgba(15,23,42,0.14), inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.popup-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.42;
}

.primary-btn,
.secondary-btn,
.danger-btn,
.approve-btn,
.reject-btn {
  border-radius: 24rpx;
  font-weight: 700;
}

.empty-state,
.audit-empty-state,
.empty-inline {
  padding: 34rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(248,251,255,0.60));
  border: 1rpx dashed rgba(147,197,253,0.46);
  color: #64748b;
}

/* ── Shared utility classes (used across venue pages) ── */
.large-scroll { max-height: 820rpx; }

.card-loading-overlay {
  display: flex; align-items: center; justify-content: center;
  padding: 32rpx 0;
}
.card-loading-spinner {
  width: 40rpx; height: 40rpx;
  border: 5rpx solid rgba(37,99,235,0.16);
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: venueSpin 0.7s linear infinite;
}
@keyframes venueSpin { to { transform: rotate(360deg); } }

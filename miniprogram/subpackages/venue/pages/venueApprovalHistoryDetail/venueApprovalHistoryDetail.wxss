@import '../../../main/styles/home.wxss';
@import '../../styles/blue-polish.wxss';

.detail-shell { padding-bottom: 28rpx; }
.detail-loading,
.detail-error { padding: 42rpx 20rpx; color: #64748b; text-align: center; font-size: var(--ui-type-caption); line-height: 1.6; }
.detail-loading { display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.detail-error-title { color: #0f172a; font-size: var(--ui-type-emphasis); font-weight: 800; }
.detail-error-text { margin-top: 8rpx; }
.detail-retry { display: inline-flex; margin-top: 16rpx; padding: 6rpx 16rpx; border-radius: var(--ui-compact-radius, 18rpx); color: #2563eb; background: rgba(219,234,254,0.72); border: 1rpx solid rgba(147,197,253,0.58); font-size: var(--ui-type-caption); font-weight: 700; }

@media (min-width: 900px) and (orientation: landscape) {
  .detail-shell { max-width: 720px; margin-left: auto; margin-right: auto; }
}

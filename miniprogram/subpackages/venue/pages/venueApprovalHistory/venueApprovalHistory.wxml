<view class="page page-narrow subapp-venue-page">
  <workspace-hero class="workspace-hero-host" app-name="{{localeCopy.copy_aa4f0ed6cd}}" page-name="{{localeCopy.copy_9ba3b8c8a9}} · {{localeCopy.copy_8650ae5bf6}}"></workspace-hero>

  <view class="section-host">
    <view class="card">
        <view class="panel-head">
          <view class="panel-title-group">
            <view class="section-title">{{localeCopy.copy_8650ae5bf6}}</view>
            <view class="panel-note">{{localeCopy.copy_0804df041f}}</view>
          </view>
        </view>
      <view class="history-context">{{currentContextText}}</view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="history-scroll ui-dialog-scroll--pane" scroll-y>
        <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
        <block wx:if="{{!loading}}">
          <view class="history-item ui-motion-card" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="viewDetail" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="history-item-head">
              <view class="history-item-title">{{item.title || localeCopy.copy_9639901862}}</view>
              <text class="history-status {{item._statusClass}}">{{item._statusLabel}}</text>
            </view>
            <view class="history-item-meta">{{item.venueName}}<text wx:if="{{item.venueLocation}}"> · {{item.venueLocation}}</text></view>
            <view class="history-item-meta">{{localeCopy.copy_7d935d1225}}{{item.applicantName}}</view>
            <view class="history-assignment-chip" wx:if="{{item._applicantAssignmentText}}">{{localeCopy.applicantAssignment}} · {{item._applicantAssignmentText}}</view>
            <view class="history-item-meta">{{item.timeStartText}} {{localeCopy.copy_e8d9493a44}} {{item.timeEndText}}</view>
            <view class="history-item-entry">{{localeCopy.copy_100eaafa28}} <text class="history-item-arrow">›</text></view>
          </view>
          <view class="audit-empty-state" wx:if="{{!history.length}}">
            <view class="audit-empty-icon">✓</view>
            <view class="audit-empty-text">{{localeCopy.copy_86accadcca}}</view>
            <view class="audit-empty-tip">{{localeCopy.copy_f3a46d24ad}}</view>
          </view>
        </block>
        <view class="scroll-tail-space"></view>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">{{localeCopy.copy_aa4f0ed6cd}}</view>
    <view class="footer-org">{{localeCopy.copy_638da8ae60}}</view>
  </view>
</view>

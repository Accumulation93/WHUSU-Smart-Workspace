@import '../../../../pages/home/home.wxss';
@import '../../styles/blue-polish.wxss';

.history-context {
  margin: -6rpx 0 14rpx;
  color: #64748b;
  font-size: var(--ui-type-caption);
  line-height: 1.55;
}

.history-scroll { max-height: 68vh; }

.history-item {
  margin-bottom: 12rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(249,251,255,0.82));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow: 0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.history-item:last-child { margin-bottom: 4rpx; }
.history-item-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.history-item-title {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: var(--ui-type-emphasis);
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.history-item-meta {
  margin-top: 6rpx;
  color: #64748b;
  font-size: var(--ui-type-meta);
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.history-status {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.4;
}
.history-status.pending { color: #c2410c; background: rgba(255,237,213,0.78); border: 1rpx solid rgba(253,186,116,0.58); }
.history-status.approved,
.history-status.inUse,
.history-status.completed { color: #15803d; background: rgba(209,250,229,0.78); border: 1rpx solid rgba(110,231,183,0.58); }
.history-status.rejected,
.history-status.cancelled { color: #b45309; background: rgba(255,237,213,0.78); border: 1rpx solid rgba(253,186,116,0.58); }
.history-item-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(226,237,247,0.86);
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.5;
}
.history-item-arrow { margin-left: 12rpx; font-size: var(--ui-type-emphasis); line-height: 1; }

@media (min-width: 520px) {
  .history-scroll { max-height: 620px; }
}

@media (min-width: 900px) and (orientation: landscape) {
  .history-item { margin-bottom: 8px; padding: 14px 16px; border-radius: 14px; }
  .history-scroll { max-height: 560px; }
}

page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.redirect-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.redirect-card {
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(246, 250, 255, 0.84));
  box-shadow:
    0 22rpx 52rpx rgba(15, 23, 42, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
  text-align: center;
  box-sizing: border-box;
}

.redirect-spinner {
  width: 54rpx;
  height: 54rpx;
  margin: 0 auto;
  border: 6rpx solid rgba(147, 197, 253, 0.42);
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: redirect-spin 0.85s linear infinite;
}

.redirect-title {
  margin-top: 24rpx;
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-weight: 720;
}

.redirect-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: var(--ui-type-label);
  line-height: 1.6;
}

@keyframes redirect-spin {
  to { transform: rotate(360deg); }
}

@media (min-width: 520px) {
  .redirect-page { padding: 48px; }
  .redirect-card {
    width: min(560px, calc(100vw - 96px));
    max-width: none;
    padding: 42px 36px;
    border-radius: 24px;
  }
  .redirect-spinner {
    width: 40px;
    height: 40px;
    border-width: 4px;
  }
  .redirect-title { margin-top: 20px; font-size: var(--ui-type-page); }
  .redirect-desc { margin-top: 8px; font-size: var(--ui-type-body); }
}

@media (min-width: 900px) {
  .redirect-card { width: min(620px, calc(100vw - 128px)); }
}

@import '../../../../pages/home/home.wxss';
@import '../../styles/blue-polish.wxss';

.page { padding-bottom: 40rpx; }

/* ── Header nav ── */
.header-nav {
  display:flex; align-items:center; justify-content:flex-end; gap:12rpx;
  padding:0 0 16rpx;
}
.header-nav-btn {
  font-size:22rpx; padding:10rpx 20rpx; border-radius:20rpx; font-weight:600;
  background:rgba(255,255,255,0.8); color:#3b82f6; border:1rpx solid rgba(59,130,246,0.3);
  box-shadow:0 4rpx 12rpx rgba(59,130,246,0.08);
}

/* ── Booking item ── */
.booking-item {
  padding:22rpx 24rpx; margin-bottom:14rpx; border-radius:24rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.74);
  animation:glassFadeUp 0.38s ease both;
}
.booking-item:active { transform:translateY(1rpx) scale(0.992); }

.booking-header { display:flex; justify-content:space-between; align-items:flex-start; gap:12rpx; margin-bottom:8rpx; }
.booking-title { flex:1; min-width:0; font-size:27rpx; font-weight:700; color:#0f172a; overflow-wrap:anywhere; }
.booking-meta { font-size:22rpx; color:#64748b; line-height:1.7; }

.booking-status {
  flex-shrink: 0;
  font-size:21rpx; font-weight:700; padding:6rpx 16rpx; border-radius:16rpx; white-space:nowrap;
}
.booking-status.pending { background:#fef3c7; color:#92400e; }
.booking-status.approved { background:#d1fae5; color:#065f46; }
.booking-status.rejected { background:#fee2e2; color:#991b1b; }
.booking-status.cancelled { background:#f1f5f9; color:#94a3b8; }

.cancel-btn {
  display:inline-block; margin-top:10rpx;
  font-size:21rpx; font-weight:600; color:#ef4444;
  padding:8rpx 20rpx; border-radius:16rpx;
  background:rgba(254,226,226,0.6); border:1rpx solid rgba(252,165,165,0.4);
}

/* Scoring-style polish for my venue bookings */
page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 30rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.page::before {
  content: "";
  position: fixed;
  top: -120rpx;
  right: -90rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.18) 0%, rgba(96, 165, 250, 0) 72%);
  pointer-events: none;
}

.hero {
  margin-bottom: 20rpx;
  padding: 40rpx 34rpx 36rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.98) 0%, rgba(59, 130, 246, 0.95) 42%, rgba(96, 165, 250, 0.90) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 24rpx 54rpx rgba(37, 99, 235, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.22;
  letter-spacing: 0;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.62;
}

.header-nav {
  justify-content: flex-end;
  padding: 0 0 18rpx;
}

.header-nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
  background: rgba(219,234,254,0.76);
  border: 1rpx solid rgba(147,197,253,0.64);
  box-shadow:
    0 10rpx 22rpx rgba(37,99,235,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.82) 0%, rgba(248,251,255,0.72) 100%);
  border: 1rpx solid rgba(255,255,255,0.66);
  box-shadow:
    0 18rpx 36rpx rgba(15,23,42,0.06),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.section-title {
  margin: 0 0 20rpx;
  padding-left: 20rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.section-title::before {
  width: 7rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
}

.booking-item {
  padding: 22rpx 20rpx;
  margin-bottom: 14rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(249,251,255,0.82));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow:
    0 12rpx 24rpx rgba(15,23,42,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.booking-title {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.booking-meta {
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.68;
  word-break: break-word;
}

.booking-status {
  min-height: 38rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
  border: 1rpx solid transparent;
}

.booking-status.pending {
  color: #c2410c;
  background: rgba(255,237,213,0.78);
  border-color: rgba(253,186,116,0.58);
}

.booking-status.approved {
  color: #15803d;
  background: rgba(209,250,229,0.78);
  border-color: rgba(110,231,183,0.58);
}

.booking-status.rejected {
  color: #64748b;
  background: rgba(241,245,249,0.88);
  border-color: rgba(203,213,225,0.58);
}

.booking-status.cancelled {
  color: #64748b;
  background: rgba(241,245,249,0.88);
  border-color: rgba(203,213,225,0.58);
}

.cancel-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #dc2626;
  font-size: 22rpx;
  font-weight: 800;
  background: rgba(254,226,226,0.78);
  border: 1rpx solid rgba(252,165,165,0.58);
}

.audit-empty-state {
  padding: 42rpx 24rpx;
  border-radius: 22rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(248,251,255,0.58));
  border: 1rpx dashed rgba(147,197,253,0.52);
}

.audit-empty-text {
  color: #64748b;
  font-size: 24rpx;
}

.inner-scroll.large-scroll {
  max-height: 780rpx;
}

/* Final status polish */
.booking-status {
  box-shadow:
    0 6rpx 14rpx rgba(15,23,42,0.035),
    inset 0 1rpx 0 rgba(255,255,255,0.56);
}

.booking-status.pending {
  background: linear-gradient(135deg, rgba(255,247,237,0.96), rgba(254,215,170,0.84));
}

.booking-status.approved {
  background: linear-gradient(135deg, rgba(220,252,231,0.96), rgba(167,243,208,0.84));
}

.booking-status.rejected,
.booking-status.cancelled {
  background: linear-gradient(135deg, rgba(248,250,252,0.96), rgba(226,232,240,0.84));
}

.cancel-btn {
  background: linear-gradient(135deg, rgba(254,242,242,0.92), rgba(254,226,226,0.78));
  box-shadow:
    0 8rpx 18rpx rgba(239,68,68,0.06),
    inset 0 1rpx 0 rgba(255,255,255,0.68);
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.cancel-btn:active {
  transform: translateY(1rpx) scale(0.985);
  opacity: 0.9;
}

/* Final local motion: booking rows are containers for child actions here. */
.card:active,
.section:active,
.booking-item:active {
  transform: none !important;
  filter: none !important;
}

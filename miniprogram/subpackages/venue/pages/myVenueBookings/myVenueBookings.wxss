@import '../../../main/styles/home.wxss';
@import '../../styles/blue-polish.wxss';

.booking-assignment-chip {
  display: inline-flex;
  max-width: 100%;
  margin-top: 6rpx;
  padding: 5rpx 12rpx;
  border: 1rpx solid rgba(147,197,253,0.58);
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(239,246,255,0.96), rgba(219,234,254,0.82));
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
  box-sizing: border-box;
}

@media (min-width: 520px) {
  .booking-assignment-chip { margin-top: 5px; padding: 4px 9px; border-radius: 12px; }
}

/* ── Header nav ── */
.header-nav {
  display:flex; align-items:center; justify-content:flex-end; gap:var(--ui-inline-gap, 10rpx);
  margin-bottom: var(--ui-card-gap, 24rpx);
}
.header-nav-btn {
  font-size: var(--ui-type-meta); padding:var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx); border-radius: var(--ui-compact-radius, 18rpx); font-weight:600;
  background:rgba(255,255,255,0.8); color:#3b82f6; border:1rpx solid rgba(59,130,246,0.3);
  box-shadow:0 4rpx 12rpx rgba(59,130,246,0.08);
}

/* ── Booking item ── */
.booking-item {
  padding:22rpx 24rpx; margin-bottom:14rpx; border-radius:24rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.74);
  animation:glassFadeUp 0.38s ease both;
}
.booking-item:active { transform:translateY(1rpx) scale(0.992); }

.booking-header { display:flex; justify-content:space-between; align-items:flex-start; gap:12rpx; margin-bottom:8rpx; }
.booking-title { flex:1; min-width:0; font-size: var(--ui-type-value); font-weight:700; color:#0f172a; overflow-wrap:anywhere; }
.booking-meta { font-size: var(--ui-type-meta); color:#64748b; line-height:1.7; }

.booking-actions { display: flex; justify-content: flex-end; gap: var(--ui-inline-gap, 10rpx); margin-top: var(--ui-inline-gap, 10rpx); }

/* WHUSU Smart Workspace style polish for my venue bookings */
page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.page {
  position: relative;
  min-height: 100vh;
  padding: var(--ui-page-padding-top) var(--ui-page-padding-x) calc(var(--ui-page-padding-bottom) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page::before {
  content: "";
  position: fixed;
  top: -120rpx;
  right: -90rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.18) 0%, rgba(96, 165, 250, 0) 72%);
  pointer-events: none;
}

.hero {
  margin-bottom: 20rpx;
  padding: 40rpx 34rpx 36rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.98) 0%, rgba(59, 130, 246, 0.95) 42%, rgba(96, 165, 250, 0.90) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 24rpx 54rpx rgba(37, 99, 235, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.hero-title {
  font-size: var(--ui-type-page);
  font-weight: 800;
  line-height: 1.22;
  letter-spacing: 0;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: var(--ui-type-body);
  line-height: 1.62;
}

.header-nav {
  justify-content: flex-end;
}

.header-nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  border-radius: var(--ui-compact-radius, 18rpx);
  color: #2563eb;
  font-size: var(--ui-type-meta);
  font-weight: 800;
  background: rgba(219,234,254,0.76);
  border: 1rpx solid rgba(147,197,253,0.64);
  box-shadow:
    0 10rpx 22rpx rgba(37,99,235,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.card {
  margin-bottom: var(--ui-card-gap, 24rpx);
  padding: var(--ui-card-padding-y, 28rpx) var(--ui-card-padding-x, 26rpx);
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.82) 0%, rgba(248,251,255,0.72) 100%);
  border: 1rpx solid rgba(255,255,255,0.66);
  box-shadow:
    0 18rpx 36rpx rgba(15,23,42,0.06),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.section-title {
  margin: 0 0 var(--ui-field-gap, 16rpx);
  padding-left: var(--ui-section-title-inset, 20rpx);
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-weight: 800;
  line-height: 1.4;
}

.section-title::before {
  width: 7rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
}

.booking-item {
  padding: var(--ui-list-padding-y, 22rpx) var(--ui-list-padding-x, 20rpx);
  margin-bottom: var(--ui-list-gap, 14rpx);
  border-radius: var(--ui-list-radius, 20rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(249,251,255,0.82));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow:
    0 12rpx 24rpx rgba(15,23,42,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.booking-title {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: var(--ui-type-value);
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.booking-meta {
  color: #64748b;
  font-size: var(--ui-type-label);
  line-height: 1.68;
  word-break: break-word;
}

.audit-empty-state {
  padding: 42rpx 24rpx;
  border-radius: 22rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(248,251,255,0.58));
  border: 1rpx dashed rgba(147,197,253,0.52);
}

.audit-empty-text {
  color: #64748b;
  font-size: var(--ui-type-control);
}

.inner-scroll.large-scroll {
  max-height: 780rpx;
}

/* Final local motion: booking rows are containers for child actions here. */
.card:active,
.section:active,
.booking-item:active {
  transform: none !important;
  filter: none !important;
}

@media (min-width: 520px) {
  .booking-actions { gap: 8px; margin-top: 8px; }
}

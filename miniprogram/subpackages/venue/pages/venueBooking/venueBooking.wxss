@import '../../../../pages/home/home.wxss';
@import '../../styles/blue-polish.wxss';

.page { padding-bottom: 60rpx; }

/* ═══ Venue cards — 参考 mySubmissions 审核列表卡片样式 ═══ */
.venue-card {
  display:flex; align-items:center; gap:18rpx;
  padding:24rpx 22rpx; margin-bottom:12rpx; border-radius:22rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border:1rpx solid rgba(226,237,247,0.94);
  box-shadow:0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing:border-box; transition:transform 0.18s ease, box-shadow 0.22s ease;
  animation:glassFadeUp 0.36s ease both;
}
.venue-card:active { transform:translateY(1rpx) scale(0.992); }

.venue-main { flex:1; min-width:0; display:flex; flex-direction:column; gap:8rpx; }
.venue-name { color:#0f172a; font-size:28rpx; font-weight:700; line-height:1.4; }
.venue-loc { color:#64748b; font-size:23rpx; }

.venue-meta { display:flex; flex-wrap:wrap; align-items:center; gap:10rpx; }
.venue-tag {
  display:inline-flex; align-items:center; justify-content:center;
  min-height:38rpx; padding:6rpx 14rpx; border-radius:999rpx;
  font-size:20rpx; font-weight:700; line-height:1.35;
  border:1rpx solid transparent;
}
.venue-tag.direct {
  color:#15803d; background:rgba(209,250,229,0.78);
  border-color:rgba(110,231,183,0.58);
}
.venue-tag.approval {
  color:#c2410c; background:rgba(255,237,213,0.78);
  border-color:rgba(253,186,116,0.58);
}

.venue-actions { display:flex; flex-direction:row; gap:12rpx; flex-shrink:0; align-items:center; }

/* Action buttons — 参考管理端部门卡片 .link 药丸按钮样式 */
.action-btn {
  display:inline-flex; align-items:center; justify-content:center;
  padding:10rpx 20rpx; border-radius:999rpx; font-size:24rpx; font-weight:600;
  line-height:1; white-space:nowrap;
  background:rgba(219,234,254,0.65); color:#1d4ed8;
  border:1rpx solid rgba(147,197,253,0.45);
  transition:transform 0.12s ease, opacity 0.12s ease;
}
.action-btn:active { transform:scale(0.94); opacity:0.85; }
.action-btn.primary {
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 45%, #60a5fa 100%);
  color:#fff; border-color:transparent;
  box-shadow:0 8rpx 18rpx rgba(37,99,235,0.22);
}

/* ═══ Booking items ═══ */
.booking-item {
  padding:24rpx 22rpx; margin-bottom:14rpx; border-radius:22rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 10rpx 22rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.74);
  animation:glassFadeUp 0.36s ease both;
}
.booking-item-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:10rpx; }
.booking-item-title { font-size:28rpx; font-weight:700; color:#0f172a; }
.booking-item-meta { font-size:24rpx; color:#64748b; line-height:1.7; }
.booking-item-foot { margin-top:12rpx; display:flex; justify-content:flex-end; }

/* Status tag */
.status-tag {
  font-size:22rpx; padding:6rpx 16rpx; border-radius:999rpx; font-weight:600;
}
.status-tag.pending { background:#fef3c7; color:#92400e; }
.status-tag.approved { background:#d1fae5; color:#065f46; }
.status-tag.rejected { background:#fee2e2; color:#991b1b; }
.status-tag.cancelled { background:#f1f5f9; color:#64748b; }
.status-tag.inUse { background:#dbeafe; color:#1e40af; }
.status-tag.completed { background:#e0e7ff; color:#3730a3; }

/* ═══ Empty state ═══ */
.empty-state { text-align:center; padding:40rpx 20rpx; }
.empty-text { color:#94a3b8; font-size:26rpx; line-height:1.7; }

/* ═══ Popup detail ═══ */
.detail-body { padding:8rpx 8rpx 20rpx; }
.detail-title { font-size:30rpx; font-weight:700; color:#0f172a; margin-bottom:20rpx; }
.detail-row { display:flex; align-items:center; font-size:26rpx; color:#334155; line-height:2.2; }
.detail-key { width:120rpx; color:#94a3b8; flex-shrink:0; }
.detail-val { color:#1e293b; }

/* ═══ Form ═══ */
.form-body { padding:4rpx 8rpx 20rpx; }

/* ═══ Chips ═══ */
.chip-row { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:10rpx; }
.chip {
  font-size:24rpx; padding:10rpx 22rpx; border-radius:20rpx; font-weight:500;
  background:rgba(241,245,249,0.85); color:#475569;
  border:1rpx solid rgba(203,213,225,0.55);
}
.chip.active {
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color:#fff; border-color:transparent;
  box-shadow:0 6rpx 16rpx rgba(37,99,235,0.20);
}

/* ═══ Date picker display ═══ */
.picker-display {
  width:100%; padding:24rpx 20rpx; border-radius:18rpx;
  background:rgba(255,255,255,0.72); border:1rpx solid rgba(203,213,225,0.75);
  font-size:28rpx; color:#1e293b; box-sizing:border-box;
}
/* 已选择日期 → 蓝色强调 */
.picker-has-value {
  color:#2563eb; font-weight:700;
  border-color:rgba(37,99,235,0.32);
  background:rgba(239,246,255,0.72);
}

/* ═══ ★ Time slot grid (modern card-based) ★ ═══ */
.time-section { display:flex; flex-direction:column; gap:10rpx; }

/* Selected time result row */
.time-result-row {
  display:flex; align-items:center; gap:10rpx;
  padding:14rpx 20rpx; border-radius:18rpx;
  background:linear-gradient(135deg, rgba(37,99,235,0.08) 0%, rgba(59,130,246,0.05) 100%);
  border:1rpx solid rgba(37,99,235,0.18);
}
.time-result-icon { font-size:22rpx; color:#2563eb; }
.time-result-val { font-size:30rpx; font-weight:800; color:#2563eb; }
.time-result-suffix { font-size:22rpx; color:#64748b; margin-left:auto; }

/* End time context */
.end-context {
  display:flex; align-items:center; gap:8rpx;
  padding:8rpx 16rpx; font-size:22rpx;
}
.end-context-label { color:#94a3b8; }
.end-context-time { color:#2563eb; font-weight:700; }
.end-context-arrow { color:#94a3b8; margin:0 4rpx; }

.end-result .time-result-icon { color:#059669; }
.end-result .time-result-val { color:#059669; }
.end-result { border-color:rgba(5,150,105,0.22); background:linear-gradient(135deg, rgba(5,150,105,0.06) 0%, rgba(16,185,129,0.04) 100%); }

/* Scrollable grid container */
.time-grid-scroll { max-height:420rpx; }

/* Grid row: 4 cards per row */
.time-grid-row {
  display:flex; gap:10rpx; margin-bottom:10rpx;
}

/* Individual time slot card */
.time-slot-card {
  flex:1; min-width:0;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding:14rpx 6rpx; border-radius:16rpx;
  border:2rpx solid transparent;
  transition:all 0.15s ease;
  box-sizing:border-box;
}
.time-slot-card:active { transform:scale(0.94); }

.slot-time { font-size:26rpx; font-weight:800; line-height:1.3; }
.slot-label { font-size:18rpx; font-weight:600; line-height:1.3; margin-top:2rpx; }

/* Status color variants */
.slot-free {
  background:rgba(209,250,229,0.55);
  border-color:rgba(110,231,183,0.45);
}
.slot-free .slot-time { color:#065f46; }
.slot-free .slot-label { color:#059669; }

.slot-pending {
  background:rgba(254,243,199,0.60);
  border-color:rgba(252,211,77,0.50);
}
.slot-pending .slot-time { color:#92400e; }
.slot-pending .slot-label { color:#b45309; }

.slot-booked {
  background:rgba(254,226,226,0.50);
  border-color:rgba(252,165,165,0.40);
}
.slot-booked .slot-time { color:#991b1b; }
.slot-booked .slot-label { color:#b91c1c; }

.slot-activity {
  background:rgba(237,233,254,0.50);
  border-color:rgba(196,181,253,0.45);
}
.slot-activity .slot-time { color:#5b21b6; }
.slot-activity .slot-label { color:#7c3aed; }

/* Selected card */
.slot-active {
  transform:scale(1.02);
  box-shadow:0 4rpx 16rpx rgba(37,99,235,0.22);
}
.slot-active.slot-free {
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  border-color:#2563eb;
}
.slot-active.slot-free .slot-time,
.slot-active.slot-free .slot-label { color:#fff; }

.slot-active.slot-pending {
  background:linear-gradient(135deg, #d97706 0%, #f59e0b 100%);
  border-color:#d97706;
}
.slot-active.slot-pending .slot-time,
.slot-active.slot-pending .slot-label { color:#fff; }

/* Disabled / unselectable cards */
.slot-disabled { opacity:0.40; }
.slot-disabled:active { transform:none; }

/* Keyboard input row */
.time-input-row { display:flex; align-items:center; gap:12rpx; padding-top:4rpx; }
.time-input-hint { font-size:20rpx; color:#94a3b8; white-space:nowrap; flex-shrink:0; padding:4rpx 12rpx; background:rgba(241,245,249,0.55); border-radius:8rpx; }
.time-input {
  flex:1; height:60rpx; padding:0 18rpx; border-radius:14rpx; font-size:24rpx; font-weight:600; color:#1e293b;
  background:rgba(255,255,255,0.85); border:1rpx solid rgba(203,213,225,0.65);
  box-sizing:border-box;
}

/* ── 无可用时段提示 ── */
.field-hint { font-size:24rpx; color:#94a3b8; padding:18rpx 20rpx; }

/* ═══ Schedule / Timetable ═══ */
.schedule-nav { display:flex; align-items:center; justify-content:center; gap:28rpx; padding:8rpx 16rpx 16rpx; }
.nav-arrow {
  font-size:38rpx; padding:6rpx 22rpx; border-radius:16rpx; font-weight:300; color:#2563eb;
  background:rgba(255,255,255,0.85); border:1rpx solid rgba(59,130,246,0.20);
}
.nav-label { font-size:26rpx; font-weight:700; color:#1e293b; }

.timetable-popup { max-height:95vh; width:96vw; }
.timetable-scroll { width:100%; height:1100rpx; }
.timetable-body { display:flex; }

.tt-time-col { width:64rpx; min-width:64rpx; flex-shrink:0; }
.tt-time-header {
  height:58rpx; display:flex; align-items:center; justify-content:center;
  font-size:20rpx; font-weight:700; color:#475569; background:#f1f5f9;
  border-bottom:1rpx solid rgba(226,232,240,0.6); box-sizing:border-box;
}
.tt-time-label {
  height:64rpx; display:flex; align-items:center; justify-content:center;
  font-size:19rpx; color:#64748b; border-bottom:1rpx solid rgba(226,232,240,0.3);
  background:#f8fafc; box-sizing:border-box;
}

.tt-col-scroll { flex:1; overflow-x:visible; }
.tt-cols-row { display:flex; }
.tt-col { flex:1; min-width:0; position:relative; }
.tt-col-header {
  height:58rpx; display:flex; flex-direction:column; align-items:center; justify-content:center;
  font-size:22rpx; font-weight:600; color:#475569; background:#f1f5f9;
  border-right:1rpx solid rgba(226,232,240,0.4); border-bottom:1rpx solid rgba(226,232,240,0.6);
  position:sticky; top:0; z-index:1; padding:2rpx 0; box-sizing:border-box;
}
.tt-col-sub { font-size:18rpx; font-weight:400; color:#64748b; display:block; }

.tt-open-block {
  position:absolute; left:2rpx; right:2rpx; background:rgba(219,234,254,0.38);
  border-radius:6rpx; border:1rpx dashed rgba(147,197,253,0.40);
}
.tt-time-target { position:absolute; left:0; right:0; z-index:1; opacity:0; }

.tt-event-block {
  position:absolute; left:3rpx; right:3rpx; display:flex; align-items:center; justify-content:center;
  border-radius:7rpx; overflow:hidden; z-index:2;
}
.tt-event-block.booked { background:rgba(254,243,199,0.78); border:1rpx solid rgba(252,211,77,0.50); }
.tt-event-block.pending { background:rgba(254,215,170,0.72); border:1rpx solid rgba(253,186,116,0.45); }
.tt-event-block.activity { background:rgba(252,231,243,0.65); border:1rpx solid rgba(249,168,212,0.45); }
.tt-event-label {
  font-size:18rpx; color:#475569; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  max-width:90rpx; text-align:center; line-height:1.1;
}

/* Legend */
.tt-legend { display:flex; gap:16rpx; padding:12rpx 18rpx; font-size:20rpx; color:#64748b; flex-wrap:wrap; }
.tt-leg-item { display:flex; align-items:center; gap:6rpx; }
.tt-dot { width:22rpx; height:22rpx; border-radius:6rpx; flex-shrink:0; }
.tt-dot.open { background:#bfdbfe; border:1rpx solid #93c5fd; }
.tt-dot.booked { background:#fef3c7; border:1rpx solid #fcd34d; }
.tt-dot.pending { background:#fed7aa; border:1rpx solid #fdba74; }
.tt-dot.activity { background:#fce7f3; border:1rpx solid #f9a8d4; }
.tt-dot.closed { background:#e2e8f0; border:1rpx solid #cbd5e1; }

/* ═══ Timeline ═══ */
.timeline-wrap { margin:6rpx 0 12rpx; }
.timeline-bar { position:relative; height:48rpx; background:#f1f5f9; border-radius:12rpx; overflow:hidden; }
.timeline-block { position:absolute; top:0; height:100%; min-width:3rpx; }
.timeline-block.tl-free { background:linear-gradient(180deg, #86efac 0%, #4ade80 100%); }
.timeline-block.tl-booked { background:linear-gradient(180deg, #fca5a5 0%, #f87171 100%); }
.timeline-block.tl-pending { background:linear-gradient(180deg, #fde68a 0%, #fbbf24 100%); }
.timeline-block.tl-activity { background:linear-gradient(180deg, #e9d5ff 0%, #c084fc 100%); }
.timeline-block.tl-closed { background:#e2e8f0; }
.timeline-ticks { display:flex; justify-content:space-between; font-size:20rpx; color:#94a3b8; margin-top:4rpx; }

/* ═══ Misc ═══ */
.required { color:#ef4444; }

/* ═══ Inner scroll ═══ */
.inner-scroll { max-height:700rpx; }

/* ═══ Pending approvals entry (prominent bar) ═══ */
.pending-entry-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 22rpx; margin-bottom: 16rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(239,246,255,0.90) 0%, rgba(219,234,254,0.78) 100%);
  border: 1rpx solid rgba(147,197,253,0.52);
  box-shadow: 0 8rpx 20rpx rgba(37,99,235,0.07), inset 0 1rpx 0 rgba(255,255,255,0.78);
  transition: transform 0.14s ease, box-shadow 0.18s ease;
}
.pending-entry-bar:active { transform: translateY(1rpx) scale(0.988); box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.04); }
.pending-entry-left { display: flex; align-items: center; gap: 10rpx; }
.pending-entry-icon { font-size: 28rpx; }
.pending-entry-label { font-size: 26rpx; font-weight: 700; color: #1e3a5f; }
.pending-entry-badge {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 36rpx; height: 36rpx; padding: 0 8rpx; border-radius: 999rpx;
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #fff; font-size: 20rpx; font-weight: 700;
  box-shadow: 0 4rpx 10rpx rgba(239,68,68,0.18);
}
.pending-entry-arrow { font-size: 32rpx; font-weight: 600; color: #2563eb; }

/* ═══ Flow info (audit-style timeline in booking cards) ═══ */
.flow-info-title { font-size: 22rpx; font-weight: 700; color: #0f172a; line-height: 1.4; }
.flow-info-desc { font-size: 20rpx; color: #64748b; margin-top: 4rpx; }

/* Scoring-style polish for user venue borrowing */
page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 30rpx 24rpx 54rpx;
  box-sizing: border-box;
}

.page::before {
  content: "";
  position: fixed;
  top: -120rpx;
  right: -90rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.18) 0%, rgba(96, 165, 250, 0) 72%);
  pointer-events: none;
}

.page::after {
  content: "";
  position: fixed;
  left: -120rpx;
  bottom: 150rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(147, 197, 253, 0.16) 0%, rgba(147, 197, 253, 0) 72%);
  pointer-events: none;
}

.hero {
  margin-bottom: 22rpx;
  padding: 40rpx 34rpx 36rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.98) 0%, rgba(59, 130, 246, 0.95) 42%, rgba(96, 165, 250, 0.90) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 24rpx 54rpx rgba(37, 99, 235, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.22;
  letter-spacing: 0;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.62;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.82) 0%, rgba(248,251,255,0.72) 100%);
  border: 1rpx solid rgba(255,255,255,0.66);
  box-shadow:
    0 18rpx 36rpx rgba(15,23,42,0.06),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  animation: glassFadeUp 0.42s ease both;
}

.section-title {
  margin: 0 0 20rpx;
  padding-left: 20rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.section-title::before {
  width: 7rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
}

.venue-card,
.booking-item,
.approval-progress-bar {
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(249,251,255,0.82));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow:
    0 12rpx 24rpx rgba(15,23,42,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.venue-card {
  gap: 18rpx;
  padding: 24rpx 22rpx;
  border-radius: 22rpx;
}

.venue-name,
.booking-item-title {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.venue-loc,
.booking-item-meta {
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.68;
}

.venue-tag,
.status-tag {
  min-height: 38rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
  border: 1rpx solid transparent;
}

.venue-tag.direct,
.status-tag.approved {
  color: #15803d;
  background: rgba(209,250,229,0.78);
  border-color: rgba(110,231,183,0.58);
}

.venue-tag.approval,
.status-tag.pending {
  color: #c2410c;
  background: rgba(255,237,213,0.78);
  border-color: rgba(253,186,116,0.58);
}

.status-tag.inUse,
.status-tag.completed {
  color: #0369a1;
  background: rgba(224,242,254,0.76);
  border-color: rgba(56,189,248,0.56);
}

.status-tag.rejected,
.status-tag.cancelled {
  color: #64748b;
  background: rgba(241,245,249,0.88);
  border-color: rgba(203,213,225,0.58);
}

.venue-actions {
  gap: 12rpx;
  flex-direction: row;
}

.action-btn,
.link {
  min-height: auto;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  background: rgba(219,234,254,0.65);
  border: 1rpx solid rgba(147,197,253,0.45);
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.action-btn:active { transform: scale(0.94); opacity: 0.85; }

.action-btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 45%, #60a5fa 100%);
  box-shadow: 0 8rpx 18rpx rgba(37,99,235,0.22);
  border-color: transparent;
}

.link.danger {
  color: #dc2626;
  background: rgba(254,226,226,0.78);
  border-color: rgba(252,165,165,0.58);
}

.field-label {
  margin-bottom: 10rpx;
  color: #52647c;
  font-size: 23rpx;
  font-weight: 700;
}

.field-input,
.field-textarea,
.picker-display {
  min-height: 78rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  color: #10233d;
  font-size: 25rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(246,249,255,0.88));
  border: 1rpx solid rgba(219,229,241,0.96);
  box-shadow:
    0 8rpx 18rpx rgba(15,23,42,0.035),
    inset 0 1rpx 0 rgba(255,255,255,0.84);
}

/* ── textarea：独立 min-height + 行高，修复文字偏上 ── */
.field-textarea {
  min-height: 156rpx;
  line-height: 1.6;
}

/* ── picker-display：flex 居中，修复文字偏位 ── */
.picker-display {
  display: flex;
  align-items: center;
}


.chip {
  border-radius: 999rpx;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 800;
  background: rgba(219,234,254,0.76);
  border: 1rpx solid rgba(147,197,253,0.64);
}

.chip.active {
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 58%, #3b82f6 100%);
  box-shadow: 0 12rpx 22rpx rgba(29,78,216,0.16);
}

.primary-btn {
  min-height: 78rpx;
  line-height: 78rpx;
  border-radius: 22rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 58%, #3b82f6 100%);
  box-shadow:
    0 16rpx 32rpx rgba(29,78,216,0.20),
    inset 0 1rpx 0 rgba(255,255,255,0.20);
}

.primary-btn::after {
  border: none;
}

.empty-state {
  padding: 42rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(248,251,255,0.58));
  border: 1rpx dashed rgba(147,197,253,0.52);
}

.empty-text {
  color: #64748b;
  font-size: 24rpx;
}

.popup-card {
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(248,251,255,0.88));
  border: 1rpx solid rgba(255,255,255,0.82);
  box-shadow: 0 24rpx 52rpx rgba(15,23,42,0.16);
}

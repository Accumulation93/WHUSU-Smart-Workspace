@import '../../../../pages/home/home.wxss';

.page { padding-bottom: 60rpx; }

/* ═══ Tab bar ═══ */
.venue-tab-bar { display:flex; gap:20rpx; margin-bottom:28rpx; }
.venue-tab {
  flex:1; text-align:center; padding:24rpx 20rpx; border-radius:24rpx;
  font-size:28rpx; font-weight:700; color:#53708e;
  background:linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(246,249,255,0.82) 100%);
  border:1rpx solid rgba(219,229,241,0.92);
  box-shadow:0 10rpx 22rpx rgba(15,23,42,0.04);
  transition:all 0.2s;
}
.venue-tab.active {
  color:#fff;
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 44%, #60a5fa 100%);
  border-color:transparent;
  box-shadow:0 18rpx 34rpx rgba(37,99,235,0.20);
}
.venue-tab:active { transform:scale(0.96); }

/* ═══ Venue cards ═══ */
.venue-card {
  display:flex; align-items:center; gap:24rpx;
  padding:28rpx 24rpx; margin-bottom:16rpx; border-radius:24rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 12rpx 28rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.74);
  animation:glassFadeUp 0.38s ease both;
}
.venue-card:active { transform:translateY(1rpx) scale(0.992); }

.venue-avatar {
  width:80rpx; height:80rpx; border-radius:22rpx; flex-shrink:0;
  background:linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  display:flex; align-items:center; justify-content:center;
  color:#fff; font-size:34rpx; font-weight:700;
  box-shadow:0 10rpx 22rpx rgba(37,99,235,0.25);
}

.venue-main { flex:1; min-width:0; }
.venue-name { color:#0f172a; font-size:30rpx; font-weight:700; line-height:1.4; }
.venue-loc { color:#64748b; font-size:24rpx; margin-top:4rpx; }
.venue-tag {
  display:inline-block; font-size:22rpx; padding:6rpx 14rpx; border-radius:14rpx;
  font-weight:600; margin-top:8rpx;
}
.venue-tag.direct { background:#d1fae5; color:#065f46; }
.venue-tag.approval { background:#fef3c7; color:#92400e; }

.venue-actions { display:flex; flex-direction:column; gap:10rpx; flex-shrink:0; }

/* Action buttons */
.action-btn {
  display:inline-flex; align-items:center; justify-content:center;
  padding:14rpx 28rpx; border-radius:999rpx; font-size:26rpx; font-weight:600;
  background:rgba(241,245,249,0.85); color:#475569;
  border:1rpx solid rgba(203,213,225,0.55);
  transition:transform 0.12s ease, opacity 0.12s ease;
}
.action-btn:active { transform:scale(0.94); opacity:0.85; }
.action-btn.primary {
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color:#fff; border-color:transparent;
  box-shadow:0 6rpx 16rpx rgba(37,99,235,0.18);
}

/* ═══ Booking items ═══ */
.booking-item {
  padding:24rpx 22rpx; margin-bottom:14rpx; border-radius:22rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 10rpx 22rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.74);
}
.booking-item-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:10rpx; }
.booking-item-title { font-size:28rpx; font-weight:700; color:#0f172a; }
.booking-item-meta { font-size:24rpx; color:#64748b; line-height:1.7; }
.booking-item-foot { margin-top:12rpx; display:flex; justify-content:flex-end; }

/* Status tag */
.status-tag {
  font-size:22rpx; padding:6rpx 16rpx; border-radius:999rpx; font-weight:600;
}
.status-tag.pending { background:#fef3c7; color:#92400e; }
.status-tag.approved { background:#d1fae5; color:#065f46; }
.status-tag.rejected { background:#fee2e2; color:#991b1b; }
.status-tag.cancelled { background:#f1f5f9; color:#64748b; }

/* ═══ Empty state ═══ */
.empty-state { text-align:center; padding:40rpx 20rpx; }
.empty-text { color:#94a3b8; font-size:26rpx; line-height:1.7; }

/* ═══ Popup detail ═══ */
.detail-body { padding:8rpx 8rpx 20rpx; }
.detail-title { font-size:30rpx; font-weight:700; color:#0f172a; margin-bottom:20rpx; }
.detail-row { display:flex; align-items:center; font-size:26rpx; color:#334155; line-height:2.2; }
.detail-key { width:120rpx; color:#94a3b8; flex-shrink:0; }
.detail-val { color:#1e293b; }

/* ═══ Form ═══ */
.form-body { padding:4rpx 8rpx 20rpx; }

/* ═══ Chips ═══ */
.chip-row { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:10rpx; }
.chip {
  font-size:24rpx; padding:10rpx 22rpx; border-radius:20rpx; font-weight:500;
  background:rgba(241,245,249,0.85); color:#475569;
  border:1rpx solid rgba(203,213,225,0.55);
}
.chip.active {
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color:#fff; border-color:transparent;
  box-shadow:0 6rpx 16rpx rgba(37,99,235,0.20);
}

/* ═══ Date picker display ═══ */
.picker-display {
  width:100%; padding:24rpx 20rpx; border-radius:18rpx;
  background:rgba(255,255,255,0.72); border:1rpx solid rgba(203,213,225,0.75);
  font-size:28rpx; color:#1e293b; box-sizing:border-box;
}

/* ═══ Time picker ═══ */
.time-picker-row { display:flex; gap:12rpx; align-items:center; }
.time-val {
  min-width:100rpx; height:68rpx; line-height:68rpx; text-align:center;
  font-size:30rpx; font-weight:700; color:#1e293b;
  background:linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(247,250,255,0.84) 100%);
  border-radius:16rpx; border:1rpx solid rgba(203,213,225,0.68); padding:0 14rpx;
}
.time-sep { font-size:30rpx; color:#64748b; font-weight:500; }
.time-result { font-size:28rpx; color:#2563eb; font-weight:700; min-width:100rpx; }

/* ═══ Schedule / Timetable ═══ */
.schedule-nav { display:flex; align-items:center; justify-content:center; gap:28rpx; padding:8rpx 16rpx 16rpx; }
.nav-arrow {
  font-size:38rpx; padding:6rpx 22rpx; border-radius:16rpx; font-weight:300; color:#2563eb;
  background:rgba(255,255,255,0.85); border:1rpx solid rgba(59,130,246,0.20);
}
.nav-label { font-size:26rpx; font-weight:700; color:#1e293b; }

.timetable-popup { max-height:95vh; width:96vw; }
.timetable-scroll { width:100%; height:1100rpx; }
.timetable-body { display:flex; }

.tt-time-col { width:64rpx; min-width:64rpx; flex-shrink:0; }
.tt-time-header {
  height:58rpx; display:flex; align-items:center; justify-content:center;
  font-size:20rpx; font-weight:700; color:#475569; background:#f1f5f9;
  border-bottom:1rpx solid rgba(226,232,240,0.6); box-sizing:border-box;
}
.tt-time-label {
  height:64rpx; display:flex; align-items:center; justify-content:center;
  font-size:19rpx; color:#64748b; border-bottom:1rpx solid rgba(226,232,240,0.3);
  background:#f8fafc; box-sizing:border-box;
}

.tt-col-scroll { flex:1; overflow-x:visible; }
.tt-cols-row { display:flex; }
.tt-col { flex:1; min-width:0; position:relative; }
.tt-col-header {
  height:58rpx; display:flex; flex-direction:column; align-items:center; justify-content:center;
  font-size:22rpx; font-weight:600; color:#475569; background:#f1f5f9;
  border-right:1rpx solid rgba(226,232,240,0.4); border-bottom:1rpx solid rgba(226,232,240,0.6);
  position:sticky; top:0; z-index:1; padding:2rpx 0; box-sizing:border-box;
}
.tt-col-sub { font-size:18rpx; font-weight:400; color:#64748b; display:block; }

.tt-open-block {
  position:absolute; left:2rpx; right:2rpx; background:rgba(219,234,254,0.38);
  border-radius:6rpx; border:1rpx dashed rgba(147,197,253,0.40);
}
.tt-time-target { position:absolute; left:0; right:0; z-index:1; opacity:0; }

.tt-event-block {
  position:absolute; left:3rpx; right:3rpx; display:flex; align-items:center; justify-content:center;
  border-radius:7rpx; overflow:hidden; z-index:2;
}
.tt-event-block.booked { background:rgba(254,243,199,0.78); border:1rpx solid rgba(252,211,77,0.50); }
.tt-event-block.pending { background:rgba(254,215,170,0.72); border:1rpx solid rgba(253,186,116,0.45); }
.tt-event-block.activity { background:rgba(252,231,243,0.65); border:1rpx solid rgba(249,168,212,0.45); }
.tt-event-label {
  font-size:18rpx; color:#475569; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  max-width:90rpx; text-align:center; line-height:1.1;
}

/* Legend */
.tt-legend { display:flex; gap:16rpx; padding:12rpx 18rpx; font-size:20rpx; color:#64748b; flex-wrap:wrap; }
.tt-leg-item { display:flex; align-items:center; gap:6rpx; }
.tt-dot { width:22rpx; height:22rpx; border-radius:6rpx; flex-shrink:0; }
.tt-dot.open { background:#93c5fd; border:1rpx solid #60a5fa; }
.tt-dot.booked { background:#fde68a; border:1rpx solid #fcd34d; }
.tt-dot.pending { background:#fdba74; border:1rpx solid #fb923c; }
.tt-dot.activity { background:#f9a8d4; border:1rpx solid #f472b6; }
.tt-dot.closed { background:#e2e8f0; border:1rpx solid #cbd5e1; }

/* ═══ Timeline ═══ */
.timeline-wrap { margin:6rpx 0 12rpx; }
.timeline-bar { position:relative; height:48rpx; background:#f1f5f9; border-radius:12rpx; overflow:hidden; }
.timeline-block { position:absolute; top:0; height:100%; min-width:3rpx; }
.timeline-block.tl-free { background:linear-gradient(180deg, #86efac 0%, #4ade80 100%); }
.timeline-block.tl-booked { background:linear-gradient(180deg, #fca5a5 0%, #f87171 100%); }
.timeline-block.tl-pending { background:linear-gradient(180deg, #fde68a 0%, #fbbf24 100%); }
.timeline-block.tl-activity { background:linear-gradient(180deg, #e9d5ff 0%, #c084fc 100%); }
.timeline-block.tl-closed { background:#e2e8f0; }
.timeline-ticks { display:flex; justify-content:space-between; font-size:20rpx; color:#94a3b8; margin-top:4rpx; }

/* ═══ Misc ═══ */
.required { color:#ef4444; }

/* ═══ Inner scroll ═══ */
.inner-scroll { max-height:700rpx; }

@import '../../../../pages/home/home.wxss';

.page { padding-bottom: 40rpx; }

/* ── Header nav ── */
.header-nav {
  display:flex; align-items:center; justify-content:flex-end; gap:12rpx;
  padding:0 0 16rpx;
}
.header-nav-btn {
  font-size:22rpx; padding:10rpx 20rpx; border-radius:20rpx; font-weight:600;
  background:rgba(255,255,255,0.8); color:#3b82f6; border:1rpx solid rgba(59,130,246,0.3);
  box-shadow:0 4rpx 12rpx rgba(59,130,246,0.08);
}

/* ── Venue card ── */
.venue-card {
  display:flex; align-items:center; gap:20rpx;
  padding:24rpx 22rpx; margin-bottom:14rpx; border-radius:24rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.74);
  animation:glassFadeUp 0.38s ease both;
}
.venue-card:active { transform:translateY(1rpx) scale(0.992); }

.venue-card-avatar {
  width:76rpx; height:76rpx; border-radius:22rpx;
  background:linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%);
  display:flex; align-items:center; justify-content:center;
  color:#fff; font-size:34rpx; flex-shrink:0;
  box-shadow:0 8rpx 18rpx rgba(139,92,246,0.22);
}

.venue-card-main { flex:1; min-width:0; }
.venue-card-name { color:#0f172a; font-size:28rpx; font-weight:700; line-height:1.4; }
.venue-card-loc { color:#64748b; font-size:21rpx; margin-top:4rpx; }

.venue-card-tag {
  display:inline-block; font-size:19rpx; padding:4rpx 12rpx; border-radius:14rpx; font-weight:600; margin-top:6rpx;
}
.venue-card-tag.direct { background:#d1fae5; color:#065f46; }
.venue-card-tag.approval { background:#fef3c7; color:#92400e; }

.venue-card-actions { display:flex; flex-direction:column; gap:8rpx; flex-shrink:0; }
.venue-card-action {
  font-size:21rpx; padding:10rpx 20rpx; border-radius:18rpx; text-align:center; font-weight:600;
}
.venue-card-action.view { background:#dbeafe; color:#1d4ed8; border:1rpx solid #bfdbfe; }
.venue-card-action.book { background:linear-gradient(135deg, #10b981 0%, #34d399 100%); color:#fff; box-shadow:0 6rpx 14rpx rgba(16,185,129,0.18); }

/* ── Schedule ── */
.schedule-nav {
  display:flex; align-items:center; justify-content:center; gap:16rpx; margin-bottom:16rpx;
}
.schedule-nav-btn {
  font-size:22rpx; padding:10rpx 20rpx; border-radius:18rpx; font-weight:600;
  background:rgba(255,255,255,0.8); color:#3b82f6; border:1rpx solid rgba(59,130,246,0.3);
}
.schedule-day {
  padding:14rpx 0; border-bottom:1rpx solid rgba(226,232,240,0.5); margin-bottom:8rpx;
}
.schedule-day-title {
  font-size:24rpx; font-weight:700; color:#1e293b; margin-bottom:6rpx;
}
.slot-tag {
  display:inline-block; font-size:19rpx; padding:4rpx 12rpx; border-radius:12rpx; margin:2rpx 6rpx 2rpx 0; font-weight:500;
}
.slot-tag.open { background:#dbeafe; color:#1d4ed8; }
.slot-tag.activity { background:#fce7f3; color:#9d174d; }
.slot-tag.booked { background:#fef3c7; color:#92400e; }

/* ── Booking form ── */
.booking-form { padding:4rpx 0; }

@import '../../../../pages/home/home.wxss';

.page { padding-bottom: 40rpx; }

/* ═══ Tab bar (scoring-style: rounded rectangle) ═══ */
.venue-tab-bar { display:flex; gap:16rpx; margin-bottom:24rpx; }
.venue-tab { flex:1; text-align:center; padding:20rpx 16rpx; border-radius:24rpx; font-size:26rpx; font-weight:700;
  color:#53708e;
  background:linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(246,249,255,0.82) 100%);
  border:1rpx solid rgba(219,229,241,0.92);
  box-shadow:0 10rpx 22rpx rgba(15,23,42,0.04);
  transition:all 0.2s; }
.venue-tab.active { color:#ffffff;
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 44%, #60a5fa 100%);
  border-color:transparent;
  box-shadow:0 18rpx 34rpx rgba(37,99,235,0.18); }
.venue-tab:active { transform:scale(0.96); }

/* ═══ Venue cards ═══ */
.venue-card { display:flex; align-items:center; gap:20rpx; padding:24rpx 22rpx; margin-bottom:14rpx; border-radius:24rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.74);
  animation:glassFadeUp 0.38s ease both; }
.venue-card:active { transform:translateY(1rpx) scale(0.992); }
.venue-card-avatar { width:68rpx; height:68rpx; border-radius:20rpx;
  background:linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
  display:flex; align-items:center; justify-content:center; color:#fff; font-size:30rpx; flex-shrink:0;
  box-shadow:0 8rpx 18rpx rgba(59,130,246,0.22); }
.venue-card-main { flex:1; min-width:0; }
.venue-card-name { color:#0f172a; font-size:28rpx; font-weight:700; line-height:1.4; }
.venue-card-loc { color:#64748b; font-size:21rpx; margin-top:4rpx; }
.venue-card-tag { display:inline-block; font-size:19rpx; padding:4rpx 12rpx; border-radius:14rpx; font-weight:600; margin-top:6rpx; }
.venue-card-tag.direct { background:#d1fae5; color:#065f46; }
.venue-card-tag.approval { background:#fef3c7; color:#92400e; }
.venue-card-actions { display:flex; flex-direction:column; gap:8rpx; flex-shrink:0; }

/* ═══ Link buttons (matching scoring sub-app .link pattern) ═══ */
.link { display:inline-flex; align-items:center; justify-content:center; padding:10rpx 20rpx;
  border-radius:999rpx; font-size:24rpx; font-weight:600; line-height:1;
  background:rgba(219,234,254,0.65); color:#1d4ed8; border:1rpx solid rgba(147,197,253,0.45);
  transition:transform 0.12s ease, opacity 0.12s ease; }
.link:active { transform:scale(0.94); opacity:0.85; }
.link.danger { background:rgba(254,226,226,0.65); color:#dc2626; border-color:rgba(252,165,165,0.45); }
.link.green { background:rgba(209,250,229,0.65); color:#065f46; border-color:rgba(110,231,183,0.5); }

/* Small link variant */
.link-sm { font-size:22rpx; padding:8rpx 16rpx; }

/* ═══ Manage venue list ═══ */
.venue-list-item { display:flex; align-items:center; gap:20rpx; padding:22rpx 20rpx; margin-bottom:12rpx; border-radius:22rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 10rpx 22rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.74); }
.venue-list-avatar { width:56rpx; height:56rpx; border-radius:18rpx;
  background:linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
  display:flex; align-items:center; justify-content:center; color:#fff; font-size:26rpx; flex-shrink:0; }
.venue-list-main { flex:1; min-width:0; }
.venue-list-name { color:#0f172a; font-size:26rpx; font-weight:700; }
.venue-list-loc { color:#64748b; font-size:20rpx; margin-top:2rpx; }
.venue-list-actions { display:flex; gap:6rpx; flex-shrink:0; flex-wrap:wrap; }

/* ═══ Edit box ═══ */
.edit-box { padding:24rpx; margin-bottom:16rpx; border-radius:26rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.72) 0%, rgba(247,250,255,0.62) 100%);
  border:1rpx solid rgba(255,255,255,0.62);
  box-shadow:inset 0 1rpx 0 rgba(255,255,255,0.78), 0 12rpx 26rpx rgba(15,23,42,0.04); }

/* ═══ Booking items ═══ */
.booking-item { padding:22rpx 20rpx; margin-bottom:12rpx; border-radius:22rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 10rpx 22rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.74); }
.booking-item-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:8rpx; }
.booking-item-title { font-size:26rpx; font-weight:700; color:#0f172a; }
.booking-item-meta { font-size:22rpx; color:#64748b; line-height:1.6; }
.booking-item-actions { margin-top:10rpx; display:flex; gap:8rpx; justify-content:flex-end; }

/* Status chips */
.status-chip { font-size:20rpx; padding:4rpx 14rpx; border-radius:999rpx; font-weight:600; }
.status-chip.pending { background:#fef3c7; color:#92400e; }
.status-chip.approved { background:#d1fae5; color:#065f46; }
.status-chip.rejected { background:#fee2e2; color:#991b1b; }
.status-chip.cancelled { background:#f1f5f9; color:#64748b; }

/* ═══ Popup detail ═══ */
.popup-body { padding:24rpx; }
.detail-title { font-size:28rpx; font-weight:700; color:#1e293b; margin-bottom:16rpx; }
.detail-row { display:flex; font-size:24rpx; color:#475569; line-height:2; }
.detail-label { width:100rpx; color:#94a3b8; flex-shrink:0; }

/* ═══ Popup form ═══ */
.popup-form { padding:8rpx 16rpx 24rpx; }

/* ═══ Chips ═══ */
.chip-row { display:flex; flex-wrap:wrap; gap:8rpx; margin-top:8rpx; }
.chip-row.small { gap:4rpx; }
.chip { font-size:22rpx; padding:8rpx 18rpx; border-radius:20rpx; font-weight:500;
  background:rgba(241,245,249,0.8); color:#475569; border:1rpx solid rgba(203,213,225,0.5); }
.chip.active { background:#3b82f6; color:#fff; border-color:#3b82f6; box-shadow:0 4rpx 12rpx rgba(59,130,246,0.2); }
.chip.sm { width:52rpx; height:48rpx; padding:0; display:inline-flex; align-items:center; justify-content:center; font-size:20rpx; border-radius:12rpx; }

/* ═══ Time picker ═══ */
.time-picker-row { display:flex; gap:10rpx; align-items:center; }
.time-picker-val { min-width:90rpx; height:60rpx; line-height:60rpx; text-align:center;
  font-size:28rpx; font-weight:600; color:#1e293b;
  background:linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(247,250,255,0.82) 100%);
  border-radius:14rpx; border:1rpx solid rgba(226,232,240,0.68); padding:0 10rpx; }
.time-sep { font-size:28rpx; color:#64748b; }
.time-display { font-size:26rpx; color:#3b82f6; font-weight:600; min-width:100rpx; }
.field-hint { font-size:22rpx; color:#94a3b8; }
.empty-hint { text-align:center; color:#94a3b8; padding:20rpx; font-size:22rpx; }
.required { color:#ef4444; }
.input-row { display:flex; gap:10rpx; }

/* ═══ Cycle section ═══ */
.cycle-section { margin-bottom:12rpx; }
.range-row { display:flex; gap:6rpx; align-items:center; margin-bottom:6rpx; }
.range-label { font-size:22rpx; color:#64748b; min-width:40rpx; }
.year-chip { display:inline-flex; align-items:center; gap:4rpx; font-size:21rpx; padding:8rpx 16rpx;
  border-radius:18rpx; background:#dbeafe; color:#1d4ed8; border:1rpx solid #bfdbfe; margin:3rpx; }
.year-chip-remove { color:#ef4444; font-weight:700; margin-left:4rpx; }

/* ═══ Rules ═══ */
.rules-tabs { display:flex; border-bottom:1rpx solid rgba(226,232,240,0.8); margin:0 0 16rpx; }
.rules-tab { flex:1; text-align:center; padding:16rpx 0; font-size:24rpx; color:#94a3b8;
  border-bottom:3rpx solid transparent; font-weight:500; transition:all 0.2s; }
.rules-tab.active { color:#3b82f6; border-bottom-color:#3b82f6; font-weight:700; }
.rule-item { display:flex; align-items:center; justify-content:space-between; padding:18rpx 20rpx;
  margin-bottom:10rpx; border-radius:18rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(248,251,255,0.76) 100%);
  border:1rpx solid rgba(226,237,247,0.84);
  box-shadow:0 6rpx 14rpx rgba(15,23,42,0.025); }
.rule-item-name { font-size:25rpx; color:#1e293b; font-weight:600; }
.rule-item-detail { font-size:21rpx; color:#64748b; margin-top:4rpx; }
.rule-item-actions { display:flex; gap:6rpx; flex-shrink:0; }

/* ═══ Purpose items ═══ */
.purpose-item { display:flex; align-items:center; justify-content:space-between; padding:18rpx 20rpx;
  margin-bottom:10rpx; border-radius:18rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(248,251,255,0.76) 100%);
  border:1rpx solid rgba(226,237,247,0.84);
  box-shadow:0 6rpx 14rpx rgba(15,23,42,0.025); }
.purpose-item-text { font-size:25rpx; color:#1e293b; font-weight:500; flex:1; }
.purpose-item-actions { display:flex; gap:6rpx; flex-shrink:0; }

/* ═══ Picker value sm ═══ */
.picker-value.sm { min-height:60rpx; min-width:90rpx; font-size:22rpx; padding:0 14rpx; }

/* ═══ Primary button sm ═══ */
.primary-btn.sm { min-height:60rpx; line-height:60rpx; font-size:22rpx; min-width:120rpx; padding:0 20rpx; }

/* ═══ Schedule / Timetable ═══ */
.schedule-nav { display:flex; align-items:center; justify-content:center; gap:20rpx; padding:8rpx 16rpx 12rpx; }
.schedule-nav-btn { font-size:28rpx; padding:8rpx 18rpx; border-radius:16rpx; font-weight:700;
  background:rgba(255,255,255,0.85); color:#3b82f6; border:1rpx solid rgba(59,130,246,0.25); }
.schedule-week-label { font-size:25rpx; font-weight:700; color:#1e293b; }

.timetable-popup { max-height:95vh; width:96vw; }
.timetable-scroll { width:100%; height:1100rpx; }
.timetable-body { display:flex; }
.tt-time-col { width:60rpx; min-width:60rpx; flex-shrink:0; }
.tt-time-header { height:58rpx; display:flex; align-items:center; justify-content:center; font-size:18rpx;
  font-weight:700; color:#475569; background:#f1f5f9; border-bottom:1rpx solid rgba(226,232,240,0.6); box-sizing:border-box; }
.tt-time-label { height:64rpx; display:flex; align-items:center; justify-content:center; font-size:17rpx;
  color:#64748b; border-bottom:1rpx solid rgba(226,232,240,0.3); background:#f8fafc; box-sizing:border-box; }
.tt-col-scroll { flex:1; overflow-x:visible; }
.tt-cols-row { display:flex; }
.tt-col { flex:1; min-width:0; position:relative; }
.tt-col-header { height:58rpx; display:flex; flex-direction:column; align-items:center; justify-content:center;
  font-size:18rpx; font-weight:600; color:#475569; background:#f1f5f9;
  border-right:1rpx solid rgba(226,232,240,0.4); border-bottom:1rpx solid rgba(226,232,240,0.6);
  position:sticky; top:0; z-index:1; padding:2rpx 0; box-sizing:border-box; }
.tt-col-sub { font-size:16rpx; font-weight:400; color:#64748b; display:block; }

.tt-open-block { position:absolute; left:2rpx; right:2rpx; background:rgba(219,234,254,0.35);
  border-radius:6rpx; border:1rpx dashed rgba(147,197,253,0.35); }
.tt-time-target { position:absolute; left:0; right:0; z-index:1; opacity:0; }
.tt-event-block { position:absolute; left:2rpx; right:2rpx; display:flex; align-items:center; justify-content:center;
  border-radius:6rpx; overflow:hidden; z-index:2; }
.tt-event-block.booked { background:rgba(254,243,199,0.78); border:1rpx solid rgba(252,211,77,0.5); }
.tt-event-block.pending { background:rgba(254,215,170,0.72); border:1rpx solid rgba(253,186,116,0.45); }
.tt-event-block.activity { background:rgba(252,231,243,0.65); border:1rpx solid rgba(249,168,212,0.45); }
.tt-event-label { font-size:16rpx; color:#475569; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  max-width:80rpx; text-align:center; line-height:1.1; }

.tt-legend-row { display:flex; gap:12rpx; padding:10rpx 14rpx; font-size:18rpx; color:#64748b; flex-wrap:wrap; }
.tt-leg-item { display:flex; align-items:center; gap:3rpx; }
.tt-dot { width:20rpx; height:20rpx; border-radius:5rpx; flex-shrink:0; }
.tt-dot.open { background:#86efac; border:1rpx solid #4ade80; }
.tt-dot.booked { background:#fca5a5; border:1rpx solid #f87171; }
.tt-dot.pending { background:#fde68a; border:1rpx solid #fbbf24; }
.tt-dot.activity { background:#e9d5ff; border:1rpx solid #c084fc; }
.tt-dot.closed { background:#e2e8f0; border:1rpx solid #cbd5e1; }

/* ═══ Timeline axis ═══ */
.timeline-wrap { margin:8rpx 0; padding:0 4rpx; }
.timeline-bar { position:relative; height:40rpx; background:#f1f5f9; border-radius:10rpx; overflow:hidden; }
.timeline-block { position:absolute; top:0; height:100%; min-width:2rpx; }
.timeline-block.tl-free { background:linear-gradient(180deg, #86efac 0%, #4ade80 100%); }
.timeline-block.tl-booked { background:linear-gradient(180deg, #fca5a5 0%, #f87171 100%); }
.timeline-block.tl-pending { background:linear-gradient(180deg, #fde68a 0%, #fbbf24 100%); }
.timeline-block.tl-activity { background:linear-gradient(180deg, #e9d5ff 0%, #c084fc 100%); }
.timeline-block.tl-closed { background:#e2e8f0; }
.timeline-ticks { display:flex; justify-content:space-between; font-size:18rpx; color:#94a3b8; margin-top:2rpx; }

/* ═══ Inner scroll ═══ */
.inner-scroll { max-height:700rpx; }

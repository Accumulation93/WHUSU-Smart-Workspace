@import '../../../../pages/home/home.wxss';

.page { padding-bottom: 40rpx; }

.header-nav { display:flex; align-items:center; justify-content:flex-end; gap:12rpx; padding:0 0 16rpx; }
.header-nav-btn { font-size:22rpx; padding:10rpx 20rpx; border-radius:20rpx; font-weight:600; background:rgba(255,255,255,0.8); color:#3b82f6; border:1rpx solid rgba(59,130,246,0.3); box-shadow:0 4rpx 12rpx rgba(59,130,246,0.08); }

.venue-card { display:flex; align-items:center; gap:20rpx; padding:24rpx 22rpx; margin-bottom:14rpx; border-radius:24rpx; background:linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%); border:1rpx solid rgba(226,237,247,0.92); box-shadow:0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.74); animation:glassFadeUp 0.38s ease both; }
.venue-card:active { transform:translateY(1rpx) scale(0.992); }
.venue-card-avatar { width:76rpx; height:76rpx; border-radius:22rpx; background:linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%); display:flex; align-items:center; justify-content:center; color:#fff; font-size:34rpx; flex-shrink:0; box-shadow:0 8rpx 18rpx rgba(139,92,246,0.22); }
.venue-card-main { flex:1; min-width:0; }
.venue-card-name { color:#0f172a; font-size:28rpx; font-weight:700; line-height:1.4; }
.venue-card-loc { color:#64748b; font-size:21rpx; margin-top:4rpx; }
.venue-card-tag { display:inline-block; font-size:19rpx; padding:4rpx 12rpx; border-radius:14rpx; font-weight:600; margin-top:6rpx; }
.venue-card-tag.direct { background:#d1fae5; color:#065f46; }
.venue-card-tag.approval { background:#fef3c7; color:#92400e; }
.venue-card-actions { display:flex; flex-direction:column; gap:8rpx; flex-shrink:0; }
.venue-card-action { font-size:21rpx; padding:10rpx 20rpx; border-radius:18rpx; text-align:center; font-weight:600; }
.venue-card-action.view { background:#dbeafe; color:#1d4ed8; border:1rpx solid #bfdbfe; }
.venue-card-action.book { background:linear-gradient(135deg, #10b981 0%, #34d399 100%); color:#fff; box-shadow:0 6rpx 14rpx rgba(16,185,129,0.18); }

/* ── Week nav ── */
.schedule-nav { display:flex; align-items:center; justify-content:center; gap:20rpx; padding:8rpx 16rpx 12rpx; }
.schedule-nav-btn { font-size:28rpx; padding:8rpx 18rpx; border-radius:16rpx; font-weight:700; background:rgba(255,255,255,0.85); color:#3b82f6; border:1rpx solid rgba(59,130,246,0.25); }

/* ── Proportional Timetable ── */
.timetable-popup { max-height:95vh; width:96vw; }
.timetable-scroll { width:100%; height:1100rpx; }

.timetable-body { display:flex; }
.tt-time-col { width:60rpx; min-width:60rpx; flex-shrink:0; }
.tt-time-header { height:58rpx; display:flex; align-items:center; justify-content:center; font-size:18rpx; font-weight:700; color:#475569; background:#f1f5f9; border-bottom:1rpx solid rgba(226,232,240,0.6); box-sizing:border-box; }
.tt-time-label { height:64rpx; display:flex; align-items:center; justify-content:center; font-size:17rpx; color:#64748b; border-bottom:1rpx solid rgba(226,232,240,0.3); background:#f8fafc; box-sizing:border-box; }

.tt-col-scroll { flex:1; overflow-x:visible; }
.tt-cols-row { display:flex; }
.tt-col { flex:1; min-width:0; position:relative; }
.tt-col-header { height:58rpx; display:flex; align-items:center; justify-content:center; font-size:18rpx; font-weight:600; color:#475569; background:#f1f5f9; border-right:1rpx solid rgba(226,232,240,0.4); border-bottom:1rpx solid rgba(226,232,240,0.6); position:sticky; top:0; z-index:1; box-sizing:border-box; }

.tt-open-block { position:absolute; left:2rpx; right:2rpx; background:rgba(219,234,254,0.35); border-radius:6rpx; border:1rpx dashed rgba(147,197,253,0.35); }

.tt-time-target { position:absolute; left:0; right:0; z-index:1; opacity:0; }

.tt-event-block { position:absolute; left:2rpx; right:2rpx; display:flex; align-items:center; justify-content:center; border-radius:6rpx; overflow:hidden; z-index:2; }
.tt-event-block.booked { background:rgba(254,243,199,0.78); border:1rpx solid rgba(252,211,77,0.5); }
.tt-event-block.pending { background:rgba(254,215,170,0.72); border:1rpx solid rgba(253,186,116,0.45); }
.tt-event-block.activity { background:rgba(252,231,243,0.65); border:1rpx solid rgba(249,168,212,0.45); }

.tt-event-label { font-size:16rpx; color:#475569; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:80rpx; text-align:center; line-height:1.1; }

.tt-legend { width:28rpx; height:16rpx; border-radius:4rpx; }
.tt-l-open { background:rgba(219,234,254,0.6); border:1rpx solid #bfdbfe; }
.tt-l-booked { background:rgba(254,243,199,0.8); border:1rpx solid #fcd34d; }
.tt-l-pending { background:rgba(254,215,170,0.7); border:1rpx solid #fdba74; }
.tt-l-activity { background:rgba(252,231,243,0.7); border:1rpx solid #f9a8d4; }
.tt-l-closed { background:rgba(241,245,249,0.6); border:1rpx solid #e2e8f0; }

/* ── Horizontal Timeline Axis ── */
.timeline-wrap { margin:16rpx 0 8rpx; }
.timeline-bar { position:relative; height:48rpx; background:#f1f5f9; border-radius:12rpx; overflow:hidden; }
.timeline-block { position:absolute; top:0; height:100%; min-width:2rpx; }
.timeline-block.tl-free { background:linear-gradient(180deg, #86efac 0%, #4ade80 100%); }
.timeline-block.tl-booked { background:linear-gradient(180deg, #fca5a5 0%, #f87171 100%); }
.timeline-block.tl-pending { background:linear-gradient(180deg, #fde68a 0%, #fbbf24 100%); }
.timeline-block.tl-activity { background:linear-gradient(180deg, #e9d5ff 0%, #c084fc 100%); }
.timeline-block.tl-closed { background:#e2e8f0; }

.timeline-ticks { display:flex; justify-content:space-between; font-size:18rpx; color:#94a3b8; margin-top:4rpx; padding:0 2rpx; }
.timeline-legend { display:flex; gap:14rpx; flex-wrap:wrap; font-size:18rpx; color:#64748b; margin-top:8rpx; }
.tl-leg-item { display:flex; align-items:center; gap:4rpx; }
.tl-dot { width:20rpx; height:20rpx; border-radius:6rpx; flex-shrink:0; }
.tl-dot.free { background:#4ade80; }
.tl-dot.booked { background:#f87171; }
.tl-dot.pending { background:#fbbf24; }
.tl-dot.activity { background:#c084fc; }
.tl-dot.closed { background:#cbd5e1; }

/* ── Time pickers ── */
.time-picker-val {
  min-width:100rpx; height:60rpx; line-height:60rpx; text-align:center;
  font-size:28rpx; font-weight:600; color:#1e293b;
  background:#f1f5f9; border-radius:14rpx; border:1rpx solid #e2e8f0; padding:0 12rpx;
}

/* ── Slot chips ── */
.slot-chip { font-size:22rpx; padding:10rpx 18rpx; border-radius:18rpx; background:#dbeafe; color:#1d4ed8; border:1rpx solid #bfdbfe; font-weight:500; }
.slot-chip.selected { background:#3b82f6; color:#fff; border-color:#3b82f6; box-shadow:0 4rpx 12rpx rgba(59,130,246,0.2); }

/* ── Purpose chips ── */
.purpose-chips { display:flex; flex-wrap:wrap; gap:8rpx; margin-top:8rpx; }
.purpose-chip { font-size:22rpx; padding:8rpx 18rpx; border-radius:18rpx; background:#dbeafe; color:#1d4ed8; border:1rpx solid #bfdbfe; font-weight:500; }
.purpose-chip.selected { background:#3b82f6; color:#fff; border-color:#3b82f6; box-shadow:0 4rpx 12rpx rgba(59,130,246,0.2); }

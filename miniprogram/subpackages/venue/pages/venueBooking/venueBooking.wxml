<view class="page">
  <!-- Hero -->
  <view class="hero">
    <view class="hero-badge">{{heroIdentity}}</view>
    <view class="hero-title">{{heroName}}</view>
    <view class="hero-subtitle">{{heroSubtitle}}</view>
  </view>

  <!-- Tab bar -->
  <view class="tabs-card">
    <view class="feature-tab {{activeTab === 'browse' ? 'feature-tab-active' : ''}}" data-tab="browse" bindtap="switchTab">场地浏览</view>
    <view class="feature-tab {{activeTab === 'bookings' ? 'feature-tab-active' : ''}}" data-tab="bookings" bindtap="switchTab">我的借用</view>
  </view>

  <!-- ═══════════════════ BROWSE TAB ═══════════════════ -->
  <view wx:if="{{activeTab === 'browse'}}">
    <view class="card">
      <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
      <view class="section-title">可用场地</view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll" scroll-y>
        <view class="empty-state" wx:if="{{!venues.length}}">
          <view class="empty-text">暂无可用的场地</view>
        </view>
        <view class="venue-card" wx:for="{{venues}}" wx:key="id">
          <view class="venue-main">
            <view class="venue-name">{{item.name}}</view>
            <view class="venue-loc" wx:if="{{item.location}}">{{item.location}}</view>
            <view class="venue-meta">
              <text class="venue-tag {{item.approvalType === 'direct' ? 'direct' : 'approval'}}">{{item.approvalType === 'direct' ? '直接通过' : '需审核'}}</text>
            </view>
          </view>
          <view class="venue-actions">
            <text class="action-btn" data-id="{{item.id}}" bindtap="openSchedule">日程</text>
            <text class="action-btn primary" data-id="{{item.id}}" bindtap="openBooking">借用</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ═══════════════════ BOOKINGS TAB ═══════════════════ -->
  <view wx:if="{{activeTab === 'bookings'}}">
    <view class="card">
      <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
      <view class="section-title">借用记录</view>
      <view class="pending-entry-bar" bindtap="goPendingApprovals">
        <view class="pending-entry-left">
          <text class="pending-entry-icon">📋</text>
          <text class="pending-entry-label">待我审批</text>
          <view class="pending-entry-badge" wx:if="{{pendingApprovalCount > 0}}">{{pendingApprovalCount > 99 ? '99+' : pendingApprovalCount}}</view>
        </view>
        <text class="pending-entry-arrow">›</text>
      </view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll" scroll-y>
        <view class="empty-state" wx:if="{{!myBookings.length}}">
          <view class="empty-text">暂无借用记录</view>
        </view>
        <view class="booking-item" wx:for="{{myBookings}}" wx:key="id" bindtap="viewMyBookingDetail" data-id="{{item.id}}">
          <view class="booking-item-head">
            <view class="booking-item-title">{{item.title || '借用申请'}}</view>
            <text class="status-tag {{item.displayStatus}}">{{statusLabels[item.displayStatus] || item.status}}</text>
          </view>
          <view class="booking-item-meta">{{item.venueName}} · {{item.timeStart}} 至 {{item.timeEnd}}</view>
          <view class="booking-item-meta" wx:if="{{item.description}}">{{item.description}}</view>
          <view class="booking-item-meta" wx:if="{{item.approvalComment}}">审批意见：{{item.approvalComment}}</view>
          <view class="booking-item-foot" wx:if="{{item.displayStatus === 'pending' || item.displayStatus === 'approved'}}">
            <text class="link danger" data-id="{{item.id}}" catchtap="cancelMyBooking">取消借用</text>
          </view>
          <view class="booking-item-foot" wx:if="{{item.displayStatus === 'inUse'}}">
            <text class="link" data-id="{{item.id}}" catchtap="endMyBooking">结束使用</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ═══════════════════ TIMETABLE POPUP ═══════════════════ -->
  <view class="popup-mask" wx:if="{{scheduleVisible}}" bindtap="closeSchedule">
    <view class="popup-card timetable-popup" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">{{scheduleVenueName}}</view>
        <text class="popup-close" bindtap="closeSchedule">关闭</text>
      </view>
      <view class="schedule-nav">
        <text class="nav-arrow" bindtap="onTimetablePrevWeek">{{'‹'}}</text>
        <text class="nav-label">{{scheduleWeekStart}} 起一周</text>
        <text class="nav-arrow" bindtap="onTimetableNextWeek">{{'›'}}</text>
      </view>
      <scroll-view scroll-x scroll-y class="timetable-scroll">
        <view class="timetable-body">
          <view class="tt-time-col">
            <view class="tt-time-header">时间</view>
            <view class="tt-time-label" wx:for="{{timetableHours}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="tt-col-scroll">
            <view class="tt-cols-row">
              <view class="tt-col" wx:for="{{timetableColumns}}" wx:key="date" wx:for-item="col" data-date="{{col.date}}" bindtap="onTimetableOpenTap">
                <view class="tt-col-header">{{col.label}}<text class="tt-col-sub">{{col.dateDisplay}}</text></view>
                <view class="tt-open-block" wx:for="{{col.openBlocks}}" wx:key="top" wx:for-item="ob" style="top:{{ob.top}}rpx;height:{{ob.height}}rpx;"></view>
                <view wx:for="{{col.timeTargets}}" wx:key="top" wx:for-item="tt" class="tt-time-target" style="top:{{tt.top}}rpx;height:{{HOUR_HEIGHT/2}}rpx;" data-date="{{col.date}}" data-time="{{tt.time}}" catchtap="onTimeTargetTap"></view>
                <view class="tt-event-block {{eb.status}}" wx:for="{{col.eventBlocks}}" wx:key="top" wx:for-item="eb" style="top:{{eb.top}}rpx;height:{{eb.height}}rpx;" data-block="{{eb}}" catchtap="onTimetableBlockTap">
                  <text class="tt-event-label">{{eb.label}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="tt-legend">
        <view class="tt-leg-item"><view class="tt-dot open"></view>空闲</view>
        <view class="tt-leg-item"><view class="tt-dot booked"></view>已借用</view>
        <view class="tt-leg-item"><view class="tt-dot pending"></view>待审核</view>
        <view class="tt-leg-item"><view class="tt-dot activity"></view>活动</view>
        <view class="tt-leg-item"><view class="tt-dot closed"></view>未开放</view>
      </view>
    </view>
  </view>

  <!-- Booking detail popup -->
  <view class="popup-mask" wx:if="{{bookingDetailVisible}}" bindtap="closeBookingDetail">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">借用详情</view>
        <text class="popup-close" bindtap="closeBookingDetail">关闭</text>
      </view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y>
      <view class="detail-body">
        <view class="detail-title">{{bookingDetail.title || '借用'}}</view>
        <view class="detail-row" wx:if="{{bookingDetail.venueName}}"><text class="detail-key">场地</text><text class="detail-val">{{bookingDetail.venueName}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.userName}}"><text class="detail-key">借用人</text><text class="detail-val">{{bookingDetail.userName}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.userDept}}"><text class="detail-key">部门</text><text class="detail-val">{{bookingDetail.userDept}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.userIdentity}}"><text class="detail-key">身份</text><text class="detail-val">{{bookingDetail.userIdentity}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.timeStart}}"><text class="detail-key">时间</text><text class="detail-val">{{bookingDetail.timeStart}} 至 {{bookingDetail.timeEnd}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.description}}"><text class="detail-key">说明</text><text class="detail-val">{{bookingDetail.description}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.approvalComment}}"><text class="detail-key">审批意见</text><text class="detail-val">{{bookingDetail.approvalComment}}</text></view>
        <view class="detail-row"><text class="detail-key">状态</text><text class="status-tag {{bookingDetail.displayStatus || bookingDetail.status}}">{{statusLabels[bookingDetail.displayStatus || bookingDetail.status] || bookingDetail.status}}</text></view>
        <!-- Flow progress bar -->
        <view wx:if="{{bookingDetail.approvalProgress}}" class="audit-flow-summary" style="margin-top:8rpx;">
          <view class="audit-flow-progress-bar">
            <view class="audit-flow-progress-fill" style="width:{{bookingDetail._approvalPercent}}%;{{bookingDetail._approvalBarColor || ''}}"></view>
          </view>
          <text class="audit-flow-progress-text">{{bookingDetail.approvalProgress.isRejected ? '已驳回' : (bookingDetail.approvalProgress.isApproved ? '已完成' : (bookingDetail.approvalProgress.currentStep + '/' + bookingDetail.approvalProgress.totalSteps))}}</text>
        </view>
        <!-- Full flow timeline -->
        <view wx:if="{{bookingDetail._flowTimeline && bookingDetail._flowTimeline.length}}" class="audit-flow" style="margin-top:6rpx;">
          <view class="{{node.nodeClass}} {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}}" wx:for="{{bookingDetail._flowTimeline}}" wx:key="*this" wx:for-item="node" bindtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="flow-node-tap">
            <view class="flow-left-col">
              <view class="{{node.dotClass}}">{{node.icon}}</view>
              <view class="flow-connector" wx:if="{{!node.isLast}}"></view>
            </view>
            <view class="flow-right-col">
              <view class="flow-info">
                <view class="flow-info-title">{{node.stepName}}<text class="flow-step-status-tag flow-tag-{{node.state}}" style="margin-left:8rpx;">{{node.label}}</text></view>
                <view class="flow-info-desc" wx:if="{{node.meta}}">{{node.meta}}</view>
                <view class="flow-info-desc" wx:if="{{node.comment}}" style="font-style:italic;color:#94a3b8;">{{node.comment}}</view>
                <view wx:if="{{node.state === 'done' || node.state === 'rejected'}}" class="flow-expand-hint">{{expandedNodeKey === node._key ? '▲ 收起' : '▼ 详情'}}</view>
              </view>
              <view wx:if="{{expandedNodeKey === node._key && (node.state === 'done' || node.state === 'rejected')}}" class="flow-expand-detail">
                <view wx:if="{{node.approverName}}" class="flow-detail-text"><text class="flow-detail-label">审批人：</text>{{node.approverName}}</view>
                <view wx:if="{{node.approvedAt}}" class="flow-detail-text"><text class="flow-detail-label">审批时间：</text>{{node.approvedAt}}</view>
                <view wx:if="{{node.comment}}" class="flow-detail-text flow-detail-comment-text"><text class="flow-detail-label">审批意见：</text>{{node.comment}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
      </scroll-view>
    </view>
  </view>

  <!-- ═══════════════════ BOOKING FORM ═══════════════════ -->
  <view class="popup-mask" wx:if="{{bookingVisible}}" bindtap="closeBooking">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">借用申请 · {{bookingVenueName}}</view>
        <text class="popup-close" bindtap="closeBooking">关闭</text>
      </view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y>
        <view class="form-body">
          <!-- Title -->
          <view class="field">
            <view class="field-label">借用事由 <text class="required">*</text></view>
            <input class="field-input" value="{{bookingTitle}}" data-field="bookingTitle" bindinput="onFieldInput" placeholder="选择或输入借用事由"/>
            <view class="chip-row" wx:if="{{purposes.length}}">
              <text wx:for="{{purposes}}" wx:key="id" class="chip {{bookingTitle === item.text ? 'active' : ''}}" data-text="{{item.text}}" bindtap="onSelectPurpose">{{item.text}}</text>
            </view>
          </view>
          <!-- Start date -->
          <view class="field">
            <view class="field-label">开始日期</view>
            <picker mode="date" value="{{bookingStartDate}}" bindchange="onStartDateChange">
              <view class="picker-display {{bookingStartDate ? 'picker-has-value' : ''}}">{{bookingStartDateDisplay || '请选择日期'}}</view>
            </picker>
          </view>
          <!-- Timeline -->
          <view wx:if="{{timelineBlocks.length}}" class="timeline-wrap">
            <view class="timeline-bar">
              <view wx:for="{{timelineBlocks}}" wx:key="startMin" wx:if="{{item.width > 0}}" class="timeline-block tl-{{item.status}}" style="left:{{item.left}}%;width:{{item.width}}%;"></view>
            </view>
            <view class="timeline-ticks"><text>0:00</text><text>6:00</text><text>12:00</text><text>18:00</text><text>24:00</text></view>
          </view>
          <!-- ★ Start time grid ★ -->
          <view class="field">
            <view class="field-label">开始时间 <text class="required">*</text></view>
            <view wx:if="{{startGrid.length}}" class="time-section">
              <!-- Result display -->
              <view wx:if="{{bookingTimeStart}}" class="time-result-row">
                <text class="time-result-icon">▶</text>
                <text class="time-result-val">{{bookingTimeStart}}</text>
                <text class="time-result-suffix">开始</text>
              </view>
              <!-- Time grid -->
              <scroll-view scroll-y class="time-grid-scroll">
                <view class="time-grid-row" wx:for="{{startGrid}}" wx:key="*this" wx:for-item="row">
                  <view
                    class="time-slot-card slot-{{item.status}} {{item.active ? 'slot-active' : ''}} {{item.selectable ? '' : 'slot-disabled'}}"
                    wx:for="{{row}}" wx:key="time" wx:for-item="item"
                    data-time="{{item.time}}" data-status="{{item.status}}"
                    catchtap="onStartSlotTap"
                  >
                    <text class="slot-time">{{item.time}}</text>
                    <text class="slot-label">{{item.label}}</text>
                  </view>
                </view>
              </scroll-view>
              <!-- Keyboard input fallback -->
              <view class="time-input-row">
                <text class="time-input-hint">键盘输入</text>
                <input class="time-input" value="{{timeStartInput}}" placeholder="如 14:30" bindinput="onTimeStartInput" bindblur="onTimeStartInputBlur" maxlength="5"/>
              </view>
            </view>
            <view wx:else class="field-hint">{{bookingStartDate ? '该日期暂无可选时段' : '请先选择日期'}}</view>
          </view>
          <!-- End date -->
          <view class="field">
            <view class="field-label">结束日期</view>
            <picker mode="date" value="{{bookingEndDate}}" bindchange="onEndDateChange">
              <view class="picker-display {{bookingEndDate ? 'picker-has-value' : ''}}">{{bookingEndDateDisplay || '请选择日期'}}</view>
            </picker>
          </view>
          <!-- ★ End time grid ★ -->
          <view class="field">
            <view class="field-label">结束时间 <text class="required">*</text></view>
            <view wx:if="{{endGrid.length}}" class="time-section">
              <!-- Context: start time indicator -->
              <view wx:if="{{bookingTimeStart}}" class="end-context">
                <text class="end-context-label">始于</text>
                <text class="end-context-time">{{bookingTimeStart}}</text>
                <text class="end-context-arrow">→</text>
              </view>
              <!-- Result display -->
              <view wx:if="{{bookingTimeEnd}}" class="time-result-row end-result">
                <text class="time-result-icon">■</text>
                <text class="time-result-val">{{bookingTimeEnd}}</text>
                <text class="time-result-suffix">结束</text>
              </view>
              <!-- Time grid -->
              <scroll-view scroll-y class="time-grid-scroll">
                <view class="time-grid-row" wx:for="{{endGrid}}" wx:key="*this" wx:for-item="row">
                  <view
                    class="time-slot-card slot-{{item.status}} {{item.active ? 'slot-active' : ''}} {{item.selectable ? '' : 'slot-disabled'}}"
                    wx:for="{{row}}" wx:key="time" wx:for-item="item"
                    data-time="{{item.time}}" data-selectable="{{item.selectable}}"
                    catchtap="onEndSlotTap"
                  >
                    <text class="slot-time">{{item.time}}</text>
                    <text class="slot-label">{{item.selectable ? item.label : '✕'}}</text>
                  </view>
                </view>
              </scroll-view>
              <!-- Keyboard input fallback -->
              <view class="time-input-row">
                <text class="time-input-hint">键盘输入</text>
                <input class="time-input" value="{{timeEndInput}}" placeholder="如 15:30" bindinput="onTimeEndInput" bindblur="onTimeEndInputBlur" maxlength="5"/>
              </view>
            </view>
            <view wx:else class="field-hint">{{bookingTimeStart ? '该开始时间后无可用时段' : '请先选择开始时间'}}</view>
          </view>
          <!-- Description -->
          <view class="field">
            <view class="field-label">备注（选填）</view>
            <textarea class="field-textarea" auto-height maxlength="-1" value="{{bookingDesc}}" data-field="bookingDesc" bindinput="onFieldInput" placeholder="补充说明"/>
          </view>
          <button class="primary-btn" loading="{{loading}}" bindtap="submitBooking">提交借用申请</button>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>
</view>

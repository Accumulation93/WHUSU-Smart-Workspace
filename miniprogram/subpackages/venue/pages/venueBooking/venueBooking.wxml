<wxs module="fmt">
function hour(t) {
  if (!t) return '--';
  var p = (''+t).split(':');
  return p[0] || '--';
}
function min(t) {
  if (!t) return '--';
  var p = (''+t).split(':');
  return p[1] || '--';
}
module.exports = { hour: hour, min: min };
</wxs>
<workspace-navigation></workspace-navigation>
<view class="page">
  <!-- Hero -->
  <workspace-hero class="workspace-hero-host" app-name="WHUSU智慧工作台" page-name="场地借用"></workspace-hero>

  <!-- Tab bar -->
  <view class="tabs-card">
    <view class="feature-tab {{activeTab === 'browse' ? 'feature-tab-active' : ''}} ui-motion-chip" data-tab="browse" bindtap="switchTab" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">场地浏览</view>
    <view class="feature-tab {{activeTab === 'bookings' ? 'feature-tab-active' : ''}} ui-motion-chip" data-tab="bookings" bindtap="switchTab" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">我的借用</view>
    <view class="feature-tab {{activeTab === 'approvals' ? 'feature-tab-active' : ''}} feature-tab-approvals ui-motion-chip" data-tab="approvals" bindtap="switchTab" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
      待我审批
      <text class="approval-tab-badge" wx:if="{{pendingApprovalCount > 0}}">{{pendingApprovalCount > 99 ? '99+' : pendingApprovalCount}}</text>
    </view>
  </view>

  <!-- ═══════════════════ BROWSE TAB ═══════════════════ -->
  <view class="venue-workspace-panel" wx:if="{{activeTab === 'browse'}}">
    <view class="card">
      <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
      <view class="section-title">可用场地</view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll" scroll-y>
        <view class="empty-state" wx:if="{{!venues.length}}">
          <view class="empty-text">暂无可用的场地</view>
        </view>
        <view class="venue-card" wx:for="{{venues}}" wx:key="id">
          <view class="venue-main">
            <view class="venue-name">{{item.name}}</view>
            <view class="venue-loc" wx:if="{{item.location}}">{{item.location}}</view>
            <view class="venue-meta">
              <text class="venue-tag {{item.approvalType === 'direct' ? 'direct' : 'approval'}}">{{item.approvalType === 'direct' ? '直接通过' : '需审核'}}</text>
            </view>
          </view>
          <view class="venue-actions">
            <text class="action-btn ui-motion-chip" data-id="{{item.id}}" bindtap="openSchedule" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">日程</text>
            <text class="action-btn primary ui-motion-chip" data-id="{{item.id}}" bindtap="openBooking" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">借用</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ═══════════════════ BOOKINGS TAB ═══════════════════ -->
  <view class="venue-workspace-panel" wx:if="{{activeTab === 'bookings'}}">
    <view class="card">
      <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
      <view class="section-title">借用记录</view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll" scroll-y>
        <view class="empty-state" wx:if="{{!myBookings.length}}">
          <view class="empty-text">暂无借用记录</view>
        </view>
        <view class="booking-item ui-motion-card" wx:for="{{myBookings}}" wx:key="id" bindtap="viewMyBookingDetail" data-id="{{item.id}}" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="booking-item-head">
            <view class="booking-item-title">{{item.title || '借用申请'}}</view>
            <text class="status-tag {{item.displayStatus}}">{{statusLabels[item.displayStatus] || item.status}}</text>
          </view>
          <view class="booking-item-meta">{{item.venueName}} · {{item.timeStart}} 至 {{item.timeEnd}}</view>
          <view class="booking-item-meta" wx:if="{{item.description}}">{{item.description}}</view>
          <view class="booking-item-meta" wx:if="{{item.approvalComment}}">审批意见：{{item.approvalComment}}</view>
          <view class="booking-item-foot" wx:if="{{item.displayStatus === 'pending' || item.displayStatus === 'approved'}}">
            <text class="link danger ui-motion-chip" data-id="{{item.id}}" catchtap="cancelMyBooking" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消借用</text>
          </view>
          <view class="booking-item-foot" wx:if="{{item.displayStatus === 'inUse'}}">
            <text class="link ui-motion-chip" data-id="{{item.id}}" catchtap="endMyBooking" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">结束使用</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ═══════════════════ APPROVALS TAB ═══════════════════ -->
  <view class="venue-workspace-panel" wx:if="{{activeTab === 'approvals'}}">
    <view class="card">
      <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
      <view class="section-title">待我审批</view>
      <view class="pending-header" wx:if="{{pending.length && lastUpdateTime}}">
        <text class="pending-update-time">更新于 {{lastUpdateTime}}</text>
        <text class="pending-refresh-btn ui-motion-chip" bindtap="loadPendingData" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">⟳ 刷新</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
        <view class="pending-item ui-motion-card" wx:for="{{pending}}" wx:key="id" data-id="{{item.id}}" bindtap="viewApprovalDetail" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="pending-item-main">
            <view class="pending-item-name">{{item.title || '借用申请'}}</view>
            <view class="pending-item-meta">
              <view class="audit-chip audit-chip-progress">待我处理</view>
              <view class="pending-item-step">第{{item.currentStepIndex + 1}}步 · {{item.currentStepName}}</view>
              <view class="pending-item-step" wx:if="{{item.approvalCurrentStep > 0}}">{{item.approvalCurrentStep}}/{{item.approvalTotalSteps}} 已完成</view>
            </view>
            <view class="pending-item-info">{{item.venueName}} · {{item.userName}} · {{item.timeStart}} 至 {{item.timeEnd}}</view>
          </view>
          <view class="pending-actions-col">
            <text class="pending-action-link approve ui-motion-chip" data-id="{{item.id}}" catchtap="openApprove" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">通过</text>
            <text class="pending-action-link reject ui-motion-chip" data-id="{{item.id}}" catchtap="openReject" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">驳回</text>
          </view>
        </view>
        <view class="audit-empty-state" wx:if="{{!pending.length && !loading}}">
          <view class="audit-empty-icon"><ui-icon name="check" tone="primary" size="54" ariaLabel="当前暂无借用记录" /></view>
          <view class="audit-empty-text">暂无待审批事项</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ═══════════════════ TIMETABLE POPUP ═══════════════════ -->
  <view class="popup-mask ui-overlay" wx:if="{{scheduleVisible}}" bindtap="closeSchedule">
    <view class="popup-card timetable-popup ui-dialog-shell ui-dialog-shell--wide ui-data-grid--specialized" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">{{scheduleVenueName}}</view>
        <text class="popup-close ui-motion-chip" catchtap="closeSchedule" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>
      <view class="schedule-nav">
        <text class="nav-arrow ui-motion-card" catchtap="onTimetablePrevWeek" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{'‹'}}</text>
        <text class="nav-label">{{scheduleWeekStart}} 起一周</text>
        <text class="nav-arrow ui-motion-card" catchtap="onTimetableNextWeek" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{'›'}}</text>
      </view>
      <scroll-view scroll-x scroll-y class="timetable-scroll ui-dialog-body ui-dialog-scroll--both ui-data-grid--specialized">
        <view class="timetable-body">
          <view class="tt-time-col">
            <view class="tt-time-header">时间</view>
            <view class="tt-time-label" wx:for="{{timetableHours}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="tt-col-scroll">
            <view class="tt-cols-row">
              <view class="tt-col ui-motion-chip" wx:for="{{timetableColumns}}" wx:key="date" wx:for-item="col" data-date="{{col.date}}" catchtap="onTimetableOpenTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
                <view class="tt-col-header">{{col.label}}<text class="tt-col-sub">{{col.dateDisplay}}</text></view>
                <view class="tt-open-block" wx:for="{{col.openBlocks}}" wx:key="top" wx:for-item="ob" style="top:{{ob.top}}rpx;height:{{ob.height}}rpx;"></view>
                <view wx:for="{{col.timeTargets}}" wx:key="top" wx:for-item="tt" class="tt-time-target ui-motion-chip" style="top:{{tt.top}}rpx;height:{{HOUR_HEIGHT/2}}rpx;" data-date="{{col.date}}" data-time="{{tt.time}}" catchtap="onTimeTargetTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"></view>
                <view class="tt-event-block {{eb.status}} ui-motion-chip" wx:for="{{col.eventBlocks}}" wx:key="top" wx:for-item="eb" style="top:{{eb.top}}rpx;height:{{eb.height}}rpx;" data-block="{{eb}}" catchtap="onTimetableBlockTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
                  <text class="tt-event-label">{{eb.label}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="tt-legend">
        <view class="tt-leg-item"><view class="tt-dot open"></view>空闲</view>
        <view class="tt-leg-item"><view class="tt-dot booked"></view>已借用</view>
        <view class="tt-leg-item"><view class="tt-dot pending"></view>待审核</view>
        <view class="tt-leg-item"><view class="tt-dot activity"></view>活动</view>
        <view class="tt-leg-item"><view class="tt-dot closed"></view>未开放</view>
      </view>
    </view>
  </view>

  <!-- Booking detail popup -->
  <view class="popup-mask ui-overlay" wx:if="{{bookingDetailVisible}}" bindtap="closeBookingDetail">
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">借用详情</view>
        <text class="popup-close ui-motion-chip" catchtap="closeBookingDetail" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-scroll--fill" scroll-y>
      <view class="detail-body">
        <view class="detail-title">{{bookingDetail.title || '借用'}}</view>
        <view class="detail-row" wx:if="{{bookingDetail.venueName}}"><text class="detail-key">场地</text><text class="detail-val">{{bookingDetail.venueName}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.userName}}"><text class="detail-key">借用人</text><text class="detail-val">{{bookingDetail.userName}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.userDept}}"><text class="detail-key">部门</text><text class="detail-val">{{bookingDetail.userDept}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.userIdentity}}"><text class="detail-key">身份</text><text class="detail-val">{{bookingDetail.userIdentity}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.timeStart}}"><text class="detail-key">时间</text><text class="detail-val">{{bookingDetail.timeStart}} 至 {{bookingDetail.timeEnd}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.description}}"><text class="detail-key">说明</text><text class="detail-val">{{bookingDetail.description}}</text></view>
        <view class="detail-row" wx:if="{{bookingDetail.approvalComment}}"><text class="detail-key">审批意见</text><text class="detail-val">{{bookingDetail.approvalComment}}</text></view>
        <view class="detail-row"><text class="detail-key">状态</text><text class="status-tag {{bookingDetail.displayStatus || bookingDetail.status}}">{{statusLabels[bookingDetail.displayStatus || bookingDetail.status] || bookingDetail.status}}</text></view>
        <!-- Flow progress bar -->
        <view wx:if="{{bookingDetail.approvalProgress}}" class="audit-flow-summary" style="margin-top:8rpx;">
          <view class="audit-flow-progress-bar">
            <view class="audit-flow-progress-fill" style="width:{{bookingDetail._approvalPercent}}%;{{bookingDetail._approvalBarColor || ''}}"></view>
          </view>
          <text class="audit-flow-progress-text">{{bookingDetail.approvalProgress.isRejected ? '已驳回' : (bookingDetail.approvalProgress.isApproved ? '已完成' : (bookingDetail.approvalProgress.currentStep + '/' + bookingDetail.approvalProgress.totalSteps))}}</text>
        </view>
        <!-- Full flow timeline -->
        <view wx:if="{{bookingDetail._flowTimeline && bookingDetail._flowTimeline.length}}" class="audit-flow" style="margin-top:6rpx;">
          <view class="{{node.nodeClass}} {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}} ui-motion-chip" wx:for="{{bookingDetail._flowTimeline}}" wx:key="*this" wx:for-item="node" catchtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="flow-left-col">
              <view class="{{node.dotClass}}">{{node.icon}}</view>
              <view class="flow-connector" wx:if="{{!node.isLast}}"></view>
            </view>
            <view class="flow-right-col">
              <view class="flow-info">
                <view class="flow-info-title">{{node.stepName}}<text class="flow-step-status-tag flow-tag-{{node.state}}" style="margin-left:8rpx;">{{node.label}}</text></view>
                <view class="flow-info-desc" wx:if="{{node.meta}}">{{node.meta}}</view>
                <view class="flow-info-desc" wx:if="{{node.comment}}" style="font-style:italic;color:#94a3b8;">{{node.comment}}</view>
                <view wx:if="{{node.state === 'done' || node.state === 'rejected'}}" class="flow-expand-hint">{{expandedNodeKey === node._key ? '▲ 收起' : '▼ 详情'}}</view>
              </view>
              <view wx:if="{{expandedNodeKey === node._key && (node.state === 'done' || node.state === 'rejected')}}" class="flow-expand-detail">
                <view wx:if="{{node.approverName}}" class="flow-detail-text"><text class="flow-detail-label">审批人：</text>{{node.approverName}}</view>
                <view wx:if="{{node.approvedAt}}" class="flow-detail-text"><text class="flow-detail-label">审批时间：</text>{{node.approvedAt}}</view>
                <view wx:if="{{node.comment}}" class="flow-detail-text flow-detail-comment-text"><text class="flow-detail-label">审批意见：</text>{{node.comment}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
      </scroll-view>
    </view>
  </view>

  <!-- ═══════════════════ BOOKING FORM ═══════════════════ -->
  <view class="popup-mask ui-overlay" wx:if="{{bookingVisible}}" bindtap="closeBooking">
    <view class="popup-card booking-form-popup ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">借用申请 · {{bookingVenueName}}</view>
        <text class="popup-close ui-motion-chip" catchtap="closeBooking" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-scroll--fill" scroll-y>
        <view class="form-body">
          <!-- Title -->
          <view class="field">
            <view class="field-label">借用事由 <text class="required">*</text></view>
            <input class="field-input" value="{{bookingTitle}}" data-field="bookingTitle" bindinput="onFieldInput" placeholder="选择或输入借用事由" placeholder-style="font-size:24rpx;line-height:44rpx;color:#94a3b8;"/>
            <view class="chip-row" wx:if="{{purposes.length}}">
              <text wx:for="{{purposes}}" wx:key="id" class="chip {{bookingTitle === item.text ? 'active' : ''}} ui-motion-chip" data-text="{{item.text}}" catchtap="onSelectPurpose" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item.text}}</text>
            </view>
          </view>
          <!-- Date (same-day only) -->
          <view class="field">
            <view class="field-label">借用日期</view>
            <picker mode="date" value="{{bookingStartDate}}" bindchange="onStartDateChange">
              <view class="picker-display {{bookingStartDate ? 'picker-has-value' : ''}}">{{bookingStartDateDisplay || '请选择日期'}}</view>
            </picker>
          </view>
          <!-- Selected summary -->
          <view wx:if="{{bookingTimeStart && bookingTimeEnd}}" class="time-summary">
            <view class="time-summary-icon"><ui-icon name="clock" tone="primary" size="28" ariaLabel="借用时间" /></view>
            <text class="time-summary-text">{{bookingTimeStart}} → {{bookingTimeEnd}}</text>
            <text class="time-summary-dur">（{{_durationText}}）</text>
          </view>
          <!-- ★ Draggable timeline ★ -->
          <view wx:if="{{timelineBlocks.length}}" class="timeline-wrap">
            <view class="timeline-hint">拖动圆形滑块选择时间范围</view>
            <view class="timeline-drag-container">
              <!-- Background blocks -->
              <view class="timeline-bar">
                <view wx:for="{{timelineBlocks}}" wx:key="left" wx:if="{{item.width > 0}}" class="timeline-block tl-{{item.status}}" style="left:{{item.left}}%;width:{{item.width}}%;"></view>
                <!-- Selected range -->
                <view wx:if="{{timelineSelection}}" class="timeline-selection" style="left:{{timelineSelection.left}}%;width:{{timelineSelection.width}}%;"></view>
              </view>
              <!-- Start handle (above bar) -->
              <view class="tl-handle-wrap tl-handle-start" style="left:{{startHandleX}}px;" data-handle="start"
                    bindtouchstart="onHandleTouchStart" catchtouchmove="onHandleTouchMove" bindtouchend="onHandleTouchEnd">
                <view class="tl-tag tl-tag-start">{{bookingTimeStart ? bookingTimeStart + '开始' : '开始'}}</view>
                <text class="tl-arrow tl-arrow-down">▼</text>
              </view>
              <!-- End handle (below bar) -->
              <view class="tl-handle-wrap tl-handle-end" style="left:{{endHandleX}}px;" data-handle="end"
                    bindtouchstart="onHandleTouchStart" catchtouchmove="onHandleTouchMove" bindtouchend="onHandleTouchEnd">
                <text class="tl-arrow tl-arrow-up">▲</text>
                <view class="tl-tag tl-tag-end">{{bookingTimeEnd ? bookingTimeEnd + '结束' : '结束'}}</view>
              </view>
            </view>
            <view class="timeline-ticks"><text>0:00</text><text>6:00</text><text>12:00</text><text>18:00</text><text>24:00</text></view>
            <view class="timeline-legend">
              <text class="tl-leg"><view class="tl-dot free"></view>空闲</text>
              <text class="tl-leg"><view class="tl-dot booked"></view>已占</text>
              <text class="tl-leg"><view class="tl-dot activity"></view>活动</text>
            </view>
          </view>

          <!-- ★ Start time ★ -->
          <view class="field">
            <view class="field-label">开始时间 <text class="required">*</text></view>
            <view wx:if="{{timelineBlocks.length}}" class="time-section-new">
              <!-- Custom keyboard display -->
              <view class="time-kb-display-row">
                <view class="time-kb-display-box {{_kbTarget === 'startHour' && _kbVisible ? 'time-kb-display-active' : ''}} ui-motion-chip" data-target="startHour" catchtap="onKbOpen" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{fmt.hour(bookingTimeStart)}}</view>
                <text class="time-kb-display-colon">:</text>
                <view class="time-kb-display-box {{_kbTarget === 'startMin' && _kbVisible ? 'time-kb-display-active' : ''}} ui-motion-chip" data-target="startMin" catchtap="onKbOpen" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{fmt.min(bookingTimeStart)}}</view>
                <text wx:if="{{bookingTimeStart}}" class="time-valid-badge">✓</text>
              </view>
            </view>
            <view wx:else class="field-hint">{{bookingStartDate ? '该日期暂无可选时段' : '请先选择日期'}}</view>
          </view>

          <!-- ★ Quick duration chips ★ -->
          <view wx:if="{{bookingTimeStart && timelineBlocks.length}}" class="field">
            <view class="field-label">快捷时长</view>
            <view class="duration-row">
              <text class="duration-chip {{bookingTimeEnd && item.minutes === _activeDuration ? 'duration-chip-active' : ''}} ui-motion-chip" wx:for="{{durationChips}}" wx:key="label" data-minutes="{{item.minutes}}" catchtap="onDurationTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item.label}}</text>
            </view>
          </view>

          <!-- ★ End time ★ -->
          <view class="field">
            <view class="field-label">结束时间 <text class="required">*</text></view>
            <view wx:if="{{timelineBlocks.length && bookingTimeStart}}" class="time-section-new">
              <view class="time-kb-display-row">
                <view class="time-kb-display-box {{_kbTarget === 'endHour' && _kbVisible ? 'time-kb-display-active' : ''}} ui-motion-chip" data-target="endHour" catchtap="onKbOpen" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{fmt.hour(bookingTimeEnd)}}</view>
                <text class="time-kb-display-colon">:</text>
                <view class="time-kb-display-box {{_kbTarget === 'endMin' && _kbVisible ? 'time-kb-display-active' : ''}} ui-motion-chip" data-target="endMin" catchtap="onKbOpen" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{fmt.min(bookingTimeEnd)}}</view>
                <text wx:if="{{bookingTimeEnd}}" class="time-valid-badge end-badge">✓</text>
              </view>
            </view>
            <view wx:else class="field-hint">{{bookingTimeStart ? '' : '请先选择开始时间'}}</view>
          </view>

          <!-- Description -->
          <view class="field">
            <view class="field-label">备注（选填）</view>
            <textarea class="field-textarea" auto-height maxlength="-1" value="{{bookingDesc}}" data-field="bookingDesc" bindinput="onFieldInput" placeholder="补充说明"/>
          </view>
          <button class="primary-btn ui-motion-button" loading="{{loading}}" catchtap="submitBooking" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">提交借用申请</button>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ═══════════════════ APPROVAL / DETAIL POPUP ═══════════════════ -->
  <view class="popup-mask ui-overlay" wx:if="{{approvalVisible}}" bindtap="closeApproval">
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">{{approvalTarget.title || '借用详情'}}</view>
        <text class="popup-close ui-motion-chip" catchtap="closeApproval" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-scroll--fill" scroll-y>
        <view class="detail-body">
          <!-- Flow progress bar -->
          <view wx:if="{{approvalTarget.approvalTotalSteps > 0}}" class="audit-flow-summary">
            <view class="audit-flow-progress-bar">
              <view class="audit-flow-progress-fill" style="width:{{approvalTarget._approvalPercent}}%;"></view>
            </view>
            <text class="audit-flow-progress-text">{{approvalTarget.approvalCurrentStep}}/{{approvalTarget.approvalTotalSteps}}</text>
          </view>

          <!-- Full flow timeline -->
          <view wx:if="{{approvalTarget._flowTimeline && approvalTarget._flowTimeline.length}}" class="audit-flow">
            <view class="{{node.nodeClass}} {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}} ui-motion-chip" wx:for="{{approvalTarget._flowTimeline}}" wx:key="*this" wx:for-item="node" catchtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
              <view class="flow-left-col">
                <view class="{{node.dotClass}}">{{node.icon}}</view>
                <view class="flow-connector" wx:if="{{!node.isLast}}"></view>
              </view>
              <view class="flow-right-col">
                <view class="flow-info">
                  <view class="flow-info-title">{{node.stepName}}<text class="flow-step-status-tag flow-tag-{{node.state}}" style="margin-left:8rpx;">{{node.label}}</text></view>
                  <view class="flow-info-desc" wx:if="{{node.meta}}">{{node.meta}}</view>
                  <view class="flow-info-desc" wx:if="{{node.comment}}" style="font-style:italic;color:#94a3b8;">{{node.comment}}</view>
                  <view wx:if="{{node.state === 'done' || node.state === 'rejected'}}" class="flow-expand-hint">{{expandedNodeKey === node._key ? '▲ 收起' : '▼ 详情'}}</view>
                </view>
                <view wx:if="{{expandedNodeKey === node._key && (node.state === 'done' || node.state === 'rejected')}}" class="flow-expand-detail">
                  <view wx:if="{{node.approverName}}" class="flow-detail-text"><text class="flow-detail-label">审批人：</text>{{node.approverName}}</view>
                  <view wx:if="{{node.approvedAt}}" class="flow-detail-text"><text class="flow-detail-label">审批时间：</text>{{node.approvedAt}}</view>
                  <view wx:if="{{node.comment}}" class="flow-detail-text flow-detail-comment-text"><text class="flow-detail-label">审批意见：</text>{{node.comment}}</view>
                </view>
              </view>
            </view>
          </view>

          <view class="detail-row"><text class="detail-key">场地</text><text class="detail-val">{{approvalTarget.venueName}}<text wx:if="{{approvalTarget.venueLocation}}"> · {{approvalTarget.venueLocation}}</text></text></view>
          <view class="detail-row"><text class="detail-key">借用人</text><text class="detail-val">{{approvalTarget.userName}}</text></view>
          <view class="detail-row"><text class="detail-key">时间</text><text class="detail-val">{{approvalTarget.timeStart}} — {{approvalTarget.timeEnd}}</text></view>
          <view class="detail-row" wx:if="{{approvalTarget.description}}"><text class="detail-key">说明</text><text class="detail-val">{{approvalTarget.description}}</text></view>
          <view class="detail-row"><text class="detail-key">状态</text><text class="status-tag pending">待审核</text></view>
          <view class="detail-row" wx:if="{{approvalTarget.approvalCurrentStep >= 0}}"><text class="detail-key">当前步骤</text><text class="detail-val">第{{approvalTarget.currentStepIndex + 1}}步 · {{approvalTarget.currentStepName}}</text></view>

          <!-- Approval action area -->
          <view wx:if="{{approvalAction}}" class="approval-action-area">
            <view class="field" style="margin-top:16rpx;">
              <view class="field-label">审批意见（选填）</view>
              <textarea class="field-textarea" auto-height maxlength="-1" value="{{approvalComment}}" bindinput="onApprovalCommentInput" placeholder="{{approvalAction === 'approve' ? '如：同意借用' : '如：时间冲突，请重新选择'}}"/>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="button-row ui-dialog-footer" wx:if="{{approvalAction}}">
        <button class="secondary-btn ui-motion-button" catchtap="closeApproval" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
        <button class="{{approvalAction === 'approve' ? 'primary-btn' : 'danger-btn'}} ui-motion-button" loading="{{approvalSubmitting}}" catchtap="submitApproval" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          {{approvalAction === 'approve' ? '确认通过' : '确认驳回'}}
        </button>
      </view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">WHUSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>

  <!-- ★ Custom time keyboard ★ (page-level fixed bottom) -->
  <view class="time-keyboard ui-motion-chip" wx:if="{{_kbVisible}}" catchtap="noop" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
    <view class="time-kb-display">
      <view class="time-kb-box {{_kbField === 'hour' ? 'time-kb-box-active' : ''}} {{_kbField === 'hour' && _kbSelected ? 'time-kb-box-selected' : ''}} ui-motion-chip" data-field="hour" catchtap="onKbSwitchField" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{_kbHourVal || '--'}}</view>
      <text class="time-kb-colon">:</text>
      <view class="time-kb-box {{_kbField === 'min' ? 'time-kb-box-active' : ''}} {{_kbField === 'min' && _kbSelected ? 'time-kb-box-selected' : ''}} ui-motion-chip" data-field="min" catchtap="onKbSwitchField" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{_kbMinVal || '--'}}</view>
      <view class="time-kb-confirm ui-motion-chip" catchtap="onKbConfirm" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">确认</view>
    </view>
    <view class="time-kb-numpad">
      <view class="time-kb-row">
        <view class="time-kb-key {{_kbGray[1] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="1" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">1</view>
        <view class="time-kb-key {{_kbGray[2] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="2" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">2</view>
        <view class="time-kb-key {{_kbGray[3] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="3" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">3</view>
      </view>
      <view class="time-kb-row">
        <view class="time-kb-key {{_kbGray[4] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="4" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">4</view>
        <view class="time-kb-key {{_kbGray[5] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="5" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">5</view>
        <view class="time-kb-key {{_kbGray[6] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="6" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">6</view>
      </view>
      <view class="time-kb-row">
        <view class="time-kb-key {{_kbGray[7] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="7" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">7</view>
        <view class="time-kb-key {{_kbGray[8] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="8" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">8</view>
        <view class="time-kb-key {{_kbGray[9] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="9" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">9</view>
      </view>
      <view class="time-kb-row">
        <view class="time-kb-key time-kb-key-colon {{_kbGray[':'] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key=":" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">:</view>
        <view class="time-kb-key {{_kbGray[0] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="0" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">0</view>
        <view class="time-kb-key time-kb-key-bs ui-motion-chip" catchtap="onKbBackspace" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">⌫</view>
      </view>
    </view>
  </view>
</view>

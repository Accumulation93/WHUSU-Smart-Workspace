<view class="page">
  <view class="hero">
    <view class="hero-badge">场地</view>
    <view class="hero-title">场地借用</view>
    <view class="hero-subtitle">浏览场地、查看空闲时间并申请借用</view>
  </view>

  <view class="header-nav">
    <text class="header-nav-btn" bindtap="goMyBookings">📋 我的借用</text>
  </view>

  <view class="card">
    <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
    <view class="section-title">可用场地 ({{venues.length}})</view>
    <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
      <view class="audit-empty-state" wx:if="{{!venues.length}}"><view class="audit-empty-icon">🏟️</view><view class="audit-empty-text">暂无可用的场地</view></view>
      <view class="venue-card" wx:for="{{venues}}" wx:key="id">
        <view class="venue-card-avatar">🏟️</view>
        <view class="venue-card-main">
          <view class="venue-card-name">{{item.name}}</view>
          <view class="venue-card-loc" wx:if="{{item.location}}">📍 {{item.location}}</view>
          <text class="venue-card-tag {{item.approvalType === 'direct' ? 'direct' : 'approval'}}">{{item.approvalType === 'direct' ? '直接通过' : '需审核'}}</text>
        </view>
        <view class="venue-card-actions">
          <text class="venue-card-action view" data-id="{{item.id}}" bindtap="openSchedule">📅 安排</text>
          <text class="venue-card-action book" data-id="{{item.id}}" bindtap="openBooking">+ 借用</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ═══ Proportional Timetable Popup ═══ -->
  <view class="popup-mask" wx:if="{{scheduleVisible}}" bindtap="closeSchedule">
    <view class="popup-card timetable-popup" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">📅 {{scheduleVenueName}}</view>
        <text class="popup-close" bindtap="closeSchedule">关闭</text>
      </view>
      <view class="schedule-nav">
        <text class="schedule-nav-btn" bindtap="onTimetablePrevWeek">◀</text>
        <text style="font-size:25rpx;font-weight:700;color:#1e293b;">{{scheduleWeekStart}} 起一周</text>
        <text class="schedule-nav-btn" bindtap="onTimetableNextWeek">▶</text>
      </view>
      <scroll-view scroll-x scroll-y class="timetable-scroll">
        <view class="timetable-body">
          <view class="tt-time-col">
            <view class="tt-time-header">时间</view>
            <view class="tt-time-label" wx:for="{{timetableHours}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="tt-col-scroll">
            <view class="tt-cols-row">
              <view class="tt-col" wx:for="{{timetableColumns}}" wx:key="date" wx:for-item="col" data-date="{{col.date}}" bindtap="onTimetableOpenTap">
                <view class="tt-col-header">{{col.label}}<text style="font-size:17rpx;display:block;font-weight:400;color:#64748b;">{{col.dateDisplay}}</text></view>
                <view class="tt-open-block" wx:for="{{col.openBlocks}}" wx:key="top" wx:for-item="ob"
                      style="top:{{ob.top}}rpx;height:{{ob.height}}rpx;"
                      data-date="{{col.date}}" data-start-min="{{ob.startMin}}" data-end-min="{{ob.endMin}}" data-duration="{{ob.duration}}" data-height="{{ob.height}}" catchtap="onOpenBlockTap"></view>
                <view class="tt-event-block {{eb.status}}" wx:for="{{col.eventBlocks}}" wx:key="top" wx:for-item="eb"
                      style="top:{{eb.top}}rpx;height:{{eb.height}}rpx;"
                      data-block="{{eb}}" catchtap="onTimetableBlockTap">
                  <text class="tt-event-label">{{eb.label}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view style="display:flex;gap:16rpx;padding:12rpx 16rpx;font-size:20rpx;color:#64748b;">
        <view style="display:flex;align-items:center;gap:4rpx;"><view class="tt-legend tt-l-open"></view> 空闲</view>
        <view style="display:flex;align-items:center;gap:4rpx;"><view class="tt-legend tt-l-booked"></view> 已通过</view>
        <view style="display:flex;align-items:center;gap:4rpx;"><view class="tt-legend tt-l-pending"></view> 待审核</view>
        <view style="display:flex;align-items:center;gap:4rpx;"><view class="tt-legend tt-l-activity"></view> 活动</view>
        <view style="display:flex;align-items:center;gap:4rpx;"><view class="tt-legend tt-l-closed"></view> 关闭</view>
      </view>
    </view>
  </view>

  <!-- Booking detail popup -->
  <view class="popup-mask" wx:if="{{bookingDetailVisible}}" bindtap="closeBookingDetail">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header"><view class="popup-title">借用详情</view><text class="popup-close" bindtap="closeBookingDetail">关闭</text></view>
      <view style="padding:20rpx;">
        <view style="font-size:26rpx;font-weight:700;color:#1e293b;margin-bottom:12rpx;">{{bookingDetail.title || '借用'}}</view>
        <view style="font-size:23rpx;color:#64748b;line-height:1.8;">
          <view wx:if="{{bookingDetail.userName}}">借用人：{{bookingDetail.userName}}</view>
          <view wx:if="{{bookingDetail.userDept}}">部门：{{bookingDetail.userDept}}</view>
          <view wx:if="{{bookingDetail.userIdentity}}">身份：{{bookingDetail.userIdentity}}</view>
          <view wx:if="{{bookingDetail.userWorkGroup}}">职能组：{{bookingDetail.userWorkGroup}}</view>
          <view wx:if="{{bookingDetail.timeStart}}">时间：{{bookingDetail.timeStart}} - {{bookingDetail.timeEnd}}</view>
          <view wx:if="{{bookingDetail.status}}">状态：{{bookingDetail.status === 'approved' ? '已通过' : (bookingDetail.status === 'pending' ? '待审核' : bookingDetail.status)}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══ Booking Form ═══ -->
  <view class="popup-mask" wx:if="{{bookingVisible}}" bindtap="closeBooking">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header"><view class="popup-title">借用申请 · {{bookingVenueName}}</view><text class="popup-close" bindtap="closeBooking">关闭</text></view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y>
        <view class="detail-popup-form">
          <view class="field">
            <view class="field-label">借用事由 <text style="color:#ef4444;">*</text></view>
            <input class="field-input" value="{{bookingTitle}}" data-field="bookingTitle" bindinput="onFieldInput" placeholder="选择或输入借用事由"/>
            <view class="purpose-chips" wx:if="{{purposes.length}}">
              <text wx:for="{{purposes}}" wx:key="id"
                    class="purpose-chip {{bookingTitle === item.text ? 'selected' : ''}}"
                    data-text="{{item.text}}" bindtap="onSelectPurpose">{{item.text}}</text>
            </view>
          </view>

          <!-- Start date -->
          <view class="field"><view class="field-label">开始日期</view>
            <picker mode="date" value="{{bookingStartDate}}" bindchange="onStartDateChange">
              <view class="picker-value">{{bookingStartDateDisplay || '请选择日期'}}</view>
            </picker>
          </view>

          <!-- ═══ Horizontal Timeline Axis ═══ -->
          <view wx:if="{{timelineBlocks.length}}" class="timeline-wrap">
            <view class="timeline-bar">
              <view wx:for="{{timelineBlocks}}" wx:key="startMin" wx:if="{{item.width > 0}}"
                    class="timeline-block tl-{{item.status}}"
                    style="left:{{item.left}}%;width:{{item.width}}%;"></view>
            </view>
            <view class="timeline-ticks">
              <text>00:00</text><text>03:00</text><text>06:00</text><text>09:00</text><text>12:00</text><text>15:00</text><text>18:00</text><text>21:00</text><text>24:00</text>
            </view>
            <view class="timeline-legend">
              <view class="tl-leg-item"><view class="tl-dot free"></view>空闲</view>
              <view class="tl-leg-item"><view class="tl-dot booked"></view>已借用</view>
              <view class="tl-leg-item"><view class="tl-dot pending"></view>审核中</view>
              <view class="tl-leg-item"><view class="tl-dot activity"></view>活动</view>
              <view class="tl-leg-item"><view class="tl-dot closed"></view>关闭</view>
            </view>
          </view>

          <!-- Start time: hour + minute pickers -->
          <view class="field">
            <view class="field-label">开始时间</view>
            <view wx:if="{{startHours.length}}" style="display:flex;gap:10rpx;align-items:center;">
              <picker range="{{startHours}}" range-key="label" value="{{startHourIdx}}" bindchange="onStartHourChange">
                <view class="time-picker-val">{{startHours[startHourIdx] ? startHours[startHourIdx].label : '时'}}</view>
              </picker>
              <text style="font-size:28rpx;color:#64748b;">:</text>
              <picker range="{{startMinutes}}" range-key="label" value="{{startMinIdx}}" bindchange="onStartMinChange">
                <view class="time-picker-val">{{startMinutes[startMinIdx] ? startMinutes[startMinIdx].label : '分'}}</view>
              </picker>
              <text wx:if="{{bookingTimeStart}}" style="font-size:26rpx;color:#3b82f6;font-weight:600;min-width:100rpx;">{{bookingTimeStart}}</text>
            </view>
            <view wx:else style="font-size:22rpx;color:#94a3b8;">{{bookingStartDate ? '该日期暂无可选时段' : '请先选择日期'}}</view>
          </view>

          <!-- End date -->
          <view class="field"><view class="field-label">结束日期</view>
            <picker mode="date" value="{{bookingEndDate}}" bindchange="onEndDateChange">
              <view class="picker-value">{{bookingEndDateDisplay || '请选择日期'}}</view>
            </picker>
          </view>

          <!-- End time: hour + minute pickers -->
          <view class="field">
            <view class="field-label">结束时间</view>
            <view wx:if="{{endHours.length}}" style="display:flex;gap:10rpx;align-items:center;">
              <picker range="{{endHours}}" range-key="label" value="{{endHourIdx}}" bindchange="onEndHourChange">
                <view class="time-picker-val">{{endHours[endHourIdx] ? endHours[endHourIdx].label : '时'}}</view>
              </picker>
              <text style="font-size:28rpx;color:#64748b;">:</text>
              <picker range="{{endMinutes}}" range-key="label" value="{{endMinIdx}}" bindchange="onEndMinChange">
                <view class="time-picker-val">{{endMinutes[endMinIdx] ? endMinutes[endMinIdx].label : '分'}}</view>
              </picker>
              <text wx:if="{{bookingTimeEnd}}" style="font-size:26rpx;color:#3b82f6;font-weight:600;min-width:100rpx;">{{bookingTimeEnd}}</text>
            </view>
            <view wx:else style="font-size:22rpx;color:#94a3b8;">{{bookingEndDate ? (bookingEndDate !== bookingStartDate ? '结束日期暂无可选时段' : '请先选择开始时间') : '请先选择结束日期'}}</view>
          </view>

          <view class="field"><view class="field-label">描述（可选）</view><textarea class="field-textarea" auto-height maxlength="-1" value="{{bookingDesc}}" data-field="bookingDesc" bindinput="onFieldInput" placeholder="借用说明"/></view>
          <view class="audit-btn-bar"><button class="primary-btn" loading="{{loading}}" bindtap="submitBooking">提交借用申请</button></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer"><view class="footer-name">REDSU智慧工作台</view><view class="footer-org">武汉大学学生会</view></view>
</view>

@import './venueManage.wxss';

.venue-management-embedded { width: 100%; min-width: 0; }
.nature-choice-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--ui-inline-gap); }
.nature-choice { box-sizing:border-box;min-width:0;min-height:var(--ui-field-control-height);padding:var(--ui-control-padding-y) var(--ui-control-padding-x);border:1rpx solid rgba(191,219,254,.8);border-radius:var(--ui-field-radius);background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(239,246,255,.86));overflow-wrap:break-word; }

@import '../../../../pages/home/home.wxss';

.page { padding-bottom: 40rpx; }

/* ── Venue Card ── */
.venue-list-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx 22rpx; margin-bottom: 14rpx; border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%);
  border: 1rpx solid rgba(226,237,247,0.92);
  box-shadow: 0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.74);
  animation: glassFadeUp 0.38s ease both;
}
.venue-list-item:active { transform: translateY(1rpx) scale(0.992); }

.venue-list-avatar {
  width: 76rpx; height: 76rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 34rpx; flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(59,130,246,0.22);
}

.venue-list-main { flex:1; min-width:0; }
.venue-list-name { color:#0f172a; font-size:28rpx; font-weight:700; line-height:1.4; }
.venue-list-loc { color:#64748b; font-size:21rpx; margin-top:4rpx; }
.venue-list-desc { color:#94a3b8; font-size:20rpx; margin-top:2rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

.venue-list-actions { display:flex; gap:6rpx; flex-shrink:0; }
.venue-action-btn {
  font-size:20rpx; padding:8rpx 16rpx; border-radius:18rpx; font-weight:600;
  background:rgba(241,245,249,0.8); color:#475569; border:1rpx solid rgba(203,213,225,0.5);
}
.venue-action-btn.primary { background:#3b82f6; color:#fff; border-color:#3b82f6; }
.venue-action-btn.danger { background:rgba(254,226,226,0.6); color:#dc2626; border-color:rgba(252,165,165,0.5); }

/* ── Edit Form ── */
.edit-form-card {
  padding: 24rpx; margin-bottom: 16rpx; border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(248,251,255,0.82) 100%);
  border: 1rpx solid rgba(226,237,247,0.88);
  box-shadow: 0 14rpx 28rpx rgba(15,23,42,0.05);
}

/* ── Rules Popup ── */
.rules-tabs {
  display:flex; border-bottom:1rpx solid rgba(226,232,240,0.8); margin:0 0 16rpx;
}
.rules-tab {
  flex:1; text-align:center; padding:16rpx 0; font-size:24rpx; color:#94a3b8;
  border-bottom:3rpx solid transparent; font-weight:500; transition: all 0.2s;
}
.rules-tab.active { color:#3b82f6; border-bottom-color:#3b82f6; font-weight:700; }

.rule-item {
  display:flex; align-items:center; justify-content:space-between;
  padding:18rpx 20rpx; margin-bottom:10rpx; border-radius:18rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(248,251,255,0.76) 100%);
  border:1rpx solid rgba(226,237,247,0.84);
  box-shadow: 0 6rpx 14rpx rgba(15,23,42,0.025);
}
.rule-item-name { font-size:25rpx; color:#1e293b; font-weight:600; }
.rule-item-detail { font-size:21rpx; color:#64748b; margin-top:4rpx; }

/* ── Cycle picker chips ── */
.cycle-chip {
  display:inline-flex; align-items:center; justify-content:center;
  font-size:22rpx; padding:8rpx 16rpx; border-radius:20rpx; margin:4rpx;
  border:1rpx solid #cbd5e1; color:#64748b; background:#fff;
  transition: all 0.15s;
}
.cycle-chip.selected { border-color:#3b82f6; color:#fff; background:#3b82f6; }

.month-chip {
  width:56rpx; height:48rpx; line-height:48rpx; text-align:center;
  font-size:20rpx; border-radius:10rpx; margin:3rpx;
  border:1rpx solid #cbd5e1; color:#64748b; background:#fff;
}
.month-chip.selected { border-color:#3b82f6; color:#fff; background:#3b82f6; }

.year-chip {
  display:inline-flex; align-items:center; gap:4rpx;
  font-size:21rpx; padding:8rpx 16rpx; border-radius:18rpx; margin:3rpx;
  background:#dbeafe; color:#1d4ed8; border:1rpx solid #bfdbfe;
}
.year-chip-remove { color:#ef4444; font-weight:700; margin-left:4rpx; }

.add-range-btn { font-size:22rpx; color:#fff; background:linear-gradient(135deg, #3b82f6 0%, #6366f1 100%); padding:10rpx 22rpx; border-radius:20rpx; font-weight:600; white-space:nowrap; box-shadow:0 4rpx 12rpx rgba(59,130,246,0.18); }

/* ── Header bar with nav ── */
.header-nav {
  display:flex; align-items:center; justify-content:flex-end; gap:12rpx;
  padding:0 0 16rpx;
}
.header-nav-btn {
  font-size:22rpx; padding:10rpx 20rpx; border-radius:20rpx; font-weight:600;
  background:rgba(255,255,255,0.8); color:#3b82f6; border:1rpx solid rgba(59,130,246,0.3);
  box-shadow: 0 4rpx 12rpx rgba(59,130,246,0.08);
}

/* ── Admin Timetable ── */
.schedule-nav { display:flex; align-items:center; justify-content:center; gap:20rpx; padding:8rpx 16rpx 12rpx; }
.schedule-nav-btn { font-size:28rpx; padding:8rpx 18rpx; border-radius:16rpx; font-weight:700; background:rgba(255,255,255,0.85); color:#3b82f6; border:1rpx solid rgba(59,130,246,0.25); }

.timetable-popup { max-height:95vh; width:96vw; }
.timetable-scroll { width:100%; height:1100rpx; }

/* Body: time column + scrollable day columns */
.timetable-body { display:flex; min-width:900rpx; }
.tt-time-col { width:90rpx; min-width:90rpx; flex-shrink:0; }
.tt-time-header { height:58rpx; display:flex; align-items:center; justify-content:center; font-size:20rpx; font-weight:700; color:#475569; background:#f1f5f9; border-bottom:1rpx solid rgba(226,232,240,0.6); box-sizing:border-box; }
.tt-time-label { height:64rpx; display:flex; align-items:center; justify-content:center; font-size:19rpx; color:#64748b; border-bottom:1rpx solid rgba(226,232,240,0.3); background:#f8fafc; box-sizing:border-box; }

/* Scrollable day columns area */
.tt-col-scroll { flex:1; overflow-x:auto; }
.tt-cols-row { display:flex; }
.tt-col { flex:1; min-width:110rpx; position:relative; }
.tt-col-header { height:58rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:21rpx; font-weight:600; color:#475569; background:#f1f5f9; border-right:1rpx solid rgba(226,232,240,0.4); border-bottom:1rpx solid rgba(226,232,240,0.6); position:sticky; top:0; z-index:1; padding:4rpx 0; box-sizing:border-box; }

/* Open blocks (background) */
.tt-open-block { position:absolute; left:4rpx; right:4rpx; background:rgba(219,234,254,0.35); border-radius:8rpx; border:1rpx dashed rgba(147,197,253,0.35); pointer-events:none; }

/* Event blocks (bookings + activities) */
.tt-event-block { position:absolute; left:4rpx; right:4rpx; display:flex; align-items:center; justify-content:center; border-radius:10rpx; overflow:hidden; z-index:2; }
.tt-event-block.booked { background:rgba(254,243,199,0.78); border:1rpx solid rgba(252,211,77,0.5); }
.tt-event-block.pending { background:rgba(254,215,170,0.72); border:1rpx solid rgba(253,186,116,0.45); }
.tt-event-block.activity { background:rgba(252,231,243,0.65); border:1rpx solid rgba(249,168,212,0.45); }

.tt-event-label { font-size:18rpx; color:#475569; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:96rpx; text-align:center; line-height:1.2; }

/* Legend (reuse colors) */
.tt-legend { width:28rpx; height:16rpx; border-radius:4rpx; }
.tt-l-open { background:rgba(219,234,254,0.6); border:1rpx solid #bfdbfe; }
.tt-l-booked { background:rgba(254,243,199,0.8); border:1rpx solid #fcd34d; }
.tt-l-pending { background:rgba(254,215,170,0.7); border:1rpx solid #fdba74; }
.tt-l-activity { background:rgba(252,231,243,0.7); border:1rpx solid #f9a8d4; }
.tt-l-closed { background:rgba(241,245,249,0.6); border:1rpx solid #e2e8f0; }

/* ── Purpose Management ── */
.purpose-item {
  display:flex; align-items:center; justify-content:space-between;
  padding:18rpx 20rpx; margin-bottom:10rpx; border-radius:18rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(248,251,255,0.76) 100%);
  border:1rpx solid rgba(226,237,247,0.84);
  box-shadow: 0 6rpx 14rpx rgba(15,23,42,0.025);
}
.purpose-item-text { font-size:25rpx; color:#1e293b; font-weight:500; flex:1; }
.purpose-chips { display:flex; flex-wrap:wrap; gap:8rpx; margin-top:8rpx; }
.purpose-chip { font-size:22rpx; padding:8rpx 18rpx; border-radius:18rpx; background:#dbeafe; color:#1d4ed8; border:1rpx solid #bfdbfe; font-weight:500; }
.purpose-chip.selected { background:#3b82f6; color:#fff; border-color:#3b82f6; box-shadow:0 4rpx 12rpx rgba(59,130,246,0.2); }

/* ── Time pickers ── */
.time-picker-val {
  min-width:100rpx; height:60rpx; line-height:60rpx; text-align:center;
  font-size:28rpx; font-weight:600; color:#1e293b;
  background:#f1f5f9; border-radius:14rpx; border:1rpx solid #e2e8f0; padding:0 12rpx;
}

/* ── Slot chips ── */
.slot-chip { font-size:22rpx; padding:10rpx 18rpx; border-radius:18rpx; background:#dbeafe; color:#1d4ed8; border:1rpx solid #bfdbfe; font-weight:500; }
.slot-chip.selected { background:#3b82f6; color:#fff; border-color:#3b82f6; box-shadow:0 4rpx 12rpx rgba(59,130,246,0.2); }

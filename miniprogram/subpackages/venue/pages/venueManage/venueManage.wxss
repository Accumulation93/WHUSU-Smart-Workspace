@import '../../../../pages/home/home.wxss';
@import '../../styles/blue-polish.wxss';

.page { padding-bottom: 60rpx; }

/* ═══ Admin dark hero (matches scoring & HR admin) ═══ */
.hero-admin {
  padding: 40rpx 34rpx 36rpx;
  border-radius: 34rpx;
  background:
    linear-gradient(135deg, rgba(15, 23, 42, 0.96) 0%, rgba(30, 41, 59, 0.96) 42%, rgba(37, 99, 235, 0.92) 100%);
  box-shadow:
    0 26rpx 54rpx rgba(15, 23, 42, 0.22),
    0 0 28rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
}

.hero-admin::before {
  top: -130rpx;
  right: -56rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.30) 0%, rgba(96, 165, 250, 0.06) 46%, rgba(96, 165, 250, 0) 72%);
}

.hero-admin::after {
  content: "";
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.16) 0%, rgba(191, 219, 254, 0.34) 52%, rgba(255, 255, 255, 0) 100%);
}

.hero-admin .hero-badge {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.24) 0%, rgba(148, 163, 184, 0.14) 100%);
  border-color: rgba(191, 219, 254, 0.26);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.12);
}

.hero-admin .hero-title {
  font-size: 46rpx;
  letter-spacing: 0.8rpx;
}

.hero-admin .hero-subtitle {
  color: rgba(241, 245, 249, 0.90);
}

.hero-admin-subtitle {
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.55;
  letter-spacing: 0.4rpx;
}

/* ═══ Main tabs (pill-shaped, blue active gradient) ═══ */
.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.tab {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(255, 255, 255, 0.54);
  color: #53687f;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.04);
  transition: transform 0.18s ease, box-shadow 0.22s ease, background 0.22s ease, color 0.22s ease;
}

.tab-active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 16rpx 30rpx rgba(37, 99, 235, 0.18);
}

.tab:active {
  transform: translateY(1rpx) scale(0.985);
}

/* Department tabs inside multi-picker */
.dept-tab-scroll { margin: 0 24rpx 12rpx; }
.dept-tab-scroll-view { width: 100%; white-space: nowrap; }
.dept-tab-row { display: inline-flex; gap: 8rpx; }
.dept-tab {
  display: inline-flex; align-items: center; gap: 4rpx; flex-shrink: 0;
  font-size: 22rpx; padding: 10rpx 18rpx; border-radius: 20rpx; font-weight: 600;
  background: rgba(241, 245, 249, 0.85); color: #475569;
  border: 1rpx solid rgba(203, 213, 225, 0.55);
  transition: all 0.2s;
}
.dept-tab-active {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color: #fff; border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.20);
}
.dept-tab-count { font-size: 20rpx; opacity: 0.85; }

/* ═══ List card (from scoring admin pattern) ═══ */
.list-card {
  margin-top:18rpx; padding:20rpx; border-radius:26rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.72) 0%, rgba(247,250,255,0.62) 100%);
  border:1rpx solid rgba(255,255,255,0.62);
  box-shadow:inset 0 1rpx 0 rgba(255,255,255,0.78), 0 12rpx 26rpx rgba(15,23,42,0.04);
}

/* ═══ Rules tabs ═══ */
.rules-tabs { display:flex; border-bottom:1rpx solid rgba(226,232,240,0.8); margin:0 0 18rpx; }
.rules-tab {
  flex:1; text-align:center; padding:18rpx 0; font-size:26rpx; color:#53687f;
  border-bottom:3rpx solid transparent; font-weight:600; transition:all 0.2s;
}
.rules-tab.active { color:#2563eb; border-bottom-color:#2563eb; font-weight:700; }

/* ═══ Chip section ═══ */
.chip-section { margin-bottom:14rpx; }
.chip-row { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:8rpx; }
.chip-row.small { gap:5rpx; }
.chip {
  font-size:24rpx; padding:10rpx 22rpx; border-radius:20rpx; font-weight:500;
  background:rgba(241,245,249,0.85); color:#475569;
  border:1rpx solid rgba(203,213,225,0.55);
}
.chip.active {
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color:#fff; border-color:transparent;
  box-shadow:0 6rpx 16rpx rgba(37,99,235,0.20);
}
.chip.sm { width:56rpx; height:52rpx; padding:0; display:inline-flex; align-items:center; justify-content:center; font-size:22rpx; border-radius:14rpx; }

/* Year chips */
.year-chip {
  display:inline-flex; align-items:center; gap:6rpx;
  font-size:22rpx; padding:10rpx 18rpx; border-radius:18rpx; margin:3rpx;
  background:#dbeafe; color:#1d4ed8; border:1rpx solid #bfdbfe;
}
.year-chip-remove { color:#ef4444; font-weight:700; margin-left:6rpx; font-size:24rpx; }

/* Yearly range row */
.range-row { display:flex; gap:8rpx; align-items:center; margin-bottom:8rpx; }
.range-label { font-size:24rpx; color:#64748b; min-width:40rpx; }

/* Small picker */
.picker-sm {
  min-width:100rpx; height:64rpx; line-height:64rpx; text-align:center;
  font-size:24rpx; font-weight:600; color:#1e293b;
  background:rgba(255,255,255,0.85); border-radius:14rpx;
  border:1rpx solid rgba(203,213,225,0.65); padding:0 14rpx;
}
.add-range-btn {
  font-size:24rpx; color:#fff;
  background:linear-gradient(135deg, #2563eb 0%, #6366f1 100%);
  padding:12rpx 24rpx; border-radius:22rpx; font-weight:600;
  white-space:nowrap; box-shadow:0 6rpx 14rpx rgba(37,99,235,0.20);
}

/* ═══ Form ═══ */
.form-body { padding:4rpx 8rpx 20rpx; }

/* ═══ Picker display ═══ */
.picker-display {
  width:100%; padding:24rpx 20rpx; border-radius:18rpx;
  background:rgba(255,255,255,0.72); border:1rpx solid rgba(203,213,225,0.75);
  font-size:28rpx; color:#1e293b; box-sizing:border-box;
}

/* ═══ Time picker ═══ */
.time-picker-row { display:flex; gap:12rpx; align-items:center; }
.time-val {
  min-width:100rpx; height:68rpx; line-height:68rpx; text-align:center;
  font-size:30rpx; font-weight:700; color:#1e293b;
  background:linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(247,250,255,0.84) 100%);
  border-radius:16rpx; border:1rpx solid rgba(203,213,225,0.68); padding:0 14rpx;
}
.time-sep { font-size:30rpx; color:#64748b; font-weight:500; }
.time-result { font-size:28rpx; color:#2563eb; font-weight:700; min-width:100rpx; }

/* ═══ Input row ═══ */
.input-row { display:flex; gap:12rpx; align-items:center; }
.input-row .field-input { flex:1; min-width:0; }

/* ═══ Rule/venue add buttons with margin ═══ */
.primary-btn.rule-add-btn { margin-bottom: 12rpx; }
.secondary-btn.venue-add-btn { margin-bottom: 16rpx; }

/* ═══ Actions-aligned-to-right ═══ */
.list-actions-below { justify-content: flex-end; }

/* ═══ Purpose save button (matches .link sizing, blue fill) ═══ */
.purpose-save-btn {
  display:inline-flex; align-items:center; justify-content:center;
  padding:10rpx 20rpx; border-radius:999rpx;
  font-size:24rpx; font-weight:600; line-height:1;
  background:linear-gradient(135deg, #2563eb, #3b82f6, #60a5fa);
  color:#fff; flex-shrink:0; flex-grow:0;
  box-shadow:0 4rpx 10rpx rgba(37,99,235,0.16);
  margin:0; border:none;
}
.purpose-save-btn::after { border:none; }

/* ═══ Detail popup ═══ */
.detail-body { padding:8rpx 8rpx 20rpx; }
.detail-title { font-size:30rpx; font-weight:700; color:#0f172a; margin-bottom:20rpx; }
.detail-row { display:flex; align-items:center; font-size:26rpx; color:#334155; line-height:2.2; }
.detail-key { width:120rpx; color:#94a3b8; flex-shrink:0; }
.detail-val { color:#1e293b; }

/* Status tag */
.status-tag {
  font-size:22rpx; padding:6rpx 16rpx; border-radius:999rpx; font-weight:600;
}
.status-tag.pending { background:#fef3c7; color:#92400e; }
.status-tag.approved { background:#d1fae5; color:#065f46; }
.status-tag.rejected { background:#fee2e2; color:#991b1b; }
.status-tag.cancelled { background:#f1f5f9; color:#64748b; }

/* ═══ Timetable ═══ */
.schedule-nav { display:flex; align-items:center; justify-content:center; gap:28rpx; padding:8rpx 16rpx 16rpx; }
.nav-arrow {
  font-size:38rpx; padding:6rpx 22rpx; border-radius:16rpx; font-weight:300; color:#2563eb;
  background:rgba(255,255,255,0.85); border:1rpx solid rgba(59,130,246,0.20);
}
.nav-label { font-size:26rpx; font-weight:700; color:#1e293b; }

.timetable-popup { max-height:95vh; width:96vw; }
.timetable-scroll { width:100%; height:1100rpx; }
.timetable-body { display:flex; }

.tt-time-col { width:64rpx; min-width:64rpx; flex-shrink:0; }
.tt-time-header {
  height:58rpx; display:flex; align-items:center; justify-content:center;
  font-size:20rpx; font-weight:700; color:#475569; background:#f1f5f9;
  border-bottom:1rpx solid rgba(226,232,240,0.6); box-sizing:border-box;
}
.tt-time-label {
  height:64rpx; display:flex; align-items:center; justify-content:center;
  font-size:19rpx; color:#64748b; border-bottom:1rpx solid rgba(226,232,240,0.3);
  background:#f8fafc; box-sizing:border-box;
}

.tt-col-scroll { flex:1; overflow-x:visible; }
.tt-cols-row { display:flex; }
.tt-col { flex:1; min-width:0; position:relative; }
.tt-col-header {
  height:58rpx; display:flex; flex-direction:column; align-items:center; justify-content:center;
  font-size:22rpx; font-weight:600; color:#475569; background:#f1f5f9;
  border-right:1rpx solid rgba(226,232,240,0.4); border-bottom:1rpx solid rgba(226,232,240,0.6);
  position:sticky; top:0; z-index:1; padding:2rpx 0; box-sizing:border-box;
}
.tt-col-sub { font-size:18rpx; font-weight:400; color:#64748b; display:block; }

.tt-open-block {
  position:absolute; left:2rpx; right:2rpx; background:rgba(219,234,254,0.38);
  border-radius:6rpx; border:1rpx dashed rgba(147,197,253,0.40);
}
.tt-time-target { position:absolute; left:0; right:0; z-index:1; opacity:0; }

.tt-event-block {
  position:absolute; left:3rpx; right:3rpx; display:flex; align-items:center; justify-content:center;
  border-radius:7rpx; overflow:hidden; z-index:2;
}
.tt-event-block.booked { background:rgba(254,243,199,0.78); border:1rpx solid rgba(252,211,77,0.50); }
.tt-event-block.pending { background:rgba(254,215,170,0.72); border:1rpx solid rgba(253,186,116,0.45); }
.tt-event-block.activity { background:rgba(252,231,243,0.65); border:1rpx solid rgba(249,168,212,0.45); }
.tt-event-label {
  font-size:18rpx; color:#475569; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  max-width:90rpx; text-align:center; line-height:1.1;
}

.tt-legend { display:flex; gap:16rpx; padding:12rpx 18rpx; font-size:20rpx; color:#64748b; flex-wrap:wrap; }
.tt-leg-item { display:flex; align-items:center; gap:6rpx; }
.tt-dot { width:22rpx; height:22rpx; border-radius:6rpx; flex-shrink:0; }
.tt-dot.open { background:#bfdbfe; border:1rpx solid #93c5fd; }
.tt-dot.booked { background:#fef3c7; border:1rpx solid #fcd34d; }
.tt-dot.pending { background:#fed7aa; border:1rpx solid #fdba74; }
.tt-dot.activity { background:#fce7f3; border:1rpx solid #f9a8d4; }
.tt-dot.closed { background:#e2e8f0; border:1rpx solid #cbd5e1; }

/* ═══ Misc ═══ */
.required { color:#ef4444; }

/* ═══ Approval Flow ═══ */
.flow-info-bar {
  display:flex; justify-content:space-between; align-items:center;
  padding:12rpx 18rpx; margin-bottom:12rpx; border-radius:16rpx;
  background:rgba(219,234,254,0.42); border:1rpx solid rgba(147,197,253,0.3);
}
.flow-info-text { font-size:26rpx; font-weight:600; color:#2563eb; }

.flow-step-card {
  padding:16rpx 18rpx; margin-bottom:12rpx; border-radius:16rpx;
  background:rgba(255,255,255,0.84); border:1rpx solid rgba(226,237,247,0.8);
}
.flow-step-head { display:flex; align-items:center; gap:12rpx; margin-bottom:8rpx; }
.flow-step-badge {
  font-size:22rpx; font-weight:700; color:#fff;
  background:linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  padding:4rpx 14rpx; border-radius:12rpx;
}
.flow-step-name { font-size:26rpx; font-weight:600; color:#0f172a; flex:1; }
.flow-step-actions { display:flex; gap:8rpx; }
.flow-step-rules-summary { padding-left:4rpx; }
.flow-rule-tag {
  display:block; font-size:22rpx; color:#64748b; padding:4rpx 0;
  padding-left:14rpx; border-left:3rpx solid rgba(59,130,246,0.3); margin-bottom:4rpx;
}

.flow-rule-card {
  display:flex; justify-content:space-between; align-items:center;
  padding:10rpx 14rpx; margin-bottom:8rpx; border-radius:12rpx;
  background:rgba(241,245,249,0.8); border:1rpx solid rgba(203,213,225,0.4);
}
.flow-rule-summary { font-size:22rpx; color:#475569; flex:1; }

.rule-edit-box {
  margin-top:16rpx; padding:16rpx; border-radius:16rpx;
  background:rgba(255,255,255,0.84); border:1rpx solid rgba(226,237,247,0.8);
}

.rule-add-btn { margin-top:6rpx; margin-bottom:6rpx; }
.section-title-sm { font-size:26rpx; font-weight:700; color:#334155; margin-bottom:10rpx; }
.field-hint-sm { font-size:22rpx; color:#94a3b8; font-weight:400; }

.button-row { display:flex; gap:12rpx; margin-top:16rpx; }
.button-row button { flex:1; }

.link.sm { font-size:22rpx; padding:4rpx 12rpx; }

.rule-save-bar { padding:16rpx 8rpx 8rpx; }

.flow-divider {
  height:1rpx; margin:20rpx 0 16rpx;
  background:linear-gradient(90deg, transparent, rgba(148,163,184,0.25), transparent);
}

/* Multi-chip box (legacy, kept for compatibility) */
.multi-chip-box {
  margin:6rpx 0 10rpx; padding:10rpx; border-radius:14rpx;
  background:rgba(248,250,252,0.7); border:1rpx solid rgba(203,213,225,0.35);
}
.multi-chip-scroll { max-height:240rpx; }
.selected-hint { font-size:22rpx; color:#2563eb; font-weight:600; margin-top:6rpx; text-align:right; }

/* Compact button row */
.compact-row { gap: 10rpx; }
.compact-row .secondary-btn,
.compact-row .primary-btn { padding: 12rpx 16rpx; font-size: 22rpx; min-height: 60rpx; }

/* ═══ Bookings tab — filter section ═══ */
.filter-section { margin-bottom:14rpx; }
.filter-label { font-size:22rpx; font-weight:500; color:#94a3b8; margin-bottom:6rpx; }

/* Horizontal scroll filter row */
.filter-scroll { width:100%; white-space:nowrap; }
.filter-row { display:inline-flex; gap:8rpx; }
.filter-chip {
  display:inline-flex; align-items:center; flex-shrink:0;
  font-size:22rpx; padding:8rpx 18rpx; border-radius:18rpx; font-weight:500;
  background:rgba(241,245,249,0.7); color:#64748b;
  border:1rpx solid rgba(203,213,225,0.35);
  transition:all 0.2s;
}
.filter-chip.active {
  background:linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  color:#fff; border-color:transparent;
  box-shadow:0 6rpx 14rpx rgba(37,99,235,0.16);
}

/* Time filter */
.time-filter-row { display:flex; gap:8rpx; align-items:center; }
.time-pick {
  padding:10rpx 18rpx; border-radius:14rpx; font-size:22rpx; font-weight:500; color:#475569;
  background:rgba(241,245,249,0.7); border:1rpx solid rgba(203,213,225,0.35);
}
.time-to { font-size:22rpx; color:#94a3b8; }
.filter-clear { font-size:20rpx; color:#ef4444; font-weight:500; padding:6rpx 12rpx; }

/* ═══ Booking item ═══ */
.booking-item {
  padding:24rpx; margin-bottom:14rpx; border-radius:24rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 12rpx 28rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.74);
  animation:glassFadeUp 0.38s ease both;
}
.booking-item:active { transform:translateY(1rpx) scale(0.992); }

.booking-item-head { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10rpx; }
.booking-item-title { font-size:28rpx; font-weight:700; color:#0f172a; }
.booking-item-meta { font-size:24rpx; color:#64748b; line-height:1.7; }

.booking-status {
  font-size:22rpx; font-weight:700; padding:6rpx 16rpx; border-radius:16rpx; white-space:nowrap;
}
.booking-status.pending { background:#fef3c7; color:#92400e; }
.booking-status.approved { background:#d1fae5; color:#065f46; }
.booking-status.rejected { background:#fee2e2; color:#991b1b; }
.booking-status.cancelled { background:#f1f5f9; color:#94a3b8; }
.booking-status.inUse { background:#dbeafe; color:#1e40af; }
.booking-status.completed { background:#e0e7ff; color:#3730a3; }

.booking-actions { display:flex; gap:10rpx; margin-top:14rpx; }
.booking-actions .approve-btn {
  flex:1; padding:14rpx; border-radius:18rpx; text-align:center; font-size:24rpx; font-weight:700;
  background:linear-gradient(135deg, #10b981 0%, #34d399 100%); color:#fff;
  border:none; box-shadow:0 8rpx 18rpx rgba(16,185,129,0.20);
}
.booking-actions .reject-btn {
  flex:1; padding:14rpx; border-radius:18rpx; text-align:center; font-size:24rpx; font-weight:700;
  background:linear-gradient(135deg, rgba(254,226,226,0.92) 0%, rgba(252,165,165,0.72) 100%);
  color:#dc2626; border:1rpx solid rgba(252,165,165,0.5);
  box-shadow:0 6rpx 14rpx rgba(239,68,68,0.08);
}

/* ═══ Final venue workbench polish: align with scoring/admin glass UI ═══ */
.page {
  padding: 30rpx 24rpx 46rpx;
}

.hero-admin {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.98) 0%, rgba(59, 130, 246, 0.95) 42%, rgba(96, 165, 250, 0.90) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 24rpx 54rpx rgba(37, 99, 235, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.hero-admin::before {
  content: "";
  position: absolute;
  top: -90rpx;
  right: -35rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.hero-admin::after {
  content: "";
  position: absolute;
  left: -90rpx;
  bottom: -120rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-admin .hero-badge,
.hero-admin .hero-title,
.hero-admin .hero-subtitle {
  position: relative;
  z-index: 1;
}

.hero-admin .hero-badge {
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.22), rgba(255,255,255,0.14));
  border: 1rpx solid rgba(255,255,255,0.28);
  box-shadow: none;
}

.hero-admin .hero-title {
  font-size: 46rpx;
  line-height: 1.24;
  letter-spacing: 0.4rpx;
}

.hero-admin .hero-subtitle,
.hero-admin-subtitle {
  margin-top: 12rpx;
  color: rgba(255,255,255,0.92);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.66;
  letter-spacing: 0;
}

.tabs {
  display: flex;
  gap: 10rpx;
  margin: 0 0 18rpx;
  padding: 8rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(248,251,255,0.56));
  border: 1rpx solid rgba(255,255,255,0.62);
  box-shadow: 0 14rpx 28rpx rgba(15,23,42,0.045), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing: border-box;
}

.tab {
  flex: 1;
  min-width: 0;
  height: 70rpx;

@import '../../../../pages/home/home.wxss';

.page { padding-bottom: 40rpx; }
.card { margin: 16rpx 24rpx; }

.venue-card { display:flex; align-items:center; justify-content:space-between; padding:20rpx; margin-bottom:12rpx; border:1rpx solid #e2e8f0; border-radius:14rpx; background:#fff; }
.venue-info { flex:1; }
.venue-name { font-size:27rpx; font-weight:700; color:#1e293b; }
.venue-loc { font-size:22rpx; color:#64748b; margin-top:4rpx; }
.venue-actions { display:flex; gap:8rpx; }

.rules-tabs { display:flex; border-bottom:1rpx solid #e2e8f0; margin-bottom:12rpx; }
.rules-tab { flex:1; text-align:center; padding:14rpx 0; font-size:24rpx; color:#64748b; border-bottom:3rpx solid transparent; }
.rules-tab.active { color:#3b82f6; border-bottom-color:#3b82f6; font-weight:600; }

.rule-item { display:flex; align-items:center; justify-content:space-between; padding:14rpx 16rpx; margin-bottom:8rpx; border:1rpx solid #e2e8f0; border-radius:12rpx; background:#f8fafc; }
.rule-item-name { font-size:24rpx; color:#334155; font-weight:600; }
.rule-item-detail { font-size:21rpx; color:#64748b; margin-top:2rpx; }

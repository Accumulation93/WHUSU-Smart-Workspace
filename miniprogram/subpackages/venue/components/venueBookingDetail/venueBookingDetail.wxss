@import '../../../main/styles/home.wxss';
@import '../../styles/blue-polish.wxss';

.venue-booking-detail { min-width: 0; }
.detail-title { margin-bottom: 16rpx; color: #0f172a; font-size: var(--ui-type-section); font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
.detail-row { display: flex; align-items: flex-start; gap: 14rpx; padding: 9rpx 0; color: #334155; font-size: var(--ui-type-emphasis); line-height: 1.62; }
.detail-key { width: 120rpx; flex-shrink: 0; color: #94a3b8; line-height: 1.62; }
.detail-val { flex: 1; min-width: 0; color: #1e293b; line-height: 1.62; white-space: pre-wrap; overflow-wrap: anywhere; }
.audit-flow-summary--spaced { margin-top: 8rpx; }
.audit-flow--spaced { margin-top: 6rpx; }

/* 场地详情与审批详情共用主包流程卡；仅保留场地组件的窄屏间距覆盖。 */
.flow-info-comment { color: #94a3b8; font-style: italic; }
.flow-detail-comment { margin-top: 6rpx; }
.flow-detail-processed-meta { margin-top: 2rpx; }

/* 展开态与审核子应用 submissionDetail 的最终玻璃层保持同一组参数。 */
.flow-node-expanded .flow-info {
  background: linear-gradient(135deg, rgba(255,255,255,0.72) 0%, rgba(248,250,252,0.64) 100%);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(203,213,225,0.35);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(15,23,42,0.06), inset 0 1rpx 0 rgba(255,255,255,0.6);
  transition: background 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94), border-color 0.28s ease, box-shadow 0.32s ease, transform 0.24s ease;
}

.flow-expand-hint {
  font-size: var(--ui-type-micro);
  color: #94a3b8;
  margin-top: 2rpx;
}

.flow-expand-detail {
  margin-top: 8rpx;
  padding: 10rpx 12rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.90), rgba(248,251,255,0.78)) !important;
  border: 1rpx solid rgba(226,237,247,0.90) !important;
  border-radius: 20rpx !important;
  box-shadow:
    0 10rpx 22rpx rgba(15,23,42,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.78) !important;
}

.flow-detail-processed-text,
.flow-detail-processed-meta,
.flow-detail-comment {
  font-size: var(--ui-type-caption);
  line-height: 1.6;
}

.flow-detail-processed-text,
.flow-detail-comment { color: #475569; }
.flow-detail-processed-meta { color: #94a3b8; }
.flow-detail-label { color: #64748b; font-weight: 600; }

@media (min-width: 520px) {
  .detail-row { padding: 8px 0; }
  .audit-flow-summary--spaced { margin-top: 6px; }
  .audit-flow--spaced { margin-top: 4px; }
}

<view class="venue-booking-detail">
  <view class="detail-title">{{booking.title || localeCopy.copy_56feddb4d3}}</view>
  <view class="detail-row" wx:if="{{booking.venueName}}"><text class="detail-key">{{localeCopy.copy_bbbebc1abf}}</text><text class="detail-val">{{booking.venueName}}</text></view>
  <view class="detail-row" wx:if="{{booking.orgName}}"><text class="detail-key">{{localeCopy.copy_34e2d1f8a0}}</text><text class="detail-val">{{booking.orgName}}</text></view>
  <view class="detail-row" wx:if="{{booking.userName}}"><text class="detail-key">{{localeCopy.copy_ce30bda5a2}}</text><text class="detail-val">{{booking.userName}}</text></view>
  <view class="detail-row" wx:if="{{booking._creatorAssignmentText}}"><text class="detail-key">{{localeCopy.applicantAssignment}}</text><text class="detail-val"><text class="assignment-chip">{{booking._creatorAssignmentText}}</text></text></view>
  <view class="detail-row" wx:if="{{booking.userDept}}"><text class="detail-key">{{localeCopy.copy_02419589be}}</text><text class="detail-val">{{booking.userDept}}</text></view>
  <view class="detail-row" wx:if="{{booking.userIdentity}}"><text class="detail-key">{{localeCopy.copy_c1965e0690}}</text><text class="detail-val">{{booking.userIdentity}}</text></view>
  <view class="detail-row" wx:if="{{booking.userWorkGroup}}"><text class="detail-key">{{localeCopy.copy_303b7a8611}}</text><text class="detail-val">{{booking.userWorkGroup}}</text></view>
  <view class="detail-row" wx:if="{{booking.timeStartText}}"><text class="detail-key">{{localeCopy.copy_4202a27ca6}}</text><text class="detail-val">{{booking.timeStartText}} {{localeCopy.copy_e8d9493a44}} {{booking.timeEndText}}</text></view>
  <view class="detail-row" wx:if="{{booking.description}}"><text class="detail-key">{{localeCopy.copy_c5d9511809}}</text><text class="detail-val">{{booking.description}}</text></view>
  <view class="detail-row" wx:if="{{booking.approvalComment}}"><text class="detail-key">{{localeCopy.copy_41c20cc066}}</text><text class="detail-val">{{booking.approvalComment}}</text></view>
  <view class="detail-row"><text class="detail-key">{{localeCopy.copy_8aee737e64}}</text><text class="status-tag {{booking.displayStatus || booking.status}}">{{booking._statusLabel}}</text></view>

  <view wx:if="{{booking.approvalProgress}}" class="audit-flow-summary audit-flow-summary--spaced">
    <view class="audit-flow-progress-bar"><view class="audit-flow-progress-fill" style="width:{{booking._approvalPercent}}%;{{booking._approvalBarColor || ''}}"></view></view>
    <text class="audit-flow-progress-text">{{booking._approvalProgressText}}</text>
  </view>

  <view wx:if="{{booking._flowTimeline && booking._flowTimeline.length}}" class="audit-flow audit-flow--spaced">
    <view class="{{node.nodeClass}} {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}} ui-motion-chip" wx:for="{{booking._flowTimeline}}" wx:key="_key" wx:for-item="node" catchtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
      <view class="flow-left-col">
        <view class="{{node.dotClass}}">{{node.icon}}</view>
        <view class="flow-connector" wx:if="{{!node.isLast}}"></view>
      </view>
      <view class="flow-info {{expandedNodeKey === node._key ? 'flow-info-expanded' : ''}}">
        <view class="flow-step-label">{{node.stepName}}</view>
        <view class="flow-step-status-tag flow-tag-{{node.state}}">{{node.label}}</view>
        <view class="flow-step-meta" wx:if="{{node.meta}}">{{node.meta}}</view>
        <view wx:if="{{node.state === 'done' || node.state === 'rejected'}}" class="flow-expand-hint">{{expandedNodeKey === node._key ? localeCopy.copy_4edcf754ff : localeCopy.copy_baec508307}}</view>
        <view wx:if="{{expandedNodeKey === node._key && (node.state === 'done' || node.state === 'rejected')}}" class="flow-expand-detail">
          <view wx:if="{{node.approverName}}" class="flow-detail-processed-text"><text class="flow-detail-label">{{localeCopy.copy_866290fa02}}</text>{{node.approverName}}</view>
          <view wx:if="{{node.approverAssignmentText}}" class="flow-detail-assignment"><text class="flow-detail-label">{{localeCopy.approverAssignment}}</text><text class="assignment-chip assignment-chip--compact">{{node.approverAssignmentText}}</text></view>
          <view wx:if="{{node.approvedAtText}}" class="flow-detail-processed-meta">{{localeCopy.copy_dcadcebf08}}{{node.approvedAtText}}</view>
          <view wx:if="{{node.comment}}" class="flow-detail-comment"><text class="flow-detail-label">{{localeCopy.copy_3b3b392755}}</text>{{node.comment}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

.activity-detail { display: flex; flex-direction: column; gap: var(--ui-dialog-section-gap,18rpx); }
.activity-summary { padding: 22rpx; border-radius: var(--ui-card-radius); background: linear-gradient(135deg,rgba(219,234,254,.75),rgba(255,255,255,.92)); border: 1px solid rgba(147,197,253,.4); box-shadow: 0 8px 18px rgba(37,99,235,.04),inset 0 1px 0 rgba(255,255,255,.8); backdrop-filter: blur(12px); }
.activity-heading { display: flex; align-items: flex-start; gap: 14rpx; }
.activity-name { flex: 1; min-width: 0; font-size: var(--ui-dialog-title-size); font-weight: 750; color: #0f172a; line-height: 1.5; overflow-wrap: anywhere; }
.activity-venue { display: inline-flex; max-width: 100%; margin-top: 14rpx; padding: 6rpx 12rpx; border-radius: var(--ui-compact-radius); background: rgba(224,242,254,.76); border: 1px solid rgba(56,189,248,.35); font-size: var(--ui-dialog-meta-size); color: #0369a1; line-height: 1.6; box-sizing: border-box; overflow-wrap: anywhere; }
.activity-section { padding: 18rpx 20rpx; border-radius: var(--ui-field-radius); background: linear-gradient(135deg,rgba(255,255,255,.96),rgba(248,251,255,.82)); border: 1px solid rgba(226,237,247,.9); box-shadow: inset 0 1px 0 rgba(255,255,255,.8); backdrop-filter: blur(12px); }
.activity-label { display: flex; align-items: center; gap: 10rpx; color: #64748b; font-size: var(--ui-dialog-label-size); line-height: 1.6; }
.activity-time, .activity-value { margin-top: 10rpx; color: #1e293b; font-size: var(--ui-dialog-body-size); line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
.activity-time { font-weight: 700; }
.activity-note { font-size: var(--ui-dialog-meta-size); color: #64748b; line-height: 1.6; overflow-wrap: anywhere; }
@media (min-width: 520px) { .activity-detail { gap: 14px; } .activity-summary { padding: 18px; } .activity-heading { gap: 12px; } .activity-venue { margin-top: 10px; padding: 4px 10px; } .activity-section { padding: 14px 16px; } .activity-label { gap: 8px; } .activity-time, .activity-value { margin-top: 8px; } }
@media (min-width: 900px) { .activity-detail { gap: 12px; } .activity-summary { padding: 16px; } .activity-section { padding: 12px 14px; } }

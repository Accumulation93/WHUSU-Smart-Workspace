<view wx:if="{{sourceId}}" class="calendar-participants">
    <view class="calendar-participants-head">
      <view class="calendar-participants-title">{{result ? result.participantsTitle : copy.participants}}</view>
      <button wx:if="{{result.participants.length}}" class="secondary-btn ui-motion-button calendar-participants-action" bindtap="toggleParticipants" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{expanded ? copy.participantsCollapse : copy.participantsExpand}}</button>
    </view>
  <view wx:if="{{result.canEdit}}" class="card-actions"><button class="secondary-btn ui-motion-button calendar-participants-action" bindtap="edit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.editParticipants}}</button></view>
  <app-loading wx:if="{{loading}}" text="{{copy.participantsLoading}}" />
  <view wx:if="{{notice}}" class="calendar-participants-head"><text class="calendar-participant-position">{{notice}}</text><button wx:if="{{failed}}" class="secondary-btn ui-motion-button calendar-participants-action" bindtap="load" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.retry}}</button></view>
  <block wx:if="{{result}}">
    <view wx:if="{{!result.participants.length}}" class="calendar-participant-position">{{copy.noParticipants}}</view>
    <readonly-person-table wx:if="{{expanded}}" people="{{result.participants}}" empty-text="{{copy.noParticipants}}" />
  </block>
</view>

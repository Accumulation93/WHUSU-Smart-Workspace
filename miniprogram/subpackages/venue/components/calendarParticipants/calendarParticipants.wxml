<app-loading wx:if="{{loading}}" text="{{copy.loading}}" /><view wx:if="{{failed}}" class="section-control-card"><view>{{copy.operationFailed}}</view><button class="secondary-btn ui-motion-button" bindtap="load" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.retry}}</button></view>
<view wx:if="{{result}}" class="section-control-card calendar-participants"><view class="section-title">{{copy.participants}} · {{result.participants.length}}</view><view wx:for="{{result.participants}}" wx:key="index" class="calendar-participant"><view><person-link name="{{item.name}}" reference="{{item.personReference}}" /></view><view class="calendar-participant-position">{{item.positions || copy.noPosition}}</view></view><view wx:if="{{result.canEdit}}" class="card-actions"><button class="secondary-btn ui-motion-button" bindtap="edit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.participants}}</button></view></view>

<view wx:if="{{sourceId}}" class="calendar-participants">
    <view class="calendar-participants-head">
      <view class="calendar-participants-title">{{copy.participants}}<text wx:if="{{result}}" class="calendar-participants-count">{{result.participants.length}}</text></view>
    </view>
  <view wx:if="{{result}}" class="card-actions"><button wx:if="{{result.participants.length}}" class="secondary-btn ui-motion-button calendar-participants-action" bindtap="toggleParticipants" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{expanded ? copy.participantsCollapse : copy.participantsExpand}}</button><button wx:if="{{result.canEdit}}" class="secondary-btn ui-motion-button calendar-participants-action" bindtap="edit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.editParticipants}}</button></view>
  <app-loading wx:if="{{loading}}" text="{{copy.participantsLoading}}" />
  <view wx:if="{{notice}}" class="calendar-participants-head"><text class="calendar-participant-position">{{notice}}</text><button wx:if="{{failed}}" class="secondary-btn ui-motion-button calendar-participants-action" bindtap="load" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.retry}}</button></view>
  <block wx:if="{{result}}">
    <view wx:if="{{!result.participants.length}}" class="calendar-participant-position">{{copy.noParticipants}}</view>
    <view wx:if="{{expanded}}" class="calendar-participants-grid">
      <view wx:for="{{result.participants}}" wx:key="index" class="calendar-participant"><view class="calendar-participant-name"><person-link name="{{item.name}}" reference="{{item.personReference}}" /></view><view class="calendar-participant-position">{{item.positions || copy.noPosition}}</view></view>
    </view>
  </block>
</view>

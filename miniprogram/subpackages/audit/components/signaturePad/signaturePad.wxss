:host { display: block; height: 100%; min-height: 0; }
.sigpad-wrap { --ui-signing-tool-height: 36px; --ui-signing-tool-gap: 4px; position: relative; display: flex; height: 100%; min-height: 0; flex-direction: column; gap: var(--ui-signing-tool-gap); }
.sigpad-toolbar { display: flex; flex: none; gap: var(--ui-signing-tool-gap); }
.sigpad-toolbar .primary-btn, .sigpad-toolbar .secondary-btn { display: flex; flex: 1 1 0; align-items: center; justify-content: center; text-align: center; margin: 0; height: auto; width: auto; max-width: 100%; min-width: 0; min-height: var(--ui-signing-tool-height); padding: var(--ui-signing-tool-gap); font-size: var(--ui-type-meta); line-height: var(--ui-line-control); border-radius: var(--ui-compact-radius); box-sizing: border-box; }
.sigpad-palette { display: flex; align-items: center; }
.sigpad-palette .sigpad-color { flex: 0 0 var(--ui-signing-tool-height); width: var(--ui-signing-tool-height); }
.sigpad-swatch { width: 14px; height: 14px; border-radius: var(--ui-compact-radius); }
.sigpad-black { background: #000000; }.sigpad-blue { background: #0000ff; }.sigpad-red { background: #ff0000; }
.sigpad-palette .sigpad-selected { border-color: #2563eb; background: linear-gradient(135deg,#dbeafe,#eff6ff); }
.sigpad-width { flex: 1; min-width: 0; }
.sigpad-width .picker-display { min-height: var(--ui-signing-tool-height); padding: var(--ui-signing-tool-gap); display: flex; align-items: center; justify-content: center; font-size: var(--ui-type-meta); }
.sigpad-surface { display: block; flex: 1 0 120px; min-height: 120px; width: 100%; height: auto; border-radius: var(--ui-field-radius); background: linear-gradient(135deg, #ffffff, #f8fbff); }
.sigpad-export-canvas { position: absolute; left: 0; top: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.sigpad-colors { display: grid; grid-template-columns: auto minmax(0,1fr); flex: none; align-items: center; gap: var(--ui-signing-tool-gap); }
.sigpad-colors .sigpad-channel { height: 48px; margin: 0 12px; padding: 12px 0; box-sizing: border-box; }
.sigpad-notice { font-size: var(--ui-type-body); line-height: 1.6; color: #64748b; }
@media (min-width: 520px) { .sigpad-wrap { --ui-signing-tool-height: 40px; } }

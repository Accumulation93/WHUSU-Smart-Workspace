.sigpad-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx 8rpx;
}

/* ★ 边框 wrapper：将视觉边框从 canvas 分离，
     确保 canvas 的 boundingClientRect 与绘制区域严格对齐 */
.sigpad-canvas-border {
  width: 100%;
  border: 2rpx solid rgba(203,213,225,0.7);
  border-radius: 20rpx;
  box-shadow:
    inset 0 2rpx 8rpx rgba(15,23,42,0.04),
    0 4rpx 16rpx rgba(15,23,42,0.04);
  box-sizing: border-box;
}

.sigpad-canvas {
  display: block;
  width: 100%;
  height: 360rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.sigpad-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  width: 100%;
}

.sigpad-btn {
  flex: 1;
  min-height: 76rpx;
  line-height: 76rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 22rpx;
  letter-spacing: 0.3rpx;
}

/* Primary action */
.sigpad-btn-primary {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 45%, #60a5fa 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 12rpx 24rpx rgba(37,99,235,0.18), inset 0 1rpx 0 rgba(255,255,255,0.22);
}

/* Secondary action */
.sigpad-btn-secondary {
  background: linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(246,249,255,0.84) 100%);
  color: #1e293b;
  border: 1rpx solid rgba(219,229,241,0.88);
  box-shadow: 0 8rpx 18rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.80);
}

.sigpad-btn:active {
  transform: translateY(1rpx) scale(0.985);
  opacity: 0.92;
}

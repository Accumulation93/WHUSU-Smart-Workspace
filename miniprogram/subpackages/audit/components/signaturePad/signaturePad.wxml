<view class="sigpad-wrap">
  <view class="sigpad-tools">
  <view class="sigpad-toolbar sigpad-modes">
    <button class="{{mode === 'browse' ? 'primary-btn' : 'secondary-btn'}}" data-mode="browse" bindtap="setMode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.browse}}</button>
    <button class="{{mode === 'move' ? 'primary-btn' : 'secondary-btn'}}" data-mode="move" bindtap="setMode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.move}}</button>
    <button class="{{mode === 'pen' ? 'primary-btn' : 'secondary-btn'}}" data-mode="pen" bindtap="setMode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.pen}}</button>
  </view>
  <view class="sigpad-toolbar sigpad-actions">
    <button class="secondary-btn" disabled="{{!undoable}}" bindtap="onUndo" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.undo}}</button>
    <button class="secondary-btn" disabled="{{!redoable}}" bindtap="onRedo" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.redo}}</button>
    <button class="secondary-btn" aria-label="{{copy.clear}}" bindtap="onClear" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"><ui-icon name="trash" /></button>
    <button class="secondary-btn" aria-label="{{copy.zoomOut}}" bindtap="zoomOut" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">−</button>
    <button class="secondary-btn" aria-label="{{copy.zoomIn}}" bindtap="zoomIn" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">+</button>
    <button class="secondary-btn sigpad-action-label" bindtap="fit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.fit}}</button>
    <button class="{{toolsExpanded ? 'primary-btn' : 'secondary-btn'}} sigpad-action-label" disabled="{{mode === 'browse'}}" aria-expanded="{{toolsExpanded}}" bindtap="toggleTools" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.tools}}</button>
  </view>
  </view>
  <view class="sigpad-body">
  <view class="sigpad-frame">
    <view id="sigViewport" class="sigpad-viewport" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchCancel">
      <image wx:if="{{panelPreview}}" class="sigpad-snapshot" src="{{panelPreview}}" mode="aspectFit" bindload="showPanelPreview" binderror="panelPreviewFailed" />
      <canvas type="2d" id="sigSurface" class="sigpad-surface {{panelPreviewVisible ? 'sigpad-surface--offscreen' : ''}}"></canvas>
      <view wx:if="{{panelPreviewStale}}" class="sigpad-snapshot-note {{toolsExpanded ? '' : 'sigpad-snapshot-note--top'}}">{{copy.panelPreviewUnavailable}}</view>
    </view>
  </view>
  <view wx:if="{{toolsExpanded}}" class="sigpad-settings {{custom ? 'sigpad-settings--custom' : ''}} {{mode === 'move' ? 'sigpad-settings--move' : ''}} {{recolorable ? 'sigpad-settings--recolor' : ''}}" style="{{keyboardPanelMax ? 'max-height:' + keyboardPanelMax + 'px' : ''}}">
  <view class="sigpad-settings-heading"><text class="sigpad-settings-title">{{copy.tools}}</text><button class="secondary-btn" aria-label="{{copy.closeTools}}" bindtap="closeTools" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"><ui-icon name="x" /></button></view>
  <scroll-view class="sigpad-settings-scroll" scroll-y enhanced show-scrollbar="{{true}}">
  <view class="sigpad-settings-content">
  <view wx:if="{{mode === 'pen' || mode === 'move'}}" class="sigpad-toolbar sigpad-palette">
    <button class="secondary-btn sigpad-color {{color === '#000000' && !erasing ? 'sigpad-selected' : ''}}" aria-label="{{copy.black}}" data-color="#000000" bindtap="setColor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"><view class="sigpad-swatch sigpad-black"></view></button>
    <button class="secondary-btn sigpad-color {{color === '#0000ff' && !erasing ? 'sigpad-selected' : ''}}" aria-label="{{copy.blue}}" data-color="#0000ff" bindtap="setColor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"><view class="sigpad-swatch sigpad-blue"></view></button>
    <button class="secondary-btn sigpad-color {{color === '#ff0000' && !erasing ? 'sigpad-selected' : ''}}" aria-label="{{copy.red}}" data-color="#ff0000" bindtap="setColor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"><view class="sigpad-swatch sigpad-red"></view></button>
    <button class="{{custom ? 'primary-btn' : 'secondary-btn'}} sigpad-custom-btn" aria-expanded="{{custom}}" bindtap="toggleCustom" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.custom}}</button>
  </view>
  <view wx:if="{{mode === 'pen'}}" class="sigpad-toolbar sigpad-pen-styles {{erasing ? 'sigpad-pen-styles--single' : ''}}" role="radiogroup" aria-label="{{copy.penStyle}}">
    <button wx:if="{{!erasing}}" wx:for="{{penStyles}}" wx:key="value" class="{{penStyle === item.value ? 'primary-btn' : 'secondary-btn'}}" data-style="{{item.value}}" bindtap="setPenStyle" aria-pressed="{{penStyle === item.value}}" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item.label}}</button>
    <button class="{{erasing ? 'primary-btn' : 'secondary-btn'}}" bindtap="toggleEraser" aria-pressed="{{erasing}}" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.erase}}</button>
  </view>
  <view wx:if="{{mode === 'pen'}}">
    <view class="sigpad-width-heading">{{erasing ? copy.eraserWidth : copy.width}}</view>
    <view class="sigpad-width-controls">
      <view wx:for="{{widthOptions}}" wx:key="value" class="sigpad-width-option {{penWidth === item.value ? 'sigpad-width-option--active' : ''}}" data-width="{{item.value}}" bindtap="setWidth" aria-role="button" aria-pressed="{{penWidth === item.value}}" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"><view class="sigpad-width-stroke" style="height: {{item.height}}px"></view><text class="sigpad-width-label">{{item.label}}</text></view>
    </view>
  </view>
  <view wx:if="{{custom && (mode === 'pen' || mode === 'move')}}" class="sigpad-colors">
    <view class="field-label">{{copy.hex}}</view><input class="field-input" value="{{colorInput}}" maxlength="7" bindchange="setHex" bindkeyboardheightchange="updateColorKeyboard" adjust-position="{{false}}" cursor-spacing="16" />
    <view class="field-label">{{copy.redChannel}}</view><slider class="sigpad-channel" value="{{red}}" min="0" max="255" data-channel="0" bindchanging="setChannel" />
    <view class="field-label">{{copy.greenChannel}}</view><slider class="sigpad-channel" value="{{green}}" min="0" max="255" data-channel="1" bindchanging="setChannel" />
    <view class="field-label">{{copy.blueChannel}}</view><slider class="sigpad-channel" value="{{blue}}" min="0" max="255" data-channel="2" bindchanging="setChannel" />
  </view>
  <view wx:if="{{recolorable && (mode === 'pen' || mode === 'move')}}" class="sigpad-toolbar"><button class="secondary-btn" disabled="{{recoloring}}" bindtap="recolorSelected" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.recolor}}</button></view>
  <view wx:if="{{notice}}" class="sigpad-notice">{{notice}}</view>
  </view>
  </scroll-view>
  </view>
  <slot />
  </view>
  <canvas type="2d" id="sigInkCanvas" class="sigpad-export-canvas"></canvas>
  <canvas type="2d" id="sigExportCanvas" class="sigpad-export-canvas"></canvas>
</view>

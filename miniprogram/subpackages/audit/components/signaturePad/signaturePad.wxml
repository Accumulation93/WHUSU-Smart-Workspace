<view class="sigpad-wrap">
  <view class="sigpad-canvas-border">
    <view
      id="sigSurface"
      class="sigpad-surface"
      catchtouchstart="onTouchStart"
      catchtouchmove="onTouchMove"
      catchtouchend="onTouchEnd"
      catchtouchcancel="onTouchEnd"
    >
      <image wx:if="{{initialImageVisible}}" class="sigpad-initial-image" src="{{initialImage}}" mode="scaleToFill" />
      <view class="sigpad-ink-layer">
        <view class="sigpad-ink-segment" wx:for="{{segments}}" wx:key="id" style="{{item.style}}"></view>
      </view>
    </view>
  </view>

  <!-- 原生 Canvas 只负责最终导出，不参与屏幕显示和触摸。 -->
  <canvas type="2d" id="sigExportCanvas" class="sigpad-export-canvas"></canvas>

  <view class="sigpad-actions">
    <button class="secondary-btn sigpad-btn sigpad-btn-secondary ui-motion-button" bindtap="onClear" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">清除</button>
    <button class="primary-btn sigpad-btn sigpad-btn-primary ui-motion-button" bindtap="onConfirm" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">确认签名</button>
  </view>
</view>

<view class="page page-narrow subapp-audit-page">
  <workspace-hero class="workspace-hero-host" app-name="{{localeCopy.copy_aa4f0ed6cd}}" page-name="{{localeCopy.copy_56d416c578}} · {{localeCopy.copy_290f4e2426}}"></workspace-hero>

  <view class="section">
    <view class="card" wx:if="{{creating}}">
      <view class="section-title">{{editingSignature ? localeCopy.copy_ae48afe9fc : localeCopy.copy_c103b678f0}}</view>
      <signature-pad initialImage="{{editingSignature.imageData || ''}}" bindconfirm="onSignatureDrawConfirm" />
      <view class="audit-btn-bar"><button class="secondary-btn ui-motion-button" bindtap="cancelCreate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_06dbb49961}}</button></view>
    </view>

    <view class="card" wx:if="{{!creating}}">
      <view class="audit-btn-bar">
        <button class="primary-btn ui-motion-button" bindtap="startCreate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_d654f6c1d3}}</button>
      </view>
    </view>

    <view class="card">
      <view class="section-title">{{localeCopy.copy_e92a06d5bf}}</view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
        <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
        <block wx:else>
        <view class="audit-sig-card" wx:for="{{signatures}}" wx:key="id">
          <view class="list-name">{{item.name}} <text wx:if="{{item.isDefault}}" class="audit-chip audit-chip-approved audit-chip--inline">{{localeCopy.copy_7f8fe1554d}}</text></view>
          <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="widthFix" class="audit-sig-preview" />
          <view class="inline-actions list-actions-below">
            <text class="audit-link-btn ui-motion-chip" data-id="{{item.id}}" bindtap="editSignature" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_e040ae3016}}</text>
            <text class="audit-link-btn ui-motion-chip" wx:if="{{!item.isDefault}}" data-id="{{item.id}}" bindtap="setDefault" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_f1b28c5cf9}}</text>
            <text class="audit-link-btn audit-link-danger ui-motion-chip" data-id="{{item.id}}" bindtap="deleteSignature" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_acc985cabc}}</text>
          </view>
        </view>
        <view class="audit-empty-state" wx:if="{{!signatures.length}}">
          <view class="audit-empty-icon"><ui-icon name="signature" tone="muted" size="54" ariaLabel="{{localeCopy.copy_b9a2950b44}}" /></view>
          <view class="audit-empty-text">{{localeCopy.copy_b9a2950b44}}</view>
        </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">{{localeCopy.copy_aa4f0ed6cd}}</view>
    <view class="footer-org">{{localeCopy.copy_638da8ae60}}</view>
  </view>
</view>

@import '../../../../pages/home/home.wxss';
@import '../../styles/blue-polish.wxss';

.danger-text { color:#ef4444; font-size: var(--ui-type-control); margin-top:4rpx; }

.verify-file-meta {
  margin-top: 8rpx;
  color: #64748b;
  font-size: var(--ui-type-meta);
  line-height: 1.55;
  word-break: break-word;
}

.verify-overall {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(191, 219, 254, 0.68);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.92), rgba(255, 255, 255, 0.76));
}

.verify-subsection-title {
  margin-top: 28rpx;
  margin-bottom: 16rpx;
}

.verify-hash-value,
.verify-hash-line {
  word-break: break-all;
  overflow-wrap: anywhere;
}

.verify-hash-value {
  font-size: var(--ui-type-caption);
  line-height: 1.65;
}

.verify-status-valid { color: #15803d; }
.verify-status-invalid { color: #dc2626; }
.verify-status-unknown { color: #64748b; }

.verify-file-status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.verify-file-copy {
  min-width: 0;
  flex: 1;
}

.verify-hash-line {
  margin-top: 6rpx;
  font-size: var(--ui-type-caption);
  line-height: 1.55;
}

@media (min-width: 520px) {
  .verify-overall {
    margin-bottom: 20px;
    padding: 20px;
    border-radius: 20px;
  }
  .verify-subsection-title {
    margin-top: 24px;
    margin-bottom: 14px;
  }
  .verify-file-meta { margin-top: 6px; font-size: var(--ui-type-label); }
  .verify-hash-value,
  .verify-hash-line { font-size: var(--ui-type-meta); }
}

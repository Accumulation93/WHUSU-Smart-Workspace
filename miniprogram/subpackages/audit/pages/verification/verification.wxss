@import '../../../main/styles/home.wxss';
@import '../../styles/blue-polish.wxss';

.danger-text { color:#ef4444; font-size: var(--ui-type-control); margin-top:4rpx; }

.verify-file-meta {
  margin-top: 8rpx;
  color: #64748b;
  font-size: var(--ui-type-meta);
  line-height: 1.55;
  word-break: break-word;
}

.verify-overall {
  margin-bottom: var(--ui-card-gap, 24rpx);
  padding: var(--ui-list-padding-y, 22rpx) var(--ui-list-padding-x, 20rpx);
  border: 1rpx solid rgba(191, 219, 254, 0.68);
  border-radius: var(--ui-list-radius, 20rpx);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.92), rgba(255, 255, 255, 0.76));
}

.verify-subsection-title {
  margin-top: var(--ui-card-gap, 24rpx);
  margin-bottom: var(--ui-field-gap, 16rpx);
}

.verification-submit-field { margin-bottom: 0; }
.verification-form-card > .audit-btn-bar { margin-top: var(--ui-action-gap, 20rpx); }

.verify-hash-value,
.verify-hash-line {
  word-break: break-all;
  overflow-wrap: anywhere;
}

.verify-hash-value {
  font-size: var(--ui-type-caption);
  line-height: 1.65;
}

.verify-status-valid { color: #15803d; }
.verify-status-invalid { color: #dc2626; }
.verify-status-unknown { color: #64748b; }

.verify-file-status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.verify-file-copy {
  min-width: 0;
  flex: 1;
}

.verify-hash-line {
  margin-top: 6rpx;
  font-size: var(--ui-type-caption);
  line-height: 1.55;
}

@media (min-width: 520px) {
  .verify-file-meta { margin-top: 6px; font-size: var(--ui-type-label); }
  .verify-hash-value,
  .verify-hash-line { font-size: var(--ui-type-meta); }
}

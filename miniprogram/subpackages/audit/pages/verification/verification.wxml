<view class="page">
  <view class="hero">
    <view class="hero-badge">验签</view>
    <view class="hero-title">签名验证</view>
    <view class="hero-subtitle">验证审核文件的哈希链完整性</view>
  </view>

  <view class="section">
    <view class="card">
      <view class="section-title">验证方式</view>

      <!-- Verification mode picker -->
      <view class="field">
        <view class="field-label">查询方式</view>
        <picker range="{{['提交编号查询','提交ID查询','文件验证']}}" bindchange="onVerifyModeChange">
          <view class="picker-value">{{verifyMode === 'number' ? '提交编号查询' : (verifyMode === 'id' ? '提交ID查询' : '文件验证')}}</view>
        </picker>
      </view>

      <!-- Number mode -->
      <view class="field" wx:if="{{verifyMode === 'number'}}">
        <view class="field-label">提交编号</view>
        <input class="field-input" value="{{submissionNumber}}" bindinput="onInputNumber" placeholder="例如：SUB-20260611-001" />
      </view>

      <!-- ID mode -->
      <view class="field" wx:if="{{verifyMode === 'id'}}">
        <view class="field-label">提交ID</view>
        <input class="field-input" value="{{submissionId}}" bindinput="onInputId" placeholder="输入提交的唯一标识ID" />
      </view>

      <!-- File mode -->
      <view class="field" wx:if="{{verifyMode === 'file'}}">
        <view class="field-label">选择文件</view>
        <view class="picker-value" bindtap="chooseVerifyFile">{{fileName || '点击选择要验签的文件'}}</view>
        <view class="list-desc" wx:if="{{fileSize > 0}}" style="font-size:22rpx;color:#6b7280;">{{fileName}} · {{fileSize}} 字节</view>
      </view>

      <view class="button-row">
        <button class="primary-btn" loading="{{loading}}" bindtap="verify">验证签名链</button>
      </view>
    </view>

    <view class="card" wx:if="{{result}}">
      <view class="section-title">验证结果</view>
      <view class="info-grid">
        <view class="info-block info-block-full">
          <view class="info-label">总体结果</view>
          <view class="info-value" style="color:{{result.valid ? '#059669' : '#ef4444'}}; font-size:32rpx;">
            {{result.valid ? '✓ 验证通过' : '✗ 验证失败'}}
          </view>
        </view>
        <view class="info-block">
          <view class="info-label">签名总数</view>
          <view class="info-value">{{result.totalSignatures}}</view>
        </view>
        <view class="info-block" wx:if="{{result.submissionNumber}}">
          <view class="info-label">提交编号</view>
          <view class="info-value">{{result.submissionNumber}}</view>
        </view>
        <view class="info-block" wx:if="{{result.verifyByFileHash}}">
          <view class="info-label">验证文件哈希</view>
          <view class="info-value" style="font-size:20rpx;word-break:break-all;">{{result.verifyByFileHash}}</view>
        </view>
      </view>

      <!-- Rounds -->
      <view class="list-title" style="margin-top:16rpx;" wx:if="{{result.totalSignatures > 0}}">各轮详情</view>
      <view wx:for="{{result.rounds}}" wx:key="*this" wx:for-index="round" wx:for-item="roundData">
        <view class="list-item">
          <view class="list-main">
            <view class="list-name" style="color:{{roundData.valid ? '#059669' : '#ef4444'}};">
              第{{round}}轮：{{roundData.valid ? '完整' : '异常'}} ({{roundData.signatures}}个签名)
            </view>
            <view class="list-desc danger-text" wx:if="{{roundData.brokenAt}}">断裂点：{{roundData.brokenAt}}</view>
          </view>
        </view>
      </view>

      <!-- File hash check -->
      <view class="list-title" style="margin-top:16rpx;" wx:if="{{result.files.length}}">文件哈希对比</view>
      <view wx:for="{{result.files}}" wx:key="fileId">
        <view class="list-item">
          <view class="list-main">
            <view class="list-name" style="color:{{item.hashVerified === true ? '#059669' : (item.hashVerified === false ? '#ef4444' : '#64748b')}};">
              {{item.hashVerified === true ? '✓ 一致' : (item.hashVerified === false ? '✗ 不匹配' : '? 无法对比')}}
            </view>
            <view class="list-desc" wx:if="{{item.currentHash}}">当前哈希：{{item.currentHash}}</view>
            <view class="list-desc" wx:if="{{item.documentHashAtLastSigning}}">签名时哈希：{{item.documentHashAtLastSigning}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>
</view>

<workspace-navigation></workspace-navigation>
<view class="page page-narrow">
  <workspace-hero class="workspace-hero-host" app-name="WHUSU智慧工作台" page-name="审核审批 · 文件验签"></workspace-hero>

  <view class="section">
    <view class="card">
      <view class="section-title">查询方式</view>

      <!-- Verification mode picker -->
      <view class="field">
        <view class="field-label">查询方式</view>
        <picker range="{{['按提交编号','上传文件']}}" bindchange="onVerifyModeChange">
          <view class="picker-value">{{verifyMode === 'number' ? '按提交编号' : '上传文件'}}</view>
        </picker>
      </view>

      <!-- Number mode -->
      <view class="field" wx:if="{{verifyMode === 'number'}}">
        <view class="field-label">提交编号</view>
        <input class="field-input" value="{{submissionNumber}}" bindinput="onInputNumber" placeholder="如：SUB-20260611-001" />
      </view>

      <!-- File mode -->
      <view class="field" wx:if="{{verifyMode === 'file'}}">
        <view class="field-label">选择文件</view>
        <view class="picker-value ui-motion-chip" bindtap="chooseVerifyFile" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{fileName || '选择要验签的文件'}}</view>
      </view>

      <view class="audit-btn-bar">
        <button class="primary-btn ui-motion-button" loading="{{loading}}" bindtap="verify" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">开始验签</button>
      </view>
    </view>

    <view class="card" wx:if="{{result}}">
      <view class="section-title">验签结果</view>

      <!-- Overall result -->
      <view class="audit-verify-result verify-overall">
        <view class="audit-verify-icon"><ui-icon name="{{result.valid ? 'check' : 'x'}}" tone="{{result.valid ? 'primary' : 'danger'}}" size="56" ariaLabel="{{result.valid ? '验签通过' : '验签未通过'}}" /></view>
        <view class="audit-verify-text {{result.valid ? 'audit-verify-valid' : 'audit-verify-invalid'}}">
          {{result.valid ? '验签通过' : '验签未通过'}}
        </view>
      </view>

      <view class="info-grid">
        <view class="info-block">
          <view class="info-label">签名总数</view>
          <view class="info-value">{{result.totalSignatures}}</view>
        </view>
        <view class="info-block" wx:if="{{result.submissionNumber}}">
          <view class="info-label">提交编号</view>
          <view class="info-value">{{result.submissionNumber}}</view>
        </view>
      </view>

      <!-- Rounds -->
      <view class="section-title verify-subsection-title" wx:if="{{result.totalSignatures > 0}}">签名记录</view>
      <view wx:for="{{result.rounds}}" wx:key="*this" wx:for-index="round" wx:for-item="roundData">
        <view class="audit-step-card">
          <view class="audit-step-indicator {{roundData.valid ? 'audit-step-dot-done' : 'audit-step-dot-rejected'}}">
            <ui-icon name="{{roundData.valid ? 'check' : 'x'}}" tone="{{roundData.valid ? 'primary' : 'danger'}}" size="22" ariaLabel="{{roundData.valid ? '记录完整' : '记录有变更'}}" />
          </view>
          <view class="audit-step-body">
            <view class="audit-step-title {{roundData.valid ? 'verify-status-valid' : 'verify-status-invalid'}}">
              第{{round + 1}}轮：{{roundData.valid ? '记录完整' : '记录有变更'}}（{{roundData.signatures}}个签名）
            </view>
          </view>
        </view>
      </view>

      <!-- File hash check -->
      <view class="section-title verify-subsection-title" wx:if="{{result.files.length}}">文件内容</view>
      <view wx:for="{{result.files}}" wx:key="fileId">
        <view class="file-attach-item">
          <view class="file-attach-icon verify-file-status-icon">
            <ui-icon name="{{item.hashVerified === true ? 'check' : (item.hashVerified === false ? 'x' : 'file')}}" tone="{{item.hashVerified === true ? 'primary' : (item.hashVerified === false ? 'danger' : 'muted')}}" size="24" ariaLabel="{{item.hashVerified === true ? '文件内容一致' : (item.hashVerified === false ? '文件已变更' : '暂无法确认')}}" />
          </view>
          <view class="verify-file-copy">
            <view class="file-attach-name {{item.hashVerified === true ? 'verify-status-valid' : (item.hashVerified === false ? 'verify-status-invalid' : 'verify-status-unknown')}}">
              {{item.hashVerified === true ? '文件内容一致' : (item.hashVerified === false ? '文件已变更' : '暂无法确认文件内容')}}
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">WHUSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>
</view>

@import '../../../../pages/home/home.wxss';

.status-chip {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  background: #f1f5f9;
  color: #64748b;
  margin-right: 8rpx;
}
.green-chip { background: #d1fae5; color: #065f46; }
.red-chip { background: #fee2e2; color: #991b1b; }
.blue-chip { background: #dbeafe; color: #1e40af; }

.list-arrow {
  font-size: 36rpx;
  color: #94a3b8;
  line-height: 1;
}

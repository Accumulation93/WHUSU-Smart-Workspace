@import '../../../../pages/home/home.wxss';
@import '../../styles/blue-polish.wxss';

/* ── Filter section ── */
.my-filter-box {
  padding: 20rpx 20rpx 16rpx;
  border-radius: 22rpx;
  margin-bottom: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.84) 0%, rgba(246,249,255,0.74) 100%);
  border: 1rpx solid rgba(255,255,255,0.60);
  box-shadow: 0 12rpx 26rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.76);
  box-sizing: border-box;
}
.my-filter-box .picker-value {
  border-radius: 18rpx; min-height: 72rpx; font-size: 24rpx;
}

/* ── Submission list items ── */
.audit-submission-item {
  display: flex; align-items: center; gap: 18rpx;
  padding: 24rpx 22rpx; margin-bottom: 12rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border: 1rpx solid rgba(226,237,247,0.94);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing: border-box; transition: transform 0.18s ease, box-shadow 0.22s ease;
  animation: glassFadeUp 0.36s ease both;
}
.audit-submission-item:last-child { margin-bottom: 4rpx; }
.audit-submission-item:active { transform: translateY(1rpx) scale(0.992); }

.audit-submission-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.audit-submission-name { color: #0f172a; font-size: 28rpx; font-weight: 700; line-height: 1.4; }

.audit-submission-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.audit-submission-id { color: #94a3b8; font-size: 21rpx; font-weight: 500; }
.audit-submission-date { color: #94a3b8; font-size: 22rpx; }

.audit-submission-desc-text {
  font-size: 22rpx; color: #94a3b8; margin-top: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.audit-list-arrow {
  flex-shrink: 0; width: 48rpx; height: 48rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(241,245,249,0.7); color: #94a3b8; font-size: 32rpx; font-weight: 600;
}

/* ── Unread indicator ── */
.unread-dot {
  display: inline-block; width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #ef4444; margin-right: 10rpx; vertical-align: middle;
  box-shadow: 0 0 8rpx rgba(239,68,68,0.35);
}
.audit-submission-name { display: flex; align-items: center; }
.audit-submission-unread {
  border-left: 6rpx solid #ef4444;
  background: linear-gradient(135deg, rgba(254,242,242,0.30) 0%, rgba(255,255,255,0.90) 100%);
}

/* ── Section title with action ── */
.section-title-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 6rpx;
}
.section-title-row .section-title { margin-bottom: 0; }
.mark-all-read {
  flex-shrink: 0; padding: 8rpx 18rpx; border-radius: 999rpx;
  font-size: 22rpx; font-weight: 700; color: #2563eb;
  background: rgba(219,234,254,0.7); border: 1rpx solid rgba(147,197,253,0.45);
  transition: transform 0.12s ease;
}
.mark-all-read:active { transform: scale(0.95); }

@import '../../../main/styles/home.wxss';
@import '../../styles/blue-polish.wxss';

/* ── Filter section ── */
.my-filter-box {
  padding: var(--ui-card-padding-y, 28rpx) var(--ui-card-padding-x, 26rpx);
  border-radius: var(--ui-card-radius, 30rpx);
  margin-bottom: var(--ui-card-gap, 24rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.84) 0%, rgba(246,249,255,0.74) 100%);
  border: 1rpx solid rgba(255,255,255,0.60);
  box-shadow: 0 12rpx 26rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.76);
  box-sizing: border-box;
}
.my-filter-box .picker-value {
  min-height: var(--ui-control-height, 82rpx);
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  border-radius: var(--ui-field-radius, 20rpx);
  font-size: var(--ui-type-control);
}
.my-filter-box > .field { margin-bottom: 0; }
.my-filter-box > .audit-btn-bar { margin-top: var(--ui-action-gap, 20rpx); }

/* ── Submission list items ── */
.audit-submission-item {
  display: flex; align-items: center; gap: var(--ui-inline-gap, 10rpx);
  padding: var(--ui-list-padding-y, 22rpx) var(--ui-list-padding-x, 20rpx);
  margin-bottom: var(--ui-list-gap, 14rpx);
  border-radius: var(--ui-list-radius, 20rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border: 1rpx solid rgba(226,237,247,0.94);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing: border-box; transition: transform 0.18s ease, box-shadow 0.22s ease;
  animation: glassFadeUp 0.36s ease both;
}
.audit-submission-item:last-child { margin-bottom: 0; }
.audit-submission-item:active { transform: translateY(1rpx) scale(0.992); }

.audit-submission-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--ui-label-gap, 6rpx); }
.audit-submission-name { color: #0f172a; font-size: var(--ui-type-value); font-weight: 700; line-height: 1.3; }

.audit-submission-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ui-label-gap, 6rpx); }
.audit-submission-id { color: #94a3b8; font-size: var(--ui-type-caption); font-weight: 500; }
.audit-submission-date { color: #94a3b8; font-size: var(--ui-type-meta); }

.audit-submission-desc-text {
  font-size: var(--ui-type-meta); color: #94a3b8; margin-top: 0; line-height: 1.4;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.audit-list-arrow {
  flex-shrink: 0; width: var(--ui-compact-height, 52rpx); height: var(--ui-compact-height, 52rpx); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(241,245,249,0.7); color: #94a3b8; font-size: var(--ui-type-dialog); font-weight: 600;
}

/* ── Unread indicator ── */
.unread-dot {
  display: inline-block; width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #ef4444; margin-right: 10rpx; vertical-align: middle;
  box-shadow: 0 0 8rpx rgba(239,68,68,0.35);
}
.audit-submission-name { display: flex; align-items: center; }
.audit-submission-unread {
  border-left: 6rpx solid #3b82f6;
  background: linear-gradient(135deg, rgba(239,246,255,0.82) 0%, rgba(255,255,255,0.92) 100%);
}

/* ── Section title with action ── */
.section-title-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--ui-field-gap, 16rpx);
}
.section-title-row .section-title { margin-bottom: 0; }
.mark-all-read {
  flex-shrink: 0; padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx); border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-meta); font-weight: 700; color: #2563eb;
  background: rgba(219,234,254,0.7); border: 1rpx solid rgba(147,197,253,0.45);
  transition: transform 0.12s ease;
}

.mark-all-read:active { transform: scale(0.95); }

/* Final page motion: no wrapper wobble, held feedback on real targets. */
.section-stack:active,
.card:active,
.my-filter-box:active {
  transform: none !important;
  filter: none !important;
}

.audit-submission-item:active {
  transform: none !important;
}

.primary-btn.button-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.984) !important;
  opacity: 0.98 !important;
  box-shadow:
    0 6rpx 14rpx rgba(37,99,235,0.12),
    inset 0 3rpx 10rpx rgba(15,23,42,0.07),
    inset 0 1rpx 0 rgba(255,255,255,0.74) !important;
  transition:
    transform 0.18s cubic-bezier(0.2, 0.78, 0.22, 1),
    box-shadow 0.20s ease,
    opacity 0.16s ease !important;
}

.audit-submission-item.control-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.992) !important;
  opacity: 0.975 !important;
  box-shadow:
    0 7rpx 16rpx rgba(37,99,235,0.10),
    inset 0 2rpx 8rpx rgba(15,23,42,0.052),
    inset 0 1rpx 0 rgba(255,255,255,0.76) !important;
  transition:
    transform 0.20s cubic-bezier(0.2, 0.78, 0.22, 1),
    box-shadow 0.22s ease,
    opacity 0.18s ease !important;
}

<view class="page page-narrow subapp-audit-page">
  <workspace-hero class="workspace-hero-host" app-name="{{localeCopy.copy_aa4f0ed6cd}}" page-name="{{localeCopy.copy_56d416c578}} · {{localeCopy.copy_fb0dc97a1d}}"></workspace-hero>

  <view class="section-stack">
    <view class="my-filter-box">
      <view class="field">
        <view class="field-label">{{localeCopy.copy_bff094c480}}</view>
        <picker range="{{statusOptions}}" bindchange="onStatusFilterChange">
          <view class="picker-value">{{statusOptions[0]}}</view>
        </picker>
      </view>
      <view class="audit-btn-bar">
        <button class="primary-btn ui-motion-button" bindtap="goCreate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_c64e979552}}</button>
      </view>
    </view>

    <view class="card">
      <view class="section-title-row">
        <view class="section-title">{{localeCopy.copy_8ad4a40192}}</view>
        <text class="mark-all-read ui-motion-chip" bindtap="markAllRead" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_6830671a51}}</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
        <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
        <block wx:else>
        <view class="audit-submission-item {{item.isUnread ? 'audit-submission-unread' : ''}} ui-motion-card" wx:for="{{submissions}}" wx:key="id" data-id="{{item.id}}" bindtap="viewDetail" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="audit-submission-main">
            <view class="audit-submission-name">
              <view class="unread-dot" wx:if="{{item.isUnread}}"></view>
              {{item.title || item.submissionNumber}}
            </view>
            <view class="audit-submission-desc-text" wx:if="{{item.description}}">{{item.description}}</view>
            <view class="audit-submission-meta">
              <view class="audit-chip {{item.status === 'approved' ? 'audit-chip-approved' : (item.status === 'rejected' ? 'audit-chip-rejected' : (item.status === 'in_progress' ? 'audit-chip-progress' : (item.status === 'draft' ? 'audit-chip-draft' : (item.status === 'withdrawn' ? 'audit-chip-withdrawn' : 'audit-chip-pending'))))}}">
                {{item.status === 'draft' ? localeCopy.copy_f6afc42806 : (item.status === 'pending' ? localeCopy.copy_57b008f8c7 : (item.status === 'in_progress' ? localeCopy.copy_0dc99cac16 : (item.status === 'rejected' ? localeCopy.copy_5d5af942c5 : (item.status === 'approved' ? localeCopy.copy_2220286f1c : localeCopy.copy_282e15e226))))}}
              </view>
              <text class="audit-submission-id">{{item.submissionNumber}}</text>
            </view>
            <view class="audit-submission-date">{{item.createdAt}}</view>
          </view>
          <view class="audit-list-arrow">›</view>
        </view>
        <view class="audit-empty-state" wx:if="{{!submissions.length}}">
          <view class="audit-empty-icon"><ui-icon name="file" tone="muted" size="54" ariaLabel="{{localeCopy.copy_a7f09dc2db}}" /></view>
          <view class="audit-empty-text">{{localeCopy.copy_a7f09dc2db}}</view>
        </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">{{localeCopy.copy_aa4f0ed6cd}}</view>
    <view class="footer-org">{{localeCopy.copy_638da8ae60}}</view>
  </view>
</view>

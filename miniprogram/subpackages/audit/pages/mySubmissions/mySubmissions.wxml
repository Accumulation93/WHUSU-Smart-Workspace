<view class="page">
  <view class="hero">
    <view class="hero-badge">审核</view>
    <view class="hero-title">我的审核</view>
    <view class="hero-subtitle">查看我提交的审核申请</view>
  </view>

  <view class="section">
    <view class="edit-box">
      <view class="field">
        <view class="field-label">状态筛选</view>
        <picker range="{{statusOptions}}" bindchange="onStatusFilterChange">
          <view class="picker-value">{{statusOptions[0]}}</view>
        </picker>
      </view>
      <view class="button-row">
        <button class="primary-btn" bindtap="goCreate">发起新审核</button>
      </view>
    </view>

    <view class="list-card">
      <view class="list-title">审核列表</view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
        <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
        <block wx:else>
        <view class="list-item" wx:for="{{submissions}}" wx:key="id" data-id="{{item.id}}" bindtap="viewDetail">
          <view class="list-main">
            <view class="list-name">{{item.title || item.submissionNumber}}</view>
            <view class="chip-row">
              <view class="status-chip {{item.status === 'approved' ? 'green-chip' : (item.status === 'rejected' ? 'red-chip' : (item.status === 'in_progress' ? 'blue-chip' : ''))}}">
                {{item.status === 'draft' ? '草稿' : (item.status === 'pending' ? '待提交' : (item.status === 'in_progress' ? '审核中' : (item.status === 'rejected' ? '已驳回' : (item.status === 'approved' ? '已完成' : '已撤回'))))}}
              </view>
              <text class="list-desc">{{item.submissionNumber}}</text>
            </view>
            <view class="list-desc">{{item.createdAt}}</view>
          </view>
          <view class="list-arrow">›</view>
        </view>
        <view class="empty-inline" wx:if="{{!submissions.length}}">暂无审核申请。</view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>
</view>

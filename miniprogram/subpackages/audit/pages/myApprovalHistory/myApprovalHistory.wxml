<view class="page page-narrow subapp-audit-page">
  <workspace-hero class="workspace-hero-host" app-name="{{localeCopy.copy_aa4f0ed6cd}}" page-name="{{localeCopy.copy_56d416c578}} · {{localeCopy.copy_f69eaef5c5}}"></workspace-hero>

  <view class="section-stack">
    <view class="card">
      <view class="section-title-row">
        <view class="section-title">{{localeCopy.copy_2ad6b11547}}</view>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
        <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
        <block wx:else>
        <view class="audit-submission-item ui-motion-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="viewDetail" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="audit-submission-main">
            <view class="audit-submission-name">
              {{item.title || item.submissionNumber}}
            </view>
            <view class="audit-submission-desc-text" wx:if="{{item.description}}">{{item.description}}</view>
            <view class="audit-submission-meta">
              <view class="audit-chip {{item.status === 'approved' ? 'audit-chip-approved' : (item.status === 'rejected' ? 'audit-chip-rejected' : (item.status === 'in_progress' ? 'audit-chip-progress' : (item.status === 'draft' ? 'audit-chip-draft' : (item.status === 'withdrawn' ? 'audit-chip-withdrawn' : 'audit-chip-pending'))))}}">
                {{item.status === 'in_progress' ? localeCopy.copy_0dc99cac16 : (item.status === 'approved' ? localeCopy.copy_2220286f1c : (item.status === 'rejected' ? localeCopy.copy_5d5af942c5 : (item.status === 'withdrawn' ? localeCopy.copy_282e15e226 : item.status)))}}
              </view>
              <text class="audit-submission-meta-text">{{item.submitterName}} · {{item.submissionNumber}}</text>
            </view>
            <view class="audit-submission-date">{{item.myLastActionAtText || item.updatedAtText || item.createdAtText}}</view>
            <view class="history-assignment-list" wx:if="{{item.handledAssignmentLabels.length}}">
              <view class="audit-chip audit-chip-approved" wx:for="{{item.handledAssignmentLabels}}" wx:for-item="assignmentLabel" wx:key="*this">{{localeCopy.processedAssignmentPrefix}}{{assignmentLabel}}</view>
            </view>
            <view class="history-assignment-neutral" wx:if="{{item.hasLegacyAssignmentSnapshot}}">{{localeCopy.legacyAssignmentSnapshotUnavailable}}</view>
          </view>
          <view class="audit-list-arrow">›</view>
        </view>
        <view class="audit-empty-state" wx:if="{{!items.length}}">
          <view class="audit-empty-icon"><ui-icon name="file" tone="muted" size="54" ariaLabel="{{localeCopy.copy_86accadcca}}" /></view>
          <view class="audit-empty-text">{{localeCopy.copy_86accadcca}}</view>
        </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">{{localeCopy.copy_aa4f0ed6cd}}</view>
    <view class="footer-org">{{localeCopy.copy_638da8ae60}}</view>
  </view>
</view>

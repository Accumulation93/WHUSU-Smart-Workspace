<view class="page page-narrow">
  <view class="hero">
    <view class="hero-badge">审核</view>
    <view class="hero-title">我的审批记录</view>
    <view class="hero-subtitle">我参与过审批的申请记录</view>
  </view>

  <view class="section">
    <view class="card">
      <view class="section-title-row">
        <view class="section-title">审批记录</view>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
        <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
        <block wx:else>
        <view class="audit-submission-item ui-motion-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="viewDetail" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="audit-submission-main">
            <view class="audit-submission-name">
              {{item.title || item.submissionNumber}}
            </view>
            <view class="audit-submission-desc-text" wx:if="{{item.description}}">{{item.description}}</view>
            <view class="audit-submission-meta">
              <view class="audit-chip {{item.status === 'approved' ? 'audit-chip-approved' : (item.status === 'rejected' ? 'audit-chip-rejected' : (item.status === 'in_progress' ? 'audit-chip-progress' : (item.status === 'draft' ? 'audit-chip-draft' : (item.status === 'withdrawn' ? 'audit-chip-withdrawn' : 'audit-chip-pending'))))}}">
                {{item.status === 'in_progress' ? '审核中' : (item.status === 'approved' ? '已完成' : (item.status === 'rejected' ? '已驳回' : (item.status === 'withdrawn' ? '已撤回' : item.status)))}}
              </view>
              <text class="audit-submission-meta-text">{{item.submitterName}} · {{item.submissionNumber}}</text>
            </view>
            <view class="audit-submission-date">{{item.myLastActionAt || item.updatedAt || item.createdAt}}</view>
          </view>
          <view class="audit-list-arrow">›</view>
        </view>
        <view class="audit-empty-state" wx:if="{{!items.length}}">
          <view class="audit-empty-icon">📋</view>
          <view class="audit-empty-text">暂无审批记录</view>
        </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>
</view>

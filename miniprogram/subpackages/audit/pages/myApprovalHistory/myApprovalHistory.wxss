@import '../../../workspace/pages/home/home.wxss';
@import '../../styles/blue-polish.wxss';

/* ── Section title with action ── */
.section-title-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 6rpx;
}
.section-title-row .section-title { margin-bottom: 0; }

/* ── List items ── */
.audit-submission-item {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 16rpx; margin-bottom: 8rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border: 1rpx solid rgba(226,237,247,0.94);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing: border-box; transition: transform 0.18s ease, box-shadow 0.22s ease;
  animation: glassFadeUp 0.36s ease both;
}
.audit-submission-item:last-child { margin-bottom: 4rpx; }
.audit-submission-item:active { transform: translateY(1rpx) scale(0.992); }

/* Final page motion: avoid parent shell motion on fast taps. */
.section:active,
.card:active,
.audit-submission-item:active {
  transform: none !important;
  filter: none !important;
}

.audit-submission-item.control-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.992) !important;
  opacity: 0.975 !important;
  transition:
    transform 0.18s cubic-bezier(0.2, 0.78, 0.22, 1),
    box-shadow 0.20s ease,
    opacity 0.18s ease !important;
}

.audit-submission-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.audit-submission-name { color: #0f172a; font-size: var(--ui-type-value); font-weight: 700; line-height: 1.3; display: flex; align-items: center; }

.audit-submission-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6rpx; }
.audit-submission-meta-text { color: #94a3b8; font-size: var(--ui-type-caption); font-weight: 500; }
.audit-submission-date { color: #94a3b8; font-size: var(--ui-type-meta); }

.audit-submission-desc-text {
  font-size: var(--ui-type-meta); color: #94a3b8; margin-top: 2rpx; line-height: 1.4;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.audit-list-arrow {
  flex-shrink: 0; width: 48rpx; height: 48rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(241,245,249,0.7); color: #94a3b8; font-size: var(--ui-type-dialog); font-weight: 600;
}

@media (min-width: 900px) and (orientation: landscape) {
  .audit-submission-item {
    gap: 10px;
    padding: 10px 12px;
    margin-bottom: 6px;
    border-radius: 14px;
  }

  .audit-submission-main { gap: 3px; }
  .audit-submission-meta { gap: 5px; }
  .audit-submission-desc-text { margin-top: 1px; line-height: 1.35; }
}

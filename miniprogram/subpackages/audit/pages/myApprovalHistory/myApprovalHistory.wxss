@import '../../../../pages/home/home.wxss';
@import '../../styles/blue-polish.wxss';

/* ── List items ── */
.audit-submission-item {
  display: flex; align-items: center; gap: 18rpx;
  padding: 24rpx 22rpx; margin-bottom: 12rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border: 1rpx solid rgba(226,237,247,0.94);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing: border-box; transition: transform 0.18s ease, box-shadow 0.22s ease;
  animation: glassFadeUp 0.36s ease both;
}
.audit-submission-item:last-child { margin-bottom: 4rpx; }
.audit-submission-item:active { transform: translateY(1rpx) scale(0.992); }
.audit-submission-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.audit-submission-name { color: #0f172a; font-size: 28rpx; font-weight: 700; line-height: 1.4; display: flex; align-items: center; }
.audit-submission-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.audit-submission-date { color: #94a3b8; font-size: 22rpx; }
.audit-list-arrow {
  flex-shrink: 0; width: 48rpx; height: 48rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(241,245,249,0.7); color: #94a3b8; font-size: 32rpx; font-weight: 600;
}

/* unread dot */
.unread-dot {
  display: inline-block; width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
  margin-right: 10rpx;
  vertical-align: middle;
  box-shadow: 0 0 8rpx rgba(239,68,68,0.35);
}

/* unread item highlight */
.audit-submission-unread {
  border-left: 6rpx solid #ef4444;
  background: linear-gradient(135deg, rgba(254,242,242,0.30) 0%, rgba(255,255,255,0.90) 100%);
}

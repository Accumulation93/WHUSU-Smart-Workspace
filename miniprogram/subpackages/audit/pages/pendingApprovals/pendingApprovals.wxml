<view class="page">
  <view class="hero">
    <view class="hero-badge">审核</view>
    <view class="hero-title">待我审批</view>
    <view class="hero-subtitle">需要我处理的审核申请</view>
  </view>

  <view class="section">
    <view class="list-card">
      <view class="list-title">待审批列表</view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
        <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
        <block wx:else>
        <view class="list-item" wx:for="{{pending}}" wx:key="id" data-submission-id="{{item.submissionId}}" bindtap="viewDetail">
          <view class="list-main">
            <view class="list-name">{{item.title || item.submissionNumber}}</view>
            <view class="chip-row">
              <view class="status-chip blue-chip">待我处理</view>
              <text class="list-desc">第{{item.sortOrder}}步 · {{item.actionType === 'sign' ? '签字' : (item.actionType === 'estamp' ? '盖章' : '签字+盖章')}} · 第{{item.round}}轮</text>
            </view>
            <view class="list-desc">提交人：{{item.submitterName}} · {{item.submissionNumber}}</view>
          </view>
          <view class="list-arrow">›</view>
        </view>
        <view class="empty-inline" wx:if="{{!pending.length}}">暂无待审批的审核申请。</view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>
</view>

<view class="page page-narrow">
  <view class="hero">
    <view class="hero-badge">审核</view>
    <view class="hero-title">待我审批</view>
    <view class="hero-subtitle">需要我处理的审核申请</view>
  </view>

  <view class="section">
    <view class="card">
      <view class="section-title">待审批列表</view>
      <view class="pending-header" wx:if="{{pending.length && lastUpdateTime}}">
        <text class="pending-update-time">更新于 {{lastUpdateTime}}</text>
        <text class="pending-refresh-btn ui-motion-chip" bindtap="loadData" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">⟳ 刷新</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
        <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
        <block wx:else>
        <view class="pending-item ui-motion-card" wx:for="{{pending}}" wx:key="id" data-submission-id="{{item.submissionId}}" bindtap="viewDetail" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="pending-item-main">
            <view class="pending-item-name">{{item.title || item.submissionNumber}}</view>
            <view class="pending-item-meta">
              <view class="audit-chip audit-chip-progress">待我处理</view>
              <view class="pending-item-step">第{{item.sortOrder}}步 · {{item.actionType === 'pass' ? '仅通过' : (item.actionType === 'sign' ? '签字' : (item.actionType === 'estamp' ? '盖章' : '签字+盖章'))}} · 第{{item.round}}轮</view>
            </view>
            <view class="pending-item-info">提交人：{{item.submitterName}} · {{item.submissionNumber}}</view>
          </view>
          <view class="pending-list-arrow">›</view>
        </view>
        <view class="audit-empty-state" wx:if="{{!pending.length && !loading}}">
          <view class="audit-empty-icon">✅</view>
          <view class="audit-empty-text">暂无待审批的审核</view>
          <view class="audit-empty-tip">当其他成员发起审核并指定你为审批人时，<br/>需要你处理的审核将显示在这里。</view>
        </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">WHUSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>
</view>

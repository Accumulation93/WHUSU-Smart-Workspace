<ui-navbar title="{{navigationTitle}}" />
<view class="page signing-page" style="min-height: calc(100vh - {{navTopPx}}px); height: calc(100vh - {{navTopPx}}px)">
  <view class="card signing-card">
    <view class="section-title">{{fileName || copy.padTitle}}</view>
    <view wx:if="{{loading}}" class="signing-notice">{{copy.loading}}</view>
    <view wx:if="{{notice}}" class="signing-notice">{{notice}}<button class="secondary-btn" bindtap="retry" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.retry}}</button></view>
    <view class="signing-pages" wx:if="{{totalPages > 1}}"><button class="secondary-btn" disabled="{{page <= 1 || loading || saving}}" bindtap="previous" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">◀</button><view>{{copy.page}} {{page}} / {{totalPages}}</view><button class="secondary-btn" disabled="{{page >= totalPages || loading || saving}}" bindtap="next" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">▶</button></view>
    <signature-pad class="signing-workspace" wx:if="{{!loading && !notice}}" id="signingPad" file-id="{{fileId}}" file-image="{{fileImage}}" document-width="{{width}}" document-height="{{height}}" page="{{page}}" pdf="{{pdf}}" initial-mode="{{mode}}" active-id="{{activeId}}" materials="{{materials}}" bindlayerschange="refreshLayers" bindmodechange="workspaceMode" bindready="onCanvasReady" binderror="onCanvasError" bindplacement="moveMaterial" bindgeometry="materialGeometry" bindpagechange="historyPage" />
    <view class="signing-layer-toolbar">
      <picker disabled="{{!layers.length || saving}}" range="{{layers}}" range-key="label" value="{{layerIndex}}" bindchange="chooseLayer"><view class="signing-layer-choice">{{copy.layers}}<text wx:if="{{layers.length}}"> · {{layers[layerIndex].label}}</text></view></picker>
      <button class="secondary-btn" data-direction="1" disabled="{{layerIndex >= layers.length - 1 || saving || !ready}}" bindtap="reorderLayer" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.layerUp}}</button>
      <button class="secondary-btn" data-direction="-1" disabled="{{layerIndex <= 0 || saving || !ready}}" bindtap="reorderLayer" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.layerDown}}</button>
    </view>
    <view class="signing-objects" wx:if="{{materials.length && mode === 'move'}}">
      <view class="field-label">{{copy.objects}}</view>
      <button wx:for="{{materials}}" wx:key="_idx" data-id="{{item._idx}}" class="{{activeId === item._idx ? 'primary-btn' : 'secondary-btn'}}" bindtap="chooseMaterial" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item.stampName || copy.signature}} {{index + 1}}</button>
      <view class="signing-adjustments" wx:if="{{activeId}}"><view><view class="field-label">{{copy.size}}</view><slider min="50" max="220" value="{{materialSize}}" step="5" bindchanging="resizeMaterial" /></view><view><view class="field-label">{{copy.rotation}}</view><slider min="-180" max="180" value="{{materialRotation}}" step="5" bindchanging="rotateMaterial" /></view></view>
    </view>
    <view class="button-row signing-footer"><button class="secondary-btn" disabled="{{saving}}" bindtap="cancel" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.cancel}}</button><button class="primary-btn" disabled="{{!ready || loading || notice || saving}}" bindtap="confirm" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.confirm}}</button></view>
  </view>
</view>
<app-toast />

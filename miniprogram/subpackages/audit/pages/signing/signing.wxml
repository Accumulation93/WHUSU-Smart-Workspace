<page-meta page-orientation="{{workspaceOrientation}}" />
<ui-navbar title="{{navigationTitle}}" />
<view class="page signing-page" style="min-height: calc(100vh - {{navTopPx}}px); height: calc(100vh - {{navTopPx}}px)">
  <view class="card signing-card">
    <view wx:if="{{loading}}" class="signing-notice"><app-loading text="{{copy.loading}}" /></view>
    <view wx:if="{{notice}}" class="signing-notice">{{notice}}<button class="secondary-btn" bindtap="retry" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.retry}}</button></view>
    <signature-pad class="signing-workspace" wx:if="{{!loading && !notice}}" id="signingPad" file-id="{{fileId}}" file-image="{{fileImage}}" document-width="{{width}}" document-height="{{height}}" page="{{page}}" pdf="{{pdf}}" initial-mode="{{mode}}" active-id="{{activeId}}" materials="{{materials}}" layout-key="{{mode + layers.length + activeMaterialId + workspaceMinHeight + navTopPx}}" style="min-height: {{workspaceMinHeight}}px" bindtoolschange="workspaceTools" bindlayoutchange="workspaceLayout" bindlayerschange="refreshLayers" bindhistorychange="historyChanged" bindrecolor="recolorMaterial" bindprocessing="workspaceProcessing" bindmodechange="workspaceMode" bindready="onCanvasReady" binderror="onCanvasError" bindplacement="moveMaterial" bindgeometry="materialGeometry" bindpagechange="historyPage" />
    <scroll-view wx:if="{{layersExpanded}}" class="signing-sidepanel" scroll-y enhanced show-scrollbar="{{true}}">
    <view class="signing-layer-toolbar">
      <view class="signing-layer-heading">{{copy.layers}}<text class="signing-layer-count">{{layers.length}}</text></view>
      <button class="secondary-btn" aria-label="{{copy.layerUp}}" data-direction="1" disabled="{{layerIndex <= 0 || saving || !ready}}" bindtap="reorderLayer" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">↑</button>
      <button class="secondary-btn" aria-label="{{copy.layerDown}}" data-direction="-1" disabled="{{layerIndex >= layers.length - 1 || saving || !ready}}" bindtap="reorderLayer" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">↓</button>
      <button class="secondary-btn" aria-label="{{copy.remove}}" disabled="{{!layers.length || saving || !ready}}" bindtap="removeLayer" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">×</button>
    </view>
    <scroll-view class="signing-layer-strip" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="signing-layer-items">
        <view wx:for="{{layers}}" wx:key="id" class="signing-layer-item {{layerIndex === index ? 'signing-layer-item--active' : ''}}" data-index="{{index}}" bindtap="chooseLayer" aria-label="{{item.label}}" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="signing-layer-preview"><view class="signing-layer-sheet"><text>{{item.kind === 'draw' ? '✎' : '◎'}}</text></view><text class="signing-layer-rank">{{index + 1}}</text></view>
          <text class="signing-layer-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="signing-adjustments" wx:if="{{mode === 'move' && activeMaterialId}}">
      <view class="signing-adjustment"><view class="signing-adjustment-label"><text>{{copy.size}}</text><text>{{materialSize}}%</text></view><slider min="50" max="220" value="{{materialSize}}" step="5" block-size="24" disabled="{{saving || !ready}}" bindchanging="previewSize" bindtouchcancel="cancelAdjustment" bindchange="resizeMaterial" /></view>
      <view class="signing-adjustment"><view class="signing-adjustment-label"><text>{{copy.rotation}}</text><text>{{materialRotation}}°</text></view><slider min="-180" max="180" value="{{materialRotation}}" step="5" block-size="24" disabled="{{saving || !ready}}" bindchanging="previewRotation" bindtouchcancel="cancelAdjustment" bindchange="rotateMaterial" /></view>
    </view>
    </scroll-view>
    <view class="signing-bottom-bar">
    <button class="secondary-btn signing-toggle" aria-expanded="{{layersExpanded}}" bindtap="toggleLayers" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.adjustLayers}} {{layers.length}}</button>
    <view class="signing-pages" wx:if="{{totalPages > 1}}"><button class="secondary-btn" disabled="{{page <= 1 || loading || saving}}" bindtap="previous" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">◀</button><view>{{page}} / {{totalPages}}</view><button class="secondary-btn" disabled="{{page >= totalPages || loading || saving}}" bindtap="next" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">▶</button></view>
    <view wx:if="{{allowSaveTemplate}}" class="selection-option-card signing-save-option {{saveTemplate ? 'selection-option-card-selected' : ''}}" aria-role="checkbox" aria-checked="{{saveTemplate}}" catchtap="toggleSaveTemplate" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.saveToLibrary}}</view>
    <view wx:if="{{exportNotice}}" class="signing-notice">{{exportNotice}}</view>
    <view wx:if="{{saving || processing}}" class="signing-notice"><app-loading text="{{copy.loading}}" /></view>
    <view class="button-row signing-footer"><button class="secondary-btn" disabled="{{saving || processing}}" bindtap="cancel" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.cancel}}</button><button class="primary-btn" disabled="{{!ready || loading || notice || saving || processing}}" bindtap="confirm" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.confirm}}</button></view>
    </view>
  </view>
</view>
<app-toast />

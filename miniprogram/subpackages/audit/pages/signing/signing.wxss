@import '../../../main/styles/home.wxss';

.signing-page {
  --signing-gap: 8px;
  --signing-pad: 12px;
  --signing-tool-height: 36px;
  display: grid;
  grid-template-rows: minmax(200px,1fr) auto;
  gap: var(--signing-gap);
  padding: var(--signing-gap) max(var(--signing-gap),env(safe-area-inset-right)) max(var(--signing-gap),env(safe-area-inset-bottom)) max(var(--signing-gap),env(safe-area-inset-left));
  box-sizing: border-box;
}
.signing-main { position: relative; min-width: 0; min-height: 0; }
.signing-workspace { position: relative; z-index: 0; display: block; height: 100%; min-width: 0; }
.signing-stage-message { position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: var(--signing-gap); border: 1px solid var(--ui-line); border-radius: var(--ui-field-radius); background: linear-gradient(135deg,#f8fbff,#edf4fc); color: var(--ui-text-muted); }

/* 面板是舞台上的独立层，开关不参与画布尺寸分配。标题常驻，只有正文滚动。 */
.signing-sidepanel {
  position: absolute;
  z-index: 3;
  right: var(--signing-gap);
  bottom: var(--signing-pad);
  width: min(400px,calc(100% - 2 * var(--signing-gap)));
  height: min(222px,calc(100% - 2 * var(--signing-pad)));
  display: grid;
  grid-template-rows: auto minmax(0,1fr);
  overflow: hidden;
  border: 1px solid var(--ui-line-blue);
  border-radius: var(--ui-field-radius);
  background: linear-gradient(145deg,#ffffff,#f0f6ff);
  box-shadow: 0 12px 32px rgba(30,58,138,.16), inset 0 1px 0 rgba(255,255,255,.9);
  box-sizing: border-box;
}
.signing-sidepanel--empty { height: min(112px,calc(100% - 2 * var(--signing-pad))); }
.signing-sidepanel--adjustments { height: min(414px,65%); }
.signing-layer-header { display: flex; align-items: center; justify-content: space-between; gap: var(--signing-gap); padding: var(--signing-gap) var(--signing-pad); border-bottom: 1px solid var(--ui-line); }
.signing-layer-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px var(--signing-gap); color: var(--ui-text); font-size: var(--ui-type-emphasis); font-weight: 700; }
.signing-layer-count { color: var(--ui-text-muted); font-size: var(--ui-type-meta); font-weight: 400; }
.signing-layer-header > button { flex: none; width: var(--signing-tool-height); min-width: var(--signing-tool-height); max-width: var(--signing-tool-height); }
.signing-layer-scroll { display: block; width: 100%; height: 100%; min-height: 0; }
.signing-layer-content { display: grid; grid-template-columns: minmax(0,1fr); gap: var(--signing-pad); padding: var(--signing-pad); box-sizing: border-box; }
.signing-layer-strip { display: block; width: 100%; min-width: 0; height: 78px; white-space: nowrap; }
.signing-layer-items { display: inline-flex; gap: var(--signing-gap); padding-bottom: 2px; }
.signing-layer-item { flex: none; min-width: 88px; padding: 6px 10px; border: 1px solid var(--ui-line); border-radius: var(--ui-compact-radius); background: linear-gradient(145deg,#ffffff,#f5f8fd); box-sizing: border-box; }
.signing-layer-item--active { border-color: var(--ui-blue-500); background: linear-gradient(145deg,#eff6ff,#dbeafe); }
.signing-layer-preview { position: relative; display: flex; align-items: center; justify-content: center; min-height: 34px; }
.signing-layer-sheet { display: grid; place-items: center; width: 44px; height: 28px; border: 1px solid var(--ui-line-blue); border-radius: 4px; background: linear-gradient(145deg,#ffffff,#edf4ff); box-shadow: 2px 2px 0 #dbeafe; }
.signing-layer-rank { position: absolute; right: 0; bottom: 0; color: var(--ui-text-muted); font-size: var(--ui-type-micro); font-variant-numeric: tabular-nums; }
.signing-layer-name { display: block; color: var(--ui-text); font-size: var(--ui-type-meta); line-height: 1.5; text-align: center; }
.signing-layer-toolbar { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: var(--signing-gap); }
.signing-page .signing-layer-toolbar > button { width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; white-space: nowrap; }
.signing-adjustments { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--signing-gap) 20px; padding-top: var(--signing-pad); border-top: 1px solid var(--ui-line); }
.signing-adjustment-heading, .signing-center-button { grid-column: 1 / -1; }
.signing-page .signing-center-button { justify-self: center; width: auto; min-width: 108px; }
.signing-adjustment-heading { color: var(--ui-text); font-size: var(--ui-type-label); font-weight: 700; }
.signing-adjustment { min-width: 0; }
.signing-adjustment-label { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px; color: var(--ui-text); font-size: var(--ui-type-meta); line-height: 1.4; }
.signing-adjustments slider { display: block; height: 48px; margin: 0 8px; }
.signing-notice { color: var(--ui-text-muted); font-size: var(--ui-type-meta); line-height: 1.5; }

.signing-bottom-bar { position: relative; display: grid; gap: var(--signing-gap); padding: var(--signing-gap); border: 1px solid var(--ui-line); border-radius: var(--ui-field-radius); background: linear-gradient(145deg,#ffffff,#f1f7ff); box-shadow: 0 4px 14px rgba(30,58,138,.07), inset 0 1px 0 rgba(255,255,255,.84); }
.signing-footer-tools, .signing-pages { display: flex; align-items: center; gap: var(--signing-gap); min-width: 0; }
.signing-pages { margin-left: auto; font-size: var(--ui-type-meta); white-space: nowrap; }
.signing-pages > text { min-width: 52px; text-align: center; font-variant-numeric: tabular-nums; }
.signing-pages > button { width: var(--signing-tool-height); min-width: var(--signing-tool-height); }
.signing-help { margin-left: auto !important; }
.signing-footer-tools > button { flex: none; width: auto; min-width: 0; }
.signing-pages > button { flex: none; }
.signing-footer { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--signing-gap); }
.signing-page .signing-bottom-bar button, .signing-page .signing-sidepanel button {
  display: flex; align-items: center; justify-content: center; text-align: center;
  min-height: var(--signing-tool-height); height: auto; padding: 4px 8px; margin: 0;
  border-radius: var(--ui-compact-radius); font-size: var(--ui-type-meta); line-height: var(--ui-line-control);
}
.signing-footer > button { width: 100%; min-width: 0; box-sizing: border-box; }
.signing-save-option { display: flex; align-items: center; min-height: var(--signing-tool-height); padding: 4px 8px; box-sizing: border-box; font-size: var(--ui-type-meta); line-height: 1.4; }
.signing-bottom-bar > .signing-notice { position: absolute; z-index: 4; bottom: calc(100% + var(--signing-gap)); left: 0; right: 0; padding: var(--signing-gap); border-radius: var(--ui-field-radius); background: linear-gradient(145deg,#ffffff,#eff6ff); }

@media (min-width: 650px) {
  .signing-page { grid-template-rows: minmax(158px,1fr) auto; }
  .signing-bottom-bar { grid-template-columns: minmax(0,1fr) auto; }
  .signing-footer-tools { justify-content: flex-start; }
  .signing-pages, .signing-help { margin-left: 0 !important; }
  .signing-footer { grid-template-columns: minmax(80px,auto) minmax(108px,auto); }
  .signing-sidepanel--adjustments { height: min(414px,calc(100% - 2 * var(--signing-pad))); }
}

@media (min-width: 650px) and (max-height: 500px) {
  .signing-layer-header { padding: 4px var(--signing-pad); }
  .signing-layer-content { padding: 8px var(--signing-pad); }
}

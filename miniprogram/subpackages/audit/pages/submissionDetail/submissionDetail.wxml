<page-meta page-style="{{adHocStepEditorVisible || editStepEditorVisible || editPersonPickerVisible || stampPickerVisible || placementVisible || approvalVisible || sigSourcePickerVisible || signaturePadVisible || personPickerVisible ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="page subapp-audit-page">
  <workspace-hero class="workspace-hero-host" app-name="WHUSU智慧工作台" page-name="{{action === 'create' ? '审核 · 发起申请' : '审核 · 审核详情'}}"></workspace-hero>

  <!-- ═══════════ Create Mode ═══════════ -->
  <view class="section" wx:if="{{action === 'create'}}">
    <view class="card">
      <view class="section-title">申请方式</view>
      <view class="button-row">
        <button class="{{createMode === 'template' ? 'primary-btn' : 'secondary-btn'}} ui-motion-button" data-mode="template" bindtap="onCreateModeChange" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">使用模板</button>
        <button class="{{createMode === 'ad_hoc' ? 'primary-btn' : 'secondary-btn'}} ui-motion-button" data-mode="ad_hoc" bindtap="onCreateModeChange" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">自定义流程</button>
      </view>
    </view>

    <!-- Template mode -->
    <view class="card" wx:if="{{createMode === 'template'}}">
      <view class="section-title">选择审核模板</view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll small-scroll" scroll-y>
        <view class="template-select-item {{selectedTemplateId === item.id ? 'template-select-item-selected' : ''}} ui-motion-card" wx:for="{{flowTemplates}}" wx:key="id" data-id="{{item.id}}" catchtap="onTemplateSelect" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="radio-dot {{selectedTemplateId === item.id ? 'radio-dot-checked' : ''}}"></view>
          <view class="list-main">
            <view class="list-name">{{item.name}} <text class="list-desc">({{item.stepCount}}步 · {{item.resubmitMode === 'fresh' ? '重新逐层' : '回到驳回人'}})</text></view>
            <view class="list-desc" wx:if="{{item.description}}">{{item.description}}</view>
          </view>
        </view>
        <view class="audit-empty-state" wx:if="{{!flowTemplates.length}}">
          <view class="audit-empty-icon"><ui-icon name="file" tone="muted" size="54" ariaLabel="暂无模板" /></view>
          <view class="audit-empty-text">暂无可用模板</view>
        </view>
      </scroll-view>
    </view>

    <!-- Ad-hoc mode -->
    <view class="card" wx:if="{{createMode === 'ad_hoc'}}">
      <view class="section-title">审批步骤 ({{adHocSteps.length}}步)</view>
      <view class="ad-hoc-step-item" wx:for="{{adHocSteps}}" wx:key="index">
        <view class="ad-hoc-step-main">
          <view class="ad-hoc-step-title">{{item.name || ('第' + (index + 1) + '步')}}：{{item.approverType === 'specific_person' ? (item.approverHrName || '未指定人员') : (item.approverIdentityName || '未指定身份') + '（' + (item.scopeType === 'same_department' ? '同部门' : (item.scopeType === 'same_work_group' ? '同职能组' : (item.scopeType === 'specific_department' ? (item.scopeDepartmentName || '指定部门') : (item.scopeType === 'specific_work_group' ? (item.scopeDepartmentName || '') + (item.scopeWorkGroupName ? '·' + item.scopeWorkGroupName : '') : '全体')))) + '）'}} — {{item.actionType === 'pass' ? '通过' : (item.actionType === 'sign' ? '签字' : (item.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
          <view class="ad-hoc-step-desc">{{item.approverType === 'identity' ? '按身份审批' : '指定人员审批'}}</view>
        </view>
        <view class="list-actions"><text class="audit-link-btn audit-link-danger ui-motion-chip" data-index="{{index}}" bindtap="removeAdHocStep" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text></view>
      </view>
      <view class="audit-empty-state" wx:if="{{!adHocSteps.length}}">
        <view class="audit-empty-text">暂无审批步骤</view>
      </view>
      <view class="button-row compact-row"><button class="secondary-btn ui-motion-button" bindtap="openAdHocStepEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">按身份添加</button><button class="secondary-btn ui-motion-button" bindtap="openPersonPicker" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">指定人员添加</button></view>
      <view class="field field-mt-16">
        <view class="field-label">驳回后重新提交</view>
        <picker range="{{['重新逐层审批','直接到驳回人']}}" bindchange="onResubmitModeChange">
          <view class="picker-value">{{resubmitMode === 'fresh' ? '重新逐层审批' : '直接到驳回人'}}</view>
        </picker>
      </view>
    </view>

    <!-- Template step preview (person override) -->
    <view class="card" wx:if="{{createMode === 'template' && selectedTemplateId && templatePreviewSteps.length}}">
      <view class="section-title">审批步骤预览（共{{templatePreviewSteps.length}}步）</view>
      <view class="section-desc section-desc-sm">审批人按流程设置确定</view>
      <!-- 模板允许时：第一步审批人可指定（显眼入口，与下方步骤行共用同一状态） -->
      <view class="tpl-first-approver" wx:if="{{templateStepOverrides.length && templateStepOverrides[0].stepIndex === 1}}">
        <view class="tpl-first-approver-head">
          <view class="tpl-first-approver-title">第一步审批人</view>
          <text class="audit-link-btn ui-motion-chip" catchtap="openTemplateStepPersonPicker" data-step-index="1" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{templateStepOverrides[0].personHrIds.length ? '修改指定' : '指定'}}</text>
        </view>
        <view class="tpl-first-approver-desc">未指定时按模板审批条件确定第一步审批人，指定后由所选人员审批。</view>
        <view wx:if="{{templateStepOverrides[0].personHrNames.length}}" class="tpl-step-override-persons">
          <view class="tpl-step-person-tag" wx:for="{{templateStepOverrides[0].personHrNames}}" wx:for-item="pname" wx:for-index="pidx" wx:key="pname">
            <text>{{pname}}</text>
            <text class="tpl-step-person-remove ui-motion-chip" data-step-index="1" data-hr-id="{{templateStepOverrides[0].personHrIds[pidx]}}" catchtap="removeTemplateStepOverridePerson" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">×</text>
          </view>
        </view>
      </view>
      <view class="tpl-step-preview-item" wx:for="{{templatePreviewSteps}}" wx:key="stepIndex">
        <view class="tpl-step-preview-main">
          <view class="tpl-step-preview-num">{{item.name || ('第' + (item.sortOrder || (index + 1)) + '步')}}</view>
          <view class="tpl-step-preview-desc">{{item.approverDesc || '由未指定审批人审批'}}</view>
          <view class="tpl-step-preview-action">{{item.actionLabel || '审批'}}</view>
        </view>
        <view class="tpl-step-preview-mode">
          <text wx:if="{{item.stepIndex === 1 && templateStepOverrides.length && templateStepOverrides[0].personHrIds.length}}" class="tpl-step-fixed-mode tpl-step-designated">已指定审批人</text>
          <text wx:else class="tpl-step-fixed-mode">按审批条件</text>
        </view>
      </view>
    </view>

    <!-- Common: Title + Files -->
    <view class="card">
      <view class="section-title">基本信息</view>
      <view class="field">
        <view class="field-label">标题</view>
        <input class="field-input" value="{{createTitle}}" bindinput="onTitleInput" placeholder="请输入审核标题" />
      </view>
      <view class="field">
        <view class="field-label">描述</view>
        <textarea class="field-textarea" auto-height maxlength="-1" value="{{createDesc}}" bindinput="onDescInput" placeholder="填写说明（选填）" ></textarea>
      </view>
      <view class="section-title field-mt-16">附件 ({{uploadedFiles.length}}份)</view>
      <view class="file-attach-item" wx:for="{{uploadedFiles}}" wx:key="fileId">
        <view class="file-attach-icon"><ui-icon name="file" tone="primary" size="24" ariaLabel="附件" /></view>
        <view class="file-attach-name">{{item.fileName}}</view>
        <view class="list-actions"><text class="audit-link-btn audit-link-danger ui-motion-chip" data-index="{{index}}" bindtap="removeUploadedFile" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text></view>
      </view>
      <view class="button-row compact-row">
        <button class="secondary-btn ui-motion-button" bindtap="chooseImage" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">选择图片</button>
        <button class="secondary-btn ui-motion-button" bindtap="chooseFile" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">选择文件</button>
      </view>
      <view class="audit-btn-bar">
        <button class="primary-btn ui-motion-button" loading="{{loading}}" bindtap="submitAudit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">提交申请</button>
      </view>
    </view>

    <!-- ═══ Identity step editor popup ═══ -->
    <viewport-portal wx:if="{{adHocStepEditorVisible}}">
    <view class="popup-mask ui-overlay" wx:if="{{adHocStepEditorVisible}}" bindtap="closeAdHocStepEditor">
      <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
      <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
        <view class="popup-header ui-dialog-header"><view class="popup-title">添加审批步骤 — 按身份</view><text class="popup-close ui-motion-chip" catchtap="closeAdHocStepEditor" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text></view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-content ui-dialog-scroll--fill" scroll-y>
          <view class="detail-popup-form ui-dialog-stack">
            <view class="field">
              <view class="field-label">步骤名称</view>
              <input class="field-input" value="{{adHocStepForm.name}}" data-field="name" bindinput="onAdHocStepField" placeholder="如：部门负责人审批"/>
            </view>
            <view class="field">
              <view class="field-label">审批动作</view>
              <picker range="{{['通过','签字','盖章','签字+盖章']}}" bindchange="onAdHocActionTypeChange">
                <view class="picker-value">{{adHocStepForm.actionType === 'pass' ? '通过' : (adHocStepForm.actionType === 'sign' ? '签字' : (adHocStepForm.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
              </picker>
            </view>
            <view class="field">
              <view class="field-label">审批范围</view>
              <picker range="{{identityPickerScopeOptions}}" bindchange="onIdentityScopeChange">
                <view class="picker-value">{{identityPickerScopeOptions[identityPickerScopeIndex] || '全体成员'}}</view>
              </picker>
            </view>
            <view class="field" wx:if="{{identityPickerScopeValues[identityPickerScopeIndex] === 'specific_department' || identityPickerScopeValues[identityPickerScopeIndex] === 'specific_work_group'}}">
              <view class="field-label">指定部门</view>
              <picker range="{{identityPickerDeptOptions}}" bindchange="onIdentityDeptChange">
                <view class="picker-value">{{identityPickerDeptOptions[identityPickerDeptIndex] || '请选择部门'}}</view>
              </picker>
            </view>
            <view class="field" wx:if="{{identityPickerScopeValues[identityPickerScopeIndex] === 'specific_work_group'}}">
              <view class="field-label">指定职能组</view>
              <picker range="{{identityPickerWgOptions}}" bindchange="onIdentityWgChange">
                <view class="picker-value">{{identityPickerWgOptions[identityPickerWgIndex] || '请选择职能组'}}</view>
              </picker>
            </view>
            <view class="field">
              <view class="field-label">审批人身份</view>
              <picker range="{{identityPickerIdentOptions}}" bindchange="onIdentityIdentChange">
                <view class="picker-value">{{identityPickerIdentOptions[identityPickerIdentIndex] || '请选择身份'}}</view>
              </picker>
            </view>
          </view>
        </scroll-view>
        <view class="audit-btn-bar ui-dialog-footer"><button class="primary-btn ui-motion-button" catchtap="confirmAdHocStep" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">确定</button></view>
      </view>
    </view>
    </viewport-portal>

  </view>

  <!-- ═══════════ View Mode ═══════════ -->
  <view class="section" wx:if="{{action === 'view'}}">
    <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>

    <block wx:if="{{!loading && submission}}">
      <!-- Status -->
      <view class="card">
        <view class="info-grid">
          <view class="info-block">
            <view class="info-label">状态</view>
            <view class="info-value">
              <view class="detail-status-chip {{submission.status === 'approved' ? 'detail-status-approved' : (submission.status === 'rejected' ? 'detail-status-rejected' : (submission.status === 'in_progress' ? 'detail-status-progress' : (submission.status === 'draft' ? 'detail-status-draft' : (submission.status === 'pending' ? 'detail-status-pending' : (submission.status === 'withdrawn' ? 'detail-status-withdrawn' : 'detail-status-draft')))))}}">
                {{submission.status === 'draft' ? '草稿' : (submission.status === 'pending' ? '待提交' : (submission.status === 'in_progress' ? '审核中' : (submission.status === 'rejected' ? '已驳回' : (submission.status === 'approved' ? '已完成' : '已撤回'))))}}
              </view>
            </view>
          </view>
          <view class="info-block">
            <view class="info-label">类型</view>
            <view class="info-value">{{submission.type === 'template' ? '使用模板' : '自定义流程'}}</view>
          </view>
          <view class="info-block info-block-full" wx:if="{{submission.templateName}}">
            <view class="info-label">模板</view>
            <view class="info-value">{{submission.templateName}}</view>
          </view>
        </view>
        <!-- Status context hint — 6 states clearly explained -->
        <view class="status-hint-box">
          <view class="status-hint-icon">
            <ui-icon
              name="{{submission.status === 'approved' ? 'check' : (submission.status === 'rejected' ? 'x' : (submission.status === 'draft' ? 'edit' : 'clock'))}}"
              tone="{{submission.status === 'approved' ? 'primary' : (submission.status === 'rejected' ? 'danger' : 'muted')}}"
              size="22"
              ariaLabel="审核状态"
            />
          </view>
          <view class="status-hint-copy">
            <block wx:if="{{submission.status === 'draft'}}">尚未提交</block>
            <block wx:elif="{{submission.status === 'pending'}}">等待重新提交</block>
            <block wx:elif="{{submission.status === 'in_progress'}}">等待第{{submission.currentStepIndex || 1}}步审批</block>
            <block wx:elif="{{submission.status === 'rejected'}}">第{{submission.previousRejectStepIndex || '?'}}步已驳回，可修改后重新提交</block>
            <block wx:elif="{{submission.status === 'approved'}}">审批已完成</block>
            <block wx:elif="{{submission.status === 'withdrawn'}}">已撤回，可重新提交</block>
          </view>
        </view>
      </view>

      <!-- ═══════════ Active Approval Card (shown when current user can approve) ═══════════ -->
      <view class="card approval-card" wx:if="{{!editMode && submission.status === 'in_progress' && activeApprovalStepId && userIsApprover}}">
        <view class="section-title approval-card-title">审批操作</view>
        <view class="approval-step-info">
          {{activeApprovalStep.stepName || ('第' + activeApprovalStep.sortOrder + '步')}} · {{activeApprovalStep.actionLabel}}
          <text wx:if="{{activeApprovalStep.round > 1}}" class="approval-round-note">（第{{activeApprovalStep.round}}轮）</text>
        </view>
        <view class="approval-step-desc">{{activeApprovalStep.approverDesc}}</view>

        <!-- Signature / Stamp section (hidden for pass-only steps) -->
        <view wx:if="{{activeApprovalStep.actionType !== 'pass'}}" class="approval-sig-section">
          <view class="approval-sig-header">
            {{activeApprovalStep.actionType === 'both' ? '签名与盖章' : (activeApprovalStep.actionType === 'sign' ? '签名' : '盖章')}}
          </view>

          <!-- File list -->
          <view wx:for="{{files}}" wx:key="id" wx:for-item="f" class="approval-file-item">
            <view class="approval-file-row">
              <view class="approval-file-name"><ui-icon name="file" tone="muted" size="20" ariaLabel="附件" /><text>{{f.fileName}}</text></view>
              <view class="approval-file-actions">
                <text class="approval-file-btn-preview ui-motion-chip"
                      data-file-id="{{f.id}}" data-file-name="{{f.fileName}}"
                      bindtap="previewFile" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">预览</text>
                <text wx:if="{{activeApprovalStep.actionType === 'sign' || activeApprovalStep.actionType === 'both'}}"
                      class="approval-file-btn-sign ui-motion-chip"
                      data-file-id="{{f.id}}" data-file-name="{{f.fileName}}"
                      bindtap="addSignatureForFile" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">签名</text>
                <text wx:if="{{activeApprovalStep.actionType === 'estamp' || activeApprovalStep.actionType === 'both'}}"
                      class="approval-file-btn-stamp ui-motion-chip"
                      data-file-id="{{f.id}}" data-file-name="{{f.fileName}}"
                      bindtap="addStampForFile" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">盖章</text>
              </view>
            </view>

            <!-- Current sigs/stamps on this file -->
            <view wx:for="{{pendingSignatures}}" wx:for-item="sig" wx:key="_idx" wx:if="{{sig.fileId === f.id}}"
                  class="approval-sig-item">
              <view class="approval-sig-info">
                <image wx:if="{{sig.imageData}}" src="{{sig.imageData}}" mode="aspectFit" class="approval-sig-thumb" />
                <text class="approval-sig-name">{{sig.signatureType === 'stamp' ? (sig.stampName || '印章') : '签名'}}</text>
                <text class="approval-sig-pos">{{sig.posText || '请调整位置'}}</text>
              </view>
              <view class="approval-sig-actions">
                <text class="approval-sig-action-adjust ui-motion-chip" data-sig-idx="{{index}}" bindtap="openPlacement" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">调整位置</text>
                <text class="approval-sig-action-remove ui-motion-chip" data-sig-idx="{{index}}" bindtap="removePendingSign" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text>
              </view>
            </view>
          </view>

          <!-- Warning for incomplete sign+stamp -->
          <view wx:if="{{activeApprovalStep.actionType === 'both' && approvalWarning}}"
                class="approval-warning">
            {{approvalWarning}}
          </view>
        </view>

        <!-- Approval comment -->
        <view class="approval-field-label">审批意见（可选）</view>
          <textarea class="approval-textarea" auto-height maxlength="-1" value="{{approvalComment}}" bindinput="onApprovalCommentInput" placeholder="填写审批意见（选填）"></textarea>

        <!-- Rejection reason -->
        <view class="approval-field-label">驳回理由</view>
          <textarea class="approval-textarea" auto-height maxlength="-1" value="{{rejectionReason}}" bindinput="onRejectionReasonInput" placeholder="填写驳回理由"></textarea>

        <!-- Designate next-step approvers (optional) -->
        <view class="approval-designate-row" wx:if="{{nextStepInfo && nextStepInfo.allowApproverDesignation}}">
          <view class="approval-designate-header">
            <view class="approval-designate-label">指定下一步审批人（可选）</view>
            <text class="audit-link-btn approval-designate-link ui-motion-chip" bindtap="openDesignateNextPersonPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{designatedNextPersons.length ? '修改' : '选择'}}</text>
          </view>
          <view wx:if="{{!designatedNextPersons.length}}" class="approval-designate-empty">不指定时由下一步审批人处理</view>
          <view wx:for="{{designatedNextPersons}}" wx:key="id" class="approval-designate-tag">
            {{item.name}}
            <text data-hr-id="{{item.id}}" bindtap="removeDesignatedNextPerson" class="approval-designate-remove ui-motion-chip" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">×</text>
          </view>
          <view wx:if="{{nextStepInfo}}" class="approval-next-step-info">下一步：第{{nextStepInfo.sortOrder}}步 · {{nextStepInfo.approverDesc}}</view>
        </view>

        <!-- Action buttons -->
        <view class="button-row">
          <button class="primary-btn approval-btn-approve ui-motion-button" loading="{{loading}}" bindtap="confirmApprovalDirect" data-action="approve" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">✓ 通过</button>
          <button class="secondary-btn danger-btn approval-btn-reject ui-motion-button" loading="{{loading}}" bindtap="confirmApprovalDirect" data-action="reject" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">✗ 驳回</button>
        </view>
      </view>

      <!-- Flow Visualization -->
      <view class="card">
        <view class="section-title">审批流程</view>

        <!-- Flow progress summary -->
        <view class="audit-flow-summary">
          <text class="flow-summary-text">进度</text>
          <view class="audit-flow-progress-bar">
            <view class="audit-flow-progress-fill" style="width:{{flowProgressPercent}}%;"></view>
          </view>
          <text class="audit-flow-progress-text">{{flowProgressText}}</text>
        </view>

        <!-- Flow timeline — lifecycle events + approval steps -->
        <view class="audit-flow" wx:if="{{flowTimeline.length}}">
          <block wx:for="{{flowTimeline}}" wx:key="_key" wx:for-item="node">

            <!-- ── Remaining steps separator ── -->
            <view class="flow-separator" wx:if="{{node.type === 'separator'}}">
              <view class="flow-separator-dash"></view>
              <text class="flow-separator-text">{{node.label}}</text>
              <view class="flow-separator-dash"></view>
            </view>

            <!-- ── Lifecycle event node (tappable to expand) ── -->
            <view class="flow-node flow-node-lifecycle {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}} ui-motion-chip" wx:if="{{node.type === 'lifecycle'}}" bindtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="ui-press-chip" hover-stay-time="160" hover-start-time="0" hover-stop-propagation="{{true}}">
              <view class="flow-left-col">
                <view class="flow-dot-lifecycle-icon"><ui-icon name="{{node.iconName || 'clock'}}" tone="{{node.event === 'reject' ? 'danger' : 'primary'}}" size="20" ariaLabel="{{node.label}}" /></view>
                <view class="flow-connector flow-connector-lifecycle"></view>
              </view>
              <view class="flow-info flow-info-lifecycle">
                <view class="flow-lifecycle-label">{{node.label}}<text class="flow-lifecycle-round" wx:if="{{node.subLabel}}"> {{node.subLabel}}</text></view>
                <view class="flow-lifecycle-time" wx:if="{{node.time}}">{{node.time}}</view>
                <!-- Expand indicator -->
                <view class="flow-expand-hint">{{expandedNodeKey === node._key ? '▲ 收起' : '▼ 详情'}}</view>
                <!-- Expanded detail -->
                <view wx:if="{{expandedNodeKey === node._key}}" class="flow-expand-detail">
                  <view class="flow-detail-text">
                    <text class="flow-detail-label">操作人：</text>{{node.operatorName || '自动操作'}}
                  </view>
                  <view wx:if="{{node.comment}}" class="flow-detail-text flow-detail-comment-text">
                    <text class="flow-detail-label">{{node.event === 'approve' ? '审批意见：' : (node.event === 'reject' ? '驳回理由：' : '备注：')}}</text>{{node.comment}}
                  </view>
                  <view wx:if="{{node.time}}" class="flow-detail-meta">时间：{{node.time}}</view>
                </view>
                <!-- Collapsed: show comment inline for approve/reject -->
                <view wx:if="{{expandedNodeKey !== node._key && node.comment && (node.event === 'approve' || node.event === 'reject')}}" class="flow-collapsed-comment">{{node.event === 'approve' ? '审批意见：' : '驳回意见：'}}{{node.comment}}</view>
              </view>
            </view>

            <!-- ── Approval step node (tappable to expand) ── -->
            <view class="flow-node {{node.flowNodeClass}} {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}} ui-motion-chip" wx:if="{{node.type === 'step'}}" bindtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="ui-press-chip" hover-stay-time="160" hover-start-time="0" hover-stop-propagation="{{true}}">
              <view class="flow-left-col">
                <view class="flow-dot {{node.flowDotClass}}">
                  <block wx:if="{{node.flowIcon === 'check'}}">✓</block>
                  <block wx:elif="{{node.flowIcon === 'cross'}}">✗</block>
                  <block wx:else>{{node.sortOrder}}</block>
                </view>
                <view class="flow-connector"></view>
              </view>
              <view class="flow-info">
                <!-- Collapsed: key info only -->
                <view class="flow-step-label">{{node.stepName || ('第' + (node.sortOrder || '?') + '步')}} · {{node.actionLabel || '审批'}}<text class="flow-round-badge" wx:if="{{node.round > 1}}">第{{node.round}}轮</text></view>
                <view class="flow-step-approver">{{node.approverDesc || '由未指定审批人审批'}}</view>
                <view class="flow-step-status-tag {{node.flowTagClass}}">{{node.flowStatusLabel}}</view>
                <!-- Always show approver name + time if processed -->
                <view class="flow-step-meta" wx:if="{{node.flowIcon === 'check' || node.flowIcon === 'cross'}}">
                  {{node.operatorName || node.approverName || '未记录'}} · {{node.processedAt || ''}}
                </view>
                <!-- Expand indicator -->
                <view class="flow-expand-hint">{{expandedNodeKey === node._key ? '▲ 收起' : '▼ 详情'}}</view>

                <!-- Expanded detail section -->
                <view wx:if="{{expandedNodeKey === node._key}}" class="flow-expand-detail">
                  <!-- Processed info -->
                  <view wx:if="{{node.flowIcon === 'check' || node.flowIcon === 'cross'}}" class="flow-detail-processed-text">
                    <text class="flow-detail-label">处理人：</text>{{node.operatorName || node.approverName || '未记录'}}
                  </view>
                  <view wx:if="{{node.flowIcon === 'check' || node.flowIcon === 'cross'}}" class="flow-detail-processed-meta">
                    处理时间：{{node.processedAt || ''}}
                  </view>
                  <!-- Approval comment -->
                  <view wx:if="{{node.comment && node.flowIcon === 'check'}}" class="flow-detail-comment">
                    <text class="flow-detail-label">审批意见：</text>{{node.comment}}
                  </view>
                  <!-- Rejection reason -->
                  <view wx:if="{{node.rejectionReason}}" class="flow-detail-reject">
                    <text class="flow-detail-label">驳回理由：</text>{{node.rejectionReason}}
                  </view>
                  <!-- Conditions detail (multi-condition OR logic) -->
                  <view wx:if="{{node.conditionsDisplay && node.conditionsDisplay.length}}" class="flow-detail-conditions">
                    <view class="flow-detail-conditions-label">审批条件：</view>
                    <view wx:for="{{node.conditionsDisplay}}" wx:for-item="condLine" wx:key="*this" class="flow-detail-cond-line">{{condLine}}</view>
                  </view>
                  <!-- Round info -->
                  <view wx:if="{{node.round > 1}}" class="flow-detail-round">第{{node.round}}轮审批</view>
                </view>

                <!-- Approval action buttons (only for active step + authorized user) -->
                <view class="flow-actions" wx:if="{{node.flowNodeClass === 'flow-node-active' && userIsApprover}}">
                  <text class="flow-action-btn ui-motion-chip" data-step-id="{{node.id}}" catchtap="openApprove" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">✓ 通过</text>
                  <text class="flow-action-btn flow-action-danger ui-motion-chip" data-step-id="{{node.id}}" catchtap="openReject" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">✗ 驳回</text>
                </view>
              </view>
            </view>

          </block>
        </view>
        <!-- Diagnostic: step count from server -->
        <view wx:if="{{rawStepCount === 0 && submission.status !== 'draft' && submission.status !== 'pending'}}" class="flow-diagnostic">
          <text class="flow-diagnostic-text">暂无审批步骤</text>
        </view>

        <!-- Empty state for draft/pending with no events -->
        <view wx:if="{{!flowTimeline.length && (submission.status === 'draft' || submission.status === 'pending')}}" class="flow-empty-draft">
          <text class="flow-empty-draft-text">{{submission.status === 'draft' ? '尚未提交' : '等待重新提交'}}</text>
        </view>

        <!-- Empty state when no timeline -->
        <view wx:if="{{!flowTimeline.length}}" class="audit-empty-state">
          <view class="audit-empty-icon"><ui-icon name="list" tone="muted" size="54" ariaLabel="暂无审批流程" /></view>
          <view class="audit-empty-text">暂无审批记录</view>
        </view>
      </view>

      <!-- Files -->
      <view class="card" wx:if="{{files.length}}">
        <view class="section-title">附件 ({{files.length}}份)</view>
        <view class="file-attach-item ui-motion-card" wx:for="{{files}}" wx:key="id" data-file-id="{{item.id}}" data-file-name="{{item.fileName}}" bindtap="previewFile" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="file-attach-icon"><ui-icon name="file" tone="primary" size="24" ariaLabel="附件" /></view>
          <view class="file-attach-name">{{item.fileName}}</view>
        </view>
      </view>

      <!-- Signatures -->
      <view class="card" wx:if="{{signatures.length}}">
        <view class="section-title">签署记录 ({{signatures.length}}条)</view>
        <view class="audit-sig-card" wx:for="{{signatures}}" wx:key="id">
          <view class="list-name">{{item.signerName}} · {{item.signatureType === 'signature' ? '签名' : '印章'}} · 第{{item.round}}轮</view>
          <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="widthFix" class="audit-sig-preview" />
          <view class="list-desc">{{item.signedAt}}</view>
        </view>
      </view>

      <!-- Description display (view mode) -->
      <view class="card" wx:if="{{submission.description}}">
        <view class="section-title">描述</view>
        <view class="view-desc-text">{{submission.description}}</view>
      </view>

      <!-- Actions — submitter-only buttons -->
      <view class="card" wx:if="{{userIsSubmitter}}">
        <view class="section-title" wx:if="{{activeApprovalStepId}}">申请操作</view>
        <view class="audit-btn-bar">
          <button class="secondary-btn ui-motion-button" wx:if="{{submission.status === 'draft' || submission.status === 'pending' || submission.status === 'rejected' || submission.status === 'withdrawn'}}" bindtap="enterEditMode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">修改申请</button>
          <button class="primary-btn ui-motion-button" wx:if="{{submission.status === 'pending' || submission.status === 'rejected' || submission.status === 'withdrawn'}}" bindtap="resubmit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">重新提交</button>
          <button class="secondary-btn danger-btn ui-motion-button" wx:if="{{submission.status === 'in_progress' || submission.status === 'rejected'}}" bindtap="withdraw" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">撤回申请</button>
        </view>
      </view>

      <!-- ═══════════ Edit Mode ═══════════ -->
      <view wx:if="{{editMode}}">
        <view class="card">
          <view class="section-title">修改申请</view>
        </view>

        <view class="card">
          <view class="section-title">审批类型</view>
          <view class="button-row">
            <button class="{{editType === 'template' ? 'primary-btn' : 'secondary-btn'}} ui-motion-button" data-type="template" bindtap="onEditTypeChange" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">使用模板</button>
            <button class="{{editType === 'ad_hoc' ? 'primary-btn' : 'secondary-btn'}} ui-motion-button" data-type="ad_hoc" bindtap="onEditTypeChange" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">自定义流程</button>
          </view>
        </view>

        <!-- Basic info -->
        <view class="card">
          <view class="section-title">基本信息</view>
          <view class="field">
            <view class="field-label">标题</view>
            <input class="field-input" value="{{editTitle}}" bindinput="onEditTitleInput" placeholder="请输入审核标题" />
          </view>
          <view class="field">
            <view class="field-label">描述</view>
            <textarea class="field-textarea" auto-height maxlength="-1" value="{{editDesc}}" bindinput="onEditDescInput" placeholder="填写说明（选填）" ></textarea>
          </view>
        </view>

        <!-- Ad-hoc steps editor -->
        <view class="card" wx:if="{{editType === 'ad_hoc'}}">
          <view class="section-title">审批步骤 ({{editSteps.length}}步)</view>
          <view class="ad-hoc-step-item" wx:for="{{editSteps}}" wx:key="index">
            <view class="ad-hoc-step-main">
              <view class="ad-hoc-step-title">第{{index + 1}}步 · {{item.actionType === 'pass' ? '通过' : (item.actionType === 'sign' ? '签字' : (item.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
              <view class="ad-hoc-step-desc">{{item.approverDesc || '未选择审批人'}}</view>
              <!-- Show individual condition lines for OR logic -->
              <view wx:for="{{item.stepConditionsDisplay}}" wx:for-item="cond" wx:key="*this" wx:if="{{item.stepConditionsDisplay.length > 1}}" class="edit-cond-line">{{cond}}</view>
            </view>
            <view class="list-actions"><text class="audit-link-btn audit-link-danger ui-motion-chip" data-index="{{index}}" bindtap="removeEditStep" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text></view>
          </view>
          <view class="audit-empty-state" wx:if="{{!editSteps.length}}">
            <view class="audit-empty-text">暂无审批步骤</view>
          </view>
          <view class="button-row compact-row">
            <button class="secondary-btn ui-motion-button" bindtap="openEditStepEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">按身份添加</button>
            <button class="secondary-btn ui-motion-button" bindtap="openEditPersonPicker" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">指定人员添加</button>
          </view>
          <view class="field field-mt-16">
            <view class="field-label">驳回后重新提交</view>
            <picker range="{{['重新逐层审批','直接到驳回人']}}" bindchange="onEditResubmitModeChange">
              <view class="picker-value">{{editResubmitMode === 'fresh' ? '重新逐层审批' : '直接到驳回人'}}</view>
            </picker>
          </view>
        </view>

        <!-- Files -->
        <view class="card">
          <view class="section-title">当前附件 ({{editFiles.length}}份)</view>
          <view class="file-attach-item" wx:for="{{editFiles}}" wx:key="id">
            <view class="file-attach-icon"><ui-icon name="file" tone="primary" size="24" ariaLabel="附件" /></view>
            <view class="file-attach-name">{{item.fileName}}</view>
            <view class="list-actions"><text class="audit-link-btn audit-link-danger ui-motion-chip" data-index="{{index}}" bindtap="removeEditFile" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text></view>
          </view>
          <view class="section-title field-mt-16" wx:if="{{editNewFiles.length}}">新增附件 ({{editNewFiles.length}}份)</view>
          <view class="file-attach-item" wx:for="{{editNewFiles}}" wx:key="fileId">
            <view class="file-attach-icon"><ui-icon name="file" tone="primary" size="24" ariaLabel="附件" /></view>
            <view class="file-attach-name">{{item.fileName}}</view>
            <view class="list-actions"><text class="audit-link-btn audit-link-danger ui-motion-chip" data-index="{{index}}" bindtap="removeEditNewFile" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text></view>
          </view>
          <view class="button-row compact-row">
            <button class="secondary-btn ui-motion-button" bindtap="editChooseImage" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">选择图片</button>
            <button class="secondary-btn ui-motion-button" bindtap="editChooseFile" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">选择文件</button>
          </view>
        </view>

        <view class="card">
          <view class="audit-btn-bar">
            <button class="primary-btn ui-motion-button" loading="{{loading}}" bindtap="saveEdit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存修改</button>
            <button class="secondary-btn ui-motion-button" bindtap="cancelEdit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
          </view>
        </view>
      </view>

      <!-- ═══ Edit: Identity step editor popup ═══ -->
      <viewport-portal wx:if="{{editStepEditorVisible}}">
      <view class="popup-mask ui-overlay" wx:if="{{editStepEditorVisible}}" bindtap="closeEditStepEditor">
        <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
        <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
          <view class="popup-header ui-dialog-header"><view class="popup-title">添加审批步骤 — 按身份</view><text class="popup-close ui-motion-chip" catchtap="closeEditStepEditor" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-content ui-dialog-scroll--fill" scroll-y>
            <view class="detail-popup-form ui-dialog-stack">
              <view class="field">
                <view class="field-label">步骤名称</view>
                <input class="field-input" value="{{editStepForm.name}}" data-field="name" bindinput="onEditStepFieldInput" placeholder="如：部门负责人审批"/>
              </view>
              <view class="field">
                <view class="field-label">审批动作</view>
                <picker range="{{['通过','签字','盖章','签字+盖章']}}" bindchange="onEditActionTypeChange">
                  <view class="picker-value">{{editStepForm.actionType === 'pass' ? '通过' : (editStepForm.actionType === 'sign' ? '签字' : (editStepForm.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
                </picker>
              </view>
              <view class="field">
                <view class="field-label">审批范围</view>
                <picker range="{{identityPickerScopeOptions}}" bindchange="onEditIdentityScopeChange">
                  <view class="picker-value">{{identityPickerScopeOptions[editIdentityPickerScopeIndex] || '全体成员'}}</view>
                </picker>
              </view>
              <view class="field" wx:if="{{identityPickerScopeValues[editIdentityPickerScopeIndex] === 'specific_department' || identityPickerScopeValues[editIdentityPickerScopeIndex] === 'specific_work_group'}}">
                <view class="field-label">指定部门</view>
                <picker range="{{identityPickerDeptOptions}}" bindchange="onEditIdentityDeptChange">
                  <view class="picker-value">{{identityPickerDeptOptions[editIdentityPickerDeptIndex] || '请选择部门'}}</view>
                </picker>
              </view>
              <view class="field" wx:if="{{identityPickerScopeValues[editIdentityPickerScopeIndex] === 'specific_work_group'}}">
                <view class="field-label">指定职能组</view>
                <picker range="{{identityPickerWgOptions}}" bindchange="onEditIdentityWgChange">
                  <view class="picker-value">{{identityPickerWgOptions[editIdentityPickerWgIndex] || '请选择职能组'}}</view>
                </picker>
              </view>
              <view class="field">
                <view class="field-label">审批人身份</view>
                <picker range="{{identityPickerIdentOptions}}" bindchange="onEditIdentityIdentChange">
                  <view class="picker-value">{{identityPickerIdentOptions[editIdentityPickerIdentIndex] || '请选择身份'}}</view>
                </picker>
              </view>
            </view>
          </scroll-view>
          <view class="audit-btn-bar ui-dialog-footer"><button class="primary-btn ui-motion-button" catchtap="confirmEditIdentityStep" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">确定</button></view>
        </view>
      </view>
      </viewport-portal>

      <!-- ═══ Edit: Person picker popup ═══ -->
      <viewport-portal wx:if="{{editPersonPickerVisible}}">
      <view class="popup-mask ui-overlay" wx:if="{{editPersonPickerVisible}}" bindtap="closeEditPersonPicker">
        <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
        <view class="popup-card desig-popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
          <view class="popup-header ui-dialog-header"><view class="popup-title">指定审批人员</view><text class="popup-close ui-motion-chip" catchtap="closeEditPersonPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="ui-dialog-body ui-dialog-content ui-dialog-scroll--fill ui-dialog-stack-scroll">
          <view class="list-title">已选人员（{{editPersonPickerSelectedIds.length}}人）</view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="desig-inner-scroll desig-current-scroll ui-dialog-scroll--pane ui-dialog-selection-current">
            <view class="audit-person-item" wx:for="{{editPersonPickerSelectedList}}" wx:key="id">
              <view class="audit-person-avatar">{{item.name[0]}}</view>
              <view class="audit-person-info">
                <view class="audit-person-name">{{item.name}}</view>
                <view class="audit-person-detail">{{item.department}} · {{item.identity}} · {{item.studentId}}</view>
              </view>
              <view class="inline-actions list-actions-below">
                <text class="audit-link-btn audit-link-danger ui-motion-chip" data-hr-id="{{item.id}}" catchtap="onEditPersonToggle" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text>
              </view>
            </view>
            <view class="empty-inline" wx:if="{{!editPersonPickerSelectedList.length}}">暂无已选人员</view>
            <view class="scroll-tail-space"></view>
          </scroll-view>
          <view class="list-title field-mt-8">可选人员</view>
          <view class="rule-filter-row">
            <view class="rule-filter-field"><view class="field-label">部门</view><picker range="{{personPickerDeptOpts}}" bindchange="onEditPersonPickerDeptChange"><view class="picker-value compact-picker-value">{{editPersonPickerDept}}</view></picker></view>
            <view class="rule-filter-field"><view class="field-label">身份</view><picker range="{{personPickerIdentOpts}}" bindchange="onEditPersonPickerIdentChange"><view class="picker-value compact-picker-value">{{editPersonPickerIdent}}</view></picker></view>
            <view class="rule-filter-field"><view class="field-label">职能组</view><picker range="{{personPickerWgOpts}}" bindchange="onEditPersonPickerWgChange"><view class="picker-value compact-picker-value">{{editPersonPickerWg}}</view></picker></view>
          </view>
          <view class="field field-mb-8"><input class="field-input" placeholder="搜索姓名/学号" value="{{editPersonPickerKeyword}}" bindinput="onEditPersonPickerSearch"/></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="desig-inner-scroll desig-candidate-scroll ui-dialog-scroll--pane ui-dialog-selection-options">
            <view wx:if="{{!editPersonPickerCandidates.length}}" class="empty-inline">没有匹配的人员</view>
            <view class="audit-person-item ui-motion-card" wx:for="{{editPersonPickerCandidates}}" wx:key="id" data-hr-id="{{item.id}}" catchtap="onEditPersonToggle" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
              <view class="audit-person-avatar">{{item.name[0]}}</view>
              <view class="audit-person-info">
                <view class="audit-person-name"><view class="select-chip select-chip-inline {{item.isSelected ? 'select-chip-active' : ''}}">{{item.isSelected ? '已选' : '选择'}}</view>{{item.name}}</view>
                <view class="audit-person-detail">{{item.studentId}} · {{item.department}} · {{item.identity}}<text wx:if="{{item.workGroup}}"> · {{item.workGroup}}</text></view>
              </view>
            </view>
            <view class="scroll-tail-space"></view>
          </scroll-view>
          <view class="field field-mt-8">
            <view class="field-label">审批动作</view>
            <picker range="{{['通过','签字','盖章','签字+盖章']}}" bindchange="onEditPersonPickerActionTypeChange">
              <view class="picker-value">{{editPersonPickerStepActionType === 'pass' ? '通过' : (editPersonPickerStepActionType === 'sign' ? '签字' : (editPersonPickerStepActionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
            </picker>
          </view>
          </scroll-view>
          <view class="button-row ui-dialog-footer">
            <button class="secondary-btn ui-motion-button" catchtap="closeEditPersonPicker" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
            <button class="primary-btn ui-motion-button" catchtap="confirmEditPersonPicker" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">添加 {{editPersonPickerSelectedIds.length}} 人</button>
          </view>
        </view>
      </view>
      </viewport-portal>
    </block>
  </view>

  <!-- ═══ Stamp Picker Popup ═══ -->
  <viewport-portal wx:if="{{stampPickerVisible}}">
  <view class="popup-mask ui-overlay" wx:if="{{stampPickerVisible}}" bindtap="closeStampPicker">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">选择印章</view>
        <text class="popup-close ui-motion-chip" catchtap="closeStampPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-content ui-dialog-scroll--fill" scroll-y>
        <view class="detail-popup-form ui-dialog-stack">
          <view wx:if="{{!availableStamps.length}}" class="stamp-empty">暂无可用的印章</view>
          <view wx:for="{{availableStamps}}" wx:key="id"
                class="stamp-picker-item ui-motion-card"
                data-stamp-id="{{item.id}}" data-stamp-name="{{item.name}}" data-stamp-image="{{item.imageData}}"
                catchtap="onStampSelect" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="aspectFit" class="stamp-picker-thumb" />
            <view wx:else class="stamp-picker-placeholder"><view class="stamp-placeholder-mark"></view></view>
            <text class="stamp-picker-name">{{item.name}}</text>
            <text class="stamp-picker-select">选择</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  </viewport-portal>

  <!-- ═══ Placement / File Preview Popup (positioning sig/stamp on file) ═══ -->
  <viewport-portal wx:if="{{placementVisible}}">
  <view class="popup-mask ui-overlay" wx:if="{{placementVisible}}" bindtap="closePlacement">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card placement-popup ui-dialog-shell ui-dialog-shell--wide ui-data-grid--specialized" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">调整签名位置 · {{placementFileName}}</view>
        <text class="popup-close ui-motion-chip" catchtap="closePlacement" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>

      <!-- Hint -->
      <view class="placement-hint">
        点击文件放置{{placementType === 'stamp' ? '印章' : '签名'}}，再次点击可调整
        <text wx:if="{{placementCurrentPage > 0 && placementTotalPages > 1}}" class="placement-hint-page">
          · 当前：第{{placementCurrentPage}}页
        </text>
      </view>

      <!-- Page selector for PDFs -->
      <view wx:if="{{placementFileMime === 'application/pdf' && placementTotalPages > 1}}"
            class="placement-page-selector">
        <text class="placement-page-btn ui-motion-chip"
              data-dir="prev" catchtap="onPlacementPageChange"
              wx:if="{{placementCurrentPage > 1}}"
              hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">◀ 上一页</text>
        <text class="placement-page-num">第 {{placementCurrentPage}} / {{placementTotalPages}} 页</text>
        <text class="placement-page-btn ui-motion-chip"
              data-dir="next" catchtap="onPlacementPageChange"
              wx:if="{{placementCurrentPage < placementTotalPages}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">下一页 ▶</text>
      </view>

      <!-- Placement canvas — scrollable to show full file -->
      <scroll-view id="placementCanvas"
            enhanced="{{true}}"
            show-scrollbar="{{true}}"
            bounces="{{true}}"
            nested-scroll-enabled="{{true}}"
            scroll-y="{{true}}"
            class="placement-canvas ui-dialog-body ui-dialog-content ui-dialog-content--workspace ui-dialog-scroll--fill"
            bindtap="onPlacementTap">
        <!-- Loading indicator -->
        <view wx:if="{{placementLoading}}"
              class="placement-loading">
          <ui-icon name="clock" tone="muted" size="24" ariaLabel="加载中" />
          <text>加载文件预览中…</text>
        </view>
        <!-- File preview (image or rendered PDF page) -->
        <block wx:elif="{{placementFileImage}}">
          <view class="placement-img-wrap">
            <image id="placementPreviewImage" src="{{placementFileImage}}" mode="widthFix"
                   class="placement-preview-img" />
            <!-- Overlaid signatures/stamps -->
            <block wx:for="{{placementItems}}" wx:key="dispIdx" wx:for-item="item">
              <block wx:if="{{!placementFileMime || placementFileMime.indexOf('pdf') < 0 || item.page === placementCurrentPage}}">
                <image src="{{item.previewSrc}}"
                       mode="aspectFit"
                       data-sig-idx="{{item.dispIdx}}"
                       catchtap="onPlacementItemTap"
                       class="placement-sign-overlay {{placementActiveIdx === item.dispIdx ? 'placement-sign-overlay-active' : ''}} ui-motion-card"
                       style="left:{{item.positionX * 100}}%;top:{{item.positionY * 100}}%;width:{{18 * (item.size || 1)}}%;height:{{112 * (item.size || 1)}}rpx;transform:translate(-50%, -50%) rotate({{item.rotation || 0}}deg);"  hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"/>
              </block>
            </block>
            <!-- Crosshair showing current position -->
            <view wx:if="{{placementPreviewX >= 0}}" class="placement-crosshair placement-crosshair-v" style="left:{{placementPreviewX * 100}}%;top:{{placementPreviewY * 100}}%;"></view>
            <view wx:if="{{placementPreviewX >= 0}}" class="placement-crosshair placement-crosshair-h" style="left:{{placementPreviewX * 100}}%;top:{{placementPreviewY * 100}}%;"></view>
          </view>
        </block>
        <!-- Fallback: no preview available -->
        <view wx:else class="placement-fallback">
          <view class="placement-fallback-icon"><ui-icon name="file" tone="muted" size="48" ariaLabel="文件预览" /></view>
          <view>{{placementFileName}}</view>
          <view class="placement-fallback-sub">
            {{placementFileMime === 'application/pdf' ? 'PDF文件 · 点击区域放置签名 · 第' + placementCurrentPage + '页' : '点击区域放置' + (placementType === 'stamp' ? '印章' : '签名')}}
          </view>
        </view>
      </scroll-view>

      <!-- Position info -->
      <view wx:if="{{placementPreviewX >= 0 && placementPosText}}" class="placement-pos-info">
        位置：{{placementPosText}}
        <text wx:if="{{placementCurrentPage > 0 && placementTotalPages > 1}}"> · 第{{placementCurrentPage}}页</text>
      </view>

      <view class="placement-transform-panel" wx:if="{{placementActiveIdx >= 0}}">
        <view class="placement-transform-row">
          <text class="placement-transform-label">大小 {{placementSize}}%</text>
          <slider class="placement-slider" min="50" max="220" step="5" value="{{placementSize}}" activeColor="#2563eb" backgroundColor="#dbeafe" block-size="18" bindchanging="onPlacementSizeChange" bindchange="onPlacementSizeChange" />
        </view>
        <view class="placement-transform-row">
          <text class="placement-transform-label">旋转 {{placementRotation}}°</text>
          <slider class="placement-slider" min="-180" max="180" step="5" value="{{placementRotation}}" activeColor="#2563eb" backgroundColor="#dbeafe" block-size="18" bindchanging="onPlacementRotationChange" bindchange="onPlacementRotationChange" />
        </view>
        <view class="placement-rotate-actions">
          <button class="secondary-btn placement-mini-btn ui-motion-button" data-delta="-15" catchtap="nudgePlacementRotation" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">左转</button>
          <button class="secondary-btn placement-mini-btn ui-motion-button" catchtap="resetPlacementTransform" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">重置</button>
          <button class="secondary-btn placement-mini-btn ui-motion-button" data-delta="15" catchtap="nudgePlacementRotation" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">右转</button>
        </view>
      </view>

      <view class="placement-actions ui-dialog-footer">
        <button class="secondary-btn placement-btn-cancel ui-motion-button" catchtap="closePlacement" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
        <button class="secondary-btn placement-btn-copy ui-motion-button" catchtap="addPlacementCopy" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">再放一处</button>
        <button class="primary-btn placement-btn-save ui-motion-button" catchtap="confirmPlacement" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存位置</button>
      </view>
    </view>
  </view>
  </viewport-portal>

  <!-- Approval Dialog -->
  <viewport-portal wx:if="{{approvalVisible}}">
  <view class="popup-mask ui-overlay" wx:if="{{approvalVisible}}" bindtap="closeApproval">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">{{approvalAction === 'approve' ? '审批通过' : '驳回'}}</view>
        <text class="popup-close ui-motion-chip" catchtap="closeApproval" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-content ui-dialog-scroll--fill" scroll-y>
        <view class="detail-popup-form ui-dialog-stack">
          <!-- Signature section (only for approve) -->
          <view wx:if="{{approvalAction === 'approve'}}">
            <view class="list-title">签名/盖章</view>
            <view class="sign-file-card" wx:for="{{pendingSignatures}}" wx:key="index">
              <view class="sign-file-main">
                <view class="sign-file-name">签名{{index + 1}}</view>
                <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="widthFix" class="sign-file-preview" />
              </view>
              <view class="list-actions"><text class="audit-link-btn audit-link-danger ui-motion-chip" data-index="{{index}}" catchtap="removePendingSignature" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text></view>
            </view>
            <view class="button-row compact-row">
              <button class="secondary-btn ui-motion-button" wx:for="{{files}}" wx:key="id" data-file-id="{{item.id}}" catchtap="openSignaturePad" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">签在 {{item.fileName}}</button>
            </view>
            <view class="field approval-dialog-field-mt">
              <view class="field-label">审批意见</view>
              <textarea class="field-textarea" auto-height maxlength="-1" value="{{approvalComment}}" bindinput="onApprovalCommentInput" placeholder="可选：填写审批意见" />
            </view>
          </view>

          <!-- Reject reason -->
          <view wx:if="{{approvalAction === 'reject'}}">
            <view class="field">
              <view class="field-label">驳回理由</view>
              <textarea class="field-textarea" auto-height maxlength="-1" value="{{rejectionReason}}" bindinput="onRejectionReasonInput" placeholder="请填写驳回理由（必填）" />
            </view>
          </view>

        </view>
      </scroll-view>
      <view class="audit-btn-bar ui-dialog-footer">
        <button class="primary-btn ui-motion-button" loading="{{loading}}" catchtap="confirmApproval" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{approvalAction === 'approve' ? '确认通过' : '确认驳回'}}</button>
      </view>
    </view>
  </view>
  </viewport-portal>

  <!-- ═══ Signature Source Picker Popup (saved signatures + new drawing) ═══ -->
  <viewport-portal wx:if="{{sigSourcePickerVisible}}">
  <view class="popup-mask ui-overlay" wx:if="{{sigSourcePickerVisible}}" bindtap="closeSigSourcePicker">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">选择签名方式</view>
        <text class="popup-close ui-motion-chip" catchtap="closeSigSourcePicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-content ui-dialog-scroll--fill" scroll-y>
        <view class="detail-popup-form ui-dialog-stack">
          <view class="sig-source-file-name">{{sigSourceFileName}}</view>

          <!-- Saved Signatures -->
          <view wx:if="{{mySignatures.length}}" class="sig-source-section">
            <view class="sig-source-section-title">我的签名</view>
            <view wx:for="{{mySignatures}}" wx:key="id"
                  class="sig-source-item ui-motion-card"
                  data-sig-id="{{item.id}}" data-sig-image="{{item.imageData}}"
                  catchtap="onSelectSavedSignature" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
              <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="aspectFit"
                     class="sig-source-thumb" />
              <view wx:else class="sig-source-thumb-placeholder"><ui-icon name="signature" tone="muted" size="38" ariaLabel="签名" /></view>
              <view class="sig-source-item-info">
                <view class="sig-source-item-name">{{item.name}}</view>
                <view wx:if="{{item.isDefault}}" class="sig-source-default-badge">默认签名</view>
              </view>
              <text class="sig-source-use-btn">使用</text>
            </view>
          </view>

          <!-- No saved signatures -->
          <view wx:if="{{!mySignatures.length}}" class="sig-source-empty">
            暂无已保存的签名
          </view>

          <!-- Divider -->
          <view class="sig-source-divider">
            <view class="sig-source-divider-line"></view>
            <text class="sig-source-divider-text">或</text>
            <view class="sig-source-divider-line"></view>
          </view>

          <!-- Draw new signature -->
          <view class="sig-source-draw-section">
            <view class="sig-source-draw-title">手写新签名</view>
            <!-- Save option -->
            <view class="sig-source-save-row ui-motion-card" catchtap="onSigSaveToggle" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
              <view style="width:36rpx;height:36rpx;border-radius:6rpx;border:2rpx solid {{sigSaveNew ? '#3b82f6' : '#cbd5e1'}};background:{{sigSaveNew ? '#3b82f6' : '#fff'}};display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <text wx:if="{{sigSaveNew}}" class="sig-source-check-icon">✓</text>
              </view>
              <text class="sig-source-save-label">保存到我的签名</text>
            </view>
            <view wx:if="{{sigSaveNew}}" class="sig-source-save-input-wrap">
              <input class="sig-source-save-input"
                     placeholder="签名名称（可选）" value="{{sigSaveName}}" bindinput="onSigSaveNameInput" />
            </view>
            <button class="primary-btn sig-source-draw-btn ui-motion-button" catchtap="onOpenNewSignaturePad" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">手写签名</button>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  </viewport-portal>

  <!-- Signature Pad Popup (with save-to-library controls) -->
  <!-- ★ catchtouchmove="noop" 阻止触摸滑动穿透到底层页面，防止签名时页面翻动 -->
  <viewport-portal wx:if="{{signaturePadVisible}}">
  <view class="popup-mask ui-overlay ui-dialog-touch-lock" wx:if="{{signaturePadVisible}}" bindtap="closeSignaturePad" catchtouchmove="noop">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex ui-dialog-touch-lock" catchtap="noop" catchtouchmove="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">手写签名</view>
        <text class="popup-close ui-motion-chip" catchtap="closeSignaturePad" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>
      <view class="ui-dialog-body ui-dialog-content ui-dialog-content--workspace signature-pad-dialog-body">
        <signature-pad bindconfirm="onSignatureConfirm" />
      </view>
    </view>
  </view>
  </viewport-portal>

    <!-- ═══ Person picker popup (multi-select) ═══ -->
  <viewport-portal wx:if="{{personPickerVisible}}">
  <view class="popup-mask ui-overlay" wx:if="{{personPickerVisible}}" bindtap="closePersonPicker">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
      <view class="popup-card desig-popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
        <view class="popup-header ui-dialog-header"><view class="popup-title">指定审批人员</view><text class="popup-close ui-motion-chip" catchtap="closePersonPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text></view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="ui-dialog-body ui-dialog-content ui-dialog-scroll--fill ui-dialog-stack-scroll">

        <!-- Selected persons -->
        <view class="list-title">已选人员（{{personPickerSelectedIds.length}}人）</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="desig-inner-scroll desig-current-scroll ui-dialog-scroll--pane ui-dialog-selection-current">
          <view class="audit-person-item" wx:for="{{personPickerSelectedList}}" wx:key="id">
            <view class="audit-person-avatar">{{item.name[0]}}</view>
            <view class="audit-person-info">
              <view class="audit-person-name">{{item.name}}</view>
              <view class="audit-person-detail">{{item.department}} · {{item.identity}} · {{item.studentId}}</view>
            </view>
            <view class="inline-actions list-actions-below">
              <text class="audit-link-btn audit-link-danger ui-motion-chip" data-hr-id="{{item.id}}" catchtap="onPersonToggle" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!personPickerSelectedList.length}}">暂无已选人员</view>
          <view class="scroll-tail-space"></view>
        </scroll-view>

        <!-- Filters -->
        <view class="list-title field-mt-8">可选人员</view>
        <view class="rule-filter-row">
          <view class="rule-filter-field">
            <view class="field-label">部门</view>
            <picker range="{{personPickerDeptOpts}}" bindchange="onPersonPickerDeptChange">
              <view class="picker-value compact-picker-value">{{personPickerDept}}</view>
            </picker>
          </view>
          <view class="rule-filter-field">
            <view class="field-label">身份</view>
            <picker range="{{personPickerIdentOpts}}" bindchange="onPersonPickerIdentChange">
              <view class="picker-value compact-picker-value">{{personPickerIdent}}</view>
            </picker>
          </view>
          <view class="rule-filter-field">
            <view class="field-label">职能组</view>
            <picker range="{{personPickerWgOpts}}" bindchange="onPersonPickerWgChange">
              <view class="picker-value compact-picker-value">{{personPickerWg}}</view>
            </picker>
          </view>
        </view>
        <view class="field field-mb-8">
          <input class="field-input" placeholder="搜索姓名/学号" value="{{personPickerKeyword}}" bindinput="onPersonPickerSearch"/>
        </view>

        <!-- Candidate list -->
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="desig-inner-scroll desig-candidate-scroll ui-dialog-scroll--pane ui-dialog-selection-options">
          <view wx:if="{{!personPickerCandidates.length}}" class="empty-inline">没有匹配的人员</view>
          <view class="audit-person-item ui-motion-card" wx:for="{{personPickerCandidates}}" wx:key="id" data-hr-id="{{item.id}}" catchtap="onPersonToggle" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="audit-person-avatar">{{item.name[0]}}</view>
            <view class="audit-person-info">
              <view class="audit-person-name">
                <view class="select-chip select-chip-inline {{item.isSelected ? 'select-chip-active' : ''}}">{{item.isSelected ? '已选' : '选择'}}</view>
                {{item.name}}
              </view>
              <view class="audit-person-detail">{{item.studentId}} · {{item.department}} · {{item.identity}}<text wx:if="{{item.workGroup}}"> · {{item.workGroup}}</text></view>
            </view>
          </view>
          <view class="scroll-tail-space"></view>
        </scroll-view>

        <!-- Action type (only for ad-hoc mode; template/designate-next modes inherit step definition) -->
        <view class="field field-mt-8" wx:if="{{templateOverrideStepIndex < 0 && personPickerMode !== 'designateNext'}}">
          <view class="field-label">审批动作</view>
          <picker range="{{['通过','签字','盖章','签字+盖章']}}" bindchange="onPersonPickerActionTypeChange">
            <view class="picker-value">{{personPickerStepActionType === 'pass' ? '通过' : (personPickerStepActionType === 'sign' ? '签字' : (personPickerStepActionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
          </picker>
        </view>
        </scroll-view>

        <view class="button-row ui-dialog-footer">
          <button class="secondary-btn ui-motion-button" catchtap="closePersonPicker" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
          <button class="primary-btn ui-motion-button" catchtap="confirmPersonPicker" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">添加 {{personPickerSelectedIds.length}} 人</button>
        </view>
      </view>
    </view>
  </viewport-portal>

  <view class="page-footer">
    <view class="footer-name">WHUSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>
</view>

<view class="page">
  <view class="hero">
    <view class="hero-badge">审核</view>
    <view class="hero-title" wx:if="{{action === 'create'}}">发起新审核</view>
    <view class="hero-title" wx:else>{{submission.title || submission.submissionNumber || '审核详情'}}</view>
    <view class="hero-subtitle" wx:if="{{action === 'view' && submission}}">{{submission.submissionNumber}} · {{submission.submitterName}}</view>
  </view>

  <!-- ═══════════ Create Mode ═══════════ -->
  <view class="section" wx:if="{{action === 'create'}}">
    <view class="card">
      <view class="section-title">审核类型</view>
      <view class="button-row">
        <button class="{{createMode === 'template' ? 'primary-btn' : 'secondary-btn'}}" data-mode="template" bindtap="onCreateModeChange">从模板创建</button>
        <button class="{{createMode === 'ad_hoc' ? 'primary-btn' : 'secondary-btn'}}" data-mode="ad_hoc" bindtap="onCreateModeChange">临时审批</button>
      </view>
    </view>

    <!-- Template mode -->
    <view class="card" wx:if="{{createMode === 'template'}}">
      <view class="section-title">选择审核流模板</view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll small-scroll" scroll-y>
        <view class="template-select-item {{selectedTemplateId === item.id ? 'template-select-item-selected' : ''}}" wx:for="{{flowTemplates}}" wx:key="id" data-id="{{item.id}}" catchtap="onTemplateSelect">
          <view class="radio-dot {{selectedTemplateId === item.id ? 'radio-dot-checked' : ''}}"></view>
          <view class="list-main">
            <view class="list-name">{{item.name}} <text class="list-desc">({{item.stepCount}}步 · {{item.resubmitMode === 'fresh' ? '重新逐层' : '回到驳回人'}})</text></view>
            <view class="list-desc" wx:if="{{item.description}}">{{item.description}}</view>
          </view>
        </view>
        <view class="audit-empty-state" wx:if="{{!flowTemplates.length}}">
          <view class="audit-empty-icon">📄</view>
          <view class="audit-empty-text">暂无可用的审核流模板</view>
        </view>
      </scroll-view>
    </view>

    <!-- Ad-hoc mode -->
    <view class="card" wx:if="{{createMode === 'ad_hoc'}}">
      <view class="section-title">审批步骤 ({{adHocSteps.length}}步)</view>
      <view class="ad-hoc-step-item" wx:for="{{adHocSteps}}" wx:key="index">
        <view class="ad-hoc-step-main">
          <view class="ad-hoc-step-title">第{{index + 1}}步：{{item.approverType === 'specific_person' ? item.approverHrName : (item.approverIdentityName + '（' + (item.scopeType === 'same_department' ? '同部门' : (item.scopeType === 'same_work_group' ? '同职能组' : (item.scopeType === 'specific_department' ? item.scopeDepartmentName : (item.scopeType === 'specific_work_group' ? item.scopeDepartmentName + '·' + item.scopeWorkGroupName : '全体')))) + '）')}} — {{item.actionType === 'pass' ? '仅通过' : (item.actionType === 'sign' ? '签字' : (item.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
          <view class="ad-hoc-step-desc">{{item.approverType === 'identity' ? '按身份审批' : '指定人员审批'}}</view>
        </view>
        <view class="list-actions"><text class="audit-link-btn audit-link-danger" data-index="{{index}}" bindtap="removeAdHocStep">移除</text></view>
      </view>
      <view class="audit-empty-state" wx:if="{{!adHocSteps.length}}">
        <view class="audit-empty-text">尚未添加审批步骤</view>
      </view>
      <view class="button-row compact-row"><button class="secondary-btn" bindtap="openAdHocStepEditor">添加步骤 (按身份)</button><button class="secondary-btn" bindtap="openPersonPicker">添加步骤 (指定人员)</button></view>
      <view class="field" style="margin-top:16rpx;">
        <view class="field-label">驳回重提交模式</view>
        <picker range="{{['重新逐层审批','直接到驳回人']}}" bindchange="onResubmitModeChange">
          <view class="picker-value">{{resubmitMode === 'fresh' ? '重新逐层审批' : '直接到驳回人'}}</view>
        </picker>
      </view>
    </view>

    <!-- Common: Title + Files -->
    <view class="card">
      <view class="section-title">基本信息</view>
      <view class="field">
        <view class="field-label">标题</view>
        <input class="field-input" value="{{createTitle}}" bindinput="onTitleInput" placeholder="请输入审核标题" />
      </view>
      <view class="section-title" style="margin-top:16rpx;">附件 ({{uploadedFiles.length}}份)</view>
      <view class="file-attach-item" wx:for="{{uploadedFiles}}" wx:key="fileId">
        <view class="file-attach-icon">📎</view>
        <view class="file-attach-name">{{item.fileName}}</view>
        <view class="list-actions"><text class="audit-link-btn audit-link-danger" data-index="{{index}}" bindtap="removeUploadedFile">移除</text></view>
      </view>
      <view class="button-row compact-row">
        <button class="secondary-btn" bindtap="chooseImage">选择图片</button>
        <button class="secondary-btn" bindtap="chooseFile">选择文件</button>
      </view>
      <view class="audit-btn-bar">
        <button class="primary-btn" loading="{{loading}}" bindtap="submitAudit">提交审核</button>
      </view>
    </view>

    <!-- ═══ Identity step editor popup ═══ -->
    <view class="popup-mask" wx:if="{{adHocStepEditorVisible}}" bindtap="closeAdHocStepEditor">
      <view class="popup-card" catchtap="noop">
        <view class="popup-header"><view class="popup-title">添加审批步骤 — 按身份</view><text class="popup-close" bindtap="closeAdHocStepEditor">关闭</text></view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y>
          <view class="detail-popup-form">
            <view class="field">
              <view class="field-label">审批动作</view>
              <picker range="{{['仅通过','签字','盖章','签字+盖章']}}" bindchange="onAdHocActionTypeChange">
                <view class="picker-value">{{adHocStepForm.actionType === 'pass' ? '仅通过' : (adHocStepForm.actionType === 'sign' ? '签字' : (adHocStepForm.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
              </picker>
            </view>
            <view class="field">
              <view class="field-label">审批范围</view>
              <picker range="{{identityPickerScopeOptions}}" bindchange="onIdentityScopeChange">
                <view class="picker-value">{{identityPickerScopeOptions[identityPickerScopeIndex] || '全体成员'}}</view>
              </picker>
            </view>
            <view class="field" wx:if="{{identityPickerScopeValues[identityPickerScopeIndex] === 'specific_department' || identityPickerScopeValues[identityPickerScopeIndex] === 'specific_work_group'}}">
              <view class="field-label">指定部门</view>
              <picker range="{{identityPickerDeptOptions}}" bindchange="onIdentityDeptChange">
                <view class="picker-value">{{identityPickerDeptOptions[identityPickerDeptIndex] || '请选择部门'}}</view>
              </picker>
            </view>
            <view class="field" wx:if="{{identityPickerScopeValues[identityPickerScopeIndex] === 'specific_work_group'}}">
              <view class="field-label">指定职能组</view>
              <picker range="{{identityPickerWgOptions}}" bindchange="onIdentityWgChange">
                <view class="picker-value">{{identityPickerWgOptions[identityPickerWgIndex] || '请选择职能组'}}</view>
              </picker>
            </view>
            <view class="field">
              <view class="field-label">审批人身份</view>
              <picker range="{{identityPickerIdentOptions}}" bindchange="onIdentityIdentChange">
                <view class="picker-value">{{identityPickerIdentOptions[identityPickerIdentIndex] || '请选择身份'}}</view>
              </picker>
            </view>
            <view class="audit-btn-bar"><button class="primary-btn" bindtap="confirmAdHocStep">确定</button></view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- ═══ Person picker popup (multi-select) ═══ -->
    <view class="popup-mask" wx:if="{{personPickerVisible}}" bindtap="closePersonPicker">
      <view class="popup-card desig-popup-card" catchtap="noop">
        <view class="popup-header"><view class="popup-title">指定审批人员</view><text class="popup-close" bindtap="closePersonPicker">关闭</text></view>

        <!-- Selected persons -->
        <view class="list-title">已选人员（{{personPickerSelectedIds.length}}人）</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-current-scroll">
          <view class="audit-person-item" wx:for="{{personPickerSelectedList}}" wx:key="id">
            <view class="audit-person-avatar">{{item.name[0]}}</view>
            <view class="audit-person-info">
              <view class="audit-person-name">{{item.name}}</view>
              <view class="audit-person-detail">{{item.department}} · {{item.identity}} · {{item.studentId}}</view>
            </view>
            <view class="inline-actions list-actions-below">
              <text class="audit-link-btn audit-link-danger" data-hr-id="{{item.id}}" bindtap="onPersonToggle">移除</text>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!personPickerSelectedList.length}}">尚未选择任何人</view>
        </scroll-view>

        <!-- Filters -->
        <view class="list-title" style="margin-top:8rpx;">可选人员</view>
        <view class="rule-filter-row">
          <view class="rule-filter-field">
            <view class="field-label">部门</view>
            <picker range="{{personPickerDeptOpts}}" bindchange="onPersonPickerDeptChange">
              <view class="picker-value compact-picker-value">{{personPickerDept}}</view>
            </picker>
          </view>
          <view class="rule-filter-field">
            <view class="field-label">身份</view>
            <picker range="{{personPickerIdentOpts}}" bindchange="onPersonPickerIdentChange">
              <view class="picker-value compact-picker-value">{{personPickerIdent}}</view>
            </picker>
          </view>
          <view class="rule-filter-field">
            <view class="field-label">职能组</view>
            <picker range="{{personPickerWgOpts}}" bindchange="onPersonPickerWgChange">
              <view class="picker-value compact-picker-value">{{personPickerWg}}</view>
            </picker>
          </view>
        </view>
        <view class="field" style="margin-bottom:8rpx;">
          <input class="field-input" placeholder="搜索姓名/学号" value="{{personPickerKeyword}}" bindinput="onPersonPickerSearch"/>
        </view>

        <!-- Candidate list -->
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-candidate-scroll">
          <view wx:if="{{!personPickerCandidates.length}}" class="empty-inline">没有匹配的人员</view>
          <view class="audit-person-item" wx:for="{{personPickerCandidates}}" wx:key="id" data-hr-id="{{item.id}}" bindtap="onPersonToggle">
            <view class="audit-person-avatar">{{item.name[0]}}</view>
            <view class="audit-person-info">
              <view class="audit-person-name">
                <view class="select-chip select-chip-inline {{item.isSelected ? 'select-chip-active' : ''}}">{{item.isSelected ? '已选' : '选择'}}</view>
                {{item.name}}
              </view>
              <view class="audit-person-detail">{{item.studentId}} · {{item.department}} · {{item.identity}}<text wx:if="{{item.workGroup}}"> · {{item.workGroup}}</text></view>
            </view>
          </view>
        </scroll-view>

        <!-- Action type -->
        <view class="field" style="margin-top:8rpx;">
          <view class="field-label">审批动作</view>
          <picker range="{{['仅通过','签字','盖章','签字+盖章']}}" bindchange="onPersonPickerActionTypeChange">
            <view class="picker-value">{{personPickerStepActionType === 'pass' ? '仅通过' : (personPickerStepActionType === 'sign' ? '签字' : (personPickerStepActionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
          </picker>
        </view>

        <view class="button-row">
          <button class="secondary-btn" bindtap="closePersonPicker">取消</button>
          <button class="primary-btn" bindtap="confirmPersonPicker">添加 {{personPickerSelectedIds.length}} 人</button>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══════════ View Mode ═══════════ -->
  <view class="section" wx:if="{{action === 'view'}}">
    <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>

    <block wx:if="{{!loading && submission}}">
      <!-- Status -->
      <view class="card">
        <view class="info-grid">
          <view class="info-block">
            <view class="info-label">状态</view>
            <view class="info-value">
              <view class="detail-status-chip {{submission.status === 'approved' ? 'detail-status-approved' : (submission.status === 'rejected' ? 'detail-status-rejected' : (submission.status === 'in_progress' ? 'detail-status-progress' : (submission.status === 'draft' ? 'detail-status-draft' : (submission.status === 'pending' ? 'detail-status-pending' : (submission.status === 'withdrawn' ? 'detail-status-withdrawn' : 'detail-status-draft')))))}}">
                {{submission.status === 'draft' ? '草稿' : (submission.status === 'pending' ? '待提交' : (submission.status === 'in_progress' ? '审核中' : (submission.status === 'rejected' ? '已驳回' : (submission.status === 'approved' ? '已完成' : '已撤回'))))}}
              </view>
            </view>
          </view>
          <view class="info-block">
            <view class="info-label">类型</view>
            <view class="info-value">{{submission.type === 'template' ? '模板审核' : '临时审批'}}</view>
          </view>
          <view class="info-block info-block-full" wx:if="{{submission.templateName}}">
            <view class="info-label">模板</view>
            <view class="info-value">{{submission.templateName}}</view>
          </view>
        </view>
        <!-- Status context hint — 6 states clearly explained -->
        <view style="margin-top:16rpx;padding:16rpx 18rpx;border-radius:16rpx;font-size:23rpx;line-height:1.6;color:#64748b;background:rgba(248,251,255,0.7);border:1rpx solid rgba(226,232,240,0.45);">
          <block wx:if="{{submission.status === 'draft'}}">📝 草稿 — 尚未提交，完善信息后点击提交即可发起审批。</block>
          <block wx:elif="{{submission.status === 'pending'}}">⏳ 待提交 — 审核尚未进入审批流程，点击下方「重新提交」启动。</block>
          <block wx:elif="{{submission.status === 'in_progress'}}">🔄 审核中 — 当前第{{submission.currentStepIndex}}步正在等待审批人处理。</block>
          <block wx:elif="{{submission.status === 'rejected'}}">❌ 已驳回 — 第{{submission.previousRejectStepIndex || '?'}}步审批人驳回了此审核，修改后可重新提交。</block>
          <block wx:elif="{{submission.status === 'approved'}}">✅ 已完成 — 所有审批步骤均已通过。</block>
          <block wx:elif="{{submission.status === 'withdrawn'}}">↩️ 已撤回 — 您主动撤回了此审核，可点击下方「重新提交」重新发起。</block>
        </view>
      </view>

      <!-- Flow Visualization -->
      <view class="card">
        <view class="section-title">审批流程</view>

        <!-- Flow progress summary -->
        <view class="audit-flow-summary">
          <text style="font-size:23rpx;font-weight:600;color:#475569;white-space:nowrap;">进度</text>
          <view class="audit-flow-progress-bar">
            <view class="audit-flow-progress-fill" style="width:{{flowProgressPercent}}%;"></view>
          </view>
          <text class="audit-flow-progress-text">{{flowProgressText}}</text>
        </view>

        <!-- Flow timeline -->
        <view class="audit-flow" wx:if="{{steps.length}}">
          <view class="flow-node {{item.flowNodeClass}}" wx:for="{{steps}}" wx:key="id">

            <!-- Left column: dot + connector line -->
            <view class="flow-left-col">
              <view class="flow-dot {{item.flowDotClass}}">
                <block wx:if="{{item.flowIcon === 'check'}}">✓</block>
                <block wx:elif="{{item.flowIcon === 'cross'}}">✗</block>
                <block wx:else>{{item.sortOrder}}</block>
              </view>
              <view class="flow-connector"></view>
            </view>

            <!-- Step info card -->
            <view class="flow-info">
              <view class="flow-step-label">第{{item.sortOrder}}步<text class="flow-round-badge" wx:if="{{item.round > 1}}">第{{item.round}}轮</text></view>
              <view class="flow-step-title">
                {{item.actionType === 'pass' ? '仅通过' : (item.actionType === 'sign' ? '签字' : (item.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}
                <text style="font-size:21rpx;color:#64748b;font-weight:500;"> — {{item.approverType === 'identity' ? (item.approverIdentityName || '身份审批') : (item.approverName || '指定人员')}}</text>
              </view>

              <!-- Status tag -->
              <view class="flow-step-status-tag {{item.flowTagClass}}">{{item.flowStatusLabel}}</view>

              <!-- Processed info -->
              <view class="flow-step-meta" wx:if="{{item.flowIcon === 'check' || item.flowIcon === 'cross'}}">
                {{item.approverName}} · {{item.processedAt || ''}}
              </view>

              <!-- Comment / Rejection -->
              <view class="flow-step-comment" wx:if="{{item.comment}}">{{item.comment}}</view>
              <view class="flow-step-rejection" wx:if="{{item.rejectionReason}}">驳回理由：{{item.rejectionReason}}</view>

              <!-- Approval action buttons for current active step -->
              <view class="flow-actions" wx:if="{{item.flowNodeClass === 'flow-node-active'}}">
                <text class="flow-action-btn" data-step-id="{{item.id}}" bindtap="openApprove">✓ 通过</text>
                <text class="flow-action-btn flow-action-danger" data-step-id="{{item.id}}" bindtap="openReject">✗ 驳回</text>
              </view>
            </view>
          </view>
        </view>
        <!-- Empty state when no steps -->
        <view wx:if="{{!steps.length}}" class="audit-empty-state">
          <view class="audit-empty-icon">📋</view>
          <view class="audit-empty-text">审批流程尚未生成，请等待系统处理</view>
        </view>
      </view>

      <!-- Files -->
      <view class="card" wx:if="{{files.length}}">
        <view class="section-title">附件 ({{files.length}}份)</view>
        <view class="file-attach-item" wx:for="{{files}}" wx:key="id">
          <view class="file-attach-icon">📎</view>
          <view class="file-attach-name">{{item.fileName}}</view>
          <view class="audit-file-type">{{item.mimeType}}</view>
        </view>
      </view>

      <!-- Signatures -->
      <view class="card" wx:if="{{signatures.length}}">
        <view class="section-title">签署记录 ({{signatures.length}}条)</view>
        <view class="audit-sig-card" wx:for="{{signatures}}" wx:key="id">
          <view class="list-name">{{item.signerName}} · {{item.signatureType === 'signature' ? '签名' : '印章'}} · 第{{item.round}}轮</view>
          <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="widthFix" class="audit-sig-preview" />
          <view class="list-desc">{{item.signedAt}}</view>
        </view>
      </view>

      <!-- Actions -->
      <view class="card">
        <view class="audit-btn-bar">
          <button class="primary-btn" wx:if="{{submission.status === 'pending' || submission.status === 'rejected' || submission.status === 'withdrawn'}}" bindtap="resubmit">重新提交</button>
          <button class="secondary-btn danger-btn" wx:if="{{submission.status === 'in_progress' || submission.status === 'rejected'}}" bindtap="withdraw">撤回申请</button>
        </view>
      </view>
    </block>
  </view>

  <!-- Approval Dialog -->
  <view class="popup-mask" wx:if="{{approvalVisible}}" bindtap="closeApproval">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">{{approvalAction === 'approve' ? '审批通过' : '驳回'}}</view>
        <text class="popup-close" bindtap="closeApproval">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y>
        <view class="detail-popup-form">
          <!-- Signature section (only for approve) -->
          <view wx:if="{{approvalAction === 'approve'}}">
            <view class="list-title">签名/盖章</view>
            <view class="sign-file-card" wx:for="{{pendingSignatures}}" wx:key="index">
              <view class="sign-file-main">
                <view class="sign-file-name">签名{{index + 1}} (文件: {{item.fileId}})</view>
                <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="widthFix" class="sign-file-preview" />
              </view>
              <view class="list-actions"><text class="audit-link-btn audit-link-danger" data-index="{{index}}" bindtap="removePendingSignature">移除</text></view>
            </view>
            <view class="button-row compact-row">
              <button class="secondary-btn" wx:for="{{files}}" wx:key="id" data-file-id="{{item.id}}" bindtap="openSignaturePad">签在 {{item.fileName}}</button>
            </view>
            <view class="field" style="margin-top:12rpx;">
              <view class="field-label">审批意见</view>
              <textarea class="field-textarea" auto-height maxlength="-1" value="{{approvalComment}}" bindinput="onApprovalCommentInput" placeholder="可选：填写审批意见" />
            </view>
          </view>

          <!-- Reject reason -->
          <view wx:if="{{approvalAction === 'reject'}}">
            <view class="field">
              <view class="field-label">驳回理由</view>
              <textarea class="field-textarea" auto-height maxlength="-1" value="{{rejectionReason}}" bindinput="onRejectionReasonInput" placeholder="请填写驳回理由（必填）" />
            </view>
          </view>

          <view class="audit-btn-bar">
            <button class="primary-btn" loading="{{loading}}" bindtap="confirmApproval">{{approvalAction === 'approve' ? '确认通过' : '确认驳回'}}</button>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- Signature Pad Popup -->
  <view class="popup-mask" wx:if="{{signaturePadVisible}}" bindtap="closeSignaturePad">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">手写签名</view>
        <text class="popup-close" bindtap="closeSignaturePad">关闭</text>
      </view>
      <signature-pad bindconfirm="onSignatureConfirm" />
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>
</view>

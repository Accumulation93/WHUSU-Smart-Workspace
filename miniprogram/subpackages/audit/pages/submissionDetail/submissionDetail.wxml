<view class="page">
  <view class="hero">
    <view class="hero-badge">审核</view>
    <view class="hero-title" wx:if="{{action === 'create'}}">发起新审核</view>
    <view class="hero-title" wx:else>{{submission.title || submission.submissionNumber || '审核详情'}}</view>
    <view class="hero-subtitle" wx:if="{{action === 'view' && submission}}">{{submission.submissionNumber}} · {{submission.submitterName}}</view>
  </view>

  <!-- ═══════════ Create Mode ═══════════ -->
  <view class="section" wx:if="{{action === 'create'}}">
    <view class="card">
      <view class="section-title">审核类型</view>
      <view class="button-row">
        <button class="{{createMode === 'template' ? 'primary-btn' : 'secondary-btn'}}" data-mode="template" bindtap="onCreateModeChange">从模板创建</button>
        <button class="{{createMode === 'ad_hoc' ? 'primary-btn' : 'secondary-btn'}}" data-mode="ad_hoc" bindtap="onCreateModeChange">临时审批</button>
      </view>
    </view>

    <!-- Template mode -->
    <view class="card" wx:if="{{createMode === 'template'}}">
      <view class="section-title">选择审核流模板</view>
      <scroll-view show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll small-scroll" scroll-y>
        <view class="template-select-item {{selectedTemplateId === item.id ? 'template-select-item-selected' : ''}}" wx:for="{{flowTemplates}}" wx:key="id" data-id="{{item.id}}" catchtap="onTemplateSelect">
          <view class="radio-dot {{selectedTemplateId === item.id ? 'radio-dot-checked' : ''}}"></view>
          <view class="list-main">
            <view class="list-name">{{item.name}} <text class="list-desc">({{item.stepCount}}步 · {{item.resubmitMode === 'fresh' ? '重新逐层' : '回到驳回人'}})</text></view>
            <view class="list-desc" wx:if="{{item.description}}">{{item.description}}</view>
          </view>
        </view>
        <view class="audit-empty-state" wx:if="{{!flowTemplates.length}}">
          <view class="audit-empty-icon">📄</view>
          <view class="audit-empty-text">暂无可用的审核流模板</view>
        </view>
      </scroll-view>
    </view>

    <!-- Ad-hoc mode -->
    <view class="card" wx:if="{{createMode === 'ad_hoc'}}">
      <view class="section-title">审批步骤 ({{adHocSteps.length}}步)</view>
      <view class="ad-hoc-step-item" wx:for="{{adHocSteps}}" wx:key="index">
        <view class="ad-hoc-step-main">
          <view class="ad-hoc-step-title">{{item.name || ('第' + (index + 1) + '步')}}：{{item.approverType === 'specific_person' ? (item.approverHrName || '未指定人员') : (item.approverIdentityName || '未指定身份') + '（' + (item.scopeType === 'same_department' ? '同部门' : (item.scopeType === 'same_work_group' ? '同职能组' : (item.scopeType === 'specific_department' ? (item.scopeDepartmentName || '指定部门') : (item.scopeType === 'specific_work_group' ? (item.scopeDepartmentName || '') + (item.scopeWorkGroupName ? '·' + item.scopeWorkGroupName : '') : '全体')))) + '）'}} — {{item.actionType === 'pass' ? '仅通过' : (item.actionType === 'sign' ? '签字' : (item.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
          <view class="ad-hoc-step-desc">{{item.approverType === 'identity' ? '按身份审批' : '指定人员审批'}}</view>
        </view>
        <view class="list-actions"><text class="audit-link-btn audit-link-danger" data-index="{{index}}" bindtap="removeAdHocStep">移除</text></view>
      </view>
      <view class="audit-empty-state" wx:if="{{!adHocSteps.length}}">
        <view class="audit-empty-text">尚未添加审批步骤</view>
      </view>
      <view class="button-row compact-row"><button class="secondary-btn" bindtap="openAdHocStepEditor">添加步骤 (按身份)</button><button class="secondary-btn" bindtap="openPersonPicker">添加步骤 (指定人员)</button></view>
      <view class="field field-mt-16">
        <view class="field-label">驳回重提交模式</view>
        <picker range="{{['重新逐层审批','直接到驳回人']}}" bindchange="onResubmitModeChange">
          <view class="picker-value">{{resubmitMode === 'fresh' ? '重新逐层审批' : '直接到驳回人'}}</view>
        </picker>
      </view>
    </view>

    <!-- Template step preview (person override) -->
    <view class="card" wx:if="{{createMode === 'template' && selectedTemplateId && templatePreviewSteps.length}}">
      <view class="section-title">审批步骤预览（共{{templatePreviewSteps.length}}步）</view>
      <view class="section-desc section-desc-sm">默认由模板设定的人员审批，可指定具体人员覆盖</view>
      <view class="tpl-step-preview-item" wx:for="{{templatePreviewSteps}}" wx:key="stepIndex">
        <view class="tpl-step-preview-main">
          <view class="tpl-step-preview-num">{{item.name || ('第' + (item.sortOrder || (index + 1)) + '步')}}</view>
          <view class="tpl-step-preview-desc">{{item.approverDesc || '由未指定审批人审批'}}</view>
          <view class="tpl-step-preview-action">{{item.actionLabel || '审批'}}</view>
        </view>
        <view class="tpl-step-preview-mode">
          <block wx:for="{{templateStepOverrides}}" wx:for-item="ovr" wx:key="stepIndex">
            <block wx:if="{{ovr.stepIndex === item.stepIndex}}">
              <text class="tpl-step-toggle {{ovr.mode === 'specific' ? 'tpl-step-toggle-active' : ''}}" data-step-index="{{item.stepIndex}}" bindtap="onTemplateStepModeToggle">{{ovr.mode === 'auto' ? '按角色' : '已指定'}}</text>
              <!-- Show selected persons when in specific mode -->
              <view wx:if="{{ovr.mode === 'specific' && ovr.personHrNames.length}}" class="tpl-step-override-persons">
                <view class="tpl-step-person-tag" wx:for="{{ovr.personHrNames}}" wx:for-item="pname" wx:for-index="pidx" wx:key="pname">
                  <text>{{pname}}</text>
                  <text class="tpl-step-person-remove" data-step-index="{{item.stepIndex}}" data-hr-id="{{ovr.personHrIds[pidx]}}" bindtap="removeTemplateStepOverridePerson">×</text>
                </view>
              </view>
              <text wx:if="{{ovr.mode === 'specific'}}" class="audit-link-btn tpl-step-override-link" data-step-index="{{item.stepIndex}}" bindtap="openTemplateStepPersonPicker">{{ovr.personHrIds.length ? '修改人员' : '选择人员'}}</text>
            </block>
          </block>
        </view>
      </view>
    </view>

    <!-- Common: Title + Files -->
    <view class="card">
      <view class="section-title">基本信息</view>
      <view class="field">
        <view class="field-label">标题</view>
        <input class="field-input" value="{{createTitle}}" bindinput="onTitleInput" placeholder="请输入审核标题" />
      </view>
      <view class="field">
        <view class="field-label">描述</view>
        <textarea class="field-textarea" auto-height maxlength="-1" value="{{createDesc}}" bindinput="onDescInput" placeholder="可选：填写审核描述/说明" ></textarea>
      </view>
      <view class="section-title field-mt-16">附件 ({{uploadedFiles.length}}份)</view>
      <view class="file-attach-item" wx:for="{{uploadedFiles}}" wx:key="fileId">
        <view class="file-attach-icon">📎</view>
        <view class="file-attach-name">{{item.fileName}}</view>
        <view class="list-actions"><text class="audit-link-btn audit-link-danger" data-index="{{index}}" bindtap="removeUploadedFile">移除</text></view>
      </view>
      <view class="button-row compact-row">
        <button class="secondary-btn" bindtap="chooseImage">选择图片</button>
        <button class="secondary-btn" bindtap="chooseFile">选择文件</button>
      </view>
      <view class="audit-btn-bar">
        <button class="primary-btn" loading="{{loading}}" bindtap="submitAudit">提交审核</button>
      </view>
    </view>

    <!-- ═══ Identity step editor popup ═══ -->
    <view class="popup-mask" wx:if="{{adHocStepEditorVisible}}" bindtap="closeAdHocStepEditor">
      <view class="popup-card" catchtap="noop">
        <view class="popup-header"><view class="popup-title">添加审批步骤 — 按身份</view><text class="popup-close" bindtap="closeAdHocStepEditor">关闭</text></view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y>
          <view class="detail-popup-form">
            <view class="field">
              <view class="field-label">步骤名称</view>
              <input class="field-input" value="{{adHocStepForm.name}}" data-field="name" bindinput="onAdHocStepField" placeholder="如：部门负责人审批"/>
            </view>
            <view class="field">
              <view class="field-label">审批动作</view>
              <picker range="{{['仅通过','签字','盖章','签字+盖章']}}" bindchange="onAdHocActionTypeChange">
                <view class="picker-value">{{adHocStepForm.actionType === 'pass' ? '仅通过' : (adHocStepForm.actionType === 'sign' ? '签字' : (adHocStepForm.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
              </picker>
            </view>
            <view class="field">
              <view class="field-label">审批范围</view>
              <picker range="{{identityPickerScopeOptions}}" bindchange="onIdentityScopeChange">
                <view class="picker-value">{{identityPickerScopeOptions[identityPickerScopeIndex] || '全体成员'}}</view>
              </picker>
            </view>
            <view class="field" wx:if="{{identityPickerScopeValues[identityPickerScopeIndex] === 'specific_department' || identityPickerScopeValues[identityPickerScopeIndex] === 'specific_work_group'}}">
              <view class="field-label">指定部门</view>
              <picker range="{{identityPickerDeptOptions}}" bindchange="onIdentityDeptChange">
                <view class="picker-value">{{identityPickerDeptOptions[identityPickerDeptIndex] || '请选择部门'}}</view>
              </picker>
            </view>
            <view class="field" wx:if="{{identityPickerScopeValues[identityPickerScopeIndex] === 'specific_work_group'}}">
              <view class="field-label">指定职能组</view>
              <picker range="{{identityPickerWgOptions}}" bindchange="onIdentityWgChange">
                <view class="picker-value">{{identityPickerWgOptions[identityPickerWgIndex] || '请选择职能组'}}</view>
              </picker>
            </view>
            <view class="field">
              <view class="field-label">审批人身份</view>
              <picker range="{{identityPickerIdentOptions}}" bindchange="onIdentityIdentChange">
                <view class="picker-value">{{identityPickerIdentOptions[identityPickerIdentIndex] || '请选择身份'}}</view>
              </picker>
            </view>
            <view class="audit-btn-bar"><button class="primary-btn" bindtap="confirmAdHocStep">确定</button></view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- ═══ Person picker popup (multi-select) ═══ -->
    <view class="popup-mask" wx:if="{{personPickerVisible}}" bindtap="closePersonPicker">
      <view class="popup-card desig-popup-card" catchtap="noop">
        <view class="popup-header"><view class="popup-title">指定审批人员</view><text class="popup-close" bindtap="closePersonPicker">关闭</text></view>

        <!-- Selected persons -->
        <view class="list-title">已选人员（{{personPickerSelectedIds.length}}人）</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-current-scroll">
          <view class="audit-person-item" wx:for="{{personPickerSelectedList}}" wx:key="id">
            <view class="audit-person-avatar">{{item.name[0]}}</view>
            <view class="audit-person-info">
              <view class="audit-person-name">{{item.name}}</view>
              <view class="audit-person-detail">{{item.department}} · {{item.identity}} · {{item.studentId}}</view>
            </view>
            <view class="inline-actions list-actions-below">
              <text class="audit-link-btn audit-link-danger" data-hr-id="{{item.id}}" bindtap="onPersonToggle">移除</text>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!personPickerSelectedList.length}}">尚未选择任何人</view>
        </scroll-view>

        <!-- Filters -->
        <view class="list-title field-mt-8">可选人员</view>
        <view class="rule-filter-row">
          <view class="rule-filter-field">
            <view class="field-label">部门</view>
            <picker range="{{personPickerDeptOpts}}" bindchange="onPersonPickerDeptChange">
              <view class="picker-value compact-picker-value">{{personPickerDept}}</view>
            </picker>
          </view>
          <view class="rule-filter-field">
            <view class="field-label">身份</view>
            <picker range="{{personPickerIdentOpts}}" bindchange="onPersonPickerIdentChange">
              <view class="picker-value compact-picker-value">{{personPickerIdent}}</view>
            </picker>
          </view>
          <view class="rule-filter-field">
            <view class="field-label">职能组</view>
            <picker range="{{personPickerWgOpts}}" bindchange="onPersonPickerWgChange">
              <view class="picker-value compact-picker-value">{{personPickerWg}}</view>
            </picker>
          </view>
        </view>
        <view class="field field-mb-8">
          <input class="field-input" placeholder="搜索姓名/学号" value="{{personPickerKeyword}}" bindinput="onPersonPickerSearch"/>
        </view>

        <!-- Candidate list -->
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-candidate-scroll">
          <view wx:if="{{!personPickerCandidates.length}}" class="empty-inline">没有匹配的人员</view>
          <view class="audit-person-item" wx:for="{{personPickerCandidates}}" wx:key="id" data-hr-id="{{item.id}}" bindtap="onPersonToggle">
            <view class="audit-person-avatar">{{item.name[0]}}</view>
            <view class="audit-person-info">
              <view class="audit-person-name">
                <view class="select-chip select-chip-inline {{item.isSelected ? 'select-chip-active' : ''}}">{{item.isSelected ? '已选' : '选择'}}</view>
                {{item.name}}
              </view>
              <view class="audit-person-detail">{{item.studentId}} · {{item.department}} · {{item.identity}}<text wx:if="{{item.workGroup}}"> · {{item.workGroup}}</text></view>
            </view>
          </view>
        </scroll-view>

        <!-- Action type -->
        <view class="field field-mt-8">
          <view class="field-label">审批动作</view>
          <picker range="{{['仅通过','签字','盖章','签字+盖章']}}" bindchange="onPersonPickerActionTypeChange">
            <view class="picker-value">{{personPickerStepActionType === 'pass' ? '仅通过' : (personPickerStepActionType === 'sign' ? '签字' : (personPickerStepActionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
          </picker>
        </view>

        <view class="button-row">
          <button class="secondary-btn" bindtap="closePersonPicker">取消</button>
          <button class="primary-btn" bindtap="confirmPersonPicker">添加 {{personPickerSelectedIds.length}} 人</button>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══════════ View Mode ═══════════ -->
  <view class="section" wx:if="{{action === 'view'}}">
    <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>

    <block wx:if="{{!loading && submission}}">
      <!-- Status -->
      <view class="card">
        <view class="info-grid">
          <view class="info-block">
            <view class="info-label">状态</view>
            <view class="info-value">
              <view class="detail-status-chip {{submission.status === 'approved' ? 'detail-status-approved' : (submission.status === 'rejected' ? 'detail-status-rejected' : (submission.status === 'in_progress' ? 'detail-status-progress' : (submission.status === 'draft' ? 'detail-status-draft' : (submission.status === 'pending' ? 'detail-status-pending' : (submission.status === 'withdrawn' ? 'detail-status-withdrawn' : 'detail-status-draft')))))}}">
                {{submission.status === 'draft' ? '草稿' : (submission.status === 'pending' ? '待提交' : (submission.status === 'in_progress' ? '审核中' : (submission.status === 'rejected' ? '已驳回' : (submission.status === 'approved' ? '已完成' : '已撤回'))))}}
              </view>
            </view>
          </view>
          <view class="info-block">
            <view class="info-label">类型</view>
            <view class="info-value">{{submission.type === 'template' ? '模板审核' : '临时审批'}}</view>
          </view>
          <view class="info-block info-block-full" wx:if="{{submission.templateName}}">
            <view class="info-label">模板</view>
            <view class="info-value">{{submission.templateName}}</view>
          </view>
        </view>
        <!-- Status context hint — 6 states clearly explained -->
        <view class="status-hint-box">
          <block wx:if="{{submission.status === 'draft'}}">📝 草稿 — 尚未提交，完善信息后点击提交即可发起审批。</block>
          <block wx:elif="{{submission.status === 'pending'}}">⏳ 待提交 — 审核尚未进入审批流程，点击下方「重新提交」启动。</block>
          <block wx:elif="{{submission.status === 'in_progress'}}">🔄 审核中 — 当前第{{submission.currentStepIndex || 1}}步正在等待审批人处理。</block>
          <block wx:elif="{{submission.status === 'rejected'}}">❌ 已驳回 — 第{{submission.previousRejectStepIndex || '?'}}步审批人驳回了此审核，修改后可重新提交。</block>
          <block wx:elif="{{submission.status === 'approved'}}">✅ 已完成 — 所有审批步骤均已通过。</block>
          <block wx:elif="{{submission.status === 'withdrawn'}}">↩️ 已撤回 — 您主动撤回了此审核，可点击下方「重新提交」重新发起。</block>
        </view>
      </view>

      <!-- ═══════════ Active Approval Card (shown when current user can approve) ═══════════ -->
      <view class="card approval-card" wx:if="{{!editMode && submission.status === 'in_progress' && activeApprovalStepId && userIsApprover}}">
        <view class="section-title approval-card-title">📋 审批操作</view>
        <view class="approval-step-info">
          {{activeApprovalStep.stepName || ('第' + activeApprovalStep.sortOrder + '步')}} · {{activeApprovalStep.actionLabel}}
          <text wx:if="{{activeApprovalStep.round > 1}}" class="approval-round-note">（第{{activeApprovalStep.round}}轮）</text>
        </view>
        <view class="approval-step-desc">{{activeApprovalStep.approverDesc}}</view>

        <!-- Signature / Stamp section (hidden for pass-only steps) -->
        <view wx:if="{{activeApprovalStep.actionType !== 'pass'}}" class="approval-sig-section">
          <view class="approval-sig-header">
            {{activeApprovalStep.actionType === 'both' ? '✍️ 签名与盖章' : (activeApprovalStep.actionType === 'sign' ? '✍️ 签名' : '🔴 盖章')}}
          </view>

          <!-- File list -->
          <view wx:for="{{files}}" wx:key="id" wx:for-item="f" class="approval-file-item">
            <view class="approval-file-row">
              <view class="approval-file-name">📎 {{f.fileName}}</view>
              <view class="approval-file-actions">
                <text class="approval-file-btn-preview"
                      data-file-id="{{f.id}}" data-file-name="{{f.fileName}}"
                      bindtap="previewFile">预览</text>
                <text wx:if="{{activeApprovalStep.actionType === 'sign' || activeApprovalStep.actionType === 'both'}}"
                      class="approval-file-btn-sign"
                      data-file-id="{{f.id}}" data-file-name="{{f.fileName}}"
                      bindtap="addSignatureForFile">签名</text>
                <text wx:if="{{activeApprovalStep.actionType === 'estamp' || activeApprovalStep.actionType === 'both'}}"
                      class="approval-file-btn-stamp"
                      data-file-id="{{f.id}}" data-file-name="{{f.fileName}}"
                      bindtap="addStampForFile">盖章</text>
              </view>
            </view>

            <!-- Current sigs/stamps on this file -->
            <view wx:for="{{pendingSignatures}}" wx:for-item="sig" wx:key="_idx" wx:if="{{sig.fileId === f.id}}"
                  class="approval-sig-item">
              <view class="approval-sig-info">
                <image wx:if="{{sig.imageData}}" src="{{sig.imageData}}" mode="aspectFit" class="approval-sig-thumb" />
                <text class="approval-sig-name">{{sig.signatureType === 'stamp' ? (sig.stampName || '印章') : '签名'}}</text>
                <text class="approval-sig-pos">({{sig.positionX ? Math.round(sig.positionX * 100) : 50}}%, {{sig.positionY ? Math.round(sig.positionY * 100) : 50}}%{{sig.page && sig.page > 1 ? ', 第' + sig.page + '页' : ''}})</text>
              </view>
              <view class="approval-sig-actions">
                <text class="approval-sig-action-adjust" data-sig-idx="{{index}}" bindtap="openPlacement">调整位置</text>
                <text class="approval-sig-action-remove" data-sig-idx="{{index}}" bindtap="removePendingSign">移除</text>
              </view>
            </view>
          </view>

          <!-- Warning for incomplete sign+stamp -->
          <view wx:if="{{activeApprovalStep.actionType === 'both' && approvalWarning}}"
                class="approval-warning">
            ⚠️ {{approvalWarning}}
          </view>
        </view>

        <!-- Approval comment -->
        <view class="approval-field-label">审批意见（可选）</view>
          <textarea class="approval-textarea" auto-height maxlength="-1" value="{{approvalComment}}" bindinput="onApprovalCommentInput" placeholder="填写审批通过时的意见（可选）"></textarea>

        <!-- Rejection reason -->
        <view class="approval-field-label">驳回理由</view>
          <textarea class="approval-textarea" auto-height maxlength="-1" value="{{rejectionReason}}" bindinput="onRejectionReasonInput" placeholder="填写驳回理由（驳回时必填）"></textarea>

        <!-- Designate next-step approvers (optional) -->
        <view class="approval-designate-row">
          <view class="approval-designate-header">
            <view class="approval-designate-label">指定下一步审批人（可选）</view>
            <text class="audit-link-btn approval-designate-link" bindtap="openDesignateNextPersonPicker">{{designatedNextPersons.length ? '修改' : '选择'}}</text>
          </view>
          <view wx:if="{{!designatedNextPersons.length}}" class="approval-designate-empty">不指定则由流程规定的审批人审批</view>
          <view wx:for="{{designatedNextPersons}}" wx:key="id" class="approval-designate-tag">
            {{item.name}}
            <text data-hr-id="{{item.id}}" bindtap="removeDesignatedNextPerson" class="approval-designate-remove">×</text>
          </view>
          <view wx:if="{{nextStepInfo}}" class="approval-next-step-info">下一步：第{{nextStepInfo.sortOrder}}步 · {{nextStepInfo.approverDesc}}</view>
        </view>

        <!-- Action buttons -->
        <view class="button-row">
          <button class="primary-btn approval-btn-approve" loading="{{loading}}" bindtap="confirmApprovalDirect" data-action="approve">✓ 通过</button>
          <button class="secondary-btn danger-btn approval-btn-reject" loading="{{loading}}" bindtap="confirmApprovalDirect" data-action="reject">✗ 驳回</button>
        </view>
      </view>

      <!-- Flow Visualization -->
      <view class="card">
        <view class="section-title">审批流程</view>

        <!-- Flow progress summary -->
        <view class="audit-flow-summary">
          <text class="flow-summary-text">进度</text>
          <view class="audit-flow-progress-bar">
            <view class="audit-flow-progress-fill" style="width:{{flowProgressPercent}}%;"></view>
          </view>
          <text class="audit-flow-progress-text">{{flowProgressText}}</text>
        </view>

        <!-- Flow timeline — lifecycle events + approval steps -->
        <view class="audit-flow" wx:if="{{flowTimeline.length}}">
          <block wx:for="{{flowTimeline}}" wx:key="_key" wx:for-item="node">

            <!-- ── Remaining steps separator ── -->
            <view class="flow-separator" wx:if="{{node.type === 'separator'}}">
              <view class="flow-separator-dash"></view>
              <text class="flow-separator-text">{{node.label}}</text>
              <view class="flow-separator-dash"></view>
            </view>

            <!-- ── Lifecycle event node (tappable to expand) ── -->
            <view class="flow-node flow-node-lifecycle {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}}" wx:if="{{node.type === 'lifecycle'}}" bindtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="flow-node-tap" hover-stay-time="{{80}}">
              <view class="flow-left-col">
                <view class="flow-dot-lifecycle-icon">{{node.icon}}</view>
                <view class="flow-connector flow-connector-lifecycle"></view>
              </view>
              <view class="flow-info flow-info-lifecycle">
                <view class="flow-lifecycle-label">{{node.label}}<text class="flow-lifecycle-round" wx:if="{{node.subLabel}}"> {{node.subLabel}}</text></view>
                <view class="flow-lifecycle-time" wx:if="{{node.time}}">{{node.time}}</view>
                <!-- Expand indicator -->
                <view class="flow-expand-hint">{{expandedNodeKey === node._key ? '▲ 收起' : '▼ 详情'}}</view>
                <!-- Expanded detail -->
                <view wx:if="{{expandedNodeKey === node._key}}" class="flow-expand-detail">
                  <view class="flow-detail-text">
                    <text class="flow-detail-label">操作人：</text>{{node.operatorName || '系统'}}
                  </view>
                  <view wx:if="{{node.comment}}" class="flow-detail-text flow-detail-comment-text">
                    <text class="flow-detail-label">{{node.event === 'approve' ? '审批意见：' : (node.event === 'reject' ? '驳回理由：' : '备注：')}}</text>{{node.comment}}
                  </view>
                  <view wx:if="{{node.time}}" class="flow-detail-meta">时间：{{node.time}}</view>
                </view>
                <!-- Collapsed: show comment inline for approve/reject -->
                <view wx:if="{{expandedNodeKey !== node._key && node.comment && (node.event === 'approve' || node.event === 'reject')}}" class="flow-collapsed-comment">{{node.event === 'approve' ? '💬 ' : '❌ '}}{{node.comment}}</view>
              </view>
            </view>

            <!-- ── Approval step node (tappable to expand) ── -->
            <view class="flow-node {{node.flowNodeClass}} {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}}" wx:if="{{node.type === 'step'}}" bindtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="flow-node-tap" hover-stay-time="{{80}}">
              <view class="flow-left-col">
                <view class="flow-dot {{node.flowDotClass}}">
                  <block wx:if="{{node.flowIcon === 'check'}}">✓</block>
                  <block wx:elif="{{node.flowIcon === 'cross'}}">✗</block>
                  <block wx:else>{{node.sortOrder}}</block>
                </view>
                <view class="flow-connector"></view>
              </view>
              <view class="flow-info">
                <!-- Collapsed: key info only -->
                <view class="flow-step-label">{{node.stepName || ('第' + (node.sortOrder || '?') + '步')}} · {{node.actionLabel || '审批'}}<text class="flow-round-badge" wx:if="{{node.round > 1}}">第{{node.round}}轮</text></view>
                <view class="flow-step-approver">{{node.approverDesc || '由未指定审批人审批'}}</view>
                <view class="flow-step-status-tag {{node.flowTagClass}}">{{node.flowStatusLabel}}</view>
                <!-- Always show approver name + time if processed -->
                <view class="flow-step-meta" wx:if="{{node.flowIcon === 'check' || node.flowIcon === 'cross'}}">
                  {{node.approverName}} · {{node.processedAt || ''}}
                </view>
                <!-- Expand indicator -->
                <view class="flow-expand-hint">{{expandedNodeKey === node._key ? '▲ 收起' : '▼ 详情'}}</view>

                <!-- Expanded detail section -->
                <view wx:if="{{expandedNodeKey === node._key}}" class="flow-expand-detail">
                  <!-- Processed info -->
                  <view wx:if="{{node.flowIcon === 'check' || node.flowIcon === 'cross'}}" class="flow-detail-processed-text">
                    <text class="flow-detail-label">处理人：</text>{{node.approverName || '未知'}}
                  </view>
                  <view wx:if="{{node.flowIcon === 'check' || node.flowIcon === 'cross'}}" class="flow-detail-processed-meta">
                    处理时间：{{node.processedAt || ''}}
                  </view>
                  <!-- Approval comment -->
                  <view wx:if="{{node.comment && node.flowIcon === 'check'}}" class="flow-detail-comment">
                    <text class="flow-detail-label">💬 审批意见：</text>{{node.comment}}
                  </view>
                  <!-- Rejection reason -->
                  <view wx:if="{{node.rejectionReason}}" class="flow-detail-reject">
                    <text class="flow-detail-label">❌ 驳回理由：</text>{{node.rejectionReason}}
                  </view>
                  <!-- Conditions detail (multi-condition OR logic) -->
                  <view wx:if="{{node.conditionsDisplay && node.conditionsDisplay.length}}" class="flow-detail-conditions">
                    <view class="flow-detail-conditions-label">审批条件：</view>
                    <view wx:for="{{node.conditionsDisplay}}" wx:for-item="condLine" wx:key="*this" class="flow-detail-cond-line">{{condLine}}</view>
                  </view>
                  <!-- Round info -->
                  <view wx:if="{{node.round > 1}}" class="flow-detail-round">第{{node.round}}轮审批</view>
                </view>

                <!-- Approval action buttons (only for active step + authorized user) -->
                <view class="flow-actions" wx:if="{{node.flowNodeClass === 'flow-node-active' && userIsApprover}}">
                  <text class="flow-action-btn" data-step-id="{{node.id}}" bindtap="openApprove">✓ 通过</text>
                  <text class="flow-action-btn flow-action-danger" data-step-id="{{node.id}}" bindtap="openReject">✗ 驳回</text>
                </view>
              </view>
            </view>

          </block>
        </view>
        <!-- Diagnostic: step count from server -->
        <view wx:if="{{rawStepCount === 0 && submission.status !== 'draft' && submission.status !== 'pending'}}" class="flow-diagnostic">
          <text class="flow-diagnostic-text">⚠ 服务器返回了 0 个审批步骤。请检查：1) 模板是否已配置审批步骤 2) 服务器日志</text>
        </view>

        <!-- Empty state for draft/pending with no events -->
        <view wx:if="{{!flowTimeline.length && (submission.status === 'draft' || submission.status === 'pending')}}" class="flow-empty-draft">
          <text class="flow-empty-draft-text">{{submission.status === 'draft' ? '📝 草稿 — 提交后将开始审批流程' : '⏳ 待提交 — 点击下方「重新提交」启动审批流程'}}</text>
        </view>

        <!-- Empty state when no timeline -->
        <view wx:if="{{!flowTimeline.length}}" class="audit-empty-state">
          <view class="audit-empty-icon">📋</view>
          <view class="audit-empty-text">暂无流程数据</view>
        </view>
      </view>

      <!-- Files -->
      <view class="card" wx:if="{{files.length}}">
        <view class="section-title">附件 ({{files.length}}份)</view>
        <view class="file-attach-item" wx:for="{{files}}" wx:key="id" data-file-id="{{item.id}}" data-file-name="{{item.fileName}}" bindtap="previewFile">
          <view class="file-attach-icon">📎</view>
          <view class="file-attach-name">{{item.fileName}}</view>
          <view class="audit-file-type">{{item.mimeType}}</view>
        </view>
      </view>

      <!-- Signatures -->
      <view class="card" wx:if="{{signatures.length}}">
        <view class="section-title">签署记录 ({{signatures.length}}条)</view>
        <view class="audit-sig-card" wx:for="{{signatures}}" wx:key="id">
          <view class="list-name">{{item.signerName}} · {{item.signatureType === 'signature' ? '签名' : '印章'}} · 第{{item.round}}轮</view>
          <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="widthFix" class="audit-sig-preview" />
          <view class="list-desc">{{item.signedAt}}</view>
        </view>
      </view>

      <!-- Description display (view mode) -->
      <view class="card" wx:if="{{submission.description}}">
        <view class="section-title">描述</view>
        <view class="view-desc-text">{{submission.description}}</view>
      </view>

      <!-- Actions — submitter-only buttons -->
      <view class="card" wx:if="{{userIsSubmitter}}">
        <view class="section-title" wx:if="{{activeApprovalStepId}}">提交人操作</view>
        <view class="audit-btn-bar">
          <button class="secondary-btn" wx:if="{{submission.status === 'draft' || submission.status === 'pending' || submission.status === 'rejected' || submission.status === 'withdrawn'}}" bindtap="enterEditMode">修改审批</button>
          <button class="primary-btn" wx:if="{{submission.status === 'pending' || submission.status === 'rejected' || submission.status === 'withdrawn'}}" bindtap="resubmit">重新提交</button>
          <button class="secondary-btn danger-btn" wx:if="{{submission.status === 'in_progress' || submission.status === 'rejected'}}" bindtap="withdraw">撤回申请</button>
        </view>
      </view>

      <!-- ═══════════ Edit Mode ═══════════ -->
      <view wx:if="{{editMode}}">
        <view class="card">
          <view class="section-title">修改审批</view>
          <view class="section-desc section-desc-sm">修改审批类型、审批人和附件，保存后即可重新提交</view>
        </view>

        <view class="card">
          <view class="section-title">审批类型</view>
          <view class="button-row">
            <button class="{{editType === 'template' ? 'primary-btn' : 'secondary-btn'}}" data-type="template" bindtap="onEditTypeChange">模板审核</button>
            <button class="{{editType === 'ad_hoc' ? 'primary-btn' : 'secondary-btn'}}" data-type="ad_hoc" bindtap="onEditTypeChange">临时审批</button>
          </view>
        </view>

        <!-- Basic info -->
        <view class="card">
          <view class="section-title">基本信息</view>
          <view class="field">
            <view class="field-label">标题</view>
            <input class="field-input" value="{{editTitle}}" bindinput="onEditTitleInput" placeholder="请输入审核标题" />
          </view>
          <view class="field">
            <view class="field-label">描述</view>
            <textarea class="field-textarea" auto-height maxlength="-1" value="{{editDesc}}" bindinput="onEditDescInput" placeholder="可选：填写审核描述/说明" ></textarea>
          </view>
        </view>

        <!-- Ad-hoc steps editor -->
        <view class="card" wx:if="{{editType === 'ad_hoc'}}">
          <view class="section-title">审批步骤 ({{editSteps.length}}步)</view>
          <view class="ad-hoc-step-item" wx:for="{{editSteps}}" wx:key="index">
            <view class="ad-hoc-step-main">
              <view class="ad-hoc-step-title">第{{index + 1}}步 · {{item.actionType === 'pass' ? '仅通过' : (item.actionType === 'sign' ? '签字' : (item.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
              <view class="ad-hoc-step-desc">{{item.approverDesc || '未配置审批人'}}</view>
              <!-- Show individual condition lines for OR logic -->
              <view wx:for="{{item.stepConditionsDisplay}}" wx:for-item="cond" wx:key="*this" wx:if="{{item.stepConditionsDisplay.length > 1}}" class="edit-cond-line">{{cond}}</view>
            </view>
            <view class="list-actions"><text class="audit-link-btn audit-link-danger" data-index="{{index}}" bindtap="removeEditStep">移除</text></view>
          </view>
          <view class="audit-empty-state" wx:if="{{!editSteps.length}}">
            <view class="audit-empty-text">尚未添加审批步骤，请添加</view>
          </view>
          <view class="button-row compact-row">
            <button class="secondary-btn" bindtap="openEditStepEditor">添加步骤 (按身份)</button>
            <button class="secondary-btn" bindtap="openEditPersonPicker">添加步骤 (指定人员)</button>
          </view>
          <view class="field field-mt-16">
            <view class="field-label">驳回重提交模式</view>
            <picker range="{{['重新逐层审批','直接到驳回人']}}" bindchange="onEditResubmitModeChange">
              <view class="picker-value">{{editResubmitMode === 'fresh' ? '重新逐层审批' : '直接到驳回人'}}</view>
            </picker>
          </view>
        </view>

        <!-- Files -->
        <view class="card">
          <view class="section-title">当前附件 ({{editFiles.length}}份)</view>
          <view class="file-attach-item" wx:for="{{editFiles}}" wx:key="id">
            <view class="file-attach-icon">📎</view>
            <view class="file-attach-name">{{item.fileName}}</view>
            <view class="list-actions"><text class="audit-link-btn audit-link-danger" data-index="{{index}}" bindtap="removeEditFile">移除</text></view>
          </view>
          <view class="section-title field-mt-16" wx:if="{{editNewFiles.length}}">新增附件 ({{editNewFiles.length}}份)</view>
          <view class="file-attach-item" wx:for="{{editNewFiles}}" wx:key="fileId">
            <view class="file-attach-icon">📎</view>
            <view class="file-attach-name">{{item.fileName}}</view>
            <view class="list-actions"><text class="audit-link-btn audit-link-danger" data-index="{{index}}" bindtap="removeEditNewFile">移除</text></view>
          </view>
          <view class="button-row compact-row">
            <button class="secondary-btn" bindtap="editChooseImage">选择图片</button>
            <button class="secondary-btn" bindtap="editChooseFile">选择文件</button>
          </view>
        </view>

        <view class="card">
          <view class="audit-btn-bar">
            <button class="primary-btn" loading="{{loading}}" bindtap="saveEdit">保存修改</button>
            <button class="secondary-btn" bindtap="cancelEdit">取消</button>
          </view>
        </view>
      </view>

      <!-- ═══ Edit: Identity step editor popup ═══ -->
      <view class="popup-mask" wx:if="{{editStepEditorVisible}}" bindtap="closeEditStepEditor">
        <view class="popup-card" catchtap="noop">
          <view class="popup-header"><view class="popup-title">添加审批步骤 — 按身份</view><text class="popup-close" bindtap="closeEditStepEditor">关闭</text></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y>
            <view class="detail-popup-form">
              <view class="field">
                <view class="field-label">步骤名称</view>
                <input class="field-input" value="{{editStepForm.name}}" data-field="name" bindinput="onEditStepFieldInput" placeholder="如：部门负责人审批"/>
              </view>
              <view class="field">
                <view class="field-label">审批动作</view>
                <picker range="{{['仅通过','签字','盖章','签字+盖章']}}" bindchange="onEditActionTypeChange">
                  <view class="picker-value">{{editStepForm.actionType === 'pass' ? '仅通过' : (editStepForm.actionType === 'sign' ? '签字' : (editStepForm.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
                </picker>
              </view>
              <view class="field">
                <view class="field-label">审批范围</view>
                <picker range="{{identityPickerScopeOptions}}" bindchange="onEditIdentityScopeChange">
                  <view class="picker-value">{{identityPickerScopeOptions[editIdentityPickerScopeIndex] || '全体成员'}}</view>
                </picker>
              </view>
              <view class="field" wx:if="{{identityPickerScopeValues[editIdentityPickerScopeIndex] === 'specific_department' || identityPickerScopeValues[editIdentityPickerScopeIndex] === 'specific_work_group'}}">
                <view class="field-label">指定部门</view>
                <picker range="{{identityPickerDeptOptions}}" bindchange="onEditIdentityDeptChange">
                  <view class="picker-value">{{identityPickerDeptOptions[editIdentityPickerDeptIndex] || '请选择部门'}}</view>
                </picker>
              </view>
              <view class="field" wx:if="{{identityPickerScopeValues[editIdentityPickerScopeIndex] === 'specific_work_group'}}">
                <view class="field-label">指定职能组</view>
                <picker range="{{identityPickerWgOptions}}" bindchange="onEditIdentityWgChange">
                  <view class="picker-value">{{identityPickerWgOptions[editIdentityPickerWgIndex] || '请选择职能组'}}</view>
                </picker>
              </view>
              <view class="field">
                <view class="field-label">审批人身份</view>
                <picker range="{{identityPickerIdentOptions}}" bindchange="onEditIdentityIdentChange">
                  <view class="picker-value">{{identityPickerIdentOptions[editIdentityPickerIdentIndex] || '请选择身份'}}</view>
                </picker>
              </view>
              <view class="audit-btn-bar"><button class="primary-btn" bindtap="confirmEditIdentityStep">确定</button></view>
            </view>
          </scroll-view>
        </view>
      </view>

      <!-- ═══ Edit: Person picker popup ═══ -->
      <view class="popup-mask" wx:if="{{editPersonPickerVisible}}" bindtap="closeEditPersonPicker">
        <view class="popup-card desig-popup-card" catchtap="noop">
          <view class="popup-header"><view class="popup-title">指定审批人员</view><text class="popup-close" bindtap="closeEditPersonPicker">关闭</text></view>
          <view class="list-title">已选人员（{{editPersonPickerSelectedIds.length}}人）</view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-current-scroll">
            <view class="audit-person-item" wx:for="{{editPersonPickerSelectedList}}" wx:key="id">
              <view class="audit-person-avatar">{{item.name[0]}}</view>
              <view class="audit-person-info">
                <view class="audit-person-name">{{item.name}}</view>
                <view class="audit-person-detail">{{item.department}} · {{item.identity}} · {{item.studentId}}</view>
              </view>
              <view class="inline-actions list-actions-below">
                <text class="audit-link-btn audit-link-danger" data-hr-id="{{item.id}}" bindtap="onEditPersonToggle">移除</text>
              </view>
            </view>
            <view class="empty-inline" wx:if="{{!editPersonPickerSelectedList.length}}">尚未选择任何人</view>
          </scroll-view>
          <view class="list-title field-mt-8">可选人员</view>
          <view class="rule-filter-row">
            <view class="rule-filter-field"><view class="field-label">部门</view><picker range="{{personPickerDeptOpts}}" bindchange="onEditPersonPickerDeptChange"><view class="picker-value compact-picker-value">{{editPersonPickerDept}}</view></picker></view>
            <view class="rule-filter-field"><view class="field-label">身份</view><picker range="{{personPickerIdentOpts}}" bindchange="onEditPersonPickerIdentChange"><view class="picker-value compact-picker-value">{{editPersonPickerIdent}}</view></picker></view>
            <view class="rule-filter-field"><view class="field-label">职能组</view><picker range="{{personPickerWgOpts}}" bindchange="onEditPersonPickerWgChange"><view class="picker-value compact-picker-value">{{editPersonPickerWg}}</view></picker></view>
          </view>
          <view class="field field-mb-8"><input class="field-input" placeholder="搜索姓名/学号" value="{{editPersonPickerKeyword}}" bindinput="onEditPersonPickerSearch"/></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-candidate-scroll">
            <view wx:if="{{!editPersonPickerCandidates.length}}" class="empty-inline">没有匹配的人员</view>
            <view class="audit-person-item" wx:for="{{editPersonPickerCandidates}}" wx:key="id" data-hr-id="{{item.id}}" bindtap="onEditPersonToggle">
              <view class="audit-person-avatar">{{item.name[0]}}</view>
              <view class="audit-person-info">
                <view class="audit-person-name"><view class="select-chip select-chip-inline {{item.isSelected ? 'select-chip-active' : ''}}">{{item.isSelected ? '已选' : '选择'}}</view>{{item.name}}</view>
                <view class="audit-person-detail">{{item.studentId}} · {{item.department}} · {{item.identity}}<text wx:if="{{item.workGroup}}"> · {{item.workGroup}}</text></view>
              </view>
            </view>
          </scroll-view>
          <view class="field field-mt-8">
            <view class="field-label">审批动作</view>
            <picker range="{{['仅通过','签字','盖章','签字+盖章']}}" bindchange="onEditPersonPickerActionTypeChange">
              <view class="picker-value">{{editPersonPickerStepActionType === 'pass' ? '仅通过' : (editPersonPickerStepActionType === 'sign' ? '签字' : (editPersonPickerStepActionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
            </picker>
          </view>
          <view class="button-row">
            <button class="secondary-btn" bindtap="closeEditPersonPicker">取消</button>
            <button class="primary-btn" bindtap="confirmEditPersonPicker">添加 {{editPersonPickerSelectedIds.length}} 人</button>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- ═══ Stamp Picker Popup ═══ -->
  <view class="popup-mask" wx:if="{{stampPickerVisible}}" bindtap="closeStampPicker">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">选择印章</view>
        <text class="popup-close" bindtap="closeStampPicker">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y>
        <view class="detail-popup-form">
          <view wx:if="{{!availableStamps.length}}" class="stamp-empty">暂无可用的印章</view>
          <view wx:for="{{availableStamps}}" wx:key="id"
                class="stamp-picker-item"
                data-stamp-id="{{item.id}}" data-stamp-name="{{item.name}}" data-stamp-image="{{item.imageData}}"
                bindtap="onStampSelect">
            <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="aspectFit" class="stamp-picker-thumb" />
            <view wx:else class="stamp-picker-placeholder">🔴</view>
            <text class="stamp-picker-name">{{item.name}}</text>
            <text class="stamp-picker-select">选择</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ═══ Placement / File Preview Popup (positioning sig/stamp on file) ═══ -->
  <view class="popup-mask" wx:if="{{placementVisible}}" bindtap="closePlacement">
    <view class="popup-card placement-popup" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">预览 &amp; 定位 - {{placementFileName}}</view>
        <text class="popup-close" bindtap="closePlacement">关闭</text>
      </view>

      <!-- Hint -->
      <view class="placement-hint">
        点击文件区域放置{{placementType === 'stamp' ? '印章' : '签名'}}，可多次点击调整位置
        <text wx:if="{{placementCurrentPage > 0 && placementTotalPages > 1}}" class="placement-hint-page">
          · 当前：第{{placementCurrentPage}}页
        </text>
      </view>

      <!-- Page selector for PDFs -->
      <view wx:if="{{placementFileMime === 'application/pdf' && placementTotalPages > 1}}"
            class="placement-page-selector">
        <text class="placement-page-btn"
              data-dir="prev" bindtap="onPlacementPageChange"
              wx:if="{{placementCurrentPage > 1}}">◀ 上一页</text>
        <text class="placement-page-num">第 {{placementCurrentPage}} / {{placementTotalPages}} 页</text>
        <text class="placement-page-btn"
              data-dir="next" bindtap="onPlacementPageChange"
              wx:if="{{placementCurrentPage < placementTotalPages}}">下一页 ▶</text>
      </view>

      <!-- Placement canvas — scrollable to show full file -->
      <scroll-view id="placementCanvas"
            scroll-y="{{true}}"
            class="placement-canvas"
            bindtap="onPlacementTap">
        <!-- Loading indicator -->
        <view wx:if="{{placementLoading}}"
              class="placement-loading">
          ⏳ 加载文件预览中...
        </view>
        <!-- File preview (image or rendered PDF page) -->
        <block wx:elif="{{placementFileImage}}">
          <view class="placement-img-wrap">
            <image id="placementPreviewImage" src="{{placementFileImage}}" mode="widthFix"
                   class="placement-preview-img" />
            <!-- Overlaid signatures/stamps -->
            <block wx:for="{{placementItems}}" wx:key="dispIdx" wx:for-item="item">
              <block wx:if="{{!placementFileMime || placementFileMime.indexOf('pdf') < 0 || item.page === placementCurrentPage}}">
                <image src="{{item.previewSrc}}"
                       mode="aspectFit"
                       data-sig-idx="{{item.dispIdx}}"
                       catchtap="onPlacementItemTap"
                       class="placement-sign-overlay {{placementActiveIdx === item.dispIdx ? 'placement-sign-overlay-active' : ''}}"
                       style="left:{{item.positionX * 100}}%;top:{{item.positionY * 100}}%;width:{{18 * (item.size || 1)}}%;height:{{112 * (item.size || 1)}}rpx;transform:translate(-50%, -50%) rotate({{item.rotation || 0}}deg);" />
              </block>
            </block>
            <!-- Crosshair showing current position -->
            <view wx:if="{{placementPreviewX >= 0}}" class="placement-crosshair placement-crosshair-v" style="left:{{placementPreviewX * 100}}%;top:{{placementPreviewY * 100}}%;"></view>
            <view wx:if="{{placementPreviewX >= 0}}" class="placement-crosshair placement-crosshair-h" style="left:{{placementPreviewX * 100}}%;top:{{placementPreviewY * 100}}%;"></view>
          </view>
        </block>
        <!-- Fallback: no preview available -->
        <view wx:else class="placement-fallback">
          <view class="placement-fallback-icon">📄</view>
          <view>{{placementFileName}}</view>
          <view class="placement-fallback-sub">
            {{placementFileMime === 'application/pdf' ? 'PDF文件 · 点击区域放置签名 · 第' + placementCurrentPage + '页' : '点击区域放置' + (placementType === 'stamp' ? '印章' : '签名')}}
          </view>
        </view>
      </scroll-view>

      <!-- Position info -->
      <view wx:if="{{placementPreviewX >= 0 && placementPosText}}" class="placement-pos-info">
        位置：{{placementPosText}}
        <text wx:if="{{placementCurrentPage > 0 && placementTotalPages > 1}}"> · 第{{placementCurrentPage}}页</text>
      </view>

      <view class="placement-transform-panel" wx:if="{{placementActiveIdx >= 0}}">
        <view class="placement-transform-row">
          <text class="placement-transform-label">大小 {{placementSize}}%</text>
          <slider class="placement-slider" min="50" max="220" step="5" value="{{placementSize}}" activeColor="#2563eb" backgroundColor="#dbeafe" block-size="18" bindchanging="onPlacementSizeChange" bindchange="onPlacementSizeChange" />
        </view>
        <view class="placement-transform-row">
          <text class="placement-transform-label">旋转 {{placementRotation}}°</text>
          <slider class="placement-slider" min="-180" max="180" step="5" value="{{placementRotation}}" activeColor="#2563eb" backgroundColor="#dbeafe" block-size="18" bindchanging="onPlacementRotationChange" bindchange="onPlacementRotationChange" />
        </view>
        <view class="placement-rotate-actions">
          <button class="secondary-btn placement-mini-btn" data-delta="-15" bindtap="nudgePlacementRotation">左转</button>
          <button class="secondary-btn placement-mini-btn" bindtap="resetPlacementTransform">重置</button>
          <button class="secondary-btn placement-mini-btn" data-delta="15" bindtap="nudgePlacementRotation">右转</button>
        </view>
      </view>

      <view class="placement-actions">
        <button class="secondary-btn placement-btn-cancel" bindtap="closePlacement">取消</button>
        <button class="secondary-btn placement-btn-copy" bindtap="addPlacementCopy">新增一处</button>
        <button class="primary-btn placement-btn-save" bindtap="confirmPlacement">保存位置</button>
      </view>
    </view>
  </view>

  <!-- Approval Dialog -->
  <view class="popup-mask" wx:if="{{approvalVisible}}" bindtap="closeApproval">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">{{approvalAction === 'approve' ? '审批通过' : '驳回'}}</view>
        <text class="popup-close" bindtap="closeApproval">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y>
        <view class="detail-popup-form">
          <!-- Signature section (only for approve) -->
          <view wx:if="{{approvalAction === 'approve'}}">
            <view class="list-title">签名/盖章</view>
            <view class="sign-file-card" wx:for="{{pendingSignatures}}" wx:key="index">
              <view class="sign-file-main">
                <view class="sign-file-name">签名{{index + 1}} (文件: {{item.fileId}})</view>
                <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="widthFix" class="sign-file-preview" />
              </view>
              <view class="list-actions"><text class="audit-link-btn audit-link-danger" data-index="{{index}}" bindtap="removePendingSignature">移除</text></view>
            </view>
            <view class="button-row compact-row">
              <button class="secondary-btn" wx:for="{{files}}" wx:key="id" data-file-id="{{item.id}}" bindtap="openSignaturePad">签在 {{item.fileName}}</button>
            </view>
            <view class="field approval-dialog-field-mt">
              <view class="field-label">审批意见</view>
              <textarea class="field-textarea" auto-height maxlength="-1" value="{{approvalComment}}" bindinput="onApprovalCommentInput" placeholder="可选：填写审批意见" />
            </view>
          </view>

          <!-- Reject reason -->
          <view wx:if="{{approvalAction === 'reject'}}">
            <view class="field">
              <view class="field-label">驳回理由</view>
              <textarea class="field-textarea" auto-height maxlength="-1" value="{{rejectionReason}}" bindinput="onRejectionReasonInput" placeholder="请填写驳回理由（必填）" />
            </view>
          </view>

          <view class="audit-btn-bar">
            <button class="primary-btn" loading="{{loading}}" bindtap="confirmApproval">{{approvalAction === 'approve' ? '确认通过' : '确认驳回'}}</button>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ═══ Signature Source Picker Popup (saved signatures + new drawing) ═══ -->
  <view class="popup-mask" wx:if="{{sigSourcePickerVisible}}" bindtap="closeSigSourcePicker">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">选择签名方式</view>
        <text class="popup-close" bindtap="closeSigSourcePicker">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y>
        <view class="detail-popup-form">
          <view class="sig-source-file-name">{{sigSourceFileName}}</view>

          <!-- Saved Signatures -->
          <view wx:if="{{mySignatures.length}}" class="sig-source-section">
            <view class="sig-source-section-title">我的签名</view>
            <view wx:for="{{mySignatures}}" wx:key="id"
                  class="sig-source-item"
                  data-sig-id="{{item.id}}" data-sig-image="{{item.imageData}}"
                  bindtap="onSelectSavedSignature">
              <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="aspectFit"
                     class="sig-source-thumb" />
              <view wx:else class="sig-source-thumb-placeholder">✍️</view>
              <view class="sig-source-item-info">
                <view class="sig-source-item-name">{{item.name}}</view>
                <view wx:if="{{item.isDefault}}" class="sig-source-default-badge">默认签名</view>
              </view>
              <text class="sig-source-use-btn">使用</text>
            </view>
          </view>

          <!-- No saved signatures -->
          <view wx:if="{{!mySignatures.length}}" class="sig-source-empty">
            暂无已保存的签名
          </view>

          <!-- Divider -->
          <view class="sig-source-divider">
            <view class="sig-source-divider-line"></view>
            <text class="sig-source-divider-text">或</text>
            <view class="sig-source-divider-line"></view>
          </view>

          <!-- Draw new signature -->
          <view class="sig-source-draw-section">
            <view class="sig-source-draw-title">手写新签名</view>
            <!-- Save option -->
            <view class="sig-source-save-row" bindtap="onSigSaveToggle">
              <view style="width:36rpx;height:36rpx;border-radius:6rpx;border:2rpx solid {{sigSaveNew ? '#3b82f6' : '#cbd5e1'}};background:{{sigSaveNew ? '#3b82f6' : '#fff'}};display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <text wx:if="{{sigSaveNew}}" class="sig-source-check-icon">✓</text>
              </view>
              <text class="sig-source-save-label">保存此签名到我的签名库</text>
            </view>
            <view wx:if="{{sigSaveNew}}" class="sig-source-save-input-wrap">
              <input class="sig-source-save-input"
                     placeholder="签名名称（可选）" value="{{sigSaveName}}" bindinput="onSigSaveNameInput" />
            </view>
            <button class="primary-btn sig-source-draw-btn" bindtap="onOpenNewSignaturePad">✍️ 手写签名</button>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- Signature Pad Popup (with save-to-library controls) -->
  <view class="popup-mask" wx:if="{{signaturePadVisible}}" bindtap="closeSignaturePad">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">手写签名</view>
        <text class="popup-close" bindtap="closeSignaturePad">关闭</text>
      </view>
      <signature-pad bindconfirm="onSignatureConfirm" />
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>
</view>

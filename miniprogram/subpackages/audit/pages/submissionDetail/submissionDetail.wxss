@import '../../../../pages/home/home.wxss';

.status-chip { display:inline-block; padding:2rpx 12rpx; border-radius:16rpx; font-size:20rpx; background:#f1f5f9; color:#64748b; margin-right:8rpx; }
.green-chip { background:#d1fae5; color:#065f46; }
.red-chip { background:#fee2e2; color:#991b1b; }
.blue-chip { background:#dbeafe; color:#1e40af; }

.list-item-selected { background:rgba(37,99,235,0.06); border:2rpx solid #2563eb; border-radius:12rpx; }

.danger-btn { background:linear-gradient(135deg,#f43f5e,#e11d48) !important; color:#fff !important; }
.danger-text { color:#ef4444; font-size:24rpx; margin-top:4rpx; }

.small-scroll { max-height:360rpx; }

/* ── Approver picker (shared with merit list designation pattern) ── */
.select-chip {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 700;
  background: linear-gradient(135deg, rgba(239,246,255,0.98) 0%, rgba(219,234,254,0.90) 100%);
  color: #1d4ed8; border: 1rpx solid rgba(147,197,253,0.8);
}
.select-chip.select-chip-active,
.select-chip.select-chip-inline.select-chip-active {
  background: linear-gradient(135deg, rgba(220,252,231,0.98) 0%, rgba(187,247,208,0.9) 100%) !important;
  color: #15803d !important; border-color: rgba(134,239,172,0.6) !important;
}
.select-chip-inline { display: inline-flex; margin-right: 12rpx; vertical-align: middle; }

/* ── Designation popup (reused for person picker) ── */
.desig-popup-card {
  max-height: 88vh; overflow-y: auto;
  padding: 28rpx 28rpx 24rpx;
}
.desig-popup-card .button-row { margin-top: 16rpx; }

.desig-inner-scroll {
  margin-bottom: 8rpx; border-radius: 20rpx;
  background: rgba(248,250,252,0.6);
  border: 1rpx solid rgba(226,232,240,0.7);
  padding: 8rpx;
}
.desig-current-scroll { height: 220rpx; }
.desig-candidate-scroll { height: 340rpx; }
.desig-current-item { background: rgba(255,255,255,0.85); }

.rule-filter-row { display: flex; gap: 16rpx; margin-bottom: 6rpx; }
.rule-filter-field { flex: 1; min-width: 0; }
.compact-picker-value {
  min-height: 70rpx; padding: 0 18rpx; font-size: 23rpx; border-radius: 18rpx;
}

.inline-actions { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
.list-actions-below { margin-top: 12rpx; }

.list-title {
  position: relative; padding-left: 18rpx; margin-bottom: 10rpx;
  color: #0f172a; font-size: 26rpx; font-weight: 700;
}
.list-title::before {
  content: ""; position: absolute; left: 0; top: 6rpx;
  width: 8rpx; height: 24rpx; border-radius: 999rpx;
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 0 14rpx rgba(59,130,246,0.24);
}

.link {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 10rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600;
  line-height: 1; background: rgba(219,234,254,0.65); color: #1d4ed8;
  border: 1rpx solid rgba(147,197,253,0.45);
}

.popup-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 18rpx; }
.popup-title { color: #0f172a; font-size: 30rpx; font-weight: 700; }
.popup-close { color: #2563eb; font-size: 24rpx; font-weight: 700; }
.popup-scroll { max-height: 58vh; }

.list-item {
  display: flex; justify-content: space-between; gap: 16rpx;
  padding: 18rpx 20rpx; margin-bottom: 8rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.7); border: 1rpx solid rgba(0,0,0,0.04);
}
.list-main { flex: 1; min-width: 0; }
.list-name { color: #0f172a; font-size: 28rpx; font-weight: 700; line-height: 1.45; margin-bottom: 6rpx; }
.list-desc { color: #64748b; font-size: 22rpx; line-height: 1.5; }
.empty-inline { padding: 28rpx 0; text-align: center; font-size: 24rpx; color: #94a3b8; }

.field-label { color: #52647c; font-size: 24rpx; margin-bottom: 4rpx; }
.field-input {
  width: 100%; padding: 12rpx 16rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.7); border: 1rpx solid rgba(203,213,225,0.82);
  font-size: 24rpx; box-sizing: border-box;
}

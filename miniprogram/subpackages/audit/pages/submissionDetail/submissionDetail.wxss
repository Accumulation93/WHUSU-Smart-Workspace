@import '../../../../pages/home/home.wxss';

.status-chip { display:inline-block; padding:2rpx 12rpx; border-radius:16rpx; font-size:20rpx; background:#f1f5f9; color:#64748b; margin-right:8rpx; }
.green-chip { background:#d1fae5; color:#065f46; }
.red-chip { background:#fee2e2; color:#991b1b; }
.blue-chip { background:#dbeafe; color:#1e40af; }

.list-item-selected { background:rgba(37,99,235,0.06); border:2rpx solid #2563eb; border-radius:12rpx; }

.danger-btn { background:linear-gradient(135deg,#f43f5e,#e11d48) !important; color:#fff !important; }
.danger-text { color:#ef4444; font-size:24rpx; margin-top:4rpx; }

.small-scroll { max-height:360rpx; }

@import '../../../../pages/home/home.wxss';
@import '../../styles/blue-polish.wxss';

/* ── Create mode: template list items ── */
.template-select-item {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 20rpx; margin-bottom: 10rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%);
  border: 2rpx solid rgba(226,237,247,0.90);
  box-shadow: 0 8rpx 18rpx rgba(15,23,42,0.03);
  box-sizing: border-box; transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.24s ease, transform 0.2s ease;
}
.template-select-item:last-child { margin-bottom: 0; }
.template-select-item-selected {
  border-color: rgba(37,99,235,0.55);
  background: linear-gradient(135deg, rgba(239,246,255,0.96) 0%, rgba(219,234,254,0.90) 100%);
  box-shadow: 0 12rpx 28rpx rgba(37,99,235,0.10), inset 0 1rpx 0 rgba(255,255,255,0.82);
}

/* Radio dot for template selection */
.radio-dot {
  flex-shrink: 0; width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 3rpx solid #cbd5e1; background: #fff;
  transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.22s ease, transform 0.2s ease;
}
.radio-dot-checked {
  border-color: #2563eb; background: #2563eb;
  box-shadow: inset 0 0 0 6rpx #fff, 0 0 0 6rpx rgba(37,99,235,0.16);
}

/* ── Ad-hoc step list ── */
.ad-hoc-step-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 20rpx; margin-bottom: 10rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%);
  border: 1rpx solid rgba(226,237,247,0.90);
  box-shadow: 0 8rpx 18rpx rgba(15,23,42,0.03);
  box-sizing: border-box;
}
.ad-hoc-step-item:last-child { margin-bottom: 0; }
.ad-hoc-step-main { flex: 1; min-width: 0; }
.ad-hoc-step-title { color: #0f172a; font-size: var(--ui-type-body); font-weight: 700; line-height: 1.45; }
.ad-hoc-step-desc { color: #64748b; font-size: var(--ui-type-caption); line-height: 1.5; margin-top: 4rpx; }

/* ── File attachment item ── */
.file-attach-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 20rpx; margin-bottom: 8rpx; border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.76) 100%);
  border: 1rpx solid rgba(226,237,247,0.88);
  box-shadow: 0 8rpx 18rpx rgba(15,23,42,0.03);
  box-sizing: border-box;
}
.file-attach-item:last-child { margin-bottom: 0; }
.file-attach-icon {
  flex-shrink: 0; width: 52rpx; height: 52rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(219,234,254,0.94) 0%, rgba(191,219,254,0.84) 100%);
  border: 1rpx solid rgba(147,197,253,0.48);
  color: #2563eb; font-size: var(--ui-type-control); font-weight: 700;
}
.file-attach-name { flex: 1; min-width: 0; color: #0f172a; font-size: var(--ui-type-control); font-weight: 600; line-height: 1.4; }

/* ── View mode: status info block variations ── */
.detail-status-chip {
  display: inline-flex; align-items: center; min-height: 48rpx;
  padding: 8rpx 22rpx; border-radius: 999rpx; font-size: var(--ui-type-emphasis); font-weight: 700;
  letter-spacing: 0.3rpx;
}
.detail-status-approved { color: #15803d; background: linear-gradient(135deg, rgba(220,252,231,0.96) 0%, rgba(167,243,208,0.88) 100%); border: 1rpx solid rgba(110,231,183,0.5); }
.detail-status-rejected { color: #dc2626; background: linear-gradient(135deg, rgba(254,242,242,0.96) 0%, rgba(254,226,226,0.88) 100%); border: 1rpx solid rgba(252,165,165,0.5); }
.detail-status-progress { color: #2563eb; background: linear-gradient(135deg, rgba(219,234,254,0.96) 0%, rgba(191,219,254,0.88) 100%); border: 1rpx solid rgba(147,197,253,0.5); }
.detail-status-draft    { color: #475569; background: linear-gradient(135deg, rgba(241,245,249,0.96) 0%, rgba(226,232,240,0.88) 100%); border: 1rpx solid rgba(148,163,184,0.4); }
.detail-status-pending  { color: #c2410c; background: linear-gradient(135deg, rgba(255,247,237,0.98) 0%, rgba(254,215,170,0.90) 100%); border: 1rpx solid rgba(253,186,116,0.5); }
.detail-status-withdrawn{ color: #9a3412; background: linear-gradient(135deg, rgba(255,247,237,0.96) 0%, rgba(254,215,170,0.86) 100%); border: 1rpx solid rgba(253,186,116,0.45); }

/* ── Action buttons in step list ── */
.step-action-link {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 12rpx 22rpx; border-radius: 999rpx; font-size: var(--ui-type-meta); font-weight: 600;
  line-height: 1; letter-spacing: 0.2rpx;
  background: linear-gradient(135deg, rgba(219,234,254,0.88) 0%, rgba(191,219,254,0.76) 100%);
  color: #2563eb; border: 1rpx solid rgba(147,197,253,0.52);
  box-shadow: 0 6rpx 14rpx rgba(37,99,235,0.06);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.step-action-link:active { transform: scale(0.94); opacity: 0.85; }
.step-action-danger {
  background: linear-gradient(135deg, rgba(254,242,242,0.92) 0%, rgba(254,226,226,0.80) 100%);
  color: #dc2626; border-color: rgba(252,165,165,0.52);
}

/* ── Signature sign card in approval popup ── */
.sign-file-card {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 20rpx; margin-bottom: 8rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.86) 0%, rgba(248,251,255,0.74) 100%);
  border: 1rpx solid rgba(226,237,247,0.82);
}
.sign-file-card:last-child { margin-bottom: 0; }
.sign-file-preview {
  width: 160rpx; border-radius: 10rpx; background: #fff;
  border: 1rpx solid rgba(226,232,240,0.6); margin-top: 6rpx;
}
.sign-file-main { flex: 1; min-width: 0; }
.sign-file-name { color: #0f172a; font-size: var(--ui-type-label); font-weight: 600; line-height: 1.4; }

/* ── Danger button override for withdraw ── */
.danger-btn {
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%) !important;
  color: #fff !important;
  box-shadow: 0 14rpx 28rpx rgba(239,68,68,0.16), inset 0 1rpx 0 rgba(255,255,255,0.18) !important;
}

/* ── Popup form tweaks ── */
.detail-popup-form {
  margin: 0;
  padding: var(--ui-dialog-section-padding);
  border-radius: var(--ui-dialog-section-radius);
  background: linear-gradient(145deg, rgba(255,255,255,0.95), rgba(249,251,255,0.86));
  border: 1rpx solid rgba(226,237,247,0.94);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.045), inset 0 1rpx 0 rgba(255,255,255,0.88);
  box-sizing: border-box;
}
.detail-popup-form .field-textarea {
  min-height: 120rpx; border-radius: 18rpx; font-size: var(--ui-type-control);
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(247,250,255,0.80) 100%);
  border: 1rpx solid rgba(226,232,240,0.7);
}

/* ── Template step preview items ── */
.tpl-step-preview-item {
  display: flex; align-items: flex-start; gap: 14rpx;
  padding: 20rpx 18rpx; margin-bottom: 8rpx; border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.84) 0%, rgba(248,251,255,0.72) 100%);
  border: 1rpx solid rgba(226,237,247,0.80);
  box-shadow: 0 6rpx 14rpx rgba(15,23,42,0.025);
}
.tpl-step-preview-item:last-child { margin-bottom: 0; }
.tpl-step-preview-main { flex: 1; min-width: 0; }
.tpl-step-preview-num { font-size: var(--ui-type-emphasis); font-weight: 700; color: #0f172a; letter-spacing: 0; margin-bottom: 4rpx; }
.tpl-step-preview-desc { font-size: var(--ui-type-meta); color: #64748b; font-weight: 400; line-height: 1.45; }
.tpl-step-preview-action {
  display: inline-flex; margin-top: 4rpx; padding: 3rpx 12rpx; border-radius: 999rpx;
  font-size: var(--ui-type-micro); font-weight: 600; background: rgba(219,234,254,0.6); color: #2563eb;
}
.tpl-step-preview-mode { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 2rpx; }
.tpl-step-fixed-mode { color: #6b7b91; font-size: var(--ui-type-caption); line-height: 1.4; text-align: right; }
.tpl-step-toggle {
  display: inline-flex; align-items: center; padding: 6rpx 16rpx; border-radius: 999rpx;
  font-size: var(--ui-type-caption); font-weight: 600; line-height: 1; letter-spacing: 0.3rpx;
  background: rgba(241,245,249,0.8); color: #64748b; border: 1rpx solid rgba(203,213,225,0.6);
  transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.24s ease, transform 0.2s ease;
}
.tpl-step-toggle-active {
  background: linear-gradient(135deg, rgba(219,234,254,0.88) 0%, rgba(191,219,254,0.76) 100%);
  color: #2563eb; border-color: rgba(147,197,253,0.55);
}
.tpl-step-person-tag {
  display: inline-flex; align-items: center; gap: 4rpx;
  padding: 3rpx 10rpx; border-radius: 999rpx; margin-right: 4rpx; margin-bottom: 3rpx;
  font-size: var(--ui-type-micro); font-weight: 500; color: #2563eb;
  background: rgba(219,234,254,0.65); border: 1rpx solid rgba(147,197,253,0.4);
}
.tpl-step-person-remove {
  display: inline-flex; align-items: center; justify-content: center;
  width: 22rpx; height: 22rpx; border-radius: 50%;
  font-size: var(--ui-type-micro); color: #ef4444; margin-left: 2rpx;
}

/* ── Expandable flow nodes — glassmorphism ── */
.flow-node {
  transition: background 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94), border-color 0.28s ease, box-shadow 0.3s ease, transform 0.24s ease;
}

/* Tap feedback: subtle frosted glass ripple (replaces default blue highlight) */
.flow-node-tap {
  background: radial-gradient(circle at center, rgba(148,163,184,0.08) 0%, transparent 70%);
  border-radius: 16rpx;
  transition: none;
}

/* Expanded state: soft glass card */
.flow-node-expanded .flow-info {
  background: linear-gradient(135deg, rgba(255,255,255,0.72) 0%, rgba(248,250,252,0.64) 100%);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(203,213,225,0.35);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(15,23,42,0.06), inset 0 1rpx 0 rgba(255,255,255,0.6);
  transition: background 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94), border-color 0.28s ease, box-shadow 0.32s ease, transform 0.24s ease;
}
.flow-node-expanded .flow-info-lifecycle {
  background: linear-gradient(135deg, rgba(255,255,255,0.72) 0%, rgba(248,250,252,0.64) 100%);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(203,213,225,0.35);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(15,23,42,0.06), inset 0 1rpx 0 rgba(255,255,255,0.6);
  transition: background 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94), border-color 0.28s ease, box-shadow 0.32s ease, transform 0.24s ease;
}

/* ═══ Field utility classes ═══ */
.field-mt-16 { margin-top: 16rpx; }
.field-mt-8 { margin-top: 8rpx; }
.field-mb-8 { margin-bottom: 8rpx; }
.section-desc-sm { font-size: var(--ui-type-caption); color: #94a3b8; margin-bottom: 12rpx; }
.view-desc-text { font-size: var(--ui-type-control); color: #475569; line-height: 1.6; white-space: pre-wrap; }
.edit-cond-line { font-size: var(--ui-type-caption); color: #94a3b8; margin-top: 2rpx; }
.tpl-step-override-persons { margin-top: 4rpx; }
.tpl-step-override-link { font-size: var(--ui-type-caption); margin-top: 4rpx; }

/* ═══ Status hint box ═══ */
.status-hint-box {
  display: flex; align-items: flex-start; gap: 10rpx;
  margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 16rpx;
  font-size: var(--ui-type-label); line-height: 1.6; color: #64748b;
  background: rgba(248, 251, 255, 0.7);
  border: 1rpx solid rgba(226, 232, 240, 0.45);
}
.status-hint-icon { flex: none; padding-top: 2rpx; }
.status-hint-copy { min-width: 0; flex: 1; }

/* ═══ Active Approval Card ═══ */
.approval-card { border: 2rpx solid #3b82f6; background: #eff6ff; }
.approval-card-title { color: #2563eb; }
.approval-step-info { margin-bottom: 6rpx; font-size: var(--ui-type-emphasis); font-weight: 700; color: #0f172a; }
.approval-round-note { color: #94a3b8; }
.approval-step-desc { margin-bottom: 12rpx; font-size: var(--ui-type-meta); color: #64748b; }
.approval-sig-section {
  margin-bottom: 16rpx; padding: 12rpx; border: 1rpx solid #dbeafe;
  border-radius: 12rpx; background: #f8faff;
}
.approval-sig-header { font-size: var(--ui-type-label); font-weight: 600; color: #2563eb; margin-bottom: 8rpx; }
.approval-file-item {
  margin-bottom: 10rpx; padding: 10rpx; border: 1rpx solid #e2e8f0;
  border-radius: 10rpx; background: #fff;
}
.approval-file-row { display: flex; align-items: center; justify-content: space-between; }
.approval-file-name {
  display: flex; align-items: center; gap: 8rpx;
  font-size: var(--ui-type-meta); color: #334155; flex: 1; min-width: 0;
  white-space: normal; overflow-wrap: anywhere;
}
.approval-file-name text { min-width: 0; overflow-wrap: anywhere; }
.approval-file-actions { display: flex; gap: 4rpx; flex-shrink: 0; margin-left: 8rpx; }
.approval-file-btn-preview { font-size: var(--ui-type-caption); color: #64748b; padding: 4rpx 10rpx; border: 1rpx solid #94a3b8; border-radius: 20rpx; }
.approval-file-btn-sign { font-size: var(--ui-type-caption); color: #3b82f6; padding: 4rpx 10rpx; border: 1rpx solid #3b82f6; border-radius: 20rpx; }
.approval-file-btn-stamp { font-size: var(--ui-type-caption); color: #0369a1; padding: 4rpx 10rpx; border: 1rpx solid #0369a1; border-radius: 20rpx; }
.approval-sig-item {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 6rpx; padding: 6rpx 10rpx; background: #f1f5f9; border-radius: 8rpx;
}
.approval-sig-info { display: flex; align-items: center; gap: 6rpx; }
.approval-sig-thumb { width: 36rpx; height: 36rpx; border-radius: 4rpx; border: 1rpx solid #cbd5e1; }
.approval-sig-name { font-size: var(--ui-type-caption); color: #475569; }
.approval-sig-pos { font-size: var(--ui-type-micro); color: #94a3b8; }
.approval-sig-actions { display: flex; gap: 8rpx; }
.approval-sig-action-adjust { font-size: var(--ui-type-micro); color: #3b82f6; }
.approval-sig-action-remove { font-size: var(--ui-type-micro); color: #ef4444; }
.approval-warning { padding: 8rpx 12rpx; background: #fef3c7; border-radius: 8rpx; font-size: var(--ui-type-caption); color: #d97706; }
.approval-field-label { font-size: var(--ui-type-label); font-weight: 600; color: #475569; margin-bottom: 6rpx; }
.approval-textarea {
  width: 100%; min-height: 100rpx; padding: 12rpx; border: 1rpx solid #d1d5db;
  border-radius: 10rpx; font-size: var(--ui-type-label); box-sizing: border-box;
}
.approval-designate-row { margin-bottom: 12rpx; }
.approval-designate-label { font-size: var(--ui-type-label); font-weight: 600; color: #475569; margin-bottom: 6rpx; }
.approval-designate-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.approval-designate-link { font-size: var(--ui-type-caption); }
.approval-designate-empty { font-size: var(--ui-type-caption); color: #94a3b8; }
.approval-designate-tag {
  display: inline-flex; align-items: center; margin: 2rpx 6rpx 2rpx 0;
  padding: 2rpx 10rpx; background: #dbeafe; border-radius: 20rpx;
  font-size: var(--ui-type-caption); color: #2563eb;
}
.approval-designate-remove { margin-left: 4rpx; color: #ef4444; }
.approval-next-step-info { font-size: var(--ui-type-caption); color: #94a3b8; margin-top: 4rpx; }
.approval-btn-approve { flex: 1; background: #10b981; border-color: #10b981; }
.approval-btn-reject { flex: 1; }

/* ═══ Flow visualization ═══ */
.flow-summary-text { font-size: var(--ui-type-label); font-weight: 600; color: #475569; white-space: nowrap; }
.flow-expand-hint { font-size: var(--ui-type-micro); color: #94a3b8; margin-top: 2rpx; }
.flow-expand-detail { margin-top: 8rpx; padding: 10rpx 12rpx; background: #f8fafc; border-radius: 8rpx; }
.flow-detail-text { font-size: var(--ui-type-caption); color: #64748b; line-height: 1.6; }
.flow-detail-label { font-weight: 600; }
.flow-detail-meta { font-size: var(--ui-type-caption); color: #94a3b8; margin-top: 4rpx; }
.flow-detail-reject { font-size: var(--ui-type-caption); color: #dc2626; margin-top: 6rpx; line-height: 1.6; }
.flow-detail-conditions-label { font-size: var(--ui-type-caption); font-weight: 600; color: #64748b; }
.flow-detail-cond-line { font-size: var(--ui-type-caption); color: #94a3b8; margin-top: 2rpx; }
.flow-collapsed-comment {
  margin-top: 2rpx; font-size: var(--ui-type-caption); color: #94a3b8; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; max-width: 400rpx;
}
.flow-diagnostic {
  margin: 12rpx 0; padding: 16rpx 20rpx; border-radius: 16rpx;
  background: rgba(254, 242, 242, 0.6); border: 1rpx solid rgba(252, 165, 165, 0.4);
}
.flow-diagnostic-text { font-size: var(--ui-type-caption); color: #dc2626; }
.flow-empty-draft {
  margin: 12rpx 0; padding: 16rpx 20rpx; border-radius: 16rpx;
  background: rgba(248, 251, 255, 0.7); border: 1rpx solid rgba(226, 232, 240, 0.45);
}
.flow-empty-draft-text { font-size: var(--ui-type-label); color: #64748b; }
.flow-detail-processed-text { font-size: var(--ui-type-caption); color: #475569; line-height: 1.6; }
.flow-detail-processed-meta { font-size: var(--ui-type-caption); color: #94a3b8; margin-top: 2rpx; }
.flow-detail-comment { font-size: var(--ui-type-caption); color: #475569; margin-top: 6rpx; line-height: 1.6; }
.flow-detail-conditions { margin-top: 6rpx; }
.flow-detail-round { font-size: var(--ui-type-caption); color: #94a3b8; margin-top: 4rpx; }

/* ═══ Stamp picker popup ═══ */
.stamp-empty { text-align: center; padding: 40rpx; color: #94a3b8; }
.stamp-picker-item {
  display: flex; align-items: center; gap: 16rpx; padding: 16rpx;
  margin-bottom: 8rpx; border: 1rpx solid #e2e8f0; border-radius: 12rpx;
}
.stamp-picker-thumb { width: 60rpx; height: 60rpx; border-radius: 8rpx; border: 1rpx solid #e2e8f0; }
.stamp-picker-placeholder {
  width: 60rpx; height: 60rpx; border-radius: 8rpx; background: #f1f5f9;
  display: flex; align-items: center; justify-content: center;
}
.stamp-placeholder-mark {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(239, 68, 68, 0.78);
  border-radius: 50%;
  background: rgba(254, 226, 226, 0.84);
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.72);
}
.stamp-picker-name { font-size: var(--ui-type-body); color: #334155; flex: 1; }
.stamp-picker-select { font-size: var(--ui-type-caption); color: #3b82f6; }

/* ═══ Placement popup ═══ */
.placement-hint { flex-shrink: 0; padding: 8rpx 16rpx; font-size: var(--ui-type-meta); line-height: 1.6; color: #64748b; }
.placement-hint-page { color: #3b82f6; }
.placement-page-selector { flex-shrink: 0; display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: 8rpx 16rpx; }
.placement-page-btn { font-size: var(--ui-type-meta); color: #2563eb; padding: 6rpx 16rpx; border: 1rpx solid rgba(147,197,253,0.64); border-radius: 999rpx; background: rgba(219,234,254,0.76); }
.placement-page-num { font-size: var(--ui-type-label); color: #475569; font-weight: 600; }
.placement-popup {
  display: flex; flex-direction: column;
  max-height: 88vh; overflow: hidden !important;
}
.placement-popup .popup-header { flex-shrink: 0; }
/* Ensure "关闭" stays on one line */
.placement-popup .popup-close { white-space: nowrap; flex-shrink: 0; }
/* ★ 鲁棒约束：flex 自动分配空间，min-height:0 允许真正收缩，overflow:hidden 裁剪溢出内容。
     预览区永远在 header/hint 下方、pos-info/transform/actions 上方，绝不会挤出或遮挡底部按钮。 */
.placement-canvas {
  position: relative;
  flex: 1 1 0%;        /* 占据剩余空间，可增长也可收缩 */
  min-height: 0;       /* ★ 关键：覆盖 flex 默认 min-height:auto，允许收缩到比内容小 */
  overflow: hidden;    /* 内容由内部 scroll-view 滚动 */
  width: calc(100% - 32rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(248,251,255,0.80));
  border: 1rpx solid rgba(191,219,254,0.68); border-radius: 24rpx;
  margin: 0 16rpx; box-sizing: border-box;
  box-shadow: 0 12rpx 28rpx rgba(15,23,42,0.05), inset 0 1rpx 0 rgba(255,255,255,0.78);
}
.placement-loading { display: flex; align-items: center; justify-content: center; gap: 10rpx; height: 100%; min-height: 240rpx; color: #94a3b8; font-size: var(--ui-type-label); }
.placement-fallback {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  height: 100%; min-height: 240rpx; color: #94a3b8; font-size: var(--ui-type-body);
}
.placement-fallback-icon { font-size: var(--ui-type-page); margin-bottom: 12rpx; }
.placement-fallback-sub { font-size: var(--ui-type-caption); margin-top: 8rpx; }
.placement-img-wrap { position: relative; display: inline-block; width: 100%; }
.placement-preview-img { width: 100%; display: block; }
.placement-sign-overlay {
  position: absolute;
  width: 18%;
  height: 112rpx;
  transform: translate(-50%, -50%);
  border-radius: 8rpx;
  opacity: 0.96;
  z-index: 2;
  background: rgba(255,255,255,0.18);
  box-shadow: 0 8rpx 18rpx rgba(15,23,42,0.10);
  box-sizing: border-box;
}
.placement-sign-overlay-active { border: 3rpx solid #3b82f6; box-shadow: 0 0 0 6rpx rgba(59,130,246,0.14), 0 12rpx 24rpx rgba(37,99,235,0.16); }
.placement-crosshair {
  position: absolute;
  background: #2563eb;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 0 2rpx rgba(255,255,255,0.75);
  z-index: 3;
  pointer-events: none;
}
.placement-crosshair-v { width: 4rpx; height: 36rpx; }
.placement-crosshair-h { width: 36rpx; height: 4rpx; }
.placement-pos-info { flex-shrink: 0; padding: 10rpx 16rpx; font-size: var(--ui-type-meta); color: #64748b; text-align: center; }
.placement-transform-panel {
  flex-shrink: 0;
  margin: 12rpx 16rpx 0;
  padding: 18rpx 18rpx 14rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(248,251,255,0.82));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow: 0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.78);
}
.placement-transform-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 10rpx; }
.placement-transform-label { flex: 0 0 142rpx; color: #1e293b; font-size: var(--ui-type-meta); font-weight: 700; }
.placement-slider { flex: 1; margin: 0; }
.placement-rotate-actions { display: flex; gap: 10rpx; padding-top: 4rpx; }
.placement-mini-btn {
  flex: 1; min-width: 0; height: 58rpx; line-height: 58rpx; margin: 0;
  border-radius: 18rpx; font-size: var(--ui-type-meta); font-weight: 700;
}
/* ★ 三按钮同一排，绝不换行 */
.placement-actions { flex-shrink: 0; padding: 12rpx 16rpx; display: flex; flex-wrap: nowrap; gap: 10rpx; box-sizing: border-box; }
.placement-actions button {
  flex: 1 1 0; min-width: 0; min-height: 72rpx; height: auto; line-height: 1.4; margin: 0; padding: 14rpx 10rpx;
  border-radius: 20rpx; font-size: var(--ui-type-meta); font-weight: 700;
  white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere;
  box-sizing: border-box;
}
/* 三个按钮均分宽度，flex: 1 1 0 已覆盖 */

/* ═══ Approval dialog ═══ */
.approval-dialog-field-mt { margin-top: 12rpx; }

/* ═══ Signature source picker ═══ */
.sig-source-file-name { font-size: var(--ui-type-meta); color: #64748b; margin-bottom: 12rpx; }
.sig-source-section { margin-bottom: 16rpx; }
.sig-source-section-title { font-size: var(--ui-type-control); font-weight: 600; color: #334155; margin-bottom: 8rpx; }
.sig-source-item {
  display: flex; align-items: center; gap: 16rpx; padding: 14rpx 16rpx;
  margin-bottom: 8rpx; border: 1rpx solid #e2e8f0; border-radius: 12rpx; background: #fff;
}
.sig-source-thumb { width: 80rpx; height: 60rpx; border-radius: 8rpx; border: 1rpx solid #e2e8f0; background: #f8fafc; }
.sig-source-thumb-placeholder {
  width: 80rpx; height: 60rpx; border-radius: 8rpx; background: #f1f5f9;
  display: flex; align-items: center; justify-content: center; font-size: var(--ui-type-section);
}
.sig-source-item-info { flex: 1; }
.sig-source-item-name { font-size: var(--ui-type-body); color: #334155; }
.sig-source-default-badge { font-size: var(--ui-type-caption); color: #3b82f6; }
.sig-source-use-btn { font-size: var(--ui-type-meta); color: #3b82f6; }
.sig-source-empty { text-align: center; padding: 20rpx; color: #94a3b8; font-size: var(--ui-type-label); }
.sig-source-divider { display: flex; align-items: center; gap: 12rpx; margin: 16rpx 0; }
.sig-source-divider-line { flex: 1; height: 1rpx; background: #e2e8f0; }
.sig-source-divider-text { font-size: var(--ui-type-caption); color: #94a3b8; }
.sig-source-draw-section { margin-bottom: 12rpx; }
.sig-source-draw-title { font-size: var(--ui-type-control); font-weight: 600; color: #334155; margin-bottom: 8rpx; }
.sig-source-save-row { display: flex; align-items: center; gap: 8rpx; margin-bottom: 8rpx; }
.sig-source-save-label { font-size: var(--ui-type-label); color: #475569; }
.sig-source-save-input {
  width: 100%; padding: 12rpx; border: 1rpx solid #d1d5db;
  border-radius: 8rpx; font-size: var(--ui-type-label); box-sizing: border-box;
}
.sig-source-draw-btn { width: 100%; }
.sig-source-check-icon { color: #fff; font-size: var(--ui-type-meta); }
.sig-source-save-input-wrap { margin-bottom: 10rpx; }
.flow-detail-comment-text { margin-top: 4rpx; }

/* Final detail polish: override late legacy flat blocks */
.approval-card,
.approval-sig-section,
.approval-file-item,
.approval-sig-item,
.flow-expand-detail,
.stamp-picker-item,
.sig-source-item,
.status-hint-box,
.flow-diagnostic,
.flow-empty-draft {
  background: linear-gradient(135deg, rgba(255,255,255,0.90), rgba(248,251,255,0.78)) !important;
  border: 1rpx solid rgba(226,237,247,0.90) !important;
  border-radius: 20rpx !important;
  box-shadow:
    0 10rpx 22rpx rgba(15,23,42,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.78) !important;
}

.approval-card {
  border-color: rgba(96,165,250,0.72) !important;
  box-shadow:
    0 16rpx 32rpx rgba(37,99,235,0.10),
    0 0 0 4rpx rgba(191,219,254,0.32),
    inset 0 1rpx 0 rgba(255,255,255,0.82) !important;
}

.radio-dot {
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(248,251,255,0.84));
  border-color: rgba(203,213,225,0.82);
  box-shadow:
    0 6rpx 14rpx rgba(15,23,42,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.radio-dot-checked {
  background: linear-gradient(135deg, #2563eb, #60a5fa);
  border-color: rgba(96,165,250,0.92);
  box-shadow:
    inset 0 0 0 7rpx rgba(255,255,255,0.92),
    0 0 0 7rpx rgba(37,99,235,0.14),
    0 8rpx 18rpx rgba(37,99,235,0.16);
}

.sign-file-preview,
.approval-sig-thumb,
.stamp-picker-thumb,
.sig-source-thumb,
.sig-source-thumb-placeholder,
.stamp-picker-placeholder {
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(239,246,255,0.80)) !important;
  border: 1rpx solid rgba(191,219,254,0.58) !important;
  box-shadow:
    0 6rpx 14rpx rgba(15,23,42,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.74);
}

.sig-source-divider-line {
  background: linear-gradient(90deg, transparent, rgba(147,197,253,0.58), transparent) !important;
}

.approval-warning {
  background: linear-gradient(135deg, rgba(255,247,237,0.96), rgba(254,215,170,0.82)) !important;
  border: 1rpx solid rgba(253,186,116,0.52);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.66);
}

.approval-textarea,
.sig-source-save-input {
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(246,249,255,0.88));
  border: 1rpx solid rgba(219,229,241,0.96);
  border-radius: 18rpx;
  box-shadow:
    0 8rpx 18rpx rgba(15,23,42,0.035),
    inset 0 1rpx 0 rgba(255,255,255,0.84);
}

.approval-file-btn-preview,
.approval-file-btn-sign,
.approval-file-btn-stamp,
.stamp-picker-select,
.sig-source-use-btn {
  border-radius: 999rpx;
  background: rgba(219,234,254,0.76);
  border: 1rpx solid rgba(147,197,253,0.64);
  color: #2563eb;
  box-shadow: 0 6rpx 14rpx rgba(37,99,235,0.06);
}

.approval-btn-approve {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%) !important;
  border-color: transparent !important;
  box-shadow:
    0 16rpx 32rpx rgba(37,99,235,0.20),
    inset 0 1rpx 0 rgba(255,255,255,0.20) !important;
}

/* Final form motion: focus the field itself, never the surrounding section shell. */
.section:active,
.card:active,
.detail-popup-form:active,
.approval-card:active {
  transform: none !important;
  filter: none !important;
}

@media (min-width: 520px) {
  .section {
    min-width: 0;
  }
}

@media (min-width: 900px) {
  .page {
    max-width: 1180px;
  }

  .section > .field-grid,
  .section > .info-grid,
  .section > .audit-info-grid,
  .section > .detail-info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .section .audit-file-list,
  .section .sign-file-list,
  .section .approval-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .placement-popup,
  .signature-popup-card {
    width: min(1040px, calc(100vw - 64px));
  }
}

.field-input:focus,
.field-textarea:focus,
.approval-textarea:focus,
.sig-source-save-input:focus {
  transform: none !important;
  border-color: rgba(96,165,250,0.86) !important;
  background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(239,246,255,0.90)) !important;
  box-shadow:
    0 10rpx 22rpx rgba(37,99,235,0.10),
    0 0 0 3rpx rgba(191,219,254,0.42),
    inset 0 1rpx 0 rgba(255,255,255,0.88) !important;
}

.step-action-link:active,
.flow-action-btn:active {
  transform: translate3d(0, 1rpx, 0) scale(0.984) !important;
  opacity: 0.94 !important;
  transition:
    transform 0.16s cubic-bezier(0.2, 0.78, 0.22, 1),
    opacity 0.16s ease,
    box-shadow 0.18s ease !important;
}

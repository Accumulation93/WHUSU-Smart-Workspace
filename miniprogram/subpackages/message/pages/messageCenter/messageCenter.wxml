<view class="page message-page">
  <workspace-hero class="workspace-hero-host" app-name="{{copy.appName}}" page-name="{{copy.pageName}}"></workspace-hero>

  <view class="message-tabs">
    <view class="message-tab {{activeTab === 'todos' ? 'message-tab-active' : ''}} ui-motion-chip" data-tab="todos" bindtap="switchTab" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">
      {{copy.todos}} <text wx:if="{{todoTotal}}">{{todoTotal}}</text>
    </view>
    <view class="message-tab {{activeTab === 'notifications' ? 'message-tab-active' : ''}} ui-motion-chip" data-tab="notifications" bindtap="switchTab" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">
      {{copy.notifications}} <text wx:if="{{unreadCount}}">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
    </view>
  </view>

  <view class="organization-picker" bindtap="openOrganizationPicker" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
    <view class="organization-filter ui-motion-card" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">
      <view class="organization-filter-label">{{copy.organizationScope}}</view>
      <view class="organization-filter-value">{{selectedOrganizationName}}</view>
      <ui-icon name="chevron-right" tone="muted" size="26" ariaLabel="{{copy.selectOrganization}}" />
    </view>
  </view>

  <view class="partial-notice" wx:if="{{partial}}">
    <ui-icon name="bell" tone="primary" size="28" ariaLabel="{{copy.loadingHint}}" />
    <text>{{copy.partialOrganizationLoading}}</text>
  </view>

  <view class="card message-card">
    <view class="message-card-head">
      <view class="section-title">{{activeTab === 'todos' ? copy.currentTodos : copy.allNotifications}}</view>
      <view class="message-actions" wx:if="{{activeTab === 'notifications' && notificationTotal}}">
        <view class="message-action ui-motion-chip" wx:if="{{unreadCount > 0}}" bindtap="markAllRead" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.markAllRead}}</view>
        <view class="message-action message-action-danger ui-motion-chip" bindtap="deleteAllNotifications" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.clearAll}}</view>
      </view>
    </view>
    <scroll-view class="message-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" bindscrolltolower="loadMore" lower-threshold="100">
      <view class="message-empty" wx:if="{{!loading && activeTab === 'todos' && !todos.length}}">{{copy.noTodos}}</view>
      <view class="message-empty" wx:if="{{!loading && activeTab === 'notifications' && !notifications.length}}">{{copy.noNotifications}}</view>

      <view wx:if="{{activeTab === 'todos'}}" class="message-list">
        <view class="message-row ui-motion-card" wx:for="{{todos}}" wx:key="id" data-id="{{item.id}}" bindtap="onTodoTap" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">
          <view class="message-icon"><ui-icon name="clock" tone="primary" sizeRole="message-leading" ariaLabel="{{copy.todos}}" /></view>
          <view class="message-copy">
            <view class="message-metadata">
              <view class="message-context-line">
                <text class="message-category">{{item.categoryLabel}}</text>
                <text class="identity-meta {{item.isCurrentContext ? 'identity-meta-current' : ''}}">{{item.workContextName}}</text>
              </view>
              <view class="organization-meta {{item.isCurrentOrganization ? 'organization-meta-current' : ''}}">
                <ui-icon name="home" tone="primary" sizeRole="message-meta" ariaLabel="{{copy.organization}}" />
                <text class="organization-meta-name">{{item.organizationName}}</text>
                <text class="organization-current" wx:if="{{item.isCurrentOrganization}}">{{copy.current}}</text>
              </view>
            </view>
            <view class="message-title">{{item.title}}</view>
            <view class="message-desc">{{item.description}}</view>
            <view class="message-time">{{item.createdAtText}}</view>
          </view>
          <ui-icon name="chevron-right" tone="muted" sizeRole="message-trailing" ariaLabel="{{copy.enter}}" />
        </view>
      </view>

      <view wx:if="{{activeTab === 'notifications'}}" class="message-list">
        <view class="message-row {{item.isRead ? 'message-row-read' : 'message-row-unread'}}" wx:for="{{notifications}}" wx:key="id">
          <view class="message-main ui-motion-card" data-id="{{item.id}}" bindtap="onNotificationTap" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">
            <view class="unread-dot" wx:if="{{!item.isRead}}"></view>
            <view class="message-icon"><ui-icon name="bell" tone="primary" sizeRole="message-leading" ariaLabel="{{copy.notifications}}" /></view>
            <view class="message-copy">
              <view class="message-metadata">
                <view class="message-context-line">
                  <text class="message-category">{{item.categoryLabel}}</text>
                  <text class="identity-meta {{item.isCurrentContext ? 'identity-meta-current' : ''}}">{{item.workContextName}}</text>
                </view>
                <view class="organization-meta {{item.isCurrentOrganization ? 'organization-meta-current' : ''}}">
                  <ui-icon name="home" tone="primary" sizeRole="message-meta" ariaLabel="{{copy.organization}}" />
                  <text class="organization-meta-name">{{item.organizationName}}</text>
                  <text class="organization-current" wx:if="{{item.isCurrentOrganization}}">{{copy.current}}</text>
                </view>
              </view>
              <view class="message-title">{{item.title}}</view>
              <view class="message-desc">{{item.description}}</view>
              <view class="message-time">{{item.createdAtText}}</view>
            </view>
          </view>
          <view class="message-delete ui-motion-chip" data-id="{{item.id}}" catchtap="deleteNotification" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160"><ui-icon name="trash" tone="danger" size="28" ariaLabel="{{copy.deleteNotification}}" /></view>
        </view>
      </view>
      <view class="message-loading" wx:if="{{loading || loadingMore}}">{{copy.loading}}</view>
    </scroll-view>
  </view>

  <viewport-portal wx:if="{{showSwitchDialog}}">
  <view class="message-switch-layer ui-overlay" wx:if="{{showSwitchDialog}}">
    <view class="message-switch-mask ui-overlay-blocker" bindtap="closeSwitchDialog" catchtouchmove="noop"></view>
    <view class="message-switch-dialog ui-dialog-shell ui-dialog-shell--compact">
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="ui-dialog-body ui-dialog-content ui-dialog-scroll--fill ui-dialog-stack-scroll">
        <view class="message-switch-badge">{{copy.crossOrganizationItem}}</view>
        <view class="message-switch-title">{{switchDialogTitle}}</view>
        <view class="message-switch-desc">{{copy.switchDescription}}</view>
        <view class="message-switch-org">{{switchOrganizationName}}</view>
      </scroll-view>
      <view class="message-switch-actions ui-dialog-footer">
        <button class="secondary-btn message-dialog-btn ui-motion-button" bindtap="closeSwitchDialog" disabled="{{switchingOrganization}}" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.cancel}}</button>
        <button class="primary-btn message-dialog-btn ui-motion-button" bindtap="confirmOrganizationSwitch" loading="{{switchingOrganization}}" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.switchAndView}}</button>
      </view>
    </view>
  </view>
  </viewport-portal>

  <viewport-portal wx:if="{{organizationPickerVisible}}">
  <view class="organization-picker-overlay ui-overlay" wx:if="{{organizationPickerVisible}}">
    <view class="organization-picker-mask ui-overlay-blocker" bindtap="closeOrganizationPicker" catchtouchmove="noop"></view>
    <view class="organization-picker-dialog hit-area ui-dialog-shell ui-dialog-shell--compact" catchtap="noop">
      <view class="organization-picker-header ui-dialog-header">
        <view class="organization-picker-title">{{copy.selectOrganizationScope}}</view>
        <text class="organization-picker-close ui-motion-chip" catchtap="closeOrganizationPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.close}}</text>
      </view>
      <scroll-view class="organization-picker-options ui-dialog-body ui-dialog-content ui-dialog-scroll--fill ui-dialog-stack-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{true}}" nested-scroll-enabled="{{true}}">
        <view class="organization-picker-option organization-picker-item {{pendingOrganizationIndex === index ? 'organization-picker-option-active' : ''}}" wx:for="{{organizationOptions}}" wx:key="id" data-index="{{index}}" catchtap="selectOrganizationOption">
          <text class="organization-picker-option-name">{{item.name}}</text>
          <ui-icon wx:if="{{pendingOrganizationIndex === index}}" name="check" tone="primary" size="26" ariaLabel="{{copy.selected}}" />
        </view>
        <view class="scroll-tail-space"></view>
      </scroll-view>
      <view class="organization-picker-actions ui-dialog-footer">
        <button class="secondary-btn message-dialog-btn ui-motion-button" bindtap="closeOrganizationPicker" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.cancel}}</button>
        <button class="primary-btn message-dialog-btn ui-motion-button" bindtap="confirmOrganizationPicker" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.confirm}}</button>
      </view>
    </view>
  </view>
  </viewport-portal>
</view>

.target-card {
  position: relative;
  margin-bottom: 18rpx;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(249, 251, 255, 0.82) 100%);
  border: 1rpx solid rgba(226, 237, 247, 0.96);
  box-shadow:
    0 12rpx 24rpx rgba(15, 23, 42, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  box-sizing: border-box;
}

.target-card:last-child {
  margin-bottom: 4rpx;
}

.target-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
  padding-right: 28rpx;
}

.target-name {
  min-width: 0;
  color: #0f172a;
  font-size: var(--ui-type-value);
  font-weight: 700;
  line-height: 1.4;
}

.target-tags {
  display: flex;
  min-width: 0;
  max-width: 100%;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10rpx;
}

.target-identity,
.target-status {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-meta);
  font-weight: 700;
}

.target-identity {
  max-width: 100%;
  box-sizing: border-box;
  overflow-wrap: anywhere;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.96) 0%, rgba(219, 234, 254, 0.88) 100%);
  color: #2563eb;
  border: 1rpx solid rgba(147, 197, 253, 0.74);
}

.target-meta {
  margin-top: 6rpx;
  color: #64748b;
  font-size: var(--ui-type-label);
  line-height: 1.62;
}

.target-name,
.target-meta {
  word-break: break-word;
}

@media (max-width: 360px) {
  .target-main {
    flex-direction: column;
    align-items: flex-start;
    padding-right: 0;
  }
}

/* 待审批操作沿用普通端的紧凑文字外观，两种宿主使用相同尺寸。 */
.pending-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-inline-gap, 10rpx);
  margin-bottom: var(--ui-list-gap, 14rpx);
}
.pending-toolbar > .section-title { flex: 1 1 auto; min-width: 0; margin-bottom: 0; }
.pending-toolbar-actions { display: flex; align-items: center; flex: 0 0 auto; gap: var(--ui-inline-gap, 10rpx); }
.pending-toolbar-time {
  display: block;
  min-width: 0;
  margin-bottom: var(--ui-list-gap, 14rpx);
  color: #94a3b8;
  font-size: var(--ui-type-caption);
  line-height: var(--ui-leading-control, 1.35);
}
.pending-toolbar .pending-toolbar-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  max-width: 100%;
  height: auto;
  min-height: 60rpx !important;
  margin: 0;
  padding: 10rpx 18rpx !important;
  border-radius: var(--ui-compact-radius, 18rpx) !important;
  border: 1rpx solid rgba(147,197,253,0.58);
  background: linear-gradient(135deg, rgba(239,246,255,0.92), rgba(219,234,254,0.72));
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.72);
  color: #2563eb;
  font-size: var(--ui-type-control);
  font-weight: 600;
  line-height: var(--ui-leading-control, 1.35);
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
}
.pending-toolbar-action::after { border: 0; }
@media (min-width: 520px) {
  .pending-toolbar .pending-toolbar-action { min-height: 34px !important; padding: 6px 12px !important; }
}
@media (min-width: 900px) {
  .pending-toolbar .pending-toolbar-action { min-height: 32px !important; padding: 5px 10px !important; }
}

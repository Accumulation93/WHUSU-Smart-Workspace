<view class="page {{leavingPortal ? 'page-leaving' : ''}}">
  <view class="login-layout">
    <view class="hero login-hero">
      <view class="hero-badge">{{copy.appName}}</view>
      <view class="hero-title">{{copy.wechatLogin}}</view>
      <view class="hero-subtitle">{{copy.loginSubtitle}}</view>
    </view>

    <view class="login-main">
      <view class="login-notice" wx:if="{{authNotice}}">
        <ui-icon name="shield" tone="primary" size="26" ariaLabel="{{copy.loginHint}}" />
        <text>{{authNotice}}</text>
      </view>
      <view class="card login-card">
        <view class="section-title">{{copy.loginTitle}}</view>
        <view class="card-desc">{{copy.useOwnWechat}}</view>
        <button class="primary-btn ui-motion-button" loading="{{loading}}" bindtap="onLogin" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.wechatLogin}}</button>
        <view class="login-secondary-link ui-motion-chip" bindtap="openPasswordLogin" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.passwordLogin}}</view>
      </view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">{{copy.appName}}</view>
    <view class="footer-org">{{copy.organizationName}}</view>
  </view>

  <view class="{{sheetClass}} ui-sheet-overlay" wx:if="{{stage !== 'login'}}">
    <view class="sheet-mask ui-overlay-blocker" bindtap="closeSheet" catchtouchmove="noop"></view>
    <view class="sheet-panel ui-dialog-shell ui-dialog-shell--compact">
      <view class="sheet-header">
        <view class="sheet-title">{{stage === 'password' ? copy.passwordLogin : (stage === 'verify' ? copy.titleVerify : (stage === 'recoveryVerify' ? copy.titleRecoveryVerify : (stage === 'recoveryRotated' ? copy.titleRecoveryRotated : (stage === 'recoveryPending' ? copy.titleRecoveryPending : (stage === 'recovery' ? copy.titleRecovery : copy.titleClaim)))))}}</view>
        <view class="sheet-close ui-motion-chip" bindtap="closeSheet" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.closeWithIcon}}</view>
      </view>

      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="sheet-body ui-dialog-body ui-dialog-content ui-dialog-scroll--fill ui-dialog-stack-scroll">
        <view wx:if="{{stage === 'claim' || stage === 'recovery'}}">
        <view class="sheet-note">{{stage === 'recovery' ? copy.recoveryStartNote : copy.claimStartNote}}</view>

        <view class="field">
          <view class="field-label">{{copy.organization}}</view>
          <picker range="{{organizations}}" range-key="name" value="{{organizationIndex}}" bindchange="onOrganizationChange">
            <view class="field-picker">{{organizationName || copy.chooseOrganization}}<text class="field-picker-arrow">›</text></view>
          </picker>
        </view>

        <view class="field">
          <view class="field-label">{{copy.name}}</view>
          <input class="field-input" placeholder="{{copy.namePlaceholder}}" bindinput="onName" value="{{name}}" />
        </view>

        <view class="field">
          <view class="field-label">{{copy.studentId}}</view>
          <input class="field-input" placeholder="{{copy.studentIdPlaceholder}}" bindinput="onStudentId" value="{{studentId}}" />
        </view>

        <button wx:if="{{stage === 'claim'}}" class="primary-btn ui-motion-button" loading="{{loading}}" disabled="{{!claimAvailable}}" bindtap="submitClaim" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{claimAvailable ? copy.continueAction : copy.claimUnavailable}}</button>
        <button wx:else class="primary-btn ui-motion-button" loading="{{loading}}" bindtap="startRecovery" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.submitRecovery}}</button>

        <view class="sheet-link ui-motion-chip" wx:if="{{stage === 'claim'}}" bindtap="switchToRecovery" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.changeWechat}}</view>
        <view class="sheet-link ui-motion-chip" wx:else bindtap="switchToClaim" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.backToClaim}}</view>
      </view>

        <view wx:elif="{{stage === 'password'}}">
          <view class="sheet-note">{{copy.passwordNote}}</view>
          <view class="field"><view class="field-label">{{copy.studentId}}</view><input class="field-input" placeholder="{{copy.studentIdPlaceholder}}" bindinput="onPasswordStudentId" value="{{passwordStudentId}}" /></view>
          <view class="field"><view class="field-label">{{copy.passphrase}}</view><input class="field-input" password="{{true}}" placeholder="{{copy.passphrasePlaceholder}}" bindinput="onPasswordInput" value="{{password}}" /></view>
          <button class="primary-btn ui-motion-button" loading="{{loading}}" bindtap="onPasswordLogin" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.loginAction}}</button>
          <view class="sheet-link ui-motion-chip" bindtap="closeSheet" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.backToWechat}}</view>
        </view>
        <view wx:elif="{{stage === 'verify'}}">
        <view class="sheet-note">{{copy.verificationNote}}</view>
        <view class="field">
          <view class="field-label">{{copy.verificationCode}}</view>
          <input class="field-input verification-input" maxlength="12" placeholder="{{copy.verificationPlaceholder}}" bindinput="onVerificationCode" value="{{verificationCode}}" />
        </view>
        <button class="primary-btn ui-motion-button" loading="{{loading}}" bindtap="verifyClaim" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.finishClaim}}</button>
        <view class="sheet-link ui-motion-chip" bindtap="switchToClaim" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.backToProfile}}</view>
      </view>

        <view wx:elif="{{stage === 'recoveryVerify'}}">
        <view class="sheet-note">{{copy.recoveryNote}}</view>
        <view class="field">
          <view class="field-label">{{copy.recoveryMethod}}</view>
          <picker range="{{recoveryMethods}}" value="{{recoveryMethodIndex}}" bindchange="onRecoveryMethodChange">
            <view class="field-picker">{{recoveryMethodLabel}}<text class="field-picker-arrow">›</text></view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">{{recoveryMethodLabel}}</view>
          <input class="field-input" password="{{recoveryMethod === 'passphrase'}}" placeholder="{{copy.recoveryPlaceholder}}" bindinput="onRecoveryCredential" value="{{recoveryCredential}}" />
        </view>
        <button class="primary-btn ui-motion-button" loading="{{loading}}" bindtap="completeRecovery" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.confirmWechatChange}}</button>
        <view class="sheet-link ui-motion-chip" bindtap="closeSheet" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.waitForReview}}</view>
      </view>
        <view wx:elif="{{stage === 'recoveryRotated'}}">
        <view class="sheet-note">{{copy.rotatedRecoveryNote}}</view>
        <view class="recovery-code-box">{{rotatedRecoveryCode}}</view>
        <view class="recovery-actions">
          <button class="secondary-btn ui-motion-button" bindtap="copyRotatedRecoveryCode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.copyRecoveryCode}}</button>
          <button class="primary-btn ui-motion-button" bindtap="finishRecoveredLogin" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.finish}}</button>
        </view>
      </view>
        <view wx:else>
          <view class="sheet-note">{{copy.recoveryPendingNote}}</view>
          <button class="secondary-btn ui-motion-button" bindtap="closeSheet" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.close}}</button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

<view class="section-control-card section-control-card--stacked hr-directory-control-card" wx:if="{{visible}}">
  <view class="list-card-header hr-member-list-header">
    <view class="list-title">{{localeCopy.copy_86937eac2b}}</view>
    <button class="secondary-btn hr-profile-export-btn ui-motion-button" wx:if="{{canBrowseHrInfo}}" disabled="{{loadingMap.exportHrProfiles}}" bindtap="emitExport" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"><app-loading compact="{{true}}" active="{{loadingMap.exportHrProfiles}}" />{{localeCopy.copy_b26bdbb604}}</button>
  </view>
  <view class="hr-directory-query-grid">
    <view class="field field-half">
      <view class="field-label">{{localeCopy.hrDirectoryKeyword}}</view>
      <view class="ui-list-filter-search"><ui-icon name="search" tone="muted" sizeRole="row-leading" /><input class="ui-list-filter-input" bindinput="emitKeywordInput" value="{{keyword}}" placeholder="{{localeCopy.hrDirectoryKeywordPlaceholder}}" /></view>
    </view>
    <button class="secondary-btn compact-action hr-advanced-filter-toggle ui-motion-button" bindtap="emitToggleFilters" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{advancedVisible ? localeCopy.hrCollapseFilters : localeCopy.hrAdvancedFilters}}</button>
  </view>
  <view class="ui-list-filter ui-list-filter-stack">
    <list-filter-row label="{{localeCopy.hrDirectorySearchField}}" range="{{filterOptions.searchFields}}" range-key="label" value="{{searchFieldIndex}}" bindchange="emitSearchFieldChange" />
    <list-filter-row label="{{localeCopy.hrDirectorySort}}" range="{{filterOptions.sortModes}}" range-key="label" value="{{sortIndex}}" bindchange="emitSortChange" />
  </view>

  <view class="ui-list-filter ui-list-filter-stack" wx:if="{{advancedVisible}}">
    <list-filter-row multiple="{{true}}" label="{{localeCopy.hrMembershipStatus}}" range="{{filterOptions.membershipStatuses}}" range-key="label" data-field="membershipStatuses" bindchange="emitFilterGroupChange" />
    <list-filter-row multiple="{{true}}" label="{{localeCopy.hrPositionStatus}}" range="{{filterOptions.positionStates}}" range-key="label" data-field="positionStates" bindchange="emitFilterGroupChange" />
    <list-filter-row multiple="{{true}}" label="{{localeCopy.hrAssignmentNature}}" range="{{filterOptions.assignmentNatures}}" range-key="label" data-field="assignmentNatures" bindchange="emitFilterGroupChange" />
    <list-filter-row multiple="{{true}}" label="{{localeCopy.hrDepartment}}" range="{{filterOptions.departments}}" range-key="label" data-field="departments" bindchange="emitFilterGroupChange" />
    <list-filter-row multiple="{{true}}" label="{{localeCopy.hrIdentityCategory}}" range="{{filterOptions.identities}}" range-key="label" data-field="identities" bindchange="emitFilterGroupChange" />
    <list-filter-row multiple="{{true}}" label="{{localeCopy.hrWorkGroup}}" range="{{filterOptions.workGroups}}" range-key="label" data-field="workGroups" bindchange="emitFilterGroupChange" />
    <list-filter-row multiple="{{true}}" label="{{localeCopy.hrProfileStatus}}" range="{{filterOptions.profileStatuses}}" range-key="label" data-field="profileStatuses" bindchange="emitFilterGroupChange" />
    <list-filter-row multiple="{{true}}" label="{{localeCopy.hrProfileCompleteness}}" range="{{filterOptions.completenessStates}}" range-key="label" data-field="completenessStates" bindchange="emitFilterGroupChange" />
    <list-filter-row multiple="{{true}}" label="{{localeCopy.hrAccountStatus}}" range="{{filterOptions.accountStates}}" range-key="label" data-field="accountStates" bindchange="emitFilterGroupChange" />
    <list-filter-row multiple="{{true}}" label="{{localeCopy.hrBindingStatus}}" range="{{filterOptions.bindingStates}}" range-key="label" data-field="bindingStates" bindchange="emitFilterGroupChange" />
  </view>
  <view class="hr-active-filter-chips" wx:if="{{activeFilterChips.length}}"><view class="ui-list-filter-chip is-active ui-list-filter-opener" wx:for="{{activeFilterChips}}" wx:key="id"><text>{{item.label}}</text><text class="hr-active-filter-remove ui-motion-chip" data-category="{{item.category}}" data-value="{{item.value}}" catchtap="emitClearChip" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">×</text></view></view>
  <view class="hr-member-tools">
    <view class="field hr-member-tools-validity" wx:if="{{canVerifyIdentity}}">
      <view class="field-label">{{localeCopy.verificationCodeValidity}}</view>
      <picker range="{{codeValidityOptions}}" value="{{codeValidityIndex}}" bindchange="emitCodeValidityChange">
        <view class="picker-value">{{codeValidityOptions[codeValidityIndex]}}</view>
      </picker>
    </view>
    <view class="hr-member-tools-summary" wx:if="{{canVerifyIdentity || canGlobalAccountManage}}">{{localeCopy.copy_801a88e4a1}} {{selectionCount}} {{localeCopy.copy_2370e6144f}}</view>
    <view class="hr-member-tools-actions">
      <button class="secondary-btn compact-action ui-motion-button" bindtap="emitReset" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_bed15e0757}}</button>
      <button class="secondary-btn compact-action ui-motion-button" wx:if="{{canVerifyIdentity || canGlobalAccountManage}}" disabled="{{governanceUnavailable || authActionLoadingKey || !canSelectAll}}" bindtap="emitSelectAll" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{localeCopy.copy_00c8a8f256}}</button>
      <button class="secondary-btn compact-action ui-motion-button" wx:if="{{canVerifyIdentity || canGlobalAccountManage}}" disabled="{{governanceUnavailable || authActionLoadingKey || !canInvertSelection}}" bindtap="emitInvertSelection" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{localeCopy.copy_ba3a4b8440}}</button>
      <button class="secondary-btn compact-action ui-motion-button" wx:if="{{canVerifyIdentity || canGlobalAccountManage}}" disabled="{{authActionLoadingKey || !canClearSelection}}" bindtap="emitClearSelection" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{localeCopy.copy_6888d59833}}</button>
      <button class="primary-btn compact-action ui-motion-button" wx:if="{{canVerifyIdentity}}" disabled="{{governanceUnavailable || authActionLoadingKey || !canIssueVerification}}"  bindtap="emitIssueVerification" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160"><app-loading compact="{{true}}" active="{{authActionLoadingKey === 'member-verify-batch'}}" />{{localeCopy.copy_6b7249dab1}}</button>
      <button class="secondary-btn compact-action ui-motion-button" wx:if="{{canVerifyIdentity}}" disabled="{{governanceUnavailable || authActionLoadingKey || !canRevokeVerification}}"  bindtap="emitRevokeVerification" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160"><app-loading compact="{{true}}" active="{{authActionLoadingKey === 'member-verify-revoke-batch'}}" />{{localeCopy.copy_265032194a}}</button>
      <button class="secondary-btn compact-action ui-motion-button" wx:if="{{canGlobalAccountManage}}" disabled="{{governanceUnavailable || authActionLoadingKey || !canIssueRecovery}}"  bindtap="emitIssueRecovery" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160"><app-loading compact="{{true}}" active="{{authActionLoadingKey === 'member-recovery-batch'}}" />{{localeCopy.copy_bbb93316d5}}</button>
      <button class="secondary-btn compact-action ui-motion-button" wx:if="{{canGlobalAccountManage}}" disabled="{{governanceUnavailable || authActionLoadingKey || !canRevokeRecovery}}"  bindtap="emitRevokeRecovery" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160"><app-loading compact="{{true}}" active="{{authActionLoadingKey === 'member-recovery-revoke'}}" />{{localeCopy.copy_1cda406196}}</button>
    </view>
    <view class="field-hint hr-governance-warning" wx:if="{{governanceUnavailable}}">{{localeCopy.copy_f2dd354103}}</view>
  </view>
</view>

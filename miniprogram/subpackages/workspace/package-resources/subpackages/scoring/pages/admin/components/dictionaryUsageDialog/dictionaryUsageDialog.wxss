.dictionary-usage-description {
  color: #475569;
  font-size: var(--ui-dialog-body-size);
  line-height: 1.65;
}

.dictionary-usage-target {
  margin-top: var(--ui-dialog-section-gap, 20rpx);
  padding: var(--ui-dialog-section-padding, 22rpx);
  border: 1rpx solid rgba(191, 219, 254, 0.72);
  border-radius: var(--ui-dialog-section-radius, 22rpx);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.94), rgba(255, 255, 255, 0.86));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.dictionary-usage-target-label {
  color: #64748b;
  font-size: var(--ui-dialog-meta-size);
  font-weight: 700;
  line-height: 1.45;
}

.dictionary-usage-target-name {
  margin-top: var(--ui-label-gap, 8rpx);
  color: #0f172a;
  font-size: var(--ui-dialog-body-size);
  font-weight: 800;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.dictionary-usage-list {
  display: grid;
  gap: var(--ui-list-gap, 14rpx);
  margin-top: var(--ui-dialog-section-gap, 20rpx);
}

.dictionary-usage-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-inline-gap, 14rpx);
  padding: var(--ui-list-padding-y, 18rpx) var(--ui-list-padding-x, 20rpx);
  border: 1rpx solid rgba(226, 237, 247, 0.96);
  border-radius: var(--ui-list-radius, 22rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(248, 251, 255, 0.84));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
}

.dictionary-usage-category {
  flex: 1;
  min-width: 0;
  color: #1e293b;
  font-size: var(--ui-dialog-body-size);
  font-weight: 700;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.dictionary-usage-count {
  flex: none;
}

.dictionary-usage-close-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
}

    <view class="section-stack identity-relations" wx:if="{{activeTab === 'identities'}}">
      <view wx:if="{{!loadingMap.identities && dictionaryLoadState.identities.status !== 'error' && !identityRelationEnabled}}" class="section-control-card"><view class="hint-text">{{relationCopy.configurationNotEnabled}}</view><button class="secondary-btn ui-motion-button" catchtap="retryIdentityList" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.dictionaryRetry}}</button></view>
      <view class="section-control-card">

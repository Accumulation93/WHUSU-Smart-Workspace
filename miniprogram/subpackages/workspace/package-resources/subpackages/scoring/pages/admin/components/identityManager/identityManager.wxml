        <view class="field-label">{{relationCopy.nature}}</view>
        <view class="selection-options-grid" wx:if="{{identityRelationEnabled}}">
          <view class="selection-option-card {{!identityNatureFilter ? 'selection-option-card-selected' : ''}}" aria-checked="{{!identityNatureFilter}}" catchtap="onIdentityNatureFilter">{{relationCopy.allNatures}}</view>
          <view class="selection-option-card {{identityNatureFilter === 'pending' ? 'selection-option-card-selected' : ''}}" aria-checked="{{identityNatureFilter === 'pending'}}" data-id="pending" catchtap="onIdentityNatureFilter">{{relationCopy.pendingFilter}}</view>

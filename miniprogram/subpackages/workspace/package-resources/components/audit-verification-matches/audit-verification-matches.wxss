.verification-match-section {
  margin-top: var(--ui-field-gap, 16rpx);
  margin-bottom: var(--ui-card-gap, 24rpx);
}

.verification-match-heading {
  margin-bottom: var(--ui-field-gap, 16rpx);
}

.verification-match-card {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: var(--ui-inline-gap, 14rpx);
  margin-bottom: var(--ui-list-gap, 14rpx);
  padding: var(--ui-list-padding-y, 22rpx) var(--ui-list-padding-x, 20rpx);
  border-radius: var(--ui-list-radius, 20rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(249, 251, 255, 0.82));
  border: 1rpx solid rgba(226, 237, 247, 0.96);
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.04), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  box-sizing: border-box;
}

.verification-match-card:last-child { margin-bottom: 0; }

.verification-match-card--active {
  border-color: rgba(96, 165, 250, 0.72);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.96), rgba(255, 255, 255, 0.84));
  box-shadow: 0 14rpx 28rpx rgba(37, 99, 235, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.verification-match-main {
  flex: 1 1 360rpx;
  min-width: 0;
}

.verification-match-title-row {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: var(--ui-inline-gap, 14rpx);
}

.verification-match-title {
  flex: 1 1 260rpx;
  min-width: 0;
  color: #0f172a;
  font-size: var(--ui-type-emphasis);
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.verification-match-status,
.verification-match-file,
.verification-match-action {
  flex: none;
  padding: var(--ui-compact-padding-y, 5rpx) var(--ui-compact-padding-x, 14rpx);
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.35;
  border: 1rpx solid rgba(147, 197, 253, 0.54);
  box-sizing: border-box;
}

.verification-match-status--success { color: #15803d; background: rgba(209, 250, 229, 0.78); border-color: rgba(110, 231, 183, 0.58); }
.verification-match-status--danger { color: #dc2626; background: rgba(254, 226, 226, 0.78); border-color: rgba(252, 165, 165, 0.56); }
.verification-match-status--warning { color: #c2410c; background: rgba(255, 237, 213, 0.78); border-color: rgba(253, 186, 116, 0.58); }
.verification-match-status--muted { color: #64748b; background: rgba(241, 245, 249, 0.82); border-color: rgba(203, 213, 225, 0.64); }

.verification-match-files {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--ui-inline-gap, 14rpx);
  margin-top: var(--ui-label-gap, 8rpx);
}

.verification-match-files-label { margin-top: 0; }

.verification-match-file {
  color: #2563eb;
  background: rgba(219, 234, 254, 0.76);
}

.verification-match-action {
  align-self: center;
}

.verification-match-action--current {
  color: #15803d;
  background: rgba(209, 250, 229, 0.78);
  border-color: rgba(110, 231, 183, 0.58);
}

.verification-match-action--interactive {
  color: #2563eb;
  background: rgba(219, 234, 254, 0.76);
}

.verification-match-action--pressed {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
}

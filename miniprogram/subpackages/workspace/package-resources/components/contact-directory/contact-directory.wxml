<view class="directory-stack">
  <view wx:if="{{!detailKey && !draft}}" class="directory-card directory-stack">
    <view class="directory-heading">{{admin ? copy.rules : copy.title}}</view>
    <app-loading wx:if="{{loading || busy}}" text="{{busy ? copy.saving : (admin ? copy.loadingRules : copy.loading)}}" />
    <view wx:if="{{notice}}" class="directory-note">{{notice}}</view>
    <button wx:if="{{loadFailed}}" class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" disabled="{{busy}}" bindtap="load">{{copy.retry}}</button>
    <view wx:if="{{!admin}}" class="ui-list-filter ui-list-filter-stack">
      <view class="ui-list-filter-search">
        <ui-icon name="search" tone="muted" sizeRole="context-leading" />
        <input class="ui-list-filter-input" value="{{query}}" placeholder="{{copy.search}}" bindinput="search" />
      </view>
      <view wx:for="{{tagGroups}}" wx:for-item="category" wx:key="key" class="ui-list-filter-row" data-category="{{category.key}}">
        <view class="ui-list-filter-label">{{category.label}}</view>
        <scroll-view class="ui-list-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="ui-list-filter-track">
            <view class="ui-list-filter-chip {{category.selectedCount ? '' : 'is-active'}} ui-motion-chip" role="button" aria-pressed="{{!category.selectedCount}}" data-key="{{category.key}}" bindtap="clearTagGroup" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{allFilterOptions}}</view>
            <view wx:for="{{category.options}}" wx:for-item="option" wx:key="key" class="ui-list-filter-chip {{option.selected ? 'is-active' : ''}} ui-motion-chip" role="button" aria-pressed="{{option.selected}}" data-key="{{option.key}}" bindtap="toggleTag" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{option.label}}</view>
          </view>
        </scroll-view>
      </view>
      <view wx:if="{{tagsSelected}}" class="ui-list-filter-chip ui-list-filter-clear ui-motion-chip" role="button" bindtap="clearTags" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.clearTagFilters}}</view>
    </view>
    <block wx:if="{{admin}}">
      <button wx:if="{{canCreateRule}}" class="primary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" disabled="{{loading || busy || loadFailed}}" bindtap="edit">{{copy.add}}</button>
      <button wx:if="{{hasDeletableRules}}" class="secondary-btn directory-small-action ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" disabled="{{loading || busy || loadFailed}}" bindtap="toggleBatch">{{batchMode ? copy.finishSelection : copy.manageSelection}}</button>
      <view wx:if="{{hasDeletableRules && batchMode}}" class="directory-note">{{selectedText}}</view>
      <view wx:if="{{hasDeletableRules && batchMode}}" class="card-actions directory-actions directory-small-actions">
        <button class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" disabled="{{loading || busy || loadFailed}}" bindtap="selectAll">{{copy.selectAll}}</button>
        <button class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" disabled="{{loading || busy || loadFailed}}" bindtap="clearSelection">{{copy.clearSelection}}</button>
        <button class="danger-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" disabled="{{loading || busy || loadFailed || !selected.length}}" bindtap="deleteSelected">{{copy.deleteSelected}}</button>
      </view>
      <view wx:for="{{rules}}" wx:key="id" class="directory-rule">
        <view class="{{batchMode && item.canDelete ? 'selection-option-card' : 'directory-rule-summary'}} {{item.selected && batchMode && item.canDelete ? 'selection-option-card-selected' : ''}}" data-id="{{item.id}}" aria-checked="{{item.selected && batchMode && item.canDelete}}" catchtap="toggleRule" hover-class="{{batchMode && item.canDelete ? 'ui-press-card' : 'none'}}" hover-start-time="0" hover-stay-time="160">
          <view class="directory-value">{{item.name}}</view><view class="directory-note">{{item.enabled ? copy.enabled : copy.disabled}}</view>
          <view wx:for="{{item.summary}}" wx:for-item="section" wx:key="key" class="directory-summary-section"><view class="directory-label">{{section.title}}</view><view wx:for="{{section.groups}}" wx:for-item="group" wx:key="key"><view wx:for="{{group.lines}}" wx:for-item="line" wx:key="*this" class="directory-note">{{line}}</view><view wx:if="{{item.expanded && group.hint}}" class="directory-note">{{group.hint}}</view></view></view>
        </view>
        <view class="card-actions directory-actions directory-small-actions">
          <button class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" data-id="{{item.id}}" bindtap="toggleRuleDetails">{{item.expanded ? copy.collapse : copy.expand}}</button>
          <button wx:if="{{item.canUpdate}}" class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" disabled="{{loading || busy || loadFailed}}" data-id="{{item.id}}" bindtap="edit">{{copy.edit}}</button>
          <button wx:if="{{canCreateRule}}" class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" disabled="{{loading || busy || loadFailed}}" data-id="{{item.id}}" data-copy="{{true}}" bindtap="edit">{{copy.copy}}</button>
          <button wx:if="{{item.canUpdate}}" class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" disabled="{{loading || busy || loadFailed}}" data-id="{{item.id}}" bindtap="toggleEnabled">{{item.enabled ? copy.disable : copy.enable}}</button>
        </view>
      </view>
      <view wx:if="{{!loading && !loadFailed && !rules.length}}" class="directory-note">{{copy.noRules}}</view>
    </block>
    <view wx:if="{{!admin && !loading && !loadFailed && !hasContacts}}" class="directory-note">{{tagsSelected ? copy.tagNoResults : (query ? copy.noResults : copy.empty)}}</view>
  </view>
  <view wx:if="{{deleteTargets}}" id="directory-delete" class="directory-card directory-stack">
    <view class="directory-heading">{{deleteText}}</view>
    <view wx:for="{{deleteTargets}}" wx:key="id">{{item.name}}</view>
    <view class="card-actions directory-actions"><button class="secondary-btn ui-motion-button" disabled="{{busy}}" bindtap="cancelDelete" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.cancel}}</button><button class="danger-btn ui-motion-button" disabled="{{busy}}" bindtap="confirmDelete" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.remove}}</button></view>
  </view>
  <view wx:if="{{admin && draft && !deleteTargets}}" id="directory-editor" class="directory-card directory-stack">
    <view id="directory-rule-name" class="directory-stack">
      <view class="directory-label">{{copy.name}}</view><input class="field-input" value="{{draft.name}}" placeholder="{{copy.namePlaceholder}}" disabled="{{busy}}" bindinput="nameInput" />
      <view wx:if="{{notice && validationAnchor === 'directory-rule-name'}}" class="directory-save-notice" aria-role="alert">{{notice}}</view>
    </view>
    <view wx:for="{{sections}}" wx:for-item="section" wx:key="key" class="directory-section directory-stack">
      <view class="directory-heading">{{section.title}}</view>
      <block wx:if="{{activeSection !== section.key}}"><view wx:for="{{section.clauses}}" wx:for-item="clause" wx:key="index"><view wx:for="{{clause.lines}}" wx:for-item="line" wx:key="*this" class="directory-note">{{line}}</view></view><view class="card-actions directory-small-actions"><button class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" data-section="{{section.key}}" bindtap="editSection">{{section.key === 'audience' ? copy.editAudience : copy.editTargets}}</button></view></block>
      <block wx:else><view class="directory-note">{{section.help}}</view>
      <view wx:for="{{section.clauses}}" wx:for-item="clause" wx:key="index" id="directory-clause-{{section.key}}-{{clause.index}}" class="directory-clause directory-stack">
        <view class="directory-label">{{clause.title}}</view>
        <view wx:if="{{notice && validationAnchor === 'directory-clause-' + section.key + '-' + clause.index}}" class="directory-save-notice" aria-role="alert">{{notice}}</view>
        <view wx:if="{{!clause.expanded}}"><view wx:for="{{clause.lines}}" wx:for-item="line" wx:key="*this" class="directory-note">{{line}}</view></view>
        <view class="card-actions directory-small-actions"><button wx:if="{{!clause.expanded}}" class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" disabled="{{busy}}" data-section="{{section.key}}" data-index="{{clause.index}}" bindtap="editClause">{{copy.editGroup}}</button><button class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" disabled="{{busy || section.clauses.length === 1}}" data-section="{{section.key}}" data-index="{{clause.index}}" bindtap="removeClause">{{section.removeLabel}}</button></view>
        <block wx:if="{{clause.expanded}}"><view class="directory-note">{{section.typeLabel}}</view>
        <picker range="{{clause.labels}}" value="{{clause.typeIndex}}" data-section="{{section.key}}" data-index="{{clause.index}}" disabled="{{busy}}" bindchange="typeChange"><view class="field-input">{{clause.labels[clause.typeIndex]}}</view></picker>
        <block wx:if="{{clause.type === 'people'}}">
          <view class="directory-note">{{clause.selectedText}}</view><view>{{clause.names}}</view>
          <button class="secondary-btn directory-small-action ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" disabled="{{busy}}" data-section="{{section.key}}" data-index="{{clause.index}}" bindtap="openPeople">{{section.chooseLabel}}</button>
        </block>
        <block wx:if="{{clause.type === 'scope'}}">
          <view class="directory-note">{{copy.scopeOptionalHelp}}</view><view wx:if="{{section.key === 'targets'}}" class="directory-note">{{copy.sameScopeHelp}}</view>
          <view class="directory-stack">
            <view class="field-label">{{relations.nature}}</view>
            <view wx:if="{{section.key === 'targets'}}" class="directory-switch"><text>{{relations.directorySameNature}}</text><switch color="#2563eb" checked="{{clause.sameNature}}" disabled="{{busy || loading}}" data-section="{{section.key}}" data-index="{{clause.index}}" data-key="natureIds" data-same="sameNature" bindchange="sameChange" /></view>
            <view class="directory-options">
              <view class="selection-option-card {{clause.unrestrictedNature ? 'selection-option-card-selected' : ''}}" data-section="{{section.key}}" data-index="{{clause.index}}" aria-checked="{{clause.unrestrictedNature}}" catchtap="clearNature" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">{{copy.any}}</view>
              <view wx:for="{{clause.natures}}" wx:for-item="nature" wx:key="id" class="selection-option-card {{nature.selected ? 'selection-option-card-selected' : ''}}" data-section="{{section.key}}" data-index="{{clause.index}}" data-key="natureIds" data-id="{{nature.id}}" aria-checked="{{nature.selected}}" catchtap="toggleChoice" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">{{nature.name}}</view>
            </view>
          </view>
          <view wx:for="{{clause.dimensions}}" wx:for-item="dimension" wx:key="key" class="directory-stack">
            <view class="directory-filter-head" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" data-filter="{{dimension.filterKey}}" bindtap="toggleFilter" aria-expanded="{{dimension.expanded}}"><view><text class="directory-label">{{dimension.label}}</text><view class="directory-note">{{dimension.summary}}</view></view><text class="directory-note">{{dimension.expanded ? copy.collapse : copy.expand}}</text></view>
            <view wx:if="{{dimension.expanded && section.key === 'targets'}}" class="directory-switch"><text>{{dimension.sameLabel}}</text><switch color="#2563eb" checked="{{dimension.isSame}}" disabled="{{busy}}" data-section="{{section.key}}" data-index="{{clause.index}}" data-same="{{dimension.same}}" data-key="{{dimension.key}}" bindchange="sameChange" /></view>
            <view wx:if="{{dimension.expanded && !dimension.isSame}}" class="directory-options">
              <view wx:for="{{dimension.choices}}" wx:for-item="option" wx:key="id" class="selection-option-card {{option.selected ? 'selection-option-card-selected' : ''}}" data-section="{{section.key}}" data-index="{{clause.index}}" data-key="{{dimension.key}}" data-id="{{option.id}}" aria-checked="{{option.selected}}" catchtap="toggleChoice" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">{{option.name}}</view>
            </view>
          </view>
        </block>
        <view class="directory-note">{{clause.help}}</view>
        <view class="card-actions directory-small-actions"><button class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" bindtap="finishClause">{{copy.finishGroup}}</button></view></block>
      </view>
      <view class="directory-add-options"><button class="secondary-btn directory-small-action ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" disabled="{{busy}}" data-section="{{section.key}}" data-type="people" bindtap="addClause">{{section.key === 'audience' ? copy.addAudiencePeople : copy.addTargetPeople}}</button><button class="secondary-btn directory-small-action ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" disabled="{{busy}}" data-section="{{section.key}}" data-type="scope" bindtap="addClause">{{section.key === 'audience' ? copy.addAudienceScope : copy.addTargetScope}}</button><button wx:if="{{section.key === 'targets'}}" class="secondary-btn directory-small-action ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" disabled="{{busy}}" data-section="targets" data-type="self" bindtap="addClause">{{copy.addTargetSelf}}</button></view>
      <view class="card-actions directory-small-actions"><button class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" bindtap="finishSection">{{copy.finishSection}}</button></view></block>
    </view>
    <view class="directory-section directory-stack"><view class="directory-heading">{{copy.columns}}</view><view class="directory-note">{{fieldsSummary}}</view>
    <view wx:if="{{activeSection !== 'fields'}}" class="card-actions directory-small-actions"><button class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" bindtap="toggleFields">{{copy.editColumns}}</button></view><view class="directory-note">{{copy.baseColumns}}</view>
    <block wx:if="{{activeSection === 'fields'}}">
    <view wx:if="{{!fields.length}}" class="directory-note">{{copy.noFields}}</view>
    <view class="directory-options"><view wx:for="{{fields}}" wx:key="id" class="selection-option-card {{item.selected ? 'selection-option-card-selected' : ''}}" data-id="{{item.id}}" aria-checked="{{item.selected}}" catchtap="toggleChoice" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">{{item.label}}</view></view>
    <view class="directory-note">{{copy.columnsHelp}}</view><view class="card-actions directory-small-actions"><button class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" bindtap="toggleFields">{{copy.finishSection}}</button></view></block></view>
    <view class="directory-switch"><text>{{copy.enable}}</text><switch color="#2563eb" checked="{{draft.enabled}}" disabled="{{busy}}" bindchange="enabledChange" /></view><view class="directory-note">{{copy.ruleEffectHelp}}</view>
    <app-loading wx:if="{{busy}}" text="{{copy.saving}}" />
    <view wx:if="{{notice}}" class="directory-save-notice" aria-role="alert">{{notice}}</view>
    <view class="card-actions directory-actions"><button class="secondary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" disabled="{{busy}}" bindtap="cancel">{{copy.cancel}}</button><button class="primary-btn ui-motion-button" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" disabled="{{busy || loading || loadFailed}}" bindtap="save">{{copy.save}}</button></view>
  </view>
  <block wx:if="{{!admin && !detailKey}}">
    <view wx:for="{{groups}}" wx:for-item="group" wx:key="key" class="directory-stack">
      <view class="directory-group-head"><text class="directory-department">{{group.name}}</text></view>
      <view class="directory-person-grid">
        <view wx:for="{{group.items}}" wx:key="key" id="contact-{{item.key}}" class="target-card directory-person" data-key="{{item.key}}" role="button" bindtap="openContact" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">
          <view class="target-main">
            <view class="target-name">{{item.name}}</view>
            <view wx:if="{{item.identityCategoryName}}" class="target-tags">
              <view class="target-identity">{{item.identityCategoryName}}</view>
            </view>
          </view>
          <view wx:if="{{item.hasAssignment !== false && (item.departmentName || item.workGroupName)}}" class="target-meta">{{item.departmentName}}{{item.workGroupName ? (item.departmentName ? ' · ' : '') + item.workGroupName : ''}}</view>
        </view>
      </view>
    </view>
  </block>
  <view wx:if="{{detailKey}}" id="directory-detail" class="directory-detail">
    <view class="directory-card directory-identity">
      <view class="directory-identity-head">
        <view class="directory-person-body">
          <view class="directory-detail-kicker">{{copy.details}}</view>
          <view class="directory-detail-name">{{contact.name}}</view>
        </view>
        <button wx:if="{{!detailLoading && !detailNotice}}" class="secondary-btn directory-icon-action ui-motion-button" aria-label="{{copy.copyContact}}" data-value="{{contact.copyText}}" bindtap="copyValue" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160"><ui-icon name="copy" sizeRole="context-leading" /></button>
      </view>
      <view wx:if="{{contact.assignmentNatureName || contact.identityCategoryName}}" class="directory-detail-tags">
        <text wx:if="{{contact.assignmentNatureName}}" class="directory-detail-chip">{{contact.assignmentNatureName}}</text>
        <text wx:if="{{contact.identityCategoryName}}" class="directory-detail-chip directory-detail-chip-identity">{{contact.identityCategoryName}}</text>
      </view>
      <view wx:if="{{contact.departmentName || contact.workGroupName}}" class="directory-detail-position">{{contact.departmentName}}{{contact.workGroupName ? (contact.departmentName ? ' · ' : '') + contact.workGroupName : ''}}</view>
    </view>
    <app-loading wx:if="{{detailLoading}}" text="{{copy.loadingDetail}}" />
    <view wx:if="{{detailNotice}}" class="directory-note">{{detailNotice}}</view>
    <view wx:if="{{detailNotice}}" class="card-actions directory-actions"><button class="secondary-btn ui-motion-button" bindtap="openContact" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.retry}}</button></view>
    <block wx:if="{{!detailLoading && !detailNotice}}">
      <view wx:if="{{hasDetailFields}}" class="directory-fields">
        <view wx:for="{{contact.fields}}" wx:key="label" class="directory-card directory-detail-field {{item.phone ? 'directory-detail-field-phone' : ''}}">
          <view class="directory-person-body">
            <view class="directory-field-label">{{item.label}}</view>
            <text class="directory-field-value {{!item.value ? 'directory-field-value-empty' : ''}}" user-select="{{true}}">{{item.value || copy.blankValue}}</text>
          </view>
          <view wx:if="{{item.value}}" class="directory-field-actions">
            <button wx:if="{{item.phone}}" class="secondary-btn directory-icon-action ui-motion-button" aria-label="{{copy.call}}" data-phone="{{item.phone}}" bindtap="callPhone" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160"><ui-icon name="phone" sizeRole="context-leading" /></button>
            <button class="secondary-btn directory-icon-action ui-motion-button" aria-label="{{copy.copyValue + ' ' + item.label}}" data-value="{{item.value}}" bindtap="copyValue" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160"><ui-icon name="copy" sizeRole="context-leading" /></button>
          </view>
        </view>
      </view>
      <view wx:if="{{hasRelatedPositions}}" class="directory-card directory-related">
        <view class="directory-related-heading">{{copy.otherPositions}}</view>
        <view wx:for="{{contact.related}}" wx:key="key" class="directory-filter-head directory-related-position" role="button" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" data-key="{{item.key}}" bindtap="locate">
          <text>{{item.label}}</text><ui-icon name="chevron-right" sizeRole="context-trailing" />
        </view>
      </view>
    </block>
  </view>
</view>
<personnel-picker visible="{{pickerVisible}}" title="{{pickerTitle}}" options="{{people}}" value="{{pickerValue}}" selectionLevel="person" multiple="{{true}}" bindconfirm="confirmPeople" bindcancel="closePeople" />

<page-meta page-style="{{pickerVisible ? 'overflow: hidden;' : ''}}" />
<ui-navbar title="{{navigationTitle}}" />
<view class="page page-narrow calendar-page" style="min-height: calc(100vh - {{navTopPx}}px)">
  <workspace-hero app-name="{{common.appName}}" page-name="{{copy.title}}" />
  <app-loading wx:if="{{loading}}" text="{{copy.loading}}" />
  <view wx:if="{{notice}}" class="card calendar-stack"><text>{{notice}}</text><button wx:if="{{failed}}" class="ui-motion-button secondary-btn" bindtap="load" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.retry}}</button></view>
  <view wx:if="{{!loading && !failed}}" class="card calendar-stack">
    <view class="section-title">{{sourceKind ? copy.participants : draft.id ? copy.edit : copy.create}}</view>
    <block wx:if="{{!sourceKind}}">
      <view class="field-label">{{copy.name}}</view><input class="field-input" value="{{draft.title}}" maxlength="-1" disabled="{{busy || saved}}" data-field="title" bindinput="field" />
      <view class="field-label">{{copy.location}}</view><input class="field-input" value="{{draft.location}}" maxlength="-1" disabled="{{busy || saved}}" data-field="location" bindinput="field" />
      <view class="field-label">{{copy.description}}</view><textarea class="field-textarea" value="{{draft.description}}" maxlength="-1" disabled="{{busy || saved}}" data-field="description" bindinput="field" auto-height />
      <block wx:if="{{draft.id}}"><view class="field-label">{{copy.scope}}</view><picker range="{{scopeLabels}}" value="{{scopeIndex}}" disabled="{{busy || saved}}" bindchange="scope"><view class="picker-display">{{scopeLabels[scopeIndex]}}</view></picker></block>
      <view class="calendar-between"><text>{{copy.allDay}}</text><switch checked="{{draft.allDay}}" disabled="{{busy || saved}}" bindchange="allDay" /></view><view wx:if="{{draft.allDay}}" class="calendar-note">{{copy.endExclusive}}</view>
      <view class="field-label">{{copy.startDate}}</view><picker mode="date" value="{{draft.startDate}}" disabled="{{busy || saved}}" data-field="startDate" bindchange="field"><view class="picker-display">{{draft.startDate}}</view></picker>
      <view class="field-label">{{copy.endDate}}</view><picker mode="date" value="{{draft.endDate}}" disabled="{{busy || saved}}" data-field="endDate" bindchange="field"><view class="picker-display">{{draft.endDate}}</view></picker>
      <block wx:if="{{!draft.allDay}}"><view class="field-label">{{copy.startTime}}</view><picker mode="time" value="{{draft.startTime}}" disabled="{{busy || saved}}" data-field="startTime" bindchange="field"><view class="picker-display">{{draft.startTime}}</view></picker><view class="field-label">{{copy.endTime}}</view><picker mode="time" value="{{draft.endTime}}" disabled="{{busy || saved}}" data-field="endTime" bindchange="field"><view class="picker-display">{{draft.endTime}}</view></picker></block>
      <view class="field-label">{{copy.recurrence}}</view><picker range="{{frequencyLabels}}" value="{{frequencyIndex}}" disabled="{{busy || saved || (draft.id && draft.scope !== 'series')}}" bindchange="frequency"><view class="picker-display">{{frequencyLabels[frequencyIndex]}}</view></picker>
      <block wx:if="{{frequencyIndex > 0}}"><view class="field-label">{{copy.interval}}</view><input class="field-input" type="number" value="{{draft.recurrence.interval}}" disabled="{{busy || saved || (draft.id && draft.scope !== 'series')}}" data-field="interval" bindinput="ruleField" /><view wx:if="{{frequencyIndex === 2}}" class="calendar-actions"><view wx:for="{{weekdays}}" wx:key="value" class="ui-motion-card selection-option-card {{item.selected ? 'selection-option-card-selected' : ''}}" data-value="{{item.value}}" catchtap="weekday" aria-checked="{{item.selected}}" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">{{item.label}}</view></view><picker range="{{endModes}}" value="{{endMode}}" disabled="{{busy || saved || (draft.id && draft.scope !== 'series')}}" bindchange="endMode"><view class="picker-display">{{endModes[endMode]}}</view></picker><picker wx:if="{{endMode === 1}}" mode="date" value="{{draft.recurrence.until}}" data-field="until" bindchange="ruleField" disabled="{{busy || saved || (draft.id && draft.scope !== 'series')}}"><view class="picker-display">{{draft.recurrence.until || copy.until}}</view></picker><input wx:if="{{endMode === 2}}" class="field-input" type="number" value="{{draft.recurrence.count}}" placeholder="{{copy.count}}" data-field="count" bindinput="ruleField" disabled="{{busy || saved || (draft.id && draft.scope !== 'series')}}" /></block>
      <view class="field-label">{{copy.reminders}}</view><picker range="{{reminderLabels}}" value="{{reminderIndex}}" disabled="{{busy || saved}}" bindchange="reminder"><view class="picker-display">{{reminderLabels[reminderIndex]}}</view></picker>
      <view class="calendar-between"><text>{{copy.organization}}</text><switch checked="{{draft.visibility === 'organization'}}" disabled="{{busy || saved || draft.id}}" bindchange="visibility" /></view>
    </block>
    <block wx:if="{{sourceKind || draft.visibility === 'organization'}}"><view class="section-title">{{copy.participants}}</view><calendar-conditions value="{{draft.targets}}" metadata="{{metadata}}" disabled="{{busy || saved || (draft.id && draft.scope !== 'series')}}" bindchange="targets" bindpickerchange="picker" /></block>
    <view class="calendar-actions"><button class="ui-motion-button secondary-btn" disabled="{{busy}}" bindtap="back" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.cancel}}</button><button class="ui-motion-button primary-btn" disabled="{{busy || saved}}" bindtap="save" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.save}}</button></view>
  </view>
</view>
<app-toast loading="{{busy}}" loading-text="{{copy.saving}}" />

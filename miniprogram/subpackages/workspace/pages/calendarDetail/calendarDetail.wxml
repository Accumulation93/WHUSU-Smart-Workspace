<page-meta page-style="{{confirmation ? 'overflow: hidden;' : ''}}" />
<ui-navbar title="{{navigationTitle}}" />
<view class="page page-narrow calendar-page" style="min-height: calc(100vh - {{navTopPx}}px)"><workspace-hero app-name="{{common.brandName}}" page-name="{{copy.title}}" /><app-loading wx:if="{{loading}}" text="{{copy.loading}}" /><view wx:if="{{notice}}" class="card calendar-stack"><text>{{notice}}</text><button class="ui-motion-button secondary-btn" bindtap="load" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.refresh}}</button></view>
  <view wx:if="{{detail}}" class="card calendar-stack"><text class="chip chip-sky">{{copy[detail.sourceKind]}}</text><view class="section-title">{{detail.title}}</view><view class="calendar-name">{{detail.timeText}}</view><view>{{detail.location}}</view><view>{{detail.description}}</view><view class="section-title">{{copy.participants}} · {{detail.participants.length}}</view><view wx:for="{{detail.participants}}" wx:key="index" class="calendar-event"><view class="calendar-name"><person-link name="{{item.name}}" reference="{{item.personReference}}" /></view><view wx:for="{{item.positions}}" wx:for-item="position" wx:key="*this" class="calendar-note">{{position}}</view><view wx:if="{{!item.positions.length}}" class="calendar-note">{{copy.noPosition}}</view></view>
    <view wx:if="{{canAdd}}" class="calendar-stack"><button class="ui-motion-button secondary-btn" bindtap="addPhone" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.addOnce}}</button><view class="calendar-note">{{copy.onceHint}}</view></view>
    <view class="calendar-actions"><button wx:if="{{detail.canUpdate}}" class="ui-motion-button primary-btn" bindtap="edit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.edit}}</button><button wx:if="{{detail.attending && detail.visibility !== 'private'}}" class="ui-motion-button secondary-btn" data-action="leave" bindtap="confirm" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.leave}}</button><button wx:if="{{detail.canCancel}}" class="ui-motion-button danger-btn" data-action="cancel" bindtap="confirm" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.cancelEvent}}</button></view>
  </view>
</view>
<viewport-portal wx:if="{{confirmation}}"><view class="ui-overlay"><view class="ui-overlay-blocker popup-mask-blocker" catchtouchmove="noop" bindtap="close"></view><view class="popup-card ui-dialog-shell ui-dialog-shell--complex ui-dialog-shell--grid"><view class="ui-dialog-header"><view class="ui-dialog-title">{{action === 'leave' ? copy.leave : copy.cancelEvent}}</view></view><scroll-view class="ui-dialog-body ui-dialog-scroll--fill" scroll-y="{{true}}" enhanced="{{true}}" nested-scroll-enabled="{{true}}"><view class="ui-dialog-content"><view class="calendar-stack"><view>{{detail.title}}</view><view>{{action === 'leave' ? copy.leaveConfirm : copy.cancelConfirm}}</view><picker range="{{scopeLabels}}" value="{{scopeIndex}}" disabled="{{busy}}" bindchange="scope"><view class="picker-display">{{scopeLabels[scopeIndex]}}</view></picker><view wx:if="{{notice}}">{{notice}}</view></view></view></scroll-view><view class="ui-dialog-footer"><button class="ui-motion-button secondary-btn" disabled="{{busy}}" bindtap="close" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.close}}</button><button class="ui-motion-button danger-btn" disabled="{{busy}}" bindtap="execute" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.confirmedCancel}}</button></view></view></view></viewport-portal>
<app-toast loading="{{busy}}" loading-text="{{copy.saving}}" />

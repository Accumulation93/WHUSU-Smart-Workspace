<ui-navbar title="{{navigationTitle}}" />
<view class="page calendar-page" style="min-height: calc(100vh - {{navTopPx}}px)">
  <workspace-hero app-name="{{common.brandName}}" page-name="{{copy.title}}" />
  <view wx:if="{{failed}}" class="card calendar-stack">
    <view>{{copy.operationFailed}}</view>
    <button class="secondary-btn ui-motion-button" bindtap="retry" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.retry}}</button>
  </view>
  <app-loading wx:else text="{{copy.loading}}" />
</view>

<page-meta page-style="{{confirmation ? 'overflow: hidden;' : ''}}" />
<view class="page page-narrow calendar-page"><workspace-hero app-name="{{common.appName}}" page-name="{{copy.systemCalendar}}" /><view class="card calendar-stack"><view class="section-title">{{copy.subscribe}}</view><view>{{copy.subscriptionHint}}</view><view class="calendar-note">{{copy.subscriptionPrivacy}}</view><view wx:if="{{notice}}">{{notice}}</view><view class="calendar-actions"><button class="ui-motion-button primary-btn" disabled="{{busy}}" data-action="create" bindtap="ask" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{subscription ? copy.resetSubscription : copy.subscribe}}</button><button class="ui-motion-button danger-btn" disabled="{{busy}}" data-action="revoke" bindtap="ask" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.revokeSubscription}}</button></view></view>
  <view wx:if="{{subscription}}" class="card calendar-stack"><view>{{copy.subscriptionSetup}}</view><view class="calendar-note">{{copy.subscriptionServer}}</view><view selectable data-key="server" bindtap="copy" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">{{subscription.server}}</view><view class="calendar-note">{{copy.subscriptionUsername}}</view><view selectable data-key="username" bindtap="copy" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">{{subscription.username}}</view><view class="calendar-note">{{copy.subscriptionPassword}}</view><view selectable class="ui-motion-card calendar-note" data-key="password" bindtap="copy" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">{{subscription.password}}</view><button class="ui-motion-button secondary-btn" data-key="url" bindtap="copy" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.copyAddress}}</button></view>
  <view class="card calendar-note">{{copy.onceHint}}</view>
</view>
<viewport-portal wx:if="{{confirmation}}"><view class="ui-overlay"><view class="ui-overlay-blocker popup-mask-blocker" catchtouchmove="noop" bindtap="close"></view><view class="popup-card ui-dialog-shell ui-dialog-shell--complex ui-dialog-shell--grid"><view class="ui-dialog-header"><view class="ui-dialog-title">{{action === 'create' ? copy.subscribe : copy.revokeSubscription}}</view></view><scroll-view class="ui-dialog-body ui-dialog-scroll--fill" scroll-y="{{true}}" enhanced="{{true}}" nested-scroll-enabled="{{true}}"><view class="ui-dialog-content"><view>{{action === 'create' ? copy.subscriptionResetConfirm : copy.subscriptionStopConfirm}}</view><view wx:if="{{notice}}">{{notice}}</view></view></scroll-view><view class="ui-dialog-footer"><button class="ui-motion-button secondary-btn" disabled="{{busy}}" bindtap="close" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.close}}</button><button class="ui-motion-button primary-btn" disabled="{{busy}}" bindtap="execute" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.save}}</button></view></view></view></viewport-portal>
<app-toast loading="{{busy}}" loading-text="{{copy.saving}}" />

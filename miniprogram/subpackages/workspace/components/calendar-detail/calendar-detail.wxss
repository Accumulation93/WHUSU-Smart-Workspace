@import "../../pages/calendar/calendar.wxss";
.calendar-participants-section { display:flex;flex-direction:column;gap:var(--ui-field-gap); }
.calendar-participants-heading { display:flex;align-items:center;gap:var(--ui-inline-gap); }
.calendar-participants-heading > .section-title { flex:1;min-width:0; }
.ui-dialog-footer.calendar-detail-actions { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch;gap:var(--ui-page-action-gap); }
.ui-dialog-footer.calendar-detail-actions > .calendar-detail-action { width:100%;min-width:0;max-width:100%;margin:0;display:flex;align-items:center;justify-content:center;text-align:center; }
.calendar-detail-actions > .calendar-detail-action:only-child,.calendar-detail-actions > .calendar-detail-action:first-child:nth-last-child(3) { grid-column:1 / -1; }
.calendar-participants-section .calendar-roster-toggle { flex:none;width:auto;min-width:0;max-width:100%;height:auto;min-height:var(--ui-compact-height);padding:var(--ui-compact-padding-y) var(--ui-compact-padding-x);margin:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.4;font-size:var(--ui-type-meta); }

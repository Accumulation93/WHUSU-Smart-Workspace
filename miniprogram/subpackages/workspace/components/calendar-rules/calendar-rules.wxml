<view class="calendar-panel"><app-loading wx:if="{{loading}}" text="{{copy.loading}}" /><view wx:if="{{notice}}" class="card calendar-stack"><text>{{notice}}</text><button class="ui-motion-button secondary-btn" disabled="{{busy}}" bindtap="load" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.retry}}</button></view>
  <view wx:if="{{!draft && (canCreate || hasDeletableRules)}}" class="section-control-card calendar-stack">
    <view class="calendar-actions">
      <button wx:if="{{canCreate}}" class="ui-motion-button primary-btn" disabled="{{busy || loading || failed}}" bindtap="create" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.createRule}}</button>
      <button wx:if="{{hasDeletableRules}}" class="ui-motion-button danger-btn" disabled="{{busy || loading || failed || !selected.length}}" bindtap="askDelete" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.delete}}</button>
    </view>
    <view class="ui-action-summary calendar-note" wx:if="{{selected.length}}">{{controls.selected}} {{selected.length}} {{controls.items}}</view>
  </view>
  <view wx:if="{{draft}}" class="card calendar-stack"><view class="section-title">{{copy.ruleName}}</view><input class="field-input" value="{{draft.name}}" maxlength="-1" disabled="{{busy || saved}}" bindinput="name" /><view class="section-title">{{copy.audience}}</view><calendar-conditions audience value="{{draft.audience}}" metadata="{{metadata}}" disabled="{{busy || saved}}" data-key="audience" bindchange="conditions" bindpickerchange="picker" /><view class="section-title">{{copy.targets}}</view><calendar-conditions value="{{draft.targets}}" metadata="{{metadata}}" disabled="{{busy || saved}}" data-key="targets" bindchange="conditions" bindpickerchange="picker" /><view class="section-title">{{copy.actions}}</view><view class="calendar-actions"><view wx:for="{{actions}}" wx:key="key" class="ui-motion-card selection-option-card {{item.selected ? 'selection-option-card-selected' : ''}}" data-key="{{item.key}}" catchtap="action" aria-checked="{{item.selected}}" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">{{item.label}}</view></view><view class="calendar-between"><text>{{copy.enabled}}</text><switch checked="{{draft.enabled}}" disabled="{{busy || saved}}" bindchange="enabled" /></view><view class="calendar-actions"><button class="ui-motion-button secondary-btn" disabled="{{busy}}" bindtap="closeEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.cancel}}</button><button class="ui-motion-button primary-btn" disabled="{{busy || saved || failed}}" bindtap="save" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.save}}</button></view></view>
  <block wx:else>
    <view wx:for="{{rules}}" wx:key="id" class="card calendar-stack">
      <view wx:if="{{item.canDelete}}" class="ui-motion-card calendar-rule-selection selection-option-card {{item.selected ? 'selection-option-card-selected' : ''}}" data-id="{{item.id}}" catchtap="select" aria-role="checkbox" aria-checked="{{item.selected}}" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">
        <view class="calendar-name">{{item.name}}</view>
        <text class="chip">{{item.enabled ? copy.enabled : copy.disabled}}</text>
      </view>
      <view wx:else class="calendar-between"><view class="calendar-name">{{item.name}}</view><text class="chip">{{item.enabled ? copy.enabled : copy.disabled}}</text></view>
      <view wx:if="{{item.canUpdate || canCreate}}" class="card-actions">
        <button wx:if="{{item.canUpdate}}" class="ui-motion-button secondary-btn" disabled="{{busy || loading || failed}}" data-id="{{item.id}}" catchtap="edit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.edit}}</button>
        <button wx:if="{{canCreate}}" class="ui-motion-button secondary-btn" disabled="{{busy || loading || failed}}" data-id="{{item.id}}" catchtap="duplicate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.duplicate}}</button>
        <button wx:if="{{item.canUpdate}}" class="ui-motion-button secondary-btn" disabled="{{busy || loading || failed}}" data-id="{{item.id}}" catchtap="toggle" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item.enabled ? copy.disabled : copy.enabled}}</button>
      </view>
    </view>
    <view wx:if="{{!rules.length && !loading && !failed}}" class="card calendar-note">{{copy.rulesEmpty}}</view>
  </block>
</view>
<viewport-portal wx:if="{{confirmation}}"><view class="ui-overlay"><view class="ui-overlay-blocker popup-mask-blocker" catchtouchmove="noop" bindtap="close"></view><view class="popup-card ui-dialog-shell ui-dialog-shell--complex ui-dialog-shell--grid"><view class="popup-header ui-dialog-header"><view class="popup-title">{{copy.delete}} · {{selectedNames.length}}</view></view><scroll-view class="ui-dialog-body ui-dialog-scroll--fill ui-dialog-scroll--natural" scroll-y="{{true}}" enhanced="{{true}}" nested-scroll-enabled="{{true}}"><view class="ui-dialog-content ui-dialog-scroll-content"><view>{{copy.deleteRuleConfirm}}</view><view wx:for="{{selectedNames}}" wx:key="index">{{item}}</view><view wx:if="{{notice}}">{{notice}}</view></view></scroll-view><view class="ui-dialog-footer"><button class="ui-motion-button secondary-btn" disabled="{{busy}}" bindtap="close" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.close}}</button><button class="ui-motion-button danger-btn" disabled="{{busy}}" bindtap="remove" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.delete}}</button></view></view></view></viewport-portal>
<app-toast loading="{{busy}}" loading-text="{{copy.saving}}" />

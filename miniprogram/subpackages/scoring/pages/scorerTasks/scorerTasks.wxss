@import "../admin/admin.wxss";

.scorer-stats-grid {
  grid-template-columns: 1fr;
}

.scorer-stats-grid + .edit-box {
  margin-top: 0;
}

.scorer-filter-last-field {
  margin-bottom: 0;
}

.scorer-filter-actions {
  margin-top: var(--ui-action-gap, 20rpx);
  margin-bottom: 0;
}

.scorer-export-actions {
  margin: 0;
}

.stat-card-accent {
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.96) 0%, rgba(219, 234, 254, 0.88) 100%);
}

.task-table,
.popup-table {
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.74) 0%, rgba(239, 246, 255, 0.58) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  box-shadow:
    0 16rpx 34rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
  animation: glassFadeUp 0.48s ease both;
}

.task-table-head,
.task-table-row,
.popup-table-head,
.popup-table-row {
  display: flex;
  align-items: stretch;
}

.task-table-head,
.popup-table-head {
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.78) 0%, rgba(191, 219, 254, 0.48) 100%);
  box-shadow: inset 0 -1rpx 0 rgba(147, 197, 253, 0.34);
}

.task-table-head .task-col {
  font-size: var(--ui-type-body);
  font-weight: 600;
}

.task-table-row,
.popup-table-row {
  position: relative;
  border-top: 1rpx solid rgba(147, 197, 253, 0.28);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.48) 0%, rgba(248, 251, 255, 0.34) 100%);
  transition: transform 0.18s ease, box-shadow 0.24s ease, background 0.24s ease, filter 0.24s ease;
}

.task-row-hit-area {
  position: absolute;
  inset: 0;
  z-index: 3;
  background: transparent;
}

.task-col,
.popup-col {
  position: relative;
  z-index: 2;
  padding: 18rpx 16rpx;
  box-sizing: border-box;
}

.task-table-head .task-col,
.task-table-row .task-col,
.popup-table-head .popup-col,
.popup-table-row .popup-col {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.task-col-name {
  flex: 2.2;
  min-width: 0;
}

.task-col-progress {
  flex: 0.95;
  min-width: 210rpx;
}

.task-col-action {
  width: 112rpx;
  min-width: 112rpx;
}

.popup-col-name {
  flex: 0.82;
  text-align: center;
}

.popup-col-dept {
  flex: 1.58;
  text-align: center;
}

.task-name {
  color: #0f172a;
  font-size: var(--ui-type-emphasis);
  font-weight: 700;
  line-height: 1.5;
  word-break: break-word;
  max-width: 100%;
  text-align: center;
}

.task-meta {
  color: #64748b;
  font-size: var(--ui-type-caption);
  line-height: 1.55;
  word-break: break-word;
  text-align: center;
}

.no-wrap-link {
  display: inline-block;
  white-space: nowrap;
  font-size: var(--ui-type-meta);
  text-align: center;
}

.task-table-row:active,
.popup-table-row:active {
  transform: translateY(1rpx) scale(0.996);
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.72) 0%, rgba(248, 251, 255, 0.82) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88),
    0 0 0 3rpx rgba(37, 99, 235, 0.10);
  filter: saturate(1.03);
}

.popup-table-row:active {
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.74) 0%, rgba(248, 251, 255, 0.88) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88),
    0 0 0 3rpx rgba(37, 99, 235, 0.12);
}

.pending-pill:active {
  transform: translateY(1rpx) scale(0.985);
  filter: saturate(1.04);
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.14),
    0 8rpx 18rpx rgba(37, 99, 235, 0.12);
}

.popup-close:active {
  transform: translateY(1rpx) scale(0.986);
  opacity: 0.9;
  text-shadow: 0 0 12rpx rgba(37, 99, 235, 0.16);
}

.popup-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 28rpx;
  background: rgba(15, 23, 42, 0.30);
  box-sizing: border-box;
}

.popup-card {
  width: 100%;
  max-height: 74vh;
  padding: 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.94) 0%, rgba(248, 251, 255, 0.92) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 24rpx 56rpx rgba(15, 23, 42, 0.14);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-sizing: border-box;
  transition: transform 0.22s ease, box-shadow 0.24s ease;
  animation: glassFadeUp 0.34s ease both;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.popup-title {
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-weight: 700;
}

.popup-close {
  color: #2563eb;
  font-size: var(--ui-type-control);
  font-weight: 700;
  transition: transform 0.18s ease, opacity 0.18s ease, text-shadow 0.22s ease;
}

.popup-scroll {
  max-height: 56vh;
}

.progress-cell {
  width: 100%;
}

@media (min-width: 900px) and (orientation: landscape) {
  .task-table,
  .popup-table {
    border-radius: 14px;
  }

  .task-col,
  .popup-col {
    padding: 10px 12px;
  }
}

.progress-top {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.progress-count {
  color: #0f172a;
  font-size: var(--ui-type-label);
  font-weight: 700;
}

.progress-percent {
  color: #64748b;
  font-size: var(--ui-type-caption);
  font-weight: 700;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.70) 0%, rgba(219, 234, 254, 0.46) 100%);
  border: 1rpx solid rgba(147, 197, 253, 0.34);
  box-shadow:
    inset 0 1rpx 3rpx rgba(37, 99, 235, 0.10),
    0 4rpx 10rpx rgba(37, 99, 235, 0.06);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 54%, #60a5fa 100%);
  box-shadow:
    0 0 14rpx rgba(37, 99, 235, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  transition: width 0.25s ease;
}

.popup-loading-overlay {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  gap: 18rpx;
}

.popup-loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 5rpx solid rgba(37, 99, 235, 0.16);
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: scorerSpinner 0.7s linear infinite;
}

.popup-loading-text {
  color: #2563eb;
  font-size: var(--ui-type-control);
  font-weight: 500;
}

@keyframes scorerSpinner {
  to { transform: rotate(360deg); }
}

/* Popup close is plain text plus x, not a pill button. */
.popup-close {
  display: inline-flex !important;
  align-items: center !important;
  gap: 8rpx !important;
  padding: 4rpx 0 4rpx 16rpx !important;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  color: #475569 !important;
  font-size: var(--ui-type-control) !important;
  font-weight: 700 !important;
}

.popup-close::before { display: none !important; content: none !important; }
.popup-close::after { content: "×" !important; color: #2563eb !important; font-size: var(--ui-type-value) !important; font-weight: 800 !important; line-height: 1 !important; }

<view class="page">
  <workspace-hero class="workspace-hero-host" app-name="WHUSU智慧工作台" page-name="考核评分 · 评分任务"></workspace-hero>

  <view class="section">
    <view class="stats-grid scorer-stats-grid">
      <view class="stat-card stat-card-accent">
        <view class="stat-label">未完成评分人</view>
        <view class="stat-value">{{stats.totalPendingScorers || 0}}</view>
      </view>
    </view>

    <view class="edit-box">
      <view class="list-title">筛选</view>
      <view class="field">
        <view class="field-label">搜索评分人</view>
        <input
          class="field-input"
          value="{{keyword}}"
          bindinput="onKeywordInput"
          bindconfirm="onKeywordConfirm"
          confirm-type="search"
          placeholder="按姓名或学号搜索"
        />
      </view>
      <view class="field field-row">
        <view class="field field-half">
          <view class="field-label">所属部门</view>
          <picker range="{{filterOptions.departments}}" bindchange="onFilterChange" data-field="department">
            <view class="picker-value">{{filters.department}}</view>
          </picker>
        </view>
        <view class="field field-half">
          <view class="field-label">身份</view>
          <picker range="{{filterOptions.identities}}" bindchange="onFilterChange" data-field="identity">
            <view class="picker-value">{{filters.identity}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <view class="field-label">职能组</view>
        <picker range="{{filterOptions.workGroups}}" bindchange="onFilterChange" data-field="workGroup">
          <view class="picker-value">{{filters.workGroup}}</view>
        </picker>
      </view>
      <view class="button-row compact-row">
        <button class="secondary-btn ui-motion-button" loading="{{loading}}" bindtap="loadData" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">刷新列表</button>
      </view>
    </view>

    <view class="edit-box">
      <view class="list-title">导出当前名单</view>
      <view class="button-row">
        <button class="secondary-btn ui-motion-button" loading="{{exportLoadingMap.summary}}" data-report="summary" bindtap="exportCurrentViewUnified" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">导出概览</button>
        <button class="secondary-btn ui-motion-button" loading="{{exportLoadingMap.detail}}" data-report="detail" bindtap="exportCurrentViewUnified" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">导出明细</button>
      </view>
    </view>

    <view class="list-card">
      <view class="list-title">未完成评分人列表</view>
      <scroll-view class="inner-scroll large-scroll" scroll-y>
        <view class="task-table ui-data-grid--complex">
          <view class="task-table-head ui-data-row ui-data-row--header">
            <view class="task-col task-col-name ui-data-cell ui-data-cell--primary">评分人</view>
            <view class="task-col task-col-progress ui-data-cell">已评/应评</view>
            <view class="task-col task-col-action ui-data-cell ui-data-cell--action">操作</view>
          </view>
          <view class="task-table-row ui-motion-chip ui-data-row" wx:for="{{scorerRows}}" wx:key="scorerKey" data-index="{{index}}" bindtap="openPendingPopup" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="task-col task-col-name ui-data-cell ui-data-cell--primary">
              <text class="ui-data-cell-label">评分人</text>
              <view class="ui-data-cell-content"><view class="task-name">{{item.scorerName}}</view><view class="task-meta">{{item.department}}</view></view>
            </view>
            <view class="task-col task-col-progress ui-data-cell">
              <text class="ui-data-cell-label">完成进度</text>
              <view class="progress-cell ui-data-cell-content">
                <view class="progress-top">
                  <text class="progress-count">{{item.progressText}}</text>
                  <text class="progress-percent">{{item.progressPercentText}}</text>
                </view>
                <view class="progress-track">
                  <view class="progress-fill" style="{{item.progressFillStyle}}"></view>
                </view>
              </view>
            </view>
            <view class="task-col task-col-action ui-data-cell ui-data-cell--action">
              <text class="ui-data-cell-label">操作</text>
              <text class="link no-wrap-link">查看</text>
            </view>
          </view>
        </view>
        <view class="empty-inline" wx:if="{{!scorerRows.length}}">没有匹配的评分人</view>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">WHUSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>

  <root-portal wx:if="{{pendingPopupVisible}}">
  <view class="popup-mask ui-overlay" wx:if="{{pendingPopupVisible}}" bindtap="closePendingPopup">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">{{pendingPopupTitle}}</view>
        <text class="popup-close ui-motion-chip" catchtap="closePendingPopup" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-scroll--fill" scroll-y>
        <view class="popup-loading-overlay" wx:if="{{pendingPopupLoading}}">
          <view class="popup-loading-spinner"></view>
          <text class="popup-loading-text">正在加载...</text>
        </view>
        <view class="popup-table ui-data-grid--complex" wx:else>
          <view class="popup-table-head ui-data-row ui-data-row--header">
            <view class="popup-col popup-col-name ui-data-cell ui-data-cell--primary">被评分人</view>
            <view class="popup-col popup-col-dept ui-data-cell">部门与身份</view>
          </view>
          <view class="popup-table-row ui-data-row" wx:for="{{pendingPopupList}}" wx:key="targetId">
            <view class="popup-col popup-col-name ui-data-cell ui-data-cell--primary">
              <text class="ui-data-cell-label">被评分人</text>
              <view class="ui-data-cell-content"><view class="task-name">{{item.targetName}}</view><view class="task-meta">{{item.targetStudentId}}</view></view>
            </view>
            <view class="popup-col popup-col-dept ui-data-cell">
              <text class="ui-data-cell-label">部门与身份</text>
              <view class="ui-data-cell-content"><view class="task-meta">{{item.targetDepartment}}</view><view class="task-meta">{{item.targetIdentity}} / {{item.targetWorkGroup}}</view></view>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!pendingPopupList.length}}">评分已全部完成</view>
        </view>
      </scroll-view>
    </view>
  </view>
  </root-portal>
</view>

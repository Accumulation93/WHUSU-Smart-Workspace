<view class="page">
  <workspace-hero class="workspace-hero-host" app-name="{{localeCopy.copy_aa4f0ed6cd}}" page-name="{{localeCopy.copy_0c1a3a9fd9}} · {{localeCopy.copy_3a550fe14c}}"></workspace-hero>

  <view class="section-stack">
    <view class="stats-grid scorer-stats-grid">
      <view class="stat-card stat-card-accent">
        <view class="stat-label">{{localeCopy.copy_010476007d}}</view>
        <view class="stat-value">{{stats.totalPendingScorers || 0}}</view>
      </view>
    </view>

    <view class="edit-box">
      <view class="list-title">{{localeCopy.copy_74d527730a}}</view>
      <view class="field">
        <view class="field-label">{{localeCopy.copy_d6b32891ae}}</view>
        <input
          class="field-input"
          value="{{keyword}}"
          bindinput="onKeywordInput"
          bindconfirm="onKeywordConfirm"
          confirm-type="search"
          placeholder="{{localeCopy.copy_9ce810a320}}"
        />
      </view>
      <view class="field field-row">
        <view class="field field-half">
          <view class="field-label">{{localeCopy.copy_7ee1272d5b}}</view>
          <picker range="{{filterOptions.departments}}" bindchange="onFilterChange" data-field="department">
            <view class="picker-value">{{filters.department}}</view>
          </picker>
        </view>
        <view class="field field-half">
          <view class="field-label">{{localeCopy.copy_c1965e0690}}</view>
          <picker range="{{filterOptions.identities}}" bindchange="onFilterChange" data-field="identity">
            <view class="picker-value">{{filters.identity}}</view>
          </picker>
        </view>
      </view>
      <view class="field scorer-filter-last-field">
        <view class="field-label">{{localeCopy.copy_303b7a8611}}</view>
        <picker range="{{filterOptions.workGroups}}" bindchange="onFilterChange" data-field="workGroup">
          <view class="picker-value">{{filters.workGroup}}</view>
        </picker>
      </view>
      <view class="button-row compact-row scorer-filter-actions">
        <button class="secondary-btn ui-motion-button" loading="{{loading}}" bindtap="loadData" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_8029e5c326}}</button>
      </view>
    </view>

    <view class="edit-box">
      <view class="list-title">{{localeCopy.copy_b0bf25e2b8}}</view>
      <view class="button-row scorer-export-actions">
        <button class="secondary-btn ui-motion-button" loading="{{exportLoadingMap.summary}}" data-report="summary" bindtap="exportCurrentViewUnified" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_3f8bff9fcf}}</button>
        <button class="secondary-btn ui-motion-button" loading="{{exportLoadingMap.detail}}" data-report="detail" bindtap="exportCurrentViewUnified" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_e47f95e658}}</button>
      </view>
    </view>

    <view class="list-card">
      <view class="list-title">{{localeCopy.copy_5a47791b4b}}</view>
      <scroll-view class="inner-scroll large-scroll" scroll-y>
        <view class="task-table ui-data-grid--complex">
          <view class="task-table-head ui-data-row ui-data-row--header">
            <view class="task-col task-col-name ui-data-cell ui-data-cell--primary">{{localeCopy.copy_b9b9929aee}}</view>
            <view class="task-col task-col-progress ui-data-cell">{{localeCopy.copy_12b44cbb96}}</view>
            <view class="task-col task-col-action ui-data-cell ui-data-cell--action">{{localeCopy.copy_6dcfc3571c}}</view>
          </view>
          <view class="task-table-row ui-motion-chip ui-data-row" wx:for="{{scorerRows}}" wx:key="scorerKey" data-index="{{index}}" bindtap="openPendingPopup" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="task-col task-col-name ui-data-cell ui-data-cell--primary">
              <text class="ui-data-cell-label">{{localeCopy.copy_b9b9929aee}}</text>
              <view class="ui-data-cell-content"><view class="task-name">{{item.scorerName}}</view><view class="task-meta">{{item.department}}</view></view>
            </view>
            <view class="task-col task-col-progress ui-data-cell">
              <text class="ui-data-cell-label">{{localeCopy.copy_44b244e636}}</text>
              <view class="progress-cell ui-data-cell-content">
                <view class="progress-top">
                  <text class="progress-count">{{item.progressText}}</text>
                  <text class="progress-percent">{{item.progressPercentText}}</text>
                </view>
                <view class="progress-track">
                  <view class="progress-fill" style="{{item.progressFillStyle}}"></view>
                </view>
              </view>
            </view>
            <view class="task-col task-col-action ui-data-cell ui-data-cell--action">
              <text class="ui-data-cell-label">{{localeCopy.copy_6dcfc3571c}}</text>
              <text class="link no-wrap-link">{{localeCopy.copy_1d6224cd18}}</text>
            </view>
          </view>
        </view>
        <view class="empty-inline" wx:if="{{!scorerRows.length}}">{{localeCopy.copy_b7c3654faa}}</view>
      </scroll-view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">{{localeCopy.copy_aa4f0ed6cd}}</view>
    <view class="footer-org">{{localeCopy.copy_638da8ae60}}</view>
  </view>

  <viewport-portal wx:if="{{pendingPopupVisible}}">
  <view class="popup-mask ui-overlay" wx:if="{{pendingPopupVisible}}" bindtap="closePendingPopup">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">{{pendingPopupTitle}}</view>
        <text class="popup-close ui-motion-chip" catchtap="closePendingPopup" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_09614cef6c}}</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-content ui-dialog-scroll--fill" scroll-y>
        <view class="popup-loading-overlay" wx:if="{{pendingPopupLoading}}">
          <view class="popup-loading-spinner"></view>
          <text class="popup-loading-text">{{localeCopy.copy_8dfeae7ced}}</text>
        </view>
        <view class="popup-table ui-data-grid--complex" wx:else>
          <view class="popup-table-head ui-data-row ui-data-row--header">
            <view class="popup-col popup-col-name ui-data-cell ui-data-cell--primary">{{localeCopy.copy_12cd162fda}}</view>
            <view class="popup-col popup-col-dept ui-data-cell">{{localeCopy.copy_937ade982a}}</view>
          </view>
          <view class="popup-table-row ui-data-row" wx:for="{{pendingPopupList}}" wx:key="targetId">
            <view class="popup-col popup-col-name ui-data-cell ui-data-cell--primary">
              <text class="ui-data-cell-label">{{localeCopy.copy_12cd162fda}}</text>
              <view class="ui-data-cell-content"><view class="task-name">{{item.targetName}}</view><view class="task-meta">{{item.targetStudentId}}</view></view>
            </view>
            <view class="popup-col popup-col-dept ui-data-cell">
              <text class="ui-data-cell-label">{{localeCopy.copy_937ade982a}}</text>
              <view class="ui-data-cell-content"><view class="task-meta">{{item.targetDepartment}}</view><view class="task-meta">{{item.targetIdentity}} / {{item.targetWorkGroup}}</view></view>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!pendingPopupList.length}}">{{localeCopy.copy_d0de4ea38f}}</view>
        </view>
      </scroll-view>
    </view>
  </view>
  </viewport-portal>
</view>

@import "../../../main/styles/home.wxss";

.import-page { padding: var(--ui-page-padding-top) var(--ui-page-padding-x) var(--ui-page-padding-bottom); box-sizing: border-box; }
.import-card { margin-bottom: var(--ui-card-gap); padding: var(--ui-card-padding-y) var(--ui-card-padding-x); border-radius: var(--ui-card-radius); background: linear-gradient(135deg, rgba(255,255,255,.94), rgba(241,247,255,.82)); border: 1rpx solid rgba(255,255,255,.78); box-shadow: 0 12rpx 28rpx rgba(15,23,42,.05), inset 0 1rpx 0 rgba(255,255,255,.9); backdrop-filter: blur(24rpx); }
.import-title { font-size: var(--ui-type-section); font-weight: 700; color: #0f172a; line-height: 1.5; overflow-wrap: anywhere; }
.import-label { font-size: var(--ui-type-label); color: #334155; line-height: 1.6; }
.import-note { font-size: var(--ui-type-meta); color: #64748b; line-height: 1.7; overflow-wrap: anywhere; }
.import-error { font-size: var(--ui-type-body); color: #92400e; line-height: 1.7; }
.import-split-row { margin-top: var(--ui-field-gap); padding-top: var(--ui-field-gap); border-top: 1rpx solid rgba(147,197,253,.35); }
.import-field { margin-top: var(--ui-field-gap); min-width: 0; }
.import-field .field-input { display: block; width: 100%; box-sizing: border-box; }
.import-field .picker-display { min-height: var(--ui-field-control-height); height: auto; white-space: normal; line-height: 1.6; box-sizing: border-box; }
.import-actions, .import-views { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ui-card-action-gap, 14rpx); margin-top: var(--ui-card-action-divider-gap, 16rpx); }
.import-actions button, .import-views button { display: flex; align-items: center; justify-content: center; text-align: center; height: auto; width: 100%; min-width: 0; min-height: var(--ui-control-height); padding: var(--ui-control-padding-y) var(--ui-control-padding-x); font-size: var(--ui-type-control); border-radius: var(--ui-control-radius); line-height: 1.4; white-space: normal; margin: 0; }
.import-categories { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ui-inline-gap); margin-top: var(--ui-field-gap); }
.import-category { display: flex; align-items: center; justify-content: space-between; gap: var(--ui-inline-gap); min-width: 0; min-height: var(--ui-control-height); box-sizing: border-box; padding: var(--ui-list-padding-y) var(--ui-list-padding-x); border-radius: var(--ui-control-radius); border: 1rpx solid rgba(147,197,253,.4); background: linear-gradient(135deg, rgba(255,255,255,.94), rgba(248,251,255,.8)); }
.import-category .import-label { min-width: 0; }
.import-category .import-note { flex: none; }
.import-list-heading { padding: var(--ui-list-padding-y) var(--ui-list-padding-x); margin-bottom: var(--ui-card-gap); }
.import-issue-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--ui-inline-gap); }
.import-reason { margin-top: var(--ui-label-gap); font-size: var(--ui-type-body); color: #334155; line-height: 1.65; white-space: pre-line; overflow-wrap: anywhere; }
.import-active { border-color: #3b82f6; background: linear-gradient(135deg, rgba(219,234,254,.85), rgba(239,246,255,.9)); }
.import-value { font-size: var(--ui-type-body); color: #0f172a; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
.import-diff { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ui-inline-gap); margin-top: var(--ui-field-gap); }
.import-diff-cell { min-width: 0; padding: var(--ui-list-padding-y) var(--ui-list-padding-x); border-radius: var(--ui-control-radius); border: 1rpx solid rgba(203,213,225,.5); background: linear-gradient(135deg, rgba(248,250,252,.9), rgba(239,246,255,.6)); }
.import-switch { display: flex; align-items: center; justify-content: space-between; font-size: var(--ui-type-label); line-height: 1.6; padding-top: var(--ui-card-action-gap, 12rpx); }
@media (min-width: 520px) { .import-page { padding: 20px; } .import-views { grid-template-columns: repeat(5, minmax(0, 1fr)); } .import-categories { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (min-width: 900px) { .import-page { padding: 22px; } .import-categories { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; } }

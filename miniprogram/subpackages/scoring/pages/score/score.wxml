<view class="page {{readOnly ? 'page-readonly' : 'page-with-keyboard'}}">
  <input
    wx:if="{{!readOnly}}"
    class="physical-keyboard-capture"
    type="text"
    value="{{physicalInputValue}}"
    focus="{{physicalInputFocus}}"
    adjust-position="{{false}}"
    cursor-spacing="0"
    hold-keyboard="{{true}}"
    bindinput="onPhysicalInput"
    bindconfirm="onPhysicalConfirm"
    bindblur="onPhysicalInputBlur"
    bindkeydown="onPhysicalKeyDown"
    bindkeyup="onPhysicalKeyUp"
  />
  <workspace-hero class="workspace-hero-host" app-name="{{localeCopy.copy_aa4f0ed6cd}}" page-name="{{localeCopy.copy_0c1a3a9fd9}} · {{localeCopy.copy_1f4d77229c}}"></workspace-hero>

  <view class="target-sticky {{showStickyTarget ? 'target-sticky-show' : ''}}" wx:if="{{target.name}}">
    <view class="target-sticky-label">{{localeCopy.copy_12cd162fda}}</view>
    <view class="target-sticky-name">{{target.name}}</view>
  </view>

  <view class="card" wx:if="{{loading}}">
    <view class="empty-text">{{localeCopy.copy_a017932da1}}</view>
  </view>

  <view class="card load-error-card" wx:if="{{!loading && loadFailed}}">
    <view class="section-title">{{localeCopy.loadFailedTitle}}</view>
    <view class="load-error-text">{{loadErrorText}}</view>
    <button class="primary-btn load-error-action ui-motion-button" bindtap="retryLoadScoreForm" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{localeCopy.retryLoad}}</button>
  </view>

  <view class="score-workspace" wx:if="{{!loading && !loadFailed}}">
    <view class="card target-info-card">
      <view class="info-grid">
        <view class="info-block info-block-full">
          <view class="info-label">{{localeCopy.copy_35fabd21a9}}</view>
          <view class="info-value">{{currentActivityText}}</view>
        </view>
        <view class="info-block">
          <view class="info-label">{{localeCopy.copy_b9b9929aee}}</view>
          <view class="info-value">{{scorer.name}}</view>
          <view class="assignment-chip" wx:if="{{scorer._showAssignmentChip}}">{{scorer._assignmentChipText}}</view>
          <view class="info-subvalue">
            <view wx:if="{{scorer.department}}">{{scorer.department}}</view>
            <view wx:if="{{scorer.identity}}">{{scorer.identity}}</view>
            <view wx:if="{{scorer.workGroup}}">{{scorer.workGroup}}</view>
          </view>
        </view>
        <view class="info-block target-block">
          <view class="info-label">{{localeCopy.copy_12cd162fda}}</view>
          <view class="info-value target-name-anchor">{{target.name}}</view>
          <view class="assignment-chip" wx:if="{{target._showAssignmentChip}}">{{target._assignmentChipText}}</view>
          <view class="info-subvalue">
            <view wx:if="{{target.department}}">{{target.department}}</view>
            <view wx:if="{{target.identity}}">{{target.identity}}</view>
            <view wx:if="{{target.workGroup}}">{{target.workGroup}}</view>
          </view>
        </view>
      </view>
      <view class="existing-record-tip" wx:if="{{hasExistingRecord}}">{{existingRecordText}}</view>
    </view>

    <view class="card question-section-card">
      <view class="section-heading-row">
        <view class="section-title section-title-flush">{{localeCopy.copy_ad5ba99be4}}</view>
        <view class="readonly-chip" wx:if="{{readOnly}}">{{localeCopy.historicalReadOnlyShort}}</view>
        <view class="editable-history-chip" wx:elif="{{existingRecordEditable}}">{{localeCopy.historicalEditableShort}}</view>
      </view>
      <view class="empty-text" wx:if="{{readOnly && questionList.length === 0}}">{{localeCopy.historicalRecordEmpty}}</view>
      <block wx:for="{{questionList}}" wx:key="id">
        <view class="template-chip" wx:if="{{item.showTemplateHeader}}">
          {{item.templateSortOrder}}. {{item.templateName}}
        </view>
        <view
          class="question-card {{!readOnly && !keyboardCollapsed && currentQuestionIndex === index ? 'question-card-current' : ''}} {{readOnly ? 'question-card-readonly' : ''}} ui-motion-card"
          id="question-{{index}}"
          data-index="{{index}}"
          bindtap="focusQuestion"
          hover-class="{{readOnly ? 'none' : 'ui-press-card'}}"
          hover-start-time="0"
          hover-stay-time="160"
         hover-stop-propagation="{{true}}">
          <view class="question-heading">
            <view class="question-index">{{index + 1}}</view>
            <view class="question-title">{{item.question}}</view>
            <view class="question-max-chip">{{item.maxValue}}{{localeCopy.copy_717083eab1}}</view>
          </view>
          <view class="question-meta" wx:if="{{item.scoreLabel}}">{{item.scoreLabel}}</view>
          <view class="question-meta">
            {{localeCopy.copy_c3ec61e536}}{{item.minValue}} - {{item.maxValue}} · {{localeCopy.copy_0e686e89bb}}{{item.startValue}} · {{localeCopy.copy_8e8047cbd6}}{{item.stepValue}}
          </view>

          <view class="score-display {{readOnly ? 'score-display-readonly' : ''}} ui-motion-chip" data-index="{{index}}" catchtap="focusQuestion" hover-class="{{readOnly ? 'none' : 'ui-press-chip'}}" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="score-display-value" wx:if="{{item.score !== ''}}">
              <text class="score-display-number">{{item.score}}</text>
              <text class="score-display-unit">{{localeCopy.copy_717083eab1}}</text>
            </view>
            <view class="score-display-placeholder" wx:else>{{readOnly ? localeCopy.historicalScoreUnavailable : localeCopy.copy_c30bcbbda9}}</view>
            <view class="score-display-indicator" wx:if="{{!readOnly && currentQuestionIndex === index}}">{{keyboardCollapsed ? localeCopy.copy_fa906e8178 : localeCopy.copy_ea2892fd15}}</view>
          </view>

          <view class="score-warning" wx:if="{{item.errorText}}">
            <text class="score-warning-icon">!</text>
            <text class="score-warning-text">{{item.errorText}}</text>
          </view>

          <view class="template-footer" wx:if="{{item.showTemplateFooter}}">
            <view class="template-footer-row">
              <text class="template-footer-label">{{localeCopy.copy_3e5a801039}}</text>
              <text class="template-footer-score">{{item.templateFooterScore}} / {{item.templateFooterMax}} {{localeCopy.copy_717083eab1}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="card" wx:if="{{!loading && !loadFailed && questionList.length > 0}}">
      <view class="section-title">{{localeCopy.copy_b3cbc0c509}}</view>
      <view class="summary-list" wx:if="{{templateSummaries.length > 1}}">
        <view class="summary-item" wx:for="{{templateSummaries}}" wx:key="templateId">
          <text class="summary-name">{{item.templateSortOrder}}. {{item.templateName}}</text>
          <text class="summary-score">{{item.totalScore}} / {{item.totalMax}} {{localeCopy.copy_717083eab1}}</text>
        </view>
      </view>
      <view class="summary-total">
        <text class="summary-total-label">{{localeCopy.copy_75113404bc}}</text>
        <text class="summary-total-score">{{pageTotalScore}} / {{pageTotalMax}} {{localeCopy.copy_717083eab1}}</text>
      </view>
    </view>

    <view class="page-submit-bar" wx:if="{{!readOnly && !loading && !loadFailed && questionList.length > 0}}">
      <button class="primary-btn page-submit-btn ui-motion-button" loading="{{submitting}}" bindtap="submitScore" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_4d39b37cc5}}</button>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">{{localeCopy.copy_aa4f0ed6cd}}</view>
    <view class="footer-org">{{localeCopy.copy_638da8ae60}}</view>
  </view>

  <!-- Keyboard: collapsed state -->
  <view class="custom-keyboard custom-keyboard-collapsed" wx:if="{{!readOnly && !loading && !loadFailed && questionList.length > 0 && keyboardCollapsed}}">
    <view class="kb-collapsed-bar ui-motion-chip" bindtap="expandKeyboard" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
      <text class="kb-collapsed-icon">⌨</text>
      <text class="kb-collapsed-text">{{localeCopy.copy_fa906e8178}}</text>
      <text class="kb-collapsed-arrow">▲</text>
    </view>
  </view>

  <!-- Keyboard: expanded state -->
  <view class="custom-keyboard" wx:if="{{!readOnly && !loading && !loadFailed && questionList.length > 0 && currentQuestion && !keyboardCollapsed}}">
    <view class="kb-nav-row">
      <view class="kb-nav-btn {{currentQuestionIndex === 0 ? 'kb-nav-btn-disabled' : ''}} {{physicalKeyActive === 'prev' ? 'kb-nav-btn-active' : ''}} ui-motion-chip" bindtap="goToPrevious" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
        <text class="kb-nav-arrow">◀</text>
        <text class="kb-nav-label">{{localeCopy.copy_e00c90cadd}}</text>
      </view>
      <view class="kb-nav-display">
        <view class="kb-nav-display-hint" wx:if="{{!currentQuestion.score}}">
          {{localeCopy.copy_ef8b7ffa9b}} {{currentQuestionIndex + 1}} {{localeCopy.copy_32ff7fb805}}
        </view>
        <view class="kb-nav-display-value" wx:else>
          <text class="kb-nav-display-number">{{currentQuestion.score}}</text>
          <text class="kb-nav-display-unit">{{localeCopy.copy_717083eab1}}</text>
        </view>
      </view>
      <view class="kb-nav-btn kb-nav-btn-next {{currentQuestionIndex >= questionList.length - 1 ? 'kb-nav-btn-disabled' : ''}} {{physicalKeyActive === 'next' ? 'kb-nav-btn-next-active' : ''}} ui-motion-chip" catchtap="goToNext" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
        <text class="kb-nav-label">{{localeCopy.copy_2699b9317a}}</text>
        <text class="kb-nav-arrow">▶</text>
      </view>
    </view>

    <view class="kb-action-row">
      <view class="kb-toggle-btn ui-motion-chip" bindtap="toggleKeyboardMode" wx:if="{{quickScoreRows.length > 0}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
        <view class="kb-toggle-switch">
          <view class="kb-toggle-track {{keyboardMode === 'quick' ? 'kb-toggle-track-on' : ''}}">
            <view class="kb-toggle-thumb {{keyboardMode === 'quick' ? 'kb-toggle-thumb-on' : ''}}"></view>
          </view>
        </view>
        <text class="kb-toggle-label">{{localeCopy.copy_acc0866449}}</text>
      </view>
      <view wx:else></view>

      <view class="kb-nav-btn kb-nav-btn-submit {{physicalKeyActive === 'submit' ? 'kb-nav-btn-submit-active' : ''}} ui-motion-chip" bindtap="submitScore" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
        <view class="kb-submit-inner" wx:if="{{submitting}}">
          <text class="kb-submit-spinner"></text>
        </view>
        <block wx:else>
          <text class="kb-nav-label">{{localeCopy.copy_e507a2cd28}}</text>
          <text class="kb-nav-arrow">✓</text>
        </block>
      </view>

      <view class="kb-collapse-btn ui-motion-chip" bindtap="collapseKeyboard" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
        <text class="kb-collapse-icon">▼ {{localeCopy.copy_8ec888d575}}</text>
      </view>
    </view>

    <scroll-view class="kb-quick-scroll" scroll-y wx:if="{{keyboardMode === 'quick' && quickScoreRows.length > 0}}">
      <view class="kb-quick-row" wx:for="{{quickScoreRows}}" wx:key="index" wx:for-item="row">
        <view
          class="kb-quick-btn ui-motion-chip"
          wx:for="{{row}}"
          wx:key="*this"
          wx:for-item="qs"
          data-value="{{qs}}"
          bindtap="onQuickScoreTap"
         hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{qs}}</view>
      </view>
    </scroll-view>

    <view class="kb-numpad" wx:if="{{keyboardMode === 'numpad'}}">
      <view class="kb-row">
        <view class="kb-key {{physicalKeyActive === '1' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="1" bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">1</view>
        <view class="kb-key {{physicalKeyActive === '2' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="2" bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">2</view>
        <view class="kb-key {{physicalKeyActive === '3' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="3" bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">3</view>
      </view>
      <view class="kb-row">
        <view class="kb-key {{physicalKeyActive === '4' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="4" bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">4</view>
        <view class="kb-key {{physicalKeyActive === '5' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="5" bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">5</view>
        <view class="kb-key {{physicalKeyActive === '6' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="6" bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">6</view>
      </view>
      <view class="kb-row">
        <view class="kb-key {{physicalKeyActive === '7' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="7" bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">7</view>
        <view class="kb-key {{physicalKeyActive === '8' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="8" bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">8</view>
        <view class="kb-key {{physicalKeyActive === '9' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="9" bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">9</view>
      </view>
      <view class="kb-row">
        <view class="kb-key {{physicalKeyActive === '.' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="." bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">.</view>
        <view class="kb-key {{physicalKeyActive === '0' ? 'kb-key-active' : ''}} ui-motion-chip" data-key="0" bindtap="onKeyboardTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">0</view>
        <view class="kb-key kb-key-backspace {{physicalKeyActive === 'backspace' ? 'kb-key-backspace-active' : ''}} ui-motion-chip" bindtap="onKeyboardBackspace" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <text class="kb-backspace-icon">⌫</text>
        </view>
      </view>
    </view>
  </view>
</view>

page {
  /* Expanded keyboard = navigation/action toolbars + the tallest score input panel. */
  --score-keyboard-toolbar-reserve: 160rpx;
  --score-keyboard-content-reserve: 420rpx;
  --score-keyboard-reserve: calc(var(--score-keyboard-toolbar-reserve) + var(--score-keyboard-content-reserve));
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.physical-keyboard-capture {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 2rpx;
  opacity: 0;
  pointer-events: none;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: var(--ui-page-padding-top, 30rpx) var(--ui-page-padding-x, 24rpx) calc(var(--ui-page-padding-bottom, 42rpx) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-with-keyboard {
  padding-bottom: calc(var(--ui-page-padding-bottom, 42rpx) + var(--score-keyboard-reserve) + env(safe-area-inset-bottom));
}

.hero,
.card {
  position: relative;
  border-radius: 32rpx;
  box-sizing: border-box;
  transition: transform 0.18s ease, box-shadow 0.24s ease, border-color 0.24s ease;
}

.hero {
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 44rpx 34rpx 40rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.98) 0%, rgba(59, 130, 246, 0.95) 42%, rgba(96, 165, 250, 0.90) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 24rpx 54rpx rgba(37, 99, 235, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  color: #fff;
  animation: glassFadeUp 0.42s ease both;
}

.hero::before {
  content: "";
  position: absolute;
  top: -90rpx;
  right: -35rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.hero::after {
  content: "";
  position: absolute;
  left: -90rpx;
  bottom: -120rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-badge,
.hero-title,
.hero-subtitle {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  padding: 10rpx 24rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.14) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #f8fbff;
  font-size: var(--ui-type-meta);
  font-weight: 600;
  letter-spacing: 1rpx;
  backdrop-filter: blur(14rpx);
  -webkit-backdrop-filter: blur(14rpx);
}

.hero-title {
  color: #ffffff;
  font-size: var(--ui-type-page);
  font-weight: 700;
  line-height: 1.24;
  letter-spacing: 1rpx;
  text-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--ui-type-emphasis);
  line-height: 1.72;
}

.target-sticky {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.84) 0%, rgba(239, 246, 255, 0.76) 100%);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(147, 197, 253, 0.42);
  box-shadow:
    0 8rpx 24rpx rgba(37, 99, 235, 0.10),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  transform: translateY(-100%);
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
}

.target-sticky-show {
  transform: translateY(0);
}

.target-sticky-label {
  color: #64748b;
  font-size: var(--ui-type-control);
  margin-right: 16rpx;
}

.target-sticky-name {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: var(--ui-type-emphasis);
  font-weight: 700;
  white-space: normal;
  overflow-wrap: anywhere;
}

.card {
  margin-bottom: var(--ui-card-gap, 24rpx);
  padding: var(--ui-card-padding-y, 28rpx) var(--ui-card-padding-x, 26rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.80) 0%, rgba(248, 251, 255, 0.72) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow:
    0 18rpx 36rpx rgba(15, 23, 42, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  animation: glassFadeUp 0.48s ease both;
}

.section-title {
  position: relative;
  padding-left: var(--ui-section-title-inset, 20rpx);
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-weight: 700;
  margin-bottom: var(--ui-field-gap, 16rpx);
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  transform: translateY(-50%);
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
}

.section-heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-inline-gap, 12rpx);
  margin-bottom: var(--ui-field-gap, 16rpx);
}

.section-title-flush {
  min-width: 0;
  margin-bottom: 0;
}

.readonly-chip {
  flex-shrink: 0;
  padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  border: 1rpx solid rgba(148, 163, 184, 0.48);
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(241, 245, 249, 0.96), rgba(226, 232, 240, 0.78));
  color: #475569;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-block {
  flex: 1 1 0;
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(248, 251, 255, 0.80) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  box-sizing: border-box;
  text-align: center;
  transition: transform 0.18s ease, box-shadow 0.24s ease, border-color 0.24s ease, background 0.24s ease;
}

.info-block-full {
  width: 100%;
  flex: 0 0 100%;
}

.info-label,
.question-meta,
.empty-text {
  color: #64748b;
  font-size: var(--ui-type-meta);
  line-height: 1.72;
  white-space: pre-wrap;
}

.info-value {
  margin-top: 6rpx;
  color: #0f172a;
  font-size: var(--ui-type-value);
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.info-subvalue {
  margin-top: 4rpx;
  color: #64748b;
  font-size: var(--ui-type-micro);
  line-height: 1.45;
  white-space: pre-wrap;
  text-align: center;
}

.question-card {
  margin-bottom: var(--ui-list-gap, 14rpx);
  padding: var(--ui-list-padding-y, 22rpx) var(--ui-list-padding-x, 20rpx);
  border-radius: var(--ui-list-radius, 20rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(249, 251, 255, 0.82) 100%);
  border: 1rpx solid rgba(226, 237, 247, 0.96);
  box-shadow:
    0 12rpx 24rpx rgba(15, 23, 42, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  transition: transform 0.18s ease, box-shadow 0.24s ease, border-color 0.24s ease;
  animation: glassFadeUp 0.52s ease both;
}

.question-card:last-child {
  margin-bottom: 0;
}

.question-card-current {
  border-color: rgba(37, 99, 235, 0.55);
  box-shadow:
    0 12rpx 28rpx rgba(37, 99, 235, 0.12),
    0 0 0 4rpx rgba(191, 219, 254, 0.52),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
}

.question-heading {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.question-index,
.question-max-chip {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border: 1rpx solid rgba(147, 197, 253, 0.52);
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.98), rgba(219, 234, 254, 0.76));
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
}

.question-title {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: var(--ui-type-body);
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: break-word;
}

.template-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.98) 0%, rgba(219, 234, 254, 0.90) 100%);
  color: #2563eb;
  font-size: var(--ui-type-meta);
  font-weight: 700;
}

/* Score display (replaces input) */
.score-display {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(239, 246, 255, 0.70) 100%);
  border: 1rpx solid rgba(147, 197, 253, 0.50);
  box-shadow:
    0 10rpx 22rpx rgba(37, 99, 235, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  min-height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}

.score-display:active {
  transform: translateY(1rpx) scale(0.992);
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.14),
    0 8rpx 20rpx rgba(37, 99, 235, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.question-card-current .score-display {
  border-color: rgba(96, 165, 250, 0.8);
  box-shadow:
    0 10rpx 24rpx rgba(37, 99, 235, 0.08),
    0 0 0 3rpx rgba(191, 219, 254, 0.44);
}

.score-display-value {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.score-display-number {
  color: #0f172a;
  font-size: var(--ui-type-value);
  font-weight: 700;
  line-height: 1.2;
}

.score-display-unit {
  color: #64748b;
  font-size: var(--ui-type-control);
  font-weight: 500;
}

.score-display-placeholder {
  color: #94a3b8;
  font-size: var(--ui-type-body);
}

.score-display-indicator {
  margin-left: auto;
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  background: rgba(219, 234, 254, 0.7);
  white-space: nowrap;
}

.score-display-readonly {
  background: linear-gradient(135deg, rgba(248, 250, 252, 0.92), rgba(241, 245, 249, 0.78));
  border-color: rgba(203, 213, 225, 0.64);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
}

.score-display-readonly:active {
  transform: none;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
}

.score-warning {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(254, 242, 242, 0.96) 0%, rgba(254, 226, 226, 0.88) 100%);
  border: 1rpx solid rgba(252, 165, 165, 0.76);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82),
    0 8rpx 18rpx rgba(239, 68, 68, 0.08);
}

.score-warning-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #fff;
  font-size: var(--ui-type-micro);
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}

.score-warning-text {
  color: #b91c1c;
  font-size: var(--ui-type-meta);
  line-height: 1.6;
}

/* Template footer (per-template subtotal) */
.template-footer {
  margin-top: 18rpx;
}

.template-footer-divider {
  height: 0;
  margin: 0;
}

.template-footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-inline-gap, 12rpx);
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.8) 0%, rgba(219, 234, 254, 0.5) 100%);
  border: 1rpx solid rgba(147, 197, 253, 0.3);
}

.template-footer-label {
  flex-shrink: 0;
  color: #2563eb;
  font-size: var(--ui-type-label);
  font-weight: 600;
  white-space: nowrap;
}

.template-footer-score {
  min-width: 0;
  color: #2563eb;
  font-size: var(--ui-type-emphasis);
  font-weight: 700;
  letter-spacing: 0.5rpx;
  text-align: right;
  white-space: nowrap;
}

/* Page summary card */
.summary-list {
  margin-bottom: 8rpx;
}

.summary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  margin-bottom: 8rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.7) 0%, rgba(248, 250, 252, 0.5) 100%);
  border: 1rpx solid rgba(226, 232, 240, 0.5);
}

.summary-name {
  flex: 1;
  min-width: 0;
  color: #334155;
  font-size: var(--ui-type-body);
  font-weight: 500;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.summary-score {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #2563eb;
  font-size: var(--ui-type-emphasis);
  font-weight: 700;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

.summary-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(59, 130, 246, 0.05) 100%);
  border: 1rpx solid rgba(37, 99, 235, 0.18);
  margin-top: 4rpx;
}

.summary-total-label {
  color: #0f172a;
  font-size: var(--ui-type-emphasis);
  font-weight: 700;
}

.summary-total-score {
  color: #2563eb;
  font-size: var(--ui-type-value);
  font-weight: 700;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

/* Page submit button */
.page-submit-bar {
  margin: 0 0 var(--ui-card-gap, 24rpx);
  padding: 0;
}

.load-error-card {
  text-align: left;
}

.load-error-text {
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(191, 219, 254, 0.78);
  border-radius: var(--ui-list-radius, 20rpx);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.92), rgba(248, 251, 255, 0.84));
  color: #475569;
  font-size: var(--ui-type-control);
  line-height: 1.7;
}

.load-error-action {
  width: 100%;
  margin-top: 20rpx;
}

.assignment-chip {
  display: inline-flex;
  max-width: 100%;
  margin-top: 8rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(147, 197, 253, 0.58);
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.96), rgba(219, 234, 254, 0.82));
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.45;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
  box-sizing: border-box;
}

.page-submit-btn {
  width: 100%;
  min-height: var(--ui-control-height, 82rpx);
  height: auto;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  line-height: 1.35;
  box-sizing: border-box;
  border-radius: var(--ui-control-radius, 28rpx);
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  border: 1rpx solid rgba(147, 197, 253, 0.58);
  color: #fff;
  font-size: var(--ui-type-section);
  font-weight: 700;
  box-shadow:
    0 16rpx 32rpx rgba(37, 99, 235, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
  transition: transform 0.14s ease, box-shadow 0.24s ease, opacity 0.18s ease;
}

.page-submit-btn:active {
  transform: translateY(1rpx) scale(0.992);
  box-shadow:
    0 0 0 5rpx rgba(37, 99, 235, 0.18),
    0 8rpx 20rpx rgba(37, 99, 235, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.record-unavailable-tip {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.96) 0%, rgba(255, 237, 213, 0.84) 100%);
  border: 1rpx solid rgba(253, 186, 116, 0.68);
  color: #9a3412;
  font-size: var(--ui-type-control);
  line-height: 1.68;
}

/* ============================================
   Custom Keyboard
   ============================================ */
.custom-keyboard {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background:
    linear-gradient(135deg, rgba(239, 246, 255, 0.82) 0%, rgba(219, 234, 254, 0.66) 100%);
  border-top: 1rpx solid rgba(147, 197, 253, 0.58);
  box-shadow:
    0 -18rpx 42rpx rgba(37, 99, 235, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
  padding-bottom: env(safe-area-inset-bottom);
}

/* Navigation row */
.kb-nav-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 10rpx 6rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.46) 0%, rgba(239, 246, 255, 0.36) 100%);
}

/* Action row (toggle / submit / collapse) */
.kb-action-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 10rpx 10rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.46) 0%, rgba(239, 246, 255, 0.36) 100%);
  border-bottom: 1rpx solid rgba(147, 197, 253, 0.34);
}

.kb-action-row > view:first-child {
  flex: 0 0 210rpx;
  display: flex;
  align-items: center;
}

.kb-action-row .kb-nav-btn-submit {
  flex: 1;
  max-width: 280rpx;
  margin: 0 auto;
}

.kb-action-row > view:last-child {
  flex: 0 0 138rpx;
}

.kb-nav-btn {
  flex: 0 0 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 64rpx;
  border-radius: var(--ui-control-radius, 28rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.90) 0%, rgba(239, 246, 255, 0.72) 100%);
  border: 1rpx solid rgba(147, 197, 253, 0.52);
  box-shadow:
    0 8rpx 18rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  transition: transform 0.12s ease, opacity 0.12s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.kb-nav-btn-submit {
  flex: 0 0 104rpx;
}

.kb-nav-btn:active {
  transform: translateY(1rpx) scale(0.975);
  opacity: 0.88;
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.16),
    0 6rpx 16rpx rgba(37, 99, 235, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.kb-nav-btn-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.kb-nav-btn-active {
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.20),
    0 8rpx 20rpx rgba(37, 99, 235, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  transform: scale(0.95);
}

.kb-nav-btn-next-active {
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.30),
    0 8rpx 22rpx rgba(37, 99, 235, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  transform: scale(0.95);
}

.kb-nav-btn-submit-active {
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.30),
    0 8rpx 22rpx rgba(37, 99, 235, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  transform: scale(0.95);
}

.kb-nav-btn-next {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  border-color: rgba(147, 197, 253, 0.56);
  box-shadow:
    0 10rpx 22rpx rgba(37, 99, 235, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
}

.kb-nav-btn-submit {
  flex: 0 0 104rpx;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  border-color: rgba(147, 197, 253, 0.56);
  box-shadow:
    0 10rpx 22rpx rgba(37, 99, 235, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
}

.kb-nav-arrow {
  font-size: var(--ui-type-meta);
  color: #475569;
}

.kb-nav-btn-next .kb-nav-arrow,
.kb-nav-btn-submit .kb-nav-arrow {
  color: #fff;
}

.kb-nav-label {
  font-size: var(--ui-type-meta);
  font-weight: 600;
  color: #334155;
}

.kb-nav-btn-next .kb-nav-label,
.kb-nav-btn-submit .kb-nav-label {
  color: #fff;
}

.kb-nav-display {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(239, 246, 255, 0.64) 100%);
  border: 1rpx solid rgba(147, 197, 253, 0.44);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82),
    0 6rpx 16rpx rgba(37, 99, 235, 0.06);
  min-width: 0;
}

.kb-nav-display-hint {
  color: #94a3b8;
  font-size: var(--ui-type-control);
}

.kb-nav-display-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.kb-nav-display-number {
  color: #0f172a;
  font-size: var(--ui-type-dialog);
  font-weight: 700;
  line-height: 1.2;
}

.kb-nav-display-unit {
  color: #64748b;
  font-size: var(--ui-type-caption);
}

/* Quick scores row */
.kb-quick-row {
  display: flex;
  gap: 10rpx;
  padding: 8rpx 12rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.34) 0%, rgba(239, 246, 255, 0.26) 100%);
}

.kb-quick-row:first-child {
  padding-top: 10rpx;
}

.kb-quick-row:last-child {
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(147, 197, 253, 0.30);
}

.kb-quick-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 1;
  min-width: 56rpx;
  min-height: 78rpx;
  height: auto;
  padding: 18rpx 8rpx;
  line-height: 1.35;
  text-align: center;
  border-radius: var(--ui-control-radius, 28rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.90) 0%, rgba(219, 234, 254, 0.66) 100%);
  border: 1rpx solid rgba(147, 197, 253, 0.55);
  color: #2563eb;
  font-size: var(--ui-type-meta);
  font-weight: 700;
  box-shadow:
    0 8rpx 18rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  transition: transform 0.12s ease, opacity 0.12s ease, box-shadow 0.18s ease, background 0.18s ease;
  white-space: normal;
  overflow-wrap: anywhere;
}

.kb-quick-btn:active {
  transform: scale(0.94);
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.96) 0%, rgba(191, 219, 254, 0.82) 100%);
  color: #2563eb;
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.16),
    0 8rpx 18rpx rgba(37, 99, 235, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

/* Number pad */
.kb-numpad {
  padding: 8rpx 10rpx;
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.44) 0%, rgba(191, 219, 254, 0.28) 100%);
}

.kb-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.kb-row:last-child {
  margin-bottom: 0;
}

.kb-key {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(248, 251, 255, 0.76) 100%);
  color: #0f172a;
  font-size: var(--ui-type-dialog);
  font-weight: 600;
  box-shadow:
    0 8rpx 18rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(147, 197, 253, 0.34);
  transition: transform 0.1s ease, background 0.1s ease, box-shadow 0.16s ease;
}

.kb-key:active {
  transform: translateY(2rpx) scale(0.96);
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.94) 0%, rgba(191, 219, 254, 0.78) 100%);
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.14),
    0 6rpx 16rpx rgba(37, 99, 235, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.kb-key-backspace {
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.88) 0%, rgba(191, 219, 254, 0.70) 100%);
  color: #2563eb;
}

.kb-key-backspace:active {
  background: linear-gradient(135deg, rgba(191, 219, 254, 0.96) 0%, rgba(147, 197, 253, 0.78) 100%);
}

.kb-key-active {
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.98) 0%, rgba(191, 219, 254, 0.84) 100%);
  color: #2563eb;
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.16),
    0 8rpx 18rpx rgba(37, 99, 235, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
  transform: scale(0.94);
}

.kb-key-backspace-active {
  background: linear-gradient(135deg, rgba(191, 219, 254, 0.96) 0%, rgba(147, 197, 253, 0.78) 100%);
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.16),
    0 8rpx 18rpx rgba(37, 99, 235, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
  transform: scale(0.94);
}

.kb-key-backspace-active .kb-backspace-icon {
  color: #1e293b;
}

.kb-backspace-icon {
  font-size: var(--ui-type-dialog);
  color: #475569;
}

/* Final keyboard motion: tactile without harsh snapping. */
.kb-quick-btn:active,
.kb-key:active,
.kb-key-active,
.kb-key-backspace-active {
  transform: translate3d(0, 2rpx, 0) scale(0.984) !important;
  transition:
    transform 0.16s cubic-bezier(0.2, 0.78, 0.22, 1),
    box-shadow 0.18s ease,
    background 0.18s ease !important;
}

/* Collapse button */
.kb-collapse-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: var(--ui-control-radius, 28rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72) 0%, rgba(219, 234, 254, 0.54) 100%);
  border: 1rpx solid rgba(147, 197, 253, 0.42);
  box-shadow:
    0 8rpx 18rpx rgba(37, 99, 235, 0.07),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  transition: transform 0.12s ease, opacity 0.12s ease, box-shadow 0.18s ease;
}

.kb-collapse-btn:active {
  transform: translateY(1rpx) scale(0.95);
  opacity: 0.7;
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.14),
    0 6rpx 16rpx rgba(37, 99, 235, 0.12);
}

.kb-collapse-icon {
  font-size: var(--ui-type-caption);
  color: #64748b;
  white-space: nowrap;
}

/* Keyboard mode toggle button */
.kb-toggle-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 12rpx;
  border-radius: var(--ui-control-radius, 28rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.90) 0%, rgba(239, 246, 255, 0.72) 100%);
  border: 1rpx solid rgba(147, 197, 253, 0.52);
  box-shadow:
    0 8rpx 18rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  transition: transform 0.12s ease, opacity 0.12s ease, box-shadow 0.18s ease;
}

.kb-toggle-btn:active {
  transform: translateY(1rpx) scale(0.95);
  opacity: 0.8;
  box-shadow:
    0 0 0 4rpx rgba(37, 99, 235, 0.14),
    0 6rpx 16rpx rgba(37, 99, 235, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.kb-toggle-switch {
  flex-shrink: 0;
}

.kb-toggle-track {
  width: 52rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(203, 213, 225, 0.74) 0%, rgba(226, 237, 247, 0.84) 100%);
  position: relative;
  transition: background 0.2s ease;
}

.kb-toggle-track-on {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 0 12rpx rgba(37, 99, 235, 0.22);
}

.kb-toggle-thumb {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(239, 246, 255, 0.92) 100%);
  box-shadow: 0 2rpx 6rpx rgba(37, 99, 235, 0.20);
  transition: transform 0.2s ease;
}

.kb-toggle-thumb-on {
  transform: translateX(22rpx);
}

.kb-toggle-label {
  font-size: var(--ui-type-meta);
  font-weight: 600;
  color: #475569;
  white-space: nowrap;
}

/* Quick score scrollable container */
.kb-quick-scroll {
  max-height: 420rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.30) 0%, rgba(239, 246, 255, 0.24) 100%);
  border-bottom: 1rpx solid rgba(147, 197, 253, 0.30);
}

/* Collapsed keyboard bar */
.custom-keyboard-collapsed {
  padding: 0;
}

.kb-collapsed-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.76) 0%, rgba(219, 234, 254, 0.60) 100%);
  border-top: 1rpx solid rgba(147, 197, 253, 0.54);
  box-shadow:
    0 -10rpx 28rpx rgba(37, 99, 235, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.kb-collapsed-icon {
  font-size: var(--ui-type-value);
}

.kb-collapsed-text {
  font-size: var(--ui-type-control);
  color: #475569;
  font-weight: 600;
}

.kb-collapsed-arrow {
  font-size: var(--ui-type-caption);
  color: #94a3b8;
}

/* Submit loading spinner */
.kb-submit-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.kb-submit-spinner {
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: kbSpin 0.7s linear infinite;
}

@keyframes kbSpin {
  to { transform: rotate(360deg); }
}

@keyframes glassFadeUp {
  from {
    opacity: 0;
    transform: translateY(22rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ═══ 平板竖屏适配（≥520px）═══ */
/* 评分页不 import home.wxss，需独立添加平板约束 */
@media (min-width: 520px) {
  page {
    /* 94px toolbars + 216px quick-score panel at Pad density. */
    --score-keyboard-toolbar-reserve: 94px;
    --score-keyboard-content-reserve: 216px;
  }

  .page {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    justify-content: stretch;
    gap: 16px;
  }

  .info-block {
    width: auto;
    max-width: none;
  }

  .info-block-full {
    grid-column: 1 / -1;
  }

  .template-title,
  .section-title {
    font-size: var(--ui-type-section) !important;
    line-height: 1.45 !important;
  }

  .question-title {
    font-size: var(--ui-type-body) !important;
    line-height: 1.45 !important;
  }

  .info-value,
  .target-name {
    font-size: var(--ui-type-emphasis) !important;
    line-height: 1.5 !important;
  }

  .question-desc,
  .template-desc,
  .score-display-label {
    font-size: var(--ui-type-label) !important;
    line-height: 1.55 !important;
  }

  .info-label,
  .question-meta,
  .template-meta {
    font-size: var(--ui-type-meta) !important;
    line-height: 1.55 !important;
  }

  .target-sticky {
    height: auto;
    min-height: 52px;
    padding: 10px 24px;
  }

  .target-sticky-label {
    flex-shrink: 0;
    margin-right: 10px;
    font-size: var(--ui-type-meta);
  }

  .target-sticky-name {
    font-size: var(--ui-type-body);
    line-height: 20px;
  }

  .summary-name {
    font-size: var(--ui-type-body);
  }

  .summary-score,
  .template-footer-score {
    font-size: var(--ui-type-emphasis);
  }

  .summary-total-label {
    font-size: var(--ui-type-emphasis);
  }

  .summary-total-score {
    font-size: var(--ui-type-value);
  }

  .kb-nav-row {
    gap: 6px;
    padding: 8px 8px 5px;
  }

  .kb-action-row {
    gap: 6px;
    padding: 5px 8px 8px;
  }

  .kb-action-row > view:first-child {
    flex: 0 1 150px;
    min-width: 0;
  }

  .kb-action-row .kb-nav-btn-submit {
    max-width: 220px;
  }

  .kb-action-row > view:last-child {
    flex: 0 0 96px;
  }

  .kb-nav-btn {
    flex-basis: 100px;
    height: 44px;
    gap: 3px;
    border-radius: 14px;
  }

  .kb-nav-btn-submit {
    flex-basis: 84px;
  }

  .kb-nav-display {
    height: 44px;
    border-radius: 12px;
  }

  .kb-nav-label,
  .kb-nav-arrow,
  .kb-nav-display-hint {
    font-size: var(--ui-type-meta);
    line-height: 18px;
    white-space: nowrap;
  }

  .kb-nav-display-number {
    font-size: var(--ui-type-dialog);
  }

  .kb-nav-display-unit {
    font-size: var(--ui-type-caption);
  }

  .kb-quick-row {
    gap: 6px;
    padding: 6px 8px;
  }

  .kb-quick-row:first-child {
    padding-top: 6px;
  }

  .kb-quick-row:last-child {
    padding-bottom: 6px;
  }

  .kb-quick-btn {
    min-width: 44px;
    min-height: 44px;
    height: auto;
    padding: 10px 8px;
    line-height: 1.35;
    border-radius: 14px;
    font-size: var(--ui-type-label);
  }

  .kb-numpad {
    padding: 6px 8px 8px;
  }

  .kb-row {
    gap: 6px;
    margin-bottom: 6px;
  }

  .kb-key {
    height: 52px;
    line-height: 52px;
    border-radius: 12px;
    font-size: var(--ui-type-dialog);
  }

  .kb-backspace-icon {
    font-size: var(--ui-type-page);
  }

  .kb-collapse-btn,
  .kb-toggle-btn {
    height: 44px;
    border-radius: 14px;
  }

  .kb-toggle-btn {
    gap: 6px;
    padding: 0 10px;
  }

  .kb-toggle-label,
  .kb-collapse-icon {
    font-size: var(--ui-type-meta);
    line-height: 18px;
    white-space: nowrap;
  }
}

@media (min-width: 900px) {
  page {
    --score-keyboard-toolbar-reserve: 0px;
    --score-keyboard-content-reserve: 0px;
  }

  .assignment-chip {
    margin-top: 6px;
    padding: 4px 10px;
    border-radius: 12px;
  }

  .page.page-with-keyboard {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    align-items: start;
    gap: var(--ui-card-gap, 16px);
    max-width: 1180px;
    padding: var(--ui-page-padding-top, 22px) var(--ui-page-padding-x, 28px) calc(var(--ui-page-padding-bottom, 30px) + env(safe-area-inset-bottom));
  }

  .page-with-keyboard > .hero,
  .page-with-keyboard > .workspace-hero-host,
  .page-with-keyboard > .target-sticky {
    grid-column: 1 / -1;
  }

  .page-with-keyboard > .workspace-hero-host {
    margin-bottom: 0;
  }

  .page-with-keyboard > .score-workspace,
  .page-with-keyboard > .page-footer,
  .page-with-keyboard > .card {
    grid-column: 1;
    min-width: 0;
  }

  .page-with-keyboard > .custom-keyboard {
    position: sticky;
    grid-column: 2;
    grid-row: 2 / span 4;
    top: 24px;
    left: auto;
    right: auto;
    bottom: auto;
    width: 100%;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    border: 1px solid rgba(147, 197, 253, 0.52);
    border-radius: 24px;
    box-shadow: 0 22px 48px rgba(37, 99, 235, 0.13), inset 0 1px 0 rgba(255, 255, 255, 0.78);
  }

  .page-with-keyboard > .custom-keyboard .kb-collapsed-bar {
    border-radius: 24px;
  }

  .kb-quick-row {
    gap: 5px;
    padding: 5px 6px;
  }

  .kb-quick-row:first-child {
    padding-top: 5px;
  }

  .kb-quick-row:last-child {
    padding-bottom: 5px;
  }

  .kb-quick-btn {
    min-width: 40px;
    min-height: 40px;
    height: auto;
    padding: 8px 6px;
    border-radius: 12px;
    font-size: var(--ui-type-label);
    line-height: 1.35;
  }
}

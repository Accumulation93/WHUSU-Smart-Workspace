            <view class="result-col result-col-popup-status ui-data-cell">状态</view>
          </view>
          <view class="result-table-row {{item.status === 'submitted' ? 'result-table-row-clickable' : ''}} ui-motion-chip ui-data-row" wx:for="{{scorerTargetPopupRows}}" wx:key="targetId" data-record-id="{{item.recordId}}" catchtap="openScorerTargetRecordDetail" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="result-col result-col-target-name ui-data-cell ui-data-cell--primary">
              <text class="ui-data-cell-label">被评人</text>
              <view class="ui-data-cell-content"><view class="result-name">{{item.targetName}}</view><view class="result-meta">{{item.targetStudentId}}</view></view>
            </view>
            <view class="result-col result-col-target-detail ui-data-cell">
              <text class="ui-data-cell-label">具体信息</text>
              <view class="result-meta result-meta-strong ui-data-cell-content">{{item.detailText}}</view>
            </view>
            <view class="result-col result-col-popup-status ui-data-cell">
              <text class="ui-data-cell-label">状态</text>
              <view class="status-chip {{item.statusClass}}">{{item.statusText}}</view>
            </view>
          </view>
        </view>
        <view class="empty-inline" wx:if="{{!scorerTargetPopupRows.length}}">该评分人暂无待评任务。</view>
      </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">WHUSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>

  <view class="popup-mask ui-overlay" wx:if="{{recordDetailPopupVisible}}" bindtap="closeScoreRecordDetail" catchtouchmove="noop">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card completion-popup-card ui-dialog-shell ui-dialog-shell--wide" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">评分详情</view>
        <text class="popup-close ui-motion-chip" catchtap="closeScoreRecordDetail" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-scroll--fill" scroll-y wx:if="{{recordDetail}}">
        <view class="list-item detail-summary-card">
          <view class="list-main">
            <view class="detail-people-row">
              <view class="detail-person-block">
                <view class="detail-person-label">评分人</view>
                <view class="detail-person-name">{{recordDetail.scorer.name}}</view>
              </view>
              <view class="detail-person-divider"></view>
              <view class="detail-person-block">
                <view class="detail-person-label">被评分人</view>
                <view class="detail-person-name">{{recordDetail.target.name}}</view>
              </view>
            </view>
            <view class="list-desc">{{recordDetail.submittedAt}}</view>
            <view class="detail-action-row">
              <button
                wx:if="{{canRevokeScoreRecords}}"
                class="secondary-btn compact-action-btn revoke-score-btn ui-motion-button"
                data-id="{{recordDetail.recordId}}"
                catchtap="revokeScoreRecord"
               hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">撤销这条评分</button>
            </view>
          </view>
        </view>
        <view class="question-card" wx:for="{{recordDetail.templates}}" wx:for-index="templateIndex" wx:key="templateId">
          <view class="question-title">{{item.templateName}}</view>
          <view class="detail-tag-row">
            <view class="score-tag score-tag-template">模板得分 {{item.score}}</view>
            <view class="score-tag score-tag-weight">权重 {{item.weight}}</view>
            <view class="score-tag score-tag-weighted">加权 {{item.weightedScore}}</view>
          </view>
          <view class="detail-question compact-question" wx:for="{{item.questions}}" wx:for-item="question" wx:for-index="questionIndex" wx:key="questionIndex">
            <view class="compact-question-head">
              <view class="list-name detail-question-title">{{question.question}}</view>
              <view class="question-score-corner">{{question.score}} / {{question.maxValue}}</view>
            </view>
            <view
              class="score-label-toggle ui-motion-chip"
              wx:if="{{question.hasScoreLabel}}"
              data-template-index="{{templateIndex}}"
              data-question-index="{{questionIndex}}"
              catchtap="toggleScoreLabel"
             hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
              {{question.scoreLabelExpanded ? '收起评分说明' : '查看评分说明'}}
            </view>
            <view class="score-label-box" wx:if="{{question.hasScoreLabel && question.scoreLabelExpanded}}">{{question.scoreLabel}}</view>
          </view>
        </view>
      </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
      <view class="card-loading-overlay" wx:if="{{!recordDetail}}">
        <view class="card-loading-spinner"></view>
      </view>
    </view>
  </view>

    <view class="modal-mask ui-overlay" wx:if="{{contextSwitchGuardVisible}}" bindtap="closeContextSwitchGuard" catchtouchmove="noop">
      <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="modal-card context-switch-guard-card ui-dialog-shell ui-dialog-shell--compact" catchtap="noop">
      <view class="context-switch-guard-icon"><ui-icon name="edit" tone="primary" size="34" ariaLabel="未保存内容" /></view>
      <view class="context-switch-guard-title">请先保存修改</view>
      <view class="context-switch-guard-desc">保存或取消编辑后，即可切换组织与身份。</view>
      <view class="context-switch-guard-actions ui-dialog-footer">
        <button class="primary-btn ui-motion-button" bindtap="closeContextSwitchGuard" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">继续编辑</button>
      </view>
    </view>
  </view>

    <view class="modal-mask ui-overlay identity-action-confirm-overlay" wx:if="{{identityActionConfirmVisible}}" bindtap="closeIdentityActionConfirm" catchtouchmove="noop">
      <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="modal-card identity-action-confirm-card ui-dialog-shell ui-dialog-shell--compact" catchtap="noop">
      <view class="context-switch-guard-title">{{identityActionConfirmTitle}}</view>
      <view class="context-switch-guard-desc">{{identityActionConfirmText}}</view>
      <view class="button-row identity-action-confirm-actions ui-dialog-footer">
        <button class="secondary-btn ui-motion-button" catchtap="closeIdentityActionConfirm" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">取消</button>
        <button class="danger-btn ui-motion-button" catchtap="confirmIdentityAction" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">确认</button>
      </view>
    </view>
  </view>

    <view class="modal-mask ui-overlay" wx:if="{{adminDeleteConfirmVisible}}" bindtap="closeAdminDeleteConfirm" catchtouchmove="noop">
      <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="modal-card identity-action-confirm-card ui-dialog-shell ui-dialog-shell--compact" catchtap="noop">
      <view class="modal-title">删除管理员</view>
      <view class="modal-desc">{{adminDeleteConfirmName ? '将删除“' + adminDeleteConfirmName + '”的管理身份。' : '将删除该管理身份。'}}</view>
      <view class="button-row identity-action-confirm-actions ui-dialog-footer">
        <button class="secondary-btn ui-motion-button" catchtap="closeAdminDeleteConfirm" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">取消</button>
        <button class="danger-btn ui-motion-button" catchtap="confirmDeleteAdmin" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">删除</button>
      </view>
    </view>
  </view>

</view>

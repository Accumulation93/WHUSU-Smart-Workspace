              <view class="list-name">{{item.title || item.submissionNumber}}</view>
              <view class="chip-row">
                <view class="status-chip {{item.status === 'approved' ? 'green-chip' : (item.status === 'rejected' ? 'red-chip' : (item.status === 'in_progress' ? 'blue-chip' : ''))}}">{{item.status === 'draft' ? '草稿' : (item.status === 'pending' ? '待提交' : (item.status === 'in_progress' ? '审核中' : (item.status === 'rejected' ? '已驳回' : (item.status === 'approved' ? '已完成' : '已撤回'))))}}</view>
                <text class="list-desc">{{item.submissionNumber}} · {{item.submitterName}} · {{item.createdAt}}</text>
              </view>
            </view>
            <view class="list-actions">
              <text class="link" data-id="{{item.id}}" bindtap="viewAuditProgress">查看进度</text>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!auditSubmissions.length}}">暂无审核记录。</view>
          </block>
        </scroll-view>
      </view>

      <!-- Progress detail popup -->
      <view class="popup-mask" wx:if="{{auditSubmissionDetailVisible}}" bindtap="closeAuditSubmissionDetail">
        <view class="popup-card" catchtap="noop" style="max-height: 85vh;">
          <view class="popup-header"><view class="popup-title">审核进度</view><text class="popup-close" bindtap="closeAuditSubmissionDetail">关闭</text></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y wx:if="{{auditSubmissionDetail}}">
            <view class="card-loading-overlay" wx:if="{{loadingMap.auditProgress}}"><view class="card-loading-spinner"></view></view>
            <block wx:else>
            <view class="list-item">
              <view class="list-main">
                <view class="list-name">{{auditSubmissionDetail.submission.title}}</view>
                <view class="list-desc">{{auditSubmissionDetail.submission.submissionNumber}} · {{auditSubmissionDetail.submission.submitterName}}</view>
              </view>
            </view>
            <view class="list-title">审批步骤</view>
            <view class="list-item" wx:for="{{auditSubmissionDetail.steps}}" wx:key="id">
              <view class="list-main">
                <view class="list-name">第{{item.sortOrder}}步 {{item.approverName}} ({{item.actionType === 'sign' ? '签字' : (item.actionType === 'estamp' ? '盖章' : '签字+盖章')}})</view>
                <view class="chip-row">
                  <view class="status-chip {{item.status === 'approved' ? 'green-chip' : (item.status === 'rejected' ? 'red-chip' : '')}}">{{item.status === 'pending' ? '待处理' : (item.status === 'approved' ? '已通过' : '已驳回')}}</view>
                  <text class="list-desc" wx:if="{{item.processedAt}}">{{item.processedAt}}</text>
                </view>
                <view class="list-desc" wx:if="{{item.comment}}">{{item.comment}}</view>
                <view class="list-desc danger-text" wx:if="{{item.rejectionReason}}">驳回理由：{{item.rejectionReason}}</view>
              </view>
            </view>
            <view class="list-title" wx:if="{{auditSubmissionDetail.files.length}}">附件 ({{auditSubmissionDetail.files.length}}份)</view>
            <view class="list-item" wx:for="{{auditSubmissionDetail.files}}" wx:key="id">
              <view class="list-main"><view class="list-name">{{item.fileName}}</view></view>
            </view>
            </block>
          </scroll-view>
        </view>
      </view>
    </view>

    <!-- ══════════════ Audit: Verification ══════════════ -->
    <view class="section" wx:if="{{activeTab === 'auditVerification'}}">
      <view class="section-title">验签权限管理</view>
      <view class="edit-box">
        <view class="list-title">授予验签权限</view>
        <view class="field">
          <view class="field-label">人员HR ID</view>
          <input class="field-input" value="{{verificationGrantHrId}}" bindinput="onVerificationGrantHrInput" placeholder="输入要授权的人员HR ID" />
        </view>
        <view class="button-row">
          <button class="primary-btn" bindtap="grantVerificationPermission">授予权限</button>
        </view>
      </view>
      <view class="list-card">
        <view class="list-title">已授权人员</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll medium-scroll" scroll-y>
          <view class="card-loading-overlay" wx:if="{{loadingMap.auditVerification}}"><view class="card-loading-spinner"></view></view>
          <block wx:else>
          <view class="list-item" wx:for="{{verificationPermissions}}" wx:key="id">
            <view class="list-main"><view class="list-name">{{item.granteeName}} ({{item.granteeHrId}})</view></view>
            <view class="list-actions">
              <text class="link danger-link" data-hr-id="{{item.granteeHrId}}" bindtap="revokeVerificationPermission">撤销</text>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!verificationPermissions.length}}">暂无授权人员。</view>
          </block>
        </scroll-view>
      </view>

      <view class="edit-box" style="margin-top: 24rpx;">
        <view class="list-title">验证签名链</view>
        <view class="field">
          <view class="field-label">提交编号</view>
          <input class="field-input" value="{{verificationInputNumber}}" bindinput="onVerificationInputNumber" placeholder="输入提交编号 (如 SUB-20260611-001)" />
        </view>
        <view class="button-row">
          <button class="primary-btn" loading="{{loadingMap.verifyChain}}" bindtap="verifySubmissionChain">验证哈希链</button>
        </view>
        <view wx:if="{{verificationResult}}" class="list-card" style="margin-top: 16rpx;">
          <view class="list-name" style="color: {{verificationResult.valid ? '#059669' : '#ef4444'}};">
            {{verificationResult.valid ? '✓ 验证通过 — 所有签名链完整' : '✗ 验证失败 — 签名链存在问题'}}
          </view>
          <view class="list-desc" wx:if="{{verificationResult.totalSignatures > 0}}">共 {{verificationResult.totalSignatures}} 个签名</view>
          <view wx:for="{{verificationResult.files}}" wx:key="fileId" style="margin-top: 8rpx;">
            <view class="list-desc">文件: {{item.fileHash === null ? '文件不可访问' : (item.hashVerified ? '✓ 哈希一致' : '✗ 哈希不匹配')}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="actions" style="padding: 28rpx 8rpx 12rpx;">
      <button class="secondary-btn" bindtap="goPortal">返回门户</button>
    </view>

  </view>

  <!-- Designation Picker Popup (page level, outside tab sections) -->
  <view class="popup-mask" wx:if="{{showDesignationPicker}}" bindtap="closeDesignationPicker">
    <view class="popup-card desig-popup-card" catchtap="noop">
      <view class="popup-header"><view class="popup-title">指定评优名单</view><text class="popup-close" bindtap="closeDesignationPicker">关闭</text></view>
      <view class="list-title">当前名单（{{designationPickerSelectedIds.length}}人）</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-current-scroll">
          <view class="list-item desig-current-item" wx:for="{{designationPickerSelectedList}}" wx:key="id"><view class="list-main"><view class="list-name">{{item.name}}</view><view class="list-desc">{{item.department}} · {{item.studentId}}</view></view><view class="inline-actions list-actions-below"><text class="link danger" data-hr-id="{{item.id}}" catchtap="onDesignationPickerToggle">移除</text></view></view>
          <view class="empty-inline" wx:if="{{!designationPickerSelectedList.length}}">尚未指定任何人</view>
        </scroll-view>
        <view class="list-title" style="margin-top:8rpx;">可选成员</view>
        <view class="rule-filter-row"><view class="rule-filter-field"><view class="field-label">部门</view><picker range="{{desigFilterDeptOptions}}" bindchange="onDesigFilterChange" data-field="department"><view class="picker-value compact-picker-value">{{desigFilterDept}}</view></picker></view><view class="rule-filter-field"><view class="field-label">身份</view><picker range="{{desigFilterIdentOptions}}" bindchange="onDesigFilterChange" data-field="identity"><view class="picker-value compact-picker-value">{{desigFilterIdent}}</view></picker></view><view class="rule-filter-field" style="flex:1;"><view class="field-label">搜索</view><input class="field-input" placeholder="姓名/学号" value="{{desigSearchKeyword}}" bindinput="onDesigSearchInput"/></view></view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="desig-inner-scroll desig-candidate-scroll"><view class="list-item" wx:for="{{designationPickerFilteredList}}" wx:key="id" data-hr-id="{{item.id}}" bindtap="onDesignationPickerToggle"><view class="list-main"><view class="list-name"><view class="select-chip select-chip-inline {{item.isSelected ? 'select-chip-active' : ''}}">{{item.isSelected ? '已选' : '选择'}}</view>{{item.name}}</view><view class="list-desc">{{item.studentId}} · {{item.department}}</view></view></view><view class="empty-inline" wx:if="{{!designationPickerFilteredList.length}}">没有匹配的成员</view></scroll-view>
        <view class="button-row"><button class="secondary-btn" bindtap="closeDesignationPicker">取消</button><button class="primary-btn" loading="{{loadingMap.saveDesignations}}" bindtap="saveDesignations">保存名单（已选{{designationPickerSelectedIds.length}}人）</button></view>
    </view>
  </view>

  <view class="popup-mask" wx:if="{{orgFormVisible}}" bindtap="closeOrgForm">
    <view class="popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="list-title">{{orgFormData.id ? '编辑组织名称' : '新建组织'}}</view>
        <text class="popup-close" bindtap="closeOrgForm">关闭</text>
      </view>
      <view class="popup-body">
        <view class="field">
          <view class="field-label">组织名称</view>
          <input class="field-input" bindinput="onOrgFieldInput" value="{{orgFormData.name}}" placeholder="请输入组织名称" />
        </view>
        <view class="button-row compact-row">
          <button class="primary-btn" loading="{{loadingMap.saveOrganization}}" bindtap="saveOrganization">保存组织</button>
          <button class="secondary-btn" wx:if="{{!orgFormData.id}}" loading="{{loadingMap.switchOrganization}}" bindtap="createAndSwitchOrganization">保存并切换</button>
        </view>
      </view>
    </view>
  </view>

  <view class="popup-mask" wx:if="{{scorerTargetPopupVisible}}" bindtap="closeScorerTargetPopup">
    <view class="popup-card completion-popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">{{scorerTargetPopupTitle}}</view>
        <text class="popup-close" bindtap="closeScorerTargetPopup">关闭</text>
      </view>
      <view class="popup-loading-overlay" wx:if="{{scorerTargetPopupLoading}}">
        <view class="card-loading-spinner"></view>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y wx:else>
        <view class="result-table">
          <view class="result-table-head">
            <view class="result-col result-col-target-name">被评人</view>
            <view class="result-col result-col-target-detail">具体信息</view>
            <view class="result-col result-col-popup-status">状态</view>
          </view>
          <view class="result-table-row {{item.status === 'submitted' ? 'result-table-row-clickable' : ''}}" wx:for="{{scorerTargetPopupRows}}" wx:key="targetId" data-record-id="{{item.recordId}}" bindtap="openScorerTargetRecordDetail">
            <view class="result-col result-col-target-name">
              <view class="result-name">{{item.targetName}}</view>
              <view class="result-meta">{{item.targetStudentId}}</view>
            </view>
            <view class="result-col result-col-target-detail">
              <view class="result-meta result-meta-strong">{{item.detailText}}</view>
            </view>
            <view class="result-col result-col-popup-status">
              <view class="status-chip {{item.statusClass}}">{{item.statusText}}</view>
            </view>
          </view>
        </view>
        <view class="empty-inline" wx:if="{{!scorerTargetPopupRows.length}}">该评分人暂无待评任务。</view>
      </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-name">REDSU智慧工作台</view>
    <view class="footer-org">武汉大学学生会</view>
  </view>

  <view class="popup-mask" wx:if="{{recordDetailPopupVisible}}" bindtap="closeScoreRecordDetail">
    <view class="popup-card completion-popup-card" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">评分详情</view>
        <text class="popup-close" bindtap="closeScoreRecordDetail">关闭</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll" scroll-y wx:if="{{recordDetail}}">
        <view class="list-item detail-summary-card">
          <view class="list-main">
            <view class="detail-people-row">
              <view class="detail-person-block">
                <view class="detail-person-label">评分人</view>
                <view class="detail-person-name">{{recordDetail.scorer.name}}</view>
              </view>
              <view class="detail-person-divider"></view>
              <view class="detail-person-block">
                <view class="detail-person-label">被评分人</view>
                <view class="detail-person-name">{{recordDetail.target.name}}</view>
              </view>
            </view>
            <view class="list-desc">{{recordDetail.submittedAt}}</view>
            <view class="detail-action-row">
              <button
                class="secondary-btn danger-btn compact-action-btn"
                data-id="{{recordDetail.recordId}}"
                bindtap="revokeScoreRecord"
              >撤销这条评分</button>
            </view>
          </view>
        </view>
        <view class="question-card" wx:for="{{recordDetail.templates}}" wx:for-index="templateIndex" wx:key="templateId">
          <view class="question-title">{{item.templateName}}</view>
          <view class="detail-tag-row">
            <view class="score-tag score-tag-template">模板得分 {{item.score}}</view>
            <view class="score-tag score-tag-weight">权重 {{item.weight}}</view>
            <view class="score-tag score-tag-weighted">加权 {{item.weightedScore}}</view>
          </view>
          <view class="detail-question compact-question" wx:for="{{item.questions}}" wx:for-item="question" wx:for-index="questionIndex" wx:key="questionIndex">
            <view class="compact-question-head">
              <view class="list-name detail-question-title">{{question.question}}</view>
              <view class="question-score-corner">{{question.score}} / {{question.maxValue}}</view>
            </view>
            <view
              class="score-label-toggle"
              wx:if="{{question.hasScoreLabel}}"
              data-template-index="{{templateIndex}}"
              data-question-index="{{questionIndex}}"
              bindtap="toggleScoreLabel"
            >
              {{question.scoreLabelExpanded ? '收起评分说明' : '查看评分说明'}}
            </view>
            <view class="score-label-box" wx:if="{{question.hasScoreLabel && question.scoreLabelExpanded}}">{{question.scoreLabel}}</view>
          </view>
        </view>
      </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
      <view class="card-loading-overlay" wx:if="{{!recordDetail}}">
        <view class="card-loading-spinner"></view>
      </view>
    </view>
  </view>

</view>
</view>

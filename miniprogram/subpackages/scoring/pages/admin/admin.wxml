            </view>
          </view>
          <view class="button-row compact-row"><button class="secondary-btn ui-motion-button" bindtap="addPubViewClause" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{pubViewRuleForm.clauseEditingIndex >= 0 ? '保存范围' : '添加范围'}}</button><button class="secondary-btn ui-motion-button" bindtap="cancelPubViewClauseEdit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消编辑</button></view>

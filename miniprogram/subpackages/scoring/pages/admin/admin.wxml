<wxs module="gradeBandWxs" src="./gradeBand.wxs"></wxs>
<page-meta page-style="{{dragActive || showTemplateCsvDialog || hrProfileExportVisible || hrTemplateSwitchVisible || showHrPersonDetail || showCsvMappingDialog || showHrImportPreview || showValidationErrors || auditTemplateStepEditorVisible || auditStarterConditionEditorVisible || auditSubmissionDetailVisible || auditMultiPickerVisible || auditPersonnelPickerVisible || auditIdentityPickerVisible || showDesignationPicker || orgFormVisible || scorerTargetPopupVisible || recordDetailPopupVisible || contextSwitchGuardVisible || identityActionConfirmVisible || adminDeleteConfirmVisible ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="page">
  <workspace-hero class="workspace-hero-host" app-name="WHUSU智慧工作台" page-name="{{subAppLabel || '考核评分'}}" tone="admin"></workspace-hero>

  <view class="empty-card" wx:if="{{!hasPermission}}">
    <view class="empty-title">暂无评分管理权限</view>
    <view class="empty-desc">请切换到有评分管理权限的身份</view>
  </view>

  <view class="admin-workbench" wx:if="{{hasPermission}}">
    <view class="tabs">
      <block wx:for="{{visibleTabs}}" wx:key="*this" wx:for-item="tabKey">
        <view class="tab {{activeTab === tabKey ? 'tab-active' : ''}} ui-motion-chip" data-tab="{{tabKey}}" bindtap="switchTab" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <block wx:if="{{tabKey === 'activities'}}">评分活动</block>
          <block wx:elif="{{tabKey === 'templates'}}">评分问题</block>
          <block wx:elif="{{tabKey === 'rules'}}">评分人类别</block>
          <block wx:elif="{{tabKey === 'results'}}">结果查看</block>
          <block wx:elif="{{tabKey === 'hrInfo'}}">人事信息</block>
          <block wx:elif="{{tabKey === 'hrTemplates'}}">人事模板</block>
          <block wx:elif="{{tabKey === 'departments'}}">部门维护</block>
          <block wx:elif="{{tabKey === 'workGroups'}}">职能组</block>
          <block wx:elif="{{tabKey === 'identities'}}">身份类别</block>
          <block wx:elif="{{tabKey === 'admins'}}">管理员</block>
          <block wx:elif="{{tabKey === 'settings'}}">基本设置</block>
          <block wx:elif="{{tabKey === 'publications'}}">结果公示</block>
          <block wx:elif="{{tabKey === 'auditTemplates'}}">审核模板</block>
          <block wx:elif="{{tabKey === 'auditStamps'}}">电子印章</block>
          <block wx:elif="{{tabKey === 'auditSubmissions'}}">审核记录</block>
          <block wx:elif="{{tabKey === 'auditVerification'}}">文件验签</block>
        </view>
      </block>
    </view>


    <view class="section" wx:if="{{activeTab === 'activities'}}">
      <view class="section-title">评分活动</view>
      <view class="edit-box">
        <view class="list-title">{{activityForm.id ? '编辑活动' : '新建活动'}}</view>
        <view class="field">
          <view class="field-label">活动名称</view>
          <input class="field-input" data-field="name" bindinput="onActivityFieldInput" value="{{activityForm.name}}" placeholder="请输入活动名称" />
        </view>
        <view class="field">
          <view class="field-label">活动说明</view>
          <textarea class="field-textarea" auto-height maxlength="-1" data-field="description" bindinput="onActivityFieldInput" value="{{activityForm.description}}" placeholder="请输入活动说明" />
        </view>
        <view class="field field-row">
          <view class="field field-half">
            <view class="field-label">开始日期</view>
            <picker mode="date" value="{{activityForm.startDate}}" bindchange="onActivityDateChange" data-field="startDate">
              <view class="picker-value">{{activityForm.startDate || '请选择开始日期'}}</view>
            </picker>
          </view>
          <view class="field field-half">
            <view class="field-label">结束日期</view>
            <picker mode="date" value="{{activityForm.endDate}}" bindchange="onActivityDateChange" data-field="endDate">
              <view class="picker-value">{{activityForm.endDate || '请选择结束日期'}}</view>
            </picker>
          </view>
        </view>
        <view class="field">
          <view class="field-label">评分对象</view>
          <picker
            range="{{participantGranularityOptions}}"
            range-key="label"
            value="{{activityForm.participantGranularityIndex}}"
            bindchange="onActivityGranularityChange"
          >
            <view class="picker-value">
              {{participantGranularityOptions[activityForm.participantGranularityIndex].label}}
            </view>
          </picker>
          <view class="field-help">
            {{activityForm.participantGranularity === 'assignment' ? '同一人的不同岗位分别评分。' : '同一人只评分一次。'}}
          </view>
        </view>
        <view class="button-row">
          <button class="primary-btn ui-motion-button" loading="{{loadingMap.saveActivity}}" bindtap="saveActivity" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存活动</button>
          <button class="secondary-btn ui-motion-button" bindtap="startCreateActivity" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">新建活动</button>
        </view>
      </view>

      <view class="list-card">
        <view class="list-title">活动列表</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll medium-scroll" scroll-y>
          <view class="card-loading-overlay" wx:if="{{loadingMap.activities}}">
            <view class="card-loading-spinner"></view>
          </view>
          <block wx:else>
          <view class="list-item list-item-stacked" wx:for="{{activityList}}" wx:key="id">
            <view class="list-main">
              <view class="list-name">{{item.name}}</view>
              <view class="chip-row">
                <view class="status-chip current-chip" wx:if="{{item.isCurrent}}">当前活动</view>
                <view class="status-chip paused-chip" wx:if="{{item.isPaused}}">已暂停</view>
                <view class="status-chip">{{item.participantGranularity === 'assignment' ? '按岗位' : '按人'}}</view>
              </view>
              <view class="list-desc">{{item.description}}</view>
              <view class="list-desc">{{item.startDate}} {{item.endDate}}</view>
              <view class="inline-actions list-actions-below">
                <text class="link ui-motion-chip" data-id="{{item.id}}" bindtap="setCurrentActivity" wx:if="{{!item.isCurrent}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">设为当前</text>
                <text class="link ui-motion-chip" data-index="{{index}}" bindtap="editActivity" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text>
                <text class="link ui-motion-chip" data-id="{{item.id}}" bindtap="toggleActivityPause" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item.isPaused ? '恢复活动' : '暂停活动'}}</text>
                <text class="link danger ui-motion-chip" data-id="{{item.id}}" bindtap="deleteActivity" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">删除</text>
              </view>
            </view>
          </view>
          </block>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
      </view>
    </view>

    <view class="section" wx:if="{{activeTab === 'templates'}}">
      <view class="section-title">评分问题</view>
      <view class="edit-box">
        <view class="list-title">{{templateForm.id ? '编辑评分问题' : '新建评分问题'}}</view>
        <view class="field">
          <view class="field-label">评分问题名称</view>
          <input class="field-input" data-field="name" bindinput="onTemplateFieldInput" value="{{templateForm.name}}" placeholder="请输入评分问题名称" />
        </view>
        <view class="field">
          <view class="field-label">评分问题说明</view>
          <textarea class="field-textarea" auto-height maxlength="-1" data-field="description" bindinput="onTemplateFieldInput" value="{{templateForm.description}}" placeholder="请输入评分问题说明" />
        </view>

        <view class="list-card nested-card">
          <view class="list-title">问题条目</view>

          <view class="empty-inline" wx:if="{{!templateForm.questions.length}}">暂无问题</view>

          <!-- Ghost card that follows finger during drag -->
          <view class="drag-ghost-card" wx:if="{{dragGhostVisible}}" style="top: {{dragGhostTop}}px; left: {{dragGhostLeft}}px; width: {{dragGhostWidth}}px;">
            <view class="question-header">
              <view class="drag-handle">≡</view>
              <view class="question-title">
                <text>问题 {{draggingQuestionIndex + 1}}</text>
                <text class="expand-indicator">▼</text>
              </view>
              <view class="question-order-btns">
                <view class="order-btn order-btn-disabled">↑</view>
                <view class="order-btn order-btn-disabled">↓</view>
                <view class="order-btn order-btn-delete"></view>
              </view>
            </view>
            <view class="question-preview">
              <text class="preview-text">{{templateForm.questions[draggingQuestionIndex].question || '（未填写问题内容）'}}</text>
              <view class="preview-chips">
                <view class="preview-chip chip-min">最低 {{templateForm.questions[draggingQuestionIndex].minValue || '0'}}</view>
                <view class="preview-chip chip-start">起评 {{templateForm.questions[draggingQuestionIndex].startValue || '0'}}</view>
                <view class="preview-chip chip-max">最高 {{templateForm.questions[draggingQuestionIndex].maxValue || '10'}}</view>
                <view class="preview-chip chip-step">步进 {{templateForm.questions[draggingQuestionIndex].stepValue || '1'}}</view>
              </view>
            </view>
          </view>

          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}"
            class="inner-scroll large-scroll"
            scroll-y
            scroll-into-view="{{templateQuestionScrollInto}}"
            scroll-top="{{templateQuestionScrollTop}}"
            lower-threshold="80"
            bindscrolltolower="loadMoreScoreResults"
          >
            <view catchtouchmove="{{draggingQuestionIndex >= 0 ? 'noop' : ''}}">
            <view
              class="question-card {{draggingQuestionIndex === index ? 'dragging-ghost' : ''}} {{dragInsertIndex >= 0 && dragInsertIndex === index ? 'drag-insert-target' : ''}}"
              wx:for="{{templateForm.questions}}"
              wx:key="index"
              id="question-{{index}}"
              data-index="{{index}}"
              bindlongpress="startQuestionDrag"
              bindtouchmove="onQuestionDragMove"
              bindtouchend="endQuestionDrag"
              bindtouchcancel="onQuestionDragCancel"
            >
              <view class="question-header">
                <view class="drag-handle">≡</view>
                <view class="question-title ui-motion-chip" data-index="{{index}}" bindtap="toggleQuestionExpand" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
                  <text>问题 {{index + 1}}</text>
                  <text class="expand-indicator">{{expandedQuestionIndex === index ? '▲' : '▼'}}</text>
                </view>
                <view class="question-order-btns">
                  <view class="order-btn {{index === 0 ? 'order-btn-disabled' : ''}} ui-motion-chip" data-index="{{index}}" catchtap="moveQuestionUp" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">↑</view>
                  <view class="order-btn {{index === templateForm.questions.length - 1 ? 'order-btn-disabled' : ''}} ui-motion-chip" data-index="{{index}}" catchtap="moveQuestionDown" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">↓</view>
                  <view class="order-btn order-btn-delete ui-motion-chip" data-index="{{index}}" catchtap="removeTemplateQuestion" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"></view>
                </view>
              </view>

              <view class="question-preview ui-motion-chip" wx:if="{{expandedQuestionIndex !== index}}" data-index="{{index}}" bindtap="toggleQuestionExpand" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
                <text class="preview-text">{{item.question || '（未填写问题内容）'}}</text>
                <view class="preview-chips">
                  <view class="preview-chip chip-min">最低 {{item.minValue || '0'}}</view>
                  <view class="preview-chip chip-start">起评 {{item.startValue || '0'}}</view>
                  <view class="preview-chip chip-max">最高 {{item.maxValue || '10'}}</view>
                  <view class="preview-chip chip-step">步进 {{item.stepValue || '1'}}</view>
                </view>
              </view>

              <view class="question-fields" wx:if="{{expandedQuestionIndex === index}}">
              <view class="field">
                <view class="field-label">问题内容</view>
                <input class="field-input {{questionValidationErrors[index] && questionValidationErrors[index].field === 'question' ? 'field-error' : ''}}" data-index="{{index}}" data-field="question" bindinput="onTemplateQuestionInput" bindblur="onTemplateQuestionBlur" bindfocus="onQuestionContentFocus" focus="{{questionFocusIndex === index}}" value="{{questionInputValues[index] && questionInputValues[index].question !== undefined ? questionInputValues[index].question : item.question}}" placeholder="请输入问题内容" />
              </view>
              <view class="field">
                <view class="field-label">分值说明</view>
                <textarea class="field-textarea question-textarea" auto-height maxlength="-1" data-index="{{index}}" data-field="scoreLabel" bindinput="onTemplateQuestionInput" bindblur="onTemplateQuestionBlur" value="{{questionInputValues[index] && questionInputValues[index].scoreLabel !== undefined ? questionInputValues[index].scoreLabel : item.scoreLabel}}" placeholder="请输入分值说明" />
              </view>
              <view class="field field-row">
                <view class="field field-half">
                  <view class="field-label">最低分</view>
                  <input class="field-input {{questionValidationErrors[index] && questionValidationErrors[index].field === 'minValue' ? 'field-error' : ''}}" data-index="{{index}}" data-field="minValue" bindinput="onTemplateQuestionInput" bindblur="onTemplateQuestionBlur" value="{{questionInputValues[index] && questionInputValues[index].minValue !== undefined ? questionInputValues[index].minValue : item.minValue}}" placeholder="0" />
                </view>
                <view class="field field-half">
                  <view class="field-label">起评分</view>
                  <input class="field-input" data-index="{{index}}" data-field="startValue" bindinput="onTemplateQuestionInput" bindblur="onTemplateQuestionBlur" value="{{questionInputValues[index] && questionInputValues[index].startValue !== undefined ? questionInputValues[index].startValue : item.startValue}}" placeholder="0" />
                </view>
              </view>
              <view class="field field-row">
                <view class="field field-half">
                  <view class="field-label">最高分</view>
                  <input class="field-input {{questionValidationErrors[index] && questionValidationErrors[index].field === 'maxValue' ? 'field-error' : ''}}" data-index="{{index}}" data-field="maxValue" bindinput="onTemplateQuestionInput" bindblur="onTemplateQuestionBlur" value="{{questionInputValues[index] && questionInputValues[index].maxValue !== undefined ? questionInputValues[index].maxValue : item.maxValue}}" placeholder="10" />
                </view>
                <view class="field field-half">
                  <view class="field-label">步进值</view>
                  <input class="field-input {{questionValidationErrors[index] && questionValidationErrors[index].field === 'stepValue' ? 'field-error' : ''}}" data-index="{{index}}" data-field="stepValue" bindinput="onTemplateQuestionInput" bindblur="onTemplateQuestionBlur" value="{{questionInputValues[index] && questionInputValues[index].stepValue !== undefined ? questionInputValues[index].stepValue : item.stepValue}}" placeholder="0.5" />
                </view>
              </view>
              </view>
            </view>
            <view class="drag-insert-line-end" wx:if="{{dragInsertIndex >= 0 && dragInsertIndex === templateForm.questions.length}}"></view>
            </view>
          </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
        </view>

        <view class="button-row">
          <button class="secondary-btn ui-motion-button" bindtap="addTemplateQuestion" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">新增问题</button>
          <button class="secondary-btn ui-motion-button" bindtap="importTableTemplate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">导入表格</button>
          <button class="secondary-btn ui-motion-button" bindtap="exportTemplate" disabled="{{!templateForm.questions.length}}" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">导出表格</button>
          <button class="primary-btn ui-motion-button" loading="{{loadingMap.saveTemplate}}" bindtap="saveTemplate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存评分问题</button>
          <button class="secondary-btn ui-motion-button" bindtap="startCreateTemplate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">清空</button>
        </view>
      </view>

      <view class="list-card">
        <view class="list-title">评分问题列表</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll medium-scroll" scroll-y>
          <view class="card-loading-overlay" wx:if="{{loadingMap.templates}}">
            <view class="card-loading-spinner"></view>
          </view>
          <block wx:else>
          <view class="list-item list-item-stacked" wx:for="{{templateList}}" wx:key="id">
            <view class="list-main">
              <view class="list-name">{{item.name}}</view>
              <view class="list-desc">{{item.description}}</view>
              <view class="list-desc">问题数：{{item.questionCount}}</view>
              <view class="inline-actions list-actions-below">
                <text class="link ui-motion-chip" data-id="{{item.id}}" bindtap="duplicateTemplate" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">复制</text>
                <text class="link ui-motion-chip" data-index="{{index}}" bindtap="editTemplate" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text>
                <text class="link danger ui-motion-chip" data-id="{{item.id}}" bindtap="deleteTemplate" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">删除</text>
              </view>
            </view>
          </view>
          </block>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
      </view>
    </view>

    <!-- Template CSV import mapping dialog -->
    <view class="modal-mask ui-overlay" wx:if="{{showTemplateCsvDialog}}" bindtap="cancelTemplateCsvImport" catchtouchmove="noop">
      <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
      <view class="modal-card csv-mapping-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
        <view class="modal-header ui-dialog-header">
          <view class="modal-title">选择评分问题列</view>
          <view class="modal-close ui-motion-chip" catchtap="cancelTemplateCsvImport" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">✕</view>
        </view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="modal-body csv-mapping-body ui-dialog-body ui-dialog-scroll--fill ui-data-grid--complex" scroll-y>
          <view class="csv-mapping-tip">请选择“问题内容”对应列，其他列可选。</view>
          <view class="csv-mapping-row csv-mapping-row-header ui-data-row ui-data-row--header">
            <view class="csv-mapping-col csv-mapping-col-csv ui-data-cell ui-data-cell--primary">表格列名</view>
            <view class="csv-mapping-col csv-mapping-col-type ui-data-cell">内容类型</view>
            <view class="csv-mapping-col csv-mapping-col-sample ui-data-cell ui-data-cell--secondary">示例值</view>
            <view class="csv-mapping-col csv-mapping-col-target ui-data-cell ui-data-cell--action">作为</view>
          </view>
          <view class="csv-mapping-row ui-data-row" wx:for="{{templateCsvImportRows}}" wx:key="header">
            <view class="csv-mapping-col csv-mapping-col-csv ui-data-cell ui-data-cell--primary">
              <text class="csv-mapping-mobile-label">表格列名</text>
              <text class="csv-mapping-primary-text">{{item.header}}</text>
            </view>
            <view class="csv-mapping-col csv-mapping-col-type ui-data-cell">
              <text class="csv-mapping-mobile-label">内容类型</text>
              <view class="csv-mapping-type-tag">{{item.fieldTypeLabel}}</view>
            </view>
            <view class="csv-mapping-col csv-mapping-col-sample ui-data-cell ui-data-cell--secondary ui-motion-chip" data-value="{{item.sampleValue}}" catchtap="showCsvSampleValue" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}" aria-role="button" aria-label="查看完整示例值">
              <text class="csv-mapping-mobile-label">示例值</text>
              <text class="csv-mapping-sample-text">{{item.sampleValue || '—'}}</text>
              <text class="csv-mapping-sample-hint" wx:if="{{item.sampleValue}}">点击查看全文</text>
            </view>
            <view class="csv-mapping-col csv-mapping-col-target ui-data-cell ui-data-cell--action">
              <text class="csv-mapping-mobile-label">作为</text>
              <picker range="{{templateCsvImportMappingLabels}}"
                      mode="selector" data-index="{{index}}"
                      bindchange="onTemplateCsvMappingChange"
                      value="{{item.optionIndex}}">
                <view class="csv-mapping-picker-value ui-control-text">{{item.optionLabel}}</view>
              </picker>
            </view>
          </view>
        </scroll-view><view class="scroll-hint csv-mapping-scroll-hint"><view class="scroll-hint-dot"></view></view>
        <view class="csv-skip-invalid-row">
          <view class="csv-skip-invalid-label">
            <text>替换现有问题</text>
            <text class="csv-skip-invalid-desc">关闭时追加到现有问题</text>
          </view>
          <switch checked="{{templateCsvReplaceMode}}" bindchange="toggleTemplateCsvReplaceMode" color="#2563eb"/>
        </view>
        <view class="modal-footer csv-mapping-footer ui-dialog-footer">
          <button class="secondary-btn ui-motion-button" catchtap="cancelTemplateCsvImport" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
          <button class="primary-btn ui-motion-button" catchtap="confirmTemplateCsvImport" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">确认导入</button>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{activeTab === 'rules'}}">
      <view class="rule-panel">
        <view class="rule-panel-head">
          <view class="rule-panel-title">评分人信息</view>
        </view>
        <view class="field">
          <view class="field-label">评分人所属部门</view>
          <picker range="{{departmentList}}" range-key="name" bindchange="onRuleScorerDepartmentChange"><view class="picker-value">{{ruleForm.scorerDepartment || '请选择部门'}}</view></picker>
        </view>
        <view class="field">
          <view class="field-label">评分人身份</view>
          <picker range="{{identityList}}" range-key="name" bindchange="onRuleScorerIdentityChange"><view class="picker-value">{{ruleForm.scorerIdentity || '请选择身份'}}</view></picker>
        </view>
        <view class="button-row">
          <button class="primary-btn ui-motion-button" loading="{{loadingMap.saveRule}}" bindtap="saveRuleCategory" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存类别</button>
          <button class="secondary-btn ui-motion-button" bindtap="startCreateRuleCategory" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">新增类别</button>
          <button class="secondary-btn ui-motion-button" disabled="{{loadingMap.batchSaveRules}}" bindtap="applyClausesToSelectedRules" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">批量应用到已选类别</button>
          <button class="secondary-btn ui-motion-button" disabled="{{loadingMap.generateRules}}" bindtap="generateRuleCategoriesFinal" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">生成默认类别</button>
        </view>
        <view class="rule-switch-row">
          <view>
            <view class="field-label">允许自评</view>
            <view class="rule-panel-subtitle">关闭后隐藏评分人本人</view>
          </view>
          <switch checked="{{ruleForm.allowSelfAssessment}}" color="#2563eb" bindchange="onAllowSelfAssessmentChange" />
        </view>
      </view>

      <view class="rule-panel">
        <view class="rule-panel-head rule-panel-head-row">
          <view>
            <view class="rule-panel-title">当前被评分人规则</view>
          </view>
          <button class="secondary-btn mini-action-btn ui-motion-button" bindtap="openNewRuleClauseEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">新建被评分人规则</button>
        </view>
        <view class="rule-empty" wx:if="{{!ruleForm.clauses.length}}">暂无被评分人规则</view>
        <view class="rule-clause-card" wx:for="{{ruleForm.clauses}}" wx:key="index">
          <view class="rule-clause-main">
            <view class="rule-clause-title">{{item.targetIdentity || '不限制被评分人身份'}}</view>
            <view class="rule-tag-row">
              <text class="rule-tag tag-scope">{{item.scopeLabel || item.scopeType}}</text>
              <text class="rule-tag tag-target">{{item.targetIdentity || '不限身份'}}</text>
              <text class="rule-tag {{item.requireAllComplete ? 'tag-required' : 'tag-free'}}">{{item.requireAllComplete ? '要求全评' : '不要求全评'}}</text>
            </view>
          </view>
          <view class="rule-template-list" wx:if="{{item.templateConfigs.length}}">
            <view class="rule-template-row" wx:for="{{item.templateConfigs}}" wx:for-item="template" wx:for-index="templateIndex" wx:key="templateId">
              <view class="rule-template-name">{{template.templateName || '未命名评分问题'}}</view>
              <view class="rule-template-tags">
                <text class="rule-tag tag-weight">权重 {{template.weight}}</text>
                <text class="rule-tag tag-order">顺序 {{template.sortOrder}}</text>
                <text class="rule-tag tag-method" wx:if="{{template.calculationMethod === 'trim_extremes'}}">去极值 (高{{template.trimHighCount}}/低{{template.trimLowCount}})</text>
              </view>
            </view>
          </view>
          <view class="rule-empty small-empty" wx:else>未选择评分问题</view>
          <view class="pill-actions rule-card-actions">
            <text class="pill-link ui-motion-chip" data-index="{{index}}" bindtap="editRuleClause" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text>
            <text class="pill-close ui-motion-chip" data-index="{{index}}" bindtap="removeRuleClause" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">删除</text>
          </view>
        </view>
      </view>

      <view class="rule-panel" wx:if="{{ruleForm.isRuleClauseEditorVisible}}">
        <view class="rule-panel-head rule-panel-head-row">
          <view>
            <view class="rule-panel-title">被评分人规则编辑</view>
            <view class="rule-panel-subtitle">{{ruleForm.clauseEditingIndex >= 0 ? '正在编辑当前被评分人规则' : '添加一条新的被评分人规则'}}</view>
          </view>
          <button class="secondary-btn mini-action-btn ui-motion-button" bindtap="openTemplateConfigEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">添加评分问题</button>
        </view>
        <view class="field">
          <view class="field-label">被评分范围</view>
          <picker range="{{scopeOptions}}" range-key="label" bindchange="onClauseScopeChange">
            <view class="picker-value">{{ruleForm.clauseScopeLabel}}</view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">被评分人身份</view>
          <picker range="{{identityList}}" range-key="name" bindchange="onRuleTargetIdentityChange"><view class="picker-value">{{ruleForm.clauseTargetIdentity || '不限制身份'}}</view></picker>
        </view>
        <view class="rule-switch-row">
          <view>
            <view class="field-label">是否要求全评</view>
            <view class="rule-panel-subtitle">全部完成后计入核算</view>
          </view>
          <switch checked="{{ruleForm.clauseRequireAllComplete}}" color="#2563eb" bindchange="onClauseRequireAllCompleteChange" />
        </view>

        <view class="rule-config-list" wx:if="{{ruleForm.clauseTemplateConfigs.length || clauseTemplateInlineEditIndex >= 0}}">
          <view class="list-title">评分问题及顺序</view>
          <view class="drag-ghost-card" wx:if="{{dragTemplateGhostVisible}}" style="top: {{dragTemplateGhostTop}}px; left: {{dragTemplateGhostLeft}}px; width: {{dragTemplateGhostWidth}}px;">
            <view class="template-config-header">
              <view class="drag-handle">≡</view>
              <view class="template-config-sort-btns">
                <view class="sort-arrow sort-arrow-disabled">↑</view>
                <view class="sort-arrow sort-arrow-disabled">↓</view>
              </view>
            </view>
            <view class="template-config-name">{{ruleForm.clauseTemplateConfigs[draggingClauseTemplateIndex].templateName || '未命名评分问题'}}</view>
            <view class="template-config-meta">
              <text class="rule-tag tag-weight">权重 {{ruleForm.clauseTemplateConfigs[draggingClauseTemplateIndex].weight}}</text>
              <text class="rule-tag tag-order">顺序 {{ruleForm.clauseTemplateConfigs[draggingClauseTemplateIndex].sortOrder}}</text>
            </view>
          </view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" wx:if="{{ruleForm.clauseTemplateConfigs.length}}" class="inner-scroll small-scroll template-config-scroll {{clauseTemplateInlineEditIndex >= 0 ? 'template-config-scroll-expanded' : ''}}" scroll-y scroll-top="{{templateConfigScrollTop}}">
            <view catchtouchmove="{{draggingClauseTemplateIndex >= 0 ? 'noop' : ''}}">
              <block wx:for="{{ruleForm.clauseTemplateConfigs}}" wx:key="index">
                <view class="template-config-card {{draggingClauseTemplateIndex === index ? 'dragging-ghost' : ''}} {{dragTemplateInsertIndex >= 0 && dragTemplateInsertIndex === index ? 'drag-insert-target' : ''}}"
                      id="template-config-{{index}}"
                      data-index="{{index}}"
                      bindlongpress="startTemplateConfigDrag"
                      bindtouchmove="onTemplateConfigDragMove"
                      bindtouchend="endTemplateConfigDrag"
                      bindtouchcancel="onTemplateConfigDragCancel">
                  <view class="template-config-header">
                    <view class="drag-handle">≡</view>
                    <view class="template-config-sort-btns">
                      <view class="sort-arrow {{index === 0 ? 'sort-arrow-disabled' : ''}} ui-motion-card" data-index="{{index}}" catchtap="moveClauseTemplateConfigUp" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">↑</view>
                      <view class="sort-arrow {{index === ruleForm.clauseTemplateConfigs.length - 1 ? 'sort-arrow-disabled' : ''}} ui-motion-card" data-index="{{index}}" catchtap="moveClauseTemplateConfigDown" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">↓</view>
                    </view>
                  </view>
                  <view class="template-config-name">{{item.templateName || '未命名评分问题'}}</view>
                  <view class="template-config-row">
                    <view class="template-config-meta">
                      <text class="rule-tag tag-weight">权重 {{item.weight}}</text>
                      <text class="rule-tag tag-order">顺序 {{item.sortOrder}}</text>
                    </view>
                    <view class="pill-actions template-config-actions">
                      <text class="pill-link ui-motion-chip" data-index="{{index}}" catchtap="editClauseTemplateConfig" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text>
                      <text class="pill-close ui-motion-chip" data-index="{{index}}" catchtap="removeClauseTemplateConfig" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">删除</text>
                    </view>
                  </view>
                </view>
                <view class="template-config-inline-edit" wx:if="{{clauseTemplateInlineEditIndex === index}}">
                  <view class="field">
                    <view class="field-label">评分问题</view>
                    <picker range="{{templateList}}" range-key="name" bindchange="onRuleTemplateChange">
                      <view class="picker-value">{{ruleForm.clauseTemplateName || '请选择评分问题'}}</view>
                    </picker>
                  </view>
                  <view class="field field-row">
                    <view class="field field-half">
                      <view class="field-label">权重</view>
                      <input class="field-input" data-field="clauseTemplateWeight" bindinput="onRuleFieldInput" value="{{ruleForm.clauseTemplateWeight}}" placeholder="1" />
                    </view>
                  </view>
                  <view class="field">
                    <view class="field-label">计算方式</view>
                    <picker range="{{['加权平均', '去极值后平均']}}" bindchange="onCalculationMethodChange">
                      <view class="picker-value">{{ruleForm.clauseCalculationMethod === 'trim_extremes' ? '去极值后平均' : '加权平均'}}</view>
                    </picker>
                  </view>
                  <view class="field field-row" wx:if="{{ruleForm.clauseCalculationMethod === 'trim_extremes'}}">
                    <view class="field field-half">
                      <view class="field-label">去掉最高分个数</view>
                      <input class="field-input" data-field="clauseTrimHighCount" bindinput="onRuleFieldInput" value="{{ruleForm.clauseTrimHighCount}}" placeholder="0" type="number" />
                    </view>
                    <view class="field field-half">
                      <view class="field-label">去掉最低分个数</view>
                      <input class="field-input" data-field="clauseTrimLowCount" bindinput="onRuleFieldInput" value="{{ruleForm.clauseTrimLowCount}}" placeholder="0" type="number" />
                    </view>
                  </view>
                  <view class="button-row compact-row">
                    <button class="secondary-btn ui-motion-button" bindtap="saveClauseTemplateConfigInline" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存评分问题</button>
                    <button class="secondary-btn ui-motion-button" bindtap="cancelClauseTemplateConfigInline" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
                  </view>
                </view>
              </block>
              <view class="drag-insert-line-end" wx:if="{{dragTemplateInsertIndex >= 0 && dragTemplateInsertIndex === ruleForm.clauseTemplateConfigs.length}}"></view>
            </view>
          </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>

          <view class="template-config-inline-edit" wx:if="{{clauseTemplateInlineEditIndex >= 0 && clauseTemplateInlineEditIndex === ruleForm.clauseTemplateConfigs.length}}">
            <view class="field">
              <view class="field-label">评分问题</view>
              <picker range="{{templateList}}" range-key="name" bindchange="onRuleTemplateChange">
                <view class="picker-value">{{ruleForm.clauseTemplateName || '请选择评分问题'}}</view>
              </picker>
            </view>
            <view class="field field-row">
              <view class="field field-half">
                <view class="field-label">权重</view>
                <input class="field-input" data-field="clauseTemplateWeight" bindinput="onRuleFieldInput" value="{{ruleForm.clauseTemplateWeight}}" placeholder="1" />
              </view>
            </view>
            <view class="field">
              <view class="field-label">计算方式</view>
              <picker range="{{['加权平均', '去极值后平均']}}" bindchange="onCalculationMethodChange">
                <view class="picker-value">{{ruleForm.clauseCalculationMethod === 'trim_extremes' ? '去极值后平均' : '加权平均'}}</view>
              </picker>
            </view>
            <view class="field field-row" wx:if="{{ruleForm.clauseCalculationMethod === 'trim_extremes'}}">
              <view class="field field-half">
                <view class="field-label">去掉最高分个数</view>
                <input class="field-input" data-field="clauseTrimHighCount" bindinput="onRuleFieldInput" value="{{ruleForm.clauseTrimHighCount}}" placeholder="0" type="number" />
              </view>
              <view class="field field-half">
                <view class="field-label">去掉最低分个数</view>
                <input class="field-input" data-field="clauseTrimLowCount" bindinput="onRuleFieldInput" value="{{ruleForm.clauseTrimLowCount}}" placeholder="0" type="number" />
              </view>
            </view>
            <view class="button-row compact-row">
              <button class="secondary-btn ui-motion-button" bindtap="saveClauseTemplateConfigInline" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存评分问题</button>
              <button class="secondary-btn ui-motion-button" bindtap="cancelClauseTemplateConfigInline" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
            </view>
          </view>
        </view>

        <view class="button-row compact-row">
          <button class="secondary-btn ui-motion-button" bindtap="addRuleClause" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{ruleForm.clauseEditingIndex >= 0 ? '保存被评分人规则' : '加入当前被评分人规则'}}</button>
          <button class="secondary-btn ui-motion-button" bindtap="cancelRuleClauseEdit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消被评分人规则编辑</button>
        </view>
      </view>

      <view class="list-card rule-list-card">
        <view class="rule-list-toolbar">
          <view>
            <view class="list-title">评分人类别列表</view>
          </view>
          <view class="rule-list-count">{{ruleListView.length}} / {{ruleList.length}}</view>
        </view>
        <view class="rule-filter-row">
          <view class="rule-filter-field">
            <view class="field-label">部门筛选</view>
            <picker range="{{ruleFilterOptions.departments}}" bindchange="onRuleFilterChange" data-field="department">
              <view class="picker-value compact-picker-value">{{ruleFilters.department}}</view>
            </picker>
          </view>
          <view class="rule-filter-field">
            <view class="field-label">身份筛选</view>
            <picker range="{{ruleFilterOptions.identities}}" bindchange="onRuleFilterChange" data-field="identity">
              <view class="picker-value compact-picker-value">{{ruleFilters.identity}}</view>
            </picker>
          </view>
        </view>
        <view class="button-row compact-row">
          <button class="secondary-btn ui-motion-button" bindtap="toggleSelectAllRules" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{visibleRuleAllSelected ? '取消当前全选' : '全选当前列表'}}</button>
          <button class="secondary-btn ui-motion-button" bindtap="reverseSelectVisibleRules" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">反选当前列表</button>
          <button class="secondary-btn ui-motion-button" bindtap="resetRuleFilters" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">清除筛选</button>
        </view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll medium-scroll" scroll-y>
          <view class="card-loading-overlay" wx:if="{{loadingMap.rules}}">
            <view class="card-loading-spinner"></view>
          </view>
          <block wx:else>
          <view class="list-item rule-list-item" wx:for="{{ruleListView}}" wx:key="id">
            <view class="list-main">
              <view class="rule-list-action-row">
                <view class="select-chip {{selectedRuleIdMap[item.id] ? 'select-chip-active' : ''}} ui-motion-chip" data-id="{{item.id}}" catchtap="toggleRuleSelection" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
                  {{selectedRuleIdMap[item.id] ? '已选' : '选择'}}
                </view>
                <view class="inline-actions rule-list-inline-actions">
                  <text class="link ui-motion-chip" data-id="{{item.id}}" bindtap="editRule" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text>
                  <text class="link danger ui-motion-chip" data-id="{{item.id}}" bindtap="deleteRule" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">删除</text>
                </view>
              </view>
              <view class="rule-list-info">
                <view class="rule-list-main-line">
                  <text class="rule-info-text">{{item.scorerDepartment || '未设置部门'}} / {{item.scorerIdentity || '未设置身份'}}</text>
                </view>
                <view class="rule-list-meta">
                  <text class="rule-tag tag-scope">{{item.ruleCount || 0}} 条被评分人规则</text>
                </view>
              </view>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!ruleListView.length}}">暂无评分人类别</view>
          </block>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
      </view>
    </view>

    <view class="section" wx:if="{{activeTab === 'results'}}">
      <view class="section-title">评分结果</view>
      <view class="list-card">
        <view class="list-title">当前评分活动</view>
        <view class="result-current">{{currentActivityName || '暂无当前评分活动'}}</view>
      </view>

      <view class="stats-panel">
        <view class="stats-grid stats-grid-summary">
          <view class="stat-card">
            <view class="stat-label">成员总数</view>
            <view class="stat-value">{{scoreResultsRaw.stats.totalMembers || 0}}</view>
          </view>
          <view class="stat-card">
            <view class="stat-label">已有得分成员</view>
            <view class="stat-value">{{scoreResultsRaw.stats.scoredMembers || 0}}</view>
          </view>
          <view class="stat-card">
            <view class="stat-label">评分记录数</view>
            <view class="stat-value">{{scoreResultsRaw.stats.recordCount || 0}}</view>
          </view>
          <view class="stat-card">
            <view class="stat-label">已完成评分人数</view>
            <view class="stat-value">{{scoreResultsRaw.stats.completedMembers || 0}}</view>
          </view>
        </view>
      </view>

      <view class="edit-box">
        <view class="list-title">筛选条件</view>
        <view class="field field-row">
          <view class="field field-half">
            <view class="field-label">所属部门</view>
            <picker range="{{resultFilterOptions.departments}}" bindchange="onResultFilterChange" data-field="department">
              <view class="picker-value">{{resultFilters.department}}</view>
            </picker>
          </view>
          <view class="field field-half">
            <view class="field-label">身份</view>
            <picker range="{{resultFilterOptions.identities}}" bindchange="onResultFilterChange" data-field="identity">
              <view class="picker-value">{{resultFilters.identity}}</view>
            </picker>
          </view>
        </view>
        <view class="field field-row">
          <view class="field field-half">
            <view class="field-label">职能组</view>
            <picker range="{{resultFilterOptions.workGroups}}" bindchange="onResultFilterChange" data-field="workGroup">
              <view class="picker-value">{{resultFilters.workGroup}}</view>
            </picker>
          </view>
          <view class="field field-half">
            <view class="field-label">结果视图</view>
            <picker range="{{resultViewOptions}}" range-key="label" bindchange="onResultFilterChange" data-field="viewMode">
              <view class="picker-value">{{resultViewLabel}}</view>
            </picker>
          </view>
        </view>
        <view class="field">
          <view class="field-label">排序方式</view>
          <picker range="{{resultSortOptions}}" range-key="label" bindchange="onResultFilterChange" data-field="sortMode">
            <view class="picker-value">{{resultSortLabel}}</view>
          </picker>
        </view>
        <view class="button-row compact-row">
          <button class="secondary-btn ui-motion-button" loading="{{loadingMap.results}}" bindtap="reloadScoreResults" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">重算并刷新</button>

        </view>
        <view class="filter-loading-bar" wx:if="{{loadingMap.results}}">
          <view class="filter-loading-spinner"></view>
          <text class="filter-loading-text">正在加载评分结果...</text>
        </view>
      </view>

      <view class="edit-box" wx:if="{{canExportScoreResults}}">
        <view class="list-title">总分速览导出</view>
        <view class="button-row">
          <button class="secondary-btn ui-motion-button" loading="{{loadingMap.export_overview}}" data-report="overview" bindtap="exportScoreResultsUnified" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">总分速览导出</button>
        </view>
      </view>

      <view class="edit-box" wx:if="{{canExportScoreResults}}">
        <view class="list-title">评分明细导出</view>
        <view class="button-row">
          <button class="secondary-btn ui-motion-button" loading="{{loadingMap.export_detail}}" data-report="detail" bindtap="exportScoreResultsUnified" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">评分明细导出</button>
        </view>
      </view>

      <view class="edit-box" wx:if="{{canExportScoreResults}}">
        <view class="list-title">完成率导出</view>
        <view class="button-row">
          <button class="secondary-btn ui-motion-button" loading="{{loadingMap.export_completion}}" data-report="completion" bindtap="exportScoreResultsUnified" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">完成率导出</button>
        </view>
      </view>

      <view class="list-card" wx:if="{{resultFilters.viewMode === 'overview'}}">
        <view class="list-title">明细查看</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}"
          class="inner-scroll large-scroll"
          scroll-y
        >
          <view class="card-loading-overlay" wx:if="{{loadingMap.results}}">
            <view class="card-loading-spinner"></view>
          </view>
          <block wx:else>
            <!-- Card-based layout with staggered entrance animations (matches user-side style) -->
            <view class="ranked-list" wx:if="{{scoreResultsView.overviewRows.length}}">
              <view class="rank-card rank-card-{{index === 0 ? 'gold' : (index === 1 ? 'silver' : (index === 2 ? 'bronze' : 'normal'))}} ui-motion-card"
                wx:for="{{scoreResultsView.overviewRows}}" wx:key="id"
                style="animation-delay: {{0.04 * index}}s;"
                data-target-id="{{item.targetId || item.id}}"
                bindtap="openTargetScoreRecords" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">

                <!-- Rank badge -->
                <view class="rank-badge rank-badge-{{index === 0 ? 'gold' : (index === 1 ? 'silver' : (index === 2 ? 'bronze' : 'normal'))}}">
                  <text wx:if="{{index === 0}}">🥇</text>
                  <text wx:elif="{{index === 1}}">🥈</text>
                  <text wx:elif="{{index === 2}}">🥉</text>
                  <text wx:else>{{index + 1}}</text>
                </view>

                <!-- Member info -->
                <view class="member-info">
                  <view class="member-name">{{item.name}}</view>
                  <view class="member-detail">{{item.identity}}<text wx:if="{{item.department}}"> · {{item.department}}</text><text wx:if="{{item.workGroup}}"> · {{item.workGroup}}</text></view>
                  <!-- Progress bar inline -->
                  <view class="progress-row">
                    <view class="progress-track">
                      <view class="progress-fill" style="{{item.progressFillStyle}}"></view>
                    </view>
                    <text class="progress-nums">{{item.progressText}} ({{item.progressPercentText}})</text>
                  </view>
                </view>

                <!-- Score display -->
                <view class="score-display">
                  <view class="score-value">{{item.finalScoreDisplay}}</view>
                  <view class="score-label">得分</view>
                </view>
              </view>
            </view>
            <view class="empty-inline" wx:if="{{!scoreResultsView.overviewRows.length}}">暂无总分结果</view>
          </block>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
      </view>

      <view class="list-card" wx:if="{{resultFilters.viewMode === 'overview' && selectedResultTarget}}">
        <view class="popup-header result-drill-header ui-dialog-header">
          <view class="list-title">{{selectedResultTarget.name}}的评分情况</view>
          <text class="popup-close ui-motion-chip" bindtap="closeTargetScoreRecords" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">收起</text>
        </view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}"
          class="inner-scroll large-scroll"
          scroll-y
          lower-threshold="80"
          bindscrolltolower="loadMoreScoreResults"
        >
          <view
            class="list-item scorer-result-card {{item.canViewDetail ? 'scorer-result-card-clickable' : ''}} ui-motion-card"
            wx:for="{{targetRecordRows}}"
            wx:key="scorerKey"
            data-record-id="{{item.recordId}}"
            bindtap="openScoreRecordDetail"
            hover-class="ui-press-card"
            hover-start-time="0"
            hover-stay-time="160"
           hover-stop-propagation="{{true}}">
            <view class="list-main">
              <view class="scorer-card-title">
                <view class="list-name scorer-name">{{item.scorerName}}</view>
                <view class="status-chip scorer-inline-status {{item.statusClass}}">{{item.statusText}}</view>
              </view>
              <view class="scorer-meta-lines">
                <view class="list-desc">部门：{{item.departmentText}}</view>
                <view class="list-desc">身份：{{item.identityText}}</view>
                <view class="list-desc" wx:if="{{item.workGroupText}}">职能组：{{item.workGroupText}}</view>
              </view>
              <view class="list-desc submitted-text" wx:if="{{item.submittedAt}}">{{item.submittedAt}}</view>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{targetRecordLoading}}">正在加载评分情况...</view>
          <view class="empty-inline" wx:if="{{!targetRecordLoading && !targetRecordRows.length}}">当前暂无评分记录。</view>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
      </view>

      <view class="list-card" wx:if="{{resultFilters.viewMode === 'completion'}}">
        <view class="list-title">完成率看板</view>
        <view class="card-loading-overlay" wx:if="{{loadingMap.results}}">
          <view class="card-loading-spinner"></view>
        </view>
        <block wx:else>
          <view class="stats-grid stats-grid-completion">
            <view class="stat-card stat-card-clickable {{selectedCompletionDepartment === item.groupName ? 'stat-card-selected' : ''}} ui-motion-card" wx:for="{{scoreResultsView.completionBoards.departments}}" wx:key="groupName" data-group-name="{{item.groupName}}" bindtap="toggleDepartmentScorers" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
              <view class="stat-card-top">
                <view class="stat-group-name">{{item.groupName}}</view>
                <view class="stat-value stat-value-large">{{item.progressPercentText}}</view>
              </view>
              <view class="completion-progress">
                <view class="progress-top">
                  <text class="progress-count">{{item.completionText}}</text>
                </view>
                <view class="progress-track">
                  <view class="progress-fill" style="{{item.progressFillStyle}}"></view>
                </view>
              </view>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!scoreResultsView.completionBoards.departments.length}}">暂无完成率</view>
        </block>
      </view>

      <view class="list-card" wx:if="{{resultFilters.viewMode === 'completion' && selectedCompletionDepartment}}">
        <view class="popup-header result-drill-header ui-dialog-header">
          <view class="list-title">{{selectedCompletionDepartment}}评分人完成情况</view>
          <text class="popup-close ui-motion-chip" bindtap="closeDepartmentScorers" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">收起</text>
        </view>
        <view class="card-loading-overlay" wx:if="{{departmentScorerLoading}}">
          <view class="card-loading-spinner"></view>
        </view>
        <block wx:else>
          <view class="result-table ui-data-grid--complex">
            <view class="result-table-head ui-data-row ui-data-row--header">
              <view class="result-col result-col-popup-name ui-data-cell ui-data-cell--primary">评分人</view>
              <view class="result-col result-col-popup-detail ui-data-cell">具体信息</view>
              <view class="result-col result-col-popup-progress ui-data-cell">已评/应评</view>
              <view class="result-col result-col-popup-status ui-data-cell">状态</view>
            </view>
            <view class="result-table-row result-table-row-clickable ui-motion-chip ui-data-row" wx:for="{{departmentScorerRows}}" wx:key="scorerKey" data-scorer-key="{{item.scorerKey}}" bindtap="openScorerTargetPopup" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
              <view class="result-col result-col-popup-name ui-data-cell ui-data-cell--primary">
                <text class="ui-data-cell-label">评分人</text>
                <view class="ui-data-cell-content"><view class="result-name">{{item.scorerName}}</view><view class="result-meta">{{item.scorerStudentId}}</view></view>
              </view>
              <view class="result-col result-col-popup-detail ui-data-cell">
                <text class="ui-data-cell-label">具体信息</text>
                <view class="result-meta result-meta-strong ui-data-cell-content">{{item.detailText}}</view>
              </view>
              <view class="result-col result-col-popup-progress ui-data-cell">
                <text class="ui-data-cell-label">完成进度</text>
                <view class="progress-cell ui-data-cell-content">
                  <view class="progress-top">
                    <text class="progress-count">{{item.completionText}}</text>
                    <text class="progress-percent">{{item.progressPercentText}}</text>
                  </view>
                  <view class="progress-track">
                    <view class="progress-fill" style="{{item.progressFillStyle}}"></view>
                  </view>
                </view>
              </view>
              <view class="result-col result-col-popup-status ui-data-cell">
                <text class="ui-data-cell-label">状态</text>
                <view class="status-chip {{item.statusClass}}">{{item.statusText}}</view>
              </view>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!departmentScorerRows.length}}">暂无评分人</view>
        </block>
      </view>

    </view>

    <view class="section" wx:if="{{activeTab === 'hrInfo' || activeTab === 'hrTemplates'}}">
      <view class="section-title">{{activeTab === 'hrTemplates' ? '人事模板' : '人事信息'}}</view>
      <view class="toolbar-row" wx:if="{{activeTab === 'hrInfo'}}">
        <button class="primary-btn ui-motion-button" wx:if="{{canManageHrPeople}}" bindtap="startCreateHr" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">新增成员</button>
        <button class="secondary-btn ui-motion-button" wx:if="{{canImportHr}}" loading="{{loadingMap.importCsv}}" bindtap="chooseTable" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">导入表格</button>
        <button class="secondary-btn ui-motion-button" wx:if="{{canManageHrPeople}}" loading="{{loadingMap.batchMaintain}}" bindtap="batchMaintainFromHrInfo" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">同步组织字典</button>
        <view class="csv-tip" wx:if="{{csvName}}">{{csvName}}</view>
      </view>

      <view class="edit-box" wx:if="{{activeTab === 'hrInfo' && showAddEditForm && canManageHrPeople}}">
        <view class="edit-box-header">
          <view>
            <view class="list-title">新增成员</view>
            <view class="field-hint">保存后继续添加岗位身份和补充资料。</view>
          </view>
          <text class="link ui-motion-chip" bindtap="toggleAddEditForm" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">收起</text>
        </view>
        <view class="field">
          <view class="field-label">姓名</view>
          <input class="field-input" data-field="name" bindinput="onHrFieldInput" value="{{hrForm.name}}" placeholder="请输入姓名" />
        </view>
        <view class="field">
          <view class="field-label">学号</view>
          <input class="field-input" data-field="studentId" bindinput="onHrFieldInput" value="{{hrForm.studentId}}" placeholder="请输入学号" />
        </view>
        <view class="button-row compact-row">
          <button class="primary-btn ui-motion-button" loading="{{loadingMap.saveHr}}" bindtap="saveHr" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存并完善资料</button>
          <button class="secondary-btn ui-motion-button" bindtap="resetHrForm" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">重置</button>
        </view>
      </view>

      <view class="edit-box hr-template-editor" wx:if="{{activeTab === 'hrTemplates' && showHrTemplateEditor && canManageHrProfileTemplates}}">
        <view class="edit-box-header">
        <view class="list-title">{{hrProfileTemplateForm.id ? '编辑人事模板' : '创建人事模板'}}</view>
          <text class="link ui-motion-chip" bindtap="cancelHrProfileTemplateEditor" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</text>
        </view>
        <view class="field">
          <view class="field-label">模板名称</view>
          <input class="field-input" data-field="name" bindinput="onHrProfileTemplateInput" value="{{hrProfileTemplateForm.name}}" placeholder="请输入不重复的模板名称" />
        </view>
        <view class="field">
          <view class="field-label">填写说明</view>
          <textarea class="field-textarea" auto-height maxlength="-1" data-field="description" bindinput="onHrProfileTemplateInput" value="{{hrProfileTemplateForm.description}}" placeholder="填写说明（选填）" />
        </view>
        <view class="field">
          <view class="field-label">成员修改方式</view>
          <picker range="{{profileEditModeOptions}}" range-key="label" bindchange="onHrProfileEditModeChange">
            <view class="picker-value">{{hrProfileTemplateForm.editModeLabel}}</view>
          </picker>
        </view>
        <view class="list-card nested-card">
          <view class="list-title">补充资料</view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y lower-threshold="80" bindscrolltolower="loadMoreScoreResults">
            <view class="question-card" wx:for="{{hrProfileTemplateForm.fields}}" wx:key="id">
              <view class="question-title">资料项 {{index + 1}}</view>
              <view class="field">
                <view class="field-label">资料项名称</view>
                <input class="field-input" data-index="{{index}}" data-field="label" bindinput="onHrProfileFieldInput" value="{{item.label}}" placeholder="如：宿舍号" />
              </view>
              <view class="field">
                <view class="field-label">填写方式</view>
                <picker range="{{profileFieldTypeOptions}}" range-key="label" bindchange="onHrProfileFieldTypeChange" data-index="{{index}}">
                  <view class="picker-value">{{item.typeLabel}}</view>
                </picker>
              </view>
              <view class="field">
                <view class="field-label">必填</view>
                <switch checked="{{item.required}}" color="#2563eb" data-index="{{index}}" bindchange="onHrProfileFieldRequiredChange" />
              </view>
              <view class="field field-row" wx:if="{{item.type === 'text'}}">
                <view class="field field-half">
                  <view class="field-label">最短长度</view>
                  <input class="field-input" data-index="{{index}}" data-field="minLength" bindinput="onHrProfileFieldInput" value="{{item.minLength}}" placeholder="可留空" />
                </view>
                <view class="field field-half">
                  <view class="field-label">最大长度</view>
                  <input class="field-input" data-index="{{index}}" data-field="maxLength" bindinput="onHrProfileFieldInput" value="{{item.maxLength}}" placeholder="可留空" />
                </view>
              </view>
              <view wx:if="{{item.type === 'number'}}">
                <view class="field">
                  <view class="field-label">数字要求</view>
                  <picker range="{{numberRuleOptions}}" range-key="label" bindchange="onHrProfileNumberRuleChange" data-index="{{index}}">
                    <view class="picker-value">{{item.numberRuleLabel}}</view>
                  </picker>
                </view>
                <view class="field">
                  <view class="field-label">允许小数</view>
                  <switch checked="{{item.allowDecimal}}" color="#2563eb" data-index="{{index}}" bindchange="onHrProfileFieldAllowDecimalChange" />
                </view>
                <view class="field field-row" wx:if="{{item.numberRule === 'value_range'}}">
                  <view class="field field-half">
                    <view class="field-label">最小值</view>
                    <input class="field-input" data-index="{{index}}" data-field="minValue" bindinput="onHrProfileFieldInput" value="{{item.minValue}}" placeholder="可留空" />
                  </view>
                  <view class="field field-half">
                    <view class="field-label">最大值</view>
                    <input class="field-input" data-index="{{index}}" data-field="maxValue" bindinput="onHrProfileFieldInput" value="{{item.maxValue}}" placeholder="可留空" />
                  </view>
                </view>
                <view class="field field-row" wx:if="{{item.numberRule === 'length_range'}}">
                  <view class="field field-half">
                    <view class="field-label">最短长度</view>
                    <input class="field-input" data-index="{{index}}" data-field="minDigits" bindinput="onHrProfileFieldInput" value="{{item.minDigits}}" placeholder="可留空" />
                  </view>
                  <view class="field field-half">
                    <view class="field-label">最长长度</view>
                    <input class="field-input" data-index="{{index}}" data-field="maxDigits" bindinput="onHrProfileFieldInput" value="{{item.maxDigits}}" placeholder="可留空" />
                  </view>
                </view>
              </view>
              <view class="field" wx:if="{{item.type === 'sequence'}}">
                <view class="field-label">可选内容</view>
                <textarea class="field-textarea question-textarea" auto-height maxlength="-1" data-index="{{index}}" data-field="optionsText" bindinput="onHrProfileFieldInput" value="{{item.optionsText}}" placeholder="每行一个选项" />
              </view>
              <view class="button-row compact-row">
                <button class="secondary-btn ui-motion-button" data-index="{{index}}" bindtap="removeHrProfileField" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">删除资料项</button>
              </view>
            </view>
          </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
        </view>
        <view class="button-row hr-template-editor-actions">
          <button class="secondary-btn hr-template-editor-btn ui-motion-button" bindtap="addHrProfileField" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">新增资料项</button>
          <button class="secondary-btn hr-template-editor-btn ui-motion-button" loading="{{loadingMap.importTemplateFieldsCsv}}" bindtap="importTableFields" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">从表格导入</button>
          <button class="primary-btn template-save-btn hr-template-editor-btn hr-template-editor-save ui-motion-button" loading="{{loadingMap.saveProfileTemplate}}" bindtap="saveHrProfileTemplate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存人事模板</button>
        </view>
      </view>

      <view class="hr-template-workspace" wx:if="{{activeTab === 'hrTemplates'}}">
        <view class="list-card hr-template-current-card">
          <view class="list-card-header hr-template-library-header">
            <view>
              <view class="list-title">当前人事模板</view>
            </view>
            <view class="status-chip current-chip" wx:if="{{activeHrProfileSnapshot}}">使用中</view>
          </view>
          <view class="hr-template-empty" wx:if="{{!activeHrProfileSnapshot}}">尚未选择模板</view>
          <block wx:else>
            <view class="hr-template-meta">{{activeHrProfileSnapshot.fields.length}} 项资料 · {{activeHrProfileSnapshot.editMode === 'audit' ? '修改后审核' : activeHrProfileSnapshot.editMode === 'readonly' ? '由管理员维护' : '可直接修改'}}</view>
            <view class="hr-snapshot-fields">
              <view class="hr-snapshot-fields-head">
                <view class="hr-snapshot-fields-title">补充资料</view>
              </view>
              <view class="hr-snapshot-field" wx:for="{{activeHrProfileSnapshot.fields}}" wx:key="id">
                <view class="hr-snapshot-field-order">{{index + 1}}</view>
                <view class="hr-snapshot-field-main">
                  <view class="hr-snapshot-field-name">{{item.label}}</view>
                  <view class="hr-snapshot-field-rule" wx:if="{{item.ruleText}}">{{item.ruleText}}</view>
                </view>
                <view class="hr-snapshot-field-tags">
                  <view class="hr-snapshot-type-tag">{{item.typeLabel}}</view>
                  <view class="hr-snapshot-required-tag" wx:if="{{item.required}}">必填</view>
                </view>
              </view>
              <view class="empty-inline" wx:if="{{!activeHrProfileSnapshot.fields.length}}">暂无补充资料</view>
            </view>
            <view class="field" wx:if="{{canSelectHrProfileTemplate}}">
              <view class="field-label">本组织填写说明</view>
              <textarea class="field-textarea" auto-height maxlength="-1" data-field="description" bindinput="onActiveHrProfileSettingInput" value="{{activeHrProfileSnapshot.description}}" placeholder="填写本组织说明" />
            </view>
            <view class="field" wx:if="{{canSelectHrProfileTemplate}}">
              <view class="field-label">成员修改方式</view>
              <picker range="{{profileEditModeOptions}}" range-key="label" bindchange="onActiveHrProfileModeChange">
                <view class="picker-value">{{activeHrProfileSnapshot.editMode === 'audit' ? '提交后审核' : activeHrProfileSnapshot.editMode === 'readonly' ? '由管理员维护' : '可直接修改'}}</view>
              </picker>
            </view>
            <button class="primary-btn ui-motion-button" wx:if="{{canSelectHrProfileTemplate}}" loading="{{loadingMap.saveActiveHrProfileSettings}}" bindtap="saveActiveHrProfileSettings" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">保存组织设置</button>
          </block>
        </view>

        <view class="list-card">
          <view class="list-card-header">
            <view>
               <view class="list-title">人事模板</view>
            </view>
            <button class="primary-btn hr-template-add-btn ui-motion-button" wx:if="{{canManageHrProfileTemplates}}" bindtap="startCreateHrProfileTemplate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">创建模板</button>
          </view>
          <view class="hr-template-card" wx:for="{{hrProfileTemplateList}}" wx:key="id">
            <view class="hr-template-card-head">
              <view>
                <view class="hr-template-card-name">{{item.name}}</view>
                <view class="hr-template-meta">{{item.fieldCount}} 项资料</view>
              </view>
            </view>
            <view class="hr-template-description">{{item.description || '暂无填写说明'}}</view>
            <view class="hr-template-actions">
              <button class="primary-btn hr-template-action hr-template-action-primary ui-motion-button" wx:if="{{canSelectHrProfileTemplate}}" data-id="{{item.id}}" loading="{{loadingMap.hrTemplateSwitch}}" bindtap="startHrProfileTemplateSwitch" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">应用模板</button>
              <button class="secondary-btn hr-template-action ui-motion-button" wx:if="{{canManageHrProfileTemplates}}" data-id="{{item.id}}" bindtap="editHrProfileTemplate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">编辑</button>
              <button class="secondary-btn hr-template-action ui-motion-button" wx:if="{{canManageHrProfileTemplates}}" data-id="{{item.id}}" bindtap="duplicateHrProfileTemplate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">复制</button>
              <button class="danger-btn hr-template-action hr-template-action-danger ui-motion-button" wx:if="{{canManageHrProfileTemplates}}" data-id="{{item.id}}" bindtap="deleteHrProfileTemplate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">删除</button>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!loadingMap.hrProfileTemplates && !hrProfileTemplateList.length}}">暂无共享人事模板</view>
        </view>
      </view>

      <view class="list-card" wx:if="{{activeTab === 'hrInfo'}}">
        <view class="list-card-header hr-member-list-header">
          <view class="list-title">成员资料</view>
          <button class="secondary-btn hr-profile-export-btn ui-motion-button" wx:if="{{canBrowseHrInfo}}" loading="{{loadingMap.exportHrProfiles}}" bindtap="exportHrProfiles" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">导出成员资料</button>
        </view>
        <view class="filter-row">
          <view class="field field-half">
            <view class="field-label">部门</view>
            <picker range="{{hrProfileFilterOptions.departments}}" bindchange="onHrProfileFilterChange" data-field="departments">
              <view class="picker-value">{{hrProfileFilters.department}}</view>
            </picker>
          </view>
          <view class="field field-half">
            <view class="field-label">身份</view>
            <picker range="{{hrProfileFilterOptions.identities}}" bindchange="onHrProfileFilterChange" data-field="identities">
              <view class="picker-value">{{hrProfileFilters.identity}}</view>
            </picker>
          </view>
        </view>
        <view class="filter-row">
          <view class="field field-half">
            <view class="field-label">工作分工（职能组）</view>
            <picker range="{{hrProfileFilterOptions.workGroups}}" bindchange="onHrProfileFilterChange" data-field="workGroups">
              <view class="picker-value">{{hrProfileFilters.workGroup !== '无' ? hrProfileFilters.workGroup : (hrProfileFilters.department === '全部部门' ? '请先选择所属部门' : '请选择工作分工')}}</view>
            </picker>
          </view>
          <view class="field field-half">
            <view class="field-label">审核状态</view>
            <picker range="{{hrProfileFilterOptions.statuses}}" bindchange="onHrProfileFilterChange" data-field="statuses">
              <view class="picker-value">{{hrProfileFilters.status}}</view>
            </picker>
          </view>
        </view>
        <view class="field">
          <view class="field-label">搜索</view>
          <input class="field-input search-input" bindinput="onHrProfileKeywordInput" value="{{_hrInfoKeywordInput}}" placeholder="输入姓名或学号搜索..." />
        </view>
        <view class="button-row compact-row">
          <button class="secondary-btn ui-motion-button" bindtap="resetHrProfileFilters" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">重置筛选</button>
        </view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y lower-threshold="80" bindscrolltolower="loadMoreScoreResults">
          <view class="card-loading-overlay" wx:if="{{loadingMap.hr}}">
            <view class="card-loading-spinner"></view>
          </view>
          <block wx:else>
          <view class="hr-member-card ui-motion-card" wx:for="{{hrProfileRows}}" wx:key="id" data-hr-id="{{item.id}}" bindtap="openHrPersonDetail" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="hr-member-main">
              <view class="hr-member-top">
                <view class="hr-member-person">
                  <view class="hr-member-name">{{item.name}}</view>
                  <view class="hr-member-id">{{item.studentId}}</view>

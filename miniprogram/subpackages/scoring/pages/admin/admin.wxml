    <!-- HR table import read-only preview -->
    <view class="modal-mask ui-overlay" wx:if="{{showHrImportPreview}}" bindtap="closeHrImportPreview" catchtouchmove="noop">
      <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
      <view class="modal-card hr-import-preview-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
        <view class="modal-header ui-dialog-header">
          <view>
            <view class="modal-title">导入检查</view>
            <view class="hr-import-preview-source">{{hrImportPreview.fileName}} · {{hrImportPreview.sheetName}}</view>
          </view>
          <view class="modal-close ui-motion-chip" catchtap="closeHrImportPreview" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">✕</view>
        </view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="modal-body hr-import-preview-body ui-dialog-body ui-dialog-scroll--fill" scroll-y>
          <view class="hr-import-preview-stats">
            <view class="hr-import-preview-stat"><text>表格记录</text><text class="hr-import-preview-stat-value">{{hrImportPreview.totalRows}}</text></view>
            <view class="hr-import-preview-stat is-success"><text>可导入</text><text class="hr-import-preview-stat-value">{{hrImportPreview.validRows}}</text></view>
            <view class="hr-import-preview-stat is-warning"><text>有问题</text><text class="hr-import-preview-stat-value">{{hrImportPreview.invalidRows}}</text></view>
            <view class="hr-import-preview-stat"><text>新增 / 更新</text><text class="hr-import-preview-stat-value">{{hrImportPreview.newRecords}} / {{hrImportPreview.updateRecords}}</text></view>
          </view>

          <view class="hr-import-preview-warning" wx:if="{{hrImportPreview.invalidRows > 0}}">
            {{hrImportPreview.invalidRows}} 条记录有误。{{hrImportPreview.skipInvalid ? '将只导入可用记录。' : '请修改表格，或选择忽略问题记录。'}}
          </view>

          <view class="hr-import-preview-section">
            <view class="hr-import-preview-heading">导入内容</view>
            <view class="hr-import-preview-mapping" wx:for="{{hrImportPreview.mappings}}" wx:key="columnKey">
              <view class="hr-import-preview-column">{{item.header}}</view>
              <view class="hr-import-preview-arrow">→</view>
              <view class="hr-import-preview-target">
                <text>{{item.targetLabel}}</text>
                <text class="hr-import-preview-type">{{item.targetTypeLabel}}</text>
              </view>
            </view>
          </view>

          <view class="hr-import-preview-section" wx:if="{{hrImportPreview.ignoredColumns.length}}">
            <view class="hr-import-preview-heading">不导入的表格列</view>
            <view class="hr-import-preview-chips">
              <text class="hr-import-preview-chip is-muted" wx:for="{{hrImportPreview.ignoredColumns}}" wx:key="columnKey">{{item.header}}</text>
            </view>
          </view>

          <view class="hr-import-preview-section">
            <view class="hr-import-preview-heading">将新增的组织资料</view>
            <view class="hr-import-preview-dict-row">
              <text class="hr-import-preview-dict-label">部门 {{hrImportPreview.newDepartments.length}}</text>
              <view class="hr-import-preview-chips" wx:if="{{hrImportPreview.newDepartments.length}}">
                <text class="hr-import-preview-chip" wx:for="{{hrImportPreview.newDepartments}}" wx:key="*this">{{item}}</text>
              </view>
              <text class="hr-import-preview-empty" wx:else>无需新建</text>
            </view>
            <view class="hr-import-preview-dict-row">
              <text class="hr-import-preview-dict-label">身份 {{hrImportPreview.newIdentities.length}}</text>
              <view class="hr-import-preview-chips" wx:if="{{hrImportPreview.newIdentities.length}}">
                <text class="hr-import-preview-chip" wx:for="{{hrImportPreview.newIdentities}}" wx:key="*this">{{item}}</text>
              </view>
              <text class="hr-import-preview-empty" wx:else>无需新建</text>
            </view>
            <view class="hr-import-preview-dict-row">
              <text class="hr-import-preview-dict-label">工作分工（职能组） {{hrImportPreview.newWorkGroups.length}}</text>
              <view class="hr-import-preview-chips" wx:if="{{hrImportPreview.newWorkGroups.length}}">
                <text class="hr-import-preview-chip" wx:for="{{hrImportPreview.newWorkGroups}}" wx:key="*this">{{item}}</text>
              </view>
              <text class="hr-import-preview-empty" wx:else>留空，不创建</text>
            </view>
          </view>

          <view class="hr-import-preview-note" wx:if="{{hrImportPreview.preservedEmptyFields > 0}}">
            空单元格将保留原有内容。
          </view>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
        <view class="modal-footer csv-mapping-footer ui-dialog-footer">
          <button class="secondary-btn ui-motion-button" catchtap="cancelHrImportPreview" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">返回修改</button>
          <button class="primary-btn ui-motion-button" disabled="{{!hrImportPreview.canImport}}" loading="{{csvImportLoading}}" catchtap="confirmHrTableImport" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">确认导入</button>
        </view>
      </view>
    </view>

    <!-- Validation errors dialog -->
    <view class="modal-mask ui-overlay" wx:if="{{showValidationErrors}}" bindtap="closeValidationErrors" catchtouchmove="noop">
      <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
      <view class="modal-card validation-errors-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
        <view class="modal-header ui-dialog-header">
          <view class="modal-title">请检查表格内容</view>
          <view class="modal-close ui-motion-chip" catchtap="closeValidationErrors" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">✕</view>
        </view>
        <view class="validation-errors-summary">{{validationErrorSummary}}，请修正后重新导入</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="modal-body validation-errors-body ui-dialog-body ui-dialog-scroll--fill" scroll-y>
          <view class="validation-error-card" wx:for="{{validationErrorCards}}" wx:key="studentId">
            <view class="ve-card-top">
              <view class="ve-card-name">{{item.name || '—'}}</view>
              <view class="ve-card-sid">{{item.studentId}}</view>
            </view>
            <view class="ve-card-errors">
              <view class="ve-error-item" wx:for="{{item.errors}}" wx:key="index" wx:for-item="err">
                <view class="ve-error-label">
                  <text class="ve-error-field">{{err.fieldName}}</text>
                  <text class="ve-error-type-tag">{{err.fieldType}}</text>
                </view>
                <view class="ve-error-detail">
                  <text class="ve-error-reason">{{err.errorReason}}</text>
                  <text class="ve-error-value" wx:if="{{err.errorValue}}">当前值：{{err.errorValue}}</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view><view class="scroll-hint"><view class="scroll-hint-dot"></view></view>
        <view class="modal-footer ui-dialog-footer">
          <button class="secondary-btn ui-motion-button" catchtap="downloadErrorTable" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">导出问题清单</button>
          <button class="primary-btn ui-motion-button" catchtap="closeValidationErrors" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</button>
        </view>
      </view>
    </view>



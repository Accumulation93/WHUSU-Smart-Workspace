    <!-- Validation errors dialog -->
    <view class="modal-mask" wx:if="{{showValidationErrors}}" bindtap="closeValidationErrors">
      <view class="modal-card validation-errors-card" catchtap>
        <view class="modal-header">
          <view class="modal-title">数据校验失败</view>
          <view class="modal-close" bindtap="closeValidationErrors">✕</view>
        </view>
        <view class="validation-errors-summary">{{validationErrorSummary}}，请修正后重新导入</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="modal-body validation-errors-body" scroll-y>
          <view class="validation-error-card" wx:for="{{validationErrorCards}}" wx:key="studentId">

                <!-- Collapsed: colored bubble -->
                <view class="grade-band-collapsed ui-motion-chip" wx:if="{{expandedGradeBandIndex !== index}}" data-index="{{index}}" bindtap="toggleGradeBandExpand" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
                  <view class="grade-band-bubble" style="background: {{gradeBandWxs.getColor(item.gradeName)}};">

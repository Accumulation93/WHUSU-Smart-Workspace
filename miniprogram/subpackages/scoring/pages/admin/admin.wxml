          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="target-scroll" style="max-height:500rpx;">
            <view class="list-item rule-list-item" wx:for="{{pubMeritRuleListView}}" wx:key="id">
              <view class="list-main">
                <view class="rule-list-action-row">
                  <view class="select-chip {{pubMeritRuleSelectedIds[item.id] ? 'select-chip-active' : ''}} ui-motion-chip" data-id="{{item.id}}" catchtap="togglePubMeritRuleSelection" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{pubMeritRuleSelectedIds[item.id] ? '已选' : '选择'}}</view>
                  <view class="inline-actions rule-list-inline-actions"><text class="link ui-motion-chip" data-id="{{item.id}}" bindtap="editPubMeritRule" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text><text class="link danger ui-motion-chip" data-id="{{item.id}}" bindtap="deletePubMeritRule" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">删除</text></view>
                </view>
                <view class="rule-list-info"><view class="rule-list-main-line"><text class="rule-info-text">{{item.granteeDepartment}} / {{item.granteeIdentity}}</text></view><view class="rule-list-meta"><text class="rule-tag tag-scope">{{item.clauseCount || item.clauses.length || 0}} 条评优规则</text></view></view>
              </view>
            </view>
            <view class="rule-empty small-empty" wx:if="{{!pubMeritRuleListView.length}}">暂无评优指定权类别</view>
          </scroll-view>
        </view>
      </view>

      <!-- ═══ 评优名单汇总（Feature 5） ═══ -->
      <view class="rule-panel merit-summary-panel" wx:if="{{publicationForm.id}}" style="margin-top:28rpx;">
        <view class="rule-panel-head">
          <view class="rule-panel-head-row">
            <view>
              <view class="rule-panel-title">评优名单汇总</view>
            </view>
          </view>
          <view class="merit-summary-head-bar" wx:if="{{meritSummaryGroups.length}}">
            <view class="merit-summary-total-chip">共 {{meritSummaryGroups.length}} 组</view>
            <view class="merit-export-btn-wrap">
              <button class="secondary-btn ui-motion-button" loading="{{loadingMap.exportMeritSummary}}" bindtap="exportMeritListSummary" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">导出表格</button>
            </view>
          </view>
        </view>

        <!-- 筛选条（玻璃风格） -->
        <view class="merit-summary-filter-bar" wx:if="{{meritSummaryGroups.length}}">
          <view class="merit-summary-filter-field">
            <text class="merit-summary-filter-label">部门</text>
            <picker range="{{meritSummaryDeptOptions}}" bindchange="onMeritSummaryFilterChange" data-field="department">
              <view class="merit-summary-filter-value">{{meritSummaryFilterDept}}</view>
            </picker>
          </view>
          <view class="merit-summary-filter-field">
            <text class="merit-summary-filter-label">身份</text>
            <picker range="{{meritSummaryIdentOptions}}" bindchange="onMeritSummaryFilterChange" data-field="identity">
              <view class="merit-summary-filter-value">{{meritSummaryFilterIdent}}</view>
            </picker>
          </view>
          <view class="merit-summary-filter-field">
            <text class="merit-summary-filter-label">职能组</text>
            <picker range="{{meritSummaryWgOptions}}" bindchange="onMeritSummaryFilterChange" data-field="workGroup">
              <view class="merit-summary-filter-value">{{meritSummaryFilterWg}}</view>
            </picker>
          </view>
        </view>

        <view class="rule-empty glass-empty merit-summary-loading" wx:if="{{meritSummaryLoading}}">
          <view class="empty-desc">正在加载评优名单</view>
        </view>

        <view class="rule-empty glass-empty" wx:elif="{{meritSummaryLoadFailed}}">
          <view class="empty-title">暂未显示评优名单</view>
          <view class="empty-desc">请稍后刷新</view>
        </view>

        <view class="rule-empty glass-empty" wx:elif="{{meritSummaryLoaded && !meritSummaryGroups.length}}">
          <view class="empty-title">暂无评优名单</view>
          <view class="empty-desc">尚未指定人选</view>
        </view>

        <!-- 分组卡片 -->
        <view class="merit-group-card" wx:for="{{meritSummaryFilteredGroups}}" wx:key="clauseId" wx:for-item="group" wx:for-index="gi" style="animation: glassFadeUp 0.38s {{0.06 * gi}}s ease both;">
          <!-- Group header -->
          <view class="merit-group-head ui-motion-chip" data-clause-id="{{group.clauseId}}" bindtap="toggleMeritSummaryGroup" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="merit-group-head-accent" style="background: {{gradeBandWxs.getColor(group.targetIdentity)}};"></view>
            <view class="merit-group-head-body">
              <view class="merit-group-head-title">
                <text class="merit-title-dept">{{group.granteeDepartment}}</text>
              </view>
              <view class="merit-group-head-meta">
                <view class="merit-chip merit-chip-ident">{{group.targetIdentity}}</view>
                <view class="merit-chip merit-chip-count">{{group.memberCount}} 人</view>
                <view class="merit-chip merit-chip-quota" wx:if="{{group.quotaLimit > 0}}">名额 {{group.quotaLimit}}</view>
              </view>
            </view>
            <view class="merit-group-chevron {{expandedMeritSummaryClauseId === group.clauseId ? 'merit-group-chevron-open' : ''}}">
              <text>{{expandedMeritSummaryClauseId === group.clauseId ? '▴' : '▾'}}</text>
            </view>
          </view>
          <!-- Expanded member list -->
          <view class="merit-group-body" wx:if="{{expandedMeritSummaryClauseId === group.clauseId}}">
            <view class="merit-member-card" wx:for="{{group.members}}" wx:key="id" wx:for-item="m" style="animation: glassFadeUp 0.28s {{0.04 * index}}s ease both;">
              <view class="merit-member-accent" style="background: {{gradeBandWxs.getColor(group.targetIdentity)}};"></view>
              <view class="merit-member-body">
                <view class="merit-member-row">
                  <text class="merit-member-name">{{m.name}}</text>
                  <view class="merit-member-sid-chip"><text>{{m.studentId}}</text></view>
                </view>
                <view class="merit-member-tags">
                  <view class="merit-tag merit-tag-ident">{{m.identity}}</view>
                  <view class="merit-tag merit-tag-dept" wx:if="{{m.department}}">{{m.department}}</view>
                  <view class="merit-tag merit-tag-wg" wx:if="{{m.workGroup}}">{{m.workGroup}}</view>
                </view>
              </view>
            </view>
            <view class="empty-inline" wx:if="{{!group.members.length}}">没有匹配成员</view>
          </view>
        </view>
      </view>
    </view>
    <view class="section" wx:if="{{activeTab === 'auditTemplates'}}">
      <view class="edit-box">
        <view class="list-title">{{auditTemplateForm.id ? '编辑模板' : '新建模板'}}</view>
        <view class="field">
          <view class="field-label">模板名称</view>
          <input class="field-input" data-field="name" bindinput="onAuditTemplateFieldInput" value="{{auditTemplateForm.name}}" placeholder="请输入模板名称" />
        </view>
        <view class="field">
          <view class="field-label">描述说明</view>
          <textarea class="field-textarea" auto-height maxlength="-1" data-field="description" bindinput="onAuditTemplateFieldInput" value="{{auditTemplateForm.description}}" placeholder="请输入模板说明" />
        </view>
        <view class="field field-row">
        <view class="field field-half">
          <view class="field-label">驳回重提交模式</view>
          <picker range="{{['重新逐层审批','直接到驳回人']}}" bindchange="onResubmitModeChange">
            <view class="picker-value">{{auditTemplateForm.resubmitMode === 'fresh' ? '重新逐层审批' : '直接到驳回人'}}</view>
          </picker>
        </view>
      </view>

      <!-- Starter Conditions (multi-condition OR-ed) -->
      <view class="list-card nested-card" style="margin:0 0 16rpx;">
        <view class="list-title">可发起人（满足任一条件）</view>
        <view class="list-item" wx:for="{{auditTemplateForm.starterConditions}}" wx:key="index" wx:for-item="cond">
          <view class="list-main">
            <view class="list-name">{{cond.conditionType === 'person' ? '人员条件' : '身份范围条件'}}</view>
            <view class="chip-row" style="flex-wrap:wrap;">
              <block wx:if="{{cond.conditionType === 'person'}}">
                <view class="status-chip info-chip" wx:for="{{cond._personNames}}" wx:for-item="pname" wx:key="index" style="margin:2rpx;">{{pname}}</view>
                <view class="list-desc" wx:if="{{!cond._personNames || !cond._personNames.length}}" style="margin:2rpx;">未选择人员</view>
              </block>
              <block wx:else>
                <block wx:if="{{cond.departmentScope === 'own'}}">
                  <view class="status-chip info-chip" style="margin:2rpx;">同部门</view>
                </block>
                <block wx:elif="{{cond.departmentScope === 'specific'}}">
                  <view class="status-chip info-chip" wx:for="{{cond._deptNames}}" wx:for-item="dname" wx:key="index" style="margin:2rpx;">{{dname}}</view>
                  <view class="status-chip info-chip" wx:if="{{!cond._deptNames || !cond._deptNames.length}}" style="margin:2rpx;">指定部门</view>
                </block>
                <block wx:if="{{cond.workGroupScope === 'own'}}">
                  <view class="status-chip info-chip" style="margin:2rpx;">同职能组</view>
                </block>
                <block wx:elif="{{cond.workGroupScope === 'specific'}}">
                  <view class="status-chip info-chip" wx:for="{{cond._wgNames}}" wx:for-item="wname" wx:key="index" style="margin:2rpx;">{{wname}}</view>
                  <view class="status-chip info-chip" wx:if="{{!cond._wgNames || !cond._wgNames.length}}" style="margin:2rpx;">指定职能组</view>
                </block>
                <block wx:if="{{cond.identityScope === 'own'}}">
                  <view class="status-chip info-chip" style="margin:2rpx;">同身份</view>
                </block>
                <block wx:elif="{{cond.identityScope === 'specific'}}">
                  <view class="status-chip info-chip" wx:for="{{cond._identNames}}" wx:for-item="iname" wx:key="index" style="margin:2rpx;">{{iname}}</view>
                  <view class="status-chip info-chip" wx:if="{{!cond._identNames || !cond._identNames.length}}" style="margin:2rpx;">指定身份</view>
                </block>
                <view class="list-desc" wx:if="{{cond.departmentScope === 'all' && cond.workGroupScope === 'all' && cond.identityScope === 'all'}}" style="margin:2rpx;">不限（所有人）</view>
              </block>
            </view>
          </view>
          <view class="list-actions">
            <text class="link ui-motion-chip" data-index="{{index}}" bindtap="openStarterConditionEditor" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text>
            <text class="link danger-link ui-motion-chip" data-index="{{index}}" bindtap="removeStarterCondition" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text>
          </view>
        </view>
        <view class="empty-inline" wx:if="{{!auditTemplateForm.starterConditions.length}}" style="padding:0 24rpx;">任何人均可发起</view>
        <view class="button-row" style="padding:0 24rpx;">
          <button class="secondary-btn ui-motion-button" bindtap="openStarterConditionEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">添加发起条件</button>
        </view>
      </view>

        <view class="list-title" style="margin-top: 20rpx;">审批步骤（{{auditTemplateForm.steps.length}}步）</view>
        <view class="list-item" wx:for="{{auditTemplateForm.steps}}" wx:key="index">
          <view class="list-main">
            <view class="list-name">{{item.name || ('第' + (index + 1) + '步')}} — {{item.actionType === 'pass' ? '通过' : (item.actionType === 'sign' ? '签字' : (item.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
            <!-- Each condition as separate bubble chips, OR-separated -->
            <view wx:for="{{item.conditions}}" wx:for-item="cond" wx:for-index="ci" wx:key="ci" style="margin-top:6rpx;display:flex;flex-wrap:wrap;align-items:center;">
              <block wx:if="{{cond.conditionType === 'person'}}">
                <block wx:if="{{cond._personNames && cond._personNames.length}}">
                  <view class="status-chip info-chip" wx:for="{{cond._personNames}}" wx:for-item="pname" wx:key="index" style="margin:2rpx;">{{pname}}</view>
                </block>
                <view class="status-chip current-chip" wx:else style="margin:2rpx;">人员未选择</view>
              </block>
              <block wx:else>
                <block wx:if="{{cond.departmentScope === 'own'}}">
                  <view class="status-chip info-chip" style="margin:2rpx;">同部门</view>
                </block>
                <block wx:elif="{{cond.departmentScope === 'specific'}}">
                  <view class="status-chip info-chip" wx:for="{{cond._deptNames}}" wx:for-item="dname" wx:key="index" style="margin:2rpx;">{{dname}}</view>
                  <view class="status-chip info-chip" wx:if="{{!cond._deptNames || !cond._deptNames.length}}" style="margin:2rpx;">指定部门</view>
                </block>
                <block wx:if="{{cond.workGroupScope === 'own'}}">
                  <view class="status-chip info-chip" style="margin:2rpx;">同职能组</view>
                </block>
                <block wx:elif="{{cond.workGroupScope === 'specific'}}">
                  <view class="status-chip info-chip" wx:for="{{cond._wgNames}}" wx:for-item="wname" wx:key="index" style="margin:2rpx;">{{wname}}</view>
                  <view class="status-chip info-chip" wx:if="{{!cond._wgNames || !cond._wgNames.length}}" style="margin:2rpx;">指定职能组</view>
                </block>
                <block wx:if="{{cond.identityScope === 'own'}}">
                  <view class="status-chip info-chip" style="margin:2rpx;">同身份</view>
                </block>
                <block wx:elif="{{cond.identityScope === 'specific'}}">
                  <view class="status-chip info-chip" wx:for="{{cond._identNames}}" wx:for-item="iname" wx:key="index" style="margin:2rpx;">{{iname}}</view>
                  <view class="status-chip info-chip" wx:if="{{!cond._identNames || !cond._identNames.length}}" style="margin:2rpx;">指定身份</view>
                </block>
                <view class="list-desc" wx:if="{{cond.departmentScope === 'all' && cond.workGroupScope === 'all' && cond.identityScope === 'all'}}" style="margin:2rpx;">不限（所有人）</view>
              </block>
              <text wx:if="{{ci < item.conditions.length - 1}}" class="audit-or-sep">或</text>
            </view>
          </view>
          <view class="list-actions">
            <text class="link ui-motion-chip" data-index="{{index}}" bindtap="openAuditTemplateStepEditor" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text>
            <text class="link danger-link ui-motion-chip" data-index="{{index}}" bindtap="removeAuditTemplateStep" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text>
          </view>
        </view>
        <view class="button-row compact-row">
          <button class="secondary-btn ui-motion-button" bindtap="openAuditTemplateStepEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">添加步骤</button>
        </view>
        <view class="button-row" style="margin-top: 16rpx;">
          <button class="primary-btn ui-motion-button" loading="{{loadingMap.saveAuditTemplate}}" bindtap="saveAuditFlowTemplate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存模板</button>
          <button class="secondary-btn ui-motion-button" bindtap="startCreateAuditTemplate" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">新建模板</button>
        </view>
      </view>

      <view class="list-card">
        <view class="list-title">模板列表</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll medium-scroll" scroll-y>
          <view class="card-loading-overlay" wx:if="{{loadingMap.auditTemplates}}"><view class="card-loading-spinner"></view></view>
          <block wx:else>
          <view class="list-item audit-template-list-item" wx:for="{{auditFlowTemplates}}" wx:key="id">
            <view data-id="{{item.id}}" bindtap="toggleAuditTemplateExpand" style="display:flex;justify-content:space-between;width:100%;" hover-class="ui-press-chip ui-motion-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
              <view class="list-main">
                <view class="list-name">{{item.name}} <text class="list-desc">({{item.stepCount}}步 · {{item.resubmitMode === 'fresh' ? '重新逐层' : '回到驳回人'}})</text></view>
                <view class="list-desc" wx:if="{{item.description}}">{{item.description}}</view>
              </view>
              <view class="audit-expand-toggle">
                <text>{{auditExpandedTemplateId === item.id ? '收起 ▲' : '展开 ▼'}}</text>
              </view>
            </view>
            <view class="list-actions" style="position:absolute;right:80rpx;top:16rpx;">
              <text class="link ui-motion-chip" data-id="{{item.id}}" catchtap="editAuditTemplate" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text>
              <text class="link danger-link ui-motion-chip" data-id="{{item.id}}" catchtap="deleteAuditFlowTemplate" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">删除</text>
            </view>
            <!-- Expanded steps preview with bubble chips -->
            <view wx:if="{{auditExpandedTemplateId === item.id}}" class="audit-template-expanded">
              <view wx:for="{{item.steps}}" wx:for-item="step" wx:for-index="si" wx:key="si" class="audit-template-step-preview">
                <view class="audit-template-step-head">
                  <text style="font-weight:700;font-size:25rpx;color:#0f172a;">第{{si + 1}}步：</text>
                  <text style="font-size:21rpx;color:#64748b;margin-left:8rpx;">{{step.actionType === 'pass' ? '通过' : (step.actionType === 'sign' ? '签字' : (step.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</text>
                </view>
                <!-- Each condition as bubble chips -->
                <view wx:for="{{step._resolvedConditions}}" wx:for-item="cond" wx:for-index="ci" wx:key="ci" style="display:flex;flex-wrap:wrap;align-items:center;margin-left:12rpx;">
                  <block wx:if="{{cond.conditionType === 'person'}}">
                    <block wx:if="{{cond._personNames && cond._personNames.length}}">
                      <view wx:for="{{cond._personNames}}" wx:for-item="pname" wx:key="index" class="audit-cond-chip audit-cond-person">{{pname}}</view>
                    </block>
                    <view wx:else class="audit-cond-chip audit-cond-none">人员未选择</view>
                  </block>
                  <block wx:else>
                    <view wx:if="{{cond.departmentScope === 'own'}}" class="audit-cond-chip audit-cond-dept">同部门</view>
                    <view wx:for="{{cond._deptNames}}" wx:for-item="dname" wx:key="index" wx:if="{{cond.departmentScope === 'specific'}}" class="audit-cond-chip audit-cond-dept">{{dname}}</view>
                    <view wx:if="{{cond.departmentScope === 'specific' && (!cond._deptNames || !cond._deptNames.length)}}" class="audit-cond-chip audit-cond-dept">指定部门</view>
                    <view wx:if="{{cond.workGroupScope === 'own'}}" class="audit-cond-chip audit-cond-wg">同职能组</view>
                    <view wx:for="{{cond._wgNames}}" wx:for-item="wname" wx:key="index" wx:if="{{cond.workGroupScope === 'specific'}}" class="audit-cond-chip audit-cond-wg">{{wname}}</view>
                    <view wx:if="{{cond.workGroupScope === 'specific' && (!cond._wgNames || !cond._wgNames.length)}}" class="audit-cond-chip audit-cond-wg">指定职能组</view>
                    <view wx:if="{{cond.identityScope === 'own'}}" class="audit-cond-chip audit-cond-ident">同身份</view>
                    <view wx:for="{{cond._identNames}}" wx:for-item="iname" wx:key="index" wx:if="{{cond.identityScope === 'specific'}}" class="audit-cond-chip audit-cond-ident">{{iname}}</view>
                    <view wx:if="{{cond.identityScope === 'specific' && (!cond._identNames || !cond._identNames.length)}}" class="audit-cond-chip audit-cond-ident">指定身份</view>
                    <view wx:if="{{cond.departmentScope === 'all' && cond.workGroupScope === 'all' && cond.identityScope === 'all'}}" class="audit-cond-chip audit-cond-none">不限</view>
                  </block>
                  <text wx:if="{{ci < step._resolvedConditions.length - 1}}" class="audit-or-sep">或</text>
                </view>
              </view>
              <view wx:if="{{!item.steps || !item.steps.length}}" style="color:#9ca3af;font-size:22rpx;">暂无步骤</view>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!auditFlowTemplates.length}}">暂无审核流程</view>
          </block>
        </scroll-view>
      </view>

      <!-- Step editor popup (condition-based) -->
      <view class="popup-mask ui-overlay" wx:if="{{auditTemplateStepEditorVisible}}" bindtap="closeAuditTemplateStepEditor" catchtouchmove="noop">
        <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
        <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop" style="max-height:90vh;">
          <view class="popup-header ui-dialog-header"><view class="popup-title">{{auditTemplateStepForm.editingIndex >= 0 ? '编辑步骤' : '添加步骤'}}</view><text class="popup-close ui-motion-chip" catchtap="closeAuditTemplateStepEditor" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="popup-scroll ui-dialog-body ui-dialog-scroll--fill">
            <!-- Step name -->
            <view class="field" style="padding:0 24rpx;">
              <view class="field-label">步骤名称</view>
              <input class="field-input" value="{{auditTemplateStepForm.name}}" data-field="name" bindinput="onAuditTemplateStepField" placeholder="如：部门负责人审批"/>
            </view>
            <!-- Conditions list -->
            <view class="list-title" style="padding:0 24rpx;">审批条件（满足任一条件）</view>
            <view class="list-item" wx:for="{{auditTemplateStepForm.conditions}}" wx:key="index" wx:for-item="cond">
              <view class="list-main">
                <view class="list-name">{{cond.conditionType === 'person' ? '人员条件' : '身份范围条件'}}</view>
                <view class="chip-row" style="flex-wrap:wrap;">
                  <block wx:if="{{cond.conditionType === 'person'}}">
                    <view class="status-chip info-chip" wx:for="{{cond._personNames}}" wx:for-item="pname" wx:key="index" style="margin:2rpx;">{{pname}}</view>
                    <view class="list-desc" wx:if="{{!cond._personNames || !cond._personNames.length}}" style="margin:2rpx;">未选择人员</view>
                  </block>
                  <block wx:else>
                    <!-- Department badges -->
                    <block wx:if="{{cond.departmentScope === 'own'}}">
                      <view class="status-chip info-chip" style="margin:2rpx;">同部门</view>
                    </block>
                    <block wx:elif="{{cond.departmentScope === 'specific'}}">
                      <view class="status-chip info-chip" wx:for="{{cond._deptNames}}" wx:for-item="dname" wx:key="index" style="margin:2rpx;">{{dname}}</view>
                      <view class="status-chip info-chip" wx:if="{{!cond._deptNames || !cond._deptNames.length}}" style="margin:2rpx;">指定部门</view>
                    </block>
                    <!-- Work Group badges -->
                    <block wx:if="{{cond.workGroupScope === 'own'}}">
                      <view class="status-chip info-chip" style="margin:2rpx;">同职能组</view>
                    </block>
                    <block wx:elif="{{cond.workGroupScope === 'specific'}}">
                      <view class="status-chip info-chip" wx:for="{{cond._wgNames}}" wx:for-item="wname" wx:key="index" style="margin:2rpx;">{{wname}}</view>
                      <view class="status-chip info-chip" wx:if="{{!cond._wgNames || !cond._wgNames.length}}" style="margin:2rpx;">指定职能组</view>
                    </block>
                    <!-- Identity badges -->
                    <block wx:if="{{cond.identityScope === 'own'}}">
                      <view class="status-chip info-chip" style="margin:2rpx;">同身份</view>
                    </block>
                    <block wx:elif="{{cond.identityScope === 'specific'}}">
                      <view class="status-chip info-chip" wx:for="{{cond._identNames}}" wx:for-item="iname" wx:key="index" style="margin:2rpx;">{{iname}}</view>
                      <view class="status-chip info-chip" wx:if="{{!cond._identNames || !cond._identNames.length}}" style="margin:2rpx;">指定身份</view>
                    </block>
                    <!-- All scopes = anyone -->
                    <view class="list-desc" wx:if="{{cond.departmentScope === 'all' && cond.workGroupScope === 'all' && cond.identityScope === 'all'}}" style="margin:2rpx;">不限（所有人）</view>
                  </block>
                </view>
              </view>
              <view class="list-actions">
                <text class="link ui-motion-chip" data-index="{{index}}" catchtap="openStepConditionEditor" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text>
                <text class="link danger-link ui-motion-chip" data-index="{{index}}" catchtap="removeStepCondition" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">移除</text>
              </view>
            </view>
            <view class="empty-inline" wx:if="{{!auditTemplateStepForm.conditions.length}}" style="padding:0 24rpx;">暂无审批条件</view>

            <!-- Add condition button -->
            <view class="button-row" style="padding:0 24rpx;">
              <button class="secondary-btn ui-motion-button" catchtap="openStepConditionEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">添加审批条件</button>
            </view>

            <!-- Action type -->
            <view class="field" style="padding:0 24rpx;">
              <view class="field-label">审批方式</view>
              <picker range="{{['通过','签字','盖章','签字+盖章']}}" bindchange="onStepActionTypeChange">
                <view class="picker-value">{{auditTemplateStepForm.actionType === 'pass' ? '通过' : (auditTemplateStepForm.actionType === 'sign' ? '签字' : (auditTemplateStepForm.actionType === 'estamp' ? '盖章' : '签字+盖章'))}}</view>
              </picker>
            </view>

            <!-- Condition editor (inline sub-panel) -->
            <view class="list-card nested-card audit-step-condition-editor" wx:if="{{auditStepConditionEditorVisible}}" style="margin:0 16rpx 16rpx;">
              <view class="list-title">{{auditStepConditionEditingIndex >= 0 ? '编辑条件' : '添加条件'}}</view>
              <view class="field">
                <view class="field-label">条件类型</view>
                <picker range="{{['身份范围','指定人员']}}" bindchange="onConditionTypeChange">
                  <view class="picker-value">{{auditStepConditionForm.conditionType === 'identity_scope' ? '身份范围' : '指定人员'}}</view>
                </picker>
              </view>

              <!-- Person condition fields -->
              <block wx:if="{{auditStepConditionForm.conditionType === 'person'}}">
                <view class="field">
                  <view class="field-label">指定人员（可多选）</view>
                  <view class="picker-value ui-motion-chip" data-target="personHrIds" data-title="选择人员" catchtap="openStepConditionPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{auditStepConditionForm.personHrNames || '点击选择人员'}}</view>
                  <text class="link ui-motion-chip" wx:if="{{auditStepConditionForm.personHrIds}}" catchtap="onStepConditionFieldClear" data-field="personHrIds" style="font-size:22rpx;color:#ef4444;" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">清除</text>
                </view>
              </block>

              <!-- Identity scope condition fields -->
              <block wx:else>
                <view class="field">
                  <view class="field-label">部门范围</view>
                  <picker range="{{['全部','指定','自己所在']}}" data-field="departmentScope" bindchange="onConditionScopeChange">
                    <view class="picker-value">{{auditStepConditionForm.departmentScope === 'all' ? '全部' : (auditStepConditionForm.departmentScope === 'specific' ? '指定' : '自己所在')}}</view>
                  </picker>
                </view>
                <view class="field" wx:if="{{auditStepConditionForm.departmentScope === 'specific'}}">
                  <view class="field-label">指定部门</view>
                  <view class="picker-value ui-motion-chip" data-target="specificDepartmentId" data-title="选择部门" catchtap="openStepConditionPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{auditStepConditionForm.specificDepartmentName || '点击选择部门'}}</view>
                </view>

                <view class="field">
                  <view class="field-label">职能组范围</view>
                  <picker range="{{['全部','指定','自己所在']}}" data-field="workGroupScope" bindchange="onConditionScopeChange">
                    <view class="picker-value">{{auditStepConditionForm.workGroupScope === 'all' ? '全部' : (auditStepConditionForm.workGroupScope === 'specific' ? '指定' : '自己所在')}}</view>
                  </picker>
                </view>
                <view class="field" wx:if="{{auditStepConditionForm.workGroupScope === 'specific'}}">
                  <view class="field-label">指定职能组</view>
                  <view class="picker-value ui-motion-chip" data-target="specificWorkGroupId" data-title="选择职能组" catchtap="openStepConditionPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{auditStepConditionForm.specificWorkGroupName || '点击选择职能组'}}</view>
                </view>

                <view class="field">
                  <view class="field-label">身份范围</view>
                  <picker range="{{['全部','指定','自己所在']}}" data-field="identityScope" bindchange="onConditionScopeChange">
                    <view class="picker-value">{{auditStepConditionForm.identityScope === 'all' ? '全部' : (auditStepConditionForm.identityScope === 'specific' ? '指定' : '自己所在')}}</view>
                  </picker>
                </view>
                <view class="field" wx:if="{{auditStepConditionForm.identityScope === 'specific'}}">
                  <view class="field-label">指定身份</view>
                  <view class="picker-value ui-motion-chip" data-target="specificIdentityId" data-title="选择身份" catchtap="openStepConditionPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{auditStepConditionForm.specificIdentityName || '点击选择身份'}}</view>
                </view>
              </block>

              <view class="button-row compact-row">
                <button class="primary-btn ui-motion-button" catchtap="confirmStepCondition" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{auditStepConditionEditingIndex >= 0 ? '更新条件' : '添加条件'}}</button>
                <button class="secondary-btn ui-motion-button" catchtap="closeStepConditionEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
              </view>
            </view>

          </scroll-view>
          <view class="button-row ui-dialog-footer" style="padding-left:24rpx;padding-right:24rpx;">
            <button class="primary-btn ui-motion-button" catchtap="confirmAuditTemplateStep" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">确定步骤</button>
          </view>
        </view>
      </view>

      <!-- Starter condition editor popup -->
      <view class="popup-mask ui-overlay" wx:if="{{auditStarterConditionEditorVisible}}" bindtap="closeStarterConditionEditor" catchtouchmove="noop">
        <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
        <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
          <view class="popup-header ui-dialog-header"><view class="popup-title">{{auditStarterConditionEditingIndex >= 0 ? '编辑发起条件' : '添加发起条件'}}</view><text class="popup-close ui-motion-chip" catchtap="closeStarterConditionEditor" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" scroll-y class="popup-scroll ui-dialog-body ui-dialog-scroll--fill">
            <view class="field">
              <view class="field-label">条件类型</view>
              <picker range="{{['身份范围','指定人员']}}" bindchange="onStarterConditionTypeChange">
                <view class="picker-value">{{auditStarterConditionForm.conditionType === 'identity_scope' ? '身份范围' : '指定人员'}}</view>
              </picker>
            </view>
            <block wx:if="{{auditStarterConditionForm.conditionType === 'person'}}">
              <view class="field">
                <view class="field-label">指定人员（可多选）</view>
                <view class="picker-value ui-motion-chip" data-target="personHrIds" data-title="选择人员" catchtap="openStarterConditionPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{auditStarterConditionForm.personHrNames || '点击选择人员'}}</view>
                <text class="link ui-motion-chip" wx:if="{{auditStarterConditionForm.personHrIds}}" catchtap="onStarterConditionFieldClear" data-field="personHrIds" style="font-size:22rpx;color:#ef4444;" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">清除</text>
              </view>
            </block>
            <block wx:else>
              <view class="field">
                <view class="field-label">部门范围</view>
                <picker range="{{['全部','指定']}}" data-field="departmentScope" bindchange="onStarterConditionScopeChange">
                  <view class="picker-value">{{auditStarterConditionForm.departmentScope === 'all' ? '全部' : '指定'}}</view>
                </picker>
              </view>
              <view class="field" wx:if="{{auditStarterConditionForm.departmentScope === 'specific'}}">
                <view class="field-label">指定部门（可多选）</view>
                <view class="picker-value ui-motion-chip" data-target="specificDepartmentId" data-title="选择部门" catchtap="openStarterConditionPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{auditStarterConditionForm.specificDepartmentName || '点击选择部门'}}</view>
                <text class="link ui-motion-chip" wx:if="{{auditStarterConditionForm.specificDepartmentId}}" catchtap="onStarterConditionFieldClear" data-field="specificDepartmentId" style="font-size:22rpx;color:#ef4444;" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">清除</text>
              </view>
              <view class="field">
                <view class="field-label">职能组范围</view>
                <picker range="{{['全部','指定']}}" data-field="workGroupScope" bindchange="onStarterConditionScopeChange">
                  <view class="picker-value">{{auditStarterConditionForm.workGroupScope === 'all' ? '全部' : '指定'}}</view>
                </picker>
              </view>
              <view class="field" wx:if="{{auditStarterConditionForm.workGroupScope === 'specific'}}">
                <view class="field-label">指定职能组（可多选）</view>
                <view class="picker-value ui-motion-chip" data-target="specificWorkGroupId" data-title="选择职能组" catchtap="openStarterConditionPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{auditStarterConditionForm.specificWorkGroupName || '点击选择职能组'}}</view>
                <text class="link ui-motion-chip" wx:if="{{auditStarterConditionForm.specificWorkGroupId}}" catchtap="onStarterConditionFieldClear" data-field="specificWorkGroupId" style="font-size:22rpx;color:#ef4444;" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">清除</text>
              </view>
              <view class="field">
                <view class="field-label">身份范围</view>
                <picker range="{{['全部','指定']}}" data-field="identityScope" bindchange="onStarterConditionScopeChange">
                  <view class="picker-value">{{auditStarterConditionForm.identityScope === 'all' ? '全部' : '指定'}}</view>
                </picker>
              </view>
              <view class="field" wx:if="{{auditStarterConditionForm.identityScope === 'specific'}}">
                <view class="field-label">指定身份（可多选）</view>
                <view class="picker-value ui-motion-chip" data-target="specificIdentityId" data-title="选择身份" catchtap="openStarterConditionPicker" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{auditStarterConditionForm.specificIdentityName || '点击选择身份'}}</view>
                <text class="link ui-motion-chip" wx:if="{{auditStarterConditionForm.specificIdentityId}}" catchtap="onStarterConditionFieldClear" data-field="specificIdentityId" style="font-size:22rpx;color:#ef4444;" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">清除</text>
              </view>
            </block>
          </scroll-view>
          <view class="button-row compact-row ui-dialog-footer">
            <button class="primary-btn ui-motion-button" catchtap="confirmStarterCondition" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{auditStarterConditionEditingIndex >= 0 ? '更新条件' : '添加条件'}}</button>
            <button class="secondary-btn ui-motion-button" catchtap="closeStarterConditionEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
          </view>
        </view>
      </view>
    </view>

    <!-- ══════════════ Audit: Stamps ══════════════ -->
    <view class="section" wx:if="{{activeTab === 'auditStamps'}}">
      <view class="section-title">电子印章管理</view>
      <view class="edit-box">
        <view class="list-title">{{stampForm.id ? '编辑印章' : '新建印章'}}</view>
        <view class="field">
          <view class="field-label">印章名称</view>
          <input class="field-input" data-field="name" bindinput="onStampFieldInput" value="{{stampForm.name}}" placeholder="请输入印章名称" />
        </view>
        <view class="field">
          <view class="field-label">印章图片</view>
          <image wx:if="{{stampForm.imageData}}" src="{{stampForm.imageData}}" mode="widthFix" class="audit-stamp-preview" style="width:200rpx;" />
          <button class="secondary-btn ui-motion-button" bindtap="chooseStampImage" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{stampForm.imageData ? '更换图片' : '选择图片'}}</button>
        </view>
        <view class="button-row">
          <button class="primary-btn ui-motion-button" loading="{{loadingMap.saveStamp}}" bindtap="saveStamp" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存印章</button>
          <button class="secondary-btn ui-motion-button" bindtap="startCreateStamp" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">新建印章</button>
        </view>
      </view>

      <view class="list-card">
        <view class="list-title">印章列表</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll medium-scroll" scroll-y>
          <view class="card-loading-overlay" wx:if="{{loadingMap.auditStamps}}"><view class="card-loading-spinner"></view></view>
          <block wx:else>
          <view class="list-item" wx:for="{{stamps}}" wx:key="id">
            <view class="list-main">
              <view class="list-name">{{item.name}}</view>
              <image wx:if="{{item.imageData}}" src="{{item.imageData}}" mode="widthFix" class="audit-stamp-preview" style="width:160rpx;" />
            </view>
            <view class="list-actions">
              <text class="link ui-motion-chip" data-id="{{item.id}}" bindtap="editStamp" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">编辑</text>
              <text class="link danger-link ui-motion-chip" data-id="{{item.id}}" bindtap="deleteStamp" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">删除</text>
            </view>
          </view>
          <view class="empty-inline" wx:if="{{!stamps.length}}">暂无电子印章</view>
          </block>
        </scroll-view>
      </view>
    </view>

    <!-- ══════════════ Audit: Submissions ══════════════ -->
    <view class="section" wx:if="{{activeTab === 'auditSubmissions'}}">
      <view class="section-title">审核记录</view>
      <view class="audit-filter-bar">
        <text class="audit-filter-label">状态筛选</text>
        <picker range="{{['全部','草稿','待提交','审核中','已驳回','已完成','已撤回']}}" bindchange="onAuditSubmissionStatusFilter">
          <view class="picker-value" style="min-height:60rpx;font-size:22rpx;padding:0 18rpx;border-radius:14rpx;">{{auditSubmissionFilters.status === 'draft' ? '草稿' : (auditSubmissionFilters.status === 'pending' ? '待提交' : (auditSubmissionFilters.status === 'in_progress' ? '审核中' : (auditSubmissionFilters.status === 'rejected' ? '已驳回' : (auditSubmissionFilters.status === 'approved' ? '已完成' : (auditSubmissionFilters.status === 'withdrawn' ? '已撤回' : '全部')))))}}</view>
        </picker>
      </view>
      <view class="card">
        <view class="section-title">提交列表</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
          <view class="card-loading-overlay" wx:if="{{loadingMap.auditSubmissions}}"><view class="card-loading-spinner"></view></view>
          <block wx:else>
          <view class="audit-submission-admin-item ui-motion-card" wx:for="{{auditSubmissions}}" wx:key="id" data-id="{{item.id}}" bindtap="viewAuditProgress" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="audit-submission-admin-main">
              <view class="audit-submission-admin-title">{{item.title || item.submissionNumber}}</view>
              <view class="audit-submission-admin-meta">
                <view class="audit-chip {{item.status === 'approved' ? 'audit-chip-approved' : (item.status === 'rejected' ? 'audit-chip-rejected' : (item.status === 'in_progress' ? 'audit-chip-progress' : (item.status === 'draft' ? 'audit-chip-draft' : (item.status === 'withdrawn' ? 'audit-chip-withdrawn' : 'audit-chip-pending'))))}}">{{item.status === 'draft' ? '草稿' : (item.status === 'pending' ? '待提交' : (item.status === 'in_progress' ? '审核中' : (item.status === 'rejected' ? '已驳回' : (item.status === 'approved' ? '已完成' : '已撤回'))))}}</view>
                <text class="audit-submission-admin-sub">{{item.submissionNumber}} · {{item.submitterName}} · {{item.createdAt}}</text>
              </view>
            </view>
            <view class="audit-submission-admin-arrow">›</view>
          </view>
          <view class="audit-empty-state" wx:if="{{!auditSubmissions.length}}">
            <view class="audit-empty-icon"><ui-icon name="list" tone="muted" size="54" ariaLabel="暂无审核记录" /></view>
            <view class="audit-empty-text">暂无审核记录</view>
          </view>
          </block>
        </scroll-view>
      </view>

      <!-- Progress detail popup -->
      <view class="popup-mask ui-overlay" wx:if="{{auditSubmissionDetailVisible}}" bindtap="closeAuditSubmissionDetail" catchtouchmove="noop">
        <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
        <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop" style="max-height: 85vh;">
          <view class="popup-header ui-dialog-header"><view class="popup-title">审核流程</view><text class="popup-close ui-motion-chip" catchtap="closeAuditSubmissionDetail" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">关闭</text></view>
          <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-scroll--fill" scroll-y wx:if="{{auditSubmissionDetail}}">
            <view class="card-loading-overlay" wx:if="{{loadingMap.auditProgress}}"><view class="card-loading-spinner"></view></view>
            <block wx:else>
            <!-- Header -->
            <view class="audit-progress-header">
              <view class="list-name">{{auditSubmissionDetail.submission.title || auditSubmissionDetail.submission.submissionNumber}}</view>
              <view class="list-desc">{{auditSubmissionDetail.submission.submissionNumber}} · {{auditSubmissionDetail.submission.submitterName}} · {{auditSubmissionDetail.submission.status === 'draft' ? '草稿' : (auditSubmissionDetail.submission.status === 'pending' ? '待提交' : (auditSubmissionDetail.submission.status === 'in_progress' ? '审核中' : (auditSubmissionDetail.submission.status === 'rejected' ? '已驳回' : (auditSubmissionDetail.submission.status === 'approved' ? '已完成' : '已撤回'))))}}</view>
            </view>

            <!-- Flow visualization -->
            <view class="audit-flow" wx:if="{{auditSubmissionDetail.flowTimeline.length}}">
              <block wx:for="{{auditSubmissionDetail.flowTimeline}}" wx:key="_key" wx:for-item="node">

                <!-- Lifecycle event -->
                <view class="flow-node flow-node-lifecycle" wx:if="{{node.type === 'lifecycle'}}">
                  <view class="flow-left-col">
                    <view class="flow-dot-lifecycle-icon"><ui-icon name="{{node.iconName || 'clock'}}" tone="primary" size="20" ariaLabel="{{node.label}}" /></view>
                    <view class="flow-connector flow-connector-lifecycle"></view>
                  </view>
                  <view class="flow-info flow-info-lifecycle">
                    <view class="flow-lifecycle-label">{{node.label}}<text class="flow-lifecycle-round" wx:if="{{node.subLabel}}">{{node.subLabel}}</text></view>
                    <view class="flow-lifecycle-time" wx:if="{{node.time}}">{{node.time}}</view>
                  </view>
                </view>

                <!-- Remaining steps separator -->
                <view class="flow-separator" wx:if="{{node.type === 'separator'}}">
                  <view class="flow-separator-dash"></view>
                  <text class="flow-separator-text">{{node.label}}</text>
                  <view class="flow-separator-dash"></view>
                </view>

                <!-- Approval step -->
                <view class="flow-node {{node.flowNodeClass}}" wx:if="{{node.type === 'step'}}">
                  <view class="flow-left-col">
                    <view class="flow-dot {{node.flowDotClass}}">
                      <block wx:if="{{node.flowIcon === 'check'}}">✓</block>
                      <block wx:elif="{{node.flowIcon === 'cross'}}">✗</block>
                      <block wx:else>{{node.sortOrder}}</block>
                    </view>
                    <view class="flow-connector"></view>
                  </view>
                  <view class="flow-info">
                    <view class="flow-step-label">第{{node.sortOrder}}步 · {{node.actionLabel}}<text class="flow-round-badge" wx:if="{{node.round > 1}}">第{{node.round}}轮</text></view>
                    <view class="flow-step-approver">{{node.approverDesc}}</view>

            <view class="rule-empty small-empty" wx:if="{{!pubViewRuleListView.length}}">暂无结果查看权限</view>
          </scroll-view>
        </view>

        <!-- ═══ 评优名单指定权 ─── 类别 + 条款 ─── -->

.admin-candidate-assignments {
  display: grid;
  gap: var(--ui-list-gap, 14rpx);
  margin-top: var(--ui-field-gap, 18rpx);
}

.admin-candidate-assignment {
  min-width: 0;
  padding: var(--ui-list-padding-y, 18rpx) var(--ui-list-padding-x, 20rpx);
  border: 1rpx solid rgba(191, 219, 254, 0.72);
  border-radius: var(--ui-list-radius, 22rpx);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.92), rgba(255, 255, 255, 0.84));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.admin-candidate-assignment-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--ui-inline-gap, 14rpx);
}

.admin-candidate-assignment-index {
  color: #64748b;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.45;
}

.admin-candidate-assignment-label {
  margin-top: var(--ui-label-gap, 8rpx);
  color: #1e293b;
  font-size: var(--ui-type-body);
  font-weight: 700;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.admin-candidate-nature-chip {
  color: var(--ui-blue-700);
  border-color: rgba(147, 197, 253, 0.72);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.96), rgba(219, 234, 254, 0.86));
}

.admin-candidate-no-position {
  margin-top: var(--ui-field-gap, 18rpx);
}

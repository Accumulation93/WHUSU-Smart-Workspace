/* 不兼容记录明细：与人事成员卡同一套柔和卡面，红色只用于问题语义。 */
.issue-list {
  width: 100%;
  min-width: 0;
}

.issue-title {
  font-size: var(--ui-type-emphasis);
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.issue-hint {
  font-size: var(--ui-type-meta);
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.validation-error-card {
  padding: 24rpx;
  margin-bottom: 14rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(254,250,250,0.82) 100%);
  border: 1rpx solid rgba(254,226,226,0.8);
  box-shadow: 0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing: border-box;
}

.ve-card-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 14rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #fef2f2;
}

.ve-card-name {
  font-size: var(--ui-type-section);
  font-weight: 700;
  color: #0f172a;
}

.ve-card-sid {
  font-size: var(--ui-type-label);
  color: #64748b;
  font-weight: 500;
}

.ve-card-errors {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ve-error-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 10rpx 14rpx;
  background: #fffbfb;
  border-radius: 12rpx;
  border: 1rpx solid #fee2e2;
}

.ve-error-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ve-error-field {
  font-size: var(--ui-type-body);
  font-weight: 600;
  color: #1e293b;
}

.ve-error-type-tag {
  display: inline-block;
  font-size: var(--ui-type-caption);
  padding: 2rpx 10rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  background: #eff6ff;
  color: #2563eb;
}

.ve-error-detail {
  font-size: var(--ui-type-label);
  color: #64748b;
  line-height: 1.5;
}

.ve-error-reason {
  color: #dc2626;
  font-weight: 500;
}

.ve-error-value {
  display: block;
  margin-top: 2rpx;
  color: #94a3b8;
  font-size: var(--ui-type-meta);
}

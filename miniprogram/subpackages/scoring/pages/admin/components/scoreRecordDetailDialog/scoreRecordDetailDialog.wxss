/* 组件使用 apply-shared，复用管理页已审计的评分详情弹窗样式。 */

/*
 * 自绘顶栏比原生状态栏更高：弹窗按共享规则居中后，顶边会顶到微信胶囊，
 * 标题行与关闭键点不到。这里只收高度（居中仍交给共享弹窗壳），
 * 并用“两个类名 + 直接子级”的选择器，否则单类名挡不住共享规则的 !important。
 */
.popup-mask.ui-overlay > .popup-card.ui-dialog-shell {
  /* 只调共享弹窗契约的“高度让位”令牌，居中仍交给共享壳负责，不自己重定位弹窗。 */
  --ui-dialog-height-inset: 208rpx;
  max-height: calc(100vh - 208rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
}

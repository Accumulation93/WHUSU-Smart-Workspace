<view class="hr-template-editor">
  <view class="edit-box-header">
    <view class="list-title">{{form.id ? localeCopy.copy_fcb584d9c6 : localeCopy.copy_cef74d5df5}}</view>
    <view class="hr-template-editor-head-actions">
      <view class="hr-template-dirty-chip" wx:if="{{dirty}}">{{hrTemplateCopy.dirtyBadge}}</view>
      <text class="link ui-motion-chip" bindtap="onCancel" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_06dbb49961}}</text>
    </view>
  </view>
  <view class="hr-template-error-banner" wx:if="{{formError}}">{{formError}}</view>
  <view class="field">
    <view class="field-label">{{localeCopy.copy_53adcabdff}}</view>
    <input class="field-input" data-field="name" bindinput="onTemplateInput" value="{{form.name}}" placeholder="{{localeCopy.copy_66382c2bfd}}" />
  </view>
  <view class="field">
    <view class="field-label">{{localeCopy.copy_560dc33d09}}</view>
    <textarea class="field-textarea hr-template-description-textarea" auto-height cursor-spacing="24" maxlength="-1" data-field="description" bindinput="onTemplateInput" value="{{form.description}}" placeholder="{{localeCopy.copy_3234735724}}" />
  </view>
  <view class="field">
    <view class="field-label">{{localeCopy.copy_1037d0aa5f}}</view>
    <picker range="{{editModeOptions}}" value="{{form.editModeIndex || 0}}" range-key="label" bindchange="onEditModeChange">
      <view class="picker-value">{{form.editModeLabel}}</view>
    </picker>
    <view class="field-hint">{{form.editModeHint}}</view>
  </view>
  <view class="hr-template-fields">
    <view class="hr-snapshot-fields hr-template-editor-fields">
      <view class="hr-snapshot-fields-head">
        <view class="hr-snapshot-fields-title">{{localeCopy.copy_f6f826bc55}}</view>
      </view>
      <view class="hr-template-field-item {{dragIndex === index ? 'is-dragging' : ''}}" id="hr-template-field-{{item.id}}" wx:for="{{form.fields}}" wx:key="id">
        <view class="hr-field-insert-line" wx:if="{{dragIndex >= 0 && dragInsertIndex === index}}"></view>
        <view class="hr-snapshot-field {{item.errorText ? 'has-error' : ''}}">
          <view class="hr-snapshot-field-order">{{index + 1}}</view>
          <view class="hr-snapshot-field-main">
            <view class="hr-snapshot-field-name">{{item.label || hrTemplateCopy.unnamedField}}</view>
            <view class="hr-snapshot-field-rule" wx:if="{{item.type === 'sequence' && item.optionsSummary}}">{{item.optionsSummary}}</view>
            <view class="hr-template-field-error" wx:if="{{item.errorText}}">{{item.errorText}}</view>
          </view>
          <view class="hr-snapshot-field-tags">
            <view class="hr-snapshot-type-tag">{{item.typeLabel}}</view>
            <view class="hr-snapshot-required-tag" wx:if="{{item.required}}">{{localeCopy.copy_df05b9bf5d}}</view>
          </view>
        </view>
        <view class="hr-template-field-toggle-row">
          <view class="hr-template-field-handle ui-motion-chip" data-index="{{index}}" bindlongpress="onHandleLongPress" catchtouchmove="onDragMove" bindtouchend="onDragEnd" bindtouchcancel="onDragEnd" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" aria-role="button" aria-label="{{hrTemplateCopy.dragFieldLabel}}">≡</view>
          <button class="secondary-btn hr-template-field-move ui-motion-button" data-index="{{index}}" data-dir="-1" disabled="{{index === 0}}" bindtap="onMoveField" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{hrTemplateCopy.moveFieldUpAction}}</button>
          <button class="secondary-btn hr-template-field-move ui-motion-button" data-index="{{index}}" data-dir="1" disabled="{{index === form.fields.length - 1}}" bindtap="onMoveField" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{hrTemplateCopy.moveFieldDownAction}}</button>
          <button class="secondary-btn hr-template-field-toggle ui-motion-button" data-field-id="{{item.id}}" bindtap="onToggleField" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item.expanded ? hrTemplateCopy.collapseFieldAction : hrTemplateCopy.editFieldAction}}</button>
        </view>
        <view class="hr-template-field-settings" wx:if="{{item.expanded}}">
          <view class="field">
            <view class="field-label">{{localeCopy.copy_93ab263567}}</view>
            <input class="field-input" data-index="{{index}}" data-field="label" bindinput="onFieldInput" value="{{item.label}}" placeholder="{{localeCopy.copy_a4cbcb25b9}}" />
          </view>
          <view class="field">
            <view class="field-label">{{localeCopy.copy_54d366a2c5}}</view>
            <picker range="{{fieldTypeOptions}}" value="{{item.typeIndex || 0}}" range-key="label" bindchange="onFieldTypeChange" data-index="{{index}}">
              <view class="picker-value">{{item.typeLabel}}</view>
            </picker>
          </view>
          <view class="field">
            <view class="field-label">{{localeCopy.copy_df05b9bf5d}}</view>
            <switch checked="{{item.required}}" color="#2563eb" data-index="{{index}}" bindchange="onFieldRequiredChange" />
          </view>
          <view class="field field-row" wx:if="{{item.type === 'text'}}">
            <view class="field field-half">
              <view class="field-label">{{localeCopy.copy_5354228d3f}}</view>
              <input class="field-input" data-index="{{index}}" data-field="minLength" bindinput="onFieldInput" value="{{item.minLength}}" placeholder="{{localeCopy.copy_d88a120c73}}" />
            </view>
            <view class="field field-half">
              <view class="field-label">{{localeCopy.copy_453aeb2049}}</view>
              <input class="field-input" data-index="{{index}}" data-field="maxLength" bindinput="onFieldInput" value="{{item.maxLength}}" placeholder="{{localeCopy.copy_d88a120c73}}" />
            </view>
          </view>
          <view wx:if="{{item.type === 'number'}}">
            <view class="field">
              <view class="field-label">{{localeCopy.copy_069296c265}}</view>
              <picker range="{{numberRuleOptions}}" value="{{item.numberRuleIndex || 0}}" range-key="label" bindchange="onNumberRuleChange" data-index="{{index}}">
                <view class="picker-value">{{item.numberRuleLabel}}</view>
              </picker>
            </view>
            <view class="field">
              <view class="field-label">{{localeCopy.copy_f29d0c426b}}</view>
              <switch checked="{{item.allowDecimal}}" color="#2563eb" data-index="{{index}}" bindchange="onFieldAllowDecimalChange" />
            </view>
            <view class="field field-row" wx:if="{{item.numberRule === 'value_range'}}">
              <view class="field field-half">
                <view class="field-label">{{localeCopy.copy_c536f98c27}}</view>
                <input class="field-input" data-index="{{index}}" data-field="minValue" bindinput="onFieldInput" value="{{item.minValue}}" placeholder="{{localeCopy.copy_d88a120c73}}" />
              </view>
              <view class="field field-half">
                <view class="field-label">{{localeCopy.copy_c7710f6c1e}}</view>
                <input class="field-input" data-index="{{index}}" data-field="maxValue" bindinput="onFieldInput" value="{{item.maxValue}}" placeholder="{{localeCopy.copy_d88a120c73}}" />
              </view>
            </view>
            <view class="field field-row" wx:if="{{item.numberRule === 'length_range'}}">
              <view class="field field-half">
                <view class="field-label">{{localeCopy.copy_5354228d3f}}</view>
                <input class="field-input" data-index="{{index}}" data-field="minDigits" bindinput="onFieldInput" value="{{item.minDigits}}" placeholder="{{localeCopy.copy_d88a120c73}}" />
              </view>
              <view class="field field-half">
                <view class="field-label">{{localeCopy.copy_37c16943eb}}</view>
                <input class="field-input" data-index="{{index}}" data-field="maxDigits" bindinput="onFieldInput" value="{{item.maxDigits}}" placeholder="{{localeCopy.copy_d88a120c73}}" />
              </view>
            </view>
          </view>
          <view class="field" wx:if="{{item.type === 'sequence'}}">
            <view class="field-label">{{localeCopy.copy_1016162deb}}</view>
            <textarea class="field-textarea question-textarea hr-template-options-textarea" cursor-spacing="24" maxlength="-1" data-index="{{index}}" data-field="optionsText" bindinput="onFieldInput" value="{{item.optionsText}}" style="--hr-option-rows: {{item.optionsRows}}" placeholder="{{localeCopy.copy_c3f8ea9aaa}}" />
            <view class="field-hint">{{hrTemplateCopy.fieldOptionsHint}} · {{item.optionsCountText}}</view>
            <view class="hr-template-option-list" wx:if="{{item.optionsCount}}">
              <view class="hr-template-option-row {{optionDragFieldIndex === index && optionDragIndex === option.index ? 'is-dragging' : ''}}" wx:for="{{item.optionsViewList}}" wx:for-item="option" wx:key="index" data-field-index="{{index}}" data-option-index="{{option.index}}">
                <view class="hr-field-insert-line" wx:if="{{optionDragFieldIndex === index && dragInsertIndex === optionIndex}}"></view>
                <view class="hr-template-option-handle ui-motion-chip" wx:if="{{item.optionsExpanded}}" data-index="{{index}}" data-option-index="{{option.index}}" bindlongpress="onOptionHandleLongPress" catchtouchmove="onDragMove" bindtouchend="onDragEnd" bindtouchcancel="onDragEnd" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" aria-role="button" aria-label="{{hrTemplateCopy.dragFieldLabel}}">≡</view>
                <text class="hr-template-option-text">{{option.text}}</text>
                <view class="hr-template-option-move ui-motion-chip {{option.first ? 'is-disabled' : ''}}" wx:if="{{item.optionsExpanded}}" data-index="{{index}}" data-option-index="{{option.index}}" data-dir="-1" bindtap="onMoveOption" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" aria-role="button" aria-label="{{hrTemplateCopy.moveOptionUpAction}}">↑</view>
                <view class="hr-template-option-move ui-motion-chip {{option.last ? 'is-disabled' : ''}}" wx:if="{{item.optionsExpanded}}" data-index="{{index}}" data-option-index="{{option.index}}" data-dir="1" bindtap="onMoveOption" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" aria-role="button" aria-label="{{hrTemplateCopy.moveOptionDownAction}}">↓</view>
                <view class="hr-template-option-remove ui-motion-chip" data-index="{{index}}" data-option-index="{{option.index}}" bindtap="onRemoveOption" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" aria-role="button" aria-label="{{hrTemplateCopy.removeOptionAction}}">×</view>
              </view>
              <view class="hr-field-insert-line hr-field-insert-line-end" wx:if="{{optionDragFieldIndex === index && dragInsertIndex === item.optionsViewList.length}}"></view>
            </view>
            <view class="hr-template-option-toggle-row" wx:if="{{item.optionsHiddenCount > 0 || item.optionsExpanded}}">
              <text class="link ui-motion-chip" data-index="{{index}}" bindtap="onToggleOptionsExpand" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{item.optionsExpanded ? hrTemplateCopy.fieldOptionsCollapseAction : hrTemplateCopy.fieldOptionsExpandAction}}</text>
              <text class="hr-template-option-hint" wx:if="{{!item.optionsExpanded}}">{{hrTemplateCopy.fieldOptionsOrderHint}}</text>
            </view>
            <view class="hr-template-option-warning" wx:if="{{item.optionsDuplicateText}}">
              <text>{{item.optionsDuplicateText}}</text>
              <text class="link ui-motion-chip" data-index="{{index}}" bindtap="onDedupeOptions" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{hrTemplateCopy.fieldOptionsDedupeAction}}</text>
            </view>
          </view>
          <view class="button-row compact-row">
            <button class="secondary-btn ui-motion-button" data-index="{{index}}" bindtap="onRemoveField" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_779363030e}}</button>
          </view>
        </view>
      </view>
      <view class="hr-field-insert-line hr-field-insert-line-end" wx:if="{{dragIndex >= 0 && dragInsertIndex === form.fields.length}}"></view>
    </view>
  </view>
  <view class="button-row hr-template-editor-actions hr-template-editor-actions-sticky">
    <button class="secondary-btn hr-template-editor-btn ui-motion-button" bindtap="onAddField" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_e0e7db5698}}</button>
    <button class="secondary-btn hr-template-editor-btn ui-motion-button" loading="{{importing}}" bindtap="onImportFields" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_e39d601eb0}}</button>
    <button class="primary-btn template-save-btn hr-template-editor-btn hr-template-editor-save ui-motion-button" loading="{{saving}}" bindtap="onSave" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_41e8060a1f}}</button>
  </view>
</view>
<view class="hr-field-drag-ghost" wx:if="{{ghostVisible}}" style="top: {{ghostTop}}px; left: {{ghostLeft}}px; width: {{ghostWidth}}px;">
  <view class="hr-field-drag-ghost-handle">≡</view>
  <view class="hr-field-drag-ghost-text">{{ghostLabel}}</view>
</view>

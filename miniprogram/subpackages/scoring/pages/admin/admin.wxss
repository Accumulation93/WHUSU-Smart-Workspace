  border-color: rgba(96, 165, 250, 0.65);
}

.stat-card-selected {
  border-color: rgba(37, 99, 235, 0.55);
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.65) 0%, rgba(239, 246, 255, 0.55) 100%);
  box-shadow:
    0 14rpx 30rpx rgba(37, 99, 235, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.stat-card-top {

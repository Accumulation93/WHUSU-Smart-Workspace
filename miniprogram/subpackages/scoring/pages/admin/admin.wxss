  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.template-config-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.template-config-meta {
  flex-shrink: 0;
  justify-content: flex-end;
}

.template-config-actions {
  width: auto;
  flex-shrink: 0;
  margin-top: 0;
  justify-content: flex-start;
  gap: 14rpx;
}

.rule-list-card {
  margin-top: 18rpx;
}

.rule-list-item {
  align-items: stretch;
  padding: 20rpx;
  border-color: rgba(191, 219, 254, 0.42);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.94) 0%, rgba(248, 251, 255, 0.88) 100%);
}

.rule-list-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.rule-list-count {
  flex-shrink: 0;
  min-height: 42rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #2563eb;
  font-size: 21rpx;
  font-weight: 800;
  background: rgba(219, 234, 254, 0.68);
  border: 1rpx solid rgba(147, 197, 253, 0.58);
}

.rule-filter-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.rule-filter-field {
  flex: 1;
  min-width: 0;
}

.compact-picker-value {
  min-height: 70rpx;
  padding: 0 18rpx;
  font-size: 23rpx;
  border-radius: 18rpx;
}

.rule-list-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.rule-list-inline-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 22rpx;
  min-width: 150rpx;
}

.rule-list-info {
  display: grid;
  gap: 10rpx;
}

.rule-list-main-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.rule-info-text {
  min-width: 0;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-word;
}

.inner-scroll {
  padding-right: 8rpx;
}

.medium-scroll {
  max-height: 620rpx;
}

.large-scroll {
  max-height: 820rpx;
}

.small-scroll {
  max-height: 700rpx;
}

.small-scroll.template-config-scroll-expanded {
  max-height: none;
}

.scroll-hint {
  display: flex;
  justify-content: center;
  padding: 6rpx 0 8rpx;
  opacity: 0.3;
  pointer-events: none;
}

.scroll-hint-dot {
  width: 56rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #64748b;
}

.list-item,
.question-card,
.pill {
  margin-bottom: 14rpx;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(249, 251, 255, 0.82) 100%);
  border: 1rpx solid rgba(226, 237, 247, 0.96);
  box-shadow:
    0 12rpx 24rpx rgba(15, 23, 42, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  box-sizing: border-box;
  transition: transform 0.18s ease, box-shadow 0.24s ease, border-color 0.24s ease;
}

.list-item:last-child,
.question-card:last-child,
.pill:last-child {
  margin-bottom: 0;
}

.dragging-ghost {
  opacity: 0.4;
  transform: scale(0.96);
  box-shadow: none;
}

.drag-insert-target {
  box-shadow: inset 0 4rpx 0 0 #3b82f6, 0 8rpx 20rpx rgba(59, 130, 246, 0.12);
}

.drag-ghost-card {
  position: fixed;
  z-index: 1000;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72) 0%, rgba(249, 251, 255, 0.58) 100%);
  border: 1rpx solid rgba(226, 237, 247, 0.50);
  box-shadow: 0 16rpx 32rpx rgba(15, 23, 42, 0.10);
  box-sizing: border-box;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ghost-preview-text {
  font-size: 26rpx;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.drag-handle {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #94a3b8;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.drag-insert-line-end {
  height: 4rpx;
  background: #3b82f6;
  border-radius: 2rpx;
  margin: 8rpx 0;
}

.question-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.question-title {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.expand-indicator {
  font-size: 20rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.question-preview {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.preview-text {
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 700;
  line-height: 1.5;
  word-break: break-word;
}

.preview-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.preview-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
  border: 1rpx solid transparent;
}

.chip-min { background: rgba(219, 234, 254, 0.76); color: #2563eb; border-color: rgba(147, 197, 253, 0.64); }
.chip-start { background: rgba(209, 250, 229, 0.78); color: #15803d; border-color: rgba(110, 231, 183, 0.58); }
.chip-max { background: rgba(255, 237, 213, 0.78); color: #c2410c; border-color: rgba(253, 186, 116, 0.58); }
.chip-step { background: rgba(224,242,254,0.76); color: #0369a1; border-color: rgba(56,189,248,0.56); }

.question-fields {
  margin-top: 8rpx;
  animation: fadeInDown 0.18s ease;
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-6rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.question-order-btns {
  display: flex;
  gap: 8rpx;
}

.order-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: rgba(239, 246, 255, 0.92);
  color: #3b82f6;
  font-size: 26rpx;
  font-weight: 700;
  border: 1rpx solid rgba(191, 219, 254, 0.72);
}

.order-btn:active {
  background: rgba(59, 130, 246, 0.18);
}

.order-btn-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.order-btn-delete {
  background: #ef4444;
  border-color: #ef4444;
  position: relative;
}

/* trash can lid */
.order-btn-delete::before {
  content: '';
  position: absolute;
  top: 13rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 5rpx;
  background: white;
  border-radius: 2rpx;
}

/* trash can body */
.order-btn-delete::after {
  content: '';
  position: absolute;
  top: 19rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 22rpx;
  height: 21rpx;
  background: white;
  border-radius: 2rpx 2rpx 4rpx 4rpx;
}

.order-btn-delete:active {
  background: #dc2626;
  border-color: #dc2626;
}

.field-error {
  border-color: #ef4444 !important;
  box-shadow: 0 0 0 2rpx rgba(239, 68, 68, 0.12) !important;
}

.list-item:active,
.question-card:active,
.pill:active {
  transform: translateY(1rpx) scale(0.992);
  box-shadow:
    0 16rpx 28rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
}

.list-item {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.list-item-stacked {
  display: block;
}

.list-actions-below {
  margin-top: 16rpx;
  justify-content: flex-start;
}

.list-main {

var COLOR_MAP = {
  '优秀': '#f59e0b',
  '良好': '#10b981',
  '合格': '#3b82f6',
  '不合格': '#ef4444'
};

var PALETTE = ['#8b5cf6', '#ec4899', '#06b6d4', '#f97316', '#84cc16', '#6366f1'];

function getColor(name) {
  if (COLOR_MAP[name]) return COLOR_MAP[name];
  if (!name) return '#9ca3af';
  var hash = 0;
  for (var i = 0; i < name.length; i++) {
    hash = ((hash << 5) - hash) + name.charCodeAt(i);
  }
  return PALETTE[Math.abs(hash) % PALETTE.length];
}

function getLabel(item, index) {
  var name = item.gradeName || '';
  var minS = item.minScore;
  var maxS = item.maxScore;
  if (name && (minS !== undefined && minS !== '' || maxS !== undefined && maxS !== '')) {
    return name + ' (' + (minS || '?') + '-' + (maxS || '?') + ')';
  }
  if (name) return name;
  return '区间 ' + (index + 1);
}

module.exports = {
  getColor: getColor,
  getLabel: getLabel
};

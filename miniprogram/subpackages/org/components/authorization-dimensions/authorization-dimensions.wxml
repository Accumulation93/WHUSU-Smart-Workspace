<view class="dimension-note">{{ui.withinGroup}}</view>
<view wx:if="{{natureMissing}}" class="dimension-note">{{ui.chooseNatureFirst}}</view>
<view wx:for="{{groups}}" wx:key="key" class="dimension-group">
  <view class="dimension-heading ui-motion-card" data-key="{{item.key}}" bindtap="expand" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160"><view class="dimension-title">{{item.label}}</view><view class="dimension-summary">{{item.summary}}</view><ui-icon name="chevron-right" sizeRole="row-leading" /></view>
  <view wx:if="{{expanded[item.key]}}" class="dimension-options">
    <view wx:if="{{item.blocked}}" class="dimension-note">{{ui.chooseNatureFirst}}</view>
    <view wx:if="{{item.incompatible}}" class="dimension-note">{{ui.ruleInvalidCombination}}</view>
    <button wx:if="{{relative}}" class="secondary-btn ui-motion-button dimension-option {{item.same ? 'dimension-selected' : ''}}" data-key="{{item.key}}" data-same="{{true}}" disabled="{{disabled || item.blocked}}" bindtap="choose" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.sameAsViewer}}</button>
    <button wx:for="{{item.items}}" wx:for-item="option" wx:key="id" class="secondary-btn ui-motion-button dimension-option {{option.selected ? 'dimension-selected' : ''}}" data-key="{{item.key}}" data-id="{{option.id}}" disabled="{{disabled}}" bindtap="choose" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{option.name}}</button>
  </view>
</view>

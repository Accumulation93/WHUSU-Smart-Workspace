.dimension-note { color: #64748b; font-size: var(--ui-type-meta); line-height: 1.5; }
.dimension-group { margin-top: 14rpx; }
.dimension-heading, .dimension-option { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 72rpx; padding: 12rpx 16rpx; box-sizing: border-box; text-align: center; line-height: 1.4; font-size: var(--ui-type-control); color: #1e293b; border: 1rpx solid rgba(147,197,253,.64); border-radius: var(--ui-control-radius, 28rpx); background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(246,249,255,.88)); }
.dimension-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 12rpx; }
.dimension-selected { border-color: #2563eb; background: linear-gradient(135deg, rgba(219,234,254,.92), rgba(224,242,254,.88)); }
@media (min-width: 520px) { .dimension-heading, .dimension-option { min-height: 40px; padding: 8px 10px; } .dimension-group { margin-top: 10px; } .dimension-options { gap: 8px; margin-top: 8px; } }

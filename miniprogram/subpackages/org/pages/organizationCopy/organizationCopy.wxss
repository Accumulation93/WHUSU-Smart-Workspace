@import "../authorization/authorization.wxss";
.copy-stack, .copy-field { display: flex; flex-direction: column; gap: var(--ui-field-gap); min-width: 0; }
.copy-field { gap: var(--ui-label-gap); }
.copy-stack > button, .copy-field > button { flex: none; box-sizing: border-box; width: 100%; min-width: 100%; max-width: 100%; }
.copy-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ui-inline-gap); padding: var(--ui-label-gap); border: 1rpx solid rgba(191,219,254,.7); border-radius: var(--ui-tab-shell-radius); background: linear-gradient(135deg,rgba(255,255,255,.9),rgba(239,246,255,.7)); }
@media (min-width: 520px) { .copy-tabs { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
.copy-tabs > button, .copy-actions > button { box-sizing: border-box; width: 100%; min-width: 0; max-width: 100%; margin: 0; white-space: normal; word-break: normal; overflow-wrap: break-word; }
.copy-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ui-page-action-gap); }
.copy-actions > button { min-width: 0; width: 100%; }
.copy-muted { color: #64748b; font-size: var(--ui-type-meta); line-height: 1.6; overflow-wrap: anywhere; }
.copy-page .picker-display { display: flex; align-items: center; justify-content: space-between; gap: var(--ui-inline-gap); width: 100%; min-height: var(--ui-field-control-height); box-sizing: border-box; padding: var(--ui-control-padding-y) var(--ui-control-padding-x); border: 1rpx solid rgba(191,219,254,.8); border-radius: var(--ui-field-radius); background: linear-gradient(135deg,rgba(255,255,255,.98),rgba(239,246,255,.86)); white-space: normal; overflow-wrap: break-word; }
.copy-page .copy-field { padding-top: var(--ui-label-gap); }
.copy-page .copy-summary-title { font-size: var(--ui-type-label); color: #0f172a; }
.copy-actions > button:last-child:nth-child(odd) { grid-column: 1 / -1; }
.copy-multiline { white-space: pre-wrap; overflow-wrap: anywhere; }
.copy-summary-title { font-weight: 600; }
.copy-page .selection-option-card { box-sizing: border-box; min-height: var(--ui-field-control-height); padding: var(--ui-control-padding-y) var(--ui-control-padding-x); border: 1rpx solid rgba(191,219,254,.8); border-radius: var(--ui-field-radius); background: linear-gradient(135deg,rgba(255,255,255,.98),rgba(239,246,255,.86)); overflow-wrap: break-word; }

@import "../authorization/authorization.wxss";
.authorization-input { display: block; width: 100%; min-height: var(--ui-field-control-height); box-sizing: border-box; padding: 16rpx 20rpx; margin-top: 12rpx; line-height: 1.5; font-size: var(--ui-type-body); color: #0f172a; border: 1rpx solid rgba(147,197,253,.64); border-radius: var(--ui-field-radius); background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(246,249,255,.88)); }
.authorization-group { margin-top: 16rpx; }
.authorization-group > .permission-section-head { align-items: center; }
.authorization-group > .permission-section-head > .authorization-label { flex: 1; min-width: 0; margin-top: 0; }
.authorization-group > .permission-section-head > button { flex: none; width: auto; min-width: 0; }
.authorization-option { display: flex; align-items: center; justify-content: center; min-height: var(--ui-control-height); padding: 14rpx 18rpx; text-align: center; line-height: 1.4; font-size: var(--ui-type-control); color: #1e293b; border: 1rpx solid rgba(147,197,253,.64); border-radius: var(--ui-control-radius); background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(246,249,255,.88)); }
.authorization-option-selected { border-color: #2563eb; background: linear-gradient(135deg, rgba(219,234,254,.92), rgba(224,242,254,.88)); }
.permission-page button.authorization-option-selected:not([disabled]) { color: #2563eb; border-color: #3b82f6; background: linear-gradient(135deg,rgba(219,234,254,.92),rgba(239,246,255,.96)); box-shadow: inset 0 0 0 1px rgba(59,130,246,.26); }
.permission-page > .permission-card { display: flex; flex-direction: column; gap: var(--ui-field-gap); }
.permission-page .authorization-group { display: flex; flex-direction: column; gap: var(--ui-field-gap); margin-top: 0; }
.permission-page .authorization-input, .permission-page .authorization-label { margin-top: 0; }
.permission-page .authorization-actions { margin-top: 0; margin-bottom: 0; gap: var(--ui-field-gap); }
@media (min-width: 520px) { .authorization-input { min-height: 42px; padding: 10px 12px; margin-top: 8px; } .authorization-group { margin-top: 10px; } .authorization-option { min-height: 40px; padding: 8px 12px; } }

<page-meta page-style="{{(picker ? 'overflow:hidden;' : '') + '--ui-navbar-height:' + navTopPx + 'px;'}}"></page-meta>
<import src="./authorizationPermissionTree.wxml" />
<ui-navbar title="{{ui.title}}" />
<template name="grantDetails">
  <view class="authorization-details">
    <view class="authorization-chips"><text wx:for="{{grant.capabilityLabels}}" wx:key="*this" class="authorization-chip">{{item}}</text></view>
    <block wx:if="{{grant.allocationSubjects.length}}"><view class="authorization-label">{{grant.allocationSubjectsTitle}}</view><view wx:for="{{grant.allocationSubjects}}" wx:for-item="subject" wx:key="key"><view>{{subject.label}}</view><view wx:for="{{subject.lines}}" wx:for-item="line" wx:key="key" class="permission-admin-meta">{{line.label}} {{line.value}}</view></view></block>
    <view class="authorization-label">{{ui.scopes}}</view><block wx:for="{{grant.scopes}}" wx:for-item="scope" wx:key="key"><view>{{scope.label}}</view><view wx:for="{{scope.lines}}" wx:for-item="line" wx:key="key" class="permission-admin-meta">{{line.label}} {{line.value}}</view></block>
    <view class="authorization-label">{{ui.fields}}</view><view wx:for="{{grant.fieldLabels}}" wx:key="*this" class="permission-admin-meta">{{item}}</view>
    <view class="authorization-label">{{ui.conditions}}</view><view wx:if="{{!grant.startsAtText && !grant.endsAtText}}">{{ui.noConditions}}</view><view wx:if="{{grant.startsAtText}}">{{ui.startsAt}} · {{grant.startsAtText}}</view><view wx:if="{{grant.endsAtText}}">{{ui.endsAt}} · {{grant.endsAtText}}</view>
  </view>
</template>
<template name="schemePermissionVersion">
  <view class="authorization-disclosure ui-motion-card" role="button" aria-expanded="{{expanded[versionKey] === true}}" data-id="{{versionKey}}" bindtap="toggleDetails" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
    <view class="authorization-label">{{title}}</view>
    <view class="authorization-permission-chevron {{expanded[versionKey] ? 'authorization-permission-chevron-open' : ''}}"><ui-icon name="chevron-right" sizeRole="row-leading" /></view>
  </view>
  <block wx:if="{{expanded[versionKey]}}">
    <template is="permissionTree" data="{{businesses: schemePermissions[versionKey].businesses, prefix: 'version:' + versionKey + ':', expanded, readOnly: true}}" />
    <view wx:if="{{schemePermissions[versionKey].missing}}" class="permission-admin-meta">{{ui.unavailableReference}}</view>
    <view wx:elif="{{!schemePermissions[versionKey].businesses.length}}" class="permission-admin-meta">{{ui.noConfiguredPermissions}}</view>
  </block>
</template>
<view class="page permission-page authorization-page" style="min-height: calc(100vh - {{navTopPx}}px)">
  <workspace-hero class="workspace-hero-host" app-name="{{ui.appName}}" page-name="{{ui.title}}" tone="{{heroTone}}" />
  <view class="tabs-card workspace-primary-tabs">
    <view wx:for="{{tabs}}" wx:key="*this" class="feature-tab {{tab === item ? 'feature-tab-active' : ''}} ui-motion-chip" data-tab="{{item}}" bindtap="switchTab" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{unified && ui.unified[item] || ui[item]}}</view>
  </view>
  <view wx:if="{{previewOnly}}" class="permission-empty">{{ui.previewOnly}}</view>
  <app-loading wx:if="{{loading}}" text="{{ui.loading}}" />
  <view wx:if="{{notice}}" class="permission-card authorization-toolbar"><view>{{notice}}</view><button class="secondary-btn ui-motion-button" bindtap="load" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.retry}}</button></view>
  <block wx:if="{{ready && !loading}}">
    <view wx:if="{{canCopy}}" class="permission-card authorization-toolbar">
      <button class="secondary-btn ui-motion-button authorization-compact" bindtap="openOrganizationCopy" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.configurationCopy.title}}</button>
    </view>
    <view wx:if="{{tab !== 'effective'}}" class="permission-card authorization-toolbar">
      <view class="permission-section-head">
        <view class="permission-section-title">{{unified && ui.unified[tab] || ui[tab]}}</view>
        <button wx:if="{{tab === 'schemes' || !unified || hasPublishedSchemes}}" class="primary-btn ui-motion-button" bindtap="edit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{tab === 'rules' && unified ? ui.unified.assignPublishedRole : tab === 'rules' ? ui.createRule : ui.createScheme}}</button>
        <button wx:elif="{{canManage}}" class="secondary-btn ui-motion-button" data-tab="schemes" bindtap="switchTab" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.identitySettingsEntry}}</button>
      </view>
      <view class="permission-section-desc">{{!unified ? ui.tabHelp[tab] : tab === 'schemes' ? ui.unified.landingRoleHelp : hasPublishedSchemes ? ui.unified.landingRuleHelp : canManage ? ui.unified.landingNoPublishedRole : ui.unified.landingAskForPublishedRole}}</view>
      <view class="ui-list-filter-search"><ui-icon name="search" tone="muted" sizeRole="row-leading" /><input class="ui-list-filter-input" value="{{keyword}}" bindinput="search" placeholder="{{tab === 'schemes' ? ui.searchIdentities : ui.allocation.search}}" /></view>
      <block wx:if="{{tab === 'rules'}}">
        <view class="authorization-filter-row">
          <block wx:if="{{!showRules}}">
            <block wx:for="{{allocationFilterFields}}" wx:key="key">
              <view wx:if="{{!item.more || moreAllocationFilters}}" class="authorization-allocation-filter">
                <view class="authorization-label">{{item.label}}</view>
                <picker range="{{item.options}}" range-key="name" value="{{item.index}}" data-key="{{item.key}}" bindchange="filterAllocations"><view class="picker-value">{{item.options[item.index].name}}</view></picker>
              </view>
            </block>
          </block>
          <view class="authorization-filter-actions">
            <block wx:if="{{!showRules}}">
              <button class="secondary-btn ui-motion-button" bindtap="toggleAllocationFilters" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{moreAllocationFilters ? ui.allocation.fewerFilters : ui.allocation.moreFilters}}</button>
              <button class="secondary-btn ui-motion-button" bindtap="clearAllocationFilters" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.allocation.clearFilters}}</button>
            </block>
            <button wx:if="{{!roleBindingOnly}}" class="secondary-btn ui-motion-button" bindtap="toggleRules" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{showRules ? ui.byRecipient : ui.advancedRules}}</button>
            <button wx:if="{{hasEditableAllocations}}" class="secondary-btn ui-motion-button" bindtap="toggleSelection" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{selecting ? ui.finishSelection : ui.batchSelect}}</button>
          </view>
        </view>
        <view wx:if="{{!showRules}}" class="permission-admin-meta">{{ui.allocation.filterHelp}}</view>
        <view wx:if="{{!showRules}}" class="permission-admin-meta">{{allocationResultText}}</view>
        <block wx:if="{{selecting}}">
          <view class="permission-admin-meta">{{ui.allocation.batchHelp}}</view>
          <view class="permission-admin-meta">{{selectedText}}</view>
          <view class="authorization-filter-row"><button class="secondary-btn ui-motion-button" bindtap="selectShown" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.selectShown}}</button><button class="secondary-btn ui-motion-button" bindtap="clearSelection" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.clearSelection}}</button><button class="danger-btn ui-motion-button" disabled="{{!selectedCount}}" bindtap="deleteSelected" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.deleteSelected}}</button></view>
        </block>
      </block>
    </view>
    <block wx:if="{{tab === 'rules'}}">
      <block wx:if="{{!showRules}}">
        <view wx:if="{{!allocations.length}}" class="permission-empty">{{keyword || hasAllocationFilters ? ui.allocation.noMatches : ui.allocation.empty}}</view>
        <view wx:for="{{allocations}}" wx:for-item="grant" wx:key="id" class="permission-card authorization-body authorization-allocation {{selecting && grant.canEdit !== false ? 'selection-option-card ui-motion-card' : ''}} {{selecting && selectedRules[grant.id] ? 'selection-option-card-selected' : ''}}" data-id="{{grant.id}}" bindtap="selectRule" hover-class="{{selecting && grant.canEdit !== false ? 'ui-press-card' : 'none'}}" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="authorization-label">{{ui.allocation.role}}</view>
          <view class="permission-section-title">{{grant.roleName}}</view>
          <view class="authorization-allocation-facts">
            <view class="authorization-allocation-fact">
              <view class="authorization-label">{{ui.allocation.recipient}}</view>
              <block wx:for="{{grant.recipientRows}}" wx:for-item="recipient" wx:key="key">
                <view>{{recipient.name}}<text wx:if="{{recipient.detail}}" class="permission-admin-meta"> · {{recipient.detail}}</text></view>
                <block wx:if="{{expanded['allocation:' + grant.id] && recipient.lines.length}}">
                  <view class="permission-admin-meta">{{ui.allocation.conditionalHelp}}</view>
                  <view wx:for="{{recipient.lines}}" wx:for-item="line" wx:key="key" class="permission-admin-meta">{{line.label}} {{line.value}}</view>
                </block>
              </block>
            </view>
            <view class="authorization-allocation-fact"><view class="authorization-label">{{ui.allocation.dataScope}}</view><view wx:for="{{grant.scopeNames}}" wx:key="*this">{{item}}</view></view>
            <view class="authorization-allocation-fact"><view class="authorization-label">{{ui.allocation.status}}</view><view><text class="authorization-chip">{{grant.statusText}}</text></view></view>
          </view>
          <view class="authorization-row-actions">
            <button class="secondary-btn ui-motion-button authorization-link" data-id="{{'allocation:' + grant.id}}" aria-expanded="{{!!expanded['allocation:' + grant.id]}}" catchtap="toggleDetails" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{expanded['allocation:' + grant.id] ? ui.allocation.hide : ui.allocation.view}}</button>
            <button wx:if="{{grant.canEdit !== false}}" class="secondary-btn ui-motion-button authorization-link authorization-edit" data-id="{{grant.id}}" data-kind="rule" catchtap="edit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{ui.allocation.adjust}}</button>
          </view>
          <block wx:if="{{expanded['allocation:' + grant.id]}}">
            <view wx:if="{{grant.custom}}" class="permission-admin-meta">{{ui.customAuthorization}}</view>
            <view wx:if="{{grant.shared}}" class="permission-admin-meta">{{ui.allocation.sharedNotice}}</view>
            <view class="authorization-label">{{grant.effectText}}</view>
            <template is="grantDetails" data="{{grant, ui}}" />
          </block>
        </view>
        <view wx:if="{{allocationPages > 1}}" class="authorization-allocation-pager">
          <button class="secondary-btn ui-motion-button" data-direction="-1" disabled="{{allocationPage === 1}}" bindtap="changeAllocationPage" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.allocation.previousPage}}</button>
          <text class="permission-admin-meta">{{allocationPageText}}</text>
          <button class="secondary-btn ui-motion-button" data-direction="1" disabled="{{allocationPage === allocationPages}}" bindtap="changeAllocationPage" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.allocation.nextPage}}</button>
        </view>
      </block>
      <block wx:else>
      <view wx:if="{{!cards.length}}" class="permission-empty">{{keyword ? ui.noMatchingRules : ui.noRules}}</view>
      <view wx:for="{{cards}}" wx:key="id" class="permission-card {{selecting ? 'selection-option-card' : ''}} {{selecting && selectedRules[item.id] ? 'selection-option-card-selected' : ''}}" data-id="{{item.id}}" catchtap="selectRule">
        <view class="permission-section-head"><view class="permission-section-title">{{item.name}}</view><view class="authorization-chip">{{item.effectText}}</view></view>
        <view class="authorization-chips"><text wx:for="{{expanded[item.id] ? item.capabilityLabels : item.summaryLabels}}" wx:for-item="label" wx:key="*this" class="authorization-chip">{{label}}</text></view>
        <view class="permission-admin-meta">{{item.enabledText}}</view>
        <view class="authorization-disclosure ui-motion-card" data-id="{{item.id}}" catchtap="toggleDetails" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160"><view class="authorization-summary">{{item.capabilityCountText}}</view><ui-icon name="chevron-right" sizeRole="row-leading" /></view>
        <view wx:if="{{expanded[item.id]}}" class="authorization-details">
          <view class="authorization-label">{{ui.subjects}}</view>
          <block wx:for="{{item.subjects}}" wx:for-item="subject" wx:key="key"><view>{{subject.label}}</view><view wx:for="{{subject.lines}}" wx:for-item="line" wx:key="key" class="permission-admin-meta">{{line.label}} {{line.value}}</view></block>
          <view class="authorization-label">{{ui.scopes}}</view>
          <block wx:for="{{item.scopes}}" wx:for-item="scope" wx:key="key"><view>{{scope.label}}</view><view wx:for="{{scope.lines}}" wx:for-item="line" wx:key="key" class="permission-admin-meta">{{line.label}} {{line.value}}</view></block>
          <view class="authorization-label">{{ui.fields}}</view>
          <view wx:for="{{item.fieldLabels}}" wx:for-item="label" wx:key="*this" class="permission-admin-meta">{{label}}</view>
        </view>
        <view wx:if="{{item.canEdit !== false}}" class="authorization-row-actions"><button class="secondary-btn ui-motion-button authorization-link authorization-edit" data-id="{{item.id}}" data-kind="rule" catchtap="edit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.edit}}</button><button class="secondary-btn ui-motion-button authorization-link" data-id="{{item.id}}" data-kind="rule" data-copy="{{true}}" catchtap="edit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.copy}}</button><button class="danger-btn ui-motion-button authorization-link authorization-link-danger" data-id="{{item.id}}" data-kind="delete" catchtap="changes" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.remove}}</button></view>
      </view>
      </block>
    </block>
    <block wx:elif="{{tab === 'schemes'}}">
      <view wx:if="{{!schemes.length}}" class="permission-empty">{{ui.noSchemes}}</view>
      <view wx:for="{{schemes}}" wx:key="id" class="permission-card authorization-body">
        <view class="authorization-disclosure ui-motion-card" data-id="{{'scheme:' + item.id}}" bindtap="toggleDetails" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160"><view><view class="permission-section-title">{{item.name}}</view><view class="authorization-summary">{{item.countText}}</view><view wx:if="{{item.draftRestrictedLabels.length}}" class="authorization-summary">{{ui.unified.schemeBlockedStatus}}</view></view><text class="authorization-chip">{{item.versionText}}</text><ui-icon name="chevron-right" sizeRole="row-leading" /></view>
        <block wx:if="{{expanded['scheme:' + item.id]}}">
        <template wx:if="{{item.publishedVersion}}" is="schemePermissionVersion" data="{{title: ui.schemePublishedTitle, versionKey: 'published:' + item.id, expanded, schemePermissions, ui}}" />
        <template wx:if="{{item.canEdit !== false}}" is="schemePermissionVersion" data="{{title: ui.schemeDraftTitle, versionKey: 'draft:' + item.id, expanded, schemePermissions, ui}}" />
        <view wx:if="{{item.draftRestrictedLabels.length}}" class="authorization-group authorization-body">
          <view class="permission-admin-meta">{{ui.unified.schemePublishBlocked}}</view>
          <view class="authorization-chips"><text wx:for="{{item.draftRestrictedLabels}}" wx:for-item="blocked" wx:key="key" class="authorization-status authorization-status-warning">{{blocked.label}}</text></view>
        </view>
        <view class="authorization-row-actions">
          <button wx:if="{{item.canEdit !== false}}" class="secondary-btn ui-motion-button authorization-link authorization-edit" data-id="{{item.id}}" data-kind="scheme" bindtap="edit" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{item.draftRestrictedLabels.length ? ui.editSchemeTitle : ui.edit}}</button>
          <button wx:if="{{item.canPublish !== false && !item.draftRestrictedLabels.length}}" class="primary-btn ui-motion-button" data-id="{{item.id}}" data-kind="publish" bindtap="changes" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.publish}}</button>
          <button wx:if="{{item.publishedVersion && item.draftRestrictedLabels.length}}" class="secondary-btn ui-motion-button authorization-link" data-id="{{item.id}}" data-kind="publish" bindtap="changes" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.versionHistory}}</button>
        </view>
        </block>
      </view>
    </block>
    <block wx:else>
      <view class="permission-card authorization-toolbar">
        <view class="permission-section-head"><view class="permission-section-title">{{inspectionLabel}}</view><button class="secondary-btn ui-motion-button" disabled="{{inspecting}}" bindtap="inspect" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.refresh}}</button></view>
        <view class="permission-section-title">{{inspectingOther ? ui.effective : ui.ownPermissions}}</view>
        <view wx:if="{{!inspectingOther}}" class="permission-admin-meta">{{canInspectOthers ? ui.unified.landingEffectiveHelp : ui.unified.landingOwnEffectiveHelp}}</view>
        <view wx:if="{{canInspectOthers}}" class="authorization-label">{{ui.inspectOthers}}</view>
        <view wx:if="{{canInspectOthers}}" class="authorization-actions">
          <button class="secondary-btn ui-motion-button" disabled="{{candidateLoading}}" data-role="user" bindtap="openInspection" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.inspectAssignment}}</button>
          <button wx:if="{{!unified}}" class="secondary-btn ui-motion-button" disabled="{{candidateLoading}}" data-role="admin" bindtap="openInspection" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.inspectAdmin}}</button>
        </view>
        <button class="secondary-btn ui-motion-button" bindtap="ownInspection" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{ui.ownRole}}</button>
        <app-loading wx:if="{{inspecting || candidateLoading}}" text="{{ui.loading}}" />
      </view>
      <view class="permission-card authorization-toolbar">
        <view class="tabs workspace-secondary-tabs">
          <view class="tab {{effectiveRange === 'granted' ? 'tab-active' : ''}} ui-motion-chip" data-range="granted" bindtap="selectEffectiveRange" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{ui.effectiveAssigned}}</view>
          <view class="tab {{effectiveRange === 'all' ? 'tab-active' : ''}} ui-motion-chip" data-range="all" bindtap="selectEffectiveRange" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{ui.effectiveAll}}</view>
        </view>
        <view class="permission-admin-meta">{{effectiveRange === 'all' ? ui.effectiveAllHelp : ui.effectiveAssignedHelp}}</view><view class="permission-admin-meta">{{ui.effectiveHelp}}</view>
        <view class="ui-list-filter-search"><ui-icon name="search" tone="muted" sizeRole="row-leading" /><input class="ui-list-filter-input" value="{{keyword}}" bindinput="search" placeholder="{{ui.searchEffective}}" /></view>
      </view>
      <view wx:if="{{inspectionLoaded && !effectiveGroups.length}}" class="permission-card">{{inspectionUnavailable ? ui.permissionUnavailable : keyword ? ui.noMatchingPermissions : ui.noConfiguredPermissions}}</view>
      <view wx:if="{{controlledEffective.length}}" class="permission-card authorization-section"><view class="authorization-disclosure ui-motion-card" data-key="controlled" bindtap="toggleEffectiveGroup" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160"><view>{{ui.systemControlledTitle}}</view><ui-icon name="chevron-right" sizeRole="row-leading" /></view><block wx:if="{{effectiveExpanded.controlled}}"><view class="permission-admin-meta">{{ui.systemControlledHelp}}</view><view wx:for="{{controlledEffective}}" wx:key="*this">{{item}}</view></block></view>
      <view wx:for="{{effectiveGroups}}" wx:key="key" class="permission-card effective-group">
        <view class="authorization-disclosure ui-motion-card" data-key="{{item.key}}" bindtap="toggleEffectiveGroup" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160"><view><view class="authorization-title">{{item.label}}</view><view class="authorization-summary">{{item.countText}}</view></view><ui-icon name="chevron-right" sizeRole="row-leading" /></view>
        <view wx:if="{{effectiveExpanded[item.key]}}" class="authorization-body">
          <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="capability" class="authorization-section">
            <view class="authorization-disclosure ui-motion-card" data-key="{{'operation:' + entry.capability}}" bindtap="toggleEffectiveGroup" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160"><view>{{entry.label}}</view><text class="authorization-status {{entry.grantState !== 'granted' ? 'authorization-status-warning' : ''}}">{{entry.statusText}}</text><ui-icon wx:if="{{entry.rules.length}}" name="chevron-right" sizeRole="row-leading" /></view>
            <block wx:if="{{effectiveExpanded['operation:' + entry.capability]}}">
            <view wx:if="{{unified}}" class="authorization-chips"><text class="authorization-chip">{{entry.categoryLabel}}</text><text wx:if="{{entry.roleName}}" class="authorization-chip">{{entry.roleName}}</text></view>
            <view wx:for="{{entry.rules}}" wx:for-item="rule" wx:key="id" class="authorization-group authorization-section"><view class="authorization-label">{{rule.name}}</view>
              <view class="authorization-chip">{{rule.sections.effectText}}</view>
              <view class="authorization-label">{{ui.scopes}}</view><view wx:for="{{rule.sections.scopes}}" wx:for-item="scope" wx:key="key"><view>{{scope.label}}</view><view wx:for="{{scope.lines}}" wx:for-item="line" wx:key="key">{{line.label}} {{line.value}}</view></view>
              <block wx:if="{{entry.supportsFields}}"><view class="authorization-label">{{ui.fields}}</view><view wx:if="{{!rule.displayFields.length}}">{{ui.effectiveNoVisibleFields}}</view><view wx:for="{{rule.sections.fieldLabels}}" wx:for-item="label" wx:key="*this">{{label}}</view><view class="permission-admin-meta">{{ui.effectiveFieldsHelp}}</view></block>
              <view class="authorization-label">{{ui.conditions}}</view><view wx:if="{{!rule.startsAtText && !rule.endsAtText}}">{{ui.noConditions}}</view><view wx:if="{{rule.startsAtText}}">{{ui.startsAt}} · {{rule.startsAtText}}</view><view wx:if="{{rule.endsAtText}}">{{ui.endsAt}} · {{rule.endsAtText}}</view>
            </view>
            </block>
          </view>
        </view>
      </view>
    </block>
  </block>
  <personnel-picker visible="{{!!picker}}" title="{{picker === 'user' ? ui.inspectAssignment : ui.inspectAdmin}}" options="{{pickerOptions}}" value="{{pickerValue}}" multiple="{{false}}" selectionLevel="{{picker === 'user' ? 'assignment' : 'person'}}" bind:confirm="confirmInspection" bind:cancel="closeInspection" />
  <app-toast />
</view>

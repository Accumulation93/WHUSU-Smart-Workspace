<view class="page auth-page">
  <workspace-hero class="workspace-hero-host" app-name="WHUSU智慧工作台" page-name="身份认证" tone="admin"></workspace-hero>

  <view class="global-scope-notice" wx:if="{{showGlobalScopeNotice}}">
    <view class="global-scope-icon"><ui-icon name="shield" tone="primary" size="29" ariaLabel="全部组织" /></view>
    <view class="global-scope-copy">
      <view class="global-scope-title">适用于全部组织</view>
      <view class="global-scope-detail">当前查看组织：{{currentOrganizationName || '未选择组织'}}</view>
    </view>
  </view>

  <view class="card auth-card" wx:if="{{tabs.length}}">
    <view class="tabs-card">
      <view class="feature-tab {{activeTab === item.key ? 'feature-tab-active' : ''}} ui-motion-chip" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{item.label}}</view>
    </view>

    <view class="loading-text" wx:if="{{loading}}">正在加载…</view>

    <view wx:elif="{{activeTab === 'claims'}}">
      <view class="auth-filter-row"><input class="field-input auth-filter-input" placeholder="按姓名或学号查找" value="{{eligibleSearch}}" bindinput="onEligibleSearch" /><picker wx:if="{{eligibleOrganizations.length > 1}}" range="{{eligibleOrganizations}}" range-key="name" bindchange="onEligibleOrganizationChange"><view class="field-picker auth-filter-picker">{{eligibleOrganizationName || '全部组织'}} ›</view></picker><button class="secondary-btn compact-btn ui-motion-button" bindtap="filterEligible" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">筛选</button></view>
      <view class="empty-state" wx:if="{{!claims.length}}">暂无待处理身份认证</view>
      <view class="claim-toolbar" wx:else>
        <view class="claim-toolbar-copy">已选择 {{selectedClaimIds.length}} 项</view>
        <view class="claim-toolbar-actions">
          <view class="claim-tool ui-motion-chip" bindtap="selectAllClaims" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">全选</view>
          <view class="claim-tool ui-motion-chip" bindtap="clearClaimSelection" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">清除</view>
          <button class="primary-btn compact-btn batch-issue-btn ui-motion-button" disabled="{{!selectedClaimIds.length}}" loading="{{actionLoading}}" bindtap="issueSelectedCodes" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">批量生成</button>
        </view>
      </view>
      <view class="request-item" wx:for="{{claims}}" wx:key="id">
        <view class="claim-selector {{item.selected ? 'claim-selector-active' : ''}} ui-motion-chip" data-id="{{item.id}}" bindtap="toggleClaimSelection" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" aria-role="checkbox" aria-checked="{{item.selected}}">
          <view class="claim-selector-mark">{{item.selected ? '✓' : ''}}</view>
        </view>
        <view class="request-copy">
          <view class="request-name">{{item.name}}</view>
          <view class="request-meta">{{item.studentId}} · {{item.requestedOrganizationName}}</view>
          <view class="request-meta">提交于 {{item.createdText}}</view>
        </view>
        <button class="primary-btn compact-btn ui-motion-button" data-id="{{item.id}}" data-name="{{item.name}}" loading="{{actionLoading}}" bindtap="issueCode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{item.hasActiveCode ? '生成新认证码' : '生成认证码'}}</button>
      </view>
      <view class="section-divider" wx:if="{{eligibleClaims.length}}">未绑定人员</view>
      <view class="claim-toolbar" wx:if="{{eligibleClaims.length}}">
        <view class="claim-toolbar-copy">已选 {{selectedEligiblePersonIds.length}} 人</view>
        <view class="claim-toolbar-actions">
          <view class="claim-tool ui-motion-chip" bindtap="selectAllEligible" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">全选</view>
          <view class="claim-tool ui-motion-chip" bindtap="clearEligibleSelection" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">清除</view>
          <button class="primary-btn compact-btn ui-motion-button" disabled="{{!selectedEligiblePersonIds.length}}" loading="{{actionLoading}}" bindtap="issueSelectedInvites" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">生成初始化码</button><button class="secondary-btn compact-btn ui-motion-button" disabled="{{!selectedEligiblePersonIds.length}}" loading="{{actionLoading}}" bindtap="revokeSelectedInvites" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">撤销旧码</button>
        </view>
      </view>
      <view class="request-item" wx:for="{{eligibleClaims}}" wx:key="personId">
        <view class="claim-selector {{item.selected ? 'claim-selector-active' : ''}} ui-motion-chip" data-id="{{item.personId}}" bindtap="toggleEligibleSelection" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160"><view class="claim-selector-mark">{{item.selected ? '✓' : ''}}</view></view>
        <view class="request-copy"><view class="request-name">{{item.name}}</view><view class="request-meta">{{item.studentId}} · {{item.organizationName}}</view><view class="request-meta">{{item.departmentName || ''}} {{item.identityName || ''}} {{item.workGroupName || ''}}</view></view>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'recoveries'}}">
      <view class="auth-filter-row"><input class="field-input auth-filter-input" placeholder="按姓名或学号查找" value="{{recoverySearch}}" bindinput="onRecoverySearch" /><button class="secondary-btn compact-btn ui-motion-button" bindtap="filterRecovery" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">筛选</button></view>
      <view class="empty-state" wx:if="{{!recoveries.length}}">暂无待处理账号恢复</view>
      <view class="request-item" wx:for="{{recoveries}}" wx:key="id">
        <view class="request-copy">
          <view class="request-name">{{item.name}}</view>
          <view class="request-meta">{{item.studentId}} · {{item.requestedOrganizationName}}</view>
          <view class="request-meta">提交于 {{item.createdText}}</view>
        </view>
        <button class="primary-btn compact-btn ui-motion-button" data-id="{{item.id}}" bindtap="openRecoveryDialog" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">审核恢复</button>
      </view>
      <view class="section-divider" wx:if="{{recoveryAccounts.length}}">已认证账号</view>
      <view class="claim-toolbar" wx:if="{{recoveryAccounts.length}}"><view class="claim-toolbar-copy">已选 {{selectedRecoveryAccountIds.length}} 人</view><view class="claim-toolbar-actions"><view class="claim-tool ui-motion-chip" bindtap="selectAllRecoveryAccounts" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">全选</view><view class="claim-tool ui-motion-chip" bindtap="clearRecoverySelection" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">清除</view><button class="primary-btn compact-btn ui-motion-button" disabled="{{!selectedRecoveryAccountIds.length}}" loading="{{actionLoading}}" bindtap="issueSelectedRecoveryCodes" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">生成恢复码</button><button class="secondary-btn compact-btn ui-motion-button" disabled="{{!selectedRecoveryAccountIds.length}}" loading="{{actionLoading}}" bindtap="revokeSelectedRecoveryCodes" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">撤销旧码</button></view></view>
      <view class="request-item" wx:for="{{recoveryAccounts}}" wx:key="accountId"><view class="claim-selector {{item.selected ? 'claim-selector-active' : ''}} ui-motion-chip" data-id="{{item.accountId}}" bindtap="toggleRecoverySelection" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160"><view class="claim-selector-mark">{{item.selected ? '✓' : ''}}</view></view><view class="request-copy"><view class="request-name">{{item.name}}</view><view class="request-meta">{{item.studentId}} · {{item.statusLabel}}</view></view></view>
    </view>

    <view wx:elif="{{activeTab === 'accounts'}}">
      <view class="auth-filter-row"><input class="field-input auth-filter-input" placeholder="按姓名或学号查找" value="{{accountSearch}}" bindinput="onAccountSearch" /><button class="secondary-btn compact-btn ui-motion-button" bindtap="filterAccounts" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">筛选</button></view>
      <view class="empty-state" wx:if="{{!accounts.length}}">暂无已认证账号</view>
      <view class="request-item" wx:for="{{accounts}}" wx:key="accountId">
        <view class="request-copy">
          <view class="request-name">{{item.name}}</view>
          <view class="request-meta">{{item.studentId}} · {{item.statusLabel}}{{item.isSuperAdmin ? ' · 超级管理员' : ''}}</view>
        </view>
        <button class="{{item.accountStatus === 'frozen' ? 'primary-btn' : 'secondary-btn'}} compact-btn ui-motion-button" data-id="{{item.personId}}" data-frozen="{{item.accountStatus === 'frozen'}}" loading="{{actionLoading}}" bindtap="toggleAccountFrozen" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{item.accountStatus === 'frozen' ? '解除冻结' : '冻结账号'}}</button>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'policy' && policy}}">
      <view class="policy-row">
        <view><view class="request-name">开放首次认证</view><view class="request-meta">关闭后，未使用的认证码失效</view></view>
        <switch color="#3b82f6" checked="{{policy.initialClaimEnabled}}" data-field="initialClaimEnabled" bindchange="onPolicySwitch" />
      </view>
      <view class="policy-field">
        <view class="request-name">认证开放时间</view>
        <view class="policy-time-grid">
          <picker mode="date" value="{{policy.claimStartsDate}}" data-field="claimStartsDate" bindchange="onPolicyDateChange">
            <view class="field-picker">{{policy.claimStartsDate || '立即开放'}}<text class="field-picker-arrow">›</text></view>
          </picker>
          <picker mode="time" value="{{policy.claimStartsTime}}" data-field="claimStartsTime" bindchange="onPolicyTimeChange">
            <view class="field-picker">{{policy.claimStartsTime || '00:00'}}<text class="field-picker-arrow">›</text></view>
          </picker>
          <view class="policy-clear ui-motion-chip" data-prefix="claimStarts" bindtap="clearPolicyTime" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">清除</view>
        </view>
      </view>
      <view class="policy-field">
        <view class="request-name">认证截止时间</view>
        <view class="policy-time-grid">
          <picker mode="date" value="{{policy.claimEndsDate}}" data-field="claimEndsDate" bindchange="onPolicyDateChange">
            <view class="field-picker">{{policy.claimEndsDate || '不设截止'}}<text class="field-picker-arrow">›</text></view>
          </picker>
          <picker mode="time" value="{{policy.claimEndsTime}}" data-field="claimEndsTime" bindchange="onPolicyTimeChange">
            <view class="field-picker">{{policy.claimEndsTime || '23:59'}}<text class="field-picker-arrow">›</text></view>
          </picker>
          <view class="policy-clear ui-motion-chip" data-prefix="claimEnds" bindtap="clearPolicyTime" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">清除</view>
        </view>
      </view>
      <view class="policy-row">
        <view><view class="request-name">允许账号恢复码</view><view class="request-meta">使用后自动失效</view></view>
        <switch color="#3b82f6" checked="{{policy.allowRecoveryCode}}" data-field="allowRecoveryCode" bindchange="onPolicySwitch" />
      </view>
      <view class="policy-row">
        <view><view class="request-name">允许恢复口令</view><view class="request-meta">用户可以自行设置恢复口令</view></view>
        <switch color="#3b82f6" checked="{{policy.allowPassphrase}}" data-field="allowPassphrase" bindchange="onPolicySwitch" />
      </view>
      <view class="policy-field" wx:if="{{policy.allowPassphrase}}">
        <view class="request-name">恢复口令最短长度</view>
        <input class="field-input policy-input" type="number" value="{{policy.passphraseMinLength}}" bindinput="onMinLengthInput" />
      </view>
      <button class="primary-btn policy-save ui-motion-button" loading="{{actionLoading}}" bindtap="savePolicy" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">保存设置</button>
    </view>

    <view wx:elif="{{activeTab === 'audit'}}">
      <view class="empty-state" wx:if="{{!auditEvents.length}}">暂无操作记录</view>
      <view class="audit-item" wx:for="{{auditEvents}}" wx:key="id">
        <view class="request-name">{{item.eventTypeLabel}}</view>
        <view class="request-meta">{{item.actorName || '自动操作'}} → {{item.targetName || '自动操作'}}</view>
        <view class="request-meta">{{item.createdText}}</view>
      </view>
    </view>
  </view>

  <view class="card auth-card empty-state" wx:else>请使用可管理账号认证的管理员身份</view>

  <root-portal enable="{{showCodeDialog}}">
  <view class="dialog-layer ui-overlay" wx:if="{{showCodeDialog}}">
    <view class="dialog-mask ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="dialog-panel auth-dialog modal-card ui-dialog-shell ui-dialog-shell--compact">
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="ui-dialog-body ui-dialog-scroll--fill ui-dialog-stack-scroll">
        <view class="dialog-badge">个人认证码</view>
        <view class="dialog-title">{{issuedCodes.length > 1 ? '个人认证码已批量生成' : issuedPersonName + '的个人认证码'}}</view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="issued-code-list ui-dialog-scroll--pane" scroll-y>
          <view class="issued-code-row" wx:for="{{issuedCodes}}" wx:key="claimId">
            <view class="issued-person">{{item.personName}}</view>
            <view class="issued-code">{{item.verificationCode}}</view>
          </view>
        </scroll-view>
        <view class="dialog-desc">请立即保存并单独发给本人，24 小时后失效。</view>
      </scroll-view>
      <view class="dialog-actions ui-dialog-footer">
        <button class="secondary-btn dialog-btn ui-motion-button" bindtap="copyIssuedCode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{issuedCodes.length > 1 ? '复制全部' : '复制认证码'}}</button>
        <button class="secondary-btn dialog-btn ui-motion-button" bindtap="exportIssuedCodes" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">导出文本</button>
        <button class="primary-btn dialog-btn ui-motion-button" bindtap="closeCodeDialog" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">关闭</button>
      </view>
    </view>
  </view>
  </root-portal>

  <root-portal enable="{{showRecoveryDialog}}">
  <view class="dialog-layer ui-overlay" wx:if="{{showRecoveryDialog}}">
    <view class="dialog-mask ui-overlay-blocker" bindtap="closeRecoveryDialog" catchtouchmove="noop"></view>
    <view class="dialog-panel auth-dialog modal-card ui-dialog-shell ui-dialog-shell--compact">
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="ui-dialog-body ui-dialog-scroll--fill ui-dialog-stack-scroll">
        <view class="dialog-badge">账号恢复</view>
        <view class="dialog-title">确认恢复{{pendingRecovery.name}}的账号？</view>
        <view class="dialog-desc">通过后，新微信将登录该账号，原微信和其他设备会退出。本人的申请请由其他管理员处理。</view>
      </scroll-view>
      <view class="dialog-actions ui-dialog-footer">
        <button class="secondary-btn dialog-btn ui-motion-button" disabled="{{actionLoading}}" bindtap="closeRecoveryDialog" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">取消</button>
        <button class="primary-btn dialog-btn ui-motion-button" loading="{{actionLoading}}" bindtap="approveRecovery" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">确认恢复</button>
      </view>
    </view>
  </view>
  </root-portal>
</view>

<view class="permission-page">
  <workspace-hero class="workspace-hero-host" app-name="WHUSU智慧工作台" page-name="管理员权限" tone="admin"></workspace-hero>

  <view class="permission-card">
    <view class="permission-section-head">
      <view>
        <view class="permission-section-title">管理员列表</view>
      </view>
      <view class="permission-count">{{filteredAdmins.length}} 人</view>
    </view>
    <view class="permission-search">
      <ui-icon name="search" tone="muted" size="32" ariaLabel="搜索" />
      <input class="permission-search-input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索姓名、学号或管理员类型" />
      <view class="permission-search-clear ui-motion-chip" wx:if="{{keyword}}" bindtap="clearKeyword" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"><ui-icon name="x" tone="muted" size="28" ariaLabel="清除" /></view>
    </view>

    <view class="permission-loading" wx:if="{{loading}}">正在加载管理员…</view>
    <view class="permission-empty" wx:elif="{{!filteredAdmins.length}}">当前组织暂无可管理的管理员</view>
    <view class="permission-admin-list" wx:else>
      <view class="permission-admin-row ui-motion-card" wx:for="{{filteredAdmins}}" wx:key="id" data-id="{{item.id}}" bindtap="openAdmin" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160">
        <view class="permission-role-mark" aria-label="管理员">
          <ui-icon name="shield" tone="primary" size="34" ariaLabel="管理员" />
        </view>
        <view class="permission-admin-main">
          <view class="permission-admin-title-row">
            <view class="permission-admin-name">{{item.name || '未命名管理员'}}</view>
            <view class="permission-level permission-level-{{item.adminLevel}}">{{item.adminLevelLabel}}</view>
          </view>
          <view class="permission-admin-meta">学号 {{item.studentId || '未填写'}} · {{item.bindStatusLabel}}</view>
          <view class="permission-admin-progress">
            <view class="permission-progress-track"><view class="permission-progress-fill" style="width: {{item.applicableCount ? item.grantedCount * 100 / item.applicableCount : 0}}%;"></view></view>
            <view class="permission-progress-text">已启用 {{item.grantedCount}} / {{item.applicableCount}}</view>
          </view>
        </view>
        <ui-icon name="chevron-right" tone="muted" size="32" ariaLabel="设置权限" />
      </view>
    </view>
  </view>

  <root-portal enable="{{editorVisible}}">
  <view class="permission-overlay ui-overlay" wx:if="{{editorVisible}}">
    <view class="permission-mask ui-overlay-blocker" bindtap="closeEditor" catchtouchmove="noop"></view>
    <view class="permission-dialog hit-area ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="permission-dialog-header ui-dialog-header">
        <view>
          <view class="permission-dialog-eyebrow">{{selectedAdmin.adminLevelLabel}}</view>
          <view class="permission-dialog-title">{{selectedAdmin.name}}的权限</view>
        </view>
        <view class="permission-close ui-motion-chip" bindtap="closeEditor" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"><ui-icon name="x" tone="muted" size="30" ariaLabel="关闭" /></view>
      </view>
      <scroll-view class="permission-dialog-body ui-dialog-body ui-dialog-scroll--fill" scroll-y enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}">
        <view class="permission-group" wx:for="{{permissionGroups}}" wx:key="key" wx:for-item="group" wx:for-index="groupIndex">
          <view class="permission-group-head">
            <view class="permission-group-copy">
              <view class="permission-group-title">{{group.label}}</view>
              <view class="permission-group-desc">{{group.description}}</view>
            </view>
            <view class="permission-group-switch">
              <text>全部</text>
              <switch checked="{{group.allGranted}}" disabled="{{!group.editableCount}}" color="#2563eb" data-group-index="{{groupIndex}}" bindchange="onGroupChange" />
            </view>
          </view>
          <view class="permission-item" wx:for="{{group.permissions}}" wx:key="key" wx:for-item="permission" wx:for-index="permissionIndex">
            <view class="permission-item-copy">
              <view class="permission-item-title">{{permission.label}}</view>
              <view class="permission-item-desc">{{permission.description}}</view>
            </view>
            <switch checked="{{permission.granted}}" disabled="{{!permission.editable}}" color="#2563eb" data-group-index="{{groupIndex}}" data-permission-index="{{permissionIndex}}" bindchange="onPermissionChange" />
          </view>
        </view>
      </scroll-view>
      <view class="permission-dialog-footer ui-dialog-footer">
        <button class="secondary-btn permission-secondary ui-motion-button" bindtap="closeEditor" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">取消</button>
        <button class="primary-btn permission-primary ui-motion-button" loading="{{saving}}" bindtap="savePermissions" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">保存</button>
      </view>
    </view>
  </view>
  </root-portal>

  <root-portal enable="{{contextSwitchGuardVisible}}">
  <view class="permission-overlay ui-overlay" wx:if="{{contextSwitchGuardVisible}}">
    <view class="permission-mask ui-overlay-blocker" bindtap="closeContextSwitchGuard" catchtouchmove="noop"></view>
    <view class="permission-dialog context-switch-guard-card hit-area ui-dialog-shell ui-dialog-shell--compact" catchtap="noop">
      <view class="context-switch-guard-icon"><ui-icon name="edit" tone="primary" size="34" ariaLabel="未保存内容" /></view>
      <view class="context-switch-guard-title">有未保存内容</view>
      <view class="context-switch-guard-desc">保存或取消修改后再切换组织。</view>
      <view class="context-switch-guard-actions ui-dialog-footer">
        <button class="primary-btn permission-primary ui-motion-button" bindtap="closeContextSwitchGuard" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">继续编辑</button>
      </view>
    </view>
  </view>
  </root-portal>
</view>

page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.permission-page { min-height: 100vh; padding: 28rpx 24rpx 52rpx; box-sizing: border-box; }
.permission-hero { position: relative; overflow: hidden; padding: 40rpx 34rpx 34rpx; border-radius: 38rpx; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%); border: 1rpx solid rgba(255,255,255,.26); box-shadow: 0 24rpx 50rpx rgba(37,99,235,.2), inset 0 1rpx 0 rgba(255,255,255,.24); color: #fff; }
.permission-hero::after { content: ""; position: absolute; right: -70rpx; top: -90rpx; width: 260rpx; height: 260rpx; border-radius: 50%; background: rgba(255,255,255,.12); pointer-events: none; }
.permission-hero-badge { position: relative; z-index: 1; display: inline-block; padding: 8rpx 20rpx; border-radius: var(--ui-compact-radius, 18rpx); background: linear-gradient(135deg, rgba(255,255,255,.22), rgba(255,255,255,.12)); border: 1rpx solid rgba(255,255,255,.28); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.22); font-size: var(--ui-type-meta, 22rpx); }
.permission-hero-title { position: relative; z-index: 1; margin-top: 18rpx; font-size: var(--ui-type-page, 46rpx); line-height: 1.28; font-weight: 750; }
.permission-hero-desc { position: relative; z-index: 1; margin-top: 12rpx; max-width: 650rpx; color: rgba(255,255,255,.9); font-size: var(--ui-type-body, 25rpx); line-height: var(--ui-leading-relaxed, 1.7); }
.permission-org { position: relative; z-index: 1; display: flex; align-items: center; gap: 14rpx; margin-top: 26rpx; padding: 15rpx 18rpx; border-radius: 20rpx; background: rgba(255,255,255,.14); border: 1rpx solid rgba(255,255,255,.2); }
.permission-org-copy { min-width: 0; flex: 1; }
.permission-org-label { color: rgba(255,255,255,.72); font-size: var(--ui-type-caption); }
.permission-org-name { margin-top: 3rpx; font-size: var(--ui-type-emphasis); font-weight: 650; word-break: break-word; }
.permission-org-pressing { background: rgba(255,255,255,.2); }

.permission-card { margin-top: 0; padding: 28rpx 26rpx; border-radius: 30rpx; background: linear-gradient(135deg, rgba(255,255,255,.88), rgba(248,251,255,.76)); border: 1rpx solid rgba(255,255,255,.72); box-shadow: 0 18rpx 38rpx rgba(15,23,42,.06), inset 0 1rpx 0 rgba(255,255,255,.82); backdrop-filter: blur(24rpx); -webkit-backdrop-filter: blur(24rpx); }
.permission-section-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; }
.permission-section-title { font-size: var(--ui-type-section, 30rpx); font-weight: 720; color: #0f172a; line-height: 1.4; }
.permission-section-desc { margin-top: 7rpx; color: #64748b; font-size: var(--ui-type-label, 23rpx); line-height: var(--ui-leading-body, 1.6); }
.permission-count { flex: none; padding: 7rpx 16rpx; border-radius: var(--ui-compact-radius, 18rpx); background: linear-gradient(135deg, rgba(239,246,255,.96), rgba(219,234,254,.86)); border: 1rpx solid rgba(147,197,253,.55); color: #2563eb; font-size: var(--ui-type-meta); font-weight: 650; box-shadow: inset 0 1rpx 0 rgba(255,255,255,.78); }
.permission-search { display: flex; align-items: center; gap: 12rpx; margin-top: 22rpx; padding: 0 18rpx; min-height: 82rpx; border-radius: 20rpx; background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(246,249,255,.86)); border: 1rpx solid rgba(219,229,241,.96); box-shadow: 0 8rpx 18rpx rgba(15,23,42,.035), inset 0 1rpx 0 rgba(255,255,255,.88); box-sizing: border-box; }
.permission-search-input { display: block; min-width: 0; flex: 1; height: 82rpx; line-height: 82rpx; font-size: var(--ui-type-emphasis); color: #0f172a; }
.permission-search-clear { flex: none; padding: 10rpx; }
.permission-loading, .permission-empty { padding: 36rpx 20rpx; text-align: center; color: #64748b; font-size: var(--ui-type-body); line-height: 1.65; }
.permission-admin-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 20rpx; }
.permission-admin-row { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 20rpx; border-radius: 24rpx; background: linear-gradient(135deg, rgba(255,255,255,.94), rgba(249,251,255,.84)); border: 1rpx solid rgba(226,237,247,.96); box-shadow: 0 10rpx 24rpx rgba(15,23,42,.04), inset 0 1rpx 0 rgba(255,255,255,.82); }
.permission-role-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border: 1rpx solid rgba(191, 219, 254, 0.84);
  border-radius: 18rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(219, 234, 254, 0.78));
  box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}
.permission-admin-main { min-width: 0; flex: 1; }
.permission-admin-title-row { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.permission-admin-name { color: #0f172a; font-size: var(--ui-type-value, 28rpx); font-weight: 700; line-height: var(--ui-leading-heading, 1.45); }
.permission-level { padding: 5rpx 11rpx; border-radius: var(--ui-compact-radius, 18rpx); background: linear-gradient(135deg, rgba(239,246,255,.96), rgba(219,234,254,.84)); border: 1rpx solid rgba(147,197,253,.52); color: #2563eb; font-size: var(--ui-type-micro); }
.permission-level-super_admin { background: linear-gradient(135deg, rgba(219,234,254,.96), rgba(191,219,254,.84)); border-color: rgba(147,197,253,.66); color: #2563eb; }
.permission-admin-meta { margin-top: 7rpx; color: #64748b; font-size: var(--ui-type-meta); }
.permission-admin-progress { display: flex; align-items: center; gap: 12rpx; margin-top: 13rpx; }
.permission-progress-track { min-width: 100rpx; max-width: 240rpx; height: 8rpx; flex: 1; overflow: hidden; border-radius: 999rpx; background: linear-gradient(135deg, rgba(226,237,247,.78), rgba(248,251,255,.68)); border: 1rpx solid rgba(255,255,255,.66); box-shadow: inset 0 1rpx 4rpx rgba(15,23,42,.08); }
.permission-progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #2563eb 0%, #3b82f6 54%, #60a5fa 100%); box-shadow: 0 0 10rpx rgba(37,99,235,.22); }
.permission-progress-text { flex: none; color: #64748b; font-size: var(--ui-type-caption); }

.permission-overlay { position: fixed; inset: 0; z-index: 900; display: flex; align-items: center; justify-content: center; padding: 16rpx; box-sizing: border-box; }
.permission-mask { position: absolute; inset: 0; background: rgba(15,23,42,.42); backdrop-filter: blur(8rpx); }
.permission-dialog { position: relative; z-index: 1; display: flex; flex-direction: column; width: 100%; max-height: calc(100vh - 32rpx); overflow: hidden; border-radius: 32rpx; background: linear-gradient(135deg, rgba(255,255,255,.97), rgba(248,251,255,.92)); border: 1rpx solid rgba(255,255,255,.84); box-shadow: 0 30rpx 80rpx rgba(15,23,42,.22), inset 0 1rpx 0 rgba(255,255,255,.9); backdrop-filter: blur(28rpx); -webkit-backdrop-filter: blur(28rpx); }
.permission-dialog-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; padding: 28rpx 26rpx 22rpx; flex: none; border-bottom: 1rpx solid rgba(226,237,247,.92); }
.permission-dialog-eyebrow { color: #2563eb; font-size: var(--ui-type-caption); font-weight: 650; }
.permission-dialog-title { margin-top: 6rpx; color: #0f172a; font-size: var(--ui-type-dialog, 32rpx); font-weight: 750; line-height: var(--ui-leading-heading, 1.45); }
.permission-dialog-desc { margin-top: 7rpx; color: #64748b; font-size: var(--ui-type-meta, 22rpx); line-height: var(--ui-leading-body, 1.6); }
.permission-close {
  flex: none;
  padding: 10rpx;
  border: 1rpx solid rgba(191, 219, 254, 0.72);
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(239,246,255,.86));
  box-shadow: 0 8rpx 18rpx rgba(37,99,235,.07);
}
.permission-dialog-body { min-height: 0; flex: 1; padding: 20rpx 22rpx; box-sizing: border-box; }
.permission-group { margin-bottom: 18rpx; padding: 22rpx 20rpx; border-radius: 24rpx; background: linear-gradient(135deg, rgba(255,255,255,.94), rgba(249,251,255,.84)); border: 1rpx solid rgba(226,237,247,.96); box-shadow: 0 10rpx 24rpx rgba(15,23,42,.04), inset 0 1rpx 0 rgba(255,255,255,.82); }
.permission-group-head, .permission-item { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.permission-group-head { padding-bottom: 18rpx; border-bottom: 1rpx solid rgba(226,237,247,.84); }
.permission-group-copy, .permission-item-copy { min-width: 0; flex: 1; }
.permission-group-title { color: #0f172a; font-size: var(--ui-type-value, 28rpx); font-weight: 720; line-height: var(--ui-leading-heading, 1.45); }
.permission-group-desc, .permission-item-desc { margin-top: 5rpx; color: #64748b; font-size: var(--ui-type-meta, 22rpx); line-height: var(--ui-leading-body, 1.6); }
.permission-group-switch { display: flex; align-items: center; gap: 8rpx; flex: none; color: #64748b; font-size: var(--ui-type-caption); }
.permission-item { min-height: 104rpx; padding: 12rpx 0; border-bottom: 1rpx solid rgba(226,237,247,.72); }
.permission-item:last-child { border-bottom: 0; }
.permission-item-title { color: #1e293b; font-size: var(--ui-type-body, 25rpx); font-weight: 650; line-height: var(--ui-leading-heading, 1.45); }
.permission-dialog-footer { display: flex; gap: 16rpx; padding: 18rpx 22rpx; flex: none; border-top: 1rpx solid rgba(226,237,247,.92); background: linear-gradient(180deg, rgba(248,251,255,.72), rgba(248,251,255,.96)); }
.permission-secondary, .permission-primary {
  min-width: 0;
  min-height: 76rpx;
  height: auto;
  flex: 1;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  font-size: var(--ui-type-emphasis);
  font-weight: 680;
  line-height: 1.35;
  box-sizing: border-box;
}
.permission-secondary {
  color: #2563eb;
  background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(235,243,255,.88));
  border: 1rpx solid rgba(191,219,254,.8);
  box-shadow: 0 10rpx 22rpx rgba(37,99,235,.07);
}
.permission-primary { color: #fff; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%); border: 0; box-shadow: 0 12rpx 24rpx rgba(37,99,235,.2), inset 0 1rpx 0 rgba(255,255,255,.24); }

@media (min-width: 520px) {
  .permission-page { width: min(720px, calc(100% - 40px)); margin: 0 auto; padding: 22px 0 32px; }
  .permission-hero { padding: 24px 26px; border-radius: 20px; }
  .permission-hero-title { font-size: var(--ui-type-page); }
  .permission-card { padding: 18px; border-radius: 16px; }
  .permission-dialog { width: min(720px, calc(100vw - 36px)); max-height: calc(100vh - 36px); border-radius: 18px; }
  .permission-dialog-header { padding: 18px 20px 12px; }
  .permission-dialog-body { padding: 12px 18px; }
  .permission-dialog-footer { padding: 12px 18px; }
  .permission-role-mark { width: 36px; height: 36px; border-radius: 10px; }
}

@media (min-width: 900px) {
  .permission-page { width: min(1040px, calc(100% - 56px)); }
  .permission-admin-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .permission-dialog { width: min(860px, calc(100vw - 48px)); }
}
.context-switch-guard-card {
  padding: 26rpx;
  text-align: center;
}

.context-switch-guard-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin: 0 auto 17rpx;
  border: 1rpx solid rgba(147, 197, 253, 0.62);
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.94), rgba(239, 246, 255, 0.82));
}

.context-switch-guard-title {
  color: #0f172a;
  font-size: var(--ui-type-dialog);
  font-weight: 800;
  line-height: 1.45;
}

.context-switch-guard-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: var(--ui-type-body);
  line-height: 1.65;
}

.context-switch-guard-actions {
  margin-top: 20rpx;
  padding: 0;
  border: 0;
  background: transparent;
}

.context-switch-guard-actions button {
  width: 100%;
}

@media (min-width: 520px) {
  .context-switch-guard-card { padding: 18px 20px; }
  .context-switch-guard-icon {
    width: 42px;
    height: 42px;
    margin-bottom: 10px;
    border-radius: 11px;
  }
  .context-switch-guard-desc { margin-top: 8px; }
  .context-switch-guard-actions { margin-top: 12px; }
}

/* 页面背景 */
page {
  background:
    radial-gradient(circle at 12% 10%, rgba(96,165,250,0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191,219,254,0.22) 0%, transparent 24%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.page {
  padding: 32rpx 28rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Hero 区域 */
.hero {
  margin-bottom: 32rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.3;
}

.hero-sub {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 8rpx;
}

/* 空状态 */
.empty-hint {
  font-size: 30rpx;
  color: #64748b;
  text-align: center;
  padding: 48rpx 0 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  padding-bottom: 48rpx;
}

/* 卡片 */
.card {
  background: linear-gradient(135deg, rgba(255,255,255,0.94) 0%, rgba(255,255,255,0.88) 100%);
  border: 1rpx solid rgba(255,255,255,0.82);
  border-radius: 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.06), inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
}

/* 组织列表 */
.org-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.org-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.94) 0%, rgba(255,255,255,0.88) 100%);
  border: 1rpx solid rgba(255,255,255,0.82);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.04), inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
  transition: all 0.2s ease;
}

.org-item--active {
  border-color: rgba(37,99,235,0.36);
  box-shadow: 0 8rpx 28rpx rgba(37,99,235,0.12), inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.org-info {
  flex: 1;
  min-width: 0;
}

.org-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.org-role {
  display: flex;
  gap: 8rpx;
}

.chip {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.chip--blue {
  background: rgba(219,234,254,0.76);
  color: #1d4ed8;
}

.chip--green {
  background: rgba(209,250,229,0.78);
  color: #15803d;
}

.org-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

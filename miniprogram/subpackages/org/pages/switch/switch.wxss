page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96,165,250,0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191,219,254,0.22) 0%, transparent 24%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
  color: #1e293b;
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 30rpx 24rpx 42rpx;
  box-sizing: border-box;
}

.org-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 36rpx 34rpx 34rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 48%, #60a5fa 100%);
  border: 1rpx solid rgba(255,255,255,0.24);
  box-shadow: 0 24rpx 52rpx rgba(37,99,235,0.20), inset 0 1rpx 0 rgba(255,255,255,0.24);
  animation: glassFadeUp 0.42s ease both;
}

.org-hero::before {
  content: "";
  position: absolute;
  top: -86rpx;
  right: -32rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.13);
}

.hero-badge,
.hero-title,
.hero-subtitle {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  margin-bottom: 16rpx;
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  color: rgba(255,255,255,0.96);
  font-size: 21rpx;
  font-weight: 700;
  background: linear-gradient(135deg, rgba(255,255,255,0.22), rgba(255,255,255,0.12));
  border: 1rpx solid rgba(255,255,255,0.28);
}

.hero-title {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.24;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: rgba(255,255,255,0.90);
  font-size: 24rpx;
  line-height: 1.62;
}

.org-item-icon,
.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.org-panel {
  padding: 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.82), rgba(248,251,255,0.70));
  border: 1rpx solid rgba(255,255,255,0.68);
  box-shadow: 0 18rpx 36rpx rgba(15,23,42,0.06), inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
  animation: glassFadeUp 0.46s ease both;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.section-title {
  position: relative;
  padding-left: 20rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 7rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #2563eb, #60a5fa);
  transform: translateY(-50%);
}

.panel-note {
  margin-top: 5rpx;
  color: #64748b;
  font-size: 22rpx;
}

.refresh-status {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 700;
  background: rgba(219,234,254,0.72);
  border: 1rpx solid rgba(147,197,253,0.56);
}

.org-list,
.org-skeleton {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 14rpx;
}

.org-item,
.skeleton-row {
  box-sizing: border-box;
  min-width: 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(247,250,255,0.84));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.80);
}

.org-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 118rpx;
  padding: 20rpx;
  transition: transform 0.20s cubic-bezier(0.16,0.84,0.28,1), box-shadow 0.20s ease, border-color 0.20s ease, background 0.20s ease;
}

.org-item-active {
  border-color: rgba(96,165,250,0.74);
  background: linear-gradient(135deg, rgba(239,246,255,0.96), rgba(219,234,254,0.76));
  box-shadow: 0 14rpx 28rpx rgba(37,99,235,0.10), inset 0 1rpx 0 rgba(255,255,255,0.88);
}

.org-item-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.992);
  box-shadow: 0 6rpx 16rpx rgba(37,99,235,0.08), inset 0 1rpx 0 rgba(255,255,255,0.74);
}

.org-item-switching {
  border-color: rgba(37,99,235,0.52);
}

.org-item-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(219,234,254,0.92), rgba(239,246,255,0.78));
  border: 1rpx solid rgba(147,197,253,0.52);
}

.org-info {
  flex: 1;
  min-width: 0;
}

.org-name {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.org-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.role-chip,
.current-chip {
  padding: 5rpx 13rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
  border: 1rpx solid transparent;
}

.role-chip-admin,
.current-chip {
  color: #2563eb;
  background: rgba(219,234,254,0.76);
  border-color: rgba(147,197,253,0.58);
}

.role-chip-user {
  color: #15803d;
  background: rgba(209,250,229,0.78);
  border-color: rgba(110,231,183,0.58);
}

.org-item-end {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: rgba(241,245,249,0.82);
}

.org-item-active .org-item-end,
.org-item-switching .org-item-end {
  background: linear-gradient(135deg, #2563eb, #60a5fa);
  box-shadow: 0 8rpx 18rpx rgba(37,99,235,0.16);
}

.switching-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(255,255,255,0.18);
}

.skeleton-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 118rpx;
  padding: 20rpx;
}

.skeleton-icon {
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(219,234,254,0.66), rgba(241,245,249,0.88));
}

.skeleton-copy {
  flex: 1;
}

.skeleton-copy view {
  width: 58%;
  height: 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(203,213,225,0.54), rgba(226,232,240,0.76));
}

.skeleton-copy view + view {
  width: 34%;
  height: 14rpx;
  margin-top: 14rpx;
}

.empty-state {
  padding: 54rpx 24rpx 48rpx;
  text-align: center;
}

.empty-icon {
  width: 94rpx;
  height: 94rpx;
  margin: 0 auto 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(241,245,249,0.94), rgba(226,232,240,0.72));
}

.empty-title {
  color: #334155;
  font-size: 28rpx;
  font-weight: 800;
}

.empty-desc {
  max-width: 520rpx;
  margin: 10rpx auto 0;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.65;
}

@media (min-width: 520px) {
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 24px 38px;
  }

  .org-hero {
    padding: 26px 30px;
    border-radius: 28px;
  }

  .hero-title { font-size: 28px; }
  .hero-subtitle { font-size: 15px; }
  .panel-note,
  .refresh-status,
  .role-chip,
  .current-chip { font-size: 12px; }

  .org-panel {
    padding: 24px;
    border-radius: 24px;
  }

  .section-title { font-size: 18px; }

  .org-list,
  .org-skeleton {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .org-item,
  .skeleton-row {
    min-height: 104px;
    padding: 16px;
    border-radius: 18px;
  }

  .org-name { font-size: 16px; }
  .empty-title { font-size: 18px; }
  .empty-desc { font-size: 13px; }
}

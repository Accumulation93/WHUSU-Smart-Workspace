<view class="page">
  <view class="hero org-hero">
    <view class="hero-badge">{{roleLabel}} · 组织空间</view>
    <view class="hero-title">切换组织</view>
  </view>

  <view class="org-panel">
    <view class="panel-head">
      <view>
        <view class="section-title">可访问组织</view>
        <view class="panel-note">共 {{organizations.length}} 个组织</view>
      </view>
      <view class="refresh-status" wx:if="{{refreshing}}">正在同步</view>
    </view>

    <view class="org-skeleton" wx:if="{{loading && organizations.length === 0}}">
      <view class="skeleton-row" wx:for="{{skeletonRows}}" wx:key="*this">
        <view class="skeleton-icon"></view>
        <view class="skeleton-copy"><view></view><view></view></view>
      </view>
    </view>

    <view class="empty-state" wx:elif="{{!loading && organizations.length === 0}}">
      <view class="empty-icon"><ui-icon name="home" tone="muted" size="54" ariaLabel="暂无组织" /></view>
      <view class="empty-title">暂无可访问组织</view>
      <view class="empty-desc">请联系组织管理员</view>
    </view>

    <view class="org-list" wx:else>
      <view
        class="org-item {{activeOrgId === item.id ? 'org-item-active' : ''}} {{switchingOrgId === item.id ? 'org-item-switching' : ''}}"
        wx:for="{{organizations}}"
        wx:key="id"
        data-index="{{index}}"
        catchtap="onOrgTap"
        hover-class="org-item-pressing"
        hover-start-time="0"
        hover-stay-time="160"
        hover-stop-propagation="{{true}}"
        aria-role="button"
        aria-label="切换到{{item.name}}"
      >
        <view class="org-item-icon"><ui-icon name="home" tone="primary" size="34" ariaLabel="组织" /></view>
        <view class="org-info">
          <view class="org-name">{{item.name}}</view>
          <view class="org-meta">
            <view class="role-chip {{item.role === 'admin' ? 'role-chip-admin' : 'role-chip-user'}}">{{item.role === 'admin' ? '管理员' : '普通用户'}}</view>
            <view class="current-chip" wx:if="{{activeOrgId === item.id}}">当前组织</view>
          </view>
        </view>
        <view class="org-item-end">
          <view class="switching-dot" wx:if="{{switchingOrgId === item.id}}"></view>
          <ui-icon wx:elif="{{activeOrgId === item.id}}" name="check" tone="white" size="24" ariaLabel="当前组织" />
          <ui-icon wx:else name="chevron-right" tone="muted" size="28" ariaLabel="进入" />
        </view>
      </view>
    </view>
  </view>
</view>

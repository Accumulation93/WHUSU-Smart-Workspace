<view class="page">
  <view class="hero">
    <view class="hero-title">选择组织</view>
    <view class="hero-sub">切换当前需要访问和管理的组织</view>
  </view>

  <view class="card" wx:if="{{organizations.length === 0 && !loading}}">
    <view class="empty-hint">暂无可用组织</view>
    <view class="empty-desc">您尚未在任何组织中绑定身份，请先绑定</view>
  </view>

  <view class="org-list" wx:if="{{organizations.length > 0}}">
    <view
      class="org-item {{activeOrgId === item.id ? 'org-item--active' : ''}}"
      wx:for="{{organizations}}"
      wx:key="id"
      data-index="{{index}}"
      bindtap="onOrgTap"
    >
      <view class="org-info">
        <view class="org-name">{{item.name}}</view>
        <view class="org-role">
          <view class="chip {{item.role === 'admin' ? 'chip--blue' : 'chip--green'}}">
            {{item.role === 'admin' ? '管理员' : '普通用户'}}
          </view>
        </view>
      </view>
      <view class="org-check" wx:if="{{activeOrgId === item.id}}">
        <text class="check-icon">✓</text>
      </view>
    </view>
  </view>
</view>

.security-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 44rpx;
  box-sizing: border-box;
}

.security-hero {
  margin-bottom: 22rpx;
  padding: 34rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #2563eb, #3b82f6 54%, #60a5fa);
  box-shadow: 0 22rpx 46rpx rgba(37,99,235,0.18);
}

.security-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
}

.security-row,
.credential-head,
.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.security-row {
  margin-top: 20rpx;
}

.security-main {
  color: #0f172a;
  font-size: var(--ui-type-value);
  font-weight: 800;
  line-height: 1.45;
}

.security-sub,
.security-note,
.security-empty {
  margin-top: 6rpx;
  color: #64748b;
  font-size: var(--ui-type-meta);
  line-height: 1.65;
}

.status-tag {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(147,197,253,0.58);
  border-radius: 12rpx;
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.4;
  background: rgba(219,234,254,0.72);
}

.credential-block {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(219,229,241,0.94);
  border-radius: 18rpx;
  background: rgba(248,251,255,0.72);
}

.passphrase-input {
  margin: 16rpx 0;
}

.compact-btn {
  width: auto;
  min-width: 132rpx;
  min-height: 66rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  font-size: var(--ui-type-label);
  line-height: 1.45;
}

.recovery-code-panel {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(147,197,253,0.62);
  border-radius: 16rpx;
  background: rgba(239,246,255,0.84);
}

.recovery-code {
  color: #2563eb;
  font-size: var(--ui-type-value);
  font-weight: 800;
  letter-spacing: 3rpx;
  line-height: 1.5;
  text-align: center;
  overflow-wrap: anywhere;
}

.code-actions {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.session-list {
  margin-top: 16rpx;
}

.session-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(226,232,240,0.9);
}

.session-item:last-child {
  border-bottom: 0;
}

.session-copy {
  flex: 1;
  min-width: 0;
}

@media (min-width: 520px) {
  .security-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 24px 42px;
  }

  .security-hero {
    padding: 28px 30px;
    border-radius: 26px;
  }

  .security-card {
    padding: 24px;
  }

  .security-main { font-size: var(--ui-type-emphasis); }
  .security-sub,
  .security-note,
  .security-empty { font-size: var(--ui-type-meta); }
  .status-tag { font-size: var(--ui-type-caption); }

  .compact-btn {
    min-height: 42px;
    padding: 10px 16px;
    border-radius: 12px;
    font-size: var(--ui-type-label);
  }
}

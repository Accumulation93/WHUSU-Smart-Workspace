<view class="page security-page">
  <view class="hero security-hero">
    <view class="hero-badge">账号保护</view>
    <view class="hero-title">账号安全</view>
    <view class="hero-subtitle">微信换绑会原子撤销旧微信和全部旧会话，不提供直接清空绑定</view>
  </view>

  <view class="card security-card">
    <view class="section-title">认证账号</view>
    <view class="security-row" wx:if="{{account}}">
      <view>
        <view class="security-main">{{account.name}}</view>
        <view class="security-sub">{{account.studentId}}</view>
      </view>
      <view class="status-tag">已认证</view>
    </view>
    <view class="security-empty" wx:elif="{{loading}}">正在加载账号信息…</view>
  </view>

  <view class="card security-card">
    <view class="section-title">恢复凭据</view>
    <view class="security-note" wx:if="{{!allowRecoveryCode && !allowPassphrase}}">当前系统仅允许管理员人工恢复账号。</view>

    <view class="credential-block" wx:if="{{allowRecoveryCode}}">
      <view class="credential-head">
        <view>
          <view class="security-main">系统恢复码</view>
          <view class="security-sub">高熵一次性凭据，生成新码后旧码失效</view>
        </view>
        <button class="secondary-btn compact-btn ui-motion-button" loading="{{savingCredential}}" bindtap="rotateRecoveryCode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">生成新码</button>
      </view>
      <view class="recovery-code-panel" wx:if="{{recoveryCode}}">
        <view class="recovery-code">{{recoveryCode}}</view>
        <view class="code-actions">
          <button class="secondary-btn compact-btn ui-motion-button" bindtap="copyRecoveryCode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">复制</button>
          <button class="secondary-btn compact-btn ui-motion-button" bindtap="hideRecoveryCode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">已保存并隐藏</button>
        </view>
      </view>
    </view>

    <view class="credential-block" wx:if="{{allowPassphrase}}">
      <view class="security-main">自定义恢复口令</view>
      <view class="security-sub">至少 {{passphraseMinLength}} 位，请勿与其他平台密码相同</view>
      <input class="field-input passphrase-input" password="{{true}}" value="{{passphrase}}" bindinput="onPassphraseInput" placeholder="输入新的恢复口令" />
      <button class="primary-btn compact-btn ui-motion-button" loading="{{savingCredential}}" bindtap="savePassphrase" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">保存恢复口令</button>
    </view>
  </view>

  <view class="card security-card">
    <view class="section-title">设备会话</view>
    <view class="security-note">可以撤销其他设备；当前设备需在门户退出登录。</view>
    <view class="session-list">
      <view class="session-item" wx:for="{{sessions}}" wx:key="id">
        <view class="session-copy">
          <view class="security-main">{{item.current ? '当前设备' : '已登录设备'}}</view>
          <view class="security-sub">{{item.roleLabel}} · 最近活动 {{item.lastSeenText}}</view>
        </view>
        <view class="status-tag" wx:if="{{item.current}}">当前</view>
        <button wx:else class="secondary-btn compact-btn ui-motion-button" data-id="{{item.id}}" loading="{{revokingSessionId === item.id}}" bindtap="revokeSession" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">撤销</button>
      </view>
      <view class="security-empty" wx:if="{{!loading && !sessions.length}}">暂无有效设备会话</view>
    </view>
  </view>
</view>

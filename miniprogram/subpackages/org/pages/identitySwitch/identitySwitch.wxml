<view class="page">
  <view class="hero org-hero">
    <view class="hero-badge">统一身份</view>
    <view class="hero-title">切换身份</view>
    <view class="hero-subtitle">业务权限严格跟随当前组织和岗位，不同身份互不混用</view>
  </view>

  <view class="org-panel">
    <view class="panel-head">
      <view>
        <view class="section-title">可用身份</view>
        <view class="panel-note">共 {{contexts.length}} 个组织岗位或管理身份</view>
      </view>
    </view>

    <view class="org-skeleton" wx:if="{{loading && !contexts.length}}">
      <view class="skeleton-row" wx:for="{{skeletonRows}}" wx:key="*this">
        <view class="skeleton-icon"></view>
        <view class="skeleton-copy"><view></view><view></view></view>
      </view>
    </view>

    <view class="empty-state" wx:elif="{{!loading && !contexts.length}}">
      <view class="empty-icon"><ui-icon name="user" tone="muted" size="54" ariaLabel="暂无身份" /></view>
      <view class="empty-title">暂无可用身份</view>
      <view class="empty-desc">请联系组织管理员核对成员关系</view>
    </view>

    <view class="org-list" wx:else>
      <view
        class="org-item {{item.current ? 'org-item-active' : ''}} {{switchingContextId === item.contextId ? 'org-item-switching' : ''}}"
        wx:for="{{contexts}}"
        wx:key="contextId"
        data-id="{{item.contextId}}"
        catchtap="onContextTap"
        hover-class="org-item-pressing"
        hover-start-time="0"
        hover-stay-time="160"
        hover-stop-propagation="{{true}}"
        aria-role="button"
        aria-label="切换到{{item.organizationName}}{{item.identityName}}"
      >
        <view class="org-item-icon"><ui-icon name="{{item.role === 'admin' ? 'shield' : 'user'}}" tone="primary" size="34" ariaLabel="身份" /></view>
        <view class="org-info">
          <view class="org-name">{{item.identityName}}</view>
          <view class="identity-org-name">{{item.organizationName}}</view>
          <view class="identity-detail" wx:if="{{item.detail}}">{{item.detail}}</view>
          <view class="org-meta">
            <view class="role-chip {{item.role === 'admin' ? 'role-chip-admin' : 'role-chip-user'}}">{{item.roleLabel}}</view>
            <view class="current-chip" wx:if="{{item.current}}">当前身份</view>
          </view>
        </view>
        <view class="org-item-end">
          <view class="switching-dot" wx:if="{{switchingContextId === item.contextId}}"></view>
          <ui-icon wx:elif="{{item.current}}" name="check" tone="white" size="24" ariaLabel="当前身份" />
          <ui-icon wx:else name="chevron-right" tone="muted" size="28" ariaLabel="进入" />
        </view>
      </view>
    </view>
  </view>
</view>

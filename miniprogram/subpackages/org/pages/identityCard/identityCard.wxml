<ui-navbar title="{{navigationTitle}}" />
<view class="page page-narrow" style="min-height: calc(100vh - {{navTopPx}}px)">
  <view class="identity-card">
    <view class="identity-card-header">
      <view class="identity-card-heading"><ui-icon name="shield" tone="white" sizeRole="feature-leading" /><view><view class="identity-card-brand">{{common.brandName}}</view><view class="identity-card-title">{{publicView ? copy.verifyTitle : copy.credential}}</view></view></view>
      <view class="identity-card-emblem" aria-hidden="true"><ui-icon name="shield" tone="white" sizeRole="feature-leading" /></view>
      <view wx:if="{{card}}" class="identity-card-name">{{card.name}}</view>
      <view wx:if="{{card}}" class="identity-card-status"><text>{{card.state}}</text></view>
    </view>
    <view class="identity-card-body">
      <app-loading wx:if="{{loading}}" text="{{copy.loading}}" />
      <block wx:if="{{card}}">
        <view class="identity-card-fields">
          <view class="identity-card-field"><text class="identity-card-label">{{copy.organization}}</text><text class="identity-card-value">{{card.organization}}</text></view>
          <view class="identity-card-field"><text class="identity-card-label">{{copy.position}}</text><text class="identity-card-value">{{card.position}}</text></view>
        </view>
        <view wx:if="{{publicView && valid}}" class="identity-card-result"><ui-icon name="shield" sizeRole="feature-leading" /><text>{{copy.verified}}</text></view>
        <view wx:if="{{!publicView}}" class="identity-card-code">
          <view class="identity-code-heading"><text class="identity-card-value">{{copy.liveCheck}}</text><text class="identity-card-label">{{copy.expiryHint}}</text></view>
          <app-loading wx:if="{{qrLoading}}" text="{{copy.generating}}" />
          <view wx:if="{{image}}" class="identity-code-tabs">
            <view class="identity-code-tab {{codeMode === 'verification' ? 'identity-code-tab-active' : ''}} ui-motion-chip" data-mode="verification" bindtap="switchCode" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.verificationCode}}</view>
            <view class="identity-code-tab {{codeMode === 'miniProgram' ? 'identity-code-tab-active' : ''}} ui-motion-chip" data-mode="miniProgram" bindtap="switchCode" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.miniProgramCode}}</view>
          </view>
          <image wx:if="{{image}}" class="identity-qr-image" src="{{image}}" mode="aspectFit" />
          <view wx:if="{{image}}" class="identity-card-label">{{copy.scanHint}}</view>
          <button wx:if="{{image}}" class="secondary-btn identity-card-refresh ui-motion-button" bindtap="showOriginal" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.originalImage}}</button>
        </view>
      </block>
      <view wx:if="{{notice}}" class="identity-card-label">{{notice}}</view>
      <button class="secondary-btn identity-card-refresh ui-motion-button" disabled="{{loading || qrLoading}}" bindtap="load" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{publicView ? copy.retry : copy.refresh}}</button>
    </view>
  </view>
</view>

<ui-navbar title="{{navigationTitle}}" />
<view class="page page-narrow" style="min-height: calc(100vh - {{navTopPx}}px)">
  <workspace-hero app-name="{{common.brandName}}" page-name="{{publicView ? copy.verifyTitle : managementOnly ? copy.management.title : copy.title}}" tone="{{heroTone || 'blue'}}" />
  <view wx:if="{{!managementOnly}}" class="identity-card {{publicView ? 'identity-verification' : ''}}">
    <view wx:if="{{publicView && valid && card && !loading}}" class="identity-card-header">
      <view class="identity-card-heading"><ui-icon name="shield" tone="primary" sizeRole="feature-leading" /><view class="identity-card-title">{{copy.verifyTitle}}</view></view>
      <view wx:if="{{card}}" class="identity-card-name">{{card.name}}</view>
      <view wx:if="{{valid && card}}" class="identity-card-result"><ui-icon name="check" sizeRole="context-trailing" /><text>{{copy.verified}}</text></view>
      <view wx:if="{{card.state && card.stateCode !== 'no_position'}}" class="identity-card-status"><text>{{card.state}}</text></view>
    </view>
    <view class="identity-card-body">
      <view wx:if="{{publicView && (!valid || !card || loading)}}" class="identity-card-title">{{copy.verifyTitle}}</view>
      <app-loading wx:if="{{loading}}" text="{{copy.loading}}" />
      <block wx:if="{{card && (!publicView || (valid && !loading))}}">
        <view wx:if="{{!publicView && card.state}}" class="identity-own-status">{{card.state}}</view>
        <view wx:if="{{!publicView}}" class="identity-time"><ui-icon name="clock" sizeRole="context-trailing" /><view><view class="identity-card-label">{{timeLabel}}</view><view class="identity-time-value">{{currentTimeText}}</view></view></view>
        <view class="identity-card-fields">
          <view class="identity-card-field identity-organization-field"><text class="identity-card-label">{{copy.organization}}</text><text class="identity-card-value">{{card.organization}}</text></view>
          <view wx:if="{{publicView && card.department}}" class="identity-card-field"><text class="identity-card-label">{{copy.department}}</text><text class="identity-card-value">{{card.department}}</text></view>
          <view wx:if="{{publicView && card.identityCategory}}" class="identity-card-field"><text class="identity-card-label">{{copy.identityCategory}}</text><text class="identity-card-value">{{card.identityCategory}}</text></view>
          <view wx:if="{{publicView && card.workGroup}}" class="identity-card-field"><text class="identity-card-label">{{copy.functionGroup}}</text><text class="identity-card-value">{{card.workGroup}}</text></view>
          <view wx:if="{{!publicView || !card.hasPositionDetails}}" class="identity-card-field"><text class="identity-card-label">{{copy.position}}</text><text class="identity-card-value">{{card.position}}</text></view>
        </view>
        <view wx:if="{{publicView}}" class="identity-time identity-live-time"><ui-icon name="clock" tone="primary" sizeRole="context-trailing" /><view><view class="identity-card-label">{{copy.currentTime}}</view><view class="identity-time-value">{{currentTimeText}}</view></view></view>
        <view wx:if="{{publicView && checkedAtText}}" class="identity-time"><ui-icon name="clock" tone="muted" sizeRole="context-trailing" /><view><view class="identity-card-label">{{copy.checkedAt}}</view><view class="identity-time-value">{{checkedAtText}}</view></view></view>
        <view wx:if="{{!publicView}}" class="identity-card-code">
          <view class="identity-code-heading"><text class="identity-card-value">{{copy.liveCheck}}</text><text class="identity-card-label">{{copy.expiryHint}}</text></view>
          <app-loading wx:if="{{qrLoading}}" text="{{copy.generating}}" />
          <view wx:if="{{image}}" class="identity-code-tabs">
            <view class="identity-code-tab {{codeMode === 'verification' ? 'identity-code-tab-active' : ''}} ui-motion-chip" data-mode="verification" bindtap="switchCode" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.verificationCode}}</view>
            <view class="identity-code-tab {{codeMode === 'miniProgram' ? 'identity-code-tab-active' : ''}} ui-motion-chip" data-mode="miniProgram" bindtap="switchCode" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.miniProgramCode}}</view>
          </view>
          <image wx:if="{{image}}" class="identity-qr-image" src="{{image}}" mode="aspectFit" />
          <view wx:if="{{image}}" class="identity-card-label">{{copy.scanHint}}</view>
        </view>
      </block>
      <view wx:if="{{notice}}" class="identity-card-label">{{notice}}</view>
      <view wx:if="{{!publicView && image}}" class="identity-card-actions">
        <button class="secondary-btn identity-card-refresh ui-motion-button" bindtap="showOriginal" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.originalImage}}</button>
        <button class="secondary-btn identity-card-refresh ui-motion-button" disabled="{{loading || qrLoading || policySaving}}" bindtap="load" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.refresh}}</button>
      </view>
      <button wx:else class="secondary-btn identity-card-refresh ui-motion-button" disabled="{{loading || qrLoading || policySaving}}" bindtap="load" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{publicView ? (valid ? copy.refreshVerification : copy.retry) : copy.refresh}}</button>
    </view>
  </view>
  <view wx:if="{{!publicView && (policyAllowed || managementOnly)}}" class="identity-card identity-policy-card">
    <view class="identity-card-body">
      <view wx:if="{{!managementOnly}}" class="identity-card-title">{{copy.management.title}}</view>
      <app-loading wx:if="{{policyLoading}}" text="{{copy.loading}}" />
      <block wx:elif="{{policy}}">
        <view class="identity-policy-row">
          <view class="identity-card-value">{{copy.management.issue}}</view>
          <switch aria-label="{{copy.management.issue}}" color="#3b82f6" checked="{{policy.issueEnabled}}" disabled="{{!canUpdatePolicy || policySaving}}" data-key="issueEnabled" bindchange="changePolicy" />
        </view>
        <view class="identity-policy-row">
          <view><view class="identity-card-value">{{copy.management.publicVerification}}</view><view class="identity-card-label">{{copy.management.publicVerificationHelp}}</view></view>
          <switch aria-label="{{copy.management.publicVerification}}" color="#3b82f6" checked="{{policy.publicVerificationEnabled}}" disabled="{{!canUpdatePolicy || policySaving}}" data-key="publicVerificationEnabled" bindchange="changePolicy" />
        </view>
        <button wx:if="{{canUpdatePolicy}}" class="primary-btn identity-card-refresh ui-motion-button" disabled="{{!policyDirty || policySaving}}" bindtap="savePolicy" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160"><app-loading compact="{{true}}" active="{{policySaving}}" />{{saveLabel}}</button>
        <view wx:else class="identity-card-label">{{copy.management.readOnly}}</view>
      </block>
      <block wx:else>
        <view wx:if="{{!policyAllowed && !policyNotice}}" class="identity-card-label">{{notice || policyDeniedLabel}}</view>
        <button class="secondary-btn identity-card-refresh ui-motion-button" bindtap="loadPolicy" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.retry}}</button>
      </block>
      <view wx:if="{{policyNotice}}" aria-live="polite" class="identity-card-label">{{policyNotice}}</view>
    </view>
  </view>
</view>

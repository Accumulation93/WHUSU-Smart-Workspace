# WHUSU Smart Workspace Server - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whusu_smart_workspace
DB_POOL_LIMIT=20

# Persistent audit attachment storage (must be outside versioned release folders)
AUDIT_UPLOAD_DIR=/home/ubuntu/whusu-smart-workspace-shared/uploads/audit

# WeChat Mini Program (code2session，与 unifiedAuth 运行时变量保持一致)
WECHAT_APPID=your-appid
WECHAT_SECRET=your-secret

# 用途密钥（生产环境必须分别生成，禁止复用；不要提交真实值）
# JWT_SECRET 与 AUTH_IDENTITY_SECRET 均至少 32 字节。
JWT_SECRET=
AUTH_IDENTITY_SECRET=
# 仅在身份根密钥轮换期间填写上一版身份密钥；旧 OpenID 命中后会改写为新密钥。
AUTH_IDENTITY_LEGACY_SECRET=

# PDF 文件级签名私钥使用 AES-256-GCM 静态加密。主密钥必须是恰好 32 字节的 base64: 或 hex: 值。
PDF_SIGNING_KEY_ENCRYPTION_KEY_VERSION=v1
PDF_SIGNING_KEY_ENCRYPTION_KEY=
# 密钥轮换后，以 JSON 对象提供只读旧版本，例如 {"v1":"base64:..."}。
PDF_SIGNING_KEY_DECRYPTION_KEYS_JSON=
# 只在执行一次性旧 PEM 迁移时临时设为 true；正常运行必须为 false。
PDF_SIGNING_KEY_ALLOW_LEGACY_PLAINTEXT=false

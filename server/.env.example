# WHUSU Smart Workspace Server - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whusu_smart_workspace
DB_POOL_LIMIT=20

# Persistent audit attachment storage (must be outside versioned release folders)
AUDIT_UPLOAD_DIR=/home/ubuntu/whusu-smart-workspace-shared/uploads/audit

# WeChat Mini Program (code2session)
WX_APPID=your-appid
WX_SECRET=your-secret

# JWT
JWT_SECRET=change-me-to-a-random-string
